<Project Sdk="Microsoft.NET.Sdk">

  <!--
    EPOS.Kern - der RECHENKERN von EPOS-Plan als plattformfreie Bibliothek
    (Umsetzungskonzept iOS, Paket iU3; Entscheidungsregister § 2.2).

    Die Dateien werden VERLINKT, nicht verschoben. Es gibt weiterhin genau EINE
    Quelle je Datei; das Hauptprojekt WindowsFormsApplication1 baut unveraendert
    weiter, und jede Aenderung am Rechenkern wirkt sofort in beiden Projekten.
    Ein Umzug haette den Bestand in zwei Haelften geteilt, die auseinanderlaufen
    koennen - genau das soll dieses Projekt verhindern.

    <EnableWindowsTargeting>false</EnableWindowsTargeting> ist die eigentliche
    Pruefung: Directory.Build.props schaltet die Eigenschaft auf Nicht-Windows
    ein, damit die net*-windows-Projekte dort uebersetzbar bleiben. Hier wird sie
    ausdruecklich wieder abgeschaltet - jede WinForms-Beruehrung in einer
    verlinkten Datei bricht damit den Build, statt erst auf iOS zur Laufzeit
    aufzufallen.

    KEIN NoWarn CA1416. Die verbliebenen Windows-APIs (System.Data.OleDb im
    eingefrorenen Access-Zweig) sollen als Warnung SICHTBAR bleiben; ihre Zahl
    ist das Restinventar, das die naechsten Pakete abtragen.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableWindowsTargeting>false</EnableWindowsTargeting>

    <!-- Es wird ausschliesslich verlinkt; ein Glob wuerde nichts finden und
         zugleich verschleiern, was tatsaechlich zum Kern gehoert. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <RootNamespace>WindowsFormsApplication1</RootNamespace>
    <AssemblyName>EPOS.Kern</AssemblyName>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <SatelliteResourceLanguages>de-DE;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- ================================================================== -->
  <!-- Rechenbibliotheken                                                  -->
  <!-- ================================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\SpeicherEngine\SpeicherEngine.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Nur zur UEBERSETZUNG: OleDbParameter ist Datentraeger in der Bruecke
         von DbParam, OleDbCommand der Rest in RecordSet (iR8). Auf Nicht-Windows
         wirft jeder Konstruktor - der Rechenpfad ruft sie seit iU3-3 nicht mehr. -->
    <PackageReference Include="System.Data.OleDb" />
    <!-- Properties\Settings.Designer.cs erbt von ApplicationSettingsBase. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" />
  </ItemGroup>










































