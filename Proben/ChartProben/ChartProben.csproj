<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ChartProben (Umsetzungskonzept iOS, Paket iU7-3) - der PLATTFORMFREIE NACHWEIS
    fuer den Diagramm-Renderer des Berichts.

    Zweck: zeigen, dass ChartRenderer.cs nach der Portierung auf SkiaSharp (iU7-2)
    OHNE Windows laeuft - also auf Linux, in der CI und damit spaeter auf iOS. Der
    fruehere Bildvergleich unter Referenzlauf\ (GDI+ gegen SkiaSharp, nur Windows) ist
    mit Entscheid iF23 am 03.09.2026 geloescht; diese Probe ist seither die Abnahme
    des Renderers: Masse, Farben, Determinismus und Lauffaehigkeit ueberall.

    net10.0 OHNE -windows und OHNE ProjectReference auf die Anwendung: Ein Verweis
    auf WindowsFormsApplication1 haette die halbe Windows-Welt mitgezogen und den
    Nachweis wertlos gemacht.

    SEIT iU7-6 HAENGT DIE PROBE AM KERN. Bis iU7-5 verlinkte sie ChartRenderer.cs
    einzeln und stellte ZeitreihenSatz, VerlaufSerie und BerichtTexte als schmale
    Ersatzklassen daneben - der Renderer lag damals noch in der Anwendung, und
    seine Nachbardateien zogen ProjektModel, DataTable und Program.nLanguage nach
    sich. Beides ist erledigt: Der Renderer liegt seit iU7-5 in EPOS.Kern, und
    BerichtTexte entscheidet seit iU4 ueber Sprache.Nummer statt ueber Program.
    Die Probe referenziert deshalb jetzt EPOS.Kern und misst die ECHTEN Typen;
    die Ersatzklassen sind ersatzlos entfallen. Der Nachweis wird dadurch
    schaerfer, nicht schwaecher - EPOS.Kern traegt kein -windows, jede
    Windowsbindung im Kern braeche diesen Bau genauso wie den eigenen.

    EIGENE Projektmappe, BEWUSST NICHT in WP-Plan.sln - dasselbe Muster wie
    Proben\ZugriffsschichtProben: Die Proben sollen den Ausrollstand nicht
    beeinflussen.

    Die nativen SkiaSharp-Bibliotheken kommen je Plattform bedingt dazu; die
    Versionen stehen zentral in ..\..\Directory.Packages.props.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>

    <!-- Der Gegenbeweis: hier wird NICHT auf Windows gezielt. Jede Windows-API in
         der verlinkten Datei bricht den Build. -->
    <EnableWindowsTargeting>false</EnableWindowsTargeting>

    <!-- Es wird ausschliesslich benannt; ein Glob wuerde verschleiern, was
         tatsaechlich zur Probe gehoert. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>

    <AssemblyName>ChartProben</AssemblyName>
    <RootNamespace>ChartProben</RootNamespace>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!-- Nur noch die Probe selbst; der Pruefling kommt aus EPOS.Kern. -->
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Der Pruefling samt seiner Nachbarn: ChartRenderer, ZeitreihenSatz,
         VerlaufSerie, BerichtTexte. -->
    <ProjectReference Include="..\..\EPOS.Kern\EPOS.Kern.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SkiaSharp und die passende Native kaemen ueber EPOS.Kern ohnehin mit;
         hier stehen sie trotzdem, weil DIESES Projekt das ausfuehrbare ist -
         wer das Bild erzeugt, soll seine Laufzeit selbst benennen. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS"
                      Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
