    }

    private string DeckelGilt()
    {
        var k = BhwTexte.Kultur;
        int jahr = Vorschlagsjahr();
        if (_uebDeckel.HasValue)
            return string.Format(_t.UebGiltEigen, _uebDeckel.Value.ToString("N0", k), _t.UebStaffel);
        return string.Format(_t.UebGiltStaffel,
                             KwkgJahresbetrag.StaffelDeckel(Katalog, jahr).ToString("N0", k),
                             jahr.ToString(System.Globalization.CultureInfo.InvariantCulture));
    }

    /// <summary>
    /// „Wirkung Jahr 1" des KWK-Zuschlags — die Sätze, das Kontingent und der Deckel des
    /// ZWISCHENSTANDS auf die Mengen und Vollbenutzungsstunden des zuletzt gebuchten
    /// Laufs, gerechnet von <see cref="KwkgJahresbetrag"/> (derselbe Ausdruck wie im
    /// Lauf). Ohne gebuchten Lauf steht der Grund statt einer Zahl.
    /// </summary>
    private IReadOnlyList<string> WirkungKwkg()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null || _uebA is null) return Array.Empty<string>();
        var k = BhwTexte.Kultur;
        int jahr = Vorschlagsjahr();
        string kopf = string.Format(_t.UebWirkungJahr1, jahr.ToString(System.Globalization.CultureInfo.InvariantCulture));
        KwkgModulNachweis? n = ModulNachweis(a);
        if (n is null || n.VbhElektrisch <= 0) return new[] { kopf + ": " + _t.UebWirkungOhneLauf };

        KwkgSatzVorschlag v = UebSatzvorschlag();
        double satzEinsp = SatzZumFormular(_uebEinsp, v.SatzEinspeisungCt) ?? 0;
        double satzEigen = KwkgJahresbetrag.SatzEigenWirksam(SatzZumFormular(_uebEigen, v.SatzEigenCt),
                                                             _uebA.Eigenfall);
        KwkgKontingentVorschlag kv = UebKontingentvorschlag();
        double kontingent = _uebKontingent.HasValue && _uebKontingent.Value > 0
            ? _uebKontingent.Value : (kv.Unvollstaendig ? 0 : kv.KontingentH);
        double deckel = _uebDeckel.HasValue && _uebDeckel.Value > 0
            ? _uebDeckel.Value : KwkgJahresbetrag.StaffelDeckel(Katalog, jahr);
        double abschlag = KwkgJahresbetrag.Abschlag(_vorgaben.KwkgAbschlagNegativ);

        double verguetet = KwkgJahresbetrag.VerguetetH(n.VbhElektrisch, deckel, kontingent, abschlag);
        double anteil = verguetet / n.VbhElektrisch;
        double summe = KwkgJahresbetrag.Voll(n.EigenMWh, satzEigen, n.EinspeisungMWh, satzEinsp) * anteil;
        double einspEur = KwkgJahresbetrag.Voll(0, 0, n.EinspeisungMWh, satzEinsp) * anteil;
        double eigenEur = KwkgJahresbetrag.Voll(n.EigenMWh, satzEigen, 0, 0) * anteil;

        return new[]
        {
            kopf + ": " + string.Format(_t.UebWirkungKwkg, verguetet.ToString("N0", k),
                                        n.VbhElektrisch.ToString("N0", k), deckel.ToString("N0", k),
                                        anteil.ToString("N3", k), summe.ToString("N1", k)),
            string.Format(_t.UebWirkungKwkgFormel, n.EinspeisungMWh.ToString("N1", k),
                          KwkgSatzHerkunft.Satz(satzEinsp, k), anteil.ToString("N3", k),
                          n.EigenMWh.ToString("N1", k), KwkgSatzHerkunft.Satz(satzEigen, k),
                          einspEur.ToString("N1", k), eigenEur.ToString("N1", k))
        };
    }

