    private IReadOnlyList<Stammblattwert> Wasserwerte(RueckkuehlwerkDaten d)
    {
        RueckkuehlwerkVorgaben? v = VorgabenZu(d);
        var liste = new List<Stammblattwert>(5);
        if (IstBefeuchtend(d))
        {
            liste.Add(new(Texte.LabelBefeuchtungWirkungsgrad, Lesewert(d.BefeuchtungWirkungsgrad, v?.BefeuchtungWirkungsgrad, "0.##", "")));
            liste.Add(new(Texte.LabelBefeuchtungAb, Lesewert(d.BefeuchtungAbC, v?.BefeuchtungAbC, "0.#", Texte.EinheitGradC)));
        }
        liste.Add(new(Texte.LabelVerdunstungFaktor, Lesewert(d.VerdunstungFaktor, v?.VerdunstungFaktor, "0.##", "")));
        liste.Add(new(Texte.LabelEindickung, Lesewert(d.Eindickung, v?.Eindickung, "0.#", "")));
        liste.Add(new(Texte.LabelDriftAnteil, Lesewert(d.DriftAnteil, v?.DriftAnteil, "0.####", "")));
        return liste;
    }

