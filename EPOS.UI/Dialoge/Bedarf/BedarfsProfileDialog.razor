    protected override void OnParametersSet()
    {
        // Der Kopf der WAHLSPALTE kommt weiter ueber den eigenen Text des Wirtes.
        Filtertexte.SpalteWahl = SpalteWahl;
        if (TitelDbAendern.Length == 0) TitelDbAendern = BtnDbAendernText;
        if (TitelDbNeu.Length == 0) TitelDbNeu = BtnDbNeuText;
        if (TitelDbLoeschen.Length == 0) TitelDbLoeschen = BtnDbLoeschenText;
        if (TitelTypAendern.Length == 0) TitelTypAendern = BtnTypAendernText;
    }

    protected override void OnInitialized()
    {
        _einheit = Einheit ?? Energieeinheit.Vorgabe;
        _rechenweg = RechenwegBrauchwasser;
        _zapfprofilZonen = ZapfprofilZonen;

        // S2.5/S3.1: der Filterstand je Katalog, fuer die Sitzung, gemeinsam mit der
        // Verwaltung desselben Bedarfs (Frage Q2).
        _filterstand = Filterstandvorgabe
            ?? Katalogfilterregister.Stand(Katalogprofil?.Schluessel ?? ("BEDARF_" + Art));

        KatalogLaden();
        if (Zeilen.Count > 0) ProjektzeileWaehlen(Zeilen[0]);

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.BEDARFSPROFILE,
                                          () => KiSicht(), KiHaken());
    }

