#27901=IFCPROPERTYENUMERATEDVALUE('AdjacentType','Kennung f\X\FCr die Angrenzart des Bauteils',(IFCLABEL('btaHeated')),$);
#27902=IFCPROPERTYENUMERATEDVALUE('ColourType','Kennung f\X\FCr die Farbe des Bauteils',(IFCLABEL('clmNone')),$);
#27903=IFCPROPERTYSINGLEVALUE('Comments','Allgemeine Kommentare zum Element',IFCTEXT(''),$);
#27904=IFCPROPERTYENUMERATEDVALUE('EcoIndexType','Kennung f\X\FCr den \X\D6ko-Index des Bauteils',(IFCLABEL('ecoNone')),$);
#27905=IFCPROPERTYENUMERATEDVALUE('ElementType','Kennung Elementtyp',(IFCLABEL('bctWall')),$);
#27906=IFCPROPERTYENUMERATEDVALUE('EmbeddedSystemPositionType','Kennung f\X\FCr die Position von fl\X\E4chenintegrierten Systemen innerhalb des Geb\X\E4udeelementes Anhand der Eigenschaft wird festgelegt, ob ein fl\X\E4chenintegriertes System innerhalb des Geb\X\E4udebauteils installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein fl\X\E4chenintegriertes System vorgesehen ist. Wenn die Position des fl\X\E4chenintegrierten Systems noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
#27907=IFCPROPERTYENUMERATEDVALUE('Generator','Kennung f\X\FCr den Ersteller/Bearbeiter des Geb\X\E4udeelementes. Der Generator dient nur zur Information. Die Kennung darf nicht f\X\FCr die Identifizierung von Modellobjekten verwendet werden.',(IFCLABEL('mgt2D3D')),$);
#27908=IFCPROPERTYSINGLEVALUE('GUID','Bezeichner, der w\X\E4hrend der Lebenszeit des Modellobjektes erhalten bleibt. Der Bezeichner ist nicht eindeutig.',IFCLABEL('4579e56c-1f7f-46f4-b1db-016c55c0ffd2'),$);
