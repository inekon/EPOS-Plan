    /// übertragen</b>: Ob ein Feldwert hinausgeht, entscheiden der Schalter „Feldwerte
    /// mitsenden" im Chat und die Einwilligungsstufe „Dialogdaten" (KI‑D‑Q2).
    /// </summary>
    private KiMaskenanmeldung? _kiMaske;

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

