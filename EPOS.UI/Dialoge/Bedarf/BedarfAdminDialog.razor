    /// <summary>
    /// <b>Der Vergleich</b> (V12) über die Vergleichszeilen des Kerns
    /// (<c>BedarfStammCtrl.Vergleichszeilen</c>: Typ, Beschreibung, Jahressumme und die
    /// zwölf Monatswerte — der Monatsgang ist der Grund, warum zwei Profile mit derselben
    /// Jahressumme verschieden rechnen), dazu die Herkunft. Ohne den Weg die Spalten der
    /// Liste.
    /// </summary>
    private void VergleichBauen()
    {
        IReadOnlyList<string> namen = _auswahl.Gewaehlte;
        _vergleichskoepfe = namen;

        if (Vergleichsparameter is null)
        {
            var zeilen = namen.Select(n => _katalog.FirstOrDefault(x => x.Schluessel == n))
                              .Where(x => x is not null).Select(x => x!).ToList();
            _vergleichszeilen = Katalogprofil is null
                ? Array.Empty<Vergleichszeile>()
                : Vergleichsbau.AusSpalten(Katalogprofil, zeilen);
            return;
        }

        var saetze = new List<IReadOnlyList<Vergleichsfeld>>(namen.Count);
        foreach (string name in namen)
        {
            var felder = new List<Vergleichsfeld>();
            foreach (Parameterwert p in Vergleichsparameter(name) ?? Array.Empty<Parameterwert>())
            {
                string titel = p.Eintrag.Einheit.Length > 0
                    ? p.Eintrag.Anzeigetext + " [" + p.Eintrag.Einheit + "]"
                    : p.Eintrag.Anzeigetext;
                felder.Add(new Vergleichsfeld(p.Eintrag.Spalte, titel, p.Wert));
            }
            felder.Add(new Vergleichsfeld(HERKUNFT, Resource.ADM_VG_HERKUNFT,
                _geschuetzt.Contains(name) ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ));
            saetze.Add(felder);
        }
        _vergleichszeilen = Vergleichsbau.AusFeldern(saetze);
    }

