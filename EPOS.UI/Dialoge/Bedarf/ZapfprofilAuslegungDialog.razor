    /// <summary>Der Konstruktor ist zu: mit Tag wird er der Bedarfstag der Auslegung (Quelle Konstruktor).</summary>
    private void KonstruktorFertig(ZapfprofilBedarfstagDaten? tag)
    {
        _konstruktorOffen = false;
        if (tag is null) return;
        _eingabe.Entwurf = tag.Kopie();
        // Die Zeilen, aus denen der Tag entstand, gehen an den Eingaben mit: Sie werden mit der
        // Auslegung gespeichert und tragen das erneute Öffnen (Schemaschritt T5, ZU25).
        _eingabe.Konstruktorzeilen = tag.Konstruktorzeilen.Select(z => z.Kopie()).ToList();
        // Der Entwurf trägt jetzt seinen Bezug selbst; der des gespeicherten Tags und sein Hinweis sind überholt.
        _eingabe.KonstruktorBezugsart = null;
        _eingabe.KonstruktorBezugsmenge = null;
        _eingabe.KonstruktorBezugHinweis = "";
        _eingabe.Quelle = ZapfprofilBedarfstagquelle.Konstruktor;
        _eingabe.IdBedarfstag = null;
        Geaendert();
    }

    /// <summary>
    /// Eine Eingabe hat die Auslegung geändert: das Ergebnis ist überholt und wird entprellt neu
    /// gerechnet; ein laufendes Ensemble gehört zu den alten Eingaben und bricht ab.
    /// </summary>
    private void Geaendert()
    {
        _hinweis = "";
        _aktuell = false;
        LaufVerwerfen();
        EntprellungAbbrechen();
        if (Rechnen is null) return;
        if (EntprellungMs <= 0)
        {
            Neurechnen();
            return;
        }
        var quelle = new CancellationTokenSource();
        _entprellung = quelle;
        _ = EntprellungAbwarten(quelle);
    }

    private async Task EntprellungAbwarten(CancellationTokenSource quelle)
    {
        try
        {
            await Task.Delay(EntprellungMs, quelle.Token);
            if (quelle.IsCancellationRequested) return;
            await InvokeAsync(() =>
            {
                if (quelle.IsCancellationRequested) return;
                Neurechnen();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { /* eine neue Eingabe war schneller */ }
        catch (ObjectDisposedException) { /* die Überlagerung ist gegangen */ }
    }

    private void EntprellungAbbrechen()
    {
        CancellationTokenSource? offen = _entprellung;
        _entprellung = null;
        if (offen is null) return;
        try { offen.Cancel(); } catch (ObjectDisposedException) { }
        offen.Dispose();
    }

    /// <summary>
    /// Rechnet neu; führt das Ergebnis den Fall „ohne Tag" neu herbei, öffnet der Konstruktor. Mit
    /// „Stochastisch rechnen" läuft die Rechnung samt Ensemble NEBENLÄUFIG (5.1) — Karte (b) sagt
    /// „rechnet …" bis zum Ergebnis; ohne Schalter rechnet der Delegat <see cref="Rechnen"/>
    /// deterministisch im Zeichenlauf.
    /// </summary>
    private void Neurechnen(bool konstruktorFolgen = true)
    {
        if (_eingabe.Stochastisch && StochastischRechnen is not null)
        {
            EnsembleStarten(konstruktorFolgen);
            return;
        }
        LaufVerwerfen();
        DeterministischRechnen(konstruktorFolgen);
    }

    /// <summary>Die Rechnung im Zeichenlauf — ohne Ensemble, auch wenn der Schalter steht.</summary>
    private void DeterministischRechnen(bool konstruktorFolgen)
    {
        if (Rechnen is null) return;
        ZapfprofilAuslegungEingabeDaten e = _eingabe.Kopie();
        e.Stochastisch = false;
        ErgebnisSetzen(Rechnen(e), konstruktorFolgen);
    }

    /// <summary>Ein neues Ergebnis: es gilt; führt es den Fall „ohne Tag" neu herbei, öffnet der Konstruktor.</summary>
    private void ErgebnisSetzen(ZapfprofilAuslegungDaten? neu, bool konstruktorFolgen)
    {
        ZapfprofilAuslegungDaten? vorher = _ergebnis;
        _ergebnis = neu;
        _aktuell = neu is not null;
        if (konstruktorFolgen && KonstruktorFaellig(vorher, neu)) _konstruktorOffen = true;
    }

    // =================================================================================
    // Das Ensemble des Bedarfstags: nebenläufig, mit Status und Abbruch (5.1)
    // =================================================================================

    /// <summary>Startet die Rechnung samt Ensemble zu den Eingaben; ein laufendes Ensemble endet vorher.</summary>
    private void EnsembleStarten(bool konstruktorFolgen)
    {
        LaufVerwerfen();
        var quelle = new CancellationTokenSource();
        _lauf = quelle;
        _aktuell = false;
        _ = EnsembleLaufen(quelle, _eingabe.Kopie(), konstruktorFolgen);
    }

    /// <summary>
    /// Der Lauf: Der Delegat der Hülle rechnet auf einem Arbeitsfaden; das Ergebnis kommt über
    /// <c>InvokeAsync</c> in den Verteiler. Ein überholter Lauf hinterlässt nichts; ein
    /// abgebrochener schaltet „Stochastisch rechnen" aus und rechnet deterministisch nach. Jede
    /// Ausnahme bleibt hier — ein loser Task erreichte die Fehlerschranke nicht.
    /// </summary>
    private async Task EnsembleLaufen(CancellationTokenSource quelle, ZapfprofilAuslegungEingabeDaten kopie, bool konstruktorFolgen)
    {
        ZapfprofilAuslegungDaten? ergebnis = null;
        bool abgebrochen = false;
        try
        {
            ergebnis = await StochastischRechnen!(kopie, quelle.Token);
        }
        catch (OperationCanceledException) { abgebrochen = true; }
        catch (Exception ex)
        {
            ergebnis = new ZapfprofilAuslegungDaten
            {
                Zustand = ZapfprofilAuslegungZustand.Abgebrochen,
                Grund = ex.Message,
                Status = Format(Texte.StatusOhne, ex.Message)
            };
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!ReferenceEquals(_lauf, quelle)) return;
                _lauf = null;
                if (abgebrochen) EnsembleAbgebrochen();
                else ErgebnisSetzen(ergebnis, konstruktorFolgen);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* die Überlagerung ist gegangen */ }
        finally { quelle.Dispose(); }
    }

    /// <summary>„Abbrechen" am Fortschritt: Das Ensemble endet zwischen zwei Realisierungen.</summary>
    private void EnsembleAbbrechen()
    {
        try { _lauf?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>
    /// Nach dem Abbruch: „Stochastisch rechnen" ist wieder aus (sein Feld verschwindet samt
    /// Fehleingabe), eine leise Zeile sagt es, und die Karten rechnen deterministisch nach.
    /// </summary>
    private void EnsembleAbgebrochen()
    {
        _eingabe.Stochastisch = false;
        _fehlfelder.Remove(Texte.LabelRealisierungen);
        DeterministischRechnen(konstruktorFolgen: false);
        _hinweis = Texte.HinweisEnsembleAbgebrochen;
    }

    /// <summary>Verwirft ein laufendes Ensemble — es gehört zu alten Eingaben.</summary>
    private void LaufVerwerfen()
    {
        CancellationTokenSource? offen = _lauf;
        _lauf = null;
        if (offen is null) return;
        try { offen.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>
    /// Regel 4.5: Ohne konstruierten Tag öffnet die Auslegung den Konstruktor, statt still das
    /// Stundenprofil zu nehmen — wenn der Fall NEU eintritt (beim Öffnen oder nach einer
    /// Neuberechnung, die ihn herbeiführt), nicht nach jedem Abbrechen erneut. Ohne
    /// Konstruktor-Delegat bleibt es beim Eintrag der Warnliste.
    /// </summary>
    private bool KonstruktorFaellig(ZapfprofilAuslegungDaten? vorher, ZapfprofilAuslegungDaten? neu)
        => Konstruieren is not null && OhneTag(neu) && !OhneTag(vorher);

    private static bool OhneTag(ZapfprofilAuslegungDaten? d) => d is not null && d.Gruppen.Any(g => g.KonstruktorOeffnen);

    // =================================================================================
    // Der Hilfe-Assistent (Welle #458, Stufe 3a)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private ZapfprofilAuslegungKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten auf die EINGABEN der Auslegung und den empfohlenen Punkt.
    /// Gesetzt wird auf den Wegen der Eingabefelder — jede Setzung rechnet die Karten
    /// entprellt neu, mit „Stochastisch rechnen" nebenläufig samt Ensemble.
    /// </summary>
    private ZapfprofilAuslegungKiSicht KiSicht() => _kiSicht ??= new ZapfprofilAuslegungKiSicht
    {
        BedarfstagLesen = () => BedarfstagAuswahl,
        BedarfstagSetzen = KiBedarfstag,
        BedarfstagEintraege = () => KiMaskenanmeldung.Eintraege(Bedarfstagwahl, e => e.Id, e => e.Text),

        SpeichertemperaturLesen = () => _eingabe.SpeicherC,
        SpeichertemperaturSetzen = w => KiWeg(() => this.SpeicherCSetzen(w)),
        ErzeugerleistungLesen = () => _eingabe.ErzeugerKw,
        ErzeugerleistungSetzen = w => KiZahl(Texte.LabelErzeugerleistung, w, 0, null, () => this.ErzeugerSetzen(w)),
        UebertragerleistungLesen = () => _eingabe.UebertragerKw,
        UebertragerleistungSetzen = w => KiZahl(Texte.LabelUebertragerleistung, w, 0, null, () => this.UebertragerSetzen(w)),

        SpeicherartLesen = () => (int)_eingabe.Speicherart,
        SpeicherartSetzen = id => KiWeg(() => this.SpeicherartSetzen(id)),
        SpeicherartEintraege = () => KiMaskenanmeldung.Eintraege(Speicherarten, e => e.Id, e => e.Text),
        SensorhoeheLesen = () => _eingabe.SensorhoeheAnteil,
        SensorhoeheSetzen = w => KiZahl(Texte.LabelSensorhoehe, w, 0, 1, () => this.SensorSetzen(w)),
        ErzeugerartLesen = () => (int)_eingabe.Erzeugerart,
        ErzeugerartSetzen = id => KiWeg(() => this.ErzeugerartSetzen(id)),
        ErzeugerartEintraege = () => KiMaskenanmeldung.Eintraege(Erzeugerarten, e => e.Id, e => e.Text),
        WerkstoffLesen = () => (int)_eingabe.Werkstoff,
        WerkstoffSetzen = id => KiWeg(() => this.WerkstoffSetzen(id)),
        WerkstoffEintraege = () => KiMaskenanmeldung.Eintraege(Werkstoffe, e => e.Id, e => e.Text),

        StochastischLesen = () => _eingabe.Stochastisch,
        StochastischSetzen = an => KiWeg(() => this.StochastischSetzen(an)),
        PerzentilLesen = () => PerzentilAuswahl,
        PerzentilSetzen = KiPerzentil,
        PerzentilEintraege = () => KiMaskenanmeldung.Eintraege(Perzentilwahl, e => e.Id, e => e.Text),
        RealisierungenLesen = () => _eingabe.RealisierungenAuslegung,
        RealisierungenSetzen = KiRealisierungen,

        PunktLesen = () => _ergebnis?.Punktgruppe is { } g ? Punkttext(g) : "",

        // Die Eingaben des Verfahrensvergleichs (Z4, Gruppe 2b) — dieselben Wege und Grenzen wie die Felder.
        AutoManuellEintraege = () => KiMaskenanmeldung.Eintraege(AutoManuell, e => e.Id, e => e.Text),
        LadeleistungModusLesen = () => _eingabe.LadeAuto ? AUTO : MANUELL,
        LadeleistungModusSetzen = id => KiAutoManuell(Texte.LabelLadeleistung, id, LadeModusSetzen),
        LadeleistungManuellLesen = () => _eingabe.LadeManuellKw,
        LadeleistungManuellSetzen = w => KiZahl(Texte.LabelLadeManuell, w, 0, null, () => this.LadeManuellSetzen(w)),
        LadefensterLesen = () => _eingabe.LadefensterH,
        LadefensterSetzen = w => KiZahl(Texte.LabelLadefenster, w, 0, 24, () => this.LadefensterSetzen(w)),
        LadefensterBeginnLesen = () => _eingabe.LadefensterBeginnH,
        LadefensterBeginnSetzen = w => KiZahl(Texte.LabelLadefensterBeginn, w, 0, 24, () => this.LadefensterBeginnSetzen(w)),
        NutzanteilLesen = () => _eingabe.Nutzanteil,
        NutzanteilSetzen = w => KiZahl(Texte.LabelNutzanteil, w, 0, 1, () => this.NutzanteilSetzen(w)),
        ZuschlagLesen = () => _eingabe.Zuschlag,
        ZuschlagSetzen = w => KiZahl(Texte.LabelZuschlag, w, 0, null, () => this.ZuschlagSetzen(w)),
        PersonenModusLesen = () => _eingabe.PersonenAuto ? AUTO : MANUELL,
