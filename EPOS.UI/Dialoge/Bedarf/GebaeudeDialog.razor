    protected override void OnInitialized()
    {
        // Der Filterstand je Katalog ueber die Sitzung - derselbe Eintrag wie in der
        // Gebaeudeverwaltung (Schluessel des Profils, "GEBAEUDE").
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Profil.Schluessel);

        KatalogLaden();
        ProjektauswahlNachziehen();

        // NP2b-5a: dazu die Einheit der Außenluft des Blatts „Nutzungsprofile" im Importdialog (np_luft_einheit).
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE, () => KiSicht(), KiHaken(),
                                          (WindowsFormsApplication1.KiNutzungsprofilfelder.LUFT_EINHEIT,
                                           () => WindowsFormsApplication1.KiNutzungsprofilfelder.Lufteinheiten));
    }

