    private void SchrittGewaehlt(string schluessel)
    {
        _schritt = schluessel;
        _eingabefehler = "";
        if (schluessel == AuslegungSchritt.Betrieb) PeakVorschlagHolen();
    }

    private void SchrittVerweigert(string schluessel)
    {
        if (schluessel == AuslegungSchritt.Ergebnis) _meldungErfolg = false;
        _meldung = ErgebnisGesperrtText;
    }

    private void ModusGewaehlt(int? wert)
    {
        if (!wert.HasValue || _laeuft) return;
        _modus = wert.Value == (int)AuslegungModus.Einzelspeicher
            ? AuslegungModus.Einzelspeicher : AuslegungModus.Flotte;

        // Die zwei Pfade rechnen getrennt (SD-Q2): Ein Ergebnis des einen sagt ueber
        // den anderen nichts, und der Ergebnisschritt bleibt deshalb zu, bis dieser
        // Modus selbst gerechnet hat.
        if (_schritt == AuslegungSchritt.Ergebnis && !ErgebnisDa) _schritt = AuslegungSchritt.Speicher;
        _meldung = "";
        _fehler = "";
    }

