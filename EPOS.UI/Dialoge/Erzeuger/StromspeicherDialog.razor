@* Verwaltung Stromspeicher - der PROJEKTDIALOG (iU9-W6.6).

   VORBILD. Views/Stromspeicher/Form_Stromspeicher (354 Z.). Dasselbe Muster wie Heizkessel und
   BHKW: oben die Speicher im Projekt, darunter der Katalog, unten die Detailzeile „gewaehlter
   Satz".

   KATALOGAUSWAHL V1, STUFE 3 (Konzept Projektdialoge mit Katalogauswahl 4.2, 4.6, 4.9):
   Summe kWh in der Projekt-Kopfleiste, Bearbeiten… und „In die Datenbank übernehmen…" im
   Projekt, Vergleichen…, Schloss…, Loeschen, Bearbeiten… im Katalogfuss (ohne Neu… - neu
   angelegt wird im Katalogeditor), Kostenknoepfe und Energietraeger nur beim Projektsatz.

   DREI UNTERSCHIEDE ZUM BHKW.
   * Keine Traegervariante vor dem Hinzufuegen: Der Speicher bekommt den Stromtraeger des
     Projekts, gewaehlt wird er beim Projektsatz in der Gliederung Gruppe > Art (ET-5).
   * JE KLICK EINE EIGENE ZEILE (AP2b): zweimal derselbe Speicher sind zwei Anlagen - Varianten,
     die sich die Projektkopie teilen. Die Detailzeile des Projektsatzes liest deshalb die
     Projektkopie ueber die Geraete-ID, nicht ueber den Namen der Zeile.
   * Der Katalogeditor ist der Modulkatalog (ModulKatalogDialog) mit dem gewaehlten Satz
     vorgewaehlt; er traegt selbst Neu…, Duplizieren… und Loeschen.

   ENTSCHEID #76 (05.09.2026). Die zwei Listen stehen im Baustein Zweispaltenauswahl - EIN
   Aufbau fuer alle Projekt/Datenbank-Dialoge des Hauses. *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Kosten
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* KONTEXT IM DIALOGKOPF (Katalogauswahl V1, 4.1 und 4.8). *@
    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <span class="epos-dialog-kontext" title="@KopfbandText">@KopfbandText</span>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="Abbrechen" />
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }
    @* KT-3: Wirft das Lesen der Katalogliste, nennt dieser Banner den Grund (Katalogladung). *@
    @if (!string.IsNullOrEmpty(_listeFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_listeFehler" />
    }
    @* KT-4: Wirft das Lesen des gewählten Satzes, nennt dieser Banner den Grund (Katalogladung.Satz). *@
    @if (!string.IsNullOrEmpty(_satzFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_satzFehler" />
    }

    @* P = Kopfleiste „Im Projekt" (Summe kWh, Bearbeiten…, In die Datenbank übernehmen…,
       Entfernen), K = Kopf- und Fussleiste des Katalogs, S = Detailzeile „gewaehlter Satz",
       D = Kopf und Fuss des Dialogs. Beide Listen fuehren eine Mehrfachwahl. *@
    <Zweispaltenauswahl Dialogname="Stromspeicher" LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                        KatalogZeile="@((int)Katalogliste.ZEILENHOEHE_ZEILENWAHL)"
                        UebernehmenText="@LabelHinzu"
                        UebernehmenGesperrt="@(KatalogZiele().Count == 0)" Uebernehmen="BeiHinzu"
                        EntfernenText="@LabelEntfernen"
                        EntfernenGesperrt="@(ProjektZiele().Count == 0)" Entfernen="BeiEntfernen"
                        ProjektWahl="@_projektWahl" ProjektSichtbar="@ProjektSchluessel()"
                        KatalogWahl="@_katalogWahl" KatalogSichtbar="@KatalogSichtbar()"
                        WahlGeaendert="BeiWahlGeaendert"
                        KatalogFussName="@_katalogZeile?.Bezeichner"
                        SatzArt="@SatzArt" SatzName="@SatzName" SatzKenndaten="@SatzKenndaten"
                        SatzNurLesen="@(!FelderSpeicherbar)" SatzUebernehmenGesperrt="@_feldFehler"
                        SatzFehler="@_satzUeberlagerungFehler" SatzVergroessert="BeiSatzVergroessert"
                        SatzUebernommen="BeiSatzUebernommen" SatzVerworfen="BeiSatzVerworfen"
                        SatzZusammenfassung="@Zusammenfassung()"
                        @ref="_zweispalten">

        <ProjektKopf>
            @if (SummeKapazitaet is not null)
            {
                <span class="epos-zweispalten-summe">@LabelSumme <b>@_summeText</b></span>
            }
        </ProjektKopf>

        <Leistenzusatz>
            @if (ProjektsatzWege is not null)
            {
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--bearbeiten-projekt"
                        title="@Resource.AUSWAHL_BTN_BEARBEITEN_PROJEKT_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiProjektBearbeiten">@Resource.AUSWAHL_BTN_BEARBEITEN</button>
            }
            @if (RueckwegWege is not null)
            {
                @* KA-E-9: der Rueckweg in die Datenbank, wirksam auf die Auswahl der Projektliste. *@
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--rueckweg"
                        title="@Resource.KATRUECK_BTN_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiRueckweg">@Resource.KATRUECK_BTN</button>
            }
        </Leistenzusatz>

        <Links>
            <Raster TZeile="ErzeugerZeile" Zeilen="@Zeilen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="ErzeugerZeile" Class="epos-spalte-kaestchen">
                        <HeaderTemplate>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" />
                        </HeaderTemplate>
                        <ChildContent>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" Schluessel="@Projektschluessel(context)"
                                           Kurztext="@context.Bezeichner" />
                        </ChildContent>
                    </TemplateColumn>
                    <TemplateColumn TGridItem="ErzeugerZeile" Title="@SpalteWahl">
                        <Zeilenwahl Gewaehlt="@(_projektZeile == context)" Kurztext="@SpalteWahl"
                                    Gewaehltwerden="() => ProjektZeileKlick(context)" />
                    </TemplateColumn>
                    <PropertyColumn TGridItem="ErzeugerZeile" TProp="string"
                                    Property="@(z => z.Bezeichner)" Title="@LabelProjektliste" />
                    @* UeS2: der Stift je Projektzeile - die Projektkopie in der Satz-Ueberlagerung;
                       nur, wo es den Weg der Projektkopie gibt (wie „Bearbeiten…"). *@
                    @if (ProjektsatzWege is not null)
                    {
                        <TemplateColumn TGridItem="ErzeugerZeile" Class="epos-spalte-stift">
                            <HeaderTemplate>
                                <Zeilenstift Kopf="true" />
                            </HeaderTemplate>
                            <ChildContent>
                                <Zeilenstift Hinweis="@Resource.AUSWAHL_BTN_BEARBEITEN_PROJEKT_HINWEIS"
                                             Geklickt="@(() => BeiProjektStift(context))" />
                            </ChildContent>
                        </TemplateColumn>
                    }
                </KindInhalt>
            </Raster>
        </Links>

        <Rechts>
            @* DIE EINE KATALOGLISTE (W14a-E-10) im Kaestchenmodus: Die Zeile ist die Wahl
               (Detailzeile), das Kaestchen waehlt mehrere fuer die Bereichsaktionen. *@
            <Katalogliste @ref="_katalogliste" Profil="@Katalogprofil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_katalogGewaehlt" GewaehltChanged="KatalogZeileWaehlen"
                          Vergleichsparameter="@Vergleichsparameter"
                          ZeileIstWahl="true" Kaestchen="true" Gewaehlte="@_katalogKaestchen"
                          GewaehlteChanged="BeiKatalogKaestchen" Gefiltert="BeiGefiltert"
                          Bearbeiten="BeiKatalogStift" BearbeitenHinweis="@Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS" />
        </Rechts>

        <KatalogFuss>
            <button type="button" class="epos-knopf epos-knopf--vergleichen"
                    title="@Resource.AUSWAHL_BTN_VERGLEICHEN_HINWEIS"
                    disabled="@(KatalogZiele().Count < 2)" @onclick="BeiVergleichen">@Resource.AUSWAHL_BTN_VERGLEICHEN</button>
            <Katalogschloss @ref="_katalogschloss" Weg="@Schloss" Zeile="@_katalogZeile"
                            Ungespeichert="@_felderGeaendert" JaText="@JaText" NeinText="@NeinText"
                            Geschaltet="BeiSchlossGeschaltet" Abgelehnt="BeiSchlossAbgelehnt" />
            @if (KatalogLoeschen is not null)
            {
                <button type="button" class="epos-knopf epos-knopf--loeschen" disabled="@(KatalogZiele().Count == 0)"
                        @onclick="BeiLoeschenGefragt">@BtnLoeschenText</button>
            }
            <button type="button" class="epos-knopf epos-knopf--bearbeiten-katalog"
                    title="@(KatalogZiele().Count > 0 && KatalogZiele().All(z => z.Geschuetzt) ? Resource.ADM_SCHLOSS_ERST_AUFHEBEN : Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS)"
                    disabled="@(KatalogZiele().Count == 0)" @onclick="BeiKatalogBearbeiten">@BtnBearbeitenText</button>
        </KatalogFuss>

        <SatzKopfKnoepfe>
            @* DIE INFOKNOEPFE IM KOPF DER DETAILZEILE (UeS2b): ohne Ueberlagerung erreichbar; in ihr
               stehen sie in der Knopfzeile des Fragments (der Baustein zeigt je Ansicht eine Stelle). *@
            <span class="epos-berechnungshilfe">
                <InfoKnopf Schluessel="Form_Stromspeicher.Grundlagen"
                           StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
                <InfoKnopf Schluessel="Form_Stromspeicher.Berechnung"
                           StandardKurztext="Berechnungsweg Stromspeicher" MitAssistent="false" />
            </span>
        </SatzKopfKnoepfe>

        <Satz>
        @* DIE KNOPFZEILE DER SATZFLAECHE: beim Projektsatz die Kostenknoepfe (KA-E-12),
           rechts der Weg in die Wikirubriken Grundlagen und Berechnung - die Geraetewerte,
           die die Speicherengine als Parametersatz liest. *@
        <div class="epos-leiste">
            @if (!Wizard && _projektZeile is not null)
            {
                <KostenKnoepfeLeiste KostenOeffnen="@KostenLeiste" EnergiekostenOeffnen="@EnergieLeiste"
                                     InvestText="@KostenInvestText" BetriebText="@KostenBetriebText"
                                     EnergieText="@KostenEnergieText" />
            }
            <span class="epos-leiste-fueller"></span>
            <span class="epos-berechnungshilfe">
                <InfoKnopf Schluessel="Form_Stromspeicher.Grundlagen"
                           StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
                <InfoKnopf Schluessel="Form_Stromspeicher.Berechnung"
                           StandardKurztext="Berechnungsweg Stromspeicher" MitAssistent="false" />
            </span>
        </div>

        @if (_projektZeile is null && _katalogZeile is null)
        {
            <p class="epos-zweispalten-satzleer">@Resource.AUSWAHL_SATZ_LEER</p>
        }
        else
        {
            <Formularraster>
                <KindInhalt>
                <Textfeld Bezeichnung="@LabelName" Wert="@_detail.Bezeichner" NurLesen="true" />
                @foreach (var feld in _detail.Felder)
                {
                    <Textfeld Bezeichnung="@feld.Feld" Wert="@feld.Wert" NurLesen="true"
                              Kurz="@ErzeugerDetail.IstZahl(feld.Wert)" />
                }
                @* ET-5: der Energietraeger der PROJEKTzeile (4.2: S aufgeklappt, nur Projektsatz). *@
                @if (_projektZeile is not null && Traegerkatalog.Count > 0)
                {
                    <EnergietraegerWahl Eintraege="@Traegerkatalog"
                                        LabelGruppe="@LabelTraegerGruppe" LabelArt="@LabelTraegerArt"
                                        Auswahl="@(_projektZeile.CarrierId > 0 ? _projektZeile.CarrierId : null)"
                                        AuswahlChanged="BeiTraegerwechsel" />
                }
                </KindInhalt>
            </Formularraster>

            @* ALLE DATEN DES GEWAEHLTEN SATZES, aufklappbar und BEARBEITBAR: beim Katalogsatz der
               Katalog (gesperrt nur lesen), beim Projektsatz die Projektkopie - dieselben Felder
               samt den vier Kostenposten. *@
            @if (AlleDatenDa)
            {
                <div class="epos-modulparameter">
                    <button type="button" class="epos-modulparameter-knopf"
                            aria-expanded="@(_parameterOffen ? "true" : "false")"
                            @onclick="ParameterUmschalten">
                        <span class="epos-modulparameter-pfeil" aria-hidden="true">@(_parameterOffen ? "▾" : "▸")</span>
                        <span>@LabelAlleParameter</span>
                    </button>

                    @if (_parameterOffen && _felder is not null)
                    {
                        @if (KatalogsatzGesperrt)
                        {
                            <p class="epos-satzbearbeitung-hinweis" role="note">@Resource.SATZBEARB_NUR_LESEN @Resource.ADM_SCHLOSS_ERST_AUFHEBEN</p>
                        }
                        <Katalogfelder Felder="@_felder" NurLesen="@(!FelderSpeicherbar)"
                                       Geaendert="FeldGeaendert"
                                       FehlerZustand="BeiFeldFehler" />
                        @* Gespeichert wird ueber das OK der Satz-Ueberlagerung - das Fragment steht nur dort (UeS2). *@
                    }
                </div>
            }
        }
        </Satz>
    </Zweispaltenauswahl>

    @if (!Wizard)
    {
        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }

    @* --- Ueberlagerung 1: der Katalogeditor (ein ungesperrter Katalogsatz, KA-E-13) --- *@
    <Ueberlagerung Offen="@(_editorGaben is not null)" Schliessbar="false"
                   Titel="" Geschlossen="() => EditorFertig(null)">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                <ModulKatalogDialog @attributes="_editorGaben" Geschlossen="EditorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 2: Bearbeiten… je Bereich, auch mehrere Saetze (4.6) ---- *@
    <Ueberlagerung Offen="@(_bearbeitung is not null)"
                   Titel="@(_bearbeitung is null ? "" : Satzbearbeitungsregel.Titel(_bearbeitung.Value.Art, _bearbeitung.Value.Saetze))"
                   Kopfzusatz="@(_bearbeitung?.Art == Satzmarke.Projektsatz ? MarkeProjektsatz : MarkeKatalogsatz)"
                   Geschlossen="() => BearbeitungFertig(false)">
        <KindInhalt>
            @if (_bearbeitung is { } b)
            {
                <Satzbearbeitung Art="@b.Art" Saetze="@b.Saetze"
                                 Wege="@(b.Art == Satzmarke.Projektsatz ? ProjektsatzWege : KatalogsatzWege)"
                                 Geschlossen="BearbeitungFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 3: Rueckfrage „In die Datenbank übernehmen…" (5.2, KA-E-9) - immer vor dem Schreiben *@
    <Ueberlagerung Offen="@(_rueckweg is not null)"
                   Titel="@(_rueckweg is null ? "" : Rueckwegregel.Titel(_rueckweg))"
                   Kopfzusatz="@MarkeKatalogsatz" Geschlossen="() => RueckwegFertig(null)">
        <KindInhalt>
            @if (_rueckweg is not null && RueckwegWege is not null)
            {
                <Rueckwegfrage Zeilen="@_rueckweg" Wege="@RueckwegWege" BleibtText="@RueckwegBleibtText"
                               Geschlossen="RueckwegFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Rueckfrage vor dem Loeschen aus dem KATALOG ------------------------- *@
    <Rueckfrage Offen="@_loeschfrage" TitelText="@TitelLoeschen" JaText="@JaText" NeinText="@NeinText"
                Frage="@LoeschfrageText" Beantwortet="BeiLoeschfrage" />
</div>

@code {
    /// <summary>Die Speicher im Projekt (Projektliste) — sie gehört der Hülle und wird in place bearbeitet.</summary>
    [Parameter] public List<ErzeugerZeile> Zeilen { get; set; } = new();

    /// <summary>Das Profil der Katalogliste (<c>Katalogfilterprofil.MitVerwendung(Anlagenart.Stromspeicher, …)</c>).</summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Zeilen des Vergleichs je Satzname (W14a-E-10, S3.3).</summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Vergleichsparameter { get; set; }

    /// <summary>Die Zeilen der Katalogliste, ungefiltert; nach jeder Katalogpflege neu erfragt.</summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Der Filterstand des Katalogs für die Sitzung (S2.5); leer = Register.</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>Der Detailblock eines Katalogsatzes nach Namen.</summary>
    [Parameter] public Func<string, ErzeugerDetail?>? KatalogDetail { get; set; }

    /// <summary>
    /// Der Detailblock einer Projektzeile — aus der Projektkopie über die Geräte-ID (im Assistenten aus dem
    /// Katalog). Die Zeile, nicht ihr Name: Varianten desselben Speichers tragen eigene Namen.
    /// </summary>
    [Parameter] public Func<ErzeugerZeile, ErzeugerDetail?>? ProjektDetail { get; set; }

    /// <summary>Nimmt den Speicher auf — je Klick eine EIGENE Zeile.</summary>
    [Parameter] public Func<int, AufnahmeErgebnis>? Aufnehmen { get; set; }

    /// <summary>Entfernt die Zeile aus der geteilten Liste.</summary>
    [Parameter] public Action<ErzeugerZeile>? Entfernen { get; set; }

    /// <summary>ET‑5 (08.09.2026): der Trägerkatalog in der Gliederung Gruppe › Art; leer = kein Feld.</summary>
    [Parameter] public IReadOnlyList<EnergietraegerWahl.Eintrag> Traegerkatalog { get; set; }
        = Array.Empty<EnergietraegerWahl.Eintrag>();

    /// <summary>Die markierte Anlage bekommt einen anderen Energieträger (Zeile, Träger-Id).</summary>
    [Parameter] public Action<ErzeugerZeile, int>? TraegerWechseln { get; set; }

    [Parameter] public string LabelTraegerGruppe { get; set; } = "Energieträger:";
    [Parameter] public string LabelTraegerArt { get; set; } = "Art:";

    /// <summary>Die Summe der Kapazitäten der Projektliste, fertig formatiert; <c>null</c> = keine Summe.</summary>
    [Parameter] public Func<string>? SummeKapazitaet { get; set; }

    /// <summary>
    /// Die Gaben des Katalogeditors (Modulkatalog) mit dem Satz vorgewählt — „Bearbeiten…" auf einen einzelnen
    /// ungesperrten Katalogsatz (KA-E-13). Ohne Delegat öffnet auch ein einzelner Satz die Satzbearbeitung.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyDictionary<string, object>>? EditorGaben { get; set; }

    /// <summary>Löscht einen Katalogsatz (KA-E-16 samt Satzvorlage); leer = gelöscht, sonst der Grund. <c>null</c> = kein Knopf.</summary>
    [Parameter] public Func<int, string>? KatalogLoeschen { get; set; }

    /// <summary>
    /// Die Wege der Satzbearbeitung für die PROJEKTKOPIEN (KA-E-8): Lesen nach Geräte-ID, Speichern aller Sätze in
    /// einer Transaktion. <c>null</c> = kein Knopf „Bearbeiten…" in der Projekt-Kopfleiste (Assistent).
    /// </summary>
    [Parameter] public Satzbearbeitungswege? ProjektsatzWege { get; set; }

    /// <summary>Die Wege der Satzbearbeitung für mehrere oder gesperrte KATALOGsätze.</summary>
    [Parameter] public Satzbearbeitungswege? KatalogsatzWege { get; set; }

    /// <summary>Die Wege des Rückwegs „In die Datenbank übernehmen…" (KA-E-9); <c>null</c> = kein Knopf.</summary>
    [Parameter] public Rueckwegwege? RueckwegWege { get; set; }

    /// <summary>Was im Projekt bleibt - der Hinweis der Rückfrage.</summary>
    [Parameter] public string RueckwegBleibtText { get; set; } = "";

    /// <summary>Assistentenbetrieb: keine OK/Abbrechen-Leiste, keine Kostenknöpfe.</summary>
    [Parameter] public bool Wizard { get; set; }

    /// <summary><c>true</c> = OK, <c>false</c> = Abbrechen.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    /// <summary>Öffnet Investitions- (<c>false</c>) oder Betriebskosten (<c>true</c>) der gewählten Projektzeile.</summary>
    [Parameter] public Func<ErzeugerZeile?, bool, Task>? KostenOeffnen { get; set; }

    /// <summary>Öffnet die Energiekosten der gewählten Projektzeile.</summary>
    [Parameter] public Func<ErzeugerZeile?, Task>? EnergiekostenOeffnen { get; set; }

    [Parameter] public string KostenInvestText { get; set; } = "Investitionskosten…";
    [Parameter] public string KostenBetriebText { get; set; } = "Betriebskosten…";

    /// <summary>
    /// <b>Invest- und Betriebskosten einer Projektzeile</b> für die Zusammenfassung der
    /// Detailzeile (UeS2) — die Summen der Kostenverwaltung dieser Anlage in € bzw. €/a.
    /// <c>null</c> (Assistent, kein Projekt): die Zusammenfassung nennt keine Kosten.
    /// </summary>
    [Parameter] public Func<ErzeugerZeile, (double Invest, double Betrieb)>? Kostensumme { get; set; }
    [Parameter] public string KostenEnergieText { get; set; } = "Energiekosten…";

    /// <summary>Die Felder des Aufklappers „Alle Daten" eines Katalogsatzes (dieselben wie im Modulkatalog).</summary>
    [Parameter] public Func<string, IReadOnlyList<BrowserFeldwert>?>? Katalogfelder { get; set; }

    /// <summary>Schreibt die Felder des Aufklappers in den Katalogsatz; ein gesperrter Satz wird nie geschrieben.</summary>
    [Parameter] public Func<string, IReadOnlyList<BrowserFeldwert>, KatalogSpeicherErgebnis>? KatalogfelderSpeichern { get; set; }

    // --- Texte -----------------------------------------------------------------
    [Parameter] public string TitelText { get; set; } = "Verwaltung Stromspeicher";
    [Parameter] public string KopfbandText { get; set; } = "Geben Sie Daten der Stromspeicher ein";
    [Parameter] public string LabelProjektliste { get; set; } = "ausgewählte Stromspeicher:";
    [Parameter] public string LabelKatalogliste { get; set; } = "Stromspeicher aus Datenbank:";
    [Parameter] public string SpalteWahl { get; set; } = "Wahl";
    [Parameter] public string LabelHinzu { get; set; } = "In das Projekt übernehmen";
    [Parameter] public string LabelEntfernen { get; set; } = "Aus dem Projekt entfernen";
    [Parameter] public string LabelSumme { get; set; } = "Summe aller ausgewählten Speicher [kWh]:";
    [Parameter] public string BtnBearbeitenText { get; set; } = "Bearbeiten...";
    [Parameter] public string BtnLoeschenText { get; set; } = "Löschen";
    [Parameter] public string LabelAlleParameter { get; set; } = "Alle Daten anzeigen";
