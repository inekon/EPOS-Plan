    protected override void OnInitialized()
    {
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Katalogprofil?.Art ?? Anlagenart.Solarkollektoren);
        KatalogNeuLaden();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);

        // Welle KI-F1 / #460: die Sichtklasse mit dem Arbeitsstand und „Alle Daten".
        _kiMaske = KiMaskenanmeldung.Fuer(
            KiMaskennamen.SOLARKOLLEKTOREN_PROJEKT, () => KiSicht(), KiHaken());
    }

    private SolarkollektorenKiSicht? _kiSicht;

    private SolarkollektorenKiSicht KiSicht() => _kiSicht ??= new SolarkollektorenKiSicht
    {
        Eingabenquelle = () => _projektZeile is null ? null : _eingaben,
        // Meldung 10.10.2026: ohne gewählte Zeile wählt der Assistent die EINZIGE wie das
        // Öffnen; bei mehreren rät er nicht, und die Sicht lehnt benannt ab.
        // Die Zeilenzahl sagt dem Sperrgrund, ob die Einzelwahl greift (genau eine Zeile).
        Zeilenzahl = () => Zeilen.Count,
        Einzelwahl = () =>
        {
            if (_projektZeile is null && Zeilen.Count == 1) ProjektZeileWaehlen(Zeilen[0]);
            return _projektZeile is null ? null : _eingaben;
        },
        AlleDaten = new AlleDatenTafel
        {
            Felder = () => _parameterOffen ? _felder : null,
            Sperrgrund = () => AlleDatenTafel.Grund(_parameterOffen ? _felder : null,
                                                    _projektZeile is not null ? ProjektsatzWege?.Speichern is not null
                                                                              : KatalogfelderSpeichern is not null,
                                                    _katalogZeile?.Geschuetzt == true),
            Gesetzt = () => _felderGeaendert = true
        }
    };

    private KiMaskenanmeldung? _kiMaske;

    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _projektZeile?.NurLesen ?? false,
        // Sperrgrund je Feld vor der Bestätigung: Energieträger nur von Hand, ohne gewählte
        // Zeile (und ohne Einzelwahl) keine Zeilenfelder.
        Sperrgrund = f => KiSicht().Sperrgrund(f),
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>
    /// „speichern" des Assistenten: geänderte Felder in „Alle Daten" über denselben Weg wie der
    /// Knopf, sonst der Arbeitsstand der Anlagenfelder über „Übernehmen".
    /// </summary>
    private KiKern.KiErgebnis KiSpeichern()
    {
        if (!_felderGeaendert) return KiUebernehmen();
        FelderSpeichern();
        return _felderGeaendert
            ? KiKern.KiErgebnis.Abgelehnt(_meldung.Length > 0 ? _meldung
                  : Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText))
            : KiKern.KiErgebnis.Ok(_felderErfolg, anzahl: 1);
    }

    private KiKern.KiErgebnis KiUebernehmen()
    {
        if (_projektZeile is null || Uebernehmen is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", TitelText));
        BeiUebernehmen();
        return KiKern.KiErgebnis.Ok(_projektZeile.Bezeichner, anzahl: 1);
    }

    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
