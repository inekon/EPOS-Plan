    /// <summary>
    /// DL-2 (Nr. 7): DER eine Schreibweg — erst die Stammwerte der Karte
    /// (Katalogkontext, DL-Q5), dann die Karte selbst. „Speichern" und „OK" gehen
    /// beide hier durch; die Prüfregeln stehen damit an einer Stelle.
    /// </summary>
    private bool SchreibenVersuchen()
    {
        if (!StammMitschreiben()) return false;

        if (Speichern is not null && !Speichern())
        {
            Melden(SpeichernGrund is null ? "" : SpeichernGrund(), WarnStufe.Warnung);
            return false;
        }
        return true;
    }

    /// <summary>
    /// „Speichern" der Preishistorie. Der Knopf ist nach einem gelungenen Speichern weich
    /// gesperrt: Ein Klick ohne neue Eingabe schreibt nicht, er nennt den Grund neben dem
    /// Knopf (dieselbe Regel wie „Speichern" der <c>SpeichernLeiste</c>).
    /// </summary>
    private void PreishistorieSpeichern()
    {
        if (_frischGespeichert)
        {
            _vermerk = Resource.ADM_TIP_SPEICHERN_UNVERAENDERT;
            _vermerkFehler = false;
            return;
        }
        BeiSpeichern();
    }

    private void BeiSpeichern()
    {
        if (!SchreibenVersuchen())
        {
            SpeichernGescheitert();
            return;
        }

        // Die Hülle hat die Preishistorie neu gelesen und den Übernahmehinweis
        // gelöscht; die Ansicht folgt, damit beides sofort dasteht.
        Nachziehen();
        // ET-5: Speichern kann den Träger dem Projekt ZUORDNEN (ET-3) — dann trägt
        // sein Listeneintrag die Marke „nicht zugeordnet" zu Unrecht weiter.
        ListeNachziehen();
        // Ein Träger ohne Preis oder CO₂-Wert lässt sich speichern — er wird dabei
        // aber benannt, nicht stillschweigend hingenommen.
        Melden(SpeichernHinweis is null ? "" : SpeichernHinweis(), WarnStufe.Hinweis);
        _status = string.Format(VorlageGespeichert, DateTime.Now.ToString("HH:mm"));
        // Der Vermerk steht dort, wo geklickt wurde: in der Leiste und am Knopf der
        // Preishistorie — derselbe Text wie SpeichernLeiste.Gespeichert().
        _vermerk = string.Format(Resource.ADM_STATUS_GESPEICHERT, DateTime.Now.ToString("T"));
        _vermerkFehler = false;
        _frischGespeichert = true;
        LeisteMelden(_vermerk, false);
    }

    private Task BeiOk()
    {
        if (!SchreibenVersuchen())
        {
            SpeichernGescheitert();
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(true);
    }

    /// <summary>
    /// Die Karte fragt, der Wirt schreibt und meldet — dieselbe Aufteilung wie
    /// beim Speichern. Ohne Rückruf bleibt der Löschknopf der Karte gesperrt.
    /// </summary>
    private Func<PreishistorieZeile, bool>? HistorienzeileLoeschenWeg
        => HistorieLoeschen is null ? null : HistorienzeileLoeschen;

    private bool HistorienzeileLoeschen(PreishistorieZeile zeile)
    {
        if (HistorieLoeschen is null) return false;

        if (!HistorieLoeschen(zeile))
        {
            Melden(HistorieLoeschenGrund is null ? "" : HistorieLoeschenGrund(),
                   WarnStufe.Warnung);
            return false;
        }

        // Die Hülle hat die Preishistorie neu gelesen; die Ansicht folgt, damit
        // die Tabelle sofort ohne die Zeile dasteht.
        Melden("");
        Nachziehen();
        return true;
    }

    private Task BeiAbbrechen() => Geschlossen.InvokeAsync(false);

    /// <summary>
    /// DL-2 (Nr. 7): Die <c>SpeichernLeiste</c> meldet OK und Abbrechen über EIN
    /// Ergebnis; die beiden Wege dahinter sind dieselben wie zuvor.
    /// </summary>
    private Task BeiErgebnis(bool ok) => ok ? BeiOk() : BeiAbbrechen();

    private void Melden(string text, WarnStufe stufe = WarnStufe.Hinweis)
    {
        _meldung = text;
        _meldungStufe = stufe;
    }

    private bool UeberlagerungOffen => _namensGaben is not null || _uebernahmeOffen
        || _unterGaben is not null || _frage.Length > 0 || _luecke is not null
        || _szenarioGaben is not null;

    // =====================================================================
    // ETAPPE E9b — die ±-Knöpfe der Preise (Konzept § 2.11.5, Pflege)
    // =====================================================================

    private IReadOnlyDictionary<string, object>? _szenarioGaben;
    private string _szenarioPreis = "";
    private string _szenarioTitel = "";

    /// <summary>Steht die Überlagerung eines Szenariopaars? (Prüfhilfe für Tests)</summary>
    public bool SzenarioOffen => _szenarioGaben is not null;

    /// <summary>Ein Text der Karte (<see cref="KarteTexte"/>) mit deutschem Rückfall.</summary>
    private string KartenText(string name, string rueckfall)
        => KarteTexte is not null && KarteTexte.TryGetValue(name, out object? t) && t is string s
           && s.Length > 0 ? s : rueckfall;

    /// <summary>
    /// ETAPPE E9b: „±" an einem Preis der Karte — der <c>CaseEingabeDialog</c> als
    /// Szenariopaar, mit dem Wert des Feldes als Erwartet-Wert, derselben Einheit und den
    /// Kohärenzzeilen der Karte. Der Arbeitspreis steht in der gewählten Preisbasis wie
    /// das Feld daneben; die Hülle rechnet beim Speichern zurück.
    /// </summary>
    private void SzenarioOeffnen(string preisart)
    {
        EnergietraegerStand? s = _ansicht.Stand;
        if (s is null || !s.MitSzenario) return;

        string feld;
        IReadOnlyDictionary<string, object> gaben;
        switch (preisart)
        {
            case EnergietraegerEinstellungen.PREIS_GRUND:
                feld = KartenText("LabelGrundpreis", "Grundpreis");
                gaben = Szenariopaar.Gaben(feld, feld + " " + s.TraegerName, s.EinheitGrundpreis,
                    s.Grundpreis, s.SzenarioGrundBest, s.SzenarioGrundWorst, 2, SZENARIO_MAX,
                    null, warnenOhneErwartet: false);
                break;
            case EnergietraegerEinstellungen.PREIS_LEISTUNG:
                feld = KartenText("LabelLeistungspreis", "Leistungspreis");
                gaben = Szenariopaar.Gaben(feld, feld + " " + s.TraegerName, s.EinheitLeistungspreis,
                    s.Leistungspreis, s.SzenarioLeistungBest, s.SzenarioLeistungWorst, 2, SZENARIO_MAX,
                    new[] { s.SzenarioLeistungOhneWirkung },
                    warnenOhneErwartet: s.SzenarioLeistungOhneErwartet);
                break;
            default:
                preisart = EnergietraegerEinstellungen.PREIS_ARBEIT;
                feld = KartenText("LabelArbeitspreis", "Arbeitspreis");
                gaben = Szenariopaar.Gaben(feld, feld + " " + s.TraegerName, s.EinheitArbeitspreis,
                    s.Arbeitspreis, s.SzenarioArbeitBest, s.SzenarioArbeitWorst, 4, SZENARIO_MAX,
                    null, warnenOhneErwartet: s.SzenarioArbeitOhneErwartet);
                break;
        }

        _szenarioPreis = preisart;
        _szenarioTitel = Szenariopaar.Titel(feld + " " + s.TraegerName);
        _szenarioGaben = gaben;
    }

    /// <summary>Obergrenze der Szenariopreise im Absolutmodus — die Felder der Karte
    /// selbst kennen keine.</summary>
    private const double SZENARIO_MAX = 10_000_000;

    /// <summary>
    /// ETAPPE E9b: Das Ergebnis des Szenariopaars auf die Karte legen — 0 heißt „wie
    /// Erwartet" (<see cref="Szenariopaar.Wert"/>). Geschrieben wird mit der Karte; danach
    /// rechnet die Hülle nach (Kennzeichen, Kohärenzzeilen, Basiswerte).
    /// </summary>
    private void SzenarioFertig(CaseEingabeErgebnis? ergebnis)
    {
        string preisart = _szenarioPreis;
        EnergietraegerStand? s = _ansicht.Stand;
        _szenarioGaben = null;
        _szenarioPreis = "";
        if (ergebnis is null || s is null) return;

        double? best = Szenariopaar.Wert(ergebnis.BestCase);
        double? worst = Szenariopaar.Wert(ergebnis.WorstCase);
        switch (preisart)
        {
            case EnergietraegerEinstellungen.PREIS_GRUND:
                s.SzenarioGrundBest = best;
                s.SzenarioGrundWorst = worst;
                break;
            case EnergietraegerEinstellungen.PREIS_LEISTUNG:
                s.SzenarioLeistungBest = best;
                s.SzenarioLeistungWorst = worst;
                break;
            default:
                s.SzenarioArbeitBest = best;
                s.SzenarioArbeitWorst = worst;
                break;
        }
        Nachziehen();
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Enter ist NICHT belegt (A-7 aus B5b); Esc geht zuerst an eine offene
        // Überlagerung — sie fängt die Taste selbst ab.
        if (e.Key != "Escape" || UeberlagerungOffen) return Task.CompletedTask;
        return BeiAbbrechen();
    }
