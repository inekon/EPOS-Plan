    /// stochastischen Laufs, sobald er dasteht, sonst das der Vorschau. Leer ohne Rechnung — die
    /// Karte sagt dann benannt „nichts zu vermerken". Die Reihenfolge ist die des Rechenwegs.
    /// </summary>
    private IReadOnlyList<ZapfprofilHerkunftZeile> Herkunftsliste
    {
        get
        {
            ZapfprofilVorschauDaten? quelle = !JahresreiheLaeuft && _stochastik is { Status.Length: > 0 } ? _stochastik : _vorschau;
            return quelle is { Zustand: ZapfprofilVorschauZustand.Gerechnet } v
                ? (IReadOnlyList<ZapfprofilHerkunftZeile>)v.Herkunft
                : Array.Empty<ZapfprofilHerkunftZeile>();
        }
    }

    /// <summary>Die Warnliste der aktuellen Vorschau; leer ohne.</summary>
    /// <summary>
    /// Die Warnliste der Bilanz — dazu die Hinweise des Vergleichs und der Kalibrierung (Stufe Z5).
    /// Sie stehen in DERSELBEN Liste: Ein Anwender sucht seine Hinweise an einer Stelle, nicht an
    /// drei. Die Reihenfolge ist stabil (Bilanz, Vergleich, Kalibrierung, Kalibriervorschlag).
    /// </summary>
    private IReadOnlyList<ZapfprofilWarnDaten> Warnliste
    {
        get
        {
            var liste = new List<ZapfprofilWarnDaten>();
            if (_vorschau is { Zustand: ZapfprofilVorschauZustand.Gerechnet } v) liste.AddRange(v.Warnliste);
            if (_vergleich is not null) liste.AddRange(_vergleich.Hinweise);
            if (_kalibrierung is not null) liste.AddRange(_kalibrierung.Hinweise);
            liste.AddRange(_vorschlagHinweise);
            return liste;
        }
    }

