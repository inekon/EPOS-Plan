using System;
using System.IO;
using System.Linq;
using ProjNet.CoordinateSystems;
using ProjNet.CoordinateSystems.Transformations;

public class TryExtractor
{
    // DWD LCC Projektionsparameter
    private const string DwdLccWkt = 
        "PROJCS[\"LCC_DWD\"," +
        "GEOGCS[\"WGS84\",DATUM[\"WGS_1984\",SPHEROID[\"WGS 84\",6378137,298.257223563]],PRIMEM[\"Greenwich\",0],UNIT[\"degree\",0.0174532925199433]]," +
        "PROJECTION[\"Lambert_Conformal_Conic_2SP\"]," +
        "PARAMETER[\"standard_parallel_1\",35]," +
        "PARAMETER[\"standard_parallel_2\",65]," +
        "PARAMETER[\"latitude_of_origin\",52]," +
        "PARAMETER[\"central_meridian\",10]," +
        "PARAMETER[\"false_easting\",0]," +
        "PARAMETER[\"false_northing\",0]," +
        "UNIT[\"meter\",1]]";

    public static void ExtractCityData(string filePath, double lat, double lon)
    {
        // 1. Koordinaten umrechnen (WGS84 -> DWD LCC)
        var ctFact = new CoordinateTransformationFactory();
        var wgs84 = GeographicCoordinateSystem.WGS84;
        var dwdLcc = new CoordinateSystemFactory().CreateFromWkt(DwdLccWkt);
        var transform = ctFact.CreateFromCoordinateSystems(wgs84, dwdLcc);

        double[] point = transform.MathTransform.Transform(new double[] { lon, lat });
        double xTarget = point[0];
        double yTarget = point[1];

        // 2. Header auslesen
        var lines = File.ReadLines(filePath);
        var header = lines.Take(6).Select(l => l.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries))
                          .ToDictionary(parts => parts[0].ToLower(), parts => double.Parse(parts[1]));

        // 3. Spalte und Zeile im Raster berechnen
        int col = (int)Math.Floor((xTarget - header["xllcorner"]) / header["cellsize"]);
        // Achtung: Rasterzeilen zählen von oben nach unten
        int row = (int)Math.Floor((header["yllcorner"] + (header["nrows"] * header["cellsize"]) - yTarget) / header["cellsize"]);

        if (col < 0 || col >= header["ncols"] || row < 0 || row >= header["nrows"])
        {
            Console.WriteLine("Fehler: Koordinaten liegen außerhalb des Datei-Rasters!");
            return;
        }

        // 4. Zielzeile berechnen (Header überspringen + Row * Spaltenanzahl + Col)
        int targetDataLineIndex = (int)(row * header["ncols"] + col);
        
        // Effizientes Auslesen der spezifischen Zeile
        string dataLine = File.ReadLines(filePath).Skip(6 + targetDataLineIndex).First();
        
        // In Werte-Array umwandeln (8760 Stundenwerte)
        double[] hourlyValues = dataLine.Split(new[] { ' ' }, StringSplitOptions.RemoveEmptyEntries)
                                        .Select(double.Parse)
                                        .ToArray();

        Console.WriteLine($"Extraktion erfolgreich für Position [{row},{col}].");
        Console.WriteLine($"Erster Wert (1. Jan, 01:00): {hourlyValues[0]}");
    }
}