    // Umschalten
    // =====================================================================

    /// <summary>
    /// Die Einträge des Katalogeinstiegs (Kapitel 9 ZU34): die Katalogverwaltungen der
    /// Menütabelle, deren Ziel die Wurzel führt (<see cref="FuehrtZiel"/>) — leer, wenn
    /// eine Kopfleiste (das Menüband unter Windows) hereingereicht ist.
    /// </summary>
    private IReadOnlyList<(string Ziel, string Text)> Katalogeintraege
        => Kopfleiste is not null
            ? Array.Empty<(string, string)>()
            : EPOS.UI.Bausteine.Menuetabelle.Kataloge(FuehrtZiel)
                  .Select(p => (p.Ziel, p.Text)).ToList();

    /// <summary>
    /// Ein Katalog aus dem Einstieg der Projektliste — derselbe Weg wie aus dem
    /// Hilfe-Assistenten (<see cref="OeffneMaske"/>), damit die benannte Ablehnung
    /// an EINER Stelle bleibt.
    /// </summary>
    private void BeiKatalog(string ziel)
    {
        _statuszeile = "";
        OeffneMaske(ziel);
    }

    private void BeiOeffnen((ProjektZeile Projekt, string Maske) wahl)
    {
        _projekt = wahl.Projekt;
        _statuszeile = "";
        Zeige(wahl.Maske);
    }

    /// <summary>
    /// „Neues Projekt…" aus der Projektliste (Befund <b>W16a-O-4</b>) — der
    /// Assistent im Zweig NEU.
    ///
    /// <para>Das offene Projekt bleibt dabei stehen: Ein neuer Lauf hängt an keinem,
    /// und der Schlüssel <c>PROJEKT_NEU</c> setzt die Betriebsart schon von selbst
    /// (dieselbe Unterscheidung wie <c>MenueCtrl.ProjektNeu</c> unter Windows).</para>
    /// </summary>
    private void BeiNeuemProjekt()
    {
        _statuszeile = "";
        Zeige(Seitenschluessel.ProjektNeu);
    }

    /// <summary>
    /// Schaltet die Ansicht. <c>false</c> = der Schlüssel ist hier unbekannt oder
    /// die Ansicht lässt sich nicht aufbauen; dann bleibt stehen, was steht.
    /// </summary>
    /// <param name="maske">Der Seitenschlüssel.</param>
    /// <param name="betriebsartWunsch">
    /// Nur für den Assistenten: die Betriebsart aus dem Argument des Aufrufers
    /// (<c>Dienste.Navigation.OeffneMaske(Masken.Assistent, betriebsart)</c>).
    /// Ohne sie entscheidet der Schlüssel bzw. das gewählte Projekt.
    /// </param>
    /// <param name="marke">
    /// Nur für die Simulationsansicht (Auftrag #207): Schritt und Reiterblatt,
    /// mit denen sie aufmacht (<c>"schritt=3;blatt=STROMSPEICHER"</c>).
    /// </param>
    /// <param name="merken">
    /// <c>false</c> = die stehende Ansicht wird NICHT auf den Rückwegstapel gelegt.
    /// Der Rückweg selbst geht so — sonst legte er ab, was er gerade verlässt, und
    /// der Stapel wüchse bei jedem Hin und Her.
    /// </param>
    private bool Zeige(string maske, int? betriebsartWunsch = null,
                       string marke = "", bool merken = true)
    {
        // ANWENDERENTSCHEID 62b-E-1 (11.09.2026): Der Assistent wird nicht still
        // verlassen. Hat der Lauf ungespeicherte Eingaben, kommt die Rueckfrage,
        // und der Wechsel geschieht erst DANACH - oder gar nicht. Ohne Aenderung
        // wird nicht gefragt, dann faellt der Aufruf hier durch.
        if (_ansicht == Seitenschluessel.Assistent && !_assistentGeklaert
            && _assistentSeite is not null && _assistentSeite.Ungespeichert)
        {
            _ = VerlassenUndZeigen(maske, betriebsartWunsch);
            return true;
        }

        // DIESELBE REGEL fuer die Stromspeicher-Auslegung (Auftrag #192): Ein
        // Arbeitsstand, der noch nicht geschrieben ist, wird nicht still weggeworfen.
        if (_ansicht == Seitenschluessel.StromspeicherAuslegung && !_auslegungGeklaert
            && _auslegungSeite is not null && _auslegungSeite.Ungespeichert)
        {
            _ = AuslegungVerlassenUndZeigen(maske, betriebsartWunsch);
            return true;
        }

        // UND fuer die Simulation (Auftrag #207): Eine ungespeicherte Kaskade ist
        // dasselbe - sie steht nur im Arbeitsspeicher der Huelle. Der Wechsel INNERHALB
        // der Ansicht (die drei Schluessel fuehren auf dieselbe) fragt nicht.
        if (_ansicht == Seitenschluessel.Simulation
            && maske != Seitenschluessel.Simulation
            && maske != Seitenschluessel.SimulationKonfiguration
            && maske != Seitenschluessel.SimulationErgebnis
            && !_simulationGeklaert
            && _simulationSeite is not null && _simulationSeite.Ungespeichert)
        {
            _ = SimulationVerlassenUndZeigen(maske, betriebsartWunsch);
            return true;
        }

        // Der Wechsel auf die STARTANSICHT leert den Stapel (Konzept 2.1): Von dort
        // aus beginnt jeder Weg neu, und ein Eintrag darunter waere unerreichbar.
        if (maske == Seitenschluessel.Startseite || maske == Seitenschluessel.Projektliste)
            _rueckweg.Clear();

        if (maske == Seitenschluessel.Startseite)
        {
            // Der Parametersatz der Huelle hat Vorrang: Unter Windows haelt
            // StartseiteHuelle den Projektkontext, die zwei Bedarfsobjekte und
            // die 21 Kachelwege - eine Projektquelle koennte das nicht.
            _startseite = MitZustand(StartseiteGaben ?? Quelle.StartseiteGaben(_projekt?.Id ?? 0));
            if (_startseite is null)
            {
                _statuszeile = KeineStartseiteText;
                return false;
            }

            // Die MARKE des Rueckwegs (Auftrag #220): Sie stellt den Reiter
            // „Simulation" samt seinem Reiterblatt wieder her. Ohne Marke bleibt die
            // Startseite, wo sie aufmacht.
            _startseiteMarke = marke;

            // DER REITERWUNSCH (16.09.2026): Er gilt fuer DIESEN Aufbau und wird
            // dabei verbraucht - sonst stuende die Startseite auch beim naechsten
            // Besuch wieder auf dem gewuenschten Reiter.
            _startseiteReiter = _reiterwunschOffen;
            _reiterwunschOffen = "";

            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.BerichteKosten)
        {
            _berichteKosten = MitZustand(BerichteKostenGaben ?? Quelle.BerichteKostenGaben(_projekt?.Id ?? 0));
            if (_berichteKosten is null)
            {
                _statuszeile = KeineBerichteText;
                return false;
            }

            // DAS BLATT (KI-D-Q8): Es gilt fuer DIESEN Aufbau und wird dabei
            // verbraucht - sonst stuende die Ansicht auch beim naechsten Besuch
            // wieder auf dem gewuenschten Blatt (Muster Reiterwunsch der Startseite).
            _berichteKostenBlatt = _blattwunschOffen;
            _blattwunschOffen = "";

            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.Energietraeger)
        {
            _energietraeger = Quelle.Energietraeger();
            _ansicht = maske;
            return true;
        }

        // ---- Die FUENF Masken aus KI-D-Q8 ---------------------------------------
        // Dasselbe Muster wie beim BHKW-Dialog darunter: Liefert die Quelle keinen
        // Parametersatz, bleibt die Ansicht stehen und SAGT WARUM - benannt
        // abgelehnt, nicht still uebergangen (Regel EPOS.UI.Daten).
        if (maske == Seitenschluessel.Klimadaten)
        {
            _klimadaten = Quelle.KlimadatenGaben();
            if (_klimadaten is null) { _statuszeile = KeineKlimadatenText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.ProjektAlsVariante)
        {
            // Die Maske gilt dem AKTIVEN Projekt; welcher STAMM daraus folgt,
            // entscheidet die Huelle (eine Variante haengt immer am Stamm).
            _projektVariante = Quelle.ProjektVarianteGaben(_projekt?.Id ?? 0);
            if (_projektVariante is null) { _statuszeile = KeineProjektvarianteText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.ProjektSpeichernUnter)
        {
            _projektKopie = Quelle.ProjektKopieGaben();
            if (_projektKopie is null) { _statuszeile = KeineProjektkopieText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.PeakShaving)
        {
            _peakShaving = Quelle.PeakShavingGaben(_projekt?.Id ?? 0);
            if (_peakShaving is null) { _statuszeile = KeinPeakShavingText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.StromganglinieAdmin)
        {
            _stromganglinien = Quelle.StromganglinieAdminGaben();
            if (_stromganglinien is null) { _statuszeile = KeineStromganglinienText; return false; }
            _ansicht = maske;
            return true;
        }

        // ---- Die DREI Masken der Wirtschaftlichkeit (E3/8, A19) -----------------
        if (maske == Seitenschluessel.Kostenverwaltung)
        {
            _kostenverwaltung = Quelle.KostenverwaltungGaben();
            if (_kostenverwaltung is null) { _statuszeile = KeineKostenverwaltungText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.NutzungsdauerVerwaltung)
        {
            _nutzungsdauern = Quelle.NutzungsdauerGaben();
            if (_nutzungsdauern is null) { _statuszeile = KeineNutzungsdauernText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.Gesetzeskatalog)
        {
            _gesetzeskatalog = Quelle.GesetzeskatalogGaben();
            if (_gesetzeskatalog is null) { _statuszeile = KeinGesetzeskatalogText; return false; }
            _ansicht = maske;
            return true;
        }

        // ---- Die ZWEI Kataloge der Gebaeudesimulation (G3) ---------------------
        // Der Delegat der Huelle hat Vorrang (Windows), sonst die Quelle (iOS); ohne beide
        // bleibt die Ansicht stehen und sagt warum.
        if (maske == Seitenschluessel.BaustoffKatalog)
        {
            _baustoffKatalog = BaustoffKatalogGaben?.Invoke() ?? Quelle.BaustoffKatalogGaben();
            if (_baustoffKatalog is null) { _statuszeile = KeinBaustoffKatalogText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.BauteilaufbauKatalog)
        {
            _bauteilaufbauKatalog = BauteilaufbauKatalogGaben?.Invoke() ?? Quelle.BauteilaufbauKatalogGaben();
            if (_bauteilaufbauKatalog is null) { _statuszeile = KeinBauteilaufbauKatalogText; return false; }
            _ansicht = maske;
            return true;
        }

        // ---- Der Katalog der BRAUCHWASSER-NUTZUNGSARTEN (ZU26) -----------------
        // ALLEIN die Quelle, ohne Delegat der Huelle: Unter Windows faengt die Schale
        // den Maskenschluessel ab und oeffnet ihr Fenster - die Wurzel kommt dort nicht
        // an die Reihe (WinFormsNavigation, Masken.BrauchwasserNutzungsarten). Ein
        // Delegat, den niemand setzt, waere toter Draht.
        if (maske == Seitenschluessel.BrauchwasserNutzungsarten)
        {
            _nutzungsartKatalog = Quelle.NutzungsartKatalogGaben();
            if (_nutzungsartKatalog is null) { _statuszeile = KeinNutzungsartKatalogText; return false; }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.BhkwWirtschaftlichkeit)
        {
            _bhkw = Quelle.BhkwDaten(_projekt?.Id ?? 0);
            if (_bhkw is null)
            {
                // Kein Stammprojekt, keine Anlagen: Die Liste bleibt stehen und
                // sagt warum. Das ist der Windows-Zustand "Dialog geht nicht auf".
                _statuszeile = KeinBhkwText;
                return false;
            }
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.Simulation
            || maske == Seitenschluessel.SimulationKonfiguration
            || maske == Seitenschluessel.SimulationErgebnis)
        {
            // DREI SCHLUESSEL, EINE ANSICHT (Auftrag #207, Muster W16a-E-1): Die zwei
            // alten Schluessel sind seither EINSTIEGSMARKEN - SIMULATION_KONFIGURATION
            // macht auf Schritt ① auf, SIMULATION_ERGEBNIS auf ③. Eine eigene Marke
            // des Aufrufers gewinnt gegen beide.
            string wunsch = marke;
            if (string.IsNullOrEmpty(wunsch))
                wunsch = maske == Seitenschluessel.SimulationErgebnis
                             ? EPOS.UI.Seiten.Simulation.SimulationMarke.SCHRITT_ERGEBNIS
                         : maske == Seitenschluessel.SimulationKonfiguration
                             ? EPOS.UI.Seiten.Simulation.SimulationMarke.SCHRITT_KONFIGURATION
                             : "";

            // Der Delegat der Huelle hat Vorrang: Unter Windows haelt SimulationHuelle
            // den gerechneten Lauf, die Bilder und die Gueltigkeitsmarke zwischen zwei
            // Besuchen - eine Projektquelle koennte das nicht.
            IReadOnlyDictionary<string, object>? gaben = SimulationGabenHolen();
            if (gaben is null)
            {
                // Kein Projekt, keine Datenbank: Die Liste bleibt stehen und sagt
                // warum - der Windows-Zustand „Seite geht nicht auf".
                _statuszeile = KeineSimulationText;
                return false;
            }

            if (merken && _ansicht != Seitenschluessel.Simulation) RueckwegMerken();

            _simulation = gaben;
            _simulationMarke = wunsch;
            _simulationGeklaert = false;
            _ansicht = Seitenschluessel.Simulation;
            return true;
        }

        if (maske == Seitenschluessel.Assistent
            || maske == Seitenschluessel.ProjektNeu
            || maske == Seitenschluessel.ProjektBearbeiten)
        {
            // DREI Schluessel, EINE Ansicht (W16a-E-1): Der Kern ruft den
            // Assistenten ueber Masken.Assistent mit der Betriebsart als Argument,
            // das Menueband meldet die zwei WEGE des Hauptfensters. Sie sagen
            // dasselbe - PROJEKT_NEU ist Betriebsart 0, PROJEKT_BEARBEITEN ist 1 -,
            // und ohne beides entscheidet das gewaehlte Projekt (der iOS-Weg,
            // dieselbe Unterscheidung wie MenueCtrl.ProjektNeu/ProjektBearbeiten).
            int betriebsart = betriebsartWunsch
                ?? (maske == Seitenschluessel.ProjektNeu
                        ? WindowsFormsApplication1.AssistentCtrl.BETRIEBSART_NEU
                    : maske == Seitenschluessel.ProjektBearbeiten
                        ? WindowsFormsApplication1.AssistentCtrl.BETRIEBSART_BEARBEITEN
                    : (_projekt?.Id ?? 0) > 0
                        ? WindowsFormsApplication1.AssistentCtrl.BETRIEBSART_BEARBEITEN
                        : WindowsFormsApplication1.AssistentCtrl.BETRIEBSART_NEU);

            // Der Delegat der Huelle hat Vorrang: Unter Windows baut
            // AssistentHuelle je Lauf einen neuen AssistentCtrl und haengt die
            // dreizehn Seitengaben daran - eine Projektquelle koennte das nicht.
            _assistent = AssistentGaben?.Invoke(betriebsart)
                         ?? Quelle.AssistentGaben(betriebsart, _projekt?.Id ?? 0);
            if (_assistent is null)
            {
                // Solange die iOS-Huelle den Assistenten nicht bedient (iU11), bleibt
                // die Liste stehen und sagt warum - der Windows-Zustand "Fenster geht
                // nicht auf".
                _statuszeile = KeinProjektassistentText;
                return false;
            }
            // DER EINSTIEG (Anwenderentscheid 16.09.2026): JEDE Neuanlage macht auf der
            // PROJEKTKONFIGURATION auf - die Startkachel „Neues Projekt" ebenso wie das
            // Menue „Projekt -> Neu...", der Knopf „Neues Projekt..." der Projektliste
            // (iOS) und der Ruf des Kerns ueber Masken.Assistent. Die Komponentenauswahl
            // waehlt Fachschritte fuer ein Projekt aus, das es noch nicht gibt; erreichbar
            // bleibt sie ueber BEARBEITEN. Es entscheidet deshalb allein die BETRIEBSART -
            // einen Merker, der den WEG unterscheidet, gibt es nicht mehr.
            _assistentEinstieg =
                betriebsart == WindowsFormsApplication1.AssistentCtrl.BETRIEBSART_NEU
                    ? EPOS.UI.Seiten.Assistent.AssistentEinstieg.Neuanlage
                    : EPOS.UI.Seiten.Assistent.AssistentEinstieg.Vollstaendig;

            _assistentGeklaert = false;
            _ansicht = Seitenschluessel.Assistent;
            return true;
        }

        if (maske == Seitenschluessel.StromspeicherAuslegung)
        {
            // Der Delegat der Huelle hat Vorrang: Unter Windows haelt
            // StromspeicherAuslegungHuelle den gerechneten Simulationslauf, aus dem die
            // EPOS-Zeitreihen stammen - eine Projektquelle koennte das nicht.
            _auslegung = StromspeicherAuslegungGaben?.Invoke()
                         ?? Quelle.StromspeicherAuslegungGaben(_projekt?.Id ?? 0);
            if (_auslegung is null)
            {
                _statuszeile = KeineAuslegungText;
                return false;
            }
            // Der Rueckweg fuehrt dorthin, woher man kam (Muster #62b) - seit #207
            // ueber den STAPEL und nicht mehr ueber ein eigenes Feld (SIM-Q4).
            if (merken) RueckwegMerken();
            _auslegungGeklaert = false;
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.KiAssistent)
        {
            IReadOnlyDictionary<string, object>? gaben = Quelle.KiAssistentGaben(_projekt?.Id ?? 0);
            if (gaben is null)
            {
                // Solange die iOS-Huelle den Assistenten nicht bedient (iU11), bleibt
                // die Liste stehen und sagt warum - der Windows-Zustand "Fenster geht
                // nicht auf".
                _statuszeile = KeinAssistentText;
                return false;
            }

            // Der AUFRUFKONTEXT (Auftrag #199) legt sich UEBER den Parametersatz der
            // Quelle: Bereich, Dialogname, Kennung und die vorbelegte Frage kommen aus
            // dem Aufruf, alles Uebrige (Delegaten, Texte, Zaehler) aus der Huelle.
            _kiAssistent = MitFeldwerten(MitAufruf(gaben));

            // Der Rueckweg fuehrt dorthin, woher man kam (Muster #62b) - der
            // Assistent ist ein Abstecher, keine neue Arbeitsansicht.
            if (merken && _ansicht != Seitenschluessel.KiAssistent) RueckwegMerken();
            _ansicht = maske;
            return true;
        }

        if (maske == Seitenschluessel.Projektliste)
        {
            _ansicht = maske;
            return true;
        }

        return false;
    }

    /// <summary>
    /// Der Rueckweg. Er fuehrt zur <see cref="Startansicht"/> - auf iOS die
    /// Projektliste, unter Windows die Startseite. Laesst sie sich nicht
    /// aufbauen, bleibt die Liste; sie steht auf beiden Plattformen.
    /// </summary>
    private void ZurueckZurListe()
    {
        // Der Assistent hat sich SELBST verabschiedet (gespeichert, abgebrochen
        // oder ueber „Projekt oeffnen") - hier wird nicht noch einmal gefragt.
        _assistentGeklaert = true;

        // Die Simulation hat sich SELBST verabschiedet - hier wird nicht noch
        // einmal gefragt (Auftrag #207, Muster 62b-E-1).
        _simulationGeklaert = true;

        _bhkw = null;
        _simulation = null;
        _simulationMarke = "";
        _kiAssistent = null;
        _assistent = null;
        _berichteKosten = null;   // W16c-E-3: auch diese Ansicht wird verlassen
        _auslegung = null;

        // Die fuenf Masken aus KI-D-Q8 tragen keinen Zustand ueber den Rueckweg
        // hinaus - beim naechsten Betreten holt Zeige() ihren Satz neu.
        _klimadaten = null;
        _projektVariante = null;
        _projektKopie = null;
        _peakShaving = null;
        _stromganglinien = null;

        // Dasselbe gilt fuer die drei Masken aus E3/8.
        _kostenverwaltung = null;
        _nutzungsdauern = null;
        _gesetzeskatalog = null;

        // Und fuer die zwei Kataloge der Gebaeudesimulation (G3) sowie den Katalog der
        // Brauchwasser-Nutzungsarten (ZU26).
        _baustoffKatalog = null;
        _bauteilaufbauKatalog = null;
        _nutzungsartKatalog = null;
        _auslegungGeklaert = true;
        _rueckweg.Clear();

        if (!Zeige(Startansicht)) _ansicht = Seitenschluessel.Projektliste;
        Laden();
    }

