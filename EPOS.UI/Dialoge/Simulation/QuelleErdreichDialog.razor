    private IReadOnlyList<(int Id, string Text)> Bodentypen
    {
        get
        {
            string[] anzeige = ErdreichTemperatur.KatalogAnzeige();
            var l = new List<(int, string)>(anzeige.Length);
            for (int i = 0; i < anzeige.Length; i++) l.Add((i, anzeige[i]));
            return l;
