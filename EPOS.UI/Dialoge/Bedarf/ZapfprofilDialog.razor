    protected override void OnInitialized()
    {
        _eingabe = (Daten.Eingabe ?? new ZapfprofilEingabeDaten()).Kopie();
        _stufe = ZapfprofilStufe.Einfach;
        _vorschau = Daten.Vorschau;
        _vorschauAktuell = _vorschau is not null;
        _wahl = _eingabe.Zonen.Count > 0 ? 0 : -1;

        // Welle #458, Stufe 3a: die Ueberlagerung als EIGENE Maske - solange sie offen
        // steht; ihr Dispose meldet sie ab.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.ZAPFPROFIL, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        StatusNachziehen();
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        _kiMaske?.Dispose();
        EntprellungAbbrechen();
        JahresreiheVerwerfen();
    }

