@* Kennzahl-Karte: Ueberschrift, grosser Wert, leise Herkunftszeile
   (iU9-W5.0).

   VORBILD ist UcBkKosten.Kachel - die Karte, die seit KD6a auf der
   Kostenseite UND auf der Wirtschaftlichkeitsseite steht (dort ueber ein
   "internal" der Kostenseite, damit es nur EINE Gestaltung gibt). Genau diese
   eine Gestaltung ist hier der Baustein.

   ANZEIGE, KEIN EINSTIEG. Sie ist bewusst kein <button>: Ein Klick tut
   nichts, und eine Sprachausgabe soll sie nicht als Schaltflaeche melden. Wer
   einen Einstieg braucht, nimmt <Kachel>.

   "—" STATT NULL. Der Wert wird fertig formatiert uebergeben; ein leerer Wert
   erscheint als Gedankenstrich. Das ist die Hausregel der Kostenseite: Eine 0
   waere eine Aussage, die niemand getroffen hat (Nutzerentscheidung 4 vom
   18.08.2026).

   KENNZEICHEN UND WARNUNG (Etappe E5, V-A, Entscheid V-3): Eine Kennzahl, die nach
   DIN EN 17463 nur nachrichtlich steht, traegt ihr Label unter dem Titel; eine
   Warnung, die den Wert stehen laesst (mehrdeutiger Zinsfuss), steht unter dem Wert.
   Beide sind leer die Vorgabe - dann bleibt die Karte, wie sie war.

   PLATZHALTERMARKE (BV-E6, Konzept Berichtsvorlagen 9.4, 9.6): Mit Vorlagenfeld steht
   die Marke oben rechts in der Titelzeile der Karte; ohne bleibt das Markup, wie es war.
   Den Schluessel liefert die Huelle mit dem Wert - die Karte kennt keinen Katalog. *@

@namespace EPOS.UI.Bausteine

<div class="epos-kennzahlkachel">
    @if (string.IsNullOrEmpty(Vorlagenfeld))
    {
        <span class="epos-kennzahlkachel-titel">@Titel</span>
    }
    else
    {
        <span class="epos-kennzahlkachel-titelzeile">
            <span class="epos-kennzahlkachel-titel">@Titel</span>
            <Vorlagenfeldknopf Vorlagenfeld="@Vorlagenfeld" Stufe="@VorlagenfeldStufe"
                               StufenHinweis="@VorlagenfeldHinweis" />
        </span>
    }
    @if (!string.IsNullOrEmpty(Kennzeichen))
    {
        <span class="epos-kennzahlkachel-kennzeichen">@Kennzeichen</span>
    }
    <span class="epos-kennzahlkachel-wert">@(string.IsNullOrEmpty(Wert) ? "—" : Wert)</span>
    @if (!string.IsNullOrEmpty(Warnung))
    {
        <span class="epos-kennzahlkachel-warnung" role="note">⚠ @Warnung</span>
    }
    @if (!string.IsNullOrEmpty(Quelle))
    {
        <span class="epos-kennzahlkachel-quelle">@Quelle</span>
    }
</div>

@code {
    /// <summary>Ueberschrift der Karte.</summary>
    [Parameter] public string Titel { get; set; } = "";

    /// <summary>Der fertig formatierte Wert; leer = „—".</summary>
    [Parameter] public string Wert { get; set; } = "";

    /// <summary>Leise Zeile darunter: woher der Wert stammt.</summary>
    [Parameter] public string Quelle { get; set; } = "";

    /// <summary>Das Label der Einordnung („nachrichtlich (Anhang C)"); leer = keines.</summary>
    [Parameter] public string Kennzeichen { get; set; } = "";

    /// <summary>Eine Warnung, die den Wert stehen lässt; leer = keine.</summary>
    [Parameter] public string Warnung { get; set; } = "";

    /// <summary>Der Platzhalter, der genau diesen Wert erzeugt (BV-E6); leer = keine Marke.</summary>
    [Parameter] public string Vorlagenfeld { get; set; } = "";

    /// <summary>„entspricht“ (Vorgabe) oder „ähnlich im Bericht“.</summary>
    [Parameter] public Vorlagenfeldstufe VorlagenfeldStufe { get; set; } = Vorlagenfeldstufe.Entspricht;

    /// <summary>Bei „ähnlich“: wo der Bericht anders zeigt; sonst leer.</summary>
    [Parameter] public string VorlagenfeldHinweis { get; set; } = "";
}
