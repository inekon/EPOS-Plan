    private int ZonendialogZonenzahl
        => _zoneOffen is null ? 0 : _arbeit.ZoneMitId(_zoneOffen.Id) is null ? _arbeit.Zonen.Count + 1 : _arbeit.Zonen.Count;

    /// <summary>„+ Neue Zone …" samt Sperrgrund — weich gesperrt (<c>aria-disabled</c>), der Versuch meldet den Grund.</summary>
    private RenderFragment Neuezonenblock => __builder =>
    {
        string? sperre = NeueZoneSperre;
        <div class="epos-zeilenknoepfe epos-zonen-neu">
            <button type="button" class="epos-knopf epos-zonen-neu-knopf"
                    aria-disabled="@(sperre is null ? null : "true")" title="@sperre"
                    @onclick="BeiNeueZone">@ZonenTexte.KnopfNeueZone</button>
            @if (_arbeit.Zonen.Count >= 2)
            {
                @* Stufe G6b: der Luftaustausch zwischen den Zonen - ab zwei Zonen; ohne Schemaschritt
                   S-G weich gesperrt, der Versuch nennt den Grund. *@
                string? luftSperre = Zonen?.KopplungSperre;
                <button type="button" class="epos-knopf epos-zonen-luft-knopf"
                        aria-disabled="@(luftSperre is null ? null : "true")" title="@luftSperre"
                        @onclick="BeiLuftaustausch">@ZonenTexte.KnopfLuftaustausch</button>
            }
        </div>
        @if (sperre is not null && Modus == GebaeudeKatalogModus.Projekt && Zonen is not null)
        {
            <p class="epos-leisezeile">@sperre</p>
        }
    };

    /// <summary>Die Nutzfläche einer Zeile der Zonenliste: ab zwei Zonen ohne eigene Fläche „fehlt".</summary>
    private string Flaechentext(ZoneDaten zone, Zonenkennwerte k)
        => _arbeit.Zonen.Count >= 2 && zone.Nutzflaeche is null ? ZonenTexte.FlaecheFehlt : Zahl(k.Nutzflaeche, 2) + " m²";

    /// <summary>Die Zeile unter „Speichern unter" mit Zonen: Sie bleiben an der Projektkopie.</summary>
    private string SpeichernUnterZonenzeile
        => string.Format(CultureInfo.CurrentCulture, ZonenTexte.HinweisSpeichernUnterZonen,
                         _arbeit.Zonen.Count.ToString(CultureInfo.CurrentCulture),
                         _arbeit.Zonen.Sum(z => z.Bauteile.Count).ToString(CultureInfo.CurrentCulture));

    /// <summary>Die Zeile unter dem Namen in der Betriebsart Projekt: Die Projektkopie behält ihren Namen.</summary>
    private string NameProjektzeile
        => string.Format(CultureInfo.CurrentCulture, ZonenTexte.ZeileNameProjekt, _ursprungsname);

    /// <summary>
    /// Der Übernahmeknopf samt leiser Erklärzeile — frei oder WEICH gesperrt (<c>aria-disabled</c>,
    /// Grund als Kurztext; der Versuch meldet den Grund). Er steht unter dem Rechenweg und im leeren
    /// Zonenreiter; es ist derselbe Knopf.
    /// </summary>
    private RenderFragment Uebernahmeblock => __builder =>
    {
        string? sperre = UebernahmeSperre;
        <div class="epos-zonenuebernahme">
            @* Eine Knopfzeile im Blatt, keine Leiste: Die Fussleiste des Editors ist die SpeichernLeiste. *@
            <div class="epos-zeilenknoepfe">
                @* Weich gesperrt: derselbe Knopf mit aria-disabled und Kurztext; der Klick meldet den Grund. *@
                <button type="button" class="epos-knopf epos-zonenuebernahme-knopf"
                        aria-disabled="@(sperre is null ? null : "true")" title="@sperre"
                        @onclick="BeiUebernehmen">@ZonenTexte.KnopfUebernehmen</button>
            </div>
            <p class="epos-leisezeile">@(sperre ?? ZonenTexte.HinweisUebernehmen)</p>
        </div>
    };

    /// <summary>
    /// Die Rückfrage der Übernahme: Faktor, Nutzfläche alt → neu, die Angabe, die dann nicht mehr gilt,
    /// und — trägt das Gebäude welche — die Leistungsgrenzen mit ihrem Wert, die nicht hochgerechnet
    /// werden (E40).
    /// </summary>
    private string Uebernahmefrage
    {
        get
        {
            if (_vorschlag is not ZonenuebernahmeDaten v) return "";
            var c = CultureInfo.CurrentCulture;
            string frage = string.Format(c, ZonenTexte.FrageUebernehmen, v.Faktor.ToString("0.###", c),
                                         Zahl(v.NutzflaecheGebaeude, 2), Zahl(v.Zone?.Nutzflaeche, 2),
                                         Zahl(v.Angabe, 2), v.Einheit);
            if (!v.Leistungsgrenzen) return frage;
            var grenzen = new List<string>();
            if (v.HeizgrenzeKw is double heiz) grenzen.Add(string.Format(c, ZonenTexte.GrenzeHeizung, heiz.ToString("0.##", c)));
            if (v.KuehlgrenzeKw is double kuehl) grenzen.Add(string.Format(c, ZonenTexte.GrenzeKuehlung, kuehl.ToString("0.##", c)));
            return frage + " " + string.Format(c, ZonenTexte.FrageGrenzen, string.Join(", ", grenzen));
        }
    }

    /// <summary>
    /// Die Rückfrage „Zone entfernen" nennt Name und Zahl der Bauteile der Zone; ist sie die einzige,
    /// sagt sie, dass das Gebäude danach wieder den Klassenweg rechnet.
    /// </summary>
    private string Entfernfrage
    {
        get
        {
            if (_entfernId is not int id || _arbeit.ZoneMitId(id) is not ZoneDaten z) return "";
            CultureInfo c = CultureInfo.CurrentCulture;
            string frage = string.Format(c, _arbeit.Zonen.Count == 1 ? ZonenTexte.FrageEntfernen : ZonenTexte.FrageEntfernenZone,
                                         z.Bezeichner, z.Bauteile.Count.ToString(c));
            // Festlegung 8 (G6b): die Trennflaechen anderer Zonen, die auf sie zeigen, und die
            // Luftstroeme mit ihr - die Rueckfrage nennt beide, Ja setzt die Bauteile auf "unbeheizt".
            var (trennflaechen, luft) = _arbeit.Bezuege(id);
            if (trennflaechen.Count > 0)
                frage += " " + string.Format(c, ZonenTexte.FrageEntfernenTrennflaechen, trennflaechen.Count,
                                             string.Join(", ", trennflaechen.Select(t => t.Bauteil.Bezeichner + " (" + t.Zone.Bezeichner + ")")));
            if (luft.Count > 0)
                frage += " " + string.Format(c, ZonenTexte.FrageEntfernenLuftstroeme, luft.Count);
            return frage;
        }
    }

    /// <summary>„Speichern unter" mit Zonen: Der Katalogsatz trägt sie nicht mit — die Frage nennt Zonen und Bauteile.</summary>
    private string SpeichernUnterFrage
    {
        get
        {
            CultureInfo c = CultureInfo.CurrentCulture;
            string bauteile = _arbeit.Zonen.Sum(z => z.Bauteile.Count).ToString(c);
            return _arbeit.Zonen.Count switch
            {
                0 => "",
                1 => string.Format(c, ZonenTexte.FrageSpeichernUnter, _arbeit.Zonen[0].Bezeichner, bauteile),
                _ => string.Format(c, ZonenTexte.FrageSpeichernUnterZonen, _arbeit.Zonen.Count.ToString(c), bauteile)
            };
        }
    }

    /// <summary>Die Herleitungszeile der abgeleiteten Hülle: aus der Zone bzw. aus allen Zonen.</summary>
    private string Summenregelzeile
        => _arbeit.Zonen.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, ZonenTexte.ZeileSummenregel, _arbeit.Zonen[0].Bezeichner)
            : string.Format(CultureInfo.CurrentCulture, ZonenTexte.ZeileSummenregelZonen, _arbeit.Zonen.Count);

    /// <summary>Die Herleitungszeile der Fenster: die Fensterfläche der Zone bzw. aller Zonen.</summary>
    private string Fensterzeile
        => _arbeit.Zonen.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, ZonenTexte.ZeileFenster, Zahl(Zonensummen.Fensterflaeche(_arbeit.Zonen[0]), 2))
            : string.Format(CultureInfo.CurrentCulture, ZonenTexte.ZeileFensterZonen, Zahl(Zonensummen.Fensterflaeche(_arbeit.Zonen), 2),
                            _arbeit.Zonen.Count);

    // =================================================================================
    // Zonen: uebernehmen, oeffnen, entfernen - alles im Arbeitsstand (Softwarearchitektur 3.3)
    // =================================================================================

    /// <summary>
    /// „Gebäude als eine Zone übernehmen": holt den Vorschlag samt Hochrechnungsfaktor aus dem Kern
    /// (ein Jahreslauf) und stellt die Rückfrage. Weich gesperrt meldet der Knopf seinen Grund.
    /// </summary>
    private async Task BeiUebernehmen()
    {
        if (UebernahmeSperre is string grund) { Melden(grund, WarnStufe.Hinweis); return; }
        _meldung = "";
        _uebernahmeLaeuft = true;
        ZonenuebernahmeDaten v;
        try
        {
            v = await Zonen!.Uebernehmen!(_arbeit.Probestand());
        }
        finally
        {
            _uebernahmeLaeuft = false;
        }
        if (!v.Ok || v.Zone is null)
        {
            Melden(v.Meldung, WarnStufe.Warnung);
            return;
        }
        _vorschlag = v;
    }

    /// <summary>Die Antwort: Ja legt die Zone in den Arbeitsstand (negative Ids), Nein lässt alles.</summary>
    private void UebernahmeBeantwortet(bool? antwort)
    {
        ZonenuebernahmeDaten? v = _vorschlag;
        _vorschlag = null;
        if (antwort != true || v?.Zone is null || _arbeit.Zonen.Count > 0) return;
        _arbeit.ZoneAnlegen(v.Zone.Kopie());
        _meldung = "";
    }

    /// <summary>Öffnet die Zone mit dieser Id im Zonendialog — als Kopie; der Arbeitsstand bleibt bis zum OK.</summary>
    private void ZoneOeffnen(int id)
    {
        if (_arbeit.ZoneMitId(id) is ZoneDaten z) _zoneOffen = z.Kopie();
    }

    /// <summary>
    /// Der Zonendialog ist zu: Mit Ergebnis ersetzt es die Zone GLEICHER Id im Arbeitsstand — die
    /// übrigen Zonen bleiben (G6a); eine Zone, die es noch nicht gibt, kommt hinzu.
    /// </summary>
    private void ZoneFertig(ZoneDaten? ergebnis)
    {
        _zoneOffen = null;
        if (ergebnis is null) return;
        if (!_arbeit.ZoneErsetzen(ergebnis)) _arbeit.ZoneAnlegen(ergebnis);
        _meldung = "";
    }

    /// <summary>
    /// „+ Neue Zone …" (G6a): Vor der ERSTEN Zone fragt der Dialog, weil das Gebäude danach über seine
    /// Bauteile rechnet (Softwarearchitektur 3.2 Regel 3); vor der ZWEITEN, weil die Simulation das
    /// Gebäude dann ablehnt, bis EPOS mehrere Zonen rechnet. Danach öffnet der Zonendialog eine neue,
    /// leere Zone; erst sein OK legt sie in den Arbeitsstand. Weich gesperrt meldet der Knopf den Grund.
    /// </summary>
    private void BeiNeueZone()
    {
        if (NeueZoneSperre is string grund) { Melden(grund, WarnStufe.Hinweis); return; }
        _meldung = "";
        if (_arbeit.Zonen.Count == 0) Fragen(ZonenTexte.KnopfNeueZone, ZonenTexte.FrageErsteZone, ZoneNeuOeffnen);
        else if (_arbeit.Zonen.Count == 1) Fragen(ZonenTexte.KnopfNeueZone, ZonenTexte.FrageZweiteZone, ZoneNeuOeffnen);
        else ZoneNeuOeffnen();
    }

    private void ZoneNeuOeffnen()
    {
        string name = string.Format(CultureInfo.CurrentCulture, ZonenTexte.NameNeu, _arbeit.Zonen.Count + 1);
        _zoneOffen = _arbeit.NeueZone(name);
    }

    /// <summary>„Duplizieren": die Kopie steht hinter der Zone; aus einer Zone werden zwei — dann mit Rückfrage.</summary>
    private void BeiDuplizieren(int id)
    {
        if (NeueZoneSperre is string grund) { Melden(grund, WarnStufe.Hinweis); return; }
        _meldung = "";
        IReadOnlyList<BauteilDaten> trennflaechen = _arbeit.EigeneTrennflaechen(id);
        if (_arbeit.Zonen.Count == 1) Fragen(ZonenTexte.KnopfDuplizieren, ZonenTexte.FrageZweiteZone, () => Duplizieren(id));
        else if (trennflaechen.Count > 0)
        {
            // Festlegung 9 (G6b): Die Kopie uebernimmt die eigenen Trennflaechen mit unveraendertem
            // Nachbarn - die Paarpruefung faengt eine Doppelung ab; die Rueckfrage sagt es vorher.
            string nachbarn = string.Join(", ", trennflaechen.Select(b => _arbeit.Zonenname(b.IdNachbarzone)).Distinct());
            Fragen(ZonenTexte.KnopfDuplizieren,
                   string.Format(CultureInfo.CurrentCulture, ZonenTexte.FrageDuplizierenTrennflaechen,
                                 _arbeit.ZoneMitId(id)?.Bezeichner ?? "", trennflaechen.Count, nachbarn),
                   () => Duplizieren(id));
        }
        else Duplizieren(id);
    }

    private void Duplizieren(int id)
    {
        if (_arbeit.ZoneMitId(id) is not ZoneDaten quelle) return;
        _arbeit.ZoneDuplizieren(id, string.Format(CultureInfo.CurrentCulture, ZonenTexte.NameKopie, quelle.Bezeichner));
    }

    /// <summary>▲▼: die Zone einen Platz nach oben bzw. unten; der Rang folgt beim Schreiben der Liste.</summary>
    private void ZoneVerschieben(int id, int richtung)
    {
        if (_arbeit.ZoneVerschieben(id, richtung)) _meldung = "";
    }

    private void Fragen(string titel, string text, Action nachJa)
    {
        _frageTitel = titel;
        _frageText = text;
        _nachFrage = nachJa;
    }

    /// <summary>Die Antwort der Rückfrage vor der ersten bzw. zweiten Zone: Ja führt den Weg aus, Nein lässt alles.</summary>
    private void NachfrageBeantwortet(bool? antwort)
    {
        Action? weiter = _nachFrage;
        _nachFrage = null;
        if (antwort == true) weiter?.Invoke();
    }

    /// <summary>
    /// „Zone entfernen": Ja nimmt die gefragte Zone aus dem Arbeitsstand — samt ihren Bezügen
    /// (Festlegung 8: Trennflächen anderer Zonen grenzen danach an einen unbeheizten Raum, ihre
    /// Luftströme entfallen); geschrieben wird mit OK. Nein bricht ab.
    /// </summary>
    private void EntfernenBeantwortet(bool? antwort)
    {
        int? id = _entfernId;
        _entfernId = null;
        if (antwort == true && id is int z) _arbeit.ZoneEntfernen(z);
    }

    /// <summary>„Luftaustausch …" (Stufe G6b): öffnet die Überlagerung; ohne Schemaschritt S-G meldet der weich gesperrte Knopf den Grund.</summary>
    private void BeiLuftaustausch()
    {
        if (Zonen?.KopplungSperre is string grund) { Melden(grund, WarnStufe.Hinweis); return; }
        _meldung = "";
        _luftOffen = true;
    }

    /// <summary>Der Luftaustausch ist zu: mit Ergebnis ersetzt es die Luftströme des Arbeitsstands — geschrieben wird mit OK.</summary>
    private void LuftaustauschFertig(IReadOnlyList<ZonenluftstromDaten>? ergebnis)
    {
        _luftOffen = false;
        if (ergebnis is null) return;
        _arbeit.LuftstroemeSetzen(ergebnis);
        _meldung = "";
    }

    /// <summary>Die Feldnamen und Meldungen der Prüfung folgen den Parametern.</summary>
