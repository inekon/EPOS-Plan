        </attribute>
        <attribute cardinality="required">
          <name>
            <simpleValue>Name</simpleValue>
          </name>
        </attribute>
        <attribute cardinality="required">
          <name>
            <simpleValue>CompositionType</simpleValue>
          </name>
          <value>
            <simpleValue>ELEMENT</simpleValue>
          </value>
        </attribute>
        <property dataType="IFCIDENTIFIER" cardinality="required">
          <propertySet>
            <simpleValue>EPOS_Gebaeude</simpleValue>
          </propertySet>
          <baseName>
            <simpleValue>Kennung</simpleValue>
          </baseName>
        </property>
        <property dataType="IFCLABEL" cardinality="optional">
