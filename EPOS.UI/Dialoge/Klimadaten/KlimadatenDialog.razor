    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> „Daten einlesen" ist ein LADEVORGANG: Er holt eine
    /// Zeitreihe aus dem Netz oder aus einer Datei, dauert Minuten und lässt sich
    /// abbrechen. Das ist kein Speichern einer Maske, sondern ein rechnender Weg — er
    /// gehört ins Aktionsregister und nicht hierher.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>
    /// Lädt die Regionsliste neu (<c>ReadAll</c> + <c>FillListBox</c>). <b>Das
    /// Stammblatt ist nie leer, solange die Liste Treffer hat</b> (Konzept 3.3): Steht
    /// die bisherige Wahl nicht mehr da, wird die erste Region gewählt.
    /// </summary>
    public async Task RegionenLaden()
    {
        if (Regionen is null) return;
        _regionen = await Regionen() ?? Array.Empty<Katalogfilterzeile>();

        _geschuetzt = new HashSet<string>(_regionen.Where(z => z.Geschuetzt).Select(z => z.Bezeichner),
                                          StringComparer.Ordinal);

        // Kaestchen verschwundener Zeilen fallen (V6); ein laufender Vergleich liest neu.
        _auswahl.Abgleichen(_regionen.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        if (_regionen.Count == 0) { Leeren(); return; }
        string ziel = _regionen.Any(z => z.Bezeichner == _gewaehlt) ? _gewaehlt : _regionen[0].Bezeichner;
        await Waehlen(ziel);
    }

    /// <summary>Befund W14c-B22: BEIDE Bilder gehen weg, nicht nur das erste.</summary>
    private void Leeren()
    {
        _gewaehlt = "";
        _fokuszeile = null;
        _auslieferung = false;
        _details = "";
        _modellTemperatur = null;
        _modellSonnenwinkel = null;
        _jahresmittel = _tiefstwert = _hoechstwert = null;
        _grossOffen = false;
    }

    /// <summary>
    /// Eine Zeile der Katalogliste wurde gewählt; sie meldet den SCHLÜSSEL, und der
    /// ist hier der Bezeichner (Auftrag KL-4).
    /// </summary>
    private Task BeiZeile(string schluessel)
    {
        _meldung = "";
        return Waehlen(schluessel ?? "");
    }

    /// <summary>
    /// Eine Region wählen: Fokuszeile, Herkunft, dann Details, Kennzahlen und die zwei
    /// Zeichenmodelle. EINE ANDERE REGION HEISST EINE ANDERE REIHE — den Ausschnitt
    /// verwirft der Baustein selbst, sobald ein anderes Modell hereinkommt.
    /// </summary>
    private async Task Waehlen(string bezeichner)
    {
        _gewaehlt = bezeichner ?? "";
        _fokuszeile = _regionen.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
        _auslieferung = _fokuszeile?.Geschuetzt == true;
        await AnsichtLaden();
    }

    /// <summary>
    /// Holt Details, Kennzahlen und die zwei Zeichenmodelle. <b>Ohne Stundenwerte
    /// bleibt es bei einer Meldung</b> statt einer Ausnahme (Befund W14c-B19).
    /// </summary>
    private async Task AnsichtLaden()
    {
        if (_gewaehlt.Length == 0 || Ansicht is null) return;

        Regionsansicht a = await Ansicht(_gewaehlt);

        _details = a.Details ?? "";
        _modellTemperatur = a.ModellTemperatur;
        _modellSonnenwinkel = a.ModellSonnenwinkel;
        _jahresmittel = a.Jahresmittel;
        _tiefstwert = a.Tiefstwert;
        _hoechstwert = a.Hoechstwert;
        if (!string.IsNullOrEmpty(a.Meldung)) Melden(a.Meldung, WarnStufe.Hinweis);
    }

