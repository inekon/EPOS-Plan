@page "/fensterprobe"
@using Microsoft.AspNetCore.WebUtilities
@using EPOS.UI.Dialoge.Admin
@using EPOS.UI.Dialoge.Bedarf
@using EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Waermepumpe
@inject NavigationManager Navigation

@*  DIE FENSTERPROBE (Anwenderentscheid 30.09.2026, "Kopf+Fuss fest") - Pruefstand, nicht
    Auslieferung.

    Sie stellt einen echten Dialog so in den Browser, wie BlazorDialogForm ihn unter Windows
    zeigt: als WURZEL in #app, dahinter in #app die Fenstermarke (Fensterwurzel) - dasselbe
    DOM wie body > div#app > .epos-dialog + span.epos-fenstermarke in der WebView2, ohne
    Datenbank. Gemessen wird von
    fensterprobe.mjs (LIESMICH.md), ob Kopfzeile und Schlussleiste am Fenster haften, ob das
    letzte Inhaltselement ueber dem Fuss sichtbar wird, ob ein angesprungenes Feld sichtbar
    bleibt, ob Ueberlagerung und Katalogdialog unveraendert stehen.

    Gaben ueber die Adresse:
      ?fall=heizkessel     HeizkesselDialog, zwei Projektzeilen, Katalog, Kostenknoepfe
      ?fall=bhkw           BhkwDialog, ebenso
      ?fall=waermepumpen   WaermepumpenDialog mit eingebetteter Detailansicht; die
                           Temperaturpruefung schlaegt an (Warnband im Fussblock der Detailansicht)
      ?fall=gebaeude       GebaeudeDialog (Katalogauswahl V1, Stufe 4): Zusammenfassung, Satz-Ueberlagerung mit
                           "Simulation..." (Waermebedarf als Ueberlagerung darueber), Stift, Rueckfrage des Rueckwegs
      ?fall=dubletten      KatalogDublettenDialog - das Protokoll steht UNTER der Schlussleiste
      ?fall=katalog        BedarfAdminDialog (Katalogdialog, .epos-katalog-dialog)
      ?fall=kaelteprofile  BedarfsProfileDialog der Art Kaelte mit dem Baustein Betriebskalenderwahl (KBP-1): der Knopf
                           "Betriebskalender…" oeffnet das Blatt mit dem BetriebskalenderDialog samt "Aus Gebaeude
                           uebernehmen…" (zwei Gebaeude, eines mit sechs Ferienzeitraeumen); Ablage im Speicher.
                           &kalender=leer: noch kein Kalender angelegt; &gebaeude=0: das Projekt hat kein Gebaeude.
                           Die Bearbeiten-Ueberlagerung einer Zeile zeigt die Kaeltegrafik (KBP-3b) aus einer
                           synthetischen Reihe, die dem Arbeitsstand folgt (Jahressumme, Monatsanteile, Kalender 2 =
                           Betriebsferien); Blatt Woche mit Wahl der Kalenderwoche (fensterprobe.mjs, Fall kaeltegrafik).
                           KBP-4b: Die Eingabeart Typtage ist waehlbar (TyptageVerfuegbar); der Editor mit der Matrix
                           12 Monate x 3 Tagesarten steht in derselben Ueberlagerung (fensterprobe.mjs, Fall kaeltetyptage)
      ?fall=klimaimport    KlimadatenDialog (Katalogdialog); "Import..." oeffnet die Ueberlagerung "Klimadaten
                           einlesen" (.epos-einlesen) - ihre Schlussleiste haftet am Boden (KD-1)
      ?fall=klimareihen    derselbe KlimadatenDialog mit einer Region samt gespeicherten Reihen (KD-8 Teil A):
                           Reiter "Weitere Reihen" mit der Reihenwahl ueber dem Bild (fensterprobe.mjs, Fall
                           klimareihen)
      ?meldung=1          fuer die Bannerprobe (bannerprobe.mjs): Heizkessel und BHKW melden bei
                           "Hinzufuegen" einen Fehler der Traegerwahl, der Gebaeudedialog traegt
                           "In DB uebernehmen" (weich gesperrt - der Versuch meldet den Grund);
                           ohne den Schalter steht alles wie fuer die Fensterprobe
      ?meldung=liste       fuer den Fall „meldungsliste" der fensterprobe.mjs: statt des Falls ein langer
                           Dialog im eigenen Fenster aus den Bausteinen des Hauses (Kopf mit Hilfepille und
                           Kreuz, Warnbanner als unmittelbares Kind der Wurzel, Absaetze mit Feldern,
                           SpeichernLeiste); der Banner traegt 30 Hinweise, die Liste steht aufgeklappt
      ?lizenz=1            das Lizenzbanner der AppWurzel (Baustein Lizenzbanner, Lesemodus-Satz) als
                           erstes Kind von #app vor dem Dialog - fuer den Fall „lizenzbanner" der
                           fensterprobe.mjs (mit ?marke=0 wie in der AppWurzel auf iOS)
      ?marke=0             OHNE Fenstermarke - die Gegenprobe: der Dialog steht wie ohne die Regel
      ?zeilen=40           Katalogzeilen
      ?verwendet=1         Heizkessel und BHKW: die erste Projektzeile heisst wie die zweite
                           Katalogzeile - die Katalogliste traegt Verwendungsmarke und Legende
                           (Spaltenwahlprobe in katalogprobe.mjs, Konzept 4.10)
      ?summe=<text>        Heizkessel und BHKW: die Summe der Projekt-Kopfleiste (Vorgabe 240 bzw. 80)
      ?kultur=de-DE|en-US  Kultur und Sprache; Program.cs setzt sie. *@

<div id="app">
    @if (_lizenz)
    {
        <Lizenzbanner Stufe="WarnStufe.Warnung" Text="@Resource.LIZ_BANNER_LESEMODUS" />
    }
    @if (_meldungListe)
    {
        @* Der Meldungsbanner mit aufgeklappter Hinweisliste: kein Fachdialog fuehrt eine Hinweisliste
           im Banner, deshalb steht hier ein Dialog aus den Bausteinen, wie ein Fachdialog ihn baut. *@
        <div class="epos-dialog epos-meldungslistenprobe" tabindex="-1">
            <div class="epos-dialog-kopf">
                <h1 class="epos-dialog-titel">Meldungsliste</h1>
                <InfoKnopf Schluessel="Fensterprobe" />
                <Schliesskreuz Geschlossen="@(() => Beendet(false))" />
            </div>
            <Warnbanner Stufe="WarnStufe.Warnung" Text="Die Prüfung hat Hinweise ergeben." Hinweise="@ProbeHinweise"
                        HinweiseOffen="true" />
            @for (int i = 1; i <= 16; i++)
            {
                int nr = i;
                <p class="epos-meldungslistenprobe-absatz">
                    <label>Feld @nr <input type="text" value="@("Wert " + nr)" /></label>
                    Absatz @nr des Inhalts – er rollt mit dem Dokument zwischen Kopf und Schlussleiste.
                </p>
            }
            <SpeichernLeiste Ergebnis="@(b => Beendet(b))" />
        </div>
    }
    else
    {
    @switch (_fall)
    {
        case "heizkessel":
            <HeizkesselDialog Zeilen="@ErzeugerZeilen("Kessel")"
                              Katalogprofil="@HeizkesselProfil"
                              Katalogzeilen="@(() => HeizkesselZeilen)"
                              Filterstandvorgabe="@_filterstand"
                              KatalogDetail="@(n => Detail(n))"
                              ProjektDetail="@(n => Detail("Kessel " + n))"
                              Varianten="@(_ => new[] { (5, "Erdgas E Variante"), (6, "Erdgas LL Variante") })"
                              Vorbereiten="@Vorbereitung"
                              TraegerGaben="@(_ => new Dictionary<string, object> { ["Energietraeger"] = new[] { (3, "Erdgas E") } })"
                              Aufnehmen="@(_aufnahme ? (id, t) => Aufnahme("Kessel", id) : null)"
                              KostenOeffnen="@((_, _) => Task.CompletedTask)"
                              EnergiekostenOeffnen="@(_ => Task.CompletedTask)"
                              Katalogfelder="@(_ => _steckbrief ? Steckbrieffelder.Fuer(_fall) : Felder())"
                              ProjektsatzWege="@SatzWege"
                              KatalogsatzWege="@SatzWege"
                              RueckwegWege="@RueckWege"
                              Vergleichsparameter="@(n => VglWerte(n, 120))"
                              VergleichsparameterProjekt="@(id => VglWerte("Kessel " + id, 100))"
                              RueckwegBleibtText="Im Projekt bleiben: Energieträger, Temperaturpaar, Senken und Zeitprogramm der Anlage."
                              NeuGaben="@(() => new Dictionary<string, object>())"
                              SummePtherm="@(() => _summe ?? "240")"
                              Geschlossen="@(b => Beendet(b))" />
            break;

        case "bhkw":
            <BhkwDialog Zeilen="@ErzeugerZeilen("Modul")"
                        Katalogprofil="@BhkwProfil"
                        Katalogzeilen="@(() => BhkwZeilen)"
                        Filterstandvorgabe="@_filterstand"
                        KatalogDetail="@(n => Detail(n))"
                        ProjektDetail="@(n => Detail(n))"
                        Varianten="@(_ => new[] { (5, "Erdgas E Variante") })"
                        Kostensumme="@(_ => (95000.0, 6200.0))"
                        Vorbereiten="@Vorbereitung"
                        TraegerGaben="@(_ => new Dictionary<string, object> { ["Energietraeger"] = new[] { (3, "Erdgas E") } })"
                        Aufnehmen="@(_aufnahme ? (id, t) => Aufnahme("Modul", id) : null)"
                        SummePtherm="@(() => _summe ?? "80")"
                        KostenOeffnen="@((_, _) => Task.CompletedTask)"
                        EnergiekostenOeffnen="@(_ => Task.CompletedTask)"
                        Katalogfelder="@(_ => _steckbrief ? Steckbrieffelder.Fuer(_fall) : Felder())"
                        ProjektsatzWege="@SatzWege"
                        Geschlossen="@(b => Beendet(b))" />
            break;

        case "waermepumpen":
            <WaermepumpenDialog Zeilen="@WpZeilen"
                                Katalog="@(() => WpKatalog)"
                                Katalogprofil="@WpProfil"
                                AnlageGaben="@WpAnlageGaben"
                                ProjektSatz="@(d => new WaermepumpeStammDaten { Id = 1, Name = d.Bezeichner, Firma = d.Firma, Nennleistung = d.Nennleistung, Heizstab = 6 })"
                                Vergleichsparameter="@(n => VglWerte(n, 20))"
                                VergleichsparameterProjekt="@(id => VglWerte("Pumpe " + id, 16))"
                                KatalogSatz="@(id => new WaermepumpeStammDaten { Id = id, Name = "Katalog " + id, Firma = "Hersteller", Nennleistung = 20, Heizstab = 6 })"
                                KatalogSpeichern="@((satz, _) => new KatalogSpeicherErgebnis(true, "", satz.Name))"
                                KatalogKennlinien="@(_ => new List<KennlinienZeile>())"
                                NeuGaben="@(() => new Dictionary<string, object>())"
                                KostenOeffnen="@((_, _) => Task.CompletedTask)"
                                Kostensumme="@(_ => (18000.0, 300.0))"
                                Anlegen="@(n => WpZeile(n))"
                                Geschlossen="@(b => Beendet(b))" />
            break;

        case "kaeltemaschine":
            @* Stufe 5: der Erzeugerdialog der Kaeltemaschinen als Wirt der Zweispaltenauswahl, ohne Datenbank. *@
            <KaeltemaschineAnlageDialog Katalogprofil="@KmProfil" Katalogzeilen="@(() => KmKatalog)"
                                        Anlagen="@KmAnlagen" Katalogwerte="@(_ => KmGeraet)"
                                        Rueckkuehlung="@(() => RkGaben())"
                                        Stromtraeger="@(new[] { (5, "Strom") })" ProjektStromtraeger="5"
                                        Anlegen="@((_, _) => -1)" Speichern="@(_ => null)" Loeschen="@(_ => { })"
                                        KatalogLoeschen="@(_ => "")" Kostensumme="@(_ => (1000.0, 50.0))"
                                        KostenOeffnen="@((_, _) => Task.CompletedTask)"
                                        Geschlossen="@(b => Beendet(b))" />
            break;

        case "gebaeude":
            <GebaeudeDialog Zeilen="@GebaeudeProjektzeilen"
                            Katalogzeilen="@(() => GebaeudeZeilen)"
                            Katalogprofil="@GebaeudeProfil"
                            Filterstandvorgabe="@_filterstand"
                            StammDetail="@GebaeudeStammdetail"
                            StammSatz="@GebaeudeStammsatz"
                            BedarfGaben="@GebaeudeBedarfGaben"
                            InDbUebernehmen="@(_meldung ? (_, _) => null! : null)"
                            RueckwegVorschau="@GebaeudeRueckwegVorschau"
                            Rueckweg="@((z, ueber, name) => new GebaeudeDbUebernahme(true, ueber ? "Ursprung" : name, "Gebäude übernommen."))"
                            RueckwegNameBelegt="@(n => GebaeudeZeilen.Any(z => z.Bezeichner == n))"
                            ProjektGaben="@(_ => null)"
                            Geschlossen="@(b => Beendet(b))" />
            break;

        case "dubletten":
            <KatalogDublettenDialog Kataloge="@(new List<(string, string)> { ("WP", "Wärmepumpen"), ("PV", "Photovoltaik") })"
                                    Geschlossen="@(b => Beendet(b))" />
            break;

        case "katalog":
            <BedarfAdminDialog Art="BedarfsArt.Stromverbraucher"
                               Katalogzeilen="@(() => BedarfZeilen)"
                               Katalogprofil="@BedarfProfil"
                               Filterstandvorgabe="@_filterstand"
                               Kopf="@(n => n.Length > 0 ? ("Beschreibung " + n, "Typ " + n) : ((string, string)?)null)"
                               Jahressumme="@(n => n.Length > 0 ? "123,45" : "")"
                               Loeschen="@(_ => BedarfLoeschAusgang.Geloescht)"
                               Exists="@(_ => false)"
                               Geschlossen="@(b => Beendet(b))" />
            break;

        case "kaelteprofile":
            <BedarfsProfileDialog Art="BedarfsArt.Kaelte" TitelText="Kältebedarfsprofile"
                                  Zeilen="@KpZeilen" Katalogprofil="@KpProfil"
                                  Katalogzeilen="@(() => KpKatalog)" Filterstandvorgabe="@_filterstand"
                                  Info="@(n => new BedarfsProfilInfo(n, "Raumkühlung eines Bürogeschosses, Mo–Fr 7–19 Uhr", "Raumkühlung Büro", 16, 19))"
                                  Jahressumme="@(_ => 40.0)"
                                  TemperaturPruefen="@((v, r) => null)"
                                  KaelteArten="@(new[] { (WindowsFormsApplication1.DbWerte.KAELTE_ART_RAUM, "Raumkühlung"), (WindowsFormsApplication1.DbWerte.KAELTE_ART_PROZESS, "Prozesskälte") })"
                                  Betriebskalender="@KpKalenderliste()"
                                  BetriebskalenderNeuLesen="@KpKalenderliste"
                                  BetriebskalenderGaben="@KpKalenderGaben"
                                  TypStammGaben="@((n, b, t, neu) => new Dictionary<string, object>())"
                                  TypProfilGaben="@(() => new Dictionary<string, object>())"
                                  KaelteGrafik="@KpGrafik"
                                  TyptageVerfuegbar="true"
                                  Geschlossen="@(b => Beendet(b))" />
            break;

        case "klimaimport":
            @* KD-1: Die Ueberlagerung "Klimadaten einlesen" traegt .epos-einlesen statt eines
               .epos-dialog und eine Leiste ohne Statusspanne - die Probe misst, dass ihre
               Schlussleiste dennoch am Boden der Ueberlagerung haftet. *@
            <EPOS.UI.Dialoge.Klimadaten.KlimadatenDialog
                Regionen="@(() => Task.FromResult<IReadOnlyList<Katalogfilterzeile>>(new[] { new Katalogfilterzeile(1, "Region 1") }))"
                Filterstandvorgabe="@_filterstand"
                Importieren="@((_, _) => Task.FromResult(new KlimaImportErgebnis()))"
                DateiWaehlen="@(_ => Task.FromResult<string?>(null))"
                RegionErmitteln="@KlimaVorschau"
                Loeschen="@(_ => Task.FromResult(true))"
                ExportLesen="@KlimaExportProbe"
                ExportSpeichern="@((_, _) => Task.FromResult(EPOS.UI.Dialoge.Export.KlimaExportErgebnis.Abgebrochen))"
                Geschlossen="@(b => Beendet(b))" />
            break;

        case "klimareihen":
            @* KD-8 Teil A: der Reiter "Weitere Reihen" der Detailkarte - die Reihenwahl bricht um, statt
               quer zu rollen, und die Schlussleiste bleibt im Fenster. *@
            <EPOS.UI.Dialoge.Klimadaten.KlimadatenDialog
                Regionen="@(() => Task.FromResult<IReadOnlyList<Katalogfilterzeile>>(new[] { new Katalogfilterzeile(1, "Region 1") }))"
                Filterstandvorgabe="@_filterstand"
                Ansicht="@KlimaReihenAnsicht"
                Importieren="@((_, _) => Task.FromResult(new KlimaImportErgebnis()))"
                DateiWaehlen="@(_ => Task.FromResult<string?>(null))"
                RegionErmitteln="@KlimaVorschau"
                Loeschen="@(_ => Task.FromResult(true))"
                Geschlossen="@(b => Beendet(b))" />
            break;

        default:
            <p>unbekannter Fall: @_fall</p>
            break;
    }
    }
    @if (_marke)
    {
        <Fenstermarke />
    }
</div>
<p id="probe-ausgang" hidden data-ausgang="@_ausgang"></p>

@code {
    /// <summary>
    /// KD-3: eine volle Vorschau fuer "Datensatz suchen" im Fall klimaimport - neutrale Werte
    /// (Station 1, 56 km, 734 m), Kennzahlen mit Monatsreihen, Parameterbestand und Hinweise.
    /// So misst die Probe die Ueberlagerung MIT Vorschaukarte, ihrer hoechsten Gestalt.
    /// </summary>
    /// <summary>
    /// KD-5: eine Region MIT Rohdaten fuer "Exportieren..." im Fall klimaimport - erfundene Reihen, die laengste
    /// Parameterliste (vier Gruppen) und eine volle Vorschau; so misst die Probe den Export in seiner hoechsten Gestalt.
    /// </summary>
    private static Task<WindowsFormsApplication1.KlimaExportDaten?> KlimaExportProbe(string region)
    {
        var d = new WindowsFormsApplication1.KlimaExportDaten
        {
            IdRegion = 1, Name = region, Quelle = "TRY_Datei", Ausfuehrung = "Probe.dat", Latitude = 50.0, Longitude = 10.0,
            StandortHoeheM = 300, Rohdaten = true, RohZeitbezug = WindowsFormsApplication1.KlimaRohwerteSchema.ZEITBEZUG_MEZ
        };
        foreach (var g in WindowsFormsApplication1.KlimaExportOptionen.Groessen)
            if (g.Art == WindowsFormsApplication1.KlimaWertart.Rechenwert)
                d.Rechenwerte[g.Spalte] = Enumerable.Range(0, 8760).Select(i => 10.0 + i % 24).ToArray();
        foreach (string s in WindowsFormsApplication1.KlimaRohwerteSchema.ROHSPALTEN)
            d.Rohwerte[s] = Enumerable.Range(0, 8760).Select(i => 1000.0 + i % 24).ToArray();
        return Task.FromResult<WindowsFormsApplication1.KlimaExportDaten?>(d);
    }

    private static Task<WindowsFormsApplication1.KlimaVorschauErgebnis> KlimaVorschau(WindowsFormsApplication1.KlimaImportAuftrag a)
    {
        var kz = new WindowsFormsApplication1.KlimaKennzahlen
        {
            Stunden = 8760, Tage = 365, TemperaturMittel = 9.9, TemperaturMin = -12.4, TemperaturMax = 34.3,
            GlobalstrahlungKwhM2 = 1147, GradtagzahlKdA = 3105, Heiztage = 209
        };
        for (int m = 0; m < 12; m++)
        {
            kz.MonatsmittelTemperatur[m] = 10 - 9 * Math.Cos(2 * Math.PI * (m + 0.5) / 12);
            kz.MonatssummeGlobalstrahlungKwhM2[m] = 95 - 70 * Math.Cos(2 * Math.PI * (m + 0.5) / 12);
        }
        // KD-8 Teil A: die weiteren Monatsreihen, damit die Reihenwahl unter dem Bild voll steht.
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.R_LUFTFEUCHTE] = Enumerable.Repeat(75.0, 12).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.R_DIREKT_NORMAL] = kz.MonatssummeGlobalstrahlungKwhM2.Select(w => w * 0.6).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.R_DIFFUS] = kz.MonatssummeGlobalstrahlungKwhM2.Select(w => w * 0.4).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.R_GEGENSTRAHLUNG] = Enumerable.Repeat(220.0, 12).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.R_BEDECKUNG] = Enumerable.Repeat(5.0, 12).ToArray();
        // KD-8 Teil B: die Rohwert-Reihen der Vorschau (Marke "R") - der Satz speichert sie (Schritt 238 steht).
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.ROH_PREFIX + WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_LUFTDRUCK] = Enumerable.Repeat(1013.0, 12).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.ROH_PREFIX + WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_WINDGESCHWINDIGKEIT] = Enumerable.Repeat(3.2, 12).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.ROH_PREFIX + WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_WASSERDAMPF] = Enumerable.Repeat(5.5, 12).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.ROH_PREFIX + WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_AUSSTRAHLUNG] = Enumerable.Repeat(60.0, 12).ToArray();
        kz.Monatsreihen[WindowsFormsApplication1.KlimaReihenkatalog.ROH_PREFIX + WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_DIREKT_HORIZONTAL] = kz.MonatssummeGlobalstrahlungKwhM2.Select(w => w * 0.5).ToArray();
        var bestand = new List<WindowsFormsApplication1.KlimaParameterEintrag>();
        foreach (WindowsFormsApplication1.KlimaParameter p in Enum.GetValues<WindowsFormsApplication1.KlimaParameter>())
            bestand.Add(new() { Parameter = p, Stand = WindowsFormsApplication1.KlimaParameterStand.Gefuehrt });
        return Task.FromResult(new WindowsFormsApplication1.KlimaVorschauErgebnis
        {
            Ausgang = WindowsFormsApplication1.KlimaImportAusgang.Erfolg,
            Quelle = a.Quelle,
            Bezugsjahr = a.TryJahr,
            Szenario = a.Szenario,
            AusfuehrungGefunden = true,
            Standort = new WindowsFormsApplication1.KlimaStandort
            {
                Latitude = 48.7289, Longitude = 9.1085, Anzeigename = "Ort 1, Land 1", AusGeokodierung = true, HoeheM = 450
            },
            Bezugspunkt = new WindowsFormsApplication1.KlimaBezugspunkt
            {
                Art = WindowsFormsApplication1.KlimaBezugspunktArt.Repraesentanzstation, Name = "Station 1",
                Latitude = 48.6536, Longitude = 9.8666, HoeheM = 734, EntfernungKm = 56
            },
            HoehenunterschiedM = 284,
            Kennzahlen = kz,
            RohwerteGespeichert = true,
            Parameterbestand = bestand,
            Repraesentanzhinweis = true,
            Ortshinweis = true
        });
    }

    /// <summary>
    /// KD-8 Teil A: eine Region mit gespeicherten Rechenspalten - neutrale Tagesgaenge, Bedeckungsgrad
    /// leer (die Quelle fuehrt ihn nicht, sein Chip ist weich gesperrt).
    /// </summary>
    private static Task<EPOS.UI.Dialoge.Klimadaten.KlimadatenDialog.Regionsansicht> KlimaReihenAnsicht(string name)
    {
        var zeilen = Enumerable.Range(0, 8760).Select(i => new WindowsFormsApplication1.SolardatenModel
        {
            Außen_Temp = 10 - 9 * Math.Cos(2 * Math.PI * i / 8760.0), Luftfeuchte = 70 + 10 * Math.Sin(2 * Math.PI * i / 24.0),
            Globalstrahlung = Math.Max(0, 600 * Math.Sin(Math.PI * (i % 24 - 6) / 12.0)),
            Direktstrahlung = Math.Max(0, 400 * Math.Sin(Math.PI * (i % 24 - 6) / 12.0)),
            Diffusstrahlung = Math.Max(0, 200 * Math.Sin(Math.PI * (i % 24 - 6) / 12.0)),
            Gegenstrahlung = 300, Sol_Sued = Math.Max(0, 300 * Math.Sin(Math.PI * (i % 24 - 6) / 12.0)),
            Sol_West = 150, Sol_Ost = 150, Sol_Nord = 60
        }).ToList();
        return Task.FromResult(new EPOS.UI.Dialoge.Klimadaten.KlimadatenDialog.Regionsansicht(
            "TRY-Datensatz " + name + ", Quelle 1, Bezugsjahr 2015", 9.18, 48.77, null, null, "")
        {
            Jahresmittel = 9.9, Tiefstwert = -12.4, Hoechstwert = 34.3,
            // KD-8 Teil B: dahinter die Rohwert-Reihen (Marke "R"); zwei davon fuehrt die Region nicht (weich gesperrt).
            Reihenbestand = WindowsFormsApplication1.KlimaReihenkatalog.AusRechenspalten(zeilen)
                .Concat(WindowsFormsApplication1.KlimaReihenkatalog.AusRohwerten(KlimaRohwerteProbe())).ToList()
        });
    }

    /// <summary>
    /// KD-8 Teil B: die Rohwerte der Probe-Region - Luftdruck, Wind und Wasserdampf gefuehrt, Ausstrahlung und
    /// Direktstrahlung horizontal nicht (NULL in jeder Stunde, wie bei einer PVGIS-Region; ihre Chips sind weich gesperrt).
    /// </summary>
    private static WindowsFormsApplication1.KlimaExportDaten KlimaRohwerteProbe()
    {
        var d = new WindowsFormsApplication1.KlimaExportDaten { IdRegion = 1, Rohdaten = true };
        d.Rohwerte[WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_LUFTDRUCK] =
            Enumerable.Range(0, 8760).Select(i => 1000.0 + 15 * Math.Sin(2 * Math.PI * i / 720.0)).ToArray();
        d.Rohwerte[WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_WINDGESCHWINDIGKEIT] =
            Enumerable.Range(0, 8760).Select(i => 3.0 + 2 * Math.Sin(2 * Math.PI * i / 24.0)).ToArray();
        d.Rohwerte[WindowsFormsApplication1.KlimaRohwerteSchema.SPALTE_WASSERDAMPF] =
            Enumerable.Range(0, 8760).Select(i => 5.0 + 3 * Math.Sin(2 * Math.PI * i / 8760.0)).ToArray();
        return d;
    }

