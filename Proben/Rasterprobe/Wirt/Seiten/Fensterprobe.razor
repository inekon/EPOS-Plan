                MaxLastKw = 31.5,
                VollbenutzungsstundenH = 1677.0,
                MonatswerteMwh = monate
            },
            ["Bildauftrag"] = new Func<bool, Zeichenmodell?>(s => s ? DAUER : GANG),
            ["BildauftragRaumtemperatur"] = new Func<Zeichenmodell?>(() => RAUM)
        };
    }

