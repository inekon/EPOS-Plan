<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Berichtsvorlage - pflegt die Word-Vorlage des Berichts
    (Konzept_Berichtsvorlagen_Platzhalter_EPOS-Plan.md, Etappen BV-E0 bis BV-E2, Abschnitt 6.3, Anhang B.3).

    Vier Modi:
      bereinigen <docx>                    doppelte Stildefinitionen (gleiche w:styleId)
                                           zusammenfuehren, je ID bleibt genau eine; das
                                           Absatzformat "EPOS Kapitelkopf" ergaenzen, wenn es fehlt
      beispiel <quelle.docx> <ziel.docx>   aus der bereinigten Vorlage die Beispielvorlage
                                           mit Platzhaltern {{...}} bauen; mit dem Schalter
                                           standard die Standardvorlage im selben Aufbau ohne
                                           Kommentare, mit sammelanker die Stufe mit
                                           {{bericht.inhalt}}; katalogfassung setzt
                                           EPOS.Katalogfassung in custom.xml (Vorgabe 4)
      kurzbericht <quelle> <ziel> (Schalter sprache de oder en)
                                           der Kurzbericht je Sprache (Anhang B.1): Lehrvorlage
                                           aus Einzelwerten, Bloecken, Tabellen und Bildern
      ausfuehrlich <quelle> <ziel> (Schalter sprache de oder en)
                                           die ausfuehrliche Vorlage je Sprache: der volle
                                           Bericht aus Einzelelementen, frei umbaubar

    Logoplatzhalter.png ist das neutrale Platzhalterbild, das in der Kopfzeile an die
    Stelle des Firmenlogos tritt (Bildplatzhalter {{bild.ersteller.logo}}); als
    eingebettete Ressource, damit jeder Lauf dieselben Bytes schreibt.

    Beide Modi pruefen ihr Ergebnis mit dem OpenXmlValidator (Office 2007 bis 2021)
    und schreiben nur, wenn er keinen Fehler meldet.

      bausteine <standard.docx> <ziel.dotx> (Schalter sprache de oder en)
                                           die Bausteinvorlage je Sprache: Dokumentvorlage mit
                                           dem Rumpf der Standardvorlage und jedem Platzhalter
                                           des Katalogs als Schnellbaustein

    Verweis auf EPOS.Kern nur fuer den Modus bausteine: Die Bausteine kommen aus dem
    Platzhalterkatalog (WordBausteinvorlage im Kern, derselbe Weg, an dem die Wache die
    ausgelieferte Datei misst). Die uebrigen Modi lesen und schreiben nur das Word-Paket.
    Die Kapitelfolge des heutigen Berichts steht als Tabelle in Beispielvorlage.cs;
    ob sie zum Code passt, prueft die Wache
    EPOS.Kern.Tests/BerichtsvorlageDateiWacheTests in jedem Kern-Lauf.

    net10.0 ohne Windows-Bindung. Gehoert bewusst NICHT in WP-Plan.sln (Muster:
    Werkzeuge\Auslieferungsvorlage, Werkzeuge\Formularkarte); gebaut wird ueber die
    eigene Projektmappe Berichtsvorlage.sln oder direkt mit "dotnet run" (Aufruf siehe
    LIESMICH.md).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Berichtsvorlage</AssemblyName>
    <RootNamespace>Berichtsvorlage</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\EPOS.Kern\EPOS.Kern.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Logoplatzhalter.png" />
    <EmbeddedResource Include="Logoplatzhalter.png" LogicalName="Berichtsvorlage.Logoplatzhalter.png" />
  </ItemGroup>

</Project>
