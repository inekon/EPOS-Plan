@* DIE ANSICHT „STROMSPEICHER-AUSLEGUNG" (Seitenschluessel STROMSPEICHER_AUSLEGUNG,
   Paket P3 / Auftrag #192, Konzept „Stromspeicher-Dialoge" 2.1).

   ANLASS. Der Anwender gab am 11.09.2026 den Dialog „Auslegung optimieren"
   zurueck, mit fuenf Punkten. Der fuenfte war der kuerzeste: „Fenster in Fenster
   ist nicht gut." Der Flottendialog stand als modale Ueberlagerung ueber der
   Ergebnisseite, sein CSV-Unterdialog als zweite Ueberlagerung darin — vier
   Reiter, eine Fussleiste, ein Warnbanner, ein Fortschrittsbalken und die
   Ergebnistabelle in einem Fenster mit eigenem Rollbalken.

   DAS HAUS KENNT DEN ANDEREN WEG seit W16b/#62b: Simulationskonfiguration und
   Projektassistent sind FREIE ANSICHTEN der AppWurzel (E-5, W16a-E-1),
   Ueberlagerungen bleiben fuer Rueckfragen und kleine Unterdialoge. Genau das ist
   diese Seite: Sie fuellt die WebView, kein Rahmen im Rahmen, kein zweiter
   Rollbalken. Geblieben sind DREI Ueberlagerungen — die CSV-Spaltenzuordnung, die
   Prognosentabelle und die Rueckfrage beim Verlassen.

   EINE ANSICHT, ZWEI MODI (Anwenderentscheid SD-Q1). „Flotte" und
   „Einzelspeicher" teilen Kopf, Ablaufleiste, Daten- und Kostenblatt; RECHNERISCH
   bleiben die Pfade getrennt (SD-Q2) — der Einzelpfad ist der regressionsgepruefte
   (zwoelf Referenzprojekte), der Flottenpfad laeuft gegen Projekt 1046. Mit ihr
   fallen die zwei Dialoge SpeicherFlottenDialog und SpeicherOptimierungDialog
   (Regel iZ5: nie zwei Fassungen derselben Maske).

   DER ABLAUF IST SICHTBAR. Fuenf Schritte statt vier Reiter: 1 Speicher ·
   2 Daten & Kosten · 3 Betriebsfuehrung · 4 Berechnen · 5 Ergebnis. Schritt 4 ist
   ein KNOPF und heisst nach dem, was er tut („Flotte bewerten" ohne, „Groessen
   optimieren" mit dem Suchlauf-Schalter). Schritt 5 ist erst nach einem Lauf
   betretbar, und eine Eingabeaenderung markiert ihn als veraltet.

   WOHER DIE SIMULATION KOMMT. Jede EPOS-Zeitreihe (Last, PV, BHKW, Preise) stammt
   aus einem abgeschlossenen Lauf. Zwei Wege fuehren dorthin, und beide liegen im
   Kern (StromspeicherAuslegungCtrl): Die Ergebnisseite reicht IHREN Lauf herein,
   und wo keiner vorliegt, rechnet die Seite ihn ueber SimulationLaufCtrl nach —
   mit dem Baustein Fortschritt, Muster iU9-W11a.

   KEINE DATENBANK (Hausregel EPOS.UI). Alles, was liest oder schreibt, steht als
   Delegat in StromspeicherAuslegungDienste und fuehrt in den Kern-Controller. *@

@namespace EPOS.UI.Seiten.Strom
@using System.Globalization
@using EPOS.UI.Dialoge.Strom
@using EPOS.UI.Seiten.Assistent
@using EPOS.UI.Seiten.Simulation
@using SpeicherEngine
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-seite epos-spauslegung">

    @* ---------------------------------------------------------------- Kopf *@
    <div class="epos-seite-kopf epos-spauslegung-kopf">
        <h1 class="epos-seite-titel">@TitelText</h1>
        @if (!string.IsNullOrWhiteSpace(ProjektText))
        {
            <span class="epos-spauslegung-kontext">@ProjektText</span>
        }
        <span class="epos-spauslegung-kopfaktionen">
            <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@TitelText" />
            <button type="button" class="epos-knopf" disabled="@_laeuft" @onclick="Verlassen">@ZurueckText</button>
        </span>
    </div>

    @if (_projektAktiv)
    {
        <p role="status" class="epos-spauslegung-projektflotte">
            <strong>@Resource.FLOTTE_DLG_PROJEKT_AKTIV</strong> @Resource.FLOTTE_DLG_PROJEKT_AKTIV_TEXT
            @if (Dienste?.ProjektflotteDeaktivieren is not null)
            {
                <button type="button" class="epos-knopf" disabled="@_laeuft"
                        @onclick="ProjektflotteDeaktivieren">@Resource.FLOTTE_DLG_BTN_PROJEKT_AUS</button>
            }
        </p>
    }

    @* Die VORPRUEFUNG steht UEBER der Ablaufleiste (Konzept 2.4 Punkt 3): Sie
       gehoert zum Lauf, nicht zu einem Blatt — und sie SPERRT nicht, sie warnt.
       Der Lauf startet trotzdem; das ist ausdruecklich so gewollt. *@
    @foreach (FlottenHinweis hinweis in _vorpruefung)
    {
        @* SEIT #199 MIT KENNUNG (Stufe S1, Weg 2): Die Vorpruefung sagt, WAS nicht
           passt; „erklaeren lassen" sagt, WARUM und was zu tun ist. Die Kennung ist
           die sprachneutrale FlottenHinweisKennung - nicht der Text, der mit jeder
           Zahl darin wechselt. *@
        <Warnbanner Stufe="@(hinweis.Stufe == FlottenHinweisStufe.Warnung ? WarnStufe.Warnung : WarnStufe.Hinweis)"
                    Text="@hinweis.Text"
                    Kennung="@KiMeldungskennung.Fuer(hinweis.Kennung)"
                    Hilfeschluessel="@HilfeSchluessel"
                    Dialogname="@TitelText" />
    }

    @* ------------------------------------------------------- Ablaufleiste *@
    <Ablaufleiste Vorne="@Vorne" Hinten="@Hinten" Aktiv="@_schritt"
                  Gewaehlt="SchrittGewaehlt" Verweigert="SchrittVerweigert"
                  RechnenText="@RechnenText" RechnenFrei="@RechnenFrei" Rechnen="Starten"
                  Bezeichnung="@AblaufText" VeraltetText="@VeraltetText">
        <Modusknopf>
            <Auswahlfeld Bezeichnung="@ModusText" Eintraege="@Modi" Auswahl="@((int)_modus)"
                         Aktiv="@(!_laeuft)" AuswahlChanged="ModusGewaehlt" />
        </Modusknopf>
    </Ablaufleiste>

    @if (Eingabefehler.Length > 0)
    {
        @* DER EINGABEFEHLER SPERRT (anders als die Vorpruefung darueber): Ein SoC-Band,
           das nicht zusammenpasst, oder eine Projektlaufzeit von 0 Jahren machen den
           Lauf nicht schlechter, sondern unmoeglich. Bei der Flotte wird er LAUFEND
           gerechnet — so hielt es der abgeloeste Dialog —, beim Einzelspeicher beim
           Start (SpeicherOptimierungCtrl.Pruefe). *@
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@Eingabefehler" />
    }

    @if (_fehler.Length > 0)
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" />
    }

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="@(_meldungErfolg ? WarnStufe.Erfolg : WarnStufe.Fehler)" Text="@_meldung" />
    }

    @if (Dienste?.LaufVorhanden is not null && !Dienste.LaufVorhanden()
         && Dienste.Simulationslauf is not null)
    {
        @* Ohne gerechneten Lauf gibt es keine EPOS-Zeitreihe. Die Seite sagt es und
           bietet den Lauf an, statt ihn heimlich zu starten (Muster W11a). *@
        <div class="epos-spauslegung-lauf">
            <Warnbanner Stufe="WarnStufe.Hinweis" Text="@KeinLaufText" />
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="SimulationslaufStarten">@LaufStartenText</button>
        </div>
    }

    <Fortschritt Sichtbar="@_laeuft" Anteil="@_anteil" Text="@_fortschritt"
                 Abbrechen="@(Dienste?.Abbrechen is null ? (EventCallback?)null
                              : EventCallback.Factory.Create(this, Abbrechen))"
                 AbbrechenText="@Resource.FLOTTE_DLG_BTN_ABBRECHEN" />

    @* ------------------------------------------------------------- Blatt *@
    <div class="epos-spauslegung-blatt">
        @if (_schritt == AuslegungSchritt.Speicher)
        {
            @if (_modus == AuslegungModus.Flotte)
            {
                <SpeicherFlottenEditor Wert="@Flotte" WertChanged="FlotteGeaendert" Aktiv="@(!_laeuft)"
                                       BetriebZeigen="false" PlanerVerfuegbar="@PlanerVerfuegbar" />
                <Schalter Bezeichnung="@Resource.FLOTTE_DLG_CHK_OPTIMIEREN"
                          Wert="@Auslegung.FlottenGroessenOptimieren" Aktiv="@(!_laeuft)"
                          WertChanged="SuchlaufSetzen" />
            }
            else
            {
                <EinzelspeicherSuchraum Wert="@_eingaben" Geaendert="Geaendert" Aktiv="@(!_laeuft)"
                                        AktuelleAuslegung="@_vorgaben.AktuelleAuslegung" />
            }
        }
        else if (_schritt == AuslegungSchritt.Daten)
        {
            @if (_modus == AuslegungModus.Flotte)
            {
                <p class="epos-herleitung">@Resource.FLOTTE_DLG_HINWEIS_KOSTENSAETZE</p>
            }
            <SpeicherAuslegungEditor Wert="@_eingaben" WertChanged="EingabenGeaendert" Aktiv="@(!_laeuft)"
                                     NurQuellenKostenProfile="@(_modus == AuslegungModus.Flotte)"
                                     Auslegungsprofile="@_vorgaben.Auslegungsprofile"
                                     Strompreisprofile="@_vorgaben.Strompreisprofile"
                                     Modulkosten="@_vorgaben.Modulkosten"
                                     EinstellungenSpeichern="@SpeicherWeg"
                                     ProfilSpeichern="@ProfilWeg"
                                     DateiWaehlen="@Dienste?.DateiWaehlen" />
            @if (_modus == AuslegungModus.Flotte && Dienste?.DateiWaehlen is not null)
            {
                <button type="button" class="epos-knopf" disabled="@_laeuft"
                        @onclick="PrognosenOeffnen">@PrognosenText</button>
            }
        }
        else if (_schritt == AuslegungSchritt.Betrieb)
        {
            @if (_modus == AuslegungModus.Flotte)
            {
                <PeakZielBlock Wert="@Flotte.Optionen" WertChanged="BetriebsoptionenGeaendert"
                               Aktiv="@(!_laeuft)" PlanerVerfuegbar="@PlanerVerfuegbar"
                               Vorschlag="@_peakVorschlag"
                               VorschlagUebernehmen="@(_peakVorschlag is null ? default : EventCallback.Factory.Create(this, PeakVorschlagUebernehmen))"
                               Bestimmen="@(Dienste?.PeakZielBestimmen is null ? default : EventCallback.Factory.Create(this, PeakZielBestimmen))"
                               Verweigert="@(EventCallback.Factory.Create(this, PeakZielVerweigert))"
                               VorschlagText="@Resource.FLOTTE_PEAK_BTN_VORSCHLAG"
                               BestimmenText="@Resource.FLOTTE_PEAK_BTN_BESTIMMEN"
                               GesperrtText="@Resource.FLOTTE_PEAK_GESPERRT"
                               NetzladungErlaubtText="@Resource.FLOTTE_PEAK_NETZLADUNG_JA"
                               NetzladungVerbotenText="@Resource.FLOTTE_PEAK_NETZLADUNG_NEIN" />
            }
            else
            {
                <EinzelspeicherBetrieb Wert="@_eingaben" Geaendert="Geaendert" Aktiv="@(!_laeuft)"
                                       Quellen="@Leistungspreisquellen"
                                       LeistungspreisSchreiben="@(Dienste?.LeistungspreisSchreiben is null ? default
                                           : EventCallback.Factory.Create<double>(this, Dienste.LeistungspreisSchreiben))" />
            }
        }
        else if (_schritt == AuslegungSchritt.Ergebnis)
        {
            @if (_modus == AuslegungModus.Flotte)
            {
                @if (_flottenErgebnis is null)
                {
                    <p>@Resource.FLOTTE_DLG_KEIN_VERGLEICH</p>
                }
                else
                {
                    @* DAS DIAGNOSEBANNER STEHT UEBER DEN KACHELN (Konzept 2.2 Punkt 2):
                       Wer die Kacheln liest, bevor er weiss, dass die Flotte nichts
                       getan hat, liest zwoelf Nullen als Ergebnis. *@
                    <FlottenDiagnosebanner Diagnose="@_flottenErgebnis.Studie?.Variante?.Diagnose"
                                           Hinweise="@_flottenErgebnis.Pruefhinweise"
                                           NetzladungSchonErlaubt="@Flotte.Optionen.NetzladungErlaubt"
                                           Gesperrt="@_laeuft"
                                           PeakZielBestimmen="@(Dienste?.PeakZielBestimmen is null ? default
                                               : EventCallback.Factory.Create(this, PeakZielBestimmen))"
                                           NetzladungErlauben="@(EventCallback.Factory.Create(this, NetzladungErlauben))"
                                           ZurBetriebsfuehrung="@(EventCallback.Factory.Create(this, ZurBetriebsfuehrung))"
                                           ArbeitslosText="@ArbeitslosText" HinweiseText="@HinweiseText"
                                           Hilfeschluessel="@HilfeSchluessel" Dialogname="@TitelText"
                                           PeakZielText="@PeakBestimmenText" NetzladungText="@NetzladungText"
                                           BetriebsfuehrungText="@ZuBetriebText" />

                    @* DIE GROESSEN-SICHT (Paket P4 / #193, eingebunden mit #196) steht
                       VOR der Ergebnisansicht, weil Konzept 2.5 sie dort verlangt: Erst
                       die Frage „welche GROESSE traegt sich?", dann die Auswertung der
                       einen gerechneten Flotte. Bedingung ist das RASTERSUCHERGEBNIS und
                       nicht der Schalter „Groessen optimieren": Der Schalter sagt, was
                       der NAECHSTE Lauf tut — abgeschaltet nach einem Suchlauf verschwaende
                       er die Karte, die gerade entstanden ist. Seit #196 traegt DIESER
                       Baustein die Kandidatentabelle; die einfache Texttabelle in der
                       Ergebnisansicht ist damit gefallen (keine zwei Tabellen). *@
                    @if (_flottenErgebnis.Auslegung is not null)
                    {
                        <SpeicherFlottenGroessenAnsicht Ergebnis="@_flottenErgebnis.Auslegung"
                                                        Einheiten="@Einheitenzahl"
                                                        KandidatUebernehmen="@(EventCallback.Factory
                                                            .Create<FlottenKandidatZusammenfassung>(this, KandidatUebernehmen))"
                                                        Csv="@(Dienste?.Csv is null ? default
                                                               : EventCallback.Factory.Create(this, KandidatenCsv))" />
                    }

                    <SpeicherFlottenErgebnisAnsicht Ergebnis="@_flottenErgebnis" Veraltet="@_veraltet"
                                                    Csv="@(Dienste?.Csv is null ? default
                                                           : EventCallback.Factory.Create<string>(this, CsvSchreiben))"
                                                    BetriebsfuehrungAendern="ZurBetriebsfuehrung" />

                    <div class="epos-simerg-fuss">
                        @if (Dienste?.ProjektflotteAktivieren is not null
                             && _flottenErgebnis.Studie?.Variante.Zulaessig == true
                             && _flottenErgebnis.Konfiguration.Einheiten.Count > 0)
                        {
                            <button type="button" class="epos-knopf" disabled="@(_veraltet || _laeuft)"
                                    @onclick="ProjektflotteUebernehmen">@Resource.FLOTTE_DLG_BTN_PROJEKT_AN</button>
                        }
                        @if (_flottenErgebnis.Auslegung?.BesteKonfiguration is not null
                             && !_flottenErgebnis.Auslegung.NullvarianteGewonnen)
                        {
                            <button type="button" class="epos-knopf" disabled="@(_veraltet || _laeuft)"
                                    @onclick="BesteFlotteUebernehmen">@Resource.FLOTTE_DLG_BTN_BESTE</button>
                        }
                    </div>
                }
            }
            else
            {
                @if (_einzelErgebnis is null)
                {
                    <p>@Resource.OPT_MSG_KEIN_ERGEBNIS</p>
                }
                else
                {
                    <EinzelspeicherErgebnis Ergebnis="@_einzelErgebnis" Veraltet="@_veraltet" Gesperrt="@_laeuft"
                                            Gelaufen="@_gelaufen" Betriebsbild="@Dienste?.Betriebsbild"
                                            Uebernehmen="@(Dienste?.AuslegungUebernehmen is null ? default
                                                : EventCallback.Factory.Create<(double Kwh, double Kw)>(this, AuslegungUebernehmen))"
                                            Csv="@(Dienste?.Csv is null ? default
                                                   : EventCallback.Factory.Create<string>(this, CsvSchreiben))" />
                }
            }
        }
    </div>

    @* ------------------------------------------------------ Ueberlagerungen *@
    @if (_csvDatei is not null)
    {
        <Ueberlagerung Offen="true" Titel="@_csvDatei.Dateiname" Zusatzklasse="epos-ueberlagerung--breit"
                       Geschlossen="CsvSchliessen">
            <KindInhalt>
                <SpeicherFlottenCsvDialog Datei="@_csvDatei" Prognosen="@_csvPrognosen"
                                          Optionen="@(_csvPrognosen ? Auslegung.FlottenPrognoseCsvOptionen
                                                                    : Auslegung.FlottenJahresCsvOptionen)"
                                          PrognosenUebernommen="PrognosenUebernehmen"
                                          JahresdatenUebernommen="JahresdatenUebernehmen"
                                          Geschlossen="CsvSchliessen" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @if (_prognosenOffen)
    {
        <Ueberlagerung Offen="true" Titel="@PrognosenTitelText" Zusatzklasse="epos-ueberlagerung--breit"
                       Geschlossen="PrognosenSchliessen">
            <KindInhalt>
                <div class="epos-flotte-prognosen">
                    <p>@Resource.FLOTTE_DLG_PROG_IDEALWISSEN</p>
                    <p>@Resource.FLOTTE_DLG_PROG_ARCHIV</p>
                    <button type="button" class="epos-knopf" disabled="@(_laeuft || Dienste?.DateiWaehlen is null)"
                            @onclick="@(() => CsvOeffnen(true))">@Resource.FLOTTE_DLG_BTN_PROGNOSE_CSV</button>
                    <p>@string.Format(Kultur, Resource.FLOTTE_DLG_PROG_SNAPSHOTS,
                            Auslegung.FlottenPrognoseDatei, Auslegung.FlottenPrognosen.Count)</p>
                    <p>@Resource.FLOTTE_DLG_PROG_JAHRE</p>
                    <button type="button" class="epos-knopf" disabled="@(_laeuft || Dienste?.DateiWaehlen is null)"
                            @onclick="@(() => CsvOeffnen(false))">@Resource.FLOTTE_DLG_BTN_JAHRE_CSV</button>
                    <p>@string.Format(Kultur, Resource.FLOTTE_DLG_PROG_JAHRESREIHEN,
                            Auslegung.FlottenJahresdatenDatei, Auslegung.FlottenProjektjahre.Count)</p>
                    @if (Auslegung.FlottenPrognosen.Count > 0)
                    {
                        <div class="epos-raster-huelle">
                            <table class="epos-tabelle">
                                <thead><tr>
                                    <th>@Resource.FLOTTE_DLG_PROG_SP_SNAPSHOT</th>
                                    <th>@Resource.FLOTTE_DLG_PROG_SP_BEKANNT</th>
                                    <th>@Resource.FLOTTE_DLG_PROG_SP_ENTSCHEIDUNG</th>
                                    <th>@Resource.FLOTTE_DLG_PROG_SP_INTERVALLE</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (FlottenPrognoseSnapshot p in Auslegung.FlottenPrognosen.Take(20))
                                    {
                                        <tr>
                                            <td>@p.Id</td>
                                            <td>@p.BekanntSeit.ToString("u")</td>
                                            <td>@p.Entscheidungszeitpunkt.ToString("u")</td>
                                            <td>@p.Intervalle.Count</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </KindInhalt>
        </Ueberlagerung>
    }

    @* Die RUECKFRAGE beim Verlassen (Muster 62b-E-1): Speichern / Verwerfen /
       Bleiben; Esc heisst „Bleiben", der vorsichtigste der drei. OHNE Aenderung
       gibt es keine Rueckfrage. *@
    <Rueckfrage Offen="@_frageOffen" TitelText="@VerlassenTitelText" Frage="@VerlassenFrageText"
                MitAbbrechen="true" JaText="@SpeichernText" NeinText="@VerwerfenText"
                AbbrechenText="@BleibenText" Beantwortet="VerlassenBeantwortet" />

    @* Die Rueckfrage vor „Kandidat uebernehmen" (#196) — dasselbe Muster wie beim
       Verlassen (62b-E-1): Speichern / Verwerfen / Bleiben, Esc heisst „Bleiben".
       Sie kommt NUR, wenn Schritt 1 ungespeicherte Eingaben traegt; der Kandidat
       ersetzt sie, und wer sie behalten will, speichert sie vorher. *@
    <Rueckfrage Offen="@(_kandidat is not null)" TitelText="@KandidatTitelText"
                Frage="@KandidatFrageText" MitAbbrechen="true"
                JaText="@SpeichernText" NeinText="@VerwerfenText" AbbrechenText="@BleibenText"
                Beantwortet="KandidatBeantwortet" />

    @* Die Rueckfrage nach dem bestimmten Peak-Ziel (SD-Q3). *@
    <Rueckfrage Offen="@(_peakErgebnis is not null)" TitelText="@PeakTitelText" Frage="@PeakFrageText"
                Beantwortet="PeakBeantwortet" />
</div>

@code {
    private static CultureInfo Kultur => CultureInfo.CurrentCulture;

    // =====================================================================
    //  Parameter
    // =====================================================================

    /// <summary>Die Datenseite; ohne sie zeigt die Seite eine leere Vorbelegung.</summary>
    [Parameter] public StromspeicherAuslegungDienste? Dienste { get; set; }

    /// <summary>Die Seite möchte verlassen werden („← zurück").</summary>
    [Parameter] public EventCallback Geschlossen { get; set; }

    /// <summary>
    /// Ist ein Fahrplan-Löser da? <c>null</c> = die Auskunft des Kerns fragen
    /// (<see cref="FlottenPlanerLage.Verfuegbar"/>) — der Betriebsfall.
    /// </summary>
    [Parameter] public bool? PlanerVerfuegbar { get; set; }

    /// <summary>Projekt und Variante in einer Zeile; leer = keine Angabe.</summary>
    [Parameter] public string ProjektText { get; set; } = "";

    /// <summary>
    /// Die ANZEIGETEXTE kommen unmittelbar aus <c>MyResource</c> — dasselbe Muster,
    /// das #184 fuer die fuenf Flottenbausteine eingefuehrt hat. Ein Bündel aus
    /// dreissig <c>[Parameter] string</c> haette die Fachparameter der Seite zwischen
    /// Knopfbeschriftungen versteckt (Hausregel EPOS.UI/CLAUDE.md).
    /// </summary>
    private static string TitelText => Resource.FLOTTE_SEITE_TITEL;
    private static string ZurueckText => Resource.FLOTTE_SEITE_ZURUECK;
    private static string ModusText => Resource.FLOTTE_SEITE_MODUS;
    private static string ModusFlotteText => Resource.FLOTTE_SEITE_MODUS_FLOTTE;
    private static string ModusEinzelText => Resource.FLOTTE_SEITE_MODUS_EINZEL;
    private static string AblaufText => Resource.FLOTTE_SEITE_ABLAUF;
    private static string VeraltetText => Resource.FLOTTE_SEITE_VERALTET;
    private static string Schritt1Text => Resource.FLOTTE_SEITE_SCHRITT1;
    private static string Schritt1EinzelText => Resource.FLOTTE_SEITE_SCHRITT1_EINZEL;
    private static string Schritt2Text => Resource.FLOTTE_SEITE_SCHRITT2;
    private static string Schritt3Text => Resource.FLOTTE_SEITE_SCHRITT3;
    private static string Schritt5Text => Resource.FLOTTE_SEITE_SCHRITT5;
    private static string RechnenFlotteText => Resource.FLOTTE_SEITE_BTN_FLOTTE;
    private static string RechnenGroessenText => Resource.FLOTTE_SEITE_BTN_GROESSEN;
    private static string RechnenEinzelText => Resource.FLOTTE_SEITE_BTN_EINZEL;
    private static string ErgebnisGesperrtText => Resource.FLOTTE_SEITE_ERGEBNIS_GESPERRT;
    private static string KeinLaufText => Resource.FLOTTE_SEITE_KEIN_LAUF;
    private static string LaufStartenText => Resource.FLOTTE_SEITE_BTN_LAUF;
    private static string PrognosenText => Resource.FLOTTE_SEITE_BTN_PROGNOSEN;
    private static string PrognosenTitelText => Resource.FLOTTE_SEITE_PROGNOSEN_TITEL;
    private static string ArbeitslosText => Resource.FLOTTE_BANNER_ARBEITSLOS;
    private static string HinweiseText => Resource.FLOTTE_BANNER_HINWEISE;
    private static string PeakBestimmenText => Resource.FLOTTE_BANNER_BTN_PEAKZIEL;
    private static string NetzladungText => Resource.FLOTTE_BANNER_BTN_NETZLADUNG;
    private static string ZuBetriebText => Resource.FLOTTE_BANNER_BTN_BETRIEB;
