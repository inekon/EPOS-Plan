@* Kostenverwaltung einer Komponente (iU9-W4.2).

   Vorbild: Views/Kosten/Form_KostenKomponente.cs (918 Z.) und .Designer.cs —
   Etappe KD2/KD6a, Konzept Kostendialoge Rev. 1.2 § 5. Drei Kontexte in einem
   Dialog: Katalogpflege je Komponente und Kategorie mit Varianten (KL2), der
   Projektmodus ueber Tab_ProjektWerte (KD6a § 3.2) und — als Abschnitt — die
   Ertrags-/Bonusanzeige des BHKW bzw. der Photovoltaik (KD5 § 6).

   DER WIRT DER WELLE. Fuenf Dialoge der Wellen 1 bis 3 haengen an dieser Maske:
   Worst/Best (W1.3), der Zeileneditor (W1.1), die Namensabfrage (W1.2), die
   Uebernahme (W1.4) und der Kostenfaktor-Katalog (W1.5). Alle fuenf sind
   bereits Razor-Komponenten — bis hierher oeffnete sie die WinForms-Maske
   jeweils in einer eigenen BlazorWebView. Seit W4.0 stehen sie in einer
   Ueberlagerung: dasselbe Fenster, dieselbe WebView (Risiko R2).

   DIE DATENSEITE LIEGT IN DER HUELLE. Die Komponente kennt weder
   KostenVorlagenCtrl noch KostenProjektPositionenCtrl. Sie fragt mit einem
   KostenKomponenteKontext und bekommt einen KostenKomponenteStand — genau die
   fuenf Methoden des Vorlaeufers (KopfAnzeigen, VariantenLaden, RasterAufbauen,
   SummenAnzeigen, ErtragReiterSteuern) in einer Antwort.

   ZWEI REITER - WIE IM VORLAEUFER (iU9-W5.0, Nachzug von A-2). Der
   Vorlaeufer trug ein TabControl mit „Kosten Invest/Betrieb" und
   „Ertrag/Bonus" und ENTFERNTE die zweite Seite zur Laufzeit, wenn das
   Gewerk keinen Ertrag kennt (ErtragReiterSteuern). Welle 4 stellte beides
   untereinander, weil es den Baustein Reiter noch nicht gab (offener Punkt
   W4-O1); seit Welle 5 gibt es ihn - und das Weglassen der zweiten Seite ist
   hier nur ein @if.

   EINE AENDERUNG LEBT BIS „SPEICHERN" NUR IM OBJEKT (Ae12/Ae19) — und wird beim
   AUFFRISCHEN mitgenommen. Eine Zeilenaktion (Position anlegen, Position
   loeschen, Uebernahme) schreibt sofort und laesst den Stand danach neu laden;
   die Huelle baut dabei jede Zeile neu aus der Datenbank. Damit die Regel
   traegt, uebertraegt KontextLaden die ungespeicherten Eingaben der bestehenden
   Zeilen auf die neu geladenen Objekte (EingabenUebertragen). Ein echter
   Kontextwechsel laedt weiterhin ohne Uebertrag; „Abbrechen" verwirft alles.

   TASTATUR: Esc schliesst zuerst eine offene Ueberlagerung, dann den Dialog.
   Enter ist nicht belegt: „Speichern", „Uebernahme" und „Katalog" schreiben
   sofort (A-7 aus B5b). *@

@namespace EPOS.UI.Dialoge.Kosten
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Wirtschaftlichkeit
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: eingebettet in der betitelten Ueberlagerung der
       Kostenseite traegt DIE den Titel; der Wirt setzt dort TitelAnzeigen="false",
       dann bleiben Titel und Kreuz hier aus. Der Titel kommt hier aus dem Stand
       (@_stand.Titel), nicht aus einem TitelText - Bauart b der Hausregel. Der
       Hilfeknopf bleibt unbedingt, er haengt nicht am Titel. *@
    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@_stand.Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="BeiAbbrechen" />
        }
    </div>

    <p class="epos-kontextzeile">@_stand.Untertitel</p>

    @if (_bannerOffen && !string.IsNullOrEmpty(BannerText))
    {
        <div class="epos-bannerzeile">
            <Warnbanner Stufe="WarnStufe.Hinweis" Text="@BannerText" />
            <button type="button" class="epos-knopf epos-zr-knopf" title="@BannerZuKurztext"
                    @onclick="() => _bannerOffen = false">✕</button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    @* ------------------------------------------------------------ Kontext *@
    <div class="epos-kontextleiste">
        <Auswahlfeld Bezeichnung="@LabelKomponente" Eintraege="@Eintraege"
                     Auswahl="@_eintragId" AuswahlChanged="BeiEintrag" />
        <Optionsgruppe Bezeichnung="@LabelKategorie"
                       Eintraege="@KATEGORIEN" Auswahl="@(_invest ? 1 : 0)"
                       AuswahlChanged="BeiKategorie" />
    </div>

    @if (_stand.VariantePflegbar)
    {
        <div class="epos-kontextleiste">
            <Auswahlfeld Bezeichnung="@LabelVariante" Eintraege="@_stand.Varianten"
                         Auswahl="@_stand.VarianteId" AuswahlChanged="BeiVariante" />
            <button type="button" class="epos-knopf" @onclick="() => VarianteFragen(false)">@VarianteNeuText</button>
            <button type="button" class="epos-knopf" @onclick="() => VarianteFragen(true)">@SpeichernUnterText</button>
            <button type="button" class="epos-knopf epos-zr-knopf" title="@VarianteLoeschenKurztext"
                    disabled="@(!_stand.VarianteLoeschbar)" @onclick="VarianteLoeschenFragen">🗑️</button>
        </div>
    }

    @if (_stand.NurLesen)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@ReadOnlyHinweis" />
    }

    <Reiter @bind-Aktiv="_reiter" Bezeichnung="@ReiterBezeichnung">
        <KindInhalt>

    <Reiterblatt Schluessel="KOSTEN" Titel="@TitelReiterKosten">
        <KindInhalt>

    @* U31: DIESELBE Doppelpflege-Warnung wie in der Kohärenzgruppe des
       BHKW-Dialogs — Hilfsenergie ist an der Anlage UND als Kostenposition
       gepflegt. Der Satz kommt wortgleich aus der Kohärenzprüfung; hier steht
       er über dem Raster, weil hier die Kostenposition gepflegt wird. *@
    @if (!string.IsNullOrEmpty(_stand.DoppelpflegeWarnung))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_stand.DoppelpflegeWarnung" />
    }

    @* U31: WOHER DIE MENGEN KOMMEN. Auf der Betriebsseite bemessen sich Zeilen
       an Größen des Simulationslaufs; wie alt der ist, stand bis dahin nirgends.
       Ohne Lauf steht hier der Grund, den auch die Zeilen ohne Bezugsgröße
       nennen. *@
    @if (!string.IsNullOrEmpty(_stand.Laufstand))
    {
        <p class="epos-herleitung epos-kdlg-laufstand">@_stand.Laufstand</p>
    }

    @* ------------------------------------------------------------- Raster *@
    <Zeilenraster Bezeichnung="@LabelRaster" Spaltenmass="@SPALTENMASS"
                  Spalten="@Spaltenkopf()" Summen="@_stand.Summen">
        <KindInhalt>
            @foreach (KostenPositionZeile z in _stand.Zeilen)
            {
                KostenPositionZeile zeile = z;
                <VorlagenZeile @key="zeile.Id"
                               Bezeichnung="@zeile.Bezeichnung"
                               BezeichnungChanged="@(w => Feld(zeile, () => zeile.Bezeichnung = w))"
                               Bemessungen="@_stand.Bemessungen"
                               BemessungId="@zeile.BemessungId"
                               BemessungIdChanged="@(w => Feld(zeile, () => zeile.BemessungId = w))"
                               Satz="@zeile.Satz"
                               SatzChanged="@(w => Feld(zeile, () => zeile.Satz = w))"
                               Einheit="@zeile.Einheit"
                               BetragText="@zeile.BetragText"
                               Kette="@zeile.Kette"
                               BetragKurztext="@zeile.BetragKurztext"
                               OhneBasis="@zeile.OhneBasis"
                               BasisHerleitung="@zeile.BasisHerleitung"
                               Herleitung="@zeile.Herleitung"
                               EmpfehlungKurztext="@zeile.EmpfehlungKurztext"
                               EmpfehlungZeile="@zeile.EmpfehlungZeile"
                               SatzHerleitung="@zeile.SatzHerleitung"
                               VorlagenHinweis="@zeile.VorlagenHinweis"
                               VorlagenUebernehmenText="@VorlageUebernehmenText"
                               VorlagenUebernehmenKurztext="@VorlageUebernehmenKurztext"
                               VorlagenUebernahme="@(() => VorlageUebernehmen(zeile))"
                               IstPflicht="@(IstPflicht is not null && IstPflicht(zeile))"
                               PflichtKurztext="@PflichtKurztext"
                               Nutzungsdauer="@zeile.Nutzungsdauer"
                               NutzungsdauerChanged="@(w => Feld(zeile, () => zeile.Nutzungsdauer = w))"
                               NutzungsdauerHerleitung="@zeile.NutzungsdauerHerleitung"
                               MitNutzungsdauer="@_stand.MitNutzungsdauer"
                               MitWorstBest="@_stand.MitWorstBest"
                               Schreibbar="@zeile.Schreibbar"
                               EditorKurztext="@EditorKurztext"
                               LoeschenKurztext="@ZeileLoeschenKurztext"
                               WorstBestKurztext="@WorstBestKurztext"
                               KetteKurztext="@KetteKurztext"
                               EditorAngefordert="@(() => EditorOeffnen(zeile))"
                               LoeschenAngefordert="@(() => LoeschenFragen(zeile))"
                               WorstBestAngefordert="@(() => CaseOeffnen(zeile))" />
            }
        </KindInhalt>
        <AbschlussZeile>
            @if (_stand.PositionNeuMoeglich)
            {
                <div class="epos-zr-neuzeile">
                    <div class="epos-zr-neuraster" style="grid-template-columns: @SPALTENMASS">
                        <VorlagenZeile Neuzeile="true" Bezeichnung="@_neuerName"
                                       BezeichnungChanged="@(w => _neuerName = w)"
                                       Bemessungen="@_stand.Bemessungen"
                                       MitNutzungsdauer="@_stand.MitNutzungsdauer"
                                       Platzhalter="@NeuPlatzhalter"
                                       AnlegenKurztext="@PositionNeuText"
                                       AnlegenAngefordert="PositionAnlegen" />
                    </div>
                </div>
            }
        </AbschlussZeile>
    </Zeilenraster>

    @* ANWENDERBEFUND 14.09.2026: KEIN STILLES 0 - die Gruende der Zeilen ohne
       Bezugsgroesse stehen UNTER dem Raster. Der Vorlaeufer trug sie nur im
       Werkzeugtipp des Betragsfeldes; im Bildschirmfoto des Befundes war unter
       dem Raster deshalb nichts zu sehen. *@
    @if (OhneBasisText.Length > 0)
    {
        <p class="epos-zr-ohnebasis-zeile">
            <span class="epos-zr-ohnebasis" role="img" aria-hidden="true">⚠</span>
            @OhneBasisText
        </p>
    }

    @* U31: DIE BEZUGSGRÖSSE DER PROZENTZEILEN, sichtbar. „% der Endenergiekosten"
       und „% des Endenergiebedarfs" bemessen sich an einer Größe, die nirgends im
       Dialog stand — der Anwender sah den Prozentsatz und den Betrag, aber nicht,
       woran der Satz hängt. Die Gruppe nennt sie je Anlage; gerechnet und gesetzt
       wird im Kern (KostenBetriebsstand). Ohne Endenergie keine Gruppe. *@
    @if (_stand.Endenergie.Count > 0)
    {
        <Gruppenkopf Titel="@GruppeEndenergieTitel">
            <KindInhalt>
                <table class="epos-kdlg-endenergie">
                    <thead>
                        <tr>
                            <th scope="col">@SpalteEndenergieKomponente</th>
                            <th scope="col" class="epos-kdlg-endenergie--zahl">@SpalteEndenergieKwh</th>
                            <th scope="col" class="epos-kdlg-endenergie--zahl">@SpalteEndenergieEuro</th>
                            <th scope="col">@SpalteEndenergieBasis</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (EndenergieZeile e in _stand.Endenergie)
                        {
                            <tr>
                                <td>@e.Komponente</td>
                                <td class="epos-kdlg-endenergie--zahl">@e.Bedarf</td>
                                <td class="epos-kdlg-endenergie--zahl">@e.Kosten</td>
                                <td>@e.Basis</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="epos-herleitung">@HinweisEndenergie</p>
            </KindInhalt>
        </Gruppenkopf>
    }

    @* U30: DIE TAFEL „ERSATZ UND RESTWERT". Der Dialog kannte die Nutzungsdauer je
       Zeile, rechnete aber weder Ersatzjahr noch Restwert vor — beides stand
       nirgends in der Anwendung. Gerechnet wird mit DENSELBEN Funktionen wie die
       Kapitalwertrechnung (KapitalwertRechner.Ersatz), gesetzt wird im Kern
       (ErsatzRestwertTafel); die Oberfläche zeigt fertige Zeilen. Leere Liste =
       keine Tafel (Betriebsseite, Katalogkontext). *@
    @if (_stand.ErsatzRestwert.Count > 0)
    {
        <Gruppenkopf Titel="@GruppeErsatzTitel">
            <KindInhalt>
                @* Der Hinweis steht ÜBER der Tafel: Er ist ein Prüfauftrag, keine
                   Fehlermeldung — eine Planungsleistung wird zu Recht nicht ersetzt,
                   eine Hydraulik ohne gepflegte Dauer würde es zu Unrecht nicht. *@
                @if (!string.IsNullOrEmpty(_stand.ErsatzRestwertHinweis))
                {
                    <Warnbanner Stufe="WarnStufe.Hinweis" Text="@_stand.ErsatzRestwertHinweis" />
                }
                <table class="epos-kdlg-ersatz">
                    <thead>
                        <tr>
                            <th scope="col">@SpalteErsatzPosition</th>
                            <th scope="col" class="epos-kdlg-ersatz--zahl">@SpalteErsatzBetrag</th>
                            <th scope="col" class="epos-kdlg-ersatz--zahl">@SpalteErsatzDauer</th>
                            <th scope="col">@SpalteErsatzErsatz</th>
                            <th scope="col" class="epos-kdlg-ersatz--zahl">@_stand.SpalteRestwert</th>
                            <th scope="col">@SpalteErsatzHerkunft</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ErsatzRestwertZeile e in _stand.ErsatzRestwert)
                        {
                            <tr class="@(e.IstSumme ? "epos-kdlg-ersatz--summe" : "")">
                                <td>@e.Position</td>
                                <td class="epos-kdlg-ersatz--zahl">@e.Betrag</td>
                                <td class="epos-kdlg-ersatz--zahl">@e.Dauer</td>
                                <td>
                                    @e.Ersatz
                                    @if (!string.IsNullOrEmpty(e.ErsatzBarwert))
                                    {
                                        <span class="epos-herleitung">@e.ErsatzBarwert</span>
                                    }
                                </td>
                                <td class="epos-kdlg-ersatz--zahl">
                                    @e.Restwert
                                    @if (!string.IsNullOrEmpty(e.RestwertBarwert))
                                    {
                                        <span class="epos-herleitung">@e.RestwertBarwert</span>
                                    }
                                </td>
                                <td>@e.Herkunft</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </KindInhalt>
        </Gruppenkopf>
    }

    <div class="epos-leiste">
        <button type="button" class="epos-knopf" disabled="@(!_stand.PositionNeuMoeglich)"
                @onclick="PositionAnlegenMitVorgabe">@PositionNeuText</button>
        <button type="button" class="epos-knopf" @onclick="UebernahmeOeffnen">@UebernahmeText</button>
        <button type="button" class="epos-knopf" @onclick="KatalogOeffnen">@KatalogText</button>
        @* U8 (Stufe S2, Anwenderentscheid ND‑Q4 (b)): NUR AUF KNOPFDRUCK. Nichts
           ändert eine gerechnete Wirtschaftlichkeit ohne Zutun — der Knopf füllt
           LEERE Nutzungsdauern und fragt nach, bevor er gefüllte überschreibt.
           Ohne Delegat kein Knopf (Hausregel). *@
        @* ETAPPE E2 (Mockup-Pruefung 03/#26): Der Knopf erscheint nur, wo er WIRKT -
           auf der Investitionsseite einer schreibbaren Vorlage bzw. eines Projekts.
           Auf der Betriebsseite stand er dauerhaft gesperrt da und behauptete eine
           Bedienung, die es dort nicht gibt. Ein gesperrtes Bedienelement bleibt nur
           stehen, wo es seinen Grund erklaeren kann; hier ist der Grund der
           Kontext, und der steht im Reiter. *@
        @* ETAPPE E10 (Stufe S3): Auf der BETRIEBSSEITE wirkt derselbe Knopf jetzt auch -
           als "Saetze vorbelegen...": Er fuellt die leeren Saetze der Positionen
           "Instandhaltung ..."/"Wartung ..." mit "% der Investition" aus der
           Nutzungsdauertabelle. Dieselbe Bedienung, dieselbe Rueckfrage, eigene Texte. *@
        @if (NutzungsdauerVorbelegen is not null &&
             (_stand.NutzungsdauerVorbelegbar || _stand.SaetzeVorbelegbar))
        {
            <button type="button" class="epos-knopf"
                    @onclick="VorbelegenAngefordert">@(_stand.SaetzeVorbelegbar ? SaetzeVorbelegenText : VorbelegenText)</button>
        }
    </div>

        </KindInhalt>
    </Reiterblatt>

    @* ------------------------------------------------------ Ertrag/Bonus *@
    @if (_stand.ErtragSichtbar && _stand.ErtragGaben is not null)
    {
        <Reiterblatt Schluessel="ERTRAG" Titel="@TitelReiterErtrag">
            <KindInhalt>
                @* Kein Delegat, kein Knopf: Ohne GesetzeGaben bekommt das
                   Reiterblatt auch keinen Rueckruf. *@
                @* Der @ref traegt den Hilfe-Assistenten: Die PV-Wahl und das
                   PV-Projekt leben in diesem Baustein, angemeldet ist sie der
                   WIRT (Hausregel EPOS.UI, Welle KI-F7). *@
                <ErtragBonus @ref="_ertrag" @attributes="_stand.ErtragGaben"
                             GesetzeGewuenscht="@GesetzeRueckruf"
                             PvOeffnen="@PvRueckruf"
                             NeuLaden="@ErtragNeuLaden" />
            </KindInhalt>
        </Reiterblatt>
    }

        </KindInhalt>
    </Reiter>

    @* DL-2 (Nr. 6): die eine Fussleiste des Hauses - Status (zugleich Fueller) ·
       Speichern · Abbrechen · OK. Die Reiterleiste im Reiter „Kosten" bleibt, wo
       sie ist: Sie traegt keinen primaeren und keinen schliessenden Knopf und ist
       damit eine Blattleiste, keine zweite Fussleiste. *@
    <SpeichernLeiste @ref="_leiste" MitSpeichern="true"
                     SatzMarkiert="true" Geaendert="true"
                     SpeichernText="@SpeichernText" Gespeichertwerden="BeiSpeichern"
                     AbbrechenText="@AbbrechenText" AbbrechenKurztext="@AbbrechenKurztext"
                     OkText="@OkText" Ergebnis="BeiErgebnis" />

    @* ------------------------------------------------------ Unterdialoge *@
    @* Das Kreuz steht beim Titel: Jede dieser sechs Ueberlagerungen traegt ihren
       Titel, also traegt sie auch das ✕ - das eingebettete Blatt bekommt darum
       TitelText="" hinter seinem Parametersatz und zeigt weder Titel noch Kreuz. *@
    <Ueberlagerung Offen="@(_caseZeile is not null)"
                   Titel="@CaseTitel" Geschlossen="() => CaseFertigMachen(null)">
        <KindInhalt>
            @if (_caseGaben is not null)
            {
                <CaseEingabeDialog @attributes="_caseGaben" TitelText=""
                                   Geschlossen="CaseFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_editorZeile is not null)"
                   Titel="@EditorTitel" Geschlossen="() => EditorFertigMachen(null)">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                <VorlagenPositionDialog @attributes="_editorGaben" TitelText=""
                                        Geschlossen="EditorFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_variantenGaben is not null)"
                   Titel="@VarianteTitel" Geschlossen="() => VarianteFertigMachen(null)">
        <KindInhalt>
            @if (_variantenGaben is not null)
            {
                <NamensDialog @attributes="_variantenGaben" TitelText=""
                              Geschlossen="VarianteFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_uebernahmeGaben is not null)"
                   Titel="@UebernahmeTitel"
                   Geschlossen="() => UebernahmeFertigMachen(new VorlagenUebernahmeSchluss(false, _invest))">
        <KindInhalt>
            @if (_uebernahmeGaben is not null)
            {
                <VorlagenUebernahmeDialog @attributes="_uebernahmeGaben" TitelText=""
                                          Geschlossen="UebernahmeFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_katalogGaben is not null)"
                   Titel="@KatalogTitel" Geschlossen="KatalogFertigMachen">
        <KindInhalt>
            @if (_katalogGaben is not null)
            {
                <KostenfaktorKatalogDialog @attributes="_katalogGaben" TitelText=""
                                           Geschlossen="KatalogFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* Die SECHSTE Ueberlagerung (iU9-W14c.3): der Gesetzeskatalog. Bis W14c
       sprang ErtragBonus dorthin ueber die Sprungbruecke; das Ziel ist jetzt
       selbst Razor, und zwei WebViews uebereinander sind Risiko R2. *@
    <Ueberlagerung Offen="@(_gesetzeGaben is not null)"
                   Titel="@GesetzeTitel" Geschlossen="() => GesetzeFertigMachen(false)">
        <KindInhalt>
            @if (_gesetzeGaben is not null)
            {
                <GesetzeskatalogDialog @attributes="_gesetzeGaben" TitelText=""
                                       Geschlossen="GesetzeFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* Die SIEBTE Ueberlagerung (E3/6): die PV-Verguetung. Bis dahin fuhr der
       Knopf des Reiterblatts "Ertrag/Bonus" ein ZWEITES WinForms-Fenster ueber
       diesem hoch (Risiko R2, deshalb nachgelagert); seit die PV-Huelle selbst
       plattformfrei ist, steht sie hier - auf Windows wie auf iOS.
       Ein Titel, eine Stelle: Die Ueberlagerung traegt Titel UND Kreuz,
       TitelAnzeigen="false" steht RECHTS vom Satz. *@
    <Ueberlagerung Offen="@(_pvGaben is not null)"
                   Titel="@PvTitel" Geschlossen="() => PvFertigMachen(null)">
        <KindInhalt>
            @if (_pvGaben is not null)
            {
                <PhotovoltaikVerguetungDialog @attributes="_pvGaben" TitelAnzeigen="false"
                                              Geschlossen="PvFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* Die ACHTE Ueberlagerung (E3/7): das Ziel des Sprungknopfs „Tarif…" im
       PV-Verguetungsdialog. Er nimmt seit #405 den OK-Weg (pruefen, schreiben,
       springen) - bis hierher lief der Sprung aber in ein zweites Fenster, und
       nach dessen Fall ins Leere. Kein Delegat, kein Sprungziel: Ohne TarifGaben
