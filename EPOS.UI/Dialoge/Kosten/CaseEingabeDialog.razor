@* Worst/Best Case einer Kostenposition (iU9-W1.3).

   Vorbild: Views/Kosten/Form_CaseEingabe.cs (301 Z.) und .Designer.cs. Die
   Feldkarte kennt nur die vier Drehfelder des Designers; VIER weitere Felder
   entstanden im Vorlaeufer zur Laufzeit (Regel F1 des Wellenplans: solche
   Felder von Hand nachtragen):

     Designer   numBestCase, numWorstCase (Kosten [€])
                numBestCase_Nutzungsdauer, numWorstCase_Nutzungsdauer ([a])
     KD6 § 11   rbCaseAbsolut / rbCaseProzent  -> Optionsgruppe
                lblCaseUmrechnung              -> Herleitungszeile
                lblStartJahr + numStartJahr    -> Ganzzahlfeld
     K5 § 7.4   chkZuschuss + lblZuschussHinweis (nur Investitions-
                NEBENpositionen, siehe ZuschussMoeglich)

   PROZENTMODUS. Woertlich aus ProzentModusGewechselt und ProzentZuBetrag: Beim
   Umschalten auf % werden die Betraege in Abweichungen zum Erwartungswert
   umgerechnet (0 bleibt 0 = "nicht gepflegt", eine Nachkommastelle), beim
   Zurueckschalten wieder in Betraege (nicht unter 0). Gespeichert werden IMMER
   Betraege (KL9). Ohne Erwartungswert bleibt der Modus gesperrt.

   TEXTE. Sechs Schluessel des Vorlaeufers werden weiterverwendet
   (KOSTEN_CASE_ABSOLUT, _PROZENT, _UMRECHNUNG, _STARTJAHR, KOSTEN_CHK_ZUSCHUSS,
   _HINT); die Beschriftungen des Designers bekommen KCASE_* (W1.7).

   ETAPPE E9b - DER ALLGEMEINE BAUSTEIN "SZENARIOPAAR" (Konzept § 2.11.5, Pflege;
   Entscheid E9b-Q1, Lesart a). Derselbe Dialog pflegt seither auch das
   Best/Worst-Paar eines TRAEGERPREISES (Traegerkarte) und eines ERLOESSATZES
   (Einspeiseverguetung PV und KWK, DV-Entgelt, PPA-Preis). Mit Szenariopaar="true"
   entfallen Nutzungsdauer, Startjahr, Zuschuss und die Erloeszeile; Einheit,
   Grenzen und Nachkommastellen kommen vom Aufrufer, dazu die Erwartet-Zeile, die
   Warnung "kein Erwartet-Wert" (E9b-Q4: warnen, nicht verweigern) und die
   Kohaerenzzeilen (gepflegte Werte, die im Lauf ohne Wirkung bleiben). Der
   Prozentmodus bleibt: Er rechnet gegen den Erwartet-Wert (Betrag) und rundet auf
   die Nachkommastellen des Paars. 0 und leer heissen wie bei der Kostenposition
   "nicht gepflegt" - fuer das Paar also "wie Erwartet".

   OHNE Szenariopaar ist alles Zeichen fuer Zeichen die Kostenposition von vorher:
   dieselben Felder, dieselben Grenzen, dieselbe Rundung, derselbe Hilfeschluessel
   (Pruefmuster Form_CaseEingabe der Formularkarte). *@

@namespace EPOS.UI.Dialoge.Kosten
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="@(() => BeiErgebnis(false))" />
        }
    </div>

    @* ETAPPE E9b (Szenariopaar): ZUERST der Erwartet-Wert, gegen den das Paar
       steht - er ist der Masstab beider Felder und die Basis des Prozentmodus. Fehlt
       er, sagt es die Warnung darunter (E9b-Q4): Gepflegt werden darf trotzdem. *@
    @if (Szenariopaar && !string.IsNullOrEmpty(ErwartetText))
    {
        <Herleitungszeile Text="@ErwartetText" />
    }
    @if (Szenariopaar && OhneErwartet && !string.IsNullOrEmpty(WarnungOhneErwartet))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@WarnungOhneErwartet" />
    }

    <Optionsgruppe Bezeichnung="@LabelEingabeart"
                   Eintraege="@_eingabearten"
                   Auswahl="@(_prozentModus ? MODUS_PROZENT : MODUS_ABSOLUT)"
                   Gesperrt="@_gesperrteModi"
                   AuswahlChanged="BeiEingabeart" />

    @if (_prozentModus)
    {
        <Herleitungszeile Text="@Umrechnungstext" />
    }

    <Gruppenkopf Titel="@LabelKosten">
        <KindInhalt>
            @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben dem
               Feld, Zahlenfelder kurz mit der Einheit dahinter. *@
            <Formularraster>
                <KindInhalt>
                    <Zahlenfeld Bezeichnung="@LabelBestKosten" Einheit="@EinheitKosten"
                                Wert="@_best" Min="@MinKosten" Max="@MaxKosten"
                                Nachkommastellen="@Anzeigestellen"
                                WertChanged="BeiBest" />
                    <Zahlenfeld Bezeichnung="@LabelWorstKosten" Einheit="@EinheitKosten"
                                Wert="@_worst" Min="@MinKosten" Max="@MaxKosten"
                                Nachkommastellen="@Anzeigestellen"
                                WertChanged="BeiWorst" />
                </KindInhalt>
            </Formularraster>
        </KindInhalt>
    </Gruppenkopf>

    @if (!Szenariopaar)
    {
        <Gruppenkopf Titel="@LabelNutzungsdauer">
            <KindInhalt>
                <Formularraster>
                    <KindInhalt>
                        <Zahlenfeld Bezeichnung="@LabelBestNutzung" Wert="@_bestNutzung"
                                    Min="0" Max="99999" WertChanged="@(w => _bestNutzung = w ?? 0)" />
                        <Zahlenfeld Bezeichnung="@LabelWorstNutzung" Wert="@_worstNutzung"
                                    Min="0" Max="99999" WertChanged="@(w => _worstNutzung = w ?? 0)" />
                    </KindInhalt>
                </Formularraster>
            </KindInhalt>
        </Gruppenkopf>

        <Formularraster>
            <KindInhalt>
                <Ganzzahlfeld Bezeichnung="@LabelStartJahr" Wert="@_startJahr"
                              Min="0" Max="50" WertChanged="@(w => _startJahr = w ?? 0)" />

                @if (ZuschussMoeglich)
                {
                    <Schalter Bezeichnung="@LabelZuschuss" Wert="@_istZuschuss"
                              WertChanged="@(w => _istZuschuss = w)" />
                }
            </KindInhalt>
        </Formularraster>

        @if (ZuschussMoeglich)
        {
            <Herleitungszeile Text="@HinweisZuschuss" />
        }

        @if (IstErloes)
        {
            <Herleitungszeile Text="@HinweisErloes" />
        }
    }
    else
    {
        @* ETAPPE E9b: was ein leeres Feld heisst, und die Kohaerenzzeilen des Wirts -
           gepflegte Werte, die der Lauf nicht liest (Staffel, Rollenmodell,
           PV-Verguetungsdialog). Sie sperren nichts. *@
        @if (!string.IsNullOrEmpty(HinweisLeer))
        {
            <Herleitungszeile Text="@HinweisLeer" />
        }
        @foreach (string hinweis in Hinweise)
        {
            <Kohaerenzzeile Text="@hinweis" Zustand="KohaerenzZustand.Abweichend" />
        }
    }

    <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
</div>

@code {
    /// <summary>Id der Option "Eingabe absolut [€]".</summary>
    public const int MODUS_ABSOLUT = 0;

    /// <summary>Id der Option "Eingabe in % vom Erwartungswert".</summary>
    public const int MODUS_PROZENT = 1;

    /// <summary>
    /// Der Erwartungswert der Position (<c>KostenPosition.Betrag</c>). Er ist die
    /// Basis des Prozentmodus; ist er 0, bleibt der Modus gesperrt — wie
    /// <c>_rbProzent.Enabled = _daten.Betrag != 0</c>.
    /// </summary>
    [Parameter] public double Betrag { get; set; }

    /// <summary>Bester Fall [€] beim Oeffnen.</summary>
    [Parameter] public double BestCase { get; set; }

    /// <summary>Schlechtester Fall [€] beim Oeffnen.</summary>
    [Parameter] public double WorstCase { get; set; }

    /// <summary>Nutzungsdauer im besten Fall [a] beim Oeffnen.</summary>
    [Parameter] public double BestNutzungsdauer { get; set; }

    /// <summary>Nutzungsdauer im schlechtesten Fall [a] beim Oeffnen.</summary>
    [Parameter] public double WorstNutzungsdauer { get; set; }

    /// <summary>Startjahr beim Oeffnen (0 = sofort).</summary>
    [Parameter] public int StartJahr { get; set; }

    /// <summary>Zuschuss-Kennzeichen beim Oeffnen.</summary>
    [Parameter] public bool IstZuschuss { get; set; }

    /// <summary>
    /// Zeigt den Zuschuss-Schalter. Ob er angeboten wird, entscheidet der
    /// Aufrufer nach der Regel von <c>ZuschussSchalterAnlegen</c>: keine
    /// Hauptkomponente UND Kostenart leer, kapitalgebunden oder bereits
    /// Zuschuss.
    /// </summary>
    [Parameter] public bool ZuschussMoeglich { get; set; }

    /// <summary>
    /// Erlösposition? Dann steht unter den Feldern eine Zeile, die das
    /// Vorzeichen erklaert. Der Vorlaeufer sagte dazu nichts.
    /// </summary>
    [Parameter] public bool IstErloes { get; set; }

    /// <summary>Das Ergebnis bei OK, <c>null</c> bei Abbrechen.</summary>
    [Parameter] public EventCallback<CaseEingabeErgebnis?> Geschlossen { get; set; }

    /// <summary>Fenstertitel (Designer: Form.Text).</summary>
    [Parameter] public string TitelText { get; set; } = "Eingabe Worst/Best Case";

    /// <summary>Titel der Optionsgruppe. Der Vorlaeufer hatte keinen — die beiden
    /// Schalter standen ohne Ueberschrift ueber den Feldern.</summary>
    [Parameter] public string LabelEingabeart { get; set; } = "";

    /// <summary>Erste Option (Designer-Nachbau: rbCaseAbsolut).</summary>
    [Parameter] public string LabelAbsolut { get; set; } = "Eingabe absolut [€]";

    /// <summary>Zweite Option (rbCaseProzent).</summary>
    [Parameter] public string LabelProzent { get; set; } = "Eingabe in % vom Erwartungswert";

    /// <summary>Vorlage der Umrechnungszeile (lblCaseUmrechnung), zwei Platzhalter.</summary>
    [Parameter] public string VorlageUmrechnung { get; set; } = "ergibt: Best {0:N2} € · Worst {1:N2} €";

    /// <summary>Gruppentitel der Kostenfelder (Designer: label2).</summary>
    [Parameter] public string LabelKosten { get; set; } = "Kosten:";

    /// <summary>Gruppentitel der Nutzungsdauerfelder (Designer: label3).</summary>
    [Parameter] public string LabelNutzungsdauer { get; set; } = "Nutzungsdauer:";

    /// <summary>Beschriftung numBestCase.</summary>
    [Parameter] public string LabelBestKosten { get; set; } = "Best Case [€]:";

    /// <summary>Beschriftung numWorstCase.</summary>
    [Parameter] public string LabelWorstKosten { get; set; } = "Worst Case [€]:";

    /// <summary>Beschriftung numBestCase_Nutzungsdauer.</summary>
    [Parameter] public string LabelBestNutzung { get; set; } = "Best Case [a]:";

    /// <summary>Beschriftung numWorstCase_Nutzungsdauer.</summary>
    [Parameter] public string LabelWorstNutzung { get; set; } = "Worst Case [a]:";

    /// <summary>Beschriftung des Startjahrfeldes (lblStartJahr).</summary>
    [Parameter] public string LabelStartJahr { get; set; }
        = "Startjahr (0 = sofort; Jahr X: Zahlung/Betrieb ab X):";

    /// <summary>Beschriftung des Zuschuss-Schalters (KOSTEN_CHK_ZUSCHUSS).</summary>
    [Parameter] public string LabelZuschuss { get; set; } = "Diese Position ist ein Zuschuss";

    /// <summary>Erlaeuterung unter dem Zuschuss-Schalter (KOSTEN_CHK_ZUSCHUSS_HINT).</summary>
    [Parameter] public string HinweisZuschuss { get; set; } = "";

    /// <summary>Erlaeuterung fuer Erlöspositionen.</summary>
    [Parameter] public string HinweisErloes { get; set; }
        = "Erlösposition: Die Werte werden als Betrag eingegeben; das negative Vorzeichen setzt die Rechnung.";

    /// <summary>Beschriftung des OK-Knopfes.</summary>
    [Parameter] public string OkText { get; set; } = "OK";

    /// <summary>Beschriftung des Abbrechen-Knopfes.</summary>
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Schluessel des Hilfeknopfes — die vorhandene Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_CaseEingabe.btn_Help";

    // =====================================================================
    // ETAPPE E9b — der allgemeine Baustein „Szenariopaar“ (Konzept § 2.11.5)
    // =====================================================================

    /// <summary>
    /// ETAPPE E9b (E9b‑Q1, Lesart a): Pflegt der Dialog das Best/Worst-Paar eines
    /// Trägerpreises oder Erlössatzes statt einer Kostenposition? Dann entfallen
    /// Nutzungsdauer, Startjahr, Zuschuss und Erlöszeile; Einheit, Grenzen und
    /// Nachkommastellen kommen vom Aufrufer, dazu Erwartet-Zeile, Warnung und
    /// Kohärenzzeilen. Vorgabe <c>false</c>: die Kostenposition wie bisher.
    /// </summary>
    [Parameter] public bool Szenariopaar { get; set; }

    /// <summary>ETAPPE E9b: was das Paar ist („Arbeitspreis Erdgas E") — die Auskunft
    /// für den Assistenten; die Beschriftungen setzt der Aufrufer über
    /// <see cref="LabelKosten"/> und die Feldtexte.</summary>
    [Parameter] public string Groesse { get; set; } = "";

    /// <summary>ETAPPE E9b: die Einheit der beiden Felder im Absolutmodus. Vorgabe „€“ —
    /// die Einheit der Kostenposition.</summary>
    [Parameter] public string Einheit { get; set; } = "€";

    /// <summary>ETAPPE E9b: die Nachkommastellen des Paars — Anzeige der Felder und
    /// Rundung der Prozentumrechnung. Nur im <see cref="Szenariopaar"/>; die
    /// Kostenposition rundet wie bisher auf Cent und zeigt die Felder ohne feste
    /// Stellen.</summary>
    [Parameter] public int Nachkommastellen { get; set; } = 2;

    /// <summary>ETAPPE E9b: kleinster Wert im Absolutmodus (Vorgabe 0 wie bisher).</summary>
    [Parameter] public double MinWert { get; set; }

    /// <summary>ETAPPE E9b: größter Wert im Absolutmodus (Vorgabe 99 999 wie bisher).</summary>
    [Parameter] public double MaxWert { get; set; } = 99999;

    /// <summary>ETAPPE E9b: die Zeile „Erwartet: 0,8400 €/Nm³“; leer = keine Zeile.</summary>
    [Parameter] public string ErwartetText { get; set; } = "";

    /// <summary>
    /// ETAPPE E9b (E9b‑Q4, Lesart a — warnen, nicht verweigern): der Satz, der steht,
    /// solange kein Erwartet-Wert gepflegt ist (<see cref="Betrag"/> = 0). Günstig und
    /// Ungünstig rechnen dann mit ihrem Szenariowert, Erwartet zeigt die Datenlücke.
    /// </summary>
    [Parameter] public string WarnungOhneErwartet { get; set; } = "";

    /// <summary>ETAPPE E9b: was ein leeres Feld heißt („leer oder 0 = wie Erwartet“).</summary>
    [Parameter] public string HinweisLeer { get; set; } = "";

    /// <summary>
    /// ETAPPE E9b: die Kohärenzzeilen des Wirts — gepflegte Werte, die im Lauf ohne
    /// Wirkung bleiben (E9a‑Q3: Staffel oder Saisonreihe neben einem
    /// Szenario-Leistungspreis; E9a‑Q7: Rollenmodell bzw. PV-Vergütungsdialog neben einer
    /// flachen Einspeisevergütung). Hinweise ohne Rechenwirkung; sie sperren nichts.
    /// </summary>
    [Parameter] public IReadOnlyList<string> Hinweise { get; set; } = Array.Empty<string>();

    /// <summary>ETAPPE E9b: Fehlt der Erwartet-Wert, gegen den das Paar steht?</summary>
    public bool OhneErwartet => Szenariopaar && Betrag == 0;

    /// <summary>Die Rundung der Prozentumrechnung: Cent bei der Kostenposition, die
    /// Stellen des Paars sonst.</summary>
    private int Rundung => Szenariopaar ? Math.Clamp(Nachkommastellen, 0, 6) : 2;

    /// <summary>Feste Anzeigestellen der zwei Felder — nur im Szenariopaar, und im
    /// Prozentmodus eine (die Rundung der Abweichung).</summary>
    private int? Anzeigestellen => !Szenariopaar ? null : _prozentModus ? 1 : Rundung;

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private double? _best;
    private double? _worst;
    private double _bestNutzung;
    private double _worstNutzung;
    private int _startJahr;
    private bool _istZuschuss;
    private bool _prozentModus;

    private (int Id, string Text)[] _eingabearten = Array.Empty<(int, string)>();
    private int[]? _gesperrteModi;

    /// <summary>Steht der Dialog im Prozentmodus? (Pruefhilfe fuer Tests.)</summary>
    public bool ProzentModus => _prozentModus;

    /// <summary>Der Einheitenzusatz hinter den Kostenfeldern — im Absolutmodus die
    /// <see cref="Einheit"/> (Kostenposition: „€“).</summary>
    private string EinheitKosten => _prozentModus ? "%" : Einheit;

    /// <summary>Grenzen der Kostenfelder — im Prozentmodus ±1000 (ProzentModusGewechselt),
    /// sonst der Designerbereich 0…99 999 bzw. die Grenzen des Szenariopaars.</summary>
    private double MinKosten => _prozentModus ? -1000 : MinWert;

    private double MaxKosten => _prozentModus ? 1000 : MaxWert;

    /// <summary>Die Umrechnungszeile des Prozentmodus (lblCaseUmrechnung). ETAPPE E9b: Im
    /// Szenariopaar stehen die Werte fertig formatiert mit Stellen und Einheit darin —
    /// „nicht gepflegt" als Gedankenstrich, nicht als 0, die wie ein Preis aussähe.</summary>
    private string Umrechnungstext => Szenariopaar
        ? string.Format(CultureInfo.CurrentCulture, VorlageUmrechnung,
                        MitEinheit(ProzentZuBetrag(_best ?? 0)), MitEinheit(ProzentZuBetrag(_worst ?? 0)))
        : string.Format(CultureInfo.CurrentCulture, VorlageUmrechnung,
                        ProzentZuBetrag(_best ?? 0), ProzentZuBetrag(_worst ?? 0));

    private string MitEinheit(double wert) => wert == 0
        ? "—"
        : wert.ToString("N" + Rundung.ToString(CultureInfo.InvariantCulture), CultureInfo.CurrentCulture)
          + " " + Einheit;

    /// <summary>ETAPPE E9b: die Werte, wie sie beim OK herausgingen — Beträge bzw.
    /// Preise, nie Prozente (Prüfhilfe für Tests und die Auskunft des Kurztexts).</summary>
    public (double Best, double Worst) Ausgabe =>
        (_prozentModus ? Math.Max(0, ProzentZuBetrag(_best ?? 0)) : (_best ?? 0),
         _prozentModus ? Math.Max(0, ProzentZuBetrag(_worst ?? 0)) : (_worst ?? 0));

    protected override void OnInitialized()
    {
        // ETAPPE E9b: Im Szenariopaar ist 0 „nicht gepflegt" (wie Erwartet) — das Feld
        // bleibt leer; die Kostenposition zeigt ihre 0 wie bisher.
        _best = Szenariopaar && BestCase == 0 ? null : BestCase;
        _worst = Szenariopaar && WorstCase == 0 ? null : WorstCase;
        _bestNutzung = BestNutzungsdauer;
        _worstNutzung = WorstNutzungsdauer;
        _startJahr = StartJahr;
        _istZuschuss = IstZuschuss;

        _eingabearten = new[]
        {
            (MODUS_ABSOLUT, LabelAbsolut),
            (MODUS_PROZENT, LabelProzent)
        };
        // rbCaseAbsolut.Checked = true; rbCaseProzent.Enabled = Betrag != 0.
        _gesperrteModi = Betrag != 0 ? null : new[] { MODUS_PROZENT };

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.CASE_EINGABE,
                                          () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent (Welle KI-F4)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private CaseEingabeKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die sieben lebenden Felder. Ein Daten-Objekt gibt
    /// es nicht — <c>CaseEingabeErgebnis</c> entsteht erst beim OK und trägt die
    /// Beträge dann immer in Euro.
    /// </summary>
    /// <remarks>
    /// Der PROZENTMODUS läuft über denselben Weg wie die Optionsgruppe der Maske:
    /// Er rechnet die zwei Kostenfelder um, statt nur einen Schalter umzulegen.
    /// Ohne gepflegten Erwartungswert lehnt er ab — dann gibt es nichts, wovon
    /// abzuweichen wäre.
    /// </remarks>
    private CaseEingabeKiSicht KiSicht()
    {
        // ETAPPE E9b: Im Szenariopaar führt die Maske weder Nutzungsdauer noch Startjahr
        // noch Zuschuss — ihre Setzwege bleiben dann leer (gesetzt wird nichts), und die
        // zwei Auskunftsfelder sagen, WAS gepflegt wird und gegen welchen Erwartet-Wert.
        bool kosten = !Szenariopaar;
        return _kiSicht ??= new CaseEingabeKiSicht
        {
            ProzentmodusLesen = () => _prozentModus,
            ProzentmodusSetzen = w => BeiEingabeart(w ? MODUS_PROZENT : MODUS_ABSOLUT),

            BestLesen = () => _best,
            BestSetzen = w => _best = w,
            WorstLesen = () => _worst,
            WorstSetzen = w => _worst = w,

            BestDauerLesen = () => kosten ? _bestNutzung : 0,
            BestDauerSetzen = kosten ? new Action<double>(w => _bestNutzung = w) : null,
            WorstDauerLesen = () => kosten ? _worstNutzung : 0,
            WorstDauerSetzen = kosten ? new Action<double>(w => _worstNutzung = w) : null,

            JahrLesen = () => kosten ? _startJahr : 0,
            JahrSetzen = kosten ? new Action<int>(w => _startJahr = w) : null,

            ZuschussLesen = () => kosten && _istZuschuss,
            ZuschussSetzen = kosten ? new Action<bool>(w => _istZuschuss = w) : null,

            GroesseLesen = () => Szenariopaar && !string.IsNullOrEmpty(Groesse)
                                 ? Groesse : LabelKosten.TrimEnd(':', ' '),
            ErwartetLesen = () => Betrag == 0 ? null : Betrag,
            EinheitLesen = () => Einheit
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> Der Dialog meldet sein Ergebnis an den Wirt; der
    /// schreibt es mit seinem eigenen OK.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private void BeiBest(double? wert) => _best = wert;

    private void BeiWorst(double? wert) => _worst = wert;

    /// <summary>
    /// Woertlich aus <c>ProzentModusGewechselt</c>: Betraege werden zu
    /// %-Abweichungen und zurueck. Ohne Erwartungswert geschieht nichts.
    /// </summary>
    private void BeiEingabeart(int? id)
    {
        bool prozent = id == MODUS_PROZENT;
        if (prozent == _prozentModus) return;
        if (Betrag == 0) return;

        double basis = Math.Abs(Betrag);
        if (prozent)
        {
            // 0 bleibt 0 = "nicht gepflegt".
            _best = (_best ?? 0) == 0 ? 0 : Math.Round(((_best ?? 0) - Betrag) / basis * 100.0, 1);
            _worst = (_worst ?? 0) == 0 ? 0 : Math.Round(((_worst ?? 0) - Betrag) / basis * 100.0, 1);
        }
        else
        {
            _best = Math.Max(0, ProzentZuBetrag(_best ?? 0));
            _worst = Math.Max(0, ProzentZuBetrag(_worst ?? 0));
        }

        // ETAPPE E9b: Im Szenariopaar heisst "nicht gepflegt" LEER - das Feld bleibt
        // dann auch nach dem Umschalten leer, statt eine 0 zu zeigen, die wie ein Preis
        // aussieht.
        if (Szenariopaar)
        {
            if (_best == 0) _best = null;
            if (_worst == 0) _worst = null;
        }
        _prozentModus = prozent;
    }

    /// <summary>Woertlich aus <c>ProzentZuBetrag</c>: 0 = nicht gepflegt. ETAPPE E9b: Das
    /// Szenariopaar rundet auf seine eigenen Nachkommastellen (ein Arbeitspreis in €/kWh
    /// verlöre auf Cent gerundet seine Aussage).</summary>
    private double ProzentZuBetrag(double prozent)
    {
        if (Betrag == 0 || prozent == 0) return 0;
        return Math.Round(Betrag * (1.0 + prozent / 100.0), Rundung);
    }

    private async Task BeiErgebnis(bool ok)
    {
        if (!ok)
        {
            await Geschlossen.InvokeAsync(null);
            return;
        }

        // btn_OK_Click: im %-Modus in Betraege uebersetzen, nie unter 0.
        (double best, double worst) = Ausgabe;

        await Geschlossen.InvokeAsync(new CaseEingabeErgebnis(
            best, worst, _bestNutzung, _worstNutzung,
            _startJahr > 1 ? _startJahr : 0,          // wie btn_OK_Click
            ZuschussMoeglich ? _istZuschuss : IstZuschuss));
    }

    private Task BeiTaste(KeyboardEventArgs e) => e.Key switch
    {
        "Enter" => BeiErgebnis(true),
        "Escape" => BeiErgebnis(false),
        _ => Task.CompletedTask
    };
}
