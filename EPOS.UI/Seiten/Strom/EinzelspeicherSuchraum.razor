@* SCHRITT 1 des Modus „Einzelspeicher" — DER SUCHRAUM der Rastersuche
   (aus SpeicherOptimierungDialog, W11b-B-5 / W11b-B-25; mit P3 ein Blatt der
   Ablaufleiste statt eines Dialogkopfes).

   DREI SPALTEN, ENGE ZEILEN. Der Formularraster stand auf der Hausvorgabe
   auto-fill und ergab auf breitem Schirm zwei Spalten mit einer leeren dritten
   Spaltenbreite dahinter (Befund W11b-B-25: „Dialog uebersichtlicher");
   .epos-speicheropt-suchraum stellt ihn auf drei Spalten. Die Enge kommt aus dem
   Stilblatt, nicht aus neuen Feldern.

   DER WERT WIRD AN ORT UND STELLE GESCHRIEBEN. Der Suchraum gehoert der SEITE —
   sie haelt den einen Arbeitsstand, aus dem am Ende der Lauf entsteht. Dieses
   Blatt meldet nur, DASS etwas geschrieben wurde; was daraus folgt (Ergebnis
   veraltet, Fehlertext weg), entscheidet die Seite. *@

@namespace EPOS.UI.Seiten.Strom
@using System.Globalization
@using SpeicherEngine
@using WindowsFormsApplication1

<section class="epos-speicheropt-blatt" aria-label="@Resource.OPT_GRP_SUCHRAUM">

    <div class="epos-speicheropt-suchraum">
        <Formularraster>
            <KindInhalt>
                <Formulargruppe Titel="@Resource.OPT_GRP_SUCHRAUM">
                    <KindInhalt>
                        <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_CMIN" Wert="@Wert.CMinKwh" Aktiv="@Aktiv" Min="0"
                                    WertChanged="@(w => Setzen(v => Wert.CMinKwh = v, w))" />
                        <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_CMAX" Wert="@Wert.CMaxKwh" Aktiv="@Aktiv" Min="0"
                                    WertChanged="@(w => Setzen(v => Wert.CMaxKwh = v, w))" />
                        <Ganzzahlfeld Bezeichnung="@Resource.OPT_LBL_STUETZSTELLEN" Wert="@Wert.Stuetzstellen" Aktiv="@Aktiv"
                                      Min="@SpeicherOptimierungCtrl.STUETZSTELLEN_MIN"
                                      Max="@SpeicherOptimierungCtrl.STUETZSTELLEN_MAX"
                                      WertChanged="@(w => SetzenGanz(v => Wert.Stuetzstellen = v, w))" />
                        <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_RMIN" Wert="@Wert.RMin" Aktiv="@Aktiv" Min="0"
                                    WertChanged="@(w => Setzen(v => Wert.RMin = v, w))" />
                        <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_RMAX" Wert="@Wert.RMax" Aktiv="@Aktiv" Min="0"
                                    WertChanged="@(w => Setzen(v => Wert.RMax = v, w))" />
                        <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_RSCHRITT" Wert="@Wert.RSchritt" Aktiv="@Aktiv" Min="0"
                                    WertChanged="@(w => Setzen(v => Wert.RSchritt = v, w))" />
                        <Schalter Bezeichnung="@Resource.OPT_CHK_FEINRASTER" Wert="@Wert.Feinraster" Aktiv="@Aktiv"
                                  WertChanged="@(w => { Wert.Feinraster = w; return Geaendert.InvokeAsync(); })" />
                    </KindInhalt>
                </Formulargruppe>
            </KindInhalt>
        </Formularraster>
    </div>

    @* Die Erklaerung steht UNTER der Gruppe, nicht neben der Klappliste — genau
       das war Befund 1 der Windows-Abnahme V2 („Texte ueberschneiden sich"). *@
    <Herleitungszeile Text="@Resource.OPT_HINWEIS_SUCHRAUM" />

    <p class="epos-speicheropt-zeile">
        @if (!string.IsNullOrEmpty(AktuelleAuslegung))
        {
            <span class="epos-speicheropt-aktuell">@AktuelleAuslegung</span>
        }
        <span class="epos-speicheropt-punkte">@Punktetext</span>
    </p>
</section>

@code {
    /// <summary>Der Arbeitsstand der Seite; er wird AN ORT UND STELLE geschrieben.</summary>
    [Parameter, EditorRequired] public SpeicherOptimierungEingaben Wert { get; set; } = new();

    /// <summary>Ein Feld hat geschrieben.</summary>
    [Parameter] public EventCallback Geaendert { get; set; }

    /// <summary>Darf bearbeitet werden? (Während eines Laufs: nein.)</summary>
    [Parameter] public bool Aktiv { get; set; } = true;

    /// <summary>Die Zeile „Aktuelle Auslegung: …" aus den Vorgaben; leer = keine.</summary>
    [Parameter] public string AktuelleAuslegung { get; set; } = "";

    private string Punktetext => string.Format(CultureInfo.CurrentCulture,
        Resource.OPT_LBL_PUNKTE, SpeicherOptimierungCtrl.Punktzahl(Wert));

    /// <summary>
    /// Ein LEERES Feld (<c>null</c>) lässt den bisherigen Wert stehen; geprüfte Grenzen
    /// gibt es erst beim Start — während des Tippens ist „Kapazität von" zwischenzeitlich
    /// immer größer als „bis".
    /// </summary>
    private Task Setzen(Action<double> schreiben, double? wert)
    {
        if (wert.HasValue) schreiben(wert.Value);
        return Geaendert.InvokeAsync();
    }

    private Task SetzenGanz(Action<int> schreiben, int? wert)
    {
        if (wert.HasValue) schreiben(wert.Value);
        return Geaendert.InvokeAsync();
    }
}
