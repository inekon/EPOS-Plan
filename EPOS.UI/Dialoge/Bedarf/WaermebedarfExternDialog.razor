    /// <summary>Die Art der markierten Kältezeile; leer oder unbekannt fällt auf den ersten Eintrag (Raum).</summary>
    private int? KaelteArtindex
    {
        get
        {
            if (_gewaehlt is null) return 0;
            for (int i = 0; i < KaelteArten.Count; i++)
                if (string.Equals(KaelteArten[i].Wert, _gewaehlt.KaelteArt, StringComparison.OrdinalIgnoreCase)) return i;
            return 0;
        }
    }

    private IReadOnlyList<(int Id, string Text)> KaelteArteintraege
        => KaelteArten.Select((a, i) => (i, a.Text)).ToList();

    /// <summary>KWN-0: setzt die Art der markierten Kältezeile.</summary>
    private void KaelteArtWaehlen(int? index)
    {
        if (_gewaehlt is null || index is null) return;
        if (index.Value < 0 || index.Value >= KaelteArten.Count) return;
        _gewaehlt.KaelteArt = KaelteArten[index.Value].Wert;
        Geaendert?.Invoke();
    }

    private void KanalWaehlen(int? index)
    {
        if (_gewaehlt is null || index is null) return;
        if (index.Value < 0 || index.Value >= Kanaele.Count) return;

        _gewaehlt.Kanal = Kanaele[index.Value].Wert;
        Geaendert?.Invoke();
    }

    // =================================================================================
    // Uebernehmen und Entfernen
    // =================================================================================

    /// <summary>
    /// „◀" — je Zuordnung ein EIGENES Modell; die neue Zeile steht auf Heizung und wird
    /// markiert, damit die Kanalwahl sichtbar auf sie wirkt
    /// (<c>btn_Hinzu_Click</c>:206-238).
    /// </summary>
    private async Task BeiHinzu()
    {
        if (Aufnehmen is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;

        // Sammelübernahme (4.5): je angekreuzter Katalogzeile eine Zuordnung; gewählt ist danach die letzte neue.
        WaermebedarfExternZeile? letzte = null;
        foreach (Katalogfilterzeile k in ziele)
        {
            WaermebedarfExternZeile? neu = Aufnehmen(k.Bezeichner);
            if (neu is null) continue;
            if (Modus == WaermebedarfExternModus.NurKuehlung) neu.Kanal = DbWerte.KANAL_KUEHLUNG;
            Zeilen.Add(neu);
            letzte = neu;
        }
        if (letzte is null) return;

        _meldung = "";
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
        await ProjektZeileWaehlen(letzte);
        Geaendert?.Invoke();
    }

    /// <summary>
    /// „▶" — entfernt GENAU die markierte Zeile. Der Vorläufer suchte die ERSTE Zeile
    /// gleichen Namens; bei zwei Zuordnungen derselben Ganglinie traf er damit die
    /// falsche (A-9, dieselbe Fehlerklasse wie W7 A-21).
    /// </summary>
    private async Task BeiEntfernen()
    {
        List<WaermebedarfExternZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;

        // Entfernt GENAU die gewählten Zeilen (die angekreuzten, sonst die markierte).
        foreach (WaermebedarfExternZeile z in ziele) Zeilen.Remove(z);
        _projektWahl.Leeren();
        _gewaehlt = SichtbareZeilen.FirstOrDefault();
        _meldung = "";

        if (_gewaehlt is null) GrafikVerwerfen();
        else await GrafikLaden(WahlZu(_gewaehlt));

        Geaendert?.Invoke();
    }

    // =================================================================================
    // Importieren (W9-E-3) - DERSELBE Weg wie in der Verwaltung
    // =================================================================================

    private async Task BeiImportieren()
    {
        if (!ImportMoeglich || _laeuft || _import is null) return;

        _meldung = "";

        // W13-B-1: Der Waehler DARF warten und wird await-et - nie synchron im
        // Blazor-Ereignis ausgewertet.
        string? pfad = await DateiWaehlen!(Dateifilter);
        if (string.IsNullOrEmpty(pfad)) return;      // abgebrochen: nichts passiert

        GanglinienImportErgebnis? erg = await _import.Starten(pfad, GanglinienRaster.Unbekannt);
        if (erg is null) return;

        if (!string.IsNullOrEmpty(erg.Meldung))
            Melden(erg.Meldung, GanglinienImportLauf.StufeZu(erg));

        if (erg.Ausgang == ImportAusgang.Erfolg) await KatalogLaden();
    }

    // =================================================================================
    // Katalog: Loeschen, Speichern unter
    // =================================================================================

    /// <summary>
    /// „Löschen" — erst die zwei Sperren, dann die Rückfrage. Der
    /// Vorläufer löschte ohne Rückfrage (A-8) und kannte die ReadOnly-Sperre nur im
    /// Controller, wo sie eine <c>MessageBox</c> zeigte.
    /// </summary>
    private void BeiLoeschen()
    {
        if (!LoeschenErlaubt) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;

        // Die zwei Sperren: Eine zugeordnete Ganglinie und ein Auslieferungssatz bleiben stehen.
        // Delete prueft das Schloss selbst; hier steht es davor, damit die Rueckfrage nicht kommt.
        // EIN Satz meldet seine Sperre; bei mehreren nennt die eine Rueckfrage die uebersprungenen.
        if (ziele.Count == 1)
        {
            Katalogfilterzeile z = ziele[0];
            if (HatProjektzuordnung is not null && HatProjektzuordnung(z.Bezeichner))
            {
                Melden(MeldungZuordnung, WarnStufe.Warnung);
                return;
            }
            if (z.Geschuetzt)
            {
                Melden(TextSchreibgeschuetzt, WarnStufe.Warnung);
                return;
            }
            _loeschziele = ziele;
            _loeschGesperrt = new();
            _loeschZugeordnet = new();
        }
        else
        {
            _loeschGesperrt = ziele.Where(z => z.Geschuetzt).ToList();
            _loeschZugeordnet = ziele.Where(z => !z.Geschuetzt && HatProjektzuordnung is not null
                                                 && HatProjektzuordnung(z.Bezeichner)).ToList();
            _loeschziele = ziele.Except(_loeschGesperrt).Except(_loeschZugeordnet).ToList();
            if (_loeschziele.Count == 0)
            {
                Melden(_loeschZugeordnet.Count > 0 ? MeldungZuordnung : TextSchreibgeschuetzt, WarnStufe.Warnung);
                return;
            }
        }

        _meldung = "";
        _loeschfrage = true;
    }

    /// <summary>Die EINE Rückfrage: ein Satz mit Namen, mehrere mit Zahl und Namen, dazu die übersprungenen.</summary>
    private string LoeschfrageText
    {
        get
        {
            string text = _loeschziele.Count <= 1
                ? string.Format(MeldungLoeschfrage, _loeschziele.FirstOrDefault()?.Bezeichner ?? Katalogname ?? "")
                : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, _loeschziele.Count,
                                string.Join(", ", _loeschziele.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschGesperrt.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                            string.Join(", ", _loeschGesperrt.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschZugeordnet.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.GANGL_UEBERSPRUNGEN_ZUGEORDNET,
                                            string.Join(", ", _loeschZugeordnet.Select(z => "„" + z.Bezeichner + "“")));
            return text;
        }
    }

    private async Task LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || KatalogLoeschen is null || ziele.Count == 0) return;

        var geloescht = new List<string>();
        string fehler = "";
        foreach (Katalogfilterzeile z in ziele)
        {
            // KT-4: Wirft der Löschweg, nennt die Meldung den Grund (Katalogladung.Loeschen).
            bool weg = Katalogladung.Loeschen(() => KatalogLoeschen(z.Bezeichner), z.Bezeichner, out string grund);
            if (weg) geloescht.Add(z.Bezeichner);
            else if (fehler.Length == 0) fehler = grund.Length > 0 ? grund : TextSchreibgeschuetzt;
        }

        if (geloescht.Contains(_katalogGewaehlt)) { _katalogZeile = null; _katalogGewaehlt = ""; GrafikVerwerfen(); }
        if (geloescht.Count > 0) KatalogKaestchenLeeren();
        await KatalogLaden();
        if (fehler.Length > 0) Melden(fehler, WarnStufe.Warnung);
        else Melden(string.Format(VorlageGeloescht, string.Join(", ", geloescht)), WarnStufe.Erfolg);
    }

    private void BeiSpeichernUnter()
    {
        if (!KopierenErlaubt || _katalogZeile is null) return;
        _meldung = "";
        _kopieVorschlag = _katalogZeile.Bezeichner + KopieZusatz;
        _kopieOffen = true;
    }

    /// <summary>
    /// Die Dublettenprüfung VOR dem Einfügen — gegen den geladenen Katalog, also
    /// ohne zweite Abfrage und ohne Warten. Sie hält den Namensdialog offen und
    /// sagt, warum; der Kern prüft dieselbe Bedingung ein zweites Mal
    /// (<c>KopiereStamm</c> liefert dann <c>0</c>), damit kein UNIQUE-Fehler
    /// durchkommt.
    /// </summary>
    private string? KopieNamePruefen(string name)
        => _katalog.Any(z => string.Equals(z.Bezeichner, name, StringComparison.Ordinal))
            ? string.Format(TextNameVergeben, name)
            : null;

    private async Task KopieFertig(string? name)
    {
        _kopieOffen = false;
        if (string.IsNullOrWhiteSpace(name) || Kopieren is null || _katalogZeile is null) return;

        string quelle = _katalogZeile.Bezeichner;
        // KT-4: Wirft der Schreibweg, kommt die Ablehnung mit Grund zurück (Katalogladung.SchreibenAsync).
        string grund = "";
        bool ok = await Katalogladung.SchreibenAsync(() => Kopieren(quelle, name!), name, g => { grund = g; return false; });
        await KatalogLaden();
        Melden(ok ? string.Format(VorlageKopiert, quelle, name) : grund.Length > 0 ? grund : TextKopieFehler,
               ok ? WarnStufe.Erfolg : WarnStufe.Fehler);
    }


    // =================================================================================
    // Die Satz-Ueberlagerung (K5c, KA-E-23): Zusammenfassung, Bearbeiten, Abbrechen, OK
    // =================================================================================

    private string _ueberlagerungFehler = "";
    private WaermebedarfExternStand? _stand;
    private Energieeinheit? _einheitGewaehlt;

    /// <summary>Die Anzeigeeinheit der Jahresarbeit — die zuletzt in der Grafik gewählte, sonst die der Hülle.</summary>
    private Energieeinheit Anzeigeeinheit => _einheitGewaehlt ?? Einheit;

    /// <summary>Der gesperrte Katalogsatz öffnet nur lesend (Fußleiste „Schließen“ mit „Erst Schloss aufheben“).</summary>
    public bool SatzNurLesen => SatzArt == Satzmarke.Katalogsatz && _katalogZeile?.Geschuetzt == true;

    /// <summary>Der Grund in der Fußleiste der Überlagerung (Prüfhilfe).</summary>
    public string UeberlagerungFehler => _ueberlagerungFehler;

    /// <summary>Die Überlagerung ist aufgegangen: den Stand der Projektzeile festhalten.</summary>
    private void BeiSatzVergroessert()
    {
        _ueberlagerungFehler = "";
        _stand = _gewaehlt is null ? null : WaermebedarfExternStand.Merken(_gewaehlt);
    }

    /// <summary>
    /// OK der Überlagerung: Eine Kühlzeile wird mit der Regel des Kerns geprüft — „Split ohne EER“ hält die Überlagerung
    /// mit dem Grund offen; sonst gilt der Stand, und die Hülle bekommt ihn.
    /// </summary>
    private void BeiSatzUebernommen()
    {
        if (_gewaehlt is WaermebedarfExternZeile z && IstKuehlzeile(z) && z.Deckung?.Pruefgrund() is not null)
        {
            _ueberlagerungFehler = MeldungDeckungOhneEer;
            _zweispalten?.SatzOffenHalten();
            return;
        }
        _ueberlagerungFehler = "";
        _stand = null;
        if (_meldungStufe == WarnStufe.Fehler) _meldung = "";
        Geaendert?.Invoke();
    }

    /// <summary>Abbrechen, Kreuz und Esc der Überlagerung: der Stand beim Öffnen gilt wieder.</summary>
    private void BeiSatzVerworfen()
    {
        _ueberlagerungFehler = "";
        if (_stand is not null && _gewaehlt is not null)
        {
            _stand.Zuruecksetzen(_gewaehlt);
            Geaendert?.Invoke();
        }
        _stand = null;
    }

    /// <summary>Eine Eingabe in der Überlagerung: der Grund in der Fußleiste fällt.</summary>
    private void BeiFeldGeaendert() => _ueberlagerungFehler = "";

    /// <summary>
    /// Die Zeile „gewählter Satz“ (KA-E-23): nur das Wesentliche — Kanal und Art der Projektzeile, Jahresarbeit,
    /// Vollbenutzungsstunden und bei einer Kühlzeile die Deckung in einem Satz.
    /// </summary>
    internal IReadOnlyList<Satzangabe> Zusammenfassung()
    {
        var liste = new List<Satzangabe>();
        if (_gewaehlt is WaermebedarfExternZeile z)
        {
            if (Modus == WaermebedarfExternModus.Alle)
                liste.Add(new(Beschriftung(KanalBezeichnung), Kanaele.ElementAtOrDefault(Kanalindex ?? 0).Text ?? ""));
            if (IstKuehlzeile(z))
                liste.Add(new(Beschriftung(KaelteArtBezeichnung), KaelteArten.ElementAtOrDefault(KaelteArtindex ?? 0).Text ?? ""));
        }
        if (_kennzahlen is GanglinienKennzahlen k)
        {
            liste.Add(new(Beschriftung(LabelJahresarbeit), Jahresarbeitstext(k)));
            if (k.VollbenutzungsstundenH is double h)
                liste.Add(new(Beschriftung(LabelVollbenutzung), Satzangaben.Zahl(h, EinheitStunden)));
        }
        if (_gewaehlt is WaermebedarfExternZeile kz && IstKuehlzeile(kz))
            liste.Add(new(Resource.DECK_GRUPPE, kz.Deckung.Zusammenfassung()));
        return liste;
    }

    /// <summary>Eine Feldbeschriftung ohne Doppelpunkt am Ende („Jahresarbeit:“ → „Jahresarbeit“).</summary>
    private static string Beschriftung(string text) => (text ?? "").Trim().TrimEnd(':').TrimEnd();

    private string Jahresarbeitstext(GanglinienKennzahlen k)
        => Anzeigeeinheit.Formatiere(Anzeigeeinheit.AusMWh(k.JahresarbeitMwh)) + " " + Anzeigeeinheit.Text;

    /// <summary>Die Grafik merkt die gewählte Einheit — Zusammenfassung und Hülle folgen.</summary>
    private void BeiEinheitGewaehlt(Energieeinheit einheit)
    {
        _einheitGewaehlt = einheit;
        EinheitGewaehlt?.Invoke(einheit);
    }

    /// <summary>
    /// Die Knöpfe der Ganglinie in der Überlagerung: „Datei importieren…“ und „Speichern unter…“ wirken auf den Katalog
    /// und sind beim Projektsatz weich gesperrt („Katalogsatz wählen“).
    /// </summary>
    private RenderFragment? Ganglinienknoepfe => !ImportMoeglich && !KopierenMoeglich ? null : __builder =>
    {
        if (ImportMoeglich)
        {
            if (KatalogSperrgrund is string g1)
            {
                <button type="button" class="epos-knopf epos-knopf--import" aria-disabled="true" title="@g1"
                        @onclick="() => BeiSchlossAbgelehnt(g1)">@BtnImportierenText</button>
            }
            else
            {
                <button type="button" class="epos-knopf epos-knopf--import" disabled="@(_laeuft || SatzNurLesen)"
                        title="@FormatHinweisText" @onclick="BeiImportieren">@BtnImportierenText</button>
            }
        }
        if (KopierenMoeglich)
        {
            if (KatalogSperrgrund is string g2)
            {
                <button type="button" class="epos-knopf epos-knopf--speichern-unter" aria-disabled="true" title="@g2"
                        @onclick="() => BeiSchlossAbgelehnt(g2)">@BtnSpeichernUnterText</button>
            }
            else
            {
                <button type="button" class="epos-knopf epos-knopf--speichern-unter" disabled="@(!KopierenErlaubt)"
                        @onclick="BeiSpeichernUnter">@BtnSpeichernUnterText</button>
            }
        }
    };

    /// <summary>Die Grafik der gewählten Ganglinie in der Überlagerung (W9-E-3); ohne brauchbare Reihe der Platzhalter.</summary>
    private RenderFragment Ganglinienbild => __builder =>
    {
        if (_kennzahlen is not null)
        {
            <GanglinienGrafik Schluessel="@Grafikschluessel" Bezeichner="@GewaehlterName"
                              Kennzahlen="@_kennzahlen" Bildauftrag="@Grafikbild" BildauftragMass="@GrafikbildMass"
                              Einheit="@Anzeigeeinheit" EinheitGewaehlt="@BeiEinheitGewaehlt"
                              LabelJahresarbeit="@LabelJahresarbeit" LabelSpitze="@LabelSpitze"
                              LabelVollbenutzung="@LabelVollbenutzung"
                              LabelSortiert="@LabelSortiert" LabelEinheit="@LabelEinheit"
                              EinheitKw="@EinheitKw" EinheitStunden="@EinheitStunden"
                              Bildtext="@Bildtext" PlatzhalterBild="@PlatzhalterBild"
                              FarbeSetzen="@FarbeSetzen"
                              FarbeZuruecksetzen="@FarbeZuruecksetzen" />
        }
        else
        {
            <p class="epos-zweispalten-satzleer">@PlatzhalterBild</p>
        }
    };

    // --- Vergleichen… (KA-E-19) -------------------------------------------------------

    /// <summary>Wie viele Sätze „Vergleichen…" im Bereich des gewählten Satzes vergleichen würde.</summary>
    private int VergleichsZahl => SatzArt == Satzmarke.Projektsatz ? ProjektZiele().Count : KatalogZiele().Count;

    /// <summary>
    /// „Vergleichen…" — zwei oder mehr Sätze nebeneinander im Bereich des gewählten Satzes: beim Projektsatz die
    /// angekreuzten Zuordnungen mit Kanal, Art, Kennzahlen und Deckung (<c>Katalogliste.VergleichenWerte</c>), sonst die
    /// angekreuzten Katalogsätze mit den Spalten des Katalogs.
    /// </summary>
    private async Task BeiVergleichen()
    {
        if (_katalogliste is null) return;
        if (SatzArt != Satzmarke.Projektsatz)
        {
            List<Katalogfilterzeile> ziele = KatalogZiele();
            if (ziele.Count >= 2) _katalogliste.Vergleichen(ziele.Select(z => z.Schluessel).ToList());
            return;
        }
        var saetze = new List<(string Name, IReadOnlyList<(string Beschriftung, string Wert)> Werte)>();
        foreach (WaermebedarfExternZeile z in ProjektZiele())
        {
            GanglinienKennzahlen? k = null;
            if (Kennzahlen is not null)
            {
                (k, string grund) = await Katalogladung.SatzAsync(() => Kennzahlen(WahlZu(z)), z.Bezeichner);
                if (grund.Length > 0) { Melden(grund, WarnStufe.Warnung); return; }
            }
            saetze.Add((z.Bezeichner, Vergleichswerte(z, k)));
        }
        if (saetze.Count >= 2) _katalogliste.VergleichenWerte(saetze);
    }

    /// <summary>Die Werte einer Zuordnung im Vergleich.</summary>
    private IReadOnlyList<(string Beschriftung, string Wert)> Vergleichswerte(WaermebedarfExternZeile z, GanglinienKennzahlen? k)
    {
        var werte = new List<(string, string)>();
        string kanal = Kanaele.FirstOrDefault(e => string.Equals(e.Wert, z.Kanal, StringComparison.OrdinalIgnoreCase)).Text
                       ?? Kanaele.FirstOrDefault().Text ?? "";
        werte.Add((Beschriftung(KanalBezeichnung), kanal));
        bool kuehl = IstKuehlzeile(z);
        if (kuehl)
            werte.Add((Beschriftung(KaelteArtBezeichnung),
                       KaelteArten.FirstOrDefault(a => string.Equals(a.Wert, z.KaelteArt, StringComparison.OrdinalIgnoreCase)).Text
                       ?? KaelteArten.FirstOrDefault().Text ?? ""));
        werte.Add((Beschriftung(LabelJahresarbeit), k is null ? "" : Jahresarbeitstext(k)));
        werte.Add((Beschriftung(LabelSpitze), k is null ? "" : Satzangaben.Zahl(k.SpitzeKw, EinheitKw)));
        werte.Add((Beschriftung(LabelVollbenutzung),
                   k?.VollbenutzungsstundenH is double h ? Satzangaben.Zahl(h, EinheitStunden) : ""));
        werte.Add((Resource.DECK_GRUPPE, kuehl ? z.Deckung.Zusammenfassung() : ""));
        return werte;
    }

    // =================================================================================
    // Schluss
    // =================================================================================

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
        // Steht die Satz-Ueberlagerung offen, verdeckt sie den Banner: Warnung und Fehler stehen dann auch in ihrer
        // Fussleiste (Kopie, Import aus der Ueberlagerung).
        if (SatzUeberlagerungOffen && stufe is WarnStufe.Warnung or WarnStufe.Fehler) _ueberlagerungFehler = _meldung;
    }

    /// <summary>
    /// OK prüft vor dem Schließen jede Kühlzeile mit der Regel des Kerns (K5a, Konzept 3.4): eine dezentrale Zeile ohne
    /// rechnenden EER wird abgelehnt — Banner, die Zeile wird gewählt, der Dialog bleibt offen.
    /// </summary>
    private async Task BeiErgebnis(bool ok)
    {
        if (ok && UnzulaessigeDeckung() is WaermebedarfExternZeile falsch)
        {
            if (_gewaehlt != falsch && SichtbareZeilen.Contains(falsch)) await ProjektZeileWaehlen(falsch);
            Melden(MeldungDeckungOhneEer, WarnStufe.Fehler);
            return;
        }
        await Geschlossen.InvokeAsync(ok);
    }

    /// <summary>Abbrechen — von Esc (nach den Wächtern) und vom Schliesskreuz gleichermaßen gerufen.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        if (e.Key != "Escape") return Task.CompletedTask;

        // Jede Ebene prueft ihre eigenen Schalter, bevor sie Esc fuer sich
        // auswertet - so schliesst Esc immer nur die oberste (Muster W7.5).
        if (_loeschfrage || _kopieOffen || _zweispalten?.SatzUeberlagerungOffen == true
            || _import?.EtwasOffen == true) return Task.CompletedTask;

        return Wizard ? Task.CompletedTask : Abbrechen();
    }

    // =================================================================================
    // Schloss setzen / aufheben (AD-Q15) - derselbe Baustein wie in den Verwaltungen
    // =================================================================================

    /// <summary>
    /// „Schloss setzen…" / „Schloss aufheben…" an der Katalogliste
    /// (<c>Schlosswege.Aus(…SchlossSetzen)</c>). Ohne ihn steht der Knopf nicht da.
    /// Die Verwendung im Projekt sperrt nichts: Das Projekt führt eine eigene Kopie.
    /// </summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    private Katalogschloss? _katalogschloss;

    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe für Tests.)</summary>
    public bool Schlossfrage => _katalogschloss?.FrageOffen == true;

    /// <summary>Nach dem Schalten: Liste neu lesen, Status melden.</summary>
    private async Task BeiSchlossGeschaltet(string status)
    {
        await KatalogLaden();
        Melden(status ?? "", WarnStufe.Hinweis);
    }

    /// <summary>Warum nicht geschaltet wurde.</summary>
    private void BeiSchlossAbgelehnt(string grund) => Melden(grund ?? "", WarnStufe.Warnung);
}
