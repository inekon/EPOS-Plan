    {
        if (_katalogWahl.Anzahl > 0)
            return _katalogWahl.Gewaehlte
                .Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s))
                .OfType<Katalogfilterzeile>().ToList();
        return _katalogZeile is null ? new() : new() { _katalogZeile };
    }

