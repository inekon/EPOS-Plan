        FuellstandBezugLesen = () => (int)_eingabe.FuellstandBezug,
        FuellstandBezugSetzen = id =>
        {
            if (id is not int n || Fuellstandbezuege.All(e => e.Id != n)) return ZapfprofilKiRegeln.Gesperrt(Texte.LabelFuellstandBezug);
            FuellstandSetzen(n);
            return null;
        },
        FuellstandBezugEintraege = () => KiMaskenanmeldung.Eintraege(Fuellstandbezuege, e => e.Id, e => e.Text)
