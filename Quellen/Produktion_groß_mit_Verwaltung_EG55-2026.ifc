#25962=IFCPROPERTYENUMERATEDVALUE('EmbeddedSystemPositionType','Kennung f\X\FCr die Position von fl\X\E4chenintegrierten Systemen innerhalb des Geb\X\E4udeelementes Anhand der Eigenschaft wird festgelegt, ob ein fl\X\E4chenintegriertes System innerhalb des Geb\X\E4udebauteils installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein fl\X\E4chenintegriertes System vorgesehen ist. Wenn die Position des fl\X\E4chenintegrierten Systems noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
#25963=IFCPROPERTYENUMERATEDVALUE('Generator','Kennung f\X\FCr den Ersteller/Bearbeiter des Geb\X\E4udeelementes. Der Generator dient nur zur Information. Die Kennung darf nicht f\X\FCr die Identifizierung von Modellobjekten verwendet werden.',(IFCLABEL('mgt2D3D')),$);
#25964=IFCPROPERTYSINGLEVALUE('GUID','Bezeichner, der w\X\E4hrend der Lebenszeit des Modellobjektes erhalten bleibt. Der Bezeichner ist nicht eindeutig.',IFCLABEL('343effb2-71b3-4a69-9ebd-01796a018582'),$);
#25965=IFCPROPERTYSINGLEVALUE('ID','Kennung f\X\FCr das Modellobjekt. MUSS innerhalb des Projektes eindeutig sein.',IFCIDENTIFIER('-1'),$);
#25966=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('5e6a9f01-0147-9f73-a277-7441b56c6a94'),$);
