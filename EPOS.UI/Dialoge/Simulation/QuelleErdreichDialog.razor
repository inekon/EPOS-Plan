    /// <b>Angemeldet heißt nicht übertragen.</b> Ob ein Feldwert hinausgeht,
    /// entscheiden der Schalter „Feldwerte mitsenden" im Chat und die
    /// Einwilligungsstufe „Dialogdaten" (KI‑D‑Q2).
    /// </remarks>
    private QuelleErdreichKiSicht? _kiSicht;

    private KiMaskenanmeldung? _kiMaske;

    /// <summary>
    /// Die sieben Wege auf die Felder der Maske.
    /// </summary>
    /// <remarks>
    /// <b>Setzen heißt tippen:</b> Jeder Setzweg nimmt denselben Weg wie die Tastatur
    /// (<see cref="Setzen"/>, <c>SystemUmschalten</c>, <c>ZoneWaehlen</c>) — die
    /// Kennwertzeile, die Vorschau und die Auslegungsprüfung ziehen danach nach.
    /// </remarks>
    private QuelleErdreichKiSicht KiSicht() => new QuelleErdreichKiSicht
    {
        ErdsondeLesen = () => _sonde,
        ErdsondeSetzen = w => SystemUmschalten(w ? SONDE : KOLLEKTOR),
        VerlegetiefeLesen = () => _tiefe,
        VerlegetiefeSetzen = w => Setzen(() => _tiefe = w),
        FlaecheLesen = () => _flaeche,
        FlaecheSetzen = w => Setzen(() => _flaeche = w),
        LaengeSondeLesen = () => _laenge,
        LaengeSondeSetzen = w => Setzen(() => _laenge = w),
        AnzahlSondenLesen = () => _anzahl,
        AnzahlSondenSetzen = w => Setzen(() => _anzahl = w),
        SpreizungLesen = () => _spreizung,
        SpreizungSetzen = w => Setzen(() => _spreizung = w),
        BodentypLesen = () => Bodentyp,
        BodentypSetzen = KiBodentypSetzen,
        BodentypEintraege = Bodentypeintraege,
        KlimazoneLesen = () => _zone,
        KlimazoneSetzen = ZoneWaehlen,
        KlimazoneEintraege = Klimazoneneintraege
    };

    /// <summary>
    /// Die Bodentypen für den Assistenten (KI-F1b): Schlüssel ist der KATALOGSCHLÜSSEL,
    /// Text der lokalisierte Untergrundname der Normtabelle.
