    {
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Katalogprofil?.Art ?? Anlagenart.Photovoltaik);

        KatalogNeuLaden();
        GesamtNeu();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);

        // Auftrag #200: die GEWAEHLTE Zeile beim Hilfe-Assistenten anmelden. Sie wechselt
        // mit jedem Klick in der Projektliste - deshalb ein Delegat und keine Instanz;
        // die Bruecke liest bei jedem Mal neu.
        // KI-F1b: Der Energieträger ist ein WAHLFELD; seine Einträge stehen im
        // Trägerkatalog, den die Hülle hereinreicht.
        // Welle KI-F7: Angemeldet wird seither die SICHTKLASSE; sie reicht die Zeile
        // durch und traegt zusaetzlich die zwei Auslegungstemperaturen des Projekts.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.PHOTOVOLTAIK, KiSicht,
                                          KiHaken(),
                                          ("energietraeger", Traegereintraege));
    }

