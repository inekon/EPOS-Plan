@* Anklickbare Einstiegskarte: Titel, Beschreibung, Statuszeile.

   Vorbild: Views/Kosten/EinstiegsKarte.cs und die davon abstammende
   Views/GemeinsameBausteine/AktionsKarte.cs. Begruendung dort: Beide Einstiege
   fuehren in einen eigenen Dialog und tragen einen Zustand, der schon vor dem
   Klick interessiert - eine Karte zeigt den Bestand gleich mit und erspart das
   Oeffnen zum Nachsehen.

   Als <button>, nicht als <div>: So ist die Kachel mit der Tastatur
   erreichbar, meldet sich einer Sprachausgabe als Schaltflaeche und
   beantwortet Enter und Leertaste ohne eigenes Zutun.

   iU9-W16a.2 (Befund W16-B7): ZWEI neue Gaben fuer den Komponentenschritt des
   Assistenten. Zustand faerbt den Statuspunkt gruen oder grau statt ihn nur
   ein- und auszublenden; Aktiv nimmt die Kachel aus der Bedienung, ohne sie zu
   verstecken - der Ersatz fuer die vierzehn Zeilen Cursors.Default, mit denen
   AktionsKarte ihre Anzeigekacheln entschaerfte (Wizard_Komponenten :166-171).
   Ein <button disabled> ist dabei mehr als eine Optik: Er nimmt die Kachel auch
   aus der Tabreihenfolge und meldet sich einer Sprachausgabe als gesperrt. *@

<button type="button" class="epos-kachel" disabled="@(!Aktiv)" @onclick="Geklickt">
    @if (!string.IsNullOrEmpty(Bild))
    {
        <img class="epos-kachel-bild" src="@Bild" alt="" />
    }
    <span class="epos-kachel-titel">@Titel</span>
    @if (!string.IsNullOrEmpty(Beschreibung))
    {
        <span class="epos-kachel-beschreibung">@Beschreibung</span>
    }
    @if (PunktSichtbar)
    {
        <span class="epos-kachel-status">
            <span class="epos-kachel-statuspunkt @Punktklasse" aria-hidden="true"></span>@Status
        </span>
    }
</button>

@code {
    /// <summary>Ueberschrift der Kachel.</summary>
    [Parameter] public string Titel { get; set; } = "";

    /// <summary>Erlaeuterung, wohin der Klick fuehrt.</summary>
    [Parameter] public string Beschreibung { get; set; } = "";

    /// <summary>
    /// Der gepflegte Bestand in einem Satz - leer, solange es nichts zu melden
    /// gibt. Ohne <see cref="Zustand"/> erscheint der gruene Statuspunkt nur mit
    /// Text; mit <see cref="Zustand"/> steht der Punkt immer.
    /// </summary>
    [Parameter] public string Status { get; set; } = "";

    /// <summary>
    /// Der Statuspunkt als ZUSTAND statt als Vorhandensein eines Textes
    /// (iU9-W16a.2, Befund W16-B7): gruen „im Projekt", grau „nicht im Projekt",
    /// der Punkt in beiden Faellen sichtbar. Nicht gesetzt = das alte Verhalten
    /// (Punkt nur mit Text, immer gruen) - so bleiben die Kacheln der Kostenseite
    /// und der Projektliste unveraendert.
    /// </summary>
    [Parameter] public Kachelstand? Zustand { get; set; }

    /// <summary>
    /// Bedienbar? <c>false</c> zeigt die Kachel wie bisher, nimmt sie aber aus der
    /// Bedienung — der Ersatz fuer <c>Cursors.Default</c> auf der Karte UND jedem
    /// Kind (<c>Wizard_Komponenten.KachelZeichnen</c> :166-171). Gedacht fuer
    /// Kacheln, die einen Bestand ehrlich anzeigen, ihn aber nicht verwalten
    /// (Brauchwasser und Pufferspeicher im Komponentenschritt).
    /// </summary>
    [Parameter] public bool Aktiv { get; set; } = true;

    /// <summary>
    /// Adresse des Sinnbilds - eine Datei unter "_content/EPOS.UI/..." oder eine
    /// eingebettete data:-URL. Leer = keine Grafik.
    /// </summary>
    [Parameter] public string? Bild { get; set; }

    /// <summary>Die Kachel wurde angeklickt.</summary>
    [Parameter] public EventCallback Geklickt { get; set; }

    private bool PunktSichtbar => Zustand is not null || !string.IsNullOrEmpty(Status);

    private string? Punktklasse
        => Zustand == Kachelstand.Aus ? "epos-kachel-statuspunkt--aus" : null;
}
