    protected override void OnInitialized()
    {
        // S2.5: der Filterstand je Katalog, fuer die Sitzung, gemeinsam mit der
        // Verwaltung (Frage Q2).
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(
            Katalogprofil?.Art ?? Anlagenart.Heizkessel);

