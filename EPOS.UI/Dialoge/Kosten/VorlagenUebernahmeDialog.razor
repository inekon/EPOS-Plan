@* Uebernahme Stamm -> Projekt (iU9-W1.4).

   Vorbild: Views/Kosten/Form_VorlagenUebernahme.cs (253 Z.) und .Designer.cs
   (Etappe KD3, Konzept Kostendialoge Rev. 1.2, § 8). Uebernommen sind der
   Feldbestand der Feldkarte, das Sperrwerk der drei Klapplisten
   (Auswahl_Geaendert), das Nachziehen der Anlagenliste beim Projektwechsel
   (QuellProjekt_Geaendert) und die Klartext-Vorschau nach jeder Aenderung.

   DER DIALOG ZAEHLT UND SCHREIBT NICHT SELBST. Beides erledigt die Huelle
   EPOS.UI.Daten/Kosten/VorlagenUebernahmeHuelle.cs ueber KostenVorlagenUebernahmeCtrl —
   mit denselben Filterparametern wie der Vorlaeufer (Regel F4/F5). Die
   Komponente kennt nur fuenf Delegaten: VorlagenZu, PositionenZu, AnlagenZu,
   Vorschau, Uebernehmen.

   ANWENDERENTSCHEID 19.09.2026 — DIE QUELLE „AUS VORLAGE/VARIANTE" IST DIE
   KATALOGANSICHT DER ADMINISTRATION. Unter der gewaehlten Option steht derselbe
   Block wie in Administration > Kosten > Kostenverwaltung: Komponente (fest —
   Positionen einer anderen gehoeren nicht in diese Anlage), Kategorie,
   Variantenliste und darunter die Positionen der gewaehlten Variante als
   Vorschau. OK uebernimmt sie in die gewaehlte Anlage UND in die gewaehlte
   Kategorie; der Wirt schaltet danach auf diese Kategorie um. Eine schlichte
   Klappliste zeigte zwar dieselben Varianten, aber weder ihre Kategorie noch
   das, was in ihnen steht.

   FUEHRT DER KATALOG NICHTS, SAGT ER ES. Ohne Variante in BEIDEN Kategorien
   bleibt die Option gesperrt — jetzt mit einer Erklaerzeile darunter statt
   stillschweigend. Fuehrt nur die ANDERE Kategorie eine, springt die
   Kategorie-Vorwahl dorthin.

   ANWENDERENTSCHEID 10.09.2026 (Ae25) — OK UND ABBRECHEN. "OK = aus der Maske
   heraus und uebernehmen, Abbrechen = aus der Maske raus, nicht speichern."
   Bis dahin galt A-7 aus B5b: Der Primaerknopf hiess "Uebernehmen", schrieb
   sofort und LIESS DIE MASKE STEHEN, um die Meldung des Controllers dort zu
   zeigen, wo sie entstanden war. Der Anwender hat das am 10.09.2026 verworfen —
   eine Maske mit einem Knopf, der schreibt, und einem zweiten, der nur
   schliesst, sagt nicht, wie man sie ohne Wirkung wieder verlaesst.

   Geblieben ist die Entscheidungsgrundlage VOR dem Schreiben: Die Vorschauzeile
   zaehlt, was angelegt wuerde, und OK ist gesperrt, solange das nichts ist.

   DIE EINE AUSNAHME: ein FEHLSCHLAG haelt die Maske offen. Ein Lauf, der nicht
   geschrieben hat, muss seinen Grund zeigen koennen, und er muss sich
   korrigieren lassen; wegzuschliessen, was man noch braucht, waere kein
   Abbrechen, sondern ein Verlust (dieselbe Ueberlegung wie beim
   Hintergrundklick der Ueberlagerung). *@

@namespace EPOS.UI.Dialoge.Kosten

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ae25: Die Ueberschrift steht nur, wo sie nicht schon ueber der Maske
       steht. Als Bereich einer Ueberlagerung traegt DEREN Kopf den Titel; der
       Wirt setzt TitelText dann leer, und hier bleibt der Hilfeknopf. *@
    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="BeiAbbrechen" />
        }
    </div>

    <p class="epos-kontextzeile">@KontextText</p>

    @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben dem Feld.
       EINSPALTIG, weil der Block eine Reihenfolge traegt - Ziel, dann Quelle,
       dann die Quelle im Einzelnen; nebeneinander gestellt liest sie sich nicht
       mehr als Weg. *@
    <Formularraster Einspaltig="true">
        <KindInhalt>
            <Auswahlfeld Bezeichnung="@LabelZielProjekt"
                         Eintraege="@Zielprojekte"
                         Auswahl="@_zielProjekt"
                         Aktiv="@ZielWaehlbar"
                         AuswahlChanged="BeiZielProjekt" />

            <Optionsgruppe Bezeichnung="@LabelQuelle"
                           Eintraege="@_quellen"
                           Auswahl="@(_ausVorlage ? QUELLE_VORLAGE : QUELLE_PROJEKT)"
                           Gesperrt="@_gesperrteQuellen"
                           Beschreibungen="@_quellErklaerung"
                           AuswahlChanged="BeiQuelle" />

            @* ANWENDERENTSCHEID 19.09.2026 — DER KATALOGBLOCK DER ADMINISTRATION.
               Er steht nur unter der gewaehlten Option und in derselben Reihenfolge
               wie Administration > Kosten > Kostenverwaltung: Komponente, Kategorie,
               Variante, Positionen. *@
            @if (_ausVorlage)
            {
                @* Die Komponente steht fest: Positionen einer anderen gehoeren nicht
                   in diese Anlage. Ein gesperrtes Auswahlfeld sagte "hier koenntest
                   du waehlen, nur jetzt nicht" - hier gibt es nichts zu waehlen. *@
                <div class="epos-feld">
                    <span class="epos-feld-text">@LabelKomponente</span>
                    <span class="epos-feld-zeile">
                        <span class="epos-lesewert">@KomponenteText</span>
                    </span>
                </div>

                <Optionsgruppe Bezeichnung="@LabelKategorie"
                               Eintraege="@KATEGORIEN"
                               Auswahl="@(_invest ? KATEGORIE_INVEST : KATEGORIE_BETRIEB)"
                               AuswahlChanged="BeiKategorie" />

                <Auswahlfeld Bezeichnung="@LabelVariante"
                             Eintraege="@_vorlagen"
                             Auswahl="@_quellVorlage"
                             AuswahlChanged="BeiQuellVorlage" />

                @if (_positionen.Count == 0)
                {
                    <Herleitungszeile Text="@VorlageLeerText" />
                }
                else
                {
                    <Zeilenraster Bezeichnung="@LabelPositionen"
                                  Spalten="@Positionsspalten"
                                  Spaltenmass="@Positionsmass">
                        <KindInhalt>
                            @foreach (VorlagenPositionZeile z in _positionen)
                            {
                                <div class="epos-zr-zeile" role="row">
                                    <div class="epos-zr-zelle epos-zr-text" role="cell">@z.Bezeichnung</div>
                                    <div class="epos-zr-zelle epos-zr-text" role="cell">@z.Bemessung</div>
                                    <div class="epos-zr-zelle epos-zr-text" role="cell">@z.Satz</div>
                                    @if (_invest)
                                    {
                                        <div class="epos-zr-zelle epos-zr-text" role="cell">@z.Nutzungsdauer</div>
                                    }
                                    <div class="epos-zr-zelle epos-zr-text" role="cell">@z.Zustand</div>
                                </div>
                            }
                        </KindInhalt>
                    </Zeilenraster>
                }
            }

            <Auswahlfeld Bezeichnung="@LabelQuellProjekt"
                         Eintraege="@Quellprojekte"
                         Auswahl="@_quellProjekt"
                         Aktiv="@(!_ausVorlage)"
                         AuswahlChanged="BeiQuellProjekt" />

            <Auswahlfeld Bezeichnung="@LabelQuellAnlage"
                         Eintraege="@_quellAnlagen"
                         Auswahl="@_quellAnlage"
                         Aktiv="@(!_ausVorlage)"
                         AuswahlChanged="BeiQuellAnlage" />
        </KindInhalt>
    </Formularraster>

    <Herleitungszeile Text="@_vorschau" />

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@(_meldungIstFehler ? WarnStufe.Fehler : WarnStufe.Hinweis)"
                    Text="@_meldung" />
    }

    @* Die Fussleiste nach der Hausregel (Konzept Knopfleisten, Abschnitt 1 Satz 1):
       Fueller · Abbrechen · OK (primaer, zuletzt) - dieselbe SpeichernLeiste wie in
       jedem anderen OK-Dialog des Hauses. Ohne Aktionen und ohne MitSpeichern
       zeichnet sie genau die zwei Knoepfe, die diese Maske hat; der Fueller ist
       ihre Statusspanne. *@
    <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText"
                     OkErlaubt="@_uebernahmeMoeglich" Ergebnis="BeiErgebnis" />
</div>

@code {
    /// <summary>Id der Option „Aus Vorlage/Variante".</summary>
    public const int QUELLE_VORLAGE = 0;

    /// <summary>Id der Option „Aus Projekt/Anlage".</summary>
    public const int QUELLE_PROJEKT = 1;

    /// <summary>Id der Kategorie „Betriebskosten" (Reihenfolge wie im Katalogmodus).</summary>
    public const int KATEGORIE_BETRIEB = 0;

    /// <summary>Id der Kategorie „Investitionskosten".</summary>
    public const int KATEGORIE_INVEST = 1;

    /// <summary>Die beiden Kategorien — wortgleich zum Katalogmodus
    /// (<c>KostenKomponenteDialog.KATEGORIEN</c>).</summary>
    private (int Id, string Text)[] KATEGORIEN
        => new[] { (KATEGORIE_BETRIEB, KategorieBetriebText), (KATEGORIE_INVEST, KategorieInvestText) };

    /// <summary>Die waehlbaren Zielprojekte (Id, Anzeigetext).</summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Zielprojekte { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Vorgewaehltes Zielprojekt; <c>null</c> = der erste Eintrag.</summary>
    [Parameter] public int? ZielProjektVorwahl { get; set; }

    /// <summary>
    /// Darf das Ziel gewechselt werden? Im Projektmodus steht es fest
    /// (<c>cmbZielProjekt.Enabled = zielProjektId &lt;= 0</c>).
    /// </summary>
    [Parameter] public bool ZielWaehlbar { get; set; } = true;

    /// <summary>
    /// Die Varianten des Admin-Katalogs je KATEGORIE (Ä11): <c>true</c> fragt die
    /// Investitionsseite, <c>false</c> die Betriebsseite — dieselbe Liste, die
    /// Administration › Kosten › Kostenverwaltung zeigt
    /// (<c>KostenVorlagenCtrl.Vorlagen</c>, Standard zuerst).
    ///
    /// <para>Ohne Delegat fuehrt der Katalog nichts; dann bleibt die Option „Aus
    /// Vorlage/Variante" gesperrt — der Pruefstandsfall.</para>
    /// </summary>
    [Parameter] public Func<bool, IReadOnlyList<(int Id, string Text)>>? VorlagenZu { get; set; }

    /// <summary>
    /// Die Positionen der gewaehlten Variante als Vorschau. Die ganze Wahl geht
    /// hinein, nicht nur die Variantennummer: Das Einheitenzeichen haengt am Raster
    /// („€/kWp" gegen „€/kWp·a"), und die Kennzeichnung „vorhanden" / „wird
    /// angelegt" haengt am ZIEL.
    /// </summary>
    [Parameter] public Func<VorlagenUebernahmeWahl, IReadOnlyList<VorlagenPositionZeile>>? PositionenZu { get; set; }

    /// <summary>Vorgewaehlte Quellvorlage; <c>null</c> = der erste Eintrag.</summary>
    [Parameter] public int? QuellVorlageVorwahl { get; set; }

    /// <summary>Die Kategorie, aus der der Dialog geoeffnet wurde (Vorbelegung).</summary>
    [Parameter] public bool InvestVorwahl { get; set; } = true;

    /// <summary>Die waehlbaren Quellprojekte (Ä21: auch das eigene).</summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Quellprojekte { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Vorgewaehltes Quellprojekt; <c>null</c> = der erste Eintrag.</summary>
    [Parameter] public int? QuellProjektVorwahl { get; set; }

    /// <summary>
    /// Die Anlagen der Komponente im gewaehlten Quellprojekt, plus
    /// „(ohne Anlagenzuordnung)", wo lose Positionen liegen (Ä21). Die Huelle
    /// liest sie ueber <c>ProjektEnergietraegerCtrl.AnlagenMitTraeger</c>.
    /// </summary>
    [Parameter] public Func<int, IReadOnlyList<(int Id, string Text)>>? AnlagenZu { get; set; }

    /// <summary>Der Klartext der Vorschau und die Frage, ob sich uebernehmen laesst.</summary>
    [Parameter] public Func<VorlagenUebernahmeWahl, VorlagenUebernahmeVorschau>? Vorschau { get; set; }

    /// <summary>Der Schreibweg. Rueckgabe = die Meldungen des Controllers.</summary>
    [Parameter] public Func<VorlagenUebernahmeWahl, VorlagenUebernahmeAntwort>? Uebernehmen { get; set; }

    /// <summary>
    /// Der Dialog ist zu Ende. <c>Geschrieben</c> = die Uebernahme lief und hat
    /// geschrieben (Ae25: der Rueckgabewert von OK), sonst abgebrochen;
    /// <c>Invest</c> nennt die Kategorie, in die uebernommen wurde.
    /// </summary>
    [Parameter] public EventCallback<VorlagenUebernahmeSchluss> Geschlossen { get; set; }

    /// <summary>Fenstertitel (Designer: lblKopfTitel); leer = die Ueberschrift
    /// steht schon ueber der Maske (Ae25, Ueberlagerungskopf).</summary>
    [Parameter] public string TitelText { get; set; } = "Übernahme ins Projekt";

    /// <summary>Kontextzeile „‹Komponente› · ‹Kategorie›" (Designer: lblKontext).</summary>
    [Parameter] public string KontextText { get; set; } = "";

    /// <summary>Beschriftung der Zielliste (Designer: lblZiel).</summary>
    [Parameter] public string LabelZielProjekt { get; set; } = "Zielprojekt:";

    /// <summary>Titel der Quellgruppe. Der Vorlaeufer hatte keinen.</summary>
    [Parameter] public string LabelQuelle { get; set; } = "";

    /// <summary>Erste Option (rbQuelleVorlage).</summary>
    [Parameter] public string LabelQuelleVorlage { get; set; } = "Aus Vorlage/Variante:";

    /// <summary>Zweite Option (rbQuelleProjekt, Ä21).</summary>
    [Parameter] public string LabelQuelleProjekt { get; set; } = "Aus Projekt/Anlage:";

    /// <summary>Beschriftung der Komponentenanzeige (Katalogmodus: <c>KDLG_LBL_KOMPONENTE</c>).</summary>
    [Parameter] public string LabelKomponente { get; set; } = "Komponente:";

    /// <summary>Die Komponente der Anlage — reine Anzeige, nicht waehlbar.</summary>
    [Parameter] public string KomponenteText { get; set; } = "";

    /// <summary>Titel der Kategoriegruppe; leer wie im Katalogmodus.</summary>
    [Parameter] public string LabelKategorie { get; set; } = "";

    /// <summary>Erste Kategorie (<c>KDLG_KAT_INVEST</c>).</summary>
    [Parameter] public string KategorieInvestText { get; set; } = "Investitionskosten";

    /// <summary>Zweite Kategorie (<c>KDLG_KAT_BETRIEB</c>).</summary>
    [Parameter] public string KategorieBetriebText { get; set; } = "Betriebskosten";

    /// <summary>Beschriftung der Variantenliste (Katalogmodus: <c>KDLG_LBL_VARIANTE</c>).</summary>
    [Parameter] public string LabelVariante { get; set; } = "Variante:";

    /// <summary>Beschriftung der Positionsvorschau fuer die Sprachausgabe.</summary>
    [Parameter] public string LabelPositionen { get; set; } = "Positionen";

    /// <summary>Spaltenkoepfe der Vorschau — dieselben wie im Positionsraster.</summary>
    [Parameter] public string SpaltePosition { get; set; } = "Position";

    /// <summary>Spaltenkopf der Bemessung.</summary>
    [Parameter] public string SpalteBemessung { get; set; } = "Bemessung";

    /// <summary>Spaltenkopf des Satzes.</summary>
    [Parameter] public string SpalteSatz { get; set; } = "Satz";

    /// <summary>Spaltenkopf der Nutzungsdauer (nur Investitionsseite).</summary>
    [Parameter] public string SpalteNutzung { get; set; } = "Nutzungsdauer [a]";

    /// <summary>Spaltenkopf der Kennzeichnung „vorhanden" / „wird angelegt".</summary>
    [Parameter] public string SpalteZiel { get; set; } = "Ziel";

    /// <summary>Erklaerzeile statt leerer Tabelle, wenn die Variante nichts fuehrt.</summary>
    [Parameter] public string VorlageLeerText { get; set; }
        = "Diese Vorlage führt keine Positionen.";

    /// <summary>
    /// Erklaerzeile unter der GESPERRTEN Option, wenn der Katalog fuer diese
    /// Komponente in KEINER Kategorie eine Variante fuehrt. Ein stilles Sperren
    /// liesse den Anwender raten, warum die Quelle nicht offensteht.
    /// </summary>
    [Parameter] public string KatalogLeerText { get; set; }
        = "Der Katalog führt für diese Komponente keine Vorlage — "
        + "Administration › Kosten › Kostenverwaltung.";

    /// <summary>Beschriftung der Quellprojektliste (A-11).</summary>
    [Parameter] public string LabelQuellProjekt { get; set; } = "Quellprojekt:";

    /// <summary>Beschriftung der Quellanlagenliste (A-11).</summary>
    [Parameter] public string LabelQuellAnlage { get; set; } = "Quellanlage:";

    /// <summary>Ae25: Beschriftung des Primaerknopfes — uebernehmen UND schliessen.</summary>
    [Parameter] public string OkText { get; set; } = "OK";

    /// <summary>Ae25: Beschriftung des Knopfes, der ohne Wirkung schliesst.</summary>
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Schluessel des Hilfeknopfes — die vorhandene Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_VorlagenUebernahme.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private int? _zielProjekt;
    private int? _quellVorlage;
    private int? _quellProjekt;
    private int? _quellAnlage;
    private bool _ausVorlage = true;
    private bool _invest = true;
    private bool _uebernahmeMoeglich;

    private string _vorschau = "";
    private string _meldung = "";
    private bool _meldungIstFehler;

    private (int Id, string Text)[] _quellen = Array.Empty<(int, string)>();
    private int[]? _gesperrteQuellen;
    private Dictionary<int, string>? _quellErklaerung;
    private IReadOnlyList<(int Id, string Text)> _quellAnlagen = Array.Empty<(int, string)>();
    private IReadOnlyList<(int Id, string Text)> _vorlagen = Array.Empty<(int, string)>();
    private IReadOnlyList<VorlagenPositionZeile> _positionen = Array.Empty<VorlagenPositionZeile>();

    /// <summary>Steht die Quelle auf „Vorlage"? (Pruefhilfe fuer Tests.)</summary>
    public bool AusVorlage => _ausVorlage;

    /// <summary>Steht der Katalogblock auf der Investitionsseite? (Pruefhilfe.)</summary>
    public bool Invest => _invest;

    /// <summary>Die gewaehlte Variante (Pruefhilfe fuer Tests.)</summary>
    public int? QuellVorlage => _quellVorlage;

    /// <summary>Die gewaehlte Quellanlage (Pruefhilfe fuer Tests.)</summary>
    public int? QuellAnlage => _quellAnlage;

    /// <summary>Ist der Uebernehmen-Knopf bedienbar? (Pruefhilfe fuer Tests.)</summary>
    public bool UebernahmeMoeglich => _uebernahmeMoeglich;

    /// <summary>Die Spaltenkoepfe der Vorschau; die Nutzungsdauer nur auf der
    /// Investitionsseite (wie <c>KostenKomponenteStand.MitNutzungsdauer</c>).</summary>
    private IReadOnlyList<string> Positionsspalten => _invest
        ? new[] { SpaltePosition, SpalteBemessung, SpalteSatz, SpalteNutzung, SpalteZiel }
        : new[] { SpaltePosition, SpalteBemessung, SpalteSatz, SpalteZiel };

    /// <summary>Die Spuren der Vorschau — dieselbe Ordnung wie im Positionsraster.</summary>
    private string Positionsmass => _invest
        ? "minmax(120px, 2fr) minmax(110px, 1.4fr) minmax(80px, 1fr) 80px minmax(80px, 1fr)"
        : "minmax(120px, 2fr) minmax(110px, 1.4fr) minmax(80px, 1fr) minmax(80px, 1fr)";

    protected override void OnInitialized()
    {
        _quellen = new[]
        {
            (QUELLE_VORLAGE, LabelQuelleVorlage),
            (QUELLE_PROJEKT, LabelQuelleProjekt)
        };

        _zielProjekt = ZielProjektVorwahl ?? ErsteId(Zielprojekte);
        _quellProjekt = QuellProjektVorwahl ?? ErsteId(Quellprojekte);

        // ANWENDERENTSCHEID 19.09.2026: Die Kategorie startet dort, wo der Dialog
        // geoeffnet wurde — fuehrt der Katalog dort aber KEINE Variante und in der
        // anderen Kategorie eine, springt die Vorwahl dorthin. Sonst waere die
        // Quelle gesperrt, obwohl es eine Vorlage gibt.
        _invest = InvestVorwahl;
        _vorlagen = VorlagenFuer(_invest);
        if (_vorlagen.Count == 0)
        {
            IReadOnlyList<(int Id, string Text)> andere = VorlagenFuer(!_invest);
            if (andere.Count > 0) { _invest = !_invest; _vorlagen = andere; }
        }

        _quellVorlage = Enthalten(_vorlagen, QuellVorlageVorwahl)
            ? QuellVorlageVorwahl : ErsteId(_vorlagen);

        // rbQuelleVorlage.Enabled = _vorlagen.Count > 0;
        // if (_vorlagen.Count == 0) rbQuelleProjekt.Checked = true;
        // Neu (19.09.2026): Die Sperre bleibt, aber sie erklaert sich.
        if (_vorlagen.Count == 0)
        {
            _gesperrteQuellen = new[] { QUELLE_VORLAGE };
            _ausVorlage = false;
            _quellErklaerung = new Dictionary<int, string> { [QUELLE_VORLAGE] = KatalogLeerText };
        }

        AnlagenNachziehen();
        VorschauAktualisieren();
    }

    /// <summary>Die Varianten EINER Kategorie; ohne Delegat fuehrt der Katalog nichts.</summary>
    private IReadOnlyList<(int Id, string Text)> VorlagenFuer(bool invest)
        => VorlagenZu is null ? Array.Empty<(int, string)>() : VorlagenZu(invest);

    private static bool Enthalten(IReadOnlyList<(int Id, string Text)> liste, int? id)
    {
        if (!id.HasValue) return false;
        foreach ((int eintrag, string _) in liste)
        {
            if (eintrag == id.Value) return true;
        }
        return false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private static int? ErsteId(IReadOnlyList<(int Id, string Text)> liste)
        => liste.Count > 0 ? liste[0].Id : (int?)null;

    private void BeiZielProjekt(int? id)
    {
        _zielProjekt = id;
        VorschauAktualisieren();
    }

    /// <summary>Wie <c>Auswahl_Geaendert</c>: Die Sperren der drei Listen folgen
    /// der Quelle, danach wird die Vorschau neu gezogen.</summary>
    private void BeiQuelle(int? id)
    {
        _ausVorlage = id != QUELLE_PROJEKT;
        VorschauAktualisieren();
    }

    /// <summary>
    /// Ein Kategoriewechsel laedt die Variantenliste DIESER Kategorie neu und setzt
    /// die Vorwahl auf die erste Zeile — das ist die Standardvariante
    /// (<c>KostenVorlagenCtrl.Vorlagen</c> sortiert Standard zuerst).
    /// </summary>
    private void BeiKategorie(int? id)
    {
        _invest = id == KATEGORIE_INVEST;
        _vorlagen = VorlagenFuer(_invest);
        _quellVorlage = ErsteId(_vorlagen);
        VorschauAktualisieren();
    }

    private void BeiQuellVorlage(int? id)
    {
        _quellVorlage = id;
        VorschauAktualisieren();
    }

    /// <summary>Wie <c>QuellProjekt_Geaendert</c>: erst die Anlagenliste, dann die Vorschau.</summary>
    private void BeiQuellProjekt(int? id)
    {
        _quellProjekt = id;
        AnlagenNachziehen();
        VorschauAktualisieren();
    }

    private void BeiQuellAnlage(int? id)
    {
        _quellAnlage = id;
        VorschauAktualisieren();
    }

    /// <summary>Wie <c>QuellAnlagenFuellen</c>: Liste holen, ersten Eintrag waehlen.</summary>
    private void AnlagenNachziehen()
    {
        _quellAnlagen = AnlagenZu is null || !_quellProjekt.HasValue
            ? Array.Empty<(int, string)>()
            : AnlagenZu(_quellProjekt.Value);
        _quellAnlage = ErsteId(_quellAnlagen);
    }

    /// <summary>
    /// Wie <c>VorschauAktualisieren</c>: Klartext und Knopfzustand in einem Zug —
    /// dazu die Positionsvorschau, die aus derselben Wahl faellt (Variante,
    /// Kategorie, Ziel).
    /// </summary>
    private void VorschauAktualisieren()
    {
        VorlagenUebernahmeWahl wahl = Wahl();

        _positionen = PositionenZu is null || !_ausVorlage || !_quellVorlage.HasValue
            ? Array.Empty<VorlagenPositionZeile>()
            : PositionenZu(wahl);

        if (Vorschau is null)
        {
            _vorschau = "";
            _uebernahmeMoeglich = false;
            return;
        }

        VorlagenUebernahmeVorschau antwort = Vorschau(wahl);
        _vorschau = antwort.Text;
        _uebernahmeMoeglich = antwort.UebernahmeMoeglich;
    }

    private VorlagenUebernahmeWahl Wahl() => new(
        _ausVorlage,
        _zielProjekt ?? 0,
        _quellVorlage ?? 0,
        _quellProjekt ?? 0,
        _quellAnlage ?? 0,
        _invest);

    /// <summary>
    /// ANWENDERENTSCHEID 10.09.2026 (Ae25): OK uebernimmt die aktuelle Wahl UND
    /// verlaesst die Maske. Der Erfolg wird nicht mehr in der Maske gemeldet — die
    /// Kostenverwaltung laedt danach ohnehin neu und zeigt die angelegten Zeilen.
    ///
    /// <para>Ein FEHLSCHLAG haelt die Maske offen (Begruendung im Kopfkommentar):
    /// Er traegt einen Grund, den niemand mehr lesen koennte, und eine Wahl, die
    /// sich noch korrigieren laesst.</para>
    /// </summary>
    private Task BeiOk()
    {
        if (!_uebernahmeMoeglich || Uebernehmen is null) return Task.CompletedTask;

        VorlagenUebernahmeAntwort antwort = Uebernehmen(Wahl());
        if (antwort.Fehler)
        {
            _meldung = antwort.Meldung;
            _meldungIstFehler = true;
            // Nach einem Teillauf stimmt die Vorschau nicht mehr — sie zaehlt neu.
            VorschauAktualisieren();
            return Task.CompletedTask;
        }

        return Geschlossen.InvokeAsync(new VorlagenUebernahmeSchluss(true, _invest));
    }

    /// <summary>Ae25: Abbrechen verlaesst die Maske, ohne zu schreiben.</summary>
    private Task BeiAbbrechen()
        => Geschlossen.InvokeAsync(new VorlagenUebernahmeSchluss(false, _invest));

    /// <summary>Der eine Ausgang der <c>SpeichernLeiste</c>: true = OK, false = Abbrechen.</summary>
    private Task BeiErgebnis(bool ok) => ok ? BeiOk() : BeiAbbrechen();

    private Task BeiTaste(KeyboardEventArgs e) => e.Key switch
    {
        // Enter bleibt unbelegt: OK schreibt (A-7 aus B5b, von Ae25 nicht beruehrt).
        "Escape" => BeiAbbrechen(),
        _ => Task.CompletedTask
    };
}
