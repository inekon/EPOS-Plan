#21057=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('68b86fc9-295b-4580-98b8-4488b87ee831'),$);
