    /// <summary>
    /// ETAPPE E7c3 (E7c2‑Q8 b, Mockup U22) — die Wirkung JE WAHL der Energiesteuer als
    /// Anzeigezeile: Satz und Betrag im ersten Jahr aus der Vorschau des Kerns
    /// (<see cref="WirtschaftlichkeitErgebnis.EnergiesteuerVorschau"/>: der Lauf rechnet
    /// jede Wahl dieser Anlage mit demselben Steuerrechner). § 53 folgt der Aufteilung, die
    /// in der Überlagerung gerade gilt. Ohne Vorschau (kein Lauf, Stand vor E7c3) bleibt
    /// der Text der Vorschrift.
    /// </summary>
    private IReadOnlyDictionary<int, string> EsWirkungen()
    {
        var d = new Dictionary<int, string>();
        List<EnergiesteuerVorschauZeile> vorschau = VorschauDerAnlage();
        string aufteilung = UebAufteilungWert();
        foreach (Steuerwahl w in _esP)
        {
            bool keine = string.Equals(w.Wert, DbWerte.ENERGIESTEUER_WAHL_KEINE, StringComparison.Ordinal);
            bool nach53 = string.Equals(w.Wert, DbWerte.ENERGIESTEUER_WAHL_53, StringComparison.Ordinal);
            EnergiesteuerVorschauZeile? z = keine ? null : vorschau.FirstOrDefault(x =>
                string.Equals(x.Wahl, w.Wert, StringComparison.Ordinal) &&
                (!nach53 || string.Equals(x.Aufteilung, aufteilung, StringComparison.Ordinal)));
            d[w.Nummer] = z is not null ? VorschauText(z) : w.Wert switch
            {
                DbWerte.ENERGIESTEUER_WAHL_53 => _t.UebEs53,
                DbWerte.ENERGIESTEUER_WAHL_53A => _t.UebEs53a,
                DbWerte.ENERGIESTEUER_WAHL_54 => _t.UebEs54,
                _ => _t.UebEsKeine
            };
        }
        return d;
    }

    /// <summary>Die Wirkung je Aufteilung — der Betrag bei § 53 aus der Vorschau, bei
    /// „energetisch" dazu der Anteil des Stroms am Brennstoff; ohne Vorschau der Text.</summary>
    private IReadOnlyDictionary<int, string> AufteilungWirkungen()
    {
        var d = new Dictionary<int, string>();
        var k = BhwTexte.Kultur;
        List<EnergiesteuerVorschauZeile> vorschau = VorschauDerAnlage();
        EnergiesteuerVorschauZeile? voll = Vorschau53(vorschau, DbWerte.AUFTEILUNG_VOLLER_BRENNSTOFF);
        EnergiesteuerVorschauZeile? energetisch = Vorschau53(vorschau, DbWerte.AUFTEILUNG_ENERGETISCH);
        foreach (Steuerwahl w in _aufP)
        {
            bool istEnergetisch = string.Equals(w.Wert, DbWerte.AUFTEILUNG_ENERGETISCH, StringComparison.Ordinal);
            if (!istEnergetisch)
                d[w.Nummer] = voll?.SatzEur is not null
                    ? string.Format(k, _t.UebAufVorschauVoll, voll.BetragEur.ToString("N1", k))
                    : _t.UebAufVoll;
            else if (energetisch?.Menge is double menge && voll?.Menge is double mengeVoll && mengeVoll > 0)
                d[w.Nummer] = string.Format(k, _t.UebAufVorschauEnergetisch,
                                            (menge / mengeVoll).ToString("N3", k),
                                            energetisch.BetragEur.ToString("N1", k));
            else
                d[w.Nummer] = _t.UebAufEnergetisch;
        }
        return d;
    }

    /// <summary>Die Vorschauzeilen DIESER Anlage aus dem gebuchten Lauf (Erwartet);
    /// leer ohne Lauf oder bei einem Stand vor E7c3.</summary>
    private List<EnergiesteuerVorschauZeile> VorschauDerAnlage()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return new List<EnergiesteuerVorschauZeile>();
        WirtschaftlichkeitErgebnis? e = Ergebnisse().FirstOrDefault(x => x.IdProjekt == a.IdProjekt);
        if (e?.EnergiesteuerVorschau is null) return new List<EnergiesteuerVorschauZeile>();
        return e.EnergiesteuerVorschau.Where(z => z is not null &&
            string.Equals(z.Anlage, a.Bezeichner, StringComparison.OrdinalIgnoreCase)).ToList();
    }

    private static EnergiesteuerVorschauZeile? Vorschau53(List<EnergiesteuerVorschauZeile> vorschau, string aufteilung)
        => vorschau.FirstOrDefault(z =>
            string.Equals(z.Wahl, DbWerte.ENERGIESTEUER_WAHL_53, StringComparison.Ordinal) &&
            string.Equals(z.Aufteilung, aufteilung, StringComparison.Ordinal));

    /// <summary>Eine Vorschauzeile als Wirkung: Satz, Einheit und Betrag (bei § 54 mit dem
    /// Sockel, den diese Wahl auslöst); ohne Position der Betrag; dahinter der Grund.</summary>
    private string VorschauText(EnergiesteuerVorschauZeile z)
    {
        var k = BhwTexte.Kultur;
        string betrag = z.BetragEur.ToString("N1", k);
        string text;
        if (z.SatzEur is null)
            text = string.Format(k, _t.UebEsVorschauOhneSatz, betrag);
        else if (string.Equals(z.Wahl, DbWerte.ENERGIESTEUER_WAHL_54, StringComparison.Ordinal) && z.SockelEur > 0)
            text = string.Format(k, _t.UebEsVorschau54, z.SatzEur.Value.ToString("N2", k), z.SatzEinheit(),
                                 z.SockelEur.ToString("N0", k), betrag);
        else
            text = string.Format(k, _t.UebEsVorschau, z.SatzEur.Value.ToString("N2", k), z.SatzEinheit(), betrag);
        return string.IsNullOrEmpty(z.Grund) ? text : string.Format(k, _t.UebEsVorschauGrund, text, z.Grund);
    }

    /// <summary>Der Hinweis unter den Wahlen, wenn ein gebuchter Lauf da ist, aber noch
    /// keine Vorschau je Wahl trägt (Stand vor E7c3); sonst leer.</summary>
    private string EsVorschauHinweis()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return "";
        bool lauf = Ergebnisse().Any(x => x.IdProjekt == a.IdProjekt);
        return lauf && VorschauDerAnlage().Count == 0 ? _t.UebEsVorschauOhne : "";
    }

    /// <summary>
    /// „Wirkung Jahr 1" der Energiesteuer — die Positionen DIESER Anlage aus dem zuletzt
    /// gebuchten Lauf (Vorschrift, Menge × Satz = Betrag), wie der Lauf sie ausweist.
    /// Eine andere Wahl wirkt erst mit dem nächsten Lauf; gerechnet wird hier nichts.
    /// </summary>
    private IReadOnlyList<string> WirkungEnergiesteuer()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return Array.Empty<string>();
        var k = BhwTexte.Kultur;
        int jahr = Vorschlagsjahr();
        string kopf = string.Format(_t.UebWirkungJahr1, jahr.ToString(System.Globalization.CultureInfo.InvariantCulture));

        WirtschaftlichkeitErgebnis? e = Ergebnisse().FirstOrDefault(x => x.IdProjekt == a.IdProjekt);
        if (e is null) return new[] { kopf + ": " + _t.UebWirkungOhneLauf };

        var zeilen = new List<string>();
        foreach (EnergiesteuerNachweis z in e.EnergiesteuerNachweise ?? new List<EnergiesteuerNachweis>())
        {
            if (!string.Equals(z.Anlage, a.Bezeichner, StringComparison.OrdinalIgnoreCase)) continue;
            string wahl = z.Paragraf switch
            {
                EnergiesteuerNachweis.PARAGRAF_53 => DbWerte.ENERGIESTEUER_WAHL_53,
                EnergiesteuerNachweis.PARAGRAF_53A => DbWerte.ENERGIESTEUER_WAHL_53A,
                EnergiesteuerNachweis.PARAGRAF_54 => DbWerte.ENERGIESTEUER_WAHL_54,
                _ => ""
            };
            string vorschrift = wahl.Length > 0 ? BhkwWahlen.TextZu(_esP, wahl) : z.Paragraf;
            zeilen.Add(kopf + ": " + string.Format(_t.UebEsGebucht, vorschrift, z.Menge.ToString("N1", k),
                                                   z.SatzEur.ToString("N2", k), z.Einheit,
                                                   z.BetragEur.ToString("N1", k)));
        }
        if (zeilen.Count == 0) zeilen.Add(kopf + ": " + _t.UebEsOhne);
        return zeilen;
    }

