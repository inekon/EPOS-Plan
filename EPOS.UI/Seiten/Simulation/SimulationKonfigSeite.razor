    /// <summary>
    /// Der Parameterbereich EINER Erzeugerkarte; <c>null</c> = dieser Erzeuger hat
    /// keinen (dann steht der Bereich gar nicht da).
    /// </summary>
    /// <remarks>
    /// Welche Karte welches Feld zeigt, entscheidet ihr <c>DbWert</c> — dieselbe
    /// Zuordnung, die bis #216 <c>BlattZuTool</c> der Hülle für die vier
    /// Unterblätter des Reiters „Parameter" traf. Die Beschriftungen sind
    /// unverändert dieselben Ressourcen wie dort.
    /// </remarks>
    private RenderFragment? Erzeugerparameter(ErzeugerZeile zeile)
    {
        if (Parameter?.Laden is null) return null;

        // NUR AN DER ERSTEN KARTE IHRER ART. Ein Projekt kann mehrere Module
        // derselben Erzeugerart fuehren (zwei BHKW-Module = zwei Karten), die
        // fuenf Werte gelten aber PROJEKTWEIT - an jeder Karte stuenden sie so
        // oft da, wie es Module gibt, und jede Eingabe schriebe dieselbe Spalte.
        // Dieselbe Regel, nach der auch ▲▼ und × nur an der ersten Karte stehen.
        if (!ReferenceEquals(zeile, ErsteIhrerArt(zeile.DbWert))) return null;

        return zeile.DbWert switch
        {
            WindowsFormsApplication1.DbWerte.ERZEUGER_BHKW => ParameterBhkw,
            WindowsFormsApplication1.DbWerte.ERZEUGER_WAERMEPUMPE => ParameterWaermepumpe,
            WindowsFormsApplication1.DbWerte.ERZEUGER_HEIZKESSEL => ParameterHeizkessel,
            _ => null
        };
    }

    /// <summary>Die erste Zeile dieser Erzeugerart über alle Gruppen; <c>null</c> = keine.</summary>
    private ErzeugerZeile? ErsteIhrerArt(string dbWert)
    {
        foreach (KachelGruppe gruppe in _daten.Gruppen)
            foreach (ErzeugerZeile zeile in gruppe.Zeilen)
                if (string.Equals(zeile.DbWert, dbWert, StringComparison.Ordinal)) return zeile;

        return null;
    }

    private bool ParameterAktiv => !_daten.Gesperrt;

    private RenderFragment ParameterKopf => @<Gruppenkopf Titel="@Resource.SIMKONF_GRP_LAUFPARAMETER" />;

    private RenderFragment ParameterBhkw => @<div class="epos-simkonfig-felder">
        @ParameterKopf
        <Formularraster Einspaltig="true">
            <KindInhalt>
                <Optionsgruppe Bezeichnung="@Resource.SIMERG_GRP_BETRIEBSART"
                               Eintraege="@BETRIEBSARTEN" Auswahl="@_parameter.Betriebsart"
                               Aktiv="@ParameterAktiv" AuswahlChanged="BetriebsartGesetzt" />

                @* W6-E-7 (07.09.2026): DIE PROJEKTWEITE UNTERGRENZE - hier und nur
                   hier. Das Feld fuehrt Tab_Einstellungen.Leistungsgrenze, traegt
                   seine Einheit am Feld und sagt in der Herleitungszeile, was 0
                   bedeutet - denn seit W6-E-7 rechnet 0 als 0 und nicht mehr still
                   als 30 %. *@
                <Ganzzahlfeld Bezeichnung="@Resource.SIMERG_LBL_UNTERE_LEISTUNGSGRENZE" Einheit="%"
                              Wert="@_parameter.UntersteLeistungsgrenze" Min="0" Max="100"
                              Aktiv="@ParameterAktiv" WertChanged="LeistungsgrenzeGesetzt" />
                <Herleitungszeile Text="@Resource.SIMERG_HRL_UNTERE_LEISTUNGSGRENZE" />
            </KindInhalt>
        </Formularraster>
        <p class="epos-simkonfig-info">@Resource.SIMERG_INFO_BHKW</p>
    </div>;

