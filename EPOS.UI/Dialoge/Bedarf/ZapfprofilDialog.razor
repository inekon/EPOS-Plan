    }

    private void BezugsmengeSetzen(double? wert)
    {
        if (Gewaehlte is { } z) ZonenBezugsmengeSetzen(z, wert);
    }

    private void NiveauSetzen(int? id)
    {
        if (Gewaehlte is { } z) ZonenNiveauSetzen(z, id);
    }

    // Der Weg der Eingabefelder fuer EINE Zone - von Hand ueber die gewaehlte, vom
    // Assistenten ueber ihre Zeile (ZapfprofilZoneKiZeile). Der Name aendert die
    // Auslegung nicht; Nutzungsart, Bezugsmenge und Niveau machen ihren Punkt ueberholt.

    private void ZonennameSetzen(ZapfprofilZoneDaten z, string name)
