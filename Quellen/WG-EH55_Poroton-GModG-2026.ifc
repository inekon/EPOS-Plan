#30989=IFCPROPERTYSINGLEVALUE('Number','Kurzbeschreibung des Objektes. (50 Zeichen)',IFCLABEL(''),$);
#30990=IFCPROPERTYSINGLEVALUE('Orientation (\X\B0)','Orientierung betogen auf das Bauteil',IFCLABEL('51,7357334284567'),$);
