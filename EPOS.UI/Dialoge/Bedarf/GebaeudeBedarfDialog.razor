    [Parameter] public string SpalteAbweichung { get; set; } = "Abweichung";
    [Parameter] public string LabelSpitzeStunde { get; set; } = "Spitzenlast (Stunde):";
    [Parameter] public string LabelSpitzeTagesmittel { get; set; } = "Spitzenlast (Tagesmittel):";
    [Parameter] public string LabelSpitzeQuantil95 { get; set; } = "95-%-Wert der Stundenlast:";
    [Parameter] public string LabelKuehlbedarf { get; set; } = "Kühlbedarf:";
    [Parameter] public string LabelKuehlstunden { get; set; } = "Stunden mit Kühlbedarf:";
    [Parameter] public string LabelMittlereRaumtemperatur { get; set; } = "mittlere Raumtemperatur (Nutzungszeit):";
    [Parameter] public string LabelUeberhitzung { get; set; } = "Überhitzungsstunden:";
    [Parameter] public string LabelSommerlueftung { get; set; } = "Stunden mit Sommerlüftung:";

    /// <summary>Zeile der Stunden mit Nachtauskühlung (<c>KOND_LBL_STUNDEN_NACHTAUSKUEHLUNG</c>, Stufe KP2 U1).</summary>
    [Parameter] public string LabelNachtauskuehlung { get; set; } = "Stunden mit Nachtauskühlung:";

    /// <summary>Trägt eine Zone Stunden mit Nachtauskühlung? Dann steht die Spalte (nur mit Wert).</summary>
    private bool ZonenMitNachtauskuehlung => Daten.Zonen.Any(z => z.NachtauskuehlstundenH.HasValue);

    /// <summary>Rechnet eine Zone gekühlt (KU3-3)? Dann stehen Kältebedarf, Kältespitze und Kühlstunden je Zone.</summary>
    private bool ZonenMitKaelte => Daten.Zonen.Any(z => z.KaeltebedarfMwh.HasValue);

    /// <summary>
    /// Die Zeile zum gleichzeitigen Heizen und Kühlen der Zonen (KU3-3, F-K15, K6) — ausgewiesen, nicht
    /// saldiert; <c>null</c> ohne solche Stunden.
    /// </summary>
    private string? Gleichzeitigzeile
        => Daten.StundenHeizenUndKuehlenH is int h && h > 0 && Daten.GleichzeitigHeizenKwh is double heiz
           && Daten.GleichzeitigKuehlenKwh is double kuehl
            ? string.Format(CultureInfo.CurrentCulture, ZonenTexte.HerleitungGleichzeitig,
                            h, heiz.ToString("N0", CultureInfo.CurrentCulture), kuehl.ToString("N0", CultureInfo.CurrentCulture))
            : null;

    /// <summary>
    /// Rechnet mindestens eine Zone gekoppelt (AK1z, E63)? Nur dann stehen Vorlauf, Rücklauf und die
    /// begrenzten Stunden je Zone in der Tabelle — eine Zone ohne Heizkreis zeigt dort „—".
    /// </summary>
    private bool ZonenMitHeizkreis => Daten.Zonen.Any(z => z.IstGekoppelt);
    [Parameter] public string EinheitStundenZahl { get; set; } = "h";

    // --- Texte der Stufe KU1 (Abschnitt „Kältebedarf", Kühlkonzept 8.4) -----------

    /// <summary><c>GEBB_GRP_KAELTE</c></summary>
    [Parameter] public string GruppeKaelte { get; set; } = "Kältebedarf";

    /// <summary><c>GEBB_LBL_KAELTELAST_MAX</c></summary>
    [Parameter] public string LabelKaeltelastMax { get; set; } = "max. Kältelast";

    /// <summary><c>GEBB_LBL_HEIZEN_UND_KUEHLEN</c></summary>
    [Parameter] public string LabelHeizenUndKuehlen { get; set; } = "Stunden mit Heizen und Kühlen:";

    /// <summary><c>GEBB_BILD_KAELTELAST</c></summary>
    [Parameter] public string BildtextKaelte { get; set; } = "Kältelast Jahresganglinie";

    /// <summary><c>GEBB_SP_HEIZUNG</c> — Kopf der Wärmespalte der Monatsübersicht.</summary>
    [Parameter] public string SpalteHeizung { get; set; } = "Heizung";

    /// <summary><c>GEBB_SP_KUEHLUNG</c> — Kopf der Kühlspalte der Monatsübersicht.</summary>
    [Parameter] public string SpalteKuehlung { get; set; } = "Kühlung";
    [Parameter] public string PlatzhalterBild { get; set; } = "Kein Diagramm vorhanden";
    [Parameter] public string OkText { get; set; } = "OK";

    /// <summary>Die zwölf Monatsbeschriftungen der Tabelle.</summary>
    [Parameter]
    public IReadOnlyList<string> Monatsnamen { get; set; } = new[]
    {
        "Januar:", "Februar:", "März:", "April:", "Mai:", "Juni:",
        "Juli:", "August:", "September:", "Oktober:", "November:", "Dezember:"
    };

    /// <summary>Was statt eines fehlenden Wertes steht.</summary>
    [Parameter] public string LeerText { get; set; } = "—";

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_Gebaeude.btn_Help";

    // --- Stand -----------------------------------------------------------------

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private bool _sortiert;
    private Energieeinheit _einheit = Energieeinheit.MWh;

    /// <summary>Steht der Schalter „sortiert"? Prüfhilfe für die Tests.</summary>
    public bool Sortiert => _sortiert;

    /// <summary>Die gewählte Anzeigeeinheit — Prüfhilfe für die Tests.</summary>
    public Energieeinheit Anzeigeeinheit => _einheit;

    protected override void OnInitialized()
    {
        _einheit = Einheit ?? Energieeinheit.Vorgabe;

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE_BEDARF,
                                          () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent liest den Bedarf und stellt die Anzeige (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GebaeudeBedarfKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die drei Kennzahlen aus dem eingefrorenen Satz und
    /// die zwei Bedienelemente der Maske.
    /// </summary>
    private GebaeudeBedarfKiSicht KiSicht()
    {
        return _kiSicht ??= new GebaeudeBedarfKiSicht
        {
            EinheitLesen = () => EinheitIndex,
            EinheitSetzen = EinheitWaehlen,
            EinheitEintraege = () => KiMaskenanmeldung.Eintraege(
                Einheitenwahl, e => e.Id, e => e.Text),

            SortiertLesen = () => _sortiert,
            SortiertSetzen = w => SortiertGesetzt(w),

            DiagrammLesen = () => Diagrammwahl.Count > 0 ? _bildzone : null,
            DiagrammSetzen = DiagrammWaehlen,
            DiagrammEintraege = () => KiMaskenanmeldung.Eintraege(
                Diagrammwahl, e => e.Id, e => e.Text),

            SatzLesen = () => Daten
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Nur Auffrischen.</b> Diese Maske zeigt ein gerechnetes Ergebnis und schreibt
    /// nichts; einen Schreibschutz und einen Speicherweg gibt es nicht.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    // =================================================================================
    // Einheit
    // =================================================================================

    private IReadOnlyList<(int Id, string Text)> Einheitenwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                liste.Add((i, Energieeinheit.Alle[i].Text));
            return liste;
        }
    }

    private int EinheitIndex
    {
        get
        {
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                if (ReferenceEquals(Energieeinheit.Alle[i], _einheit)) return i;
            return 0;
        }
    }

    private void EinheitWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n >= Energieeinheit.Alle.Count) return;

        Energieeinheit neu = Energieeinheit.Alle[n];
        if (ReferenceEquals(neu, _einheit)) return;

        _einheit = neu;
        EinheitGewaehlt?.Invoke(neu);
    }

    // =================================================================================
    // Zahlen
    // =================================================================================

    /// <summary>Die Jahressumme in der gewählten Einheit — sie liegt in MWh vor.</summary>
    private string Heizwaerme => _einheit.Formatiere(_einheit.AusMWh(Daten.HeizwaermeMwh));

    private string Monatswert(int m)
        => (Daten.MonatswerteMwh.Count > m)
            ? _einheit.Formatiere(_einheit.AusMWh(Daten.MonatswerteMwh[m]))
            : LeerText;

    /// <summary>
    /// Eine LEISTUNG bzw. eine Stundenzahl — sie folgt der Einheitenwahl NICHT, aber
    /// der Anzeigekultur (zwei Nachkommastellen wie im Bestand).
    /// </summary>
    private string Zahl(double wert)
        => wert.ToString("F2", System.Globalization.CultureInfo.CurrentCulture);

    private string Vollbenutzung
        => Daten.VollbenutzungsstundenH is null ? LeerText
                                                : Zahl(Daten.VollbenutzungsstundenH.Value);

    /// <summary>Eine nullbare Leistung, Temperatur oder Stundenzahl mit zwei Nachkommastellen; „—" ohne Wert.</summary>
    private string Zahl(double? wert) => wert is double w ? Zahl(w) : LeerText;

    /// <summary>Eine Temperatur mit einer Nachkommastelle wie die Kachel „Vorlauf / Rücklauf"; „—" ohne Wert.</summary>
    private string Temperatur(double? wert)
        => wert is double w ? w.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) : LeerText;

    /// <summary>Eine gerechnete Stundenzahl auf ganze Stunden wie die Kachel der begrenzten Übergabe; „—" ohne Wert.</summary>
    private string Stunden(double? wert)
        => wert is double w ? w.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) : LeerText;

    /// <summary>Eine Stundenzahl ohne Nachkommastellen; „—" ohne Wert.</summary>
    private string Ganzzahl(int? wert)
        => wert is int w ? w.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) : LeerText;

    /// <summary>Eine Energiemenge in MWh, angezeigt in der gewählten Einheit; „—" ohne Wert.</summary>
    private string Energie(double? mwh)
        => mwh is double w ? _einheit.Formatiere(_einheit.AusMWh(w)) : LeerText;

    /// <summary>Zeilenkopf des Vergleichs: die Beschriftung ohne Doppelpunkt, dahinter die Einheit.</summary>
    private static string Kennzahltext(string beschriftung, string einheit)
        => (beschriftung ?? "").TrimEnd(' ', ':') + " [" + einheit + "]";

    /// <summary>Der Satz des Tagesbilanz-Wegs im Vergleich alt/neu.</summary>
    private GebaeudeBedarfDaten Tagesbilanzsatz => Daten.IstVdi6007 ? Daten.Vergleich ?? Daten : Daten;

    /// <summary>Der Satz des VDI-Wegs im Vergleich alt/neu.</summary>
    private GebaeudeBedarfDaten Vdisatz => Daten.IstVdi6007 ? Daten : Daten.Vergleich ?? Daten;

    /// <summary>
    /// Die Abweichung VDI 6007 gegen Tagesbilanz in Prozent, mit Vorzeichen; „—" ohne Wert
    /// oder wenn die Tagesbilanz null ist (kein Teilen durch null).
    /// </summary>
    private string Abweichung(double? tagesbilanz, double? vdi)
    {
        if (tagesbilanz is not double a || vdi is not double b || a == 0.0) return LeerText;
        double prozent = (b - a) / a * 100.0;
        return prozent.ToString("+0.0;-0.0;0.0", System.Globalization.CultureInfo.CurrentCulture) + " %";
    }

    private string Monatsname(int m)
        => (Monatsnamen is not null && Monatsnamen.Count > m) ? Monatsnamen[m] : "";

    // =================================================================================
    // Bild
    // =================================================================================

    /// <summary>
    /// Die gerechneten Zeichenmodelle, nach Schalterstellung getrennt.
    ///
    /// <para><b>Der Zwischenspeicher ist hier mehr als eine Ersparnis:</b> Der
    /// Baustein <c>DiagrammSvg</c> baut seinen Knotenbaum nur neu, wenn die REFERENZ
    /// des Modells wechselt. Ein Modell, das je Zeichenlauf neu entstünde, verwürfe
    /// mit dem Baum auch Zoom, Zeigerstelle und abgewählte Reihen.</para>
    /// </summary>
    private readonly Dictionary<bool, Zeichenmodell?> _modelle
        = new Dictionary<bool, Zeichenmodell?>();

    private Zeichenmodell? Modell
    {
        get
        {
            if (_bildzone > 0) return Zonenmodell;
            if (Bildauftrag is null) return null;
            if (_modelle.TryGetValue(_sortiert, out Zeichenmodell? vorhanden)) return vorhanden;

            Zeichenmodell? neu = Bildauftrag(_sortiert);
            _modelle[_sortiert] = neu;
            return neu;
        }
    }

    // ---- Die Diagrammwahl je Zone (Stufe G6b, Mehrzonenkonzept 2.8) ----------------

    /// <summary>0 = das ganze Gebäude, k ≥ 1 = die Zone auf Platz k − 1.</summary>
    private int _bildzone;

    /// <summary>Die gewählte Stelle der Diagrammwahl — Prüfhilfe für die Tests.</summary>
    public int Bildzone => _bildzone;

    /// <summary>
    /// Die Einträge der Diagrammwahl: das ganze Gebäude und jede Zone; leer bei höchstens einer
    /// Zone oder ohne Bildauftrag der Zonen.
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Diagrammwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            if (Daten.Zonen.Count < 2 || (BildauftragZone is null && BildauftragRaumtemperaturZone is null)) return liste;
            liste.Add((0, ZonenTexte.EintragGebaeude));
            for (int i = 0; i < Daten.Zonen.Count; i++) liste.Add((i + 1, Daten.Zonen[i].Name));
            return liste;
        }
    }

    /// <summary>Der Zusatz der Bildkennung — die Zone, damit jedes Bild seinen Ausschnitt führt.</summary>
    private string Zonenzusatz => _bildzone > 0 ? "-zone" + _bildzone.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";

    /// <summary>Die gewählte Zone; <c>null</c> für das ganze Gebäude.</summary>
    private GebaeudeBedarfZoneDaten? Bildzonensatz
        => _bildzone > 0 && _bildzone <= Daten.Zonen.Count ? Daten.Zonen[_bildzone - 1] : null;

    /// <summary>Der Platzhalter des Wärmelastbilds: bei einer unbeheizten Zone ihr Grund.</summary>
    private string PlatzhalterLast
        => Bildzonensatz is { IstBeheizt: false } z
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ZonenTexte.BildUnbeheizt, z.Name)
            : PlatzhalterBild;

    private void DiagrammWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n > Daten.Zonen.Count || Diagrammwahl.Count == 0) return;
        _bildzone = n;
    }

    /// <summary>Die Wärmelastbilder der Zonen, nach Zone und Schalterstellung zwischengespeichert.</summary>
    private readonly Dictionary<(int, bool), Zeichenmodell?> _zonenmodelle = new();

    private Zeichenmodell? Zonenmodell
    {
        get
        {
            if (BildauftragZone is null) return null;
            var schluessel = (_bildzone, _sortiert);
            if (_zonenmodelle.TryGetValue(schluessel, out Zeichenmodell? vorhanden)) return vorhanden;
            Zeichenmodell? neu = BildauftragZone(_bildzone - 1, _sortiert);
            _zonenmodelle[schluessel] = neu;
            return neu;
        }
    }

    /// <summary>Die Raumtemperaturbilder der Zonen, je Zone einmal gerechnet.</summary>
    private readonly Dictionary<int, Zeichenmodell?> _zonenraummodelle = new();

    /// <summary>„35,3 / 32,1 °C" — die beiden Mittel des Heizkreises; ohne Heizstunde der Leertext.</summary>
    private string VorlaufRuecklaufWert
        => Daten.VorlaufMittelC is double v && Daten.RuecklaufMittelC is double r
            ? v.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " / "
              + r.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " °C"
            : LeerText;

    /// <summary>„211 h" — die Stunden mit begrenzter Übergabe, auf ganze Stunden.</summary>
    private string BegrenztWert
        => Daten.UebergabeBegrenztStundenH is double h
            ? h.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) + " " + EinheitStundenZahl
            : LeerText;

    /// <summary>Das Bild „Vorlauf und Rücklauf" — einmal gerechnet, damit der Zoom stehen bleibt.</summary>
    private Zeichenmodell? _vorlaufmodell;
    private bool _vorlaufmodellGerechnet;

    private Zeichenmodell? Vorlaufmodell
    {
        get
        {
            if (BildauftragVorlauf is null) return null;
            if (!_vorlaufmodellGerechnet)
            {
                _vorlaufmodell = BildauftragVorlauf();
                _vorlaufmodellGerechnet = true;
            }
            return _vorlaufmodell;
        }
    }

    /// <summary>„18,0 / 18,8 °C" — die beiden Mittel des Kältekreises (E37); ohne Kühlstunde der Leertext.</summary>
    private string KuehlvorlaufWert
        => Daten.KuehlVorlaufMittelC is double v && Daten.KuehlRuecklaufMittelC is double r
            ? v.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " / "
              + r.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " °C"
            : LeerText;

    /// <summary>„29 h" — die Stunden mit begrenzter Kühlübergabe, auf ganze Stunden.</summary>
    private string KuehlBegrenztWert
        => Daten.KuehlUebergabeBegrenztStundenH is double h
            ? h.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) + " " + EinheitStundenZahl
            : LeerText;

    /// <summary>Das Bild „Kühlvorlauf und Kühlrücklauf" — einmal gerechnet, damit der Zoom stehen bleibt.</summary>
    private Zeichenmodell? _kuehlvorlaufmodell;
    private bool _kuehlvorlaufmodellGerechnet;

    private Zeichenmodell? Kuehlvorlaufmodell
    {
        get
        {
            if (BildauftragKuehlvorlauf is null) return null;
            if (!_kuehlvorlaufmodellGerechnet)
            {
                _kuehlvorlaufmodell = BildauftragKuehlvorlauf();
                _kuehlvorlaufmodellGerechnet = true;
            }
            return _kuehlvorlaufmodell;
        }
    }

    /// <summary>Das Bild „Raumtemperatur" — einmal gerechnet, damit der Zoom stehen bleibt.</summary>
    private Zeichenmodell? _raummodell;
    private bool _raummodellGerechnet;

    private Zeichenmodell? Raummodell
    {
        get
        {
            if (_bildzone > 0)
            {
                if (BildauftragRaumtemperaturZone is null) return null;
                if (_zonenraummodelle.TryGetValue(_bildzone, out Zeichenmodell? zm)) return zm;
                Zeichenmodell? neuZ = BildauftragRaumtemperaturZone(_bildzone - 1);
                _zonenraummodelle[_bildzone] = neuZ;
                return neuZ;
            }
            if (BildauftragRaumtemperatur is null) return null;
            if (!_raummodellGerechnet)
            {
                _raummodell = BildauftragRaumtemperatur();
                _raummodellGerechnet = true;
            }
            return _raummodell;
        }
    }

    /// <summary>
    /// Das Bild der Kältelast (Stufe KU1) — nach Schalterstellung getrennt zwischengespeichert,
    /// aus demselben Grund wie <see cref="Modell"/>.
    /// </summary>
    private readonly Dictionary<bool, Zeichenmodell?> _kaeltemodelle
        = new Dictionary<bool, Zeichenmodell?>();

    private Zeichenmodell? Kaeltemodell
    {
        get
        {
            if (BildauftragKaelte is null) return null;
            if (_kaeltemodelle.TryGetValue(_sortiert, out Zeichenmodell? vorhanden)) return vorhanden;

            Zeichenmodell? neu = BildauftragKaelte(_sortiert);
            _kaeltemodelle[_sortiert] = neu;
            return neu;
        }
    }

    /// <summary>Trägt die Monatsübersicht die Spalte „Kühlung"? Nur mit Abschnitt und zwölf Werten.</summary>
    private bool KuehlspalteDa => Daten.KaelteAbschnitt && Daten.KuehlMonatswerteMwh.Count >= 12;

    private string Kuehlmonatswert(int m)
        => (Daten.KuehlMonatswerteMwh.Count > m)
            ? _einheit.Formatiere(_einheit.AusMWh(Daten.KuehlMonatswerteMwh[m]))
            : LeerText;

    /// <summary>
    /// Ganglinie und Dauerlinie sind zwei Bilder; der Schalter tauscht das Modell,
    /// und mit ihm beginnt der Zoom des Bildes von vorn. Er gilt für BEIDE Bilder, das der
    /// Wärmelast und das der Kältelast.
    /// </summary>
    private void SortiertGesetzt(bool wert) => _sortiert = wert;

    // =================================================================================

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Schließen — von Esc, Enter und dem Schliesskreuz gleichermaßen gerufen. Der
    /// Dialog zeigt nur an und trägt einen einzigen Knopf, deshalb immer <c>true</c>:
    /// Das Kreuz kopiert Esc, es erfindet keine neue Semantik.
    /// </summary>
    private Task Schliessen() => Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Esc UND Enter schließen. Der Dialog zeigt nur an und trägt einen einzigen Knopf —
    /// hier kann Enter nichts versehentlich schreiben (Regel aus <c>EPOS.UI/CLAUDE.md</c>).
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
        => (e.Key == "Escape" || e.Key == "Enter") ? Schliessen() : Task.CompletedTask;
}
