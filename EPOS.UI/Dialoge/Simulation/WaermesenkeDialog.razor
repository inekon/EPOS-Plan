@* Die WAERMESENKEN einer Erzeugeranlage (iU9-W10a.7, Konzept 5.1/5.3, Paket S1).

   VORBILD. Views/Simulation/Form_Waermesenke (2 050 Z., OHNE Designer und ohne
   .resx, 620 x 618, 35 Steuerelemente, fuenf MessageBox, 63
   Ressourcenschluessel) - die zweitgroesste Maske der Welle.

   VIER GRUPPEN wie im Vorlaeufer: die SENKENLISTE (Rang fuer Rang, jede kWh geht
   genau einmal in eine Direktsenke oder in einen Puffer), die SENKENZEILE
   (Ziel, Speicher, Bedarfsart), der PARALLELVERBUND und das LADEVERHALTEN.

   DER DIALOG SPEICHERT SELBST (btnOk_Click:1890) - Senkenliste und
   Verbundmitglieder in einem Zug; der Aufrufer erfaehrt nur, ob es geklappt hat.

   ABWEICHUNG A-9 (Befund W10-B24): DIE ERSATZWERTE -1/-2/-3 SIND WEG. Der
   Vorlaeufer kodierte Eingabefehler in DATENfeldern des Modells (Ladegrenze -1 =
   unlesbar, -2 = ausserhalb; bei der Einspeisehoehe begann dieselbe Reihe erst
   bei -2, weil -1 schon "nicht gesetzt" hiess). Hier ist "nicht gesetzt" ein
   null, und der Eingabefehler bleibt im Formularzustand - gemeldet wird er beim
   OK, mit demselben Wortlaut und derselben Nennung des Rangs.

   WOERTLICH TROTZ BEFUND:
     W10-B25 - der Parallelverbund haengt konstruktiv an RANG 1
       (Z_AnlagePufferVerbund fuehrt keine ID_Senke). Dokumentierter Zustand.
     W10-B26 - das Speicher-Dropdown zeigt ALLE Projektpuffer (Paket S2), die
       Verbundliste filtert dagegen nach Verwendung. Beabsichtigt, aber
       erklaerungsbeduerftig; deshalb steht darueber eine Herleitungszeile.

   DIE PV-SONDERPRIORITAET wandert beim Tauschen NICHT mit: Sie gibt es nur auf
   Rang 1 (Ladeordnung.cs:270-273), und stehen zu lassen, was nicht mehr gilt,
   waere der Anfang einer stillen Falschrechnung (Tauschen:1272).

   FELDER, DIE NICHT ZUM ZIEL PASSEN, WERDEN GELOESCHT (ZeileAusOberflaeche
   :1082-1107): Eine Ladeprioritaet an einer Direktsenke ist kein harmloser Rest,
   sie stuende in der Ladeordnung und wuerde beim naechsten Zielwechsel unbemerkt
   wieder wirksam.

   TASTATUR: Esc bricht ab - erst die Rueckfrage bzw. die Pufferverwaltung, dann
   der Dialog. Enter ist NICHT belegt: OK SPEICHERT. *@

@namespace EPOS.UI.Dialoge.Simulation

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@Titel</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
    </div>

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    @* --- Die Senkenliste ---------------------------------------------------- *@
    <Gruppenkopf Titel="@GruppeSenkenliste">
        <KindInhalt>
            <Zeilenraster Bezeichnung="@GruppeSenkenliste"
                          Spaltenmass="44px 40px 2fr 2fr 1.2fr 1fr 1fr"
                          Spalten="@Listenspalten">
                <KindInhalt>
                    @for (int i = 0; i < _zeilen.Count; i++)
                    {
                        int index = i;
                        SenkenzeileDaten z = _zeilen[index];
                        <div class="epos-zr-zeile">
                            <div class="epos-zr-zelle">
                                <Zeilenwahl Gewaehlt="@(index == _index)" Kurztext="@SpalteRang"
                                            Gewaehltwerden="() => ZeileWaehlen(index)" />
                            </div>
                            <div class="epos-zr-zelle">@(index + 1)</div>
                            <div class="epos-zr-zelle">@Zielname(z.Ziel)</div>
                            <div class="epos-zr-zelle">@Speichername(z)</div>
                            <div class="epos-zr-zelle">@Bedarfsartname(z)</div>
                            <div class="epos-zr-zelle">@Ladespalte(z)</div>
                            <div class="epos-zr-zelle">@Hoehenspalte(z)</div>
                        </div>
                    }
                </KindInhalt>
            </Zeilenraster>

            <div class="epos-leiste">
                <button type="button" class="epos-knopf" @onclick="Hinzufuegen">@BtnHinzu</button>
                <button type="button" class="epos-knopf" @onclick="EntfernenStarten">@BtnEntfernen</button>
                <button type="button" class="epos-knopf" disabled="@(_index <= 0)"
                        @onclick="() => Tauschen(-1)">@BtnRauf</button>
                <button type="button" class="epos-knopf"
                        disabled="@(_index < 0 || _index >= _zeilen.Count - 1)"
                        @onclick="() => Tauschen(+1)">@BtnRunter</button>
            </div>
        </KindInhalt>
    </Gruppenkopf>

    @* --- Die gewählte Zeile ------------------------------------------------- *@
    @if (Aktuell is not null)
    {
        <Gruppenkopf Titel="@GruppeSenkenzeile">
            <KindInhalt>
                <Auswahlfeld Bezeichnung="@LabelZiel" Eintraege="@Zieleintraege"
                             Auswahl="@_zielIndex" AuswahlChanged="ZielWaehlen" />

                @if (IstPuffer(Aktuell.Ziel))
                {
                    <Auswahlfeld Bezeichnung="@LabelSpeicher" Eintraege="@Speichereintraege"
                                 Auswahl="@Aktuell.IdPuffer" AuswahlChanged="SpeicherWaehlen" />
                    <Herleitungszeile Text="@HerleitungSpeicherliste" />
                }

                @if (IstHeizkreis(Aktuell.Ziel))
                {
                    <Auswahlfeld Bezeichnung="@LabelBedarfsart" Eintraege="@Bedarfsarteintraege"
                                 Auswahl="@_bedarfsartIndex" AuswahlChanged="BedarfsartWaehlen" />
                    <Herleitungszeile Text="@HinweisBedarf" />
                }

                @if (VerwaltungGaben is not null)
                {
                    <div class="epos-leiste">
                        <button type="button" class="epos-knopf"
                                @onclick="() => VerwaltungOeffnen()">@BtnPufferAnlegen</button>
                    </div>
                }
            </KindInhalt>
        </Gruppenkopf>
    }

    @* --- Parallelverbund (nur Rang 1 mit Puffer) ---------------------------- *@
    @if (VerbundMoeglich)
    {
        <Gruppenkopf Titel="@GruppeVerbund">
            <KindInhalt>
                <Mehrfachauswahl Bezeichnung="@GruppeVerbund" Eintraege="@Verbundeintraege"
                                 Gewaehlt="@_verbund" GewaehltChanged="VerbundSetzen"
                                 MitSammelknoepfen="false" />
                <Herleitungszeile Text="@Verbundsumme" />
                <Herleitungszeile Text="@HerleitungVerbundliste" />
            </KindInhalt>
        </Gruppenkopf>
    }

    @* --- Ladeverhalten ------------------------------------------------------ *@
    @if (Aktuell is not null && IstPuffer(Aktuell.Ziel))
    {
        <Gruppenkopf Titel="@GruppeLadeverhalten">
            <KindInhalt>
                <Auswahlfeld Bezeichnung="@LabelLadeprio" Eintraege="@Prioritaeten"
                             Auswahl="@Aktuell.Ladeprio" AuswahlChanged="LadeprioWaehlen" />
                <Herleitungszeile Text="@_position" />

                <Schalter Bezeichnung="@LabelLadegrenze" Wert="@_ladegrenzeAktiv"
                          WertChanged="LadegrenzeUmschalten" />
                @if (_ladegrenzeAktiv)
                {
                    <Zahlenfeld Bezeichnung="@LabelLadegrenze" Einheit="%"
                                Feldname="@LabelLadegrenze" Wert="@_ladegrenze"
                                WertChanged="w => { _ladegrenze = w; ZeileZurueckschreiben(); }" />
                }

                @if (Daten.PvModus && _index == 0)
                {
                    <Auswahlfeld Bezeichnung="@LabelLadeprioPv" Eintraege="@PrioritaetenPv"
                                 Auswahl="@Aktuell.LadeprioPv" AuswahlChanged="LadeprioPvWaehlen" />
                }

                <Schalter Bezeichnung="@LabelEinspeisehoehe" Wert="@_hoeheAktiv"
                          WertChanged="EinspeisehoeheUmschalten" />
                @if (_hoeheAktiv)
                {
                    <Zahlenfeld Bezeichnung="@LabelEinspeisehoehe" Feldname="@LabelEinspeisehoehe"
                                Wert="@_hoehe"
                                WertChanged="w => { _hoehe = w; ZeileZurueckschreiben(); }" />
                    <Herleitungszeile Text="@TipEinspeisehoehe" />
                }
            </KindInhalt>
        </Gruppenkopf>
    }

    <Herleitungszeile Text="@HinweisPuffer" />

    <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />

    @* --- Rückfrage „jetzt einen Pufferspeicher anlegen?" -------------------- *@
    <Rueckfrage Offen="@_frageOffen" Frage="@_fragetext" TitelText="@TitelPufferFehlt"
                Beantwortet="FrageBeantwortet" JaText="@JaText" NeinText="@NeinText" />

    @* --- Die Pufferverwaltung als ÜBERLAGERUNG ------------------------------ *@
    @if (VerwaltungGaben is not null && _verwaltungGaben is not null)
    {
        <Ueberlagerung Offen="@_verwaltungOffen" Titel="@VerwaltungTitel"
                       Geschlossen="() => _verwaltungOffen = false">
            <KindInhalt>
                <PufferSpProjektDialog @attributes="_verwaltungGaben"
                                       Geschlossen="VerwaltungGeschlossen" />
            </KindInhalt>
        </Ueberlagerung>
    }
</div>

@code {
    // --- Was hereinkommt --------------------------------------------------------

