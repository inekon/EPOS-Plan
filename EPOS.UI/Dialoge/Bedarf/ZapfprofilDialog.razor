    /// <summary>Der Vorschlag der Ladeleistung zum aktuellen Arbeitsstand; <c>null</c> ohne Delegat, ohne Speichergruppe oder veraltet.</summary>
    private ZapfprofilSchaetzhilfeDaten? Ladehilfe => _ladehilfeAktuell ? _ladehilfe : null;

    /// <summary>Gehört <see cref="_ladehilfe"/> zum aktuellen Arbeitsstand?</summary>
    private bool _ladehilfeAktuell;

    /// <summary>
    /// Rechnet den Vorschlag der Ladeleistung (die Auslegung deterministisch, Hülle) — nur ab der
    /// Stufe Erweitert, wo die Schätzhilfe steht; die teure Stufe läuft mit der Vorschau entprellt.
    /// </summary>
    private void LadehilfeRechnen()
    {
        if (Ladevorschlag is null || !AbErweitert)
        {
            _ladehilfeAktuell = false;
            return;
        }
        _ladehilfe = Ladevorschlag(MitStufe());
        _ladehilfeAktuell = true;
    }

    /// <summary>„Als manuellen Wert übernehmen" an der Ladeleistung.</summary>
    private void LadeleistungUebernehmen(double? vorschlag)
    {
        if (vorschlag is not double v) return;
        Gebaeudeangabe(x =>
        {
            x.LadeManuellKw = v;
            x.LadeAuto = false;
        });
    }

    /// <summary>Die angesetzte Ladeleistung: der Vorschlag der Auslegung (auto) oder der manuelle Wert.</summary>
    private string LadeAngesetzt
        => !G.LadeAuto && G.LadeManuellKw is double kw ? Format(Texte.LadeAngesetztManuell, Zahl(kw, "N1")) : Texte.LadeAngesetztAuto;

    /// <summary>Die Perzentilmarken der Dauerlinie als Zeile: „P99 · 13,5 kW (Rang 88) · …".</summary>
    private string Dauermarken(ZapfprofilDauerlinieDaten d)
        => string.Join(" · ", d.Marken.Select(m => Format(Texte.DauerlinieMarke, m.Perzentil, Zahl(m.LeistungKw, "N1"),
                                                           m.Rang.ToString("N0", CultureInfo.CurrentCulture))));

    /// <summary>Die Warnliste der aktuellen Vorschau; leer ohne.</summary>
    private IReadOnlyList<ZapfprofilWarnDaten> Warnliste
        => _vorschau is { Zustand: ZapfprofilVorschauZustand.Gerechnet } v ? v.Warnliste : Array.Empty<ZapfprofilWarnDaten>();

    // --- Vorschau ----------------------------------------------------------------------

    /// <summary>Die gewählte Ansicht „Anzeigen für"; <c>null</c> ohne gerechnete Vorschau (keine vorbelegten Zahlen).</summary>
    private ZapfprofilAnsichtDaten? Ansicht
    {
        get
        {
            if (_vorschau is null || _vorschau.Zustand != ZapfprofilVorschauZustand.Gerechnet) return null;
            if (_vorschau.Ansichten.Count == 0) return null;
            int i = _ansicht >= 0 && _ansicht < _vorschau.Ansichten.Count ? _ansicht : 0;
            return _vorschau.Ansichten[i];
        }
    }

    private IReadOnlyList<(int Id, string Text)> Ansichtswahl
        => _vorschau is null
            ? Array.Empty<(int Id, string Text)>()
            : _vorschau.Ansichten.Select((a, i) => (Id: i, Text: a.Titel)).ToArray();

    private string VorschauGrund
    {
        get
        {
            if (_vorschau is not null && _vorschau.Grund.Length > 0)
                return Format(Texte.StatusOhneVorschau, _vorschau.Grund);
            return Format(Texte.StatusOhneVorschau, Daten.Sperrgrund);
        }
    }

    private string Kurzkennzahlen(ZapfprofilAnsichtDaten a)
    {
        ZapfprofilKennzahlenDaten k = a.Kennzahlen;
        string mwh = " " + Energieeinheit.MWh.Text + "/a";
        return string.Join(" · ",
            Texte.ReiheZapfung + " " + Mwh(k.JahresbedarfZapfungKwh) + mwh,
            Texte.ReiheZirkulation + " " + Mwh(k.JahresverlustZirkulationKwh) + mwh,
            Texte.KennzahlGesamt + " " + Mwh(k.JahresbedarfGesamtKwh) + mwh,
            Texte.KennzahlZirkulationsanteil + " " + Prozent(k.Zirkulationsanteil));
    }

    /// <summary>Die Zeilen des Reiters Kennzahlen (4.6) — nur, was der Kern für diese Ansicht ausweist.</summary>
    private IEnumerable<(string Kennzahl, string Wert, string Vermerk)> Kennzahlzeilen(ZapfprofilAnsichtDaten a)
    {
        ZapfprofilKennzahlenDaten k = a.Kennzahlen;
        string kwh = Energieeinheit.KWh.Text;
        yield return (Texte.KennzahlZapfung, Zahl(k.JahresbedarfZapfungKwh, "N0") + " " + kwh + "/a", "");
        yield return (Texte.KennzahlZirkulation, Zahl(k.JahresverlustZirkulationKwh, "N0") + " " + kwh + "/a",
                      Texte.KennzahlZirkulationVermerk);
        yield return (Texte.KennzahlGesamt, Zahl(k.JahresbedarfGesamtKwh, "N0") + " " + kwh + "/a",
                      Texte.KennzahlZirkulationsanteil + " " + Prozent(k.Zirkulationsanteil));
        yield return (Texte.KennzahlTagesmittel, Zahl(k.TagesmittelZapfungKwh, "N0") + " " + kwh + "/d",
                      k.ZapfungLiterJeTag is double l ? Format(Texte.KennzahlLiterJeTag, Zahl(l, "N0")) : "");
        if (k.SpezifischKwhJeEinheitJahr is double spez)
            yield return (Format(Texte.KennzahlSpezifisch, a.Titel),
                          Zahl(spez, "N0") + " " + kwh + "/(" + k.SpezifischEinheit + "·a)", "");
        if (k.VolllaststundenH is double h)
            yield return (Texte.KennzahlVolllast, Zahl(h, "N0") + " h/a", Texte.KennzahlVolllastVermerk);
        if (k.GroessterStundenwertKw is double p)
            yield return (Texte.KennzahlGroessterStundenwert, Zahl(p, "N1") + " kW", k.VermerkGroessterStundenwert);
        if (k.StundenUeberSchwelle is int n && k.SchwelleKw is double schwelle)
            yield return (Format(Texte.KennzahlStundenUeberSchwelle, Zahl(schwelle, "N1")),
                          n.ToString("N0", CultureInfo.CurrentCulture) + " h/a", "");
        // Mockup Abschnitt 3: Die Gleichzeitigkeit steht in der Bilanz mit „—" und Vermerk; ihr
        // Ergebniswert nach dem Lauf gehört zur Stochastik der Stufe Experte.
        yield return (Texte.KennzahlGleichzeitigkeit, "—", Texte.KennzahlGleichzeitigkeitVermerk);
    }

    // --- Stochastik im Reiter Kennzahlen (4.4, Mockup Abschnitt 3) --------------------

    /// <summary>Hat der Lauf „Stochastisch rechnen" die Jahresreihe zum aktuellen Arbeitsstand gezogen?</summary>
    private bool StochastikGerechnet
        => _stochastik is { Stochastisch: true, Zustand: ZapfprofilVorschauZustand.Gerechnet };

    /// <summary>Der Kopf der Gruppe Stochastik: nach dem Lauf mit Seed und Jahren, während des Laufs „rechnet …".</summary>
    private string StochastikKopf
        => StochastikGerechnet ? Format(Texte.KennzahlStochastikGerechnet, Ganz(_stochastik!.Seed), Ganz(_stochastik.Realisierungen))
         : JahresreiheLaeuft ? Texte.KennzahlStochastikLaeuft
         : Texte.KennzahlStochastik;

    /// <summary>
    /// Die Erklärzeile, solange keine Einzelwerte stehen (Stufe Einfach oder ohne Probe) — nach
    /// einem abgelehnten Lauf sein benannter Grund.
    /// </summary>
    private string StochastikErklaerung
        => _stochastik is { Zustand: not ZapfprofilVorschauZustand.Gerechnet, Grund.Length: > 0 } ? _stochastik.Grund
         : StochastikGerechnet ? Texte.KennzahlStochastikJahresreihe
         : Texte.KennzahlStochastikErklaerung;

    /// <summary>
    /// Die Konsistenzproben zur gewählten Ansicht — nur nach dem Lauf und nur in der Stufe Experte.
    /// Der Lauf trägt dieselben Ansichten wie die Vorschau (Summe zuerst, dann je Zone).
    /// </summary>
    private IReadOnlyList<ZapfprofilKonsistenzDaten> Konsistenzzeilen
    {
        get
        {
            if (!StochastikGerechnet || _stufe != ZapfprofilStufe.Experte || _stochastik!.Ansichten.Count == 0)
                return Array.Empty<ZapfprofilKonsistenzDaten>();
            int i = _ansicht >= 0 && _ansicht < _stochastik.Ansichten.Count ? _ansicht : 0;
            return _stochastik.Ansichten[i].Konsistenzen;
        }
    }

    /// <summary>Der Text des laufenden Laufs: Seed und Jahre des Arbeitsstands (leer = Vorgabe).</summary>
    private string JahresreiheLaufText
        => Format(Texte.StatusJahresreiheLaeuft, Ganz(_eingabe.Seed ?? Daten.SeedVorgabe),
                  Ganz(_eingabe.Realisierungen ?? Daten.RealisierungenVorgabe));

    /// <summary>Die Energieabweichung des Mittels der R Jahre vom deterministischen Pfad in Prozent, mit Vorzeichen.</summary>
    private static string Abweichungstext(ZapfprofilKonsistenzDaten k)
        => k.Abweichung is double a ? (a * 100.0).ToString("+0.00;−0.00;0.00", CultureInfo.CurrentCulture) + " %" : "–";

    /// <summary>Der Vermerk der Probe: Mittel, deterministisch, s_R, Toleranz und das Urteil.</summary>
    private string Konsistenztext(ZapfprofilKonsistenzDaten k)
        => Format(Texte.KennzahlKonsistenzVermerk, k.Realisierungen.ToString(CultureInfo.CurrentCulture), Zahl(k.MittelKwh, "N0"),
                  Zahl(k.DeterministischKwh, "N0"), Zahl(k.StandardabweichungKwh, "N0"), Zahl(k.ToleranzKwh, "N0"))
           + " · " + (k.Erfuellt ? Texte.KonsistenzErfuellt : Texte.KonsistenzAbweichend);

    /// <summary>Eine Vorgabe als Platzhalter im leeren Feld: „(1)"; ohne Vorgabe leer.</summary>
    private static string Klammer(int? wert) => wert is int w ? "(" + w.ToString(CultureInfo.CurrentCulture) + ")" : "";

    /// <summary>Eine ganze Zahl für einen Satz; ohne Wert „–".</summary>
    private static string Ganz(int? wert) => wert is int w ? w.ToString(CultureInfo.CurrentCulture) : "–";

    /// <summary>
    /// Die Meldungen der Vorschau zur Zone an Position <paramref name="index"/> (am Feld, nicht
    /// blockierend): über die Position, die die Hülle mitgibt; ohne Position nur über einen Namen,
    /// den genau diese Zone trägt — tragen zwei Zonen denselben Namen, steht keine Meldung an beiden.
    /// </summary>
    private IEnumerable<ZapfprofilMeldung> ZonenMeldungen(int index)
    {
        if (!_vorschauAktuell || _vorschau is null) return Array.Empty<ZapfprofilMeldung>();
        return Meldungen.Where(m => GehoertZu(m, index));
    }

    /// <summary>
    /// Die Meldungen der Vorschau und — nach dem Lauf „Stochastisch rechnen" — die eigenen des
    /// Laufs (etwa eine Zone ohne Zapfkategorien oder die Schranke der Einheitentage); eine
    /// Meldung, die beide tragen, steht einmal.
    /// </summary>
    private IReadOnlyList<ZapfprofilMeldung> Meldungen
    {
        get
        {
            var liste = new List<ZapfprofilMeldung>(_vorschau?.Meldungen ?? new List<ZapfprofilMeldung>());
            if (_stochastik is null) return liste;
            foreach (ZapfprofilMeldung m in _stochastik.Meldungen)
                if (!liste.Any(x => x.Kennung == m.Kennung && x.Zone == m.Zone && x.Text == m.Text)) liste.Add(m);
            return liste;
        }
    }

    private bool GehoertZu(ZapfprofilMeldung m, int index)
    {
        if (index < 0 || index >= _eingabe.Zonen.Count || m.Zone.Length == 0) return false;
        if (m.Position is int p) return p == index;
        string name = (_eingabe.Zonen[index].Name ?? "").Trim();
        return m.Zone == name && _eingabe.Zonen.Count(z => (z.Name ?? "").Trim() == name) == 1;
    }

    /// <summary>
    /// Die Meldungen ohne sichtbare Zone: Projekt und Zirkulation, der Grund einer nicht
    /// gerechneten Vorschau und die Meldungen einer Zone, die gerade nicht gewählt ist oder
    /// sich keiner Zone eindeutig zuordnen lässt, stehen in der Vorschau — benannt statt still.
    /// </summary>
    private IEnumerable<ZapfprofilMeldung> AllgemeineMeldungen
    {
        get
        {
            if (_vorschau is null) return Array.Empty<ZapfprofilMeldung>();
            // Die Hinweise des Rechenwegs stehen in der Warnliste (Z4) — dort mit Titel und Stufe, hier nicht noch einmal.
            bool warnliste = Warnliste.Count > 0;
            return Meldungen.Where(m =>
                !(warnliste && m.Art == ZapfprofilMeldungsart.Hinweis)
                && (m.Zone.Length == 0 ? _vorschau.Zustand == ZapfprofilVorschauZustand.Gerechnet
                                       : !_vorschauAktuell || !GehoertZu(m, _wahl)));
        }
    }

    /// <summary>Der Status der Fußleiste: während des Laufs „rechnet …", danach sein Ergebnis, sonst die Vorschau.</summary>
    private string Status
        => JahresreiheLaeuft ? JahresreiheLaufText
         : _stochastik is { Status.Length: > 0 } ? _stochastik.Status
         : _vorschau is null ? "" : _vorschau.Status;

    private void StatusNachziehen()
    {
        if (_leiste is null || Status == _statusGezeigt) return;
        _statusGezeigt = Status;
        ZapfprofilVorschauDaten? quelle = !JahresreiheLaeuft && _stochastik is { Status.Length: > 0 } ? _stochastik : _vorschau;
        bool fehler = !JahresreiheLaeuft && quelle is not null && quelle.Zustand == ZapfprofilVorschauZustand.Abgebrochen;
        _leiste.Zeigen(Status, fehler);
    }

    private static string Mwh(double kwh)
        => Energieeinheit.MWh.AusKWh(kwh).ToString("N1", CultureInfo.CurrentCulture);

    private static string Zahl(double wert, string format) => wert.ToString(format, CultureInfo.CurrentCulture);

    private static string Prozent(double anteil)
        => (anteil * 100.0).ToString("N0", CultureInfo.CurrentCulture) + " %";

    private static string Format(string muster, params object[] werte)
    {
        try { return string.Format(CultureInfo.CurrentCulture, muster ?? "", werte); }
        catch (FormatException) { return muster ?? ""; }
    }

    // =================================================================================
    // Bedienung
    // =================================================================================

    private void StufeWaehlen(int? id)
    {
        // Alle drei Stufen sind waehlbar (Z4). Die Stufe blendet nur ein und aus — die Werte bleiben;
        // ein Feld, das verschwindet, nimmt seinen ungueltigen Text mit (der Arbeitsstand traegt den
        // letzten gueltigen Wert).
        if (id is not int n || !Enum.IsDefined(typeof(ZapfprofilStufe), n)) return;
        _stufe = (ZapfprofilStufe)n;
        _hinweis = "";
        if (_stufe != ZapfprofilStufe.Experte)
        {
            // Nur die Felder, die verschwinden, nehmen ihre Fehleingabe mit.
            _fehlfelder.Remove(Texte.LabelSeed);
            _fehlfelder.Remove(Texte.LabelRealisierungen);
        }
        FehlfelderRaeumen(art => art.Stufe > _stufe);
        if (_stufe == ZapfprofilStufe.Einfach && _reiter == REITER_DAUER) _reiter = REITER_TAG;
        // Der Vorschlag der Ladeleistung steht ab Erweitert — zum Stand der aktuellen Vorschau einmal rechnen.
        if (AbErweitert && _vorschauAktuell && !_ladehilfeAktuell) LadehilfeRechnen();
    }

    /// <summary>Ein gesperrter Reiter meldet seinen Grund als leise Zeile.</summary>
    private void ReiterGesperrt(string reiter)
        => _hinweis = reiter == REITER_DAUER ? Texte.GrundDauerlinie : Texte.GrundNochNicht;

    // --- Die Editoren der Stufe Experte (Z4, Gruppe 2b) ----------------------------------

    /// <summary>Warum ein Editor nicht aufgeht — ohne Delegat oder ohne Nutzungsart der Zone; <c>null</c>, wenn er aufgeht.</summary>
    private string? EditorGrund(bool delegat, ZapfprofilZoneDaten zone)
        => !delegat ? Texte.GrundNochNicht : zone.IdNutzungsart <= 0 ? Texte.GrundOhneNutzungsart : null;

    /// <summary>„Tagesgang bearbeiten…": die Überlagerung zur Nutzungsart der Zone und ihrem Satz; gesperrt nennt die leise Zeile den Grund.</summary>
    private void TagesgangOeffnen(ZapfprofilZoneDaten zone)
    {
        if (EditorGrund(TagesgangGaben is not null, zone) is { } grund)
        {
            _hinweis = grund;
            return;
        }
        _hinweis = "";
        _editorStatus = "";
        _editorZone = zone;
        _tagesgangGaben = TagesgangGaben!(zone.IdNutzungsart, zone.Angaben?.IdTagesgangsatz);
    }

    /// <summary>„Zapfkategorien und Streuung…": die Überlagerung zur Nutzungsart der Zone.</summary>
    private void KategorienOeffnen(ZapfprofilZoneDaten zone)
    {
        if (EditorGrund(KategorienGaben is not null, zone) is { } grund)
        {
            _hinweis = grund;
            return;
        }
        _hinweis = "";
        _editorStatus = "";
        _editorZone = zone;
        _kategorienGaben = KategorienGaben!(zone.IdNutzungsart);
    }

    /// <summary>
    /// Der Tagesgang ist geschrieben (Katalog, eine Transaktion): Der Katalog wird neu gelesen, die
    /// Zone rechnet mit der Nutzungsart, die jetzt die Werte trägt — eine neue Katalogversion ersetzt
    /// die gesperrte —, und eine Expertenwahl des Satzes folgt dem geschriebenen Satz. Die Vorschau
    /// rechnet neu; ein übernommener Punkt ist überholt. Abbrechen (<c>null</c>) lässt alles, wie es war.
    /// </summary>
    private void TagesgangGeschlossen(ZapfprofilTagesgangErgebnis? e)
    {
        _tagesgangGaben = null;
        ZapfprofilZoneDaten? zone = _editorZone;
        _editorZone = null;
        if (e is not { Ok: true } || zone is null || !_eingabe.Zonen.Contains(zone)) return;
        KatalogNeuLesen();
        zone.IdNutzungsart = e.IdNutzungsart;
        if (zone.Angaben?.IdTagesgangsatz is not null && e.IdTagesgangsatz > 0) zone.Angaben.IdTagesgangsatz = e.IdTagesgangsatz;
        _editorStatus = Format(Texte.TgeStatusGespeichert, zone.Name, NutzungsartKurz(e.IdNutzungsart));
        PunktUeberholen();
        GeaendertNachEditor();
    }

    /// <summary>Die Kategorien sind geschrieben: Katalog neu, die Zone auf die Nutzungsart, die sie jetzt trägt.</summary>
    private void KategorienGeschlossen(ZapfprofilKategorienErgebnis? e)
    {
        _kategorienGaben = null;
        ZapfprofilZoneDaten? zone = _editorZone;
        _editorZone = null;
        if (e is not { Ok: true } || zone is null || !_eingabe.Zonen.Contains(zone)) return;
        KatalogNeuLesen();
        zone.IdNutzungsart = e.IdNutzungsart;
        _editorStatus = Format(Texte.KatStatusGespeichert, zone.Name, NutzungsartKurz(e.IdNutzungsart));
        PunktUeberholen();
        GeaendertNachEditor();
    }

    /// <summary>Der Katalog nach dem Schreibweg — über den Delegaten der Hülle; ohne ihn bleibt der Stand beim Öffnen.</summary>
    private void KatalogNeuLesen()
    {
        if (Katalogstand is not null) _katalogstand = Katalogstand();
    }

    /// <summary>Die Nutzungsart als Kurztext „Name · Katalogversion"; unbekannt ihre Id.</summary>
    private string NutzungsartKurz(int id)
        => Nutzungsart(id) is { } n
            ? (string.IsNullOrEmpty(n.Katalogversion) ? n.Name : n.Name + " · " + n.Katalogversion)
            : "#" + id.ToString(CultureInfo.InvariantCulture);

    /// <summary>Wie <see cref="Geaendert"/>, aber die leise Zeile des Editors bleibt stehen.</summary>
    private void GeaendertNachEditor()
    {
        string status = _editorStatus;
        Geaendert();
        _editorStatus = status;
    }

    // --- Fehleingaben der hoeheren Stufen ------------------------------------------------

    /// <summary>Zu jedem gemeldeten Feld: die Stufe, in der es steht, und ob es zur gewählten Zone gehört.</summary>
    private readonly Dictionary<string, (ZapfprofilStufe Stufe, bool Zone)> _feldart = new(StringComparer.Ordinal);

    /// <summary>Ein Feld der höheren Stufen meldet seine Fehleingabe — mit Stufe und Zonenbezug, damit sie mit dem Feld verschwindet.</summary>
    private void FeldMelden((string Feld, bool Fehlerhaft) f, ZapfprofilStufe stufe, bool zone = true)
    {
        _feldart[f.Feld] = (stufe, zone);
        FehlerZustandMelden(f);
    }

    /// <summary>Nimmt die Fehleingaben der Felder, die verschwinden, aus der Sperre des OK.</summary>
    private void FehlfelderRaeumen(Func<(ZapfprofilStufe Stufe, bool Zone), bool> verschwindet)
    {
        foreach (string feld in _fehlfelder.ToList())
            if (_feldart.TryGetValue(feld, out var art) && verschwindet(art)) _fehlfelder.Remove(feld);
    }

    // --- Die Wege der Felder der hoeheren Stufen -----------------------------------------
    // Jede Angabe, die die Auslegung aendert, macht deren Punkt ueberholt (N11 (h)); Quelle und
    // Zeitraum eines Messwerts und die Laufangaben der Anzeige aendern sie nicht.

    /// <summary>Setzt eine Angabe der Zone <paramref name="z"/> (Stufen Erweitert und Experte).</summary>
    private void Angabe(ZapfprofilZoneDaten z, Action<ZapfprofilZonenangabenDaten> setzen, bool auslegung = true)
    {
        setzen(z.Angaben ??= new ZapfprofilZonenangabenDaten());
        if (auslegung) PunktUeberholen();
        Geaendert();
    }

    /// <summary>Setzt eine gebäudeweite Größe; ohne Projektzeile beginnt sie mit den Vorgaben der DDL.</summary>
    private void Gebaeudeangabe(Action<ZapfprofilGebaeudeDaten> setzen, bool auslegung = true)
    {
        setzen(_eingabe.Gebaeude ??= Daten.GebaeudeVorgabe?.Kopie() ?? new ZapfprofilGebaeudeDaten());
        if (auslegung) PunktUeberholen();
        Geaendert();
    }

    private void TopologieSetzen(ZapfprofilZoneDaten z, int? id)
    {
        if (id is not int t || !Enum.IsDefined(typeof(ZapfprofilTopologie), t)) return;
        Angabe(z, x => x.Topologie = (ZapfprofilTopologie)t);
    }

    /// <summary>Der Kalender: der Eintrag der Nutzungsart löst die Bindung, ein Gebäude bindet (A8).</summary>
    private void KalenderSetzen(ZapfprofilZoneDaten z, int? id)
        => Angabe(z, x => x.IdGebaeude = id is int g && g != KALENDER_NUTZUNGSART ? g : null);

    private void FerienSetzen(ZapfprofilZoneDaten z, int k, Action<ZapfprofilFerienDaten> setzen)
        => Angabe(z, x =>
        {
            x.Ferien ??= ZapfprofilZonenangabenDaten.NeueFerien();
            while (x.Ferien.Count <= k) x.Ferien.Add(new ZapfprofilFerienDaten());
            setzen(x.Ferien[k] ??= new ZapfprofilFerienDaten());
        });

    /// <summary>Der Jahresmesswert; der erste Wert ohne Einheit nimmt die Vorgabe kWh/a.</summary>
    private void MesswertSetzen(ZapfprofilZoneDaten z, double? wert)
        => Angabe(z, x =>
        {
            x.Jahresmesswert = wert;
            if (wert.HasValue && !x.JahresmesswertEinheit.HasValue) x.JahresmesswertEinheit = ZapfprofilMesswerteinheit.KwhJeJahr;
        });

    /// <summary>Die Einheit des Messwerts; ein Volumen gilt an der Zapfstelle — seine Grenze fällt weg.</summary>
    private void MesswertEinheitSetzen(ZapfprofilZoneDaten z, int? id)
    {
        if (id is not int e || !Enum.IsDefined(typeof(ZapfprofilMesswerteinheit), e)) return;
        Angabe(z, x =>
        {
            x.JahresmesswertEinheit = (ZapfprofilMesswerteinheit)e;
            if (x.JahresmesswertEinheit == ZapfprofilMesswerteinheit.KubikmeterJeJahr) x.JahresmesswertBilanzgrenze = null;
        });
    }

    private void MesswertGrenzeSetzen(ZapfprofilZoneDaten z, int? id)
        => Angabe(z, x => x.JahresmesswertBilanzgrenze = id is int g && Enum.IsDefined(typeof(ZapfprofilBilanzgrenze), g)
                                                          ? (ZapfprofilBilanzgrenze)g : null);

    private void AuslastungSetzen(ZapfprofilZoneDaten z, int monat, double? wert)
        => Angabe(z, x =>
        {
            x.Auslastung ??= new double?[ZapfprofilZonenangabenDaten.MONATE];
            if (monat < x.Auslastung.Length) x.Auslastung[monat] = wert;
        });

    /// <summary>„Als manuellen Wert übernehmen" am Tagesbedarf: der Vorschlag wird der manuelle Wert, der Umschalter „manuell".</summary>
    private void TagesbedarfUebernehmen(ZapfprofilZoneDaten z, double? vorschlag)
    {
        if (vorschlag is not double v) return;
        Angabe(z, x =>
        {
            x.TagesbedarfManuellKwh = v;
            x.TagesbedarfAuto = false;
        });
    }

    /// <summary>„Als manuellen Wert übernehmen" an der Zirkulation.</summary>
    private void ZirkulationUebernehmen(double? vorschlag)
    {
        if (vorschlag is not double v) return;
        Gebaeudeangabe(x =>
        {
            x.ZirkManuellKw = v;
            x.ZirkAuto = false;
        });
    }

    private void ZirkMethodeSetzen(int? id)
    {
        if (id is not int m || !Enum.IsDefined(typeof(ZapfprofilZirkulationsmethode), m)) return;
        // Die Felder der alten Methode verschwinden — ihre Fehleingaben mit ihnen.
        foreach (string feld in new[] { Texte.LabelZirkLaenge, Texte.LabelZirkVerlust, Texte.LabelZirkAnteil })
            _fehlfelder.Remove(feld);
        Gebaeudeangabe(x => x.ZirkMethode = (ZapfprofilZirkulationsmethode)m);
    }

    private void WohnungNeu(ZapfprofilZoneDaten z)
        => Angabe(z, x => x.Wohnungen.Add(new ZapfprofilWohnungDaten()));

    private void WohnungEntfernen(ZapfprofilZoneDaten z, ZapfprofilWohnungDaten w)
    {
        // Die Felder der Tabelle heissen nach ihrer Zeile — nach dem Entfernen verschieben sie sich:
        // Die Fehleingaben der Tabelle fallen mit ihr weg, die übrigen Felder bleiben gesperrt.
        ZapfprofilZonenangabenDaten a = AngabenVon(z);
        foreach (ZapfprofilWohnungDaten zeile in a.Wohnungen)
            foreach (string spalte in new[] { Texte.LabelAnzahl, Texte.LabelRaumzahl, Texte.LabelPersonen })
                _fehlfelder.Remove(WohnFeld(spalte, a, zeile));
        Angabe(z, x => x.Wohnungen.Remove(w));
    }

    private void WohnungSetzen(ZapfprofilZoneDaten z, ZapfprofilWohnungDaten w, Action<ZapfprofilWohnungDaten> setzen)
        => Angabe(z, _ => setzen(w));

    /// <summary>Die Temperatur der Literanzeige (Laufangabe, nur Kennzahlen).</summary>
    private void AnzeigetemperaturSetzen(double? wert)
    {
        if (_eingabe.AnzeigetemperaturC == wert) return;
        _eingabe.AnzeigetemperaturC = wert;
        Geaendert();
    }

    /// <summary>Die Schwelle der Stundenzählung (Laufangabe, nur Kennzahlen).</summary>
    private void SchwelleSetzen(double? wert)
