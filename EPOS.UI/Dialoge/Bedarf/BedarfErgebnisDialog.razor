@* Simulation Ergebnisse - Strom- und Waermebedarf (iU9-W8.2).

   VORBILD. DREI Masken mit demselben Aufbau: Views/Stromverbraucher/
   Form_ErgStromverbraucher (169 Z.), Views/Prozesswaerme/Form_ErgProzesswaerme
   (215 Z.) und Views/Brauchwasser/Form_ErgBrauchwasserwaerme (425 Z.). Alle
   drei heissen "Simulation Ergebnisse", alle drei haben dieselben drei Reiter -
   Kennzahlen, Monatswerte, Grafik - und alle drei sind reine ANZEIGEN. Sie
   unterscheiden sich in dem, WAS sie zeigen: vier Kennzahlen und eine
   Monatsreihe beim Strom, sieben Kennzahlen und zwei bzw. drei Reihen bei der
   Waerme.

   REINE ANZEIGE, also ein eingefrorenes Datenobjekt. Die Vorlaeufer bekamen das
   LEBENDE Simulationsobjekt und lasen bei jedem Optionswechsel neu daraus. Hier
   baut die Huelle BedarfErgebnisDaten und rendert die Bilder vorab; die
   Komponente kennt SimulationStrombedarf und SimulationWaermebedarf nicht.

   ZWEI UNABHAENGIGE OPTIONSGRUPPEN, wie im Vorlaeufer: eine fuer die Tabelle
   (radioBtn_Prozesse/Gebaeude/Brauchwasser) und eine fuer das Bild
   (radioBtn_Grafik*). Sie sind bewusst NICHT gekoppelt - wer die Zahlen der
   Prozesse liest und daneben das Gebaeudebild sehen will, kann das.

   DER STARTREITER WAEHLT BEIM BRAUCHWASSER ZUGLEICH DIE SICHT. SetPage:421 der
   Brauchwassermaske setzt nicht nur den Reiter, sondern auch beide
   Optionsgruppen: 0 -> Prozesse, 1 -> Gebaeude, 2 -> Brauchwasser. Genau
   deshalb landet der Weg "Berechnen" dort auf der Brauchwassersicht.

   EINE EINHEIT FUER ALLE DREI REITER (Anwenderentscheid W8-O-5 vom 04.09.2026):
   MWh als Vorgabe, kWh waehlbar. Das Wahlfeld steht ueber der Reiterleiste, weil
   Kennzahlen, Monatstabelle und Saeulenbild gemeinsam folgen. Umgerechnet wird
   nur, was die Huelle als ZAHL samt Quelleneinheit mitgibt - die beiden
   Leistungen in kW und der Jahresverlauf bleiben unberuehrt. Das Saeulenbild
   kommt in zwei Fassungen herein; ein PNG laesst sich nicht umrechnen, und die
   Komponente ruft keinen Renderer.

   OHNE MAUSRAD-ZOOM (A-1): Die Jahresansicht des Vorlaeufers liess sich am
   Mausrad spreizen. Ein PNG kann das nicht; Zoomen ist W3-O2/W11.

   DREI KATEGORIEN STATT EINER LISTE (Anwenderwunsch W8-E-2, Windows-Abnahme
   05.09.2026). Der Bestand reihte alle Kennzahlen untereinander - eine LEISTUNG
   in kW zwischen Energiemengen in MWh, und die Summe mittendrin. Der Anwender
   hat beides beanstandet. Das Blatt hat jetzt einen Block je Kategorie mit
   Zwischenueberschrift und die Summe ABGESETZT im tfoot. Wer keine Kategorien
   mitgibt, bekommt weiter die schlichte Liste - Vorgabe ist Kennzahlart.Energie.

   UND DER GRAFIKREITER TRAEGT DREI ZEITSTUFEN (ebenfalls W8-E-2): Jahr wie
   bisher, dazu Woche und Tag mit Navigator. Das steht in BedarfGangGrafik; ohne
   Ganglinienquelle erscheint der Umschalter gar nicht, und die drei
   Waermeauspraegungen sehen den Reiter unveraendert.

   TASTATUR: Esc und Enter schliessen - der Dialog hat nur den einen Knopf. *@

@namespace EPOS.UI.Dialoge.Bedarf
@using WindowsFormsApplication1

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@Titel</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
    </div>

    @* Die Einheit gilt fuer ALLE drei Reiter - Kennzahlen, Monatstabelle und
       Saeulenbild - und steht deshalb ueber der Reiterleiste. Sie erscheint nur,
       wenn die Huelle Zahlen samt Quelleneinheit mitgegeben hat. *@
    @if (EinheitWaehlbar)
    {
        <Auswahlfeld Bezeichnung="@LabelEinheit" Eintraege="@Einheitenwahl"
                     Auswahl="@EinheitIndex" AuswahlChanged="EinheitWaehlen" />
    }

    <Reiter @bind-Aktiv="_reiter" Bezeichnung="@TitelText">
        <KindInhalt>

            @* --- Reiter 1: die Kennzahlen ------------------------------------ *@
            <Reiterblatt Schluessel="KENNZAHLEN" Titel="@ReiterKennzahlen">
                <KindInhalt>
                    <div class="epos-raster-huelle">
                        <table class="epos-raster epos-kennzahlen">

                            @* Die LEISTUNG steht fuer sich (W8-E-2): eine Groesse in kW
                               gehoert nicht zwischen Energiemengen in MWh, und schon gar
                               nicht in deren Summe. Der Block entfaellt, wenn es keine
                               Leistungszeile gibt. *@
                            @if (Leistungen.Count > 0)
                            {
                                <tbody class="epos-kennzahlen-block">
                                    <tr class="epos-kennzahlen-kopf">
                                        <th colspan="3" scope="colgroup">@GruppeLeistung</th>
                                    </tr>
                                    @foreach (ErgebnisKennzahl kennzahl in Leistungen)
                                    {
                                        ErgebnisKennzahl k = kennzahl;
                                        <tr>
                                            <td>@k.Bezeichnung</td>
                                            <td class="epos-zahl">@Kennzahlwert(k)</td>
                                            <td class="epos-einheit">@Kennzahleinheit(k)</td>
                                        </tr>
                                    }
                                </tbody>
                            }

                            <tbody class="epos-kennzahlen-block">
                                @if (Leistungen.Count > 0)
                                {
                                    <tr class="epos-kennzahlen-kopf">
                                        <th colspan="3" scope="colgroup">@GruppeEnergie</th>
                                    </tr>
                                }
                                @foreach (ErgebnisKennzahl kennzahl in Posten)
                                {
                                    ErgebnisKennzahl k = kennzahl;
                                    <tr>
                                        <td>@k.Bezeichnung</td>
                                        <td class="epos-zahl">@Kennzahlwert(k)</td>
                                        <td class="epos-einheit">@Kennzahleinheit(k)</td>
                                    </tr>
                                }
                            </tbody>

                            @* Die SUMME steht UNTEN und abgesetzt (W8-E-2) - im tfoot,
                               damit sie auch fuer die Sprachausgabe der Fuss der Tabelle
                               ist und nicht die letzte Zeile unter vielen. *@
                            @if (Summen.Count > 0)
                            {
                                <tfoot class="epos-kennzahlen-summe">
                                    @foreach (ErgebnisKennzahl kennzahl in Summen)
                                    {
                                        ErgebnisKennzahl k = kennzahl;
                                        <tr>
                                            <th scope="row">@k.Bezeichnung</th>
                                            <td class="epos-zahl">@Kennzahlwert(k)</td>
                                            <td class="epos-einheit">@Kennzahleinheit(k)</td>
                                        </tr>
                                    }
                                </tfoot>
                            }

                        </table>
                    </div>
                </KindInhalt>
            </Reiterblatt>

            @* --- Reiter 2: die Monatswerte ----------------------------------- *@
            <Reiterblatt Schluessel="MONATE" Titel="@ReiterMonate">
                <KindInhalt>
                    @if (Daten.Sichten.Count > 1)
                    {
                        <Optionsgruppe Eintraege="@Sichtwahl" Auswahl="@_sichtTabelle"
                                       AuswahlChanged="TabellensichtWaehlen" />
                    }

                    <Gruppenkopf Titel="@GruppeMonate">
                        <KindInhalt>
                            <div class="epos-raster-huelle">
                                <table class="epos-raster">
                                    <tbody>
                                        @for (int m = 0; m < 12; m++)
                                        {
                                            int monat = m;
                                            <tr>
                                                <td>@Monatsname(monat)</td>
                                                <td class="epos-zahl">@Monatswert(monat)</td>
                                                <td>@MonatEinheit</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </KindInhalt>
                    </Gruppenkopf>
                </KindInhalt>
            </Reiterblatt>

            @* --- Reiter 3: das Bild ------------------------------------------ *@
            <Reiterblatt Schluessel="GRAFIK" Titel="@ReiterGrafik">
                <KindInhalt>
                    @* Seit W8-E-2 liegt der Reiter in BedarfGangGrafik: Die Jahressicht
                       geht unveraendert als KindInhalt hinein, Woche und Tag kommen aus
                       der Ganglinienquelle. Ohne sie gibt es weder Umschalter noch
                       Navigator und der Reiter sieht aus wie zuvor. *@
                    <BedarfGangGrafik Quelle="@Daten.Ganglinie"
                                      StufeJahrText="@StufeJahrText"
                                      StufeWocheText="@StufeWocheText"
                                      StufeTagText="@StufeTagText"
                                      MarkeFormat="@MarkeFormat"
                                      PlatzhalterText="@PlatzhalterBild">
                        <JahresInhalt>
                            @if (Daten.Sichten.Count > 1)
                            {
                                <Optionsgruppe Eintraege="@Sichtwahl" Auswahl="@_sichtGrafik"
                                               AuswahlChanged="GrafiksichtWaehlen" />
                            }

                            @* Der Schalter steht nur bei der Brauchwassersicht - und nur, wenn
                               die Huelle ueberhaupt einen Jahresverlauf mitgegeben hat
                               (checkBox_MonatJahr.Visible, AktualisiereGrafik:142). *@
                            @if (JahresverlaufMoeglich)
                            {
                                <Schalter Bezeichnung="@LabelJahresverlauf" Wert="@_jahresverlauf"
                                          WertChanged="JahresverlaufUmschalten" />
                            }

                            <ChartBild Png="@Bild" Alt="@Bildtext" PlatzhalterText="@PlatzhalterBild" />
                        </JahresInhalt>
                    </BedarfGangGrafik>
                </KindInhalt>
            </Reiterblatt>

        </KindInhalt>
    </Reiter>

    <SpeichernLeiste OkText="@OkText" MitAbbrechen="false" Ergebnis="BeiErgebnis" />
</div>

@code {
    /// <summary>Der eingefrorene Auszug des Rechenobjekts; die Hülle baut ihn.</summary>
    [Parameter] public BedarfErgebnisDaten Daten { get; set; } = new();

    /// <summary>
    /// Die ANZEIGEEINHEIT beim Öffnen — MWh (Vorgabe) oder kWh (Anwenderentscheid
    /// W8‑O‑5 vom 04.09.2026). Die Hülle holt sie aus <c>BedarfEinheitWahl</c>, damit
    /// dieser Dialog dieselbe zeigt wie der Bedarfsprofildialog, aus dem er kommt.
    /// </summary>
    [Parameter] public Energieeinheit Einheit { get; set; } = Energieeinheit.MWh;

    /// <summary>Meldet der Hülle die neu gewählte Einheit, damit sie gemerkt wird.</summary>
    [Parameter] public Action<Energieeinheit>? EinheitGewaehlt { get; set; }

    /// <summary>Der Dialog wurde geschlossen — immer mit <c>true</c>, er hat nur OK.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Simulation Ergebnisse";
    [Parameter] public string ReiterKennzahlen { get; set; } = "Wärmebedarf Ergebnisse";
    [Parameter] public string ReiterMonate { get; set; } = "Übersicht monatlich";
    [Parameter] public string ReiterGrafik { get; set; } = "Grafik";
    [Parameter] public string GruppeMonate { get; set; } = "monatlicher Verlauf:";
    /// <summary>
    /// Die Einheit der Monatstabelle, wenn die Sicht KEINE Zahlen mitbringt. Sonst
    /// steht dort die gewählte Einheit.
    /// </summary>
    [Parameter] public string EinheitMonat { get; set; } = "MWh";

    /// <summary>Beschriftung des Wahlfeldes über der Reiterleiste.</summary>
    [Parameter] public string LabelEinheit { get; set; } = "Einheit:";

    [Parameter] public string LabelJahresverlauf { get; set; } = "Jahresverlauf";
    [Parameter] public string PlatzhalterBild { get; set; } = "Kein Diagramm vorhanden";
    [Parameter] public string OkText { get; set; } = "OK";

    /// <summary>Überschrift des Leistungsblocks (W8‑E‑2) — Ressource BERG_GRP_LEISTUNG.</summary>
    [Parameter] public string GruppeLeistung { get; set; } = "Leistung";

    /// <summary>Überschrift des Energieblocks (W8‑E‑2) — Ressource BERG_GRP_ENERGIE.</summary>
    [Parameter] public string GruppeEnergie { get; set; } = "Energie";

    /// <summary>Beschriftung der Zeitstufe „Jahr" — Ressource BERG_STUFE_JAHR.</summary>
    [Parameter] public string StufeJahrText { get; set; } = "Jahr";

    /// <summary>Beschriftung der Zeitstufe „Woche" — Ressource BERG_STUFE_WOCHE.</summary>
    [Parameter] public string StufeWocheText { get; set; } = "Woche";

    /// <summary>Beschriftung der Zeitstufe „Tag" — Ressource BERG_STUFE_TAG.</summary>
    [Parameter] public string StufeTagText { get; set; } = "Tag";

    /// <summary>Marke des Navigators — {0} Nummer, {1} Anzahl, {2} Stufe (BERG_GANG_MARKE).</summary>
    [Parameter] public string MarkeFormat { get; set; } = "{2} {0} von {1}";

    /// <summary>Die zwölf Monatsbeschriftungen der Tabelle.</summary>
    [Parameter]
    public IReadOnlyList<string> Monatsnamen { get; set; } = new[]
    {
        "Januar:", "Februar:", "März:", "April:", "Mai:", "Juni:",
        "Juli:", "August:", "September:", "Oktober:", "November:", "Dezember:"
    };

    /// <summary>Was statt eines fehlenden Wertes steht.</summary>
    [Parameter] public string LeerText { get; set; } = "—";

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_ErgProzesswaerme.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private string _reiter = "";
    private int _sichtTabelle;
    private int _sichtGrafik;
    private bool _jahresverlauf;

    /// <summary>Die gewählte Anzeigeeinheit; beim Aufbau <see cref="Einheit"/>.</summary>
    private Energieeinheit _einheit = Energieeinheit.MWh;

    /// <summary>Der Fenstertitel samt Zusatz („ - ‹Name›" des Brauchwasserwegs).</summary>
    public string Titel => string.IsNullOrEmpty(Daten.TitelZusatz)
        ? TitelText : TitelText + " - " + Daten.TitelZusatz;

    /// <summary>Der sichtbare Reiter — Prüfhilfe für die Tests.</summary>
    public string Reiterblattschluessel => _reiter;

    /// <summary>Die gewählte Tabellensicht — Prüfhilfe für die Tests.</summary>
    public int Tabellensicht => _sichtTabelle;

    /// <summary>Die gewählte Grafiksicht — Prüfhilfe für die Tests.</summary>
    public int Grafiksicht => _sichtGrafik;

    /// <summary>Steht der Schalter „Jahresverlauf" gerade? Prüfhilfe für die Tests.</summary>
    public bool JahresverlaufGewaehlt => _jahresverlauf;

    /// <summary>Die gewählte Anzeigeeinheit — Prüfhilfe für die Tests.</summary>
    public Energieeinheit Anzeigeeinheit => _einheit;

    // --- Die drei Kennzahlblöcke (Anwenderwunsch W8‑E‑2) ------------------------
    //
    // Der Bestand reihte alles untereinander. Der Anwender will die LEISTUNG als
    // eigene Kategorie und die SUMME abgesetzt am Ende. Sortiert wird hier nicht:
    // Die Reihenfolge innerhalb eines Blocks bleibt die der Hülle.

    /// <summary>Die Leistungszeilen (kW) — eigener Block, außerhalb der Summe.</summary>
    public IReadOnlyList<ErgebnisKennzahl> Leistungen => Block(Kennzahlart.Leistung);

    /// <summary>Die Posten der Energiebilanz.</summary>
    public IReadOnlyList<ErgebnisKennzahl> Posten => Block(Kennzahlart.Energie);

    /// <summary>Die Summenzeile(n) am Fuß des Blattes.</summary>
    public IReadOnlyList<ErgebnisKennzahl> Summen => Block(Kennzahlart.Summe);

    private List<ErgebnisKennzahl> Block(Kennzahlart art)
    {
        var liste = new List<ErgebnisKennzahl>();
        foreach (ErgebnisKennzahl k in Daten.Kennzahlen) if (k.Art == art) liste.Add(k);
        return liste;
    }

    /// <summary>
    /// Gibt es überhaupt etwas umzurechnen? Nur wenn die Hülle Zahlen samt
    /// Quelleneinheit mitgegeben hat, erscheint das Wahlfeld — ein Datensatz aus
    /// fertigen Texten bleibt so, wie er ist.
    /// </summary>
    private bool EinheitWaehlbar
        => Daten.Kennzahlen.Any(k => k.Energie is not null && k.QuelleEinheit is not null)
           || Daten.Sichten.Any(s => s.Zahlen is not null && s.QuelleEinheit is not null);

    /// <summary>Die beiden Einheiten als Auswahlliste — MWh zuerst.</summary>
    private IReadOnlyList<(int Id, string Text)> Einheitenwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                liste.Add((i, Energieeinheit.Alle[i].Text));
            return liste;
        }
    }

    private int EinheitIndex
    {
        get
        {
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                if (ReferenceEquals(Energieeinheit.Alle[i], _einheit)) return i;
            return 0;
        }
    }

    private void EinheitWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n >= Energieeinheit.Alle.Count) return;

        Energieeinheit neu = Energieeinheit.Alle[n];
        if (ReferenceEquals(neu, _einheit)) return;

        _einheit = neu;
        EinheitGewaehlt?.Invoke(neu);
    }

    /// <summary>Die Einheit der Monatstabelle und des Säulenbildes.</summary>
    private string MonatEinheit
    {
        get
        {
            Monatssicht? sicht = AktuelleTabellensicht;
            return (sicht?.Zahlen is not null && sicht.QuelleEinheit is not null)
                ? _einheit.Text : EinheitMonat;
        }
    }

    private Monatssicht? AktuelleTabellensicht
        => (_sichtTabelle >= 0 && _sichtTabelle < Daten.Sichten.Count)
            ? Daten.Sichten[_sichtTabelle] : null;

    private static readonly string[] REITER = { "KENNZAHLEN", "MONATE", "GRAFIK" };

    /// <summary>Die Optionsknöpfe beider Gruppen — dieselbe Beschriftungsfolge.</summary>
    private IReadOnlyList<(int Id, string Text)> Sichtwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < Daten.Sichten.Count; i++) liste.Add((i, Daten.Sichten[i].Bezeichnung));
            return liste;
        }
    }

    /// <summary>
    /// Der Schalter erscheint nur bei der Brauchwassersicht UND nur, wenn ein
    /// Jahresverlauf vorliegt — wörtlich <c>AktualisiereGrafik</c>:142, das
    /// <c>checkBox_MonatJahr.Visible</c> in jedem anderen Zweig auf <c>false</c> setzt.
    /// </summary>
    private bool JahresverlaufMoeglich
        => Daten.JahresverlaufBild is not null
           && _sichtGrafik >= 0 && _sichtGrafik < Daten.Sichten.Count
           && Daten.Sichten[_sichtGrafik].IstBrauchwasser;

    /// <summary>
    /// Das gerade gezeigte Bild: Monatssäulen oder der Jahresverlauf.
    ///
    /// <para>Die Säulen gibt es in zwei Fassungen, eine je Einheit — ein PNG lässt
    /// sich nicht umrechnen, und die Komponente ruft keinen Renderer. Der
    /// Jahresverlauf zeigt eine LEISTUNG in kW und bleibt davon unberührt.</para>
    /// </summary>
    private byte[]? Bild
    {
        get
        {
            if (JahresverlaufMoeglich && _jahresverlauf) return Daten.JahresverlaufBild;
            if (_sichtGrafik < 0 || _sichtGrafik >= Daten.Sichten.Count) return null;

            Monatssicht sicht = Daten.Sichten[_sichtGrafik];
            return (ReferenceEquals(_einheit, Energieeinheit.KWh) && sicht.BildKWh is not null)
                ? sicht.BildKWh : sicht.Bild;
        }
    }

    private string Bildtext
        => (_sichtGrafik >= 0 && _sichtGrafik < Daten.Sichten.Count)
            ? Daten.Sichten[_sichtGrafik].Bezeichnung : "";

    protected override void OnInitialized()
    {
        _einheit = Einheit ?? Energieeinheit.Vorgabe;

        int start = Daten.StartReiter;
        if (start < 0 || start >= REITER.Length) start = 0;
        _reiter = REITER[start];

        // SetPage:421 der Brauchwassermaske setzt mit dem Reiter zugleich beide
        // Optionsgruppen; die beiden anderen Masken beginnen immer bei der ersten Sicht
        // (Init:27: radioBtn_Prozesse.Checked = true).
        if (Daten.MitBrauchwasser && start < Daten.Sichten.Count)
        {
            _sichtTabelle = start;
            _sichtGrafik = start;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private void TabellensichtWaehlen(int? id) => _sichtTabelle = id ?? 0;

    private void GrafiksichtWaehlen(int? id)
    {
        _sichtGrafik = id ?? 0;

        // Ein Sichtwechsel weg vom Brauchwasser nimmt den Schalter mit: Der Vorlaeufer
        // versteckte ihn dabei, und ein verborgener Haken haette beim Zurueckwechseln
        // still weitergewirkt.
        if (!JahresverlaufMoeglich) _jahresverlauf = false;
    }

    private void JahresverlaufUmschalten(bool an) => _jahresverlauf = an;

    private string Anzeige(string? wert) => string.IsNullOrEmpty(wert) ? LeerText : wert;

    private string Monatsname(int m)
        => (Monatsnamen is not null && Monatsnamen.Count > m) ? Monatsnamen[m] : "";

    private string Monatswert(int m)
    {
        Monatssicht? sicht = AktuelleTabellensicht;
        if (sicht is null) return LeerText;

        if (sicht.Zahlen is not null && sicht.QuelleEinheit is not null && sicht.Zahlen.Count > m)
            return _einheit.Formatiere(_einheit.Aus(sicht.QuelleEinheit, sicht.Zahlen[m]));

        IReadOnlyList<string>? werte = sicht.Werte;
        return (werte is not null && werte.Count > m) ? Anzeige(werte[m]) : LeerText;
    }

    /// <summary>
    /// Der Wert einer Kennzahl. Eine Energiemenge folgt der Einheitenwahl, alles
    /// andere — die beiden Leistungen in kW — bleibt der fertige Text der Hülle.
    /// </summary>
    private string Kennzahlwert(ErgebnisKennzahl k)
        => (k.Energie is not null && k.QuelleEinheit is not null)
            ? _einheit.Formatiere(_einheit.Aus(k.QuelleEinheit, k.Energie.Value))
            : Anzeige(k.Wert);

    private string Kennzahleinheit(ErgebnisKennzahl k)
        => (k.Energie is not null && k.QuelleEinheit is not null) ? _einheit.Text : k.Einheit;

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Esc UND Enter schließen. Der Dialog zeigt nur an und trägt einen einzigen Knopf —
    /// hier kann Enter nichts versehentlich schreiben (Regel aus <c>EPOS.UI/CLAUDE.md</c>).
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
        => (e.Key == "Escape" || e.Key == "Enter") ? Geschlossen.InvokeAsync(true) : Task.CompletedTask;
}
