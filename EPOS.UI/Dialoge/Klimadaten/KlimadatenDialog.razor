    private void BeiSzenario(int? id)
    {
        _szenario = id switch
        {
            (int)TrySzenario.Sommerwarm => TrySzenario.Sommerwarm,
            (int)TrySzenario.Winterkalt => TrySzenario.Winterkalt,
            _ => TrySzenario.MittleresJahr
        };
        _importMeldung = "";
    }

    // =====================================================================
    // Regionsvorschau (Auftrag KL-3)
    // =====================================================================

    /// <summary>
    /// Ermittelt die TRY-Region zum eingetragenen Standort und schreibt das Ergebnis
    /// als Herleitungszeile unter die Auswahl. <b>Ein Fehlschlag ist kein Absturz und
    /// keine Sperre</b>: Er steht als Zeile da, und einlesen darf der Anwender weiterhin.
    /// </summary>
    private async Task BeiRegion()
    {
        if (!RegionErlaubt) return;

        var auftrag = _ortsname.Trim().Length > 0
            ? new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusOrtsname,
                  Ortsname = _ortsname.Trim()
              }
            : new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusKoordinaten,
                  Bezeichnung = _bezeichnung.Trim(),
                  Longitude = _longitude ?? 0,
                  Latitude = _latitude ?? 0
              };

        auftrag.Quelle = KlimaQuelle.TryRegional;
        auftrag.TryPaketPfad = _tryPaketPfad.Trim();
        auftrag.TryJahr = _tryJahr ?? KlimaImportAuftrag.TRY_JAHR_VORGABE;
        auftrag.Szenario = _szenario;

        _regionLaeuft = true;
        _regionszeile = RegionLaeuftText;
        _importMeldung = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            KlimaVorschauErgebnis erg = await RegionErmitteln!(auftrag);
            _regionszeile = erg.Meldung ?? "";
            if (!erg.Erfolgreich && _regionszeile.Length == 0)
                _regionszeile = EingabenPruefenText;
        }
        finally
        {
            _regionLaeuft = false;
        }
    }

    // =====================================================================
    // Import (btn_Import_Click)
    // =====================================================================

    /// <summary>
    /// „Daten einlesen" in der Überlagerung. <b>Gelingt es</b>, schließt die
    /// Überlagerung, die neue Region steht gewählt in der Liste, und die Statuszeile
    /// meldet sie (V14). <b>Scheitert es</b>, bleibt die Überlagerung offen und meldet
    /// den Grund in ihrem eigenen Warnband — das des Dialogs läge unter ihr.
    /// </summary>
    private async Task BeiImport()
    {
        if (!ImportErlaubt) return;

        var auftrag = _ortsname.Trim().Length > 0
            ? new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusOrtsname,
                  Ortsname = _ortsname.Trim()
              }
            : new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusKoordinaten,
                  Bezeichnung = _bezeichnung.Trim(),
                  Longitude = _longitude ?? 0,
                  Latitude = _latitude ?? 0
              };

        // Die Quelle und ihre Angaben (Auftrag KL1-B). Bei PVGIS bleiben die
        // Vorgaben stehen - der Auftrag sieht dann aus wie vor KL1-B.
        auftrag.Quelle = _quelle;
        if (_quelle == KlimaQuelle.TryDatei)
        {
            auftrag.TryPfad = _tryPfad.Trim();
        }
        else if (_quelle == KlimaQuelle.TryRegional)
        {
            auftrag.TryPaketPfad = _tryPaketPfad.Trim();
            auftrag.TryJahr = _tryJahr ?? KlimaImportAuftrag.TRY_JAHR_VORGABE;
            auftrag.Szenario = _szenario;
        }

        _laeuft = true;
        _anteil = null;
        _fortschrittText = "";
        _importMeldung = "";
        _status = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            var melder = new Progress<ImportFortschritt>(f =>
            {
                _anteil = f.Anteil;
                _fortschrittText = Fortschrittstext(f.Schluessel);
                InvokeAsync(StateHasChanged);
            });

            KlimaImportErgebnis erg = await Importieren!(auftrag, melder);

            if (erg.Erfolgreich)
            {
                // ANWENDERWUNSCH 19.09.2026, Punkt 2: Die Felder BLEIBEN stehen - vor
                // einem Doppelimport schuetzt der Dublettenschutz des Ablaufs
                // (KlimaImportAusgang.Dublette), nicht das Leeren des Formulars.
                // Die Regionszeile der Vorschau geht weg: Sie gehoerte zum Lauf.
                _regionszeile = "";
                _importOffen = false;

                // V14: die neue Region steht gewaehlt, die Kaestchen fallen - die
                // naechste Handlung gilt ihr.
                _auswahl.Aufheben();
                _vergleichszeilen = null;
                _gewaehlt = erg.Bezeichner ?? "";
                await RegionenLaden();

                _status = erg.Meldung.Length > 0
                    ? erg.Meldung
                    : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_EINGELESEN, erg.Bezeichner);
            }
            else if (erg.Meldung.Length > 0)
            {
                ImportMelden(erg.Meldung, erg.Ausgang == KlimaImportAusgang.Abgebrochen
                                              ? WarnStufe.Hinweis : WarnStufe.Fehler);
            }
        }
        finally
        {
            // Der Vorlaeufer hatte KEIN finally: Brach der Ablauf zwischen
            // "Balken sichtbar" und einem der acht return ab, blieb er stehen
            // (Befund W14c-B32).
            _laeuft = false;
            _anteil = null;
            _fortschrittText = "";
        }
    }

    private void BeiAbbrechen()
    {
        Abbrechen?.Invoke();
    }

    /// <summary>
    /// Der Begleittext eines Schritts. Der Ablauf meldet SCHLÜSSEL, keine Texte — die
    /// Übersetzung gehört zur Anzeige.
    /// </summary>
    private string Fortschrittstext(string schluessel)
    {
        if (string.IsNullOrEmpty(schluessel)) return "";
        try { return Resource.ResourceManager.GetString(schluessel) ?? schluessel; }
        catch { return schluessel; }
    }

    // =====================================================================
    // Loeschen (btn_Delete_Click) - A-7 mit Rueckfrage, A-8 mit Kaskade,
    // seit Stufe 4 aus der Auswahlleiste und auch fuer mehrere Regionen (AD-Q9)
    // =====================================================================

    /// <summary>
    /// <b>„Löschen" aus der Auswahlleiste</b> (V8, AD-Q9): wirkt auf die gewählten
    /// Zeilen, sonst auf die Fokuszeile; Auslieferungsregionen bleiben stehen (V13),
    /// und die Rückfrage nennt sie.
    /// </summary>
    private void BeiLoeschen()
    {
        if (_laeuft || Loeschen is null) return;

        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count == 0) { Melden(AuswaehlenText, WarnStufe.Hinweis); return; }

        var loeschbar = ziele.Where(z => !_geschuetzt.Contains(z)).ToList();
        var bleiben = ziele.Where(z => _geschuetzt.Contains(z)).ToList();
        if (loeschbar.Count == 0) { Warnen(Resource.ADM_AW_LOESCHEN_GESPERRT_OHNE_KOPIE); return; }

        _loeschziele = loeschbar;
        _loeschBleiben = bleiben.Count;

        string frage = loeschbar.Count == 1
            ? string.Format(VorlageLoeschfrage, loeschbar[0])
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_FRAGE_MEHR,
                            loeschbar.Count, string.Join(", ", loeschbar));
        if (bleiben.Count > 0)
            frage += " " + string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_BLEIBEN,
                                         string.Join(", ", bleiben));
        _loeschfrage = frage;
        _loeschfrageOffen = true;
    }

    /// <summary>
    /// Nach dem „Ja": je Region ein Schritt (der Kern löscht samt Datenblöcken). Ein
    /// Fehlschlag meldet sich im Warnband; Gelungenes nennt die Statuszeile (V11).
    /// </summary>
    private async Task LoeschfrageBeantwortet(bool? antwort)
    {
        _loeschfrageOffen = false;
        if (antwort != true || Loeschen is null) return;

        int geloescht = 0;
        bool fehler = false;
        foreach (string name in _loeschziele)
        {
            if (await Loeschen(name)) geloescht++;
            else fehler = true;
        }

        int ziele = _loeschziele.Count + _loeschBleiben;
        int blieben = ziele - geloescht;
        string einzeln = _loeschziele.Count == 1 ? _loeschziele[0] : "";
        _loeschziele = new List<string>();

        if (geloescht > 0) await RegionenLaden();
        if (fehler) Warnen(ReadOnlyText);
        if (geloescht == 0) return;

        _status = ziele == 1
            ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT, einzeln)
            : blieben > 0
                ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT_BLEIBEN, geloescht, blieben)
                : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT, geloescht);
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    /// <summary>
    /// „Beenden" liefert <c>true</c> — auch über das Kreuz und Esc: EIN Schlussweg
    /// (Konzept Administrationsdialoge, V15). Einlesen und Löschen schreiben sofort.
    /// Während eines Laufs schließt der Dialog nicht.
    /// </summary>
    private Task BeiSchliessen() => _laeuft ? Task.CompletedTask : Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Esc stufenweise (Konzept 3.3): Überlagerungen und Rückfrage fangen ihr Esc
    /// selbst; im schmalen Fenster schließt Esc zuerst das Blatt, zuletzt den Dialog.
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_loeschfrageOffen || _laeuft || _importOffen || _grossOffen) return Task.CompletedTask;

        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }
        return BeiSchliessen();
    }
}
