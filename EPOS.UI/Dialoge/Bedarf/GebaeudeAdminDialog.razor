    /// <summary>
    /// <b>„Speichern"</b> — ein Auslieferungssatz ist weich gesperrt (AD-Q11); sonst
    /// <see cref="Schreiben"/>.
    /// </summary>
    private void BeiSpeichern()
    {
        if (_auslieferung) { SpeichernAbgelehnt(MeldungSpeichernGesperrt); return; }
        if (!Geaendert || Speichern is null || _gewaehlt.Length == 0) return;
        Schreiben();
    }

    /// <summary>
    /// <b>Prüfen, Ableiten, Schreiben — die Regeln und der Weg des Katalogeditors.</b> Eine
    /// verletzte Regel meldet das Warnband (und klappt „Alle Daten" auf, wenn ihr Feld dort
    /// steht); geschrieben wird der ganze Feldsatz über den Weg der Hülle, der Bezeichner
    /// bleibt. Danach liest die Liste neu (Gebäudeart, Verwendung, Baujahr und Fläche sind
    /// Spalten), und die Statuszeile meldet es. Knopf und Assistent gehen diesen Weg.
    /// </summary>
    private bool Schreiben()
    {
        if (Speichern is null) return false;

        GebaeudePruefbefund? befund = _arbeit.Pruefen(false, Pruefwortlaut, HuellTexte);
        if (befund is not null)
        {
            // Stufe KP2, Welle U4: Haengt die Regel an Matrix, Nachtzeit oder Ferien, oeffnet sie das
            // Blatt „Konditionierung" - dort steht das Feld (E56 F3 (a)).
            if (befund.Temperaturen) _kondOffen = true;
            else if (befund.Bereich != GebaeudePruefbereich.Huelle) _alleDatenOffen = true;
            SpeichernAbgelehnt(befund.Meldung);
            return false;
        }

        _arbeit.Ableiten();
        GebaeudeKatalogErgebnis erg = Speichern(_arbeit.Stand, false, _gewaehlt);
        if (!erg.Erfolg)
        {
            SpeichernAbgelehnt(erg.Meldung.Length > 0 ? erg.Meldung : MeldungFehler);
            return false;
        }

        _arbeit.Geschrieben();
        KatalogLaden();
        _status = string.Format(CultureInfo.CurrentCulture, Resource.ADM_STATUS_GESPEICHERT,
                                DateTime.Now.ToString("HH:mm", CultureInfo.CurrentCulture));
        return true;
    }

