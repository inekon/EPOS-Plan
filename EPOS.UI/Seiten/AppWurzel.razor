    private EPOS.UI.Seiten.Assistent.AssistentSeite? _assistentSeite;

    /// <summary>
    /// Der Assistent ist fertig oder darf verlassen werden — dann wird nicht (noch
    /// einmal) gefragt. Gesetzt vom Rückweg und von der beantworteten Rückfrage,
    /// zurückgesetzt beim Betreten der Ansicht.
