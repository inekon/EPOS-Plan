    /// <summary>
    /// KBP-3b: die Grafik der markierten Kaeltezeile aus einer synthetischen Reihe - werktags 7 bis 19 Uhr Volllast
    /// mit Sommeranstieg, sonst ein Fuenftel, auf die Jahressumme der Zeile skaliert; der Kalender 2 legt Betriebsferien.
    /// Nacharbeit: Bearbeitete Monatsanteile (Arbeitsstand der Ueberlagerung) verteilen die Monate um, wie im Kern.
    /// </summary>
    private WindowsFormsApplication1.Kaelteprofilbilder? KpGrafik(BedarfsProfilZeile markiert, IReadOnlyList<BedarfsProfilZeile> alle)
    {
        static double[] Reihe(double summeMwh, int versatz)
        {
            var r = new double[8760];
            for (int d = 0; d < 365; d++)
            {
                double saison = 0.4 + 0.6 * Math.Max(0.0, Math.Sin(Math.PI * (d - 60) / 245.0));
                for (int h = 0; h < 24; h++)
                    r[d * 24 + h] = saison * ((d + 3) % 7 < 5 && h >= 7 + versatz && h < 19 ? 1.0 : 0.2);
            }
            double s = r.Sum();
            for (int i = 0; i < r.Length; i++) r[i] *= summeMwh * 1000.0 / s;
            return r;
        }
        byte[]? arten = null;
        if (markiert.KalenderId == 2)
        {
            arten = new byte[365];
            for (int d = 212; d < 233; d++) arten[d] = WindowsFormsApplication1.Betriebskalender.TAG_FERIEN;
        }
        static double[] Monate(BedarfsProfilZeile z, double[] r)
        {
            if (!z.ProfilGeaendert || z.Monatsanteile is not { Length: 12 } a || a.Sum() <= 0) return r;
            int h = 0;
            for (int m = 0; m < 12; m++)
            {
                int ende = h + new[] { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }[m] * 24;
                double ist = 0;
                for (int i = h; i < ende; i++) ist += r[i];
                double soll = z.Summe * 1000.0 * a[m] / a.Sum();
                for (int i = h; i < ende; i++) r[i] = ist > 0 ? r[i] * soll / ist : 0;
                h = ende;
            }
            return r;
        }
        int platz = alle.ToList().IndexOf(markiert);
        return WindowsFormsApplication1.Kaelteprofilgrafik.Bilder(Monate(markiert, Reihe(markiert.Summe, platz)),
            alle.Select((z, i) => (z.Name, Monate(z, Reihe(z.Summe, i)))).ToList(), 3, arten);
    }

