@* ETAPPE E8b (U43; Register Q18, Konzept § 2.11.2 V-G12) - der Knopf
   "Anhang-E-Checkliste..." im Fuss des Bewertungsblocks der Wirtschaftlichkeitsseite
   (Mockup: Fussleiste des Bewertungsblocks, zwischen "Parameter..." und "Bericht
   erzeugen"). Er zeigt die Checkliste der DIN EN 17463, Anhang E, in einer
   Ueberlagerung: je Punkt Anforderung, Stelle im Bericht und Stand in EPOS.

   EIN EIGENER BAUSTEIN mit EINER Einbindungszeile in der Seite: Die Punkte entstehen
   im Kern (AnhangECheckliste.Punkte) - dieselben wie auf der Abschlussseite des Wort-
   und des Tabellenberichts. Hier wird nur die Lage aus dem Stand der Seite gelesen
   (was gerechnet und gepflegt ist); die Beurteilung 1-5 vergibt der Pruefer im
   Bericht, deshalb fehlt die Spalte hier.

   BV-E2 (Konzept Berichtsvorlagen 9.5, 11 Nr. 3): DIE STELLE DER GEWAEHLTEN VORLAGE.
   Beim Oeffnen holt der Knopf ueber StellenLaden, was die Huelle zur gewaehlten
   Word-Vorlage sagt: je Punkt die Stelle, wie die Checkliste des Kerns sie aus den
   Kapiteln der Vorlage baut - mit ihren Ueberschriften oder "nicht im Bericht",
   dazu das Blatt der Mappe. Sie steht an der Stelle der eigenen; ein Punkt ohne
   Stelle der Huelle behaelt die eigene (die Ueberschriften der Kapitel). Eine leise
   Zeile ueber der Tafel sagt, worauf sich die Spalte bezieht; ohne Delegat oder
   ohne Antwort "bezogen auf die Standardvorlage". *@

@namespace EPOS.UI.Seiten.Berichte
@using WindowsFormsApplication1

<button type="button" class="epos-knopf epos-wirt-checklistenknopf" disabled="@Gesperrt"
        @onclick="Oeffnen">@Resource.WIRT_AE_KNOPF</button>

<Ueberlagerung Offen="@_offen" Titel="@Resource.WIRT_AE_TITEL" Geschlossen="Schliessen">
    <KindInhalt>
        <Herleitungszeile Text="@Resource.WIRT_AE_HINWEIS" />
        @* BV-E6 (Konzept Berichtsvorlagen 9.5): die Marke der Checkliste in der Zeile, die
           sagt, worauf sich die Spalte "Stelle" bezieht - die gewaehlte Vorlage oder die
           Standardvorlage. Das Kapitel des Anhangs nennt sie im Zusatz. *@
        <div class="epos-vorlagenfeld-zeile">
            <Herleitungszeile Text="@Bezugszeile" />
            <Vorlagenfeldknopf Vorlagenfeld="tabelle.anhang_e.checkliste" Zusatz="kapitel.anhang_e" />
        </div>
        <div class="epos-raster-huelle">
            <table class="epos-raster epos-wirt-tafel epos-wirt-checkliste">
                <thead>
                    <tr>
                        <th>@Resource.WIRT_AE_SP_NR</th>
                        <th>@Resource.WIRT_AE_SP_THEMA</th>
                        <th>@Resource.WIRT_AE_SP_ANFORDERUNG</th>
                        <th>@Resource.WIRT_AE_SP_STELLE</th>
                        <th>@Resource.WIRT_AE_SP_STAND</th>
                    </tr>
                </thead>
                <tbody>
                    @{ string? gruppe = null; }
                    @foreach (ChecklistenPunkt p in _punkte)
                    {
                        if (!string.Equals(gruppe, p.Gruppe, StringComparison.Ordinal))
                        {
                            gruppe = p.Gruppe;
                            <tr class="epos-wirt-checkliste-gruppe"><th colspan="5">@gruppe</th></tr>
                        }
                        <tr class="@("epos-wirt-checkliste-" + p.Stand.ToString().ToLowerInvariant())">
                            <td>@p.Nummer</td>
                            <td>@p.Thema</td>
                            <td>@p.Anforderung</td>
                            <td>
                                @if (StelleDerVorlage(p) is string vorlage)
                                {
                                    <span class="epos-wirt-checkliste-stelle">@vorlage</span>
                                }
                                else
                                {
                                    @p.Stelle
                                }
                            </td>
                            <td>@p.StandZeile</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </KindInhalt>
</Ueberlagerung>

@code {
    /// <summary>Der Stand der Wirtschaftlichkeitsseite — aus ihm liest der Knopf, was
    /// gerechnet und gepflegt ist.</summary>
    [Parameter] public WirtschaftlichkeitStand? Stand { get; set; }

    /// <summary>Während eines Laufs gesperrt, wie jeder Knopf der Seite.</summary>
    [Parameter] public bool Gesperrt { get; set; }

    /// <summary>
    /// BV-E2: die Stellen der gewählten Word-Vorlage — beim Öffnen geholt, damit sie der Wahl auf der
    /// Berichtsseite folgen; eine Stelle der Hülle ersetzt die eigene des Punktes. Ohne Delegat oder
    /// ohne Antwort nennt die Spalte die eigenen Stellen mit der leisen Zeile „bezogen auf die
    /// Standardvorlage".
    /// </summary>
    [Parameter] public Func<AnhangEStellen?>? StellenLaden { get; set; }

    private bool _offen;
    private IReadOnlyList<ChecklistenPunkt> _punkte = Array.Empty<ChecklistenPunkt>();
    private AnhangEStellen? _stellen;

    private void Oeffnen()
    {
        _punkte = AnhangECheckliste.Punkte(Lage(Stand));
        _stellen = StellenHolen();
        _offen = true;
    }

    /// <summary>Die Stellen der Hülle; ein Fehler beim Holen heißt: bezogen auf die Standardvorlage.</summary>
    private AnhangEStellen? StellenHolen()
    {
        try { return StellenLaden?.Invoke(); }
        catch (Exception) { return null; }
    }

    /// <summary>Die leise Zeile über der Tafel: worauf sich die Spalte „Stelle im Bericht" bezieht.</summary>
    private string Bezugszeile => string.IsNullOrWhiteSpace(_stellen?.Bezug)
        ? Resource.WIRT_AE_BEZUG_STANDARD : _stellen!.Bezug;

    /// <summary>Die Stelle eines Punktes in der gewählten Vorlage; <c>null</c> = die eigene des Punktes.</summary>
    private string? StelleDerVorlage(ChecklistenPunkt p)
        => _stellen?.Stellen is { } stellen && stellen.TryGetValue(p.Nummer, out string? s) && !string.IsNullOrWhiteSpace(s)
           ? s : null;

    private void Schliessen() => _offen = false;

    /// <summary>
    /// Die Lage aus dem Stand der Seite — dieselben Größen, die der Bericht aus seiner
    /// Bewertung liest (<see cref="ChecklistenLage.AusBericht"/>): Kennzahlen gerechnet,
    /// nicht monetäre Wirkungen gepflegt, Zeitraum abgeglichen, Positionen ohne
    /// Nutzungsdauer, Sensitivität, Bandbreite, Vorschlag.
    /// </summary>
    internal static ChecklistenLage Lage(WirtschaftlichkeitStand? s)
    {
        if (s is null) return new ChecklistenLage();
        return new ChecklistenLage
        {
            Gerechnet = s.Ansicht.Kennzahltafel.Zeilen.Count > 0,
            // ETAPPE E17 (V‑G11): erfasst und beurteilt folgen der Wirkungsliste — dieselben
            // Kernfunktionen wie im Bericht; das Altfeld zählt nicht.
            NichtMonetaerErfasst = NichtMonetaereWirkungen.Benannt(s.Wirkungen),
            NichtMonetaerBeurteilt = NichtMonetaereWirkungen.Beurteilt(s.Wirkungen),
            ZeitraumBegruendet = !string.IsNullOrEmpty(s.Zeitraumzeile),
            PositionenOhneNutzungsdauer = s.Nutzungsdauerhinweise.Count > 0,
            SensitivitaetGerechnet = s.Ansicht.Sensitivitaet.Zeilen.Count > 0,
            SzenarienGerechnet = BeideSzenarien(s.Ansicht.Bandbreite),
            // ETAPPE E13 (E9b‑Q5 b): nur ein Szenario gerechnet hebt Punkt 9 auf „teilweise".
            EinSzenarioGerechnet = EinSzenario(s.Ansicht.Bandbreite),
            VorschlagVorhanden = !string.IsNullOrEmpty(s.Ansicht.Empfehlungszeile),
            // ETAPPE E9b: Punkt 9 nennt den Ausweis „n von m Parametern szenariert".
            Szenarioabdeckung = s.Szenarioabdeckung
        };
    }

    /// <summary>
    /// Ungünstig UND Günstig tragen in einer Zeile der Bandbreite eine Zahl — dieselbe
    /// Bedingung wie im Bericht (<see cref="ChecklistenLage.SzenarienGerechnet"/>). Die Tafel
    /// schreibt „—", wo ein Szenario fehlt, und in der Referenzzeile das Wort „Referenz";
    /// die beiden Spalten werden über ihre Köpfe gefunden (die erste Spalte ist die Version).
    /// </summary>
    internal static bool BeideSzenarien(ErgebnisMatrix tafel)
    {
        int worst = IndexVon(tafel.Spalten, Resource.WIRT_SZEN_WORST) - 1;
        int best = IndexVon(tafel.Spalten, Resource.WIRT_SZEN_BEST) - 1;
        if (worst < 0 || best < 0) return false;
        return tafel.Zeilen.Any(z => z is not null && z.Zellen.Count > Math.Max(worst, best)
                                  && IstZahl(z.Zellen[worst]) && IstZahl(z.Zellen[best]));
    }

    /// <summary>
    /// ETAPPE E13 — Ungünstig ODER Günstig trägt in einer Zeile der Bandbreite eine Zahl;
    /// dieselbe Bedingung wie im Bericht (<see cref="ChecklistenLage.EinSzenarioGerechnet"/>).
    /// </summary>
    internal static bool EinSzenario(ErgebnisMatrix tafel)
    {
        int worst = IndexVon(tafel.Spalten, Resource.WIRT_SZEN_WORST) - 1;
        int best = IndexVon(tafel.Spalten, Resource.WIRT_SZEN_BEST) - 1;
        return tafel.Zeilen.Any(z => z is not null
            && ((worst >= 0 && z.Zellen.Count > worst && IstZahl(z.Zellen[worst]))
             || (best >= 0 && z.Zellen.Count > best && IstZahl(z.Zellen[best]))));
    }

    private static int IndexVon(IReadOnlyList<string> liste, string wert)
    {
        for (int i = 0; i < liste.Count; i++)
            if (string.Equals(liste[i], wert, StringComparison.Ordinal)) return i;
        return -1;
    }

    private static bool IstZahl(string zelle)
        => double.TryParse(zelle, System.Globalization.NumberStyles.Number,
                           System.Globalization.CultureInfo.CurrentCulture, out _);
}
