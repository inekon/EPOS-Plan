    /// <summary>„Laufangabe — wird nicht gespeichert; …" ohne leeren Zusatz.</summary>
    private string Laufangabe(string zusatz)
    {
        string t = Format(Texte.HerleitungLaufangabe, zusatz ?? "").TrimEnd();
        return string.IsNullOrWhiteSpace(zusatz) ? t.TrimEnd(';', ' ') : t;
    }

    private string KonstruktorName
        => _eingabe.Entwurf?.Bezeichner is { Length: > 0 } name ? name : Daten.NameVorschlag;

    private string OhneGrund
    {
        get
        {
            if (_ergebnis is not null && _ergebnis.Grund.Length > 0) return Format(Texte.StatusOhne, _ergebnis.Grund);
            return Format(Texte.StatusOhne, Daten.Sperrgrund);
        }
    }

    /// <summary>Der Punkt einer Gruppe: Speicher „V l · Φ kW", sonst die Minutenspitze.</summary>
    private string Punkttext(ZapfprofilAuslegungsgruppeDaten g)
    {
        ZapfprofilEmpfehlungDaten e = g.Empfehlung;
        if (!e.Rechenbar) return "–";
        return e.Speicher
            ? Format(Texte.PunktSpeicher, Zahl(e.VolumenL ?? 0, "N0"), Zahl(e.LeistungKw ?? 0, "N1"))
            : Format(Texte.PunktMinutenspitze, Zahl(e.LeistungKw ?? 0, "N1"));
    }

    private string Standtext(ZapfprofilKarteDaten k)
    {
        string stand = k.Stand == ZapfprofilKartenstand.AusserhalbGueltigkeit ? Texte.StandAusserhalb : Texte.StandNichtRechenbar;
        return k.Text.Length > 0 ? stand + " — " + k.Text : stand;
    }

    private string Vergleichseingaben(ZapfprofilVergleichDaten v)
        => Format(Texte.VergleichEingaben, Zahl(v.LadeleistungKw, "N1"), v.LadeManuell ? Texte.Manuell : Texte.Auto,
                  v.Personen is double p ? Zahl(p, "N0") : "–", v.KennzahlN is double n ? Zahl(n, "N1") : "–",
                  Zahl(v.Nutzanteil, "N2"), Prozent(v.Zuschlag));

    private string Groesstertext(ZapfprofilVergleichDaten v)
    {
        ZapfprofilVerfahrenDaten? g = v.Verfahren.FirstOrDefault(z => z.Groesster);
        return g is null || g.VolumenL is not double vol ? "–" : g.Verfahren + " · " + Zahl(vol, "N0") + " l";
    }

    private string Listentext(ZapfprofilVergleichDaten v)
    {
        if (v.NenninhaltL is double n) return Format(Texte.Nenninhalt, Zahl(n, "N0")) + (v.Mehrspeicher ? " · " + Texte.Mehrspeicher : "");
        if (v.Mehrspeicher) return Texte.Mehrspeicher;
        return v.BandMaxL.HasValue ? Texte.OhneListe : "–";
    }

    private string Fuellstandtext(ZapfprofilVergleichDaten v)
        => v.MinFuellstandKwh is double min && v.KapazitaetKwh is double kap && v.ReserveAnteil is double r
            ? Format(Texte.Fuellstand, Zahl(min, "N1"), Zahl(kap, "N1"), Prozent(r), v.FuellstandBezug
                     + (v.FuellstandBezugL is double l ? " " + Zahl(l, "N0") + " l" : ""))
            : "–";

    private string Status
    {
        get
        {
            if (_ergebnis is null) return "";
            if (_ergebnis.Zustand != ZapfprofilAuslegungZustand.Gerechnet) return _ergebnis.Status;
            ZapfprofilAuslegungsgruppeDaten? g = _ergebnis.Punktgruppe;
            return g is null ? Texte.StatusOhnePunkt : Format(Texte.StatusPunkt, Punkttext(g));
        }
    }

    private void StatusNachziehen()
    {
        if (_leiste is null || Status == _statusGezeigt) return;
        _statusGezeigt = Status;
        bool fehler = _ergebnis is not null && _ergebnis.Zustand == ZapfprofilAuslegungZustand.Abgebrochen;
        _leiste.Zeigen(Status, fehler);
    }

    private static string Zahl(double? wert, string format)
        => wert is double w ? w.ToString(format, CultureInfo.CurrentCulture) : "–";

    private static string Liter(double? wert) => wert is double w ? Zahl(w, "N0") + " l" : "–";

    private static string Prozent(double anteil) => (anteil * 100.0).ToString("N0", CultureInfo.CurrentCulture) + " %";

    private static string Format(string muster, params object[] werte)
    {
        try { return string.Format(CultureInfo.CurrentCulture, muster ?? "", werte); }
        catch (FormatException) { return muster ?? ""; }
    }

