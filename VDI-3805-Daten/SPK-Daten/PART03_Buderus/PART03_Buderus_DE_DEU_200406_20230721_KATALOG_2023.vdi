600;13;CHARACTER(128) FUNCTION WE_KEWIGRAD(KB,MKWT, KEWIG,STUFE_IST,STATUS);
610;1;CHARACTER(128) FUNCTION WE_KEWIGRAD(KB,KTEMP, KEW,STU_IST,STAT);
610;2;CHARACTER(20)STU_IST(4);
610;3;CHARACTER(128) FTXT;
610;4;INTEGER STAT,IX,I,I70,Ivon,Anzahl;
610;5;REAL KTEMP,KEW(4),KB,KBalt;
610;6;REAL BELAST(10),vonMKWT(10),bisMKWT(10),a0(10),a1(10),a2(10),a3(10);
610;7;LOGICAL OK,B1,B2,B3,GRENZEN;
610;8;FTXT='';
610;9;I70=VdiIndex('700');
610;10;Ivon=VdiIWert('700',I70,'730',1,4);
610;11;B1=Ivon<1;
610;12;if(B1)then;
610;13;FTxT='Keine Daten zur Berechnung des Kesselwirkungsgrades vorhanden';
610;14;else;
610;15;Anzahl=VdiIWert('700',I70,'730',1,5);
610;16;IX=0;
610;17;OK=.TRUE.;
610;18;DO WHILE (OK);
610;19;IX=IX+1;
610;20;BELAST(IX)=VDIRWERT('700',I70,'730',Ivon,5);
610;21;vonMKWT(IX)=VDIRWERT('700',I70,'730',Ivon,6);
610;22;bisMKWT(IX)=VDIRWERT('700',I70,'730',Ivon,7);
610;23;a3(IX)=VDIRWERT('700',I70,'730',Ivon,11);
610;24;a2(IX)=VDIRWERT('700',I70,'730',Ivon,10);
610;25;a1(IX)=VDIRWERT('700',I70,'730',Ivon,9);
610;26;a0(IX)=VDIRWERT('700',I70,'730',Ivon,8);
610;27;Ivon=Ivon+1;
610;28;OK=IX<Anzahl;
610;29;ENDDO;
610;30;I=1;
610;31;STAT=0;
610;32;KBalt=0;
610;33;GRENZEN=KB>0 .AND. KTEMP>15;
610;34;DO WHILE (GRENZEN);
610;35;B2=KB<=BELAST(I) .AND. KTEMP>=vonMKWT(I) .AND. KTEMP <=bisMKWT(I);
610;36;IF(B2)THEN;
610;37;B3=KBalt /= BELAST(I);
610;38;IF(B3) STAT=STAT+1;
610;39;KBalt=BELAST(I);
610;40;KEW(STAT)=a3(I)*KTEMP**3 + a2(I)*KTEMP**2 + a1(I)*KTEMP + a0(I);
610;41;STU_IST(STAT)=VDISTRING('Belastung ### %',BELAST(I));
610;42;ENDIF;
610;43;I=I+1;
610;44;GRENZEN=I <= Anzahl;
610;45;ENDDO;
610;46;OK=STAT==0;
610;47;IF(OK)FTXT='Belastung und/oder mittl. Kesselwassertemperatur ausserhalb der Grenzwerte.';
610;48;endif;
610;49;WE_KEWIGRAD=FTXT;
610;50;END FUNCTION WE_KEWIGRAD;
600;14;REAL KEWIG(4),TV,TR,KB;
