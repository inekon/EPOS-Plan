    // =====================================================================
    // INavigationsZiel - der Weg vom Kern herein
    // =====================================================================

    /// <summary>
    /// Die POSITIVLISTE der Wurzel: Führt sie das Ziel <paramref name="maske"/> als eigene
    /// Ansicht? <see cref="OeffneMaske"/> nimmt nur diese Schlüssel an, und der
    /// Katalogeinstieg der Projektliste (Kapitel 9 ZU34) zeigt nur die Katalogverwaltungen
    /// der <see cref="EPOS.UI.Bausteine.Menuetabelle"/>, deren Ziel hier steht — EINE Liste
    /// für beide.
    /// </summary>
    /// <remarks>
    /// „Führt" heißt nicht „kann zeigen": Ob die Quelle den Parametersatz liefert,
    /// entscheidet <see cref="Zeige"/> und sagt es sonst im Banner (benannte Ablehnung).
    /// </remarks>
    public static bool FuehrtZiel(string maske)
        => maske == Seitenschluessel.Energietraeger
           || maske == Seitenschluessel.BhkwWirtschaftlichkeit
           || maske == Seitenschluessel.Simulation
           || maske == Seitenschluessel.SimulationKonfiguration
           || maske == Seitenschluessel.SimulationErgebnis
           || maske == Seitenschluessel.KiAssistent
           || maske == Seitenschluessel.Assistent
           || maske == Seitenschluessel.ProjektNeu
           || maske == Seitenschluessel.ProjektBearbeiten
           || maske == Seitenschluessel.Startseite
           || maske == Seitenschluessel.BerichteKosten
           || maske == Seitenschluessel.StromspeicherAuslegung
           || maske == Seitenschluessel.Projektliste

           // Die fuenf Masken aus KI-D-Q8. „Bekannt" heisst hier nur „die
           // Wurzel fuehrt den Schluessel" - ob sie ihn ZEIGEN kann,
           // entscheidet Zeige() an der Quelle und sagt es sonst im Banner.
           || maske == Seitenschluessel.Klimadaten
           || maske == Seitenschluessel.ProjektAlsVariante
           || maske == Seitenschluessel.ProjektSpeichernUnter
           || maske == Seitenschluessel.PeakShaving
           || maske == Seitenschluessel.StromganglinieAdmin

           // Die drei Masken der Wirtschaftlichkeit (E3/8, A19). Die
           // vier uebrigen Stuecke dieses Feldes - Parameter, PV-
           // Verguetung, Tarifstruktur und Kapitalwert-Verlauf - haben
           // keinen eigenen Schluessel: Sie sind Ueberlagerungen der
           // Wirtschaftlichkeitsseite und damit ueber BERICHTE_KOSTEN
           // zu erreichen.
           || maske == Seitenschluessel.Kostenverwaltung
           || maske == Seitenschluessel.NutzungsdauerVerwaltung
           || maske == Seitenschluessel.Gesetzeskatalog

           // Die zwei Kataloge der Gebaeudesimulation (G3) - Menue und
           // Assistent (dialog_oeffnen) erreichen sie auf beiden Plattformen.
           || maske == Seitenschluessel.BaustoffKatalog
           || maske == Seitenschluessel.BauteilaufbauKatalog

           // Der Katalog der BRAUCHWASSER-NUTZUNGSARTEN (Anwenderentscheid
           // ZU26) - der einzige Katalog, der auf iOS aufgeht. Unter Windows
           // faengt die Schale den Schluessel vorher ab und oeffnet ihr
           // Fenster; hier landet er auf dem iPad und aus dem
           // Hilfe-Assistenten (KiMaskenziele.BRAUCHWASSER_NUTZUNGSARTEN).
           || maske == Seitenschluessel.BrauchwasserNutzungsarten;

    /// <inheritdoc />
    public bool OeffneMaske(string maske, params object[] argumente)
    {
        // Der Kern ruft moeglicherweise von einem Hintergrundfaden; gezeichnet
        // wird ausschliesslich auf dem Renderfaden.
        bool bekannt = FuehrtZiel(maske);

        if (!bekannt) return false;

        // Der Assistent nimmt seine Betriebsart als Argument entgegen - so ruft ihn
        // der Kern seit jeher (Dienste.Navigation.OeffneMaske(Masken.Assistent, 0|1)).
        int? betriebsart = Betriebsart(maske, argumente);

        // Der HILFE-ASSISTENT nimmt seinen Aufrufkontext als Argument (Auftrag #199).
        // KiAssistentWeg meldet ihn im Kern, bevor er hier ankommt; gemeldet wird er
        // hier trotzdem, damit die Wurzel auch einen Aufruf traegt, der den Helfer
        // nicht benutzt hat.
        if (maske == Seitenschluessel.KiAssistent
            && argumente is { Length: > 0 }
            && argumente[0] is WindowsFormsApplication1.KiAufrufkontext kontext)
            WindowsFormsApplication1.KiChatKontext.AufrufMelden(kontext);

        // Die SIMULATION nimmt ihre MARKE als Argument entgegen (Auftrag #207) -
        // „schritt=1" vom Knopf der Startseite, „schritt=3" von ihrer Kachel,
        // „schritt=3;blatt=STROMSPEICHER" aus dem Rueckwegstapel.
        string marke = Marke(maske, argumente);

        // DER REITER der Startseite und das BLATT der Berichtsansicht (Anwenderentscheid
        // KI-D-Q8, 21.09.2026): Beide Ziele fuehren MEHRERE Masken des Dialogkatalogs -
        // die sechs Erzeugermasken stehen auf dem Reiter „Energieerzeuger", die
        // Kostenseite auf dem Blatt KOSTEN. Welcher Platz gemeint ist, sagt der Kern als
        // Zeichenkette (KiMaskenziele.ARGUMENTE); ohne Argument entscheidet die Ansicht
        // selbst. Gesetzt wird auf dem RENDERFADEN und vor Zeige - genau dort verbraucht
        // der Startseiten-Zweig schon den Reiterwunsch des Rueckwegs.
        string platz = Textargument(maske, argumente);

        _ = InvokeAsync(() =>
        {
            if (maske == Seitenschluessel.Startseite) _reiterwunschOffen = platz;
            else if (maske == Seitenschluessel.BerichteKosten) _blattwunschOffen = platz;

            Zeige(maske, betriebsart, marke);
            StateHasChanged();
        });
        return true;
    }

    /// <summary>
    /// Das TEXTARGUMENT aus dem ersten Argument — der Reiter der Startseite
    /// (<c>"ERZEUGER"</c>) und das Blatt der Berichtsansicht (<c>"KOSTEN"</c>);
    /// leer, wenn keines mitkam.
    /// </summary>
    /// <remarks>
    /// Wie <see cref="Marke"/> JE ZIEL geprüft: Ein Text, der an einem anderen
    /// Schlüssel hängt, gehört nicht hierher — der Assistent reicht an derselben
    /// Stelle seine Betriebsart und der Hilfe-Assistent seinen Aufrufkontext.
    /// </remarks>
    private static string Textargument(string maske, object[] argumente)
    {
        if (maske != Seitenschluessel.Startseite
            && maske != Seitenschluessel.BerichteKosten) return "";

        if (argumente is null || argumente.Length == 0) return "";
        return argumente[0] as string ?? "";
    }

    /// <summary>
    /// Die MARKE aus dem ersten Argument — nur für die Simulationsansicht und nur,
    /// wenn ein Text darin steht.
    /// </summary>
    private static string Marke(string maske, object[] argumente)
    {
        if (maske != Seitenschluessel.Simulation
            && maske != Seitenschluessel.SimulationKonfiguration
            && maske != Seitenschluessel.SimulationErgebnis) return "";

        if (argumente is null || argumente.Length == 0) return "";
        return argumente[0] as string ?? "";
    }

    /// <summary>
    /// Die Betriebsart aus dem ersten Argument — nur für den Assistenten und nur,
    /// wenn eine ganze Zahl darin steht.
    /// </summary>
    private static int? Betriebsart(string maske, object[] argumente)
    {
        if (maske != Seitenschluessel.Assistent) return null;
        if (argumente is null || argumente.Length == 0 || argumente[0] is null) return null;

        try { return Convert.ToInt32(argumente[0]); } catch (Exception) { return null; }
    }

    /// <inheritdoc />
    public void Auffrischen()
    {
        _ = InvokeAsync(() =>
        {
            Laden();
            StateHasChanged();
        });
    }

