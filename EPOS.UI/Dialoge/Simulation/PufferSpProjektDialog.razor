    /// <summary>
    /// <c>AnzeigenAktualisieren</c>:1360-1365 — Kapazität, Ladereihenfolge und
    /// Entladeposition.
    /// </summary>
    private void AnzeigenAktualisieren()
    {
        QmaxAnzeigen();

        _laden = _bearbeiteteId > 0 && Dienste is not null
            ? Dienste.Ladereihenfolge(_bearbeiteteId)
            : Array.Empty<PspLadezeile>();

        if (_laden.Count == 0)
            _laden = new[]
            {
                new PspLadezeile("", _bearbeiteteId <= 0 ? LadenNochNichtAngelegt : LadenKeineAnlage,
                                 "", "", "", "")
            };

        _automatik = _bearbeiteteId > 0 && Dienste is not null
            ? Dienste.Automatiktext(_bearbeiteteId) : "";
        _entladeposition = _bearbeiteteId > 0 && Dienste is not null
            ? Dienste.Entladeposition(_bearbeiteteId, Hat(0), Hat(1), Hat(2)) : "";
    }

    /// <summary>
    /// <c>QmaxAnzeigen</c>:1368-1382 — leer, sobald Volumen ≤ 0 oder Vorlauf ≤ Rücklauf.
    /// </summary>
    private void QmaxAnzeigen()
    {
        int v = _volumen ?? 0;
        int vl = _vorlauf ?? 0;
        int rl = _ruecklauf ?? 0;

        if (Dienste is null || v <= 0 || vl <= rl) { _qmax = ""; return; }

        _qmax = string.Format(AnzeigeQmax,
            Dienste.Kapazitaet(v, vl - rl)
                   .ToString("0.0", System.Globalization.CultureInfo.CurrentCulture));
    }

    // --- Übernehmen -------------------------------------------------------------

    /// <summary>
    /// <c>btnUebernehmen_Click</c>:1605-1684 — Prüfkette, dann Kriterium W6 (hart),
    /// dann Anlegen oder Ändern, dann Kriterium W4 (weich, NACH dem Speichern).
    /// </summary>
    private Task Uebernehmen()
    {
        if (Dienste is null) return Task.CompletedTask;

        PspEingaben? eingaben = EingabenLesen(out string? fehler);
        if (eingaben is null)
        {
            Melden(fehler ?? "", WarnStufe.Warnung);
            return Task.CompletedTask;
        }

        // KRITERIUM W6 - HART, ABGEWIESEN (Konzept 6.2/6.3, Entscheidung F8).
        if (eingaben.Schicht.Schichten > 1 && _bearbeiteteId > 0 &&
            Dienste.IstLeitspeicher(_bearbeiteteId))
        {
            Melden(string.Format(FehlerSchichtungAmVerbund, eingaben.Bezeichner), WarnStufe.Fehler);
            return Task.CompletedTask;
        }

        if (_bearbeiteteId > 0 && WechselBraucthRueckfrage(eingaben, out string frage))
        {
            _wartendeEingaben = eingaben;
            _fragetext = frage;
            _fragetitel = TitelKlassenSetAendern;
            _frage = Frageart.Klassenset;
            return Task.CompletedTask;
        }

        Speichern(eingaben);
        return Task.CompletedTask;
    }

    /// <summary>
    /// Kriterium W10‑B32: Der Nutzungswechsel an einem REFERENZIERTEN Speicher wird
    /// zurückgefragt. Verglichen werden die drei Flags, nicht der abgeleitete Altwert —
    /// ein Wechsel von {H} auf {H, P} ändert diesen nämlich nicht.
    /// </summary>
    private bool WechselBraucthRueckfrage(PspEingaben neu, out string frage)
    {
        frage = "";
        if (Dienste is null) return false;

        PspPufferstand? alt = Dienste.PufferLesen(_bearbeiteteId);
        if (alt is null) return false;
        if (alt.Heizung == neu.Heizung && alt.Brauchwasser == neu.Brauchwasser &&
            alt.Prozess == neu.Prozess) return false;

        IReadOnlyList<string> referenzen = Dienste.Referenzen(_bearbeiteteId);
        if (referenzen.Count == 0) return false;

        frage = string.Format(MeldungKlassensetwechsel,
            alt.Bezeichner,
            Dienste.KlassenSetAnzeige(alt.Heizung, alt.Brauchwasser, alt.Prozess),
            Dienste.KlassenSetAnzeige(neu.Heizung, neu.Brauchwasser, neu.Prozess),
            string.Join("\n  • ", referenzen));
        return true;
    }

    private void Speichern(PspEingaben eingaben)
    {
        if (Dienste is null) return;

        if (_bearbeiteteId <= 0)
        {
            int neueId = Dienste.Anlegen(eingaben);
            if (neueId <= 0) { Melden(MeldungAnlegenFehlgeschlagen, WarnStufe.Warnung); return; }

            _idPuffer = neueId;
            _bearbeiteteId = neueId;
            Melden(StatusAngelegt, WarnStufe.Erfolg);
        }
        else
        {
            if (!Dienste.Aendern(_bearbeiteteId, eingaben))
            { Melden(MeldungAendernFehlgeschlagen, WarnStufe.Warnung); return; }

            _idPuffer = _bearbeiteteId;
            Melden(StatusAenderungenUebernommen, WarnStufe.Erfolg);
        }

        BestandNeuLaden(_idPuffer);

        // KRITERIUM W4 - WEICH, NACH dem Speichern (Konzept 7.2). Die Angabe ist
        // zulaessig und wurde gespeichert; der Anwender erfaehrt nur, was der Lauf
        // damit macht.
        string? klemm = Dienste.Klemmhinweis(_idPuffer, eingaben);
        if (!string.IsNullOrEmpty(klemm)) Melden(klemm, WarnStufe.Warnung);
    }

    private void BestandNeuLaden(int auswahlId)
    {
        if (Dienste is null) return;
        _projekt = Dienste.Projektliste();

        if (auswahlId > 0 && _projekt.Any(z => z.Id == auswahlId)) PufferWaehlen(auswahlId);
        else NeuVorbereiten();
    }

    // --- Entfernen --------------------------------------------------------------

    private void EntfernenStarten()
    {
        if (Dienste is null || _bearbeiteteId <= 0) return;

        IReadOnlyList<string> referenzen = Dienste.Referenzen(_bearbeiteteId);
        if (referenzen.Count > 0)
        {
            Melden(string.Format(MeldungEntfernenBlockiert, _bezeichner,
                                 string.Join("\n  • ", referenzen)), WarnStufe.Warnung);
            return;
        }

        _fragetext = string.Format(MeldungEntfernenBestaetigen, _bezeichner);
        _fragetitel = TitelPufferEntfernen;
        _frage = Frageart.Entfernen;
    }

    private void Beantwortet(bool? ja)
    {
        Frageart was = _frage;
        _frage = Frageart.Keine;

        if (ja != true) { _wartendeEingaben = null; return; }

        if (was == Frageart.Klassenset)
        {
            PspEingaben? e = _wartendeEingaben;
            _wartendeEingaben = null;
            if (e is not null) Speichern(e);
            return;
        }

        if (was == Frageart.Entfernen && Dienste is not null)
        {
            if (!Dienste.Entfernen(_bearbeiteteId))
            { Melden(MeldungEntfernenFehlgeschlagen, WarnStufe.Warnung); return; }

            if (_idPuffer == _bearbeiteteId) _idPuffer = 0;
            Melden(StatusEntfernt, WarnStufe.Erfolg);
            BestandNeuLaden(0);
        }
    }

    // --- Katalog ----------------------------------------------------------------

    /// <summary>Der Parametersatz des offenen Katalogs; <c>null</c> = zu.</summary>
    private IReadOnlyDictionary<string, object>? _verwaltungGaben;

    /// <summary>Steht der Auslieferungskatalog? (Prüfhilfe für Tests.)</summary>
    public bool VerwaltungOffen => _verwaltungGaben is not null;

    private Task KatalogAnsehen()
    {
        if (VerwaltungGaben is null) return Task.CompletedTask;
        _verwaltungGaben = VerwaltungGaben();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Nach der Rueckkehr den Katalog neu lesen - der Anwender kann dort etwas
    /// geaendert haben (btnKatalog_Click:1593-1603).
    /// </summary>
    private void VerwaltungFertig(EPOS.UI.Dialoge.Erzeuger.BrowserErgebnis? ergebnis)
    {
        _verwaltungGaben = null;
        if (Dienste is not null) _katalog = Dienste.Katalogzeilen();
    }

    // --- Prüfkette --------------------------------------------------------------

    /// <summary>
    /// <c>EingabenLesen</c>:1914-2037 — die zwölf Regeln in derselben Reihenfolge.
    /// <c>null</c> heißt „Fehler"; der Grund steht in <paramref name="fehler"/>.
    /// </summary>
    private PspEingaben? EingabenLesen(out string? fehler)
    {
        fehler = null;

        string bezeichner = (_bezeichner ?? "").Trim();
        if (bezeichner.Length == 0) { fehler = FehlerBezeichnerFehlt; return null; }

        bool h = Hat(0), b = Hat(1), p = Hat(2);
        if (!h && !b && !p) { fehler = FehlerKlassenSetLeer; return null; }

        if (_volumen is null || _volumen.Value <= 0) { fehler = FehlerVolumen; return null; }

        double verluste = _verluste ?? 0;
        if (verluste < 0) { fehler = FehlerVerluste; return null; }

        // Temperaturen: das leere PAAR ist erlaubt (dann greift der Engine-Rueckfall),
        // ein vollstaendiges laeuft durch die gemeinsame Pruefung des Kerns.
        int? vorlauf = null, ruecklauf = null;
        if (_vorlauf is not null || _ruecklauf is not null)
        {
            string vt = Zahltext(_vorlauf);
            string rt = Zahltext(_ruecklauf);
            fehler = Dienste?.TemperaturenPruefen(vt, rt);
            if (!string.IsNullOrEmpty(fehler)) return null;
            fehler = null;
            vorlauf = _vorlauf;
            ruecklauf = _ruecklauf;
        }

        if (!SchwelleLesen(_schwelleEin, NameEinschaltschwelle, false, out double ein, out fehler))
            return null;
        if (!SchwelleLesen(_schwelleAus, NameAbschaltschwelle, false, out double aus, out fehler))
            return null;
        if (!SchwelleLesen(_schwelleNachrang, NameAbschaltschwelleNachrang, false,
                           out double nachrang, out fehler)) return null;

        if (ein >= aus) { fehler = FehlerEinKleinerAus; return null; }
        if (nachrang > aus) { fehler = FehlerNachrangUeberAus; return null; }
        if (nachrang <= ein) { fehler = FehlerNachrangUnterEin; return null; }

        // Der Mindestfuellstand darf ausdruecklich 0 sein - "dieser Speicher darf
        // leergefahren werden".
        if (!SchwelleLesen(_schwelleReserve, NameMindestfuellstand, true,
                           out double reserve, out fehler)) return null;
        if (reserve >= aus) { fehler = FehlerReserveUeberAus; return null; }

        // Schichtung ZULETZT - ihre Felder stehen in der Maske unter allen anderen.
        PspSchichtdaten? schicht = SchichtdatenLesen(out fehler);
        if (schicht is null) return null;

        return new PspEingaben(bezeichner, _volumen.Value, verluste, vorlauf, ruecklauf,
                               ein, aus, nachrang, reserve, _entladeprio ?? 0,
                               h, b, p, schicht, _katalogzeile ?? -1);
    }

    private static string Zahltext(int? wert)
        => wert is null ? "" : wert.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>
    /// <c>SchwelleLesen</c>:2044-2065 — Bereich 0…100, wobei die 0 nur mit
    /// <paramref name="nullErlaubt"/> durchgeht.
    /// </summary>
    private bool SchwelleLesen(double? feld, string name, bool nullErlaubt,
                               out double wert, out string? fehler)
    {
        wert = 0;
        fehler = null;

        if (feld is null) { fehler = string.Format(FehlerSchwelleZahl, name); return false; }

        double f = feld.Value;
        if (f < 0 || (f == 0 && !nullErlaubt) || f > 100)
        { fehler = string.Format(FehlerSchwelleBereich, name); return false; }

        wert = f;
        return true;
    }

    /// <summary>
    /// <c>SchichtdatenLesen</c>:981-1020 — LEER ist überall zulässig und bedeutet
    /// „Vorbelegung"; geprüft wird nur, was dasteht. Die Trennung „0 ist gültig" gegen
    /// „0 ist Unsinn" ist wörtlich übernommen.
    /// </summary>
    private PspSchichtdaten? SchichtdatenLesen(out string? fehler)
    {
        fehler = null;

        if (!ZahlOderLeer(_hoehe, FehlerHoehe, 0, double.MaxValue, false, out double? hoehe, out fehler))
            return null;
        if (!ZahlOderLeer(_lambda, FehlerLambdaEff, 0, double.MaxValue, false, out double? lambda, out fehler))
            return null;
        if (!ZahlOderLeer(_tNutzBW, FehlerTNutzBW, 0, double.MaxValue, false, out double? tNutz, out fehler))
            return null;

        if (!ZahlOderLeer(_entnahmeHeizung, string.Format(FehlerEntnahmehoehe, NutzungHeizung),
                          0, 1, true, out double? eH, out fehler)) return null;
        if (!ZahlOderLeer(_entnahmeBW, string.Format(FehlerEntnahmehoehe, NutzungBrauchwasser),
                          0, 1, true, out double? eB, out fehler)) return null;
        if (!ZahlOderLeer(_entnahmeProzess, string.Format(FehlerEntnahmehoehe, NutzungProzess),
                          0, 1, true, out double? eP, out fehler)) return null;

        if (!ZahlOderLeer(_ladeleistung, string.Format(FehlerLeistung, NameLadeleistungMax),
                          0, double.MaxValue, true, out double? lade, out fehler)) return null;
        if (!ZahlOderLeer(_entladeleistung, string.Format(FehlerLeistung, NameEntladeleistungMax),
                          0, double.MaxValue, true, out double? entlade, out fehler)) return null;

        return new PspSchichtdaten(_schichten ?? 1, hoehe, lambda, tNutz, eH, eB, eP,
                                   lade ?? 0, entlade ?? 0);
    }

    private static bool ZahlOderLeer(double? feld, string fehlertext, double min, double max,
                                     bool nullErlaubt, out double? wert, out string? fehler)
    {
        wert = null;
        fehler = null;

        if (feld is null) return true;                     // leer bleibt leer

        double f = feld.Value;
        if (f < min || f > max || (f == 0 && !nullErlaubt)) { fehler = fehlertext; return false; }

        wert = f;
        return true;
    }

    // --- Schluss ----------------------------------------------------------------

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text;
        _meldungStufe = stufe;
    }

    private Task Schliessen() => Geschlossen.InvokeAsync(_idPuffer);

    /// <summary>
    /// Esc: erst eine stehende Rückfrage, dann der Dialog. Zurückgenommen wird nichts
    /// (Befund W10‑B29) — der Dialog hat sein Werk längst geschrieben.
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_frage != Frageart.Keine) { _frage = Frageart.Keine; _wartendeEingaben = null; return Task.CompletedTask; }
        return Schliessen();
    }
