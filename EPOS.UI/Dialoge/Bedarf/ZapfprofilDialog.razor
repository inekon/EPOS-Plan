    private IReadOnlyList<(int Id, string Text)> Kalenderwahl(ZapfprofilNutzungsartDaten? art, ZapfprofilZonenangabenDaten a)
    {
        var liste = new List<(int Id, string Text)> { (KALENDER_NUTZUNGSART, Format(Texte.KalenderNutzungsart, art?.Kalender ?? "")) };
        liste.AddRange(Daten.Gebaeude.Select(g => (g.Id, Format(Texte.KalenderGebaeude, g.Name))));
        if (a.IdGebaeude is int id && liste.All(e => e.Id != id))
            liste.Add((id, Format(Texte.KalenderGebaeude, "#" + id.ToString(CultureInfo.InvariantCulture))));
        return liste;
