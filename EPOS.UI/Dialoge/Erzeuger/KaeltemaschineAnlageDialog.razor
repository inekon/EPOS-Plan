    public Bereichswahl ProjektWahl => _projektWahl;
    /// <summary>Die Mehrfachwahl des Katalogs (Prüfhilfe).</summary>
    public Bereichswahl KatalogWahl => _katalogWahl;
    /// <summary>Die Anlagen-Ids, die in dieser Sitzung angelegt wurden (Prüfhilfe).</summary>
    public IReadOnlyList<int> Angelegte => _zeilen.Where(z => z.Neu && z.Arbeit.AnlagenId > 0).Select(z => z.Arbeit.AnlagenId).ToList();
