@* Verwaltung Heizkessel - der PROJEKTDIALOG (iU9-W6.3).

   VORBILD. Views/Heizkessel/Form_Heizkessel (767 Z., lokalisiert de/en, 24
   Kartenzeilen, 8 MessageBox). Links "ausgewaehlt im Projekt", rechts "Kessel
   aus Datenbank", dazwischen ◀ und ▶, unten der Detailblock.

   DER DIALOG SCHREIBT BEIM OK NICHTS. Der Aufrufer loescht danach die
   Tab_Energieanlagen dieses Typs und schreibt die Liste neu
   (WizardCtrl.Del_Projekt_Waermeerzeuger + Add_WP_Waermeerzeuger); im
   Assistenten geschieht das erst beim Speichern des Projekts. SOFORTIGE
   Nebenwirkungen gibt es dennoch - CopyFromStamm/DeleteFromProjekt beim ◀/▶,
   das Anlegen der Traegervariante und das Umhaengen des Traegers. Sie stehen
   alle in der Huelle bzw. im Kern; die Komponente ruft nur Delegaten.

   MEHRERE ZEILEN DUERFEN DENSELBEN KESSEL FUEHREN. Sie teilen sich EINE
   Tab_Heizkessel-Kopie: Deshalb entfernt ▶ die Projektkopie nur, wenn keine
   zweite Zeile mehr auf dieselbe GeraetId verweist. Die Pruefung macht die
   Huelle auf der geteilten Liste; die Komponente reicht die Zeile hinaus.

   DIE TRAEGERWAHL STEHT VOR DEM HINZUFUEGEN. Bricht der Anwender sie ab oder
   schlaegt das Anlegen fehl, wird KEIN Kessel aufgenommen - sonst bliebe ein
   Eintrag mit ID_Carrier = 0 und eine Projektkopie zurueck (Punkt 2 des
   Bestands). Der Unterdialog erscheint in einer Ueberlagerung, nicht in einem
   zweiten Fenster (Risiko R2).

   ASSISTENTENBETRIEB (Wizard = true): keine OK/Abbrechen-Leiste und keine
   Kostenleiste - genau die Sichtbarkeiten von SetControls(…, bWizard: true).

   TASTATUR. Wurzel-div mit tabindex="-1", Erstfokus dort, Esc schliesst
   (zuerst eine offene Ueberlagerung). Enter ist nicht belegt: ◀, ▶,
   "Loeschen" und die Traegerwahl schreiben sofort.

   ENTSCHEID #76 (05.09.2026). Die zwei Listen und die Pfeilspalte stehen im
   Baustein Zweispaltenauswahl - EIN Aufbau fuer alle Projekt/Datenbank-Dialoge
   des Hauses. Nebeneinander wie im BHKW-PLAN, auf schmalem Schirm untereinander;
   die Knoepfe tragen seither Klartext, das Zeichen setzt der Baustein je nach
   Anordnung (◀▶ nebeneinander, ▲▼ untereinander). *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Kosten

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
    </div>

    <p class="epos-kontextzeile">@KopfbandText</p>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    <Zweispaltenauswahl LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                        UebernehmenText="@LabelHinzu"
                        UebernehmenGesperrt="@(_katalogZeile is null)" Uebernehmen="BeiHinzu"
                        EntfernenText="@LabelEntfernen"
                        EntfernenGesperrt="@(_projektZeile is null)" Entfernen="BeiEntfernen">

        <Links>
            <Raster TZeile="ErzeugerZeile" Zeilen="@Zeilen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="ErzeugerZeile" Title="@SpalteWahl">
                        <Zeilenwahl Gewaehlt="@(_projektZeile == context)" Kurztext="@SpalteWahl"
                                    Gewaehltwerden="() => ProjektZeileWaehlen(context)" />
                    </TemplateColumn>
                    <PropertyColumn TGridItem="ErzeugerZeile" TProp="string"
                                    Property="@(z => z.Bezeichner)" Title="@LabelProjektliste" />
                </KindInhalt>
            </Raster>
        </Links>

        <Rechts>
            <Auswahlfeld Bezeichnung="@LabelFilterBrennstoff" Eintraege="@_gruppenEintraege"
                         Auswahl="@_gruppe" AuswahlChanged="BeiGruppe" />
            <Auswahlfeld Bezeichnung="@LabelFilterLeistung" Eintraege="@_stufenEintraege"
                         Auswahl="@_stufe" AuswahlChanged="BeiStufe" />

            <Raster TZeile="KatalogZeile" Zeilen="@_katalog.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="KatalogZeile" Title="@SpalteWahl">
                        <Zeilenwahl Gewaehlt="@(_katalogZeile == context)" Kurztext="@SpalteWahl"
                                    Gewaehltwerden="() => KatalogZeileWaehlen(context)" />
                    </TemplateColumn>
                    <PropertyColumn TGridItem="KatalogZeile" TProp="string"
                                    Property="@(z => z.Bezeichner)" Title="@LabelKatalogliste" />
                </KindInhalt>
            </Raster>

            <div class="epos-leiste">
                <button type="button" class="epos-knopf" disabled="@(_katalogZeile is null)"
                        @onclick="BeiKatalogBearbeiten">@BtnBearbeitenText</button>
                <button type="button" class="epos-knopf" disabled="@(_katalogZeile is null)"
                        @onclick="() => _loeschfrage = true">@BtnLoeschenText</button>
                @if (VerwaltungGaben is not null)
                {
                    <button type="button" class="epos-knopf" @onclick="BeiAdmin">@BtnAdminText</button>
                }
            </div>
        </Rechts>

    </Zweispaltenauswahl>

    @* --- Detailblock ------------------------------------------------------- *@
    <Gruppenkopf Titel="@GruppeModul">
        <KindInhalt>
        @* Formularraster (iU8-E-2 / W14a-E-7): Beschriftung neben dem Feld,
           Zahlenfelder kurz mit der Einheit dahinter. Der Detailblock stand
           zuvor als eine Spalte voller Felder ueber die ganze Breite. *@
        <Formularraster>
            <KindInhalt>
            <Textfeld Bezeichnung="@LabelName" Wert="@_detail.Bezeichner" NurLesen="true" />
            @foreach (var feld in _detail.Felder)
            {
                @* Eine Zahl bekommt die kurze Feldbreite (iU8-E-2, Paket P1). *@
                <Textfeld Bezeichnung="@feld.Feld" Wert="@feld.Wert" NurLesen="true"
                          Kurz="@ErzeugerDetail.IstZahl(feld.Wert)" />
            }
            <Textfeld Bezeichnung="@LabelBeschreibung" Wert="@_detail.Beschreibung"
                      NurLesen="true" Mehrzeilig="true" Zeilen="2" />
            @if (_detail.Schalter is not null)
            {
                <Schalter Bezeichnung="@_detail.Schalter.Value.Feld"
                          Wert="@_detail.Schalter.Value.Wert" Aktiv="false" />
            }

            @* Die Traegerwahl gilt nur fuer eine PROJEKTzeile - beim Katalogsatz war
               sie im Bestand unsichtbar (listBox_Kessel_DB_SelectedIndexChanged). *@
            @if (_projektZeile is not null)
            {
                <Auswahlfeld Bezeichnung="@LabelTraeger" Eintraege="@_varianten"
                             Auswahl="@(_projektZeile.CarrierId > 0 ? _projektZeile.CarrierId : null)"
                             AuswahlChanged="BeiTraegerwechsel" />
                @* Das Feldpaar von Hand entfaellt - der Raster stellt zwei
                   Feldpaare je Zeile (iU8-E-2 / W14a-E-7). *@
                <Ganzzahlfeld Bezeichnung="@LabelVorlauf" Einheit="°C"
                              Wert="@_projektZeile.Vorlauf" WertChanged="BeiVorlauf" />
                <Ganzzahlfeld Bezeichnung="@LabelRuecklauf" Einheit="°C"
                              Wert="@_projektZeile.Ruecklauf" WertChanged="BeiRuecklauf" />
            }
            </KindInhalt>
        </Formularraster>
        </KindInhalt>
    </Gruppenkopf>

    @if (!Wizard)
    {
        <KostenKnoepfeLeiste KostenOeffnen="@KostenOeffnen" EnergiekostenOeffnen="@EnergiekostenOeffnen"
                             InvestText="@KostenInvestText" BetriebText="@KostenBetriebText"
                             EnergieText="@KostenEnergieText" />

        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }

    @* --- Ueberlagerung 1: die Traegerwahl vor dem Hinzufuegen ---------------- *@
    <Ueberlagerung Offen="@(_traegerGaben is not null)" Schliessbar="false"
                   Titel="@TraegerTitel" Geschlossen="() => TraegerFertig(null)">
        <KindInhalt>
            @if (_traegerGaben is not null)
            {
                <EnergietraegerVarianteDialog @attributes="_traegerGaben" Geschlossen="TraegerFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 2: der Katalogeditor ---------------------------------- *@
    <Ueberlagerung Offen="@(_editorGaben is not null)" Schliessbar="false"
                   Titel="@EditorTitel" Geschlossen="() => EditorFertig(null)">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                <HeizkesselKatalogDialog @attributes="_editorGaben" Geschlossen="EditorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung: die Katalogverwaltung (iU9-W14a.4) ------------------- *@
    @* Der Knopf "Verwaltung" oeffnete bis hierher Form_Heizkessel_Admin ueber die Sprungbruecke; das Ziel ist jetzt selbst Blazor. *@
    <Ueberlagerung Offen="@(_verwaltungGaben is not null)" Schliessbar="false"
                   Titel="" Geschlossen="() => VerwaltungFertig(null)">
        <KindInhalt>
            @if (_verwaltungGaben is not null)
            {
                <KatalogBrowserDialog @attributes="_verwaltungGaben" Geschlossen="VerwaltungFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Rueckfrage vor dem Loeschen aus dem KATALOG ------------------------- *@
    <Rueckfrage Offen="@_loeschfrage" TitelText="@TitelLoeschen" JaText="@JaText" NeinText="@NeinText"
                Frage="@(string.Format(FrageLoeschen, _katalogZeile?.Bezeichner ?? ""))"
                Beantwortet="BeiLoeschfrage" />
</div>

@code {
    /// <summary>
    /// Die Zeilen der linken Liste. Die Liste wird AN ORT UND STELLE bearbeitet: Sie
    /// gehoert der Huelle, die sie mit der geteilten <c>List&lt;WErzeugerModel&gt;</c>
    /// des Aufrufers gleichhaelt.
    /// </summary>
    [Parameter] public List<ErzeugerZeile> Zeilen { get; set; } = new();

    /// <summary>Die Brennstoffgruppen des Filters, „Alle" voran (Index 0).</summary>
    [Parameter] public IReadOnlyList<string> Gruppen { get; set; } = Array.Empty<string>();

    /// <summary>Die Leistungsstufen des Filters, „Alle" voran (Index 0).</summary>
    [Parameter] public IReadOnlyList<string> Leistungsstufen { get; set; } = Array.Empty<string>();

    /// <summary>Die Katalogliste zu Gruppe und Stufe (<c>HeizkesselStammCtrl.Filtern</c>).</summary>
    [Parameter] public Func<string, int, IReadOnlyList<KatalogZeile>>? Filtern { get; set; }

    /// <summary>Der Detailblock zu einem KATALOGsatz.</summary>
    [Parameter] public Func<string, ErzeugerDetail?>? KatalogDetail { get; set; }

    /// <summary>Der Detailblock zu einer PROJEKTzeile (über ihre <c>GeraetId</c>).</summary>
    [Parameter] public Func<int, ErzeugerDetail?>? ProjektDetail { get; set; }

    /// <summary>Die Trägervarianten der Gruppe eines Trägers (<c>VariantenDerGruppe</c>).</summary>
    [Parameter] public Func<int, IReadOnlyList<(int Id, string Text)>>? Varianten { get; set; }

    /// <summary>
    /// Was der Kern beisteuert, bevor der Trägerdialog erscheint — Stammwerte und
    /// Auswahlliste. Eine nicht leere Meldung bricht ab.
    /// </summary>
    [Parameter] public Func<int, TraegerVorbereitung>? Vorbereiten { get; set; }

    /// <summary>
    /// Nimmt die Zeile auf: Träger anlegen, Projektkopie ziehen, Modell in die geteilte
    /// Liste. Der zweite Parameter ist das Ergebnis des Trägerdialogs.
    /// </summary>
    [Parameter] public Func<int, EnergietraegerVarianteErgebnis, AufnahmeErgebnis>? Aufnehmen { get; set; }

    /// <summary>Entfernt die Zeile aus der geteilten Liste (und ggf. die Projektkopie).</summary>
    [Parameter] public Action<ErzeugerZeile>? Entfernen { get; set; }

    /// <summary>Hängt die Projektzuordnung auf einen anderen Träger um — SCHREIBT SOFORT.</summary>
    [Parameter] public Action<ErzeugerZeile, int>? TraegerWechseln { get; set; }

    /// <summary>Übernimmt geänderte Zeilenwerte (Vorlauf/Rücklauf) ins Modell.</summary>
    [Parameter] public Action<ErzeugerZeile>? Uebernehmen { get; set; }

    /// <summary>Der Parametersatz des Katalogeditors zu einem Namen; <c>null</c> = kein Knopf.</summary>
    [Parameter] public Func<string, IReadOnlyDictionary<string, object>>? EditorGaben { get; set; }

    /// <summary>Der Parametersatz des Trägerdialogs; die Hülle baut ihn aus der Vorbereitung.</summary>
    [Parameter] public Func<TraegerVorbereitung, IReadOnlyDictionary<string, object>>? TraegerGaben { get; set; }

    /// <summary>Löscht einen KATALOGsatz; <c>true</c> = gelöscht.</summary>
    [Parameter] public Func<int, bool>? KatalogLoeschen { get; set; }

    /// <summary>
    /// Der Parametersatz der KATALOGVERWALTUNG. Sie erscheint seit iU9-W14a als
    /// <c>Ueberlagerung</c> im selben Fenster statt als zweites Fenster über die
    /// Sprungbrücke (Risiko R2) — ihr Ziel ist jetzt selbst Blazor. Ohne Delegat
    /// kein Knopf.
    /// </summary>
    [Parameter] public Func<IReadOnlyDictionary<string, object>>? VerwaltungGaben { get; set; }

    /// <summary>Assistentenbetrieb: keine OK/Abbrechen- und keine Kostenleiste.</summary>
    [Parameter] public bool Wizard { get; set; }

    /// <summary><c>true</c> = OK, <c>false</c> = Abbrechen. Geschlossen wird von der Hülle.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // --- Kostenleiste ----------------------------------------------------------

    [Parameter] public Func<bool, Task>? KostenOeffnen { get; set; }
    [Parameter] public Func<Task>? EnergiekostenOeffnen { get; set; }
    [Parameter] public string KostenInvestText { get; set; } = "Investitionskosten…";
    [Parameter] public string KostenBetriebText { get; set; } = "Betriebskosten…";
    [Parameter] public string KostenEnergieText { get; set; } = "Energiekosten…";

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Verwaltung Heizkessel";
    [Parameter] public string KopfbandText { get; set; } = "Geben Sie Daten des Spitzenlastkessels ein";
    [Parameter] public string LabelProjektliste { get; set; } = "ausgewählt im Projekt";
    [Parameter] public string LabelKatalogliste { get; set; } = "Kessel aus Datenbank";
    [Parameter] public string SpalteWahl { get; set; } = "Wahl";
    [Parameter] public string LabelHinzu { get; set; } = "In das Projekt übernehmen";
    [Parameter] public string LabelEntfernen { get; set; } = "Aus dem Projekt entfernen";
    [Parameter] public string LabelFilterBrennstoff { get; set; } = "Filtern nach Brennstoffart:";
    [Parameter] public string LabelFilterLeistung { get; set; } = "Filtern nach Leistung:";
    [Parameter] public string BtnBearbeitenText { get; set; } = "Bearbeiten...";
    [Parameter] public string BtnLoeschenText { get; set; } = "Löschen";
    [Parameter] public string BtnAdminText { get; set; } = "Administration...";
    [Parameter] public string GruppeModul { get; set; } = "Modul";
    [Parameter] public string LabelName { get; set; } = "Name:";
    [Parameter] public string LabelBeschreibung { get; set; } = "Beschreibung:";
    [Parameter] public string LabelTraeger { get; set; } = "Brennstoff Variante:";
    [Parameter] public string LabelVorlauf { get; set; } = "Vorlauf:";
    [Parameter] public string LabelRuecklauf { get; set; } = "Rücklauf:";
    [Parameter] public string TraegerTitel { get; set; } = "Energieträger Variante";
    [Parameter] public string EditorTitel { get; set; } = "Administration Heizkessel";
    [Parameter] public string OkText { get; set; } = "OK";
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";
    [Parameter] public string JaText { get; set; } = "Ja";
    [Parameter] public string NeinText { get; set; } = "Nein";

    /// <summary>
    /// Die Rückfrage vor dem Löschen aus dem Katalog (A-4). Der Vorläufer löschte OHNE
    /// Rückfrage, obwohl der Satz global gilt — dieselbe Lage wie B0-8 beim
    /// Pufferspeicher, wo sie in Paket 9 ergänzt wurde.
    /// </summary>
    [Parameter] public string FrageLoeschen { get; set; } =
        "Der Katalogeintrag \"{0}\" wird für ALLE Projekte gelöscht. Fortfahren?";

    [Parameter] public string TitelLoeschen { get; set; } = "Löschen";

    /// <summary>Meldung, wenn das Löschen abgelehnt wurde.</summary>
    [Parameter] public string MeldungLoeschFehler { get; set; } =
        "Der Katalogeintrag konnte nicht gelöscht werden.";

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_Heizkessel.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private ErzeugerZeile? _projektZeile;
    private KatalogZeile? _katalogZeile;
    private IReadOnlyList<KatalogZeile> _katalog = Array.Empty<KatalogZeile>();
    private IReadOnlyList<(int Id, string Text)> _varianten = Array.Empty<(int, string)>();
    private ErzeugerDetail _detail = new("", "", Array.Empty<(string, string)>());

    private int? _gruppe = 0;
    private int? _stufe = 0;

    private IReadOnlyDictionary<string, object>? _traegerGaben;
    private IReadOnlyDictionary<string, object>? _editorGaben;
    private bool _loeschfrage;

    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Hinweis;

    /// <summary>Die gewaehlte Projektzeile (Pruefhilfe fuer Tests).</summary>
    public ErzeugerZeile? Projektzeile => _projektZeile;

    /// <summary>Die gewaehlte Katalogzeile (Pruefhilfe fuer Tests).</summary>
    public KatalogZeile? Katalogzeile => _katalogZeile;

    /// <summary>Steht die Traegerwahl? (Pruefhilfe fuer Tests.)</summary>
    public bool Traegerwahl => _traegerGaben is not null;

    /// <summary>Die aktuelle Meldung (Pruefhilfe fuer Tests).</summary>
    public string Meldung => _meldung;

    private IReadOnlyList<(int Id, string Text)> _gruppenEintraege = Array.Empty<(int, string)>();
    private IReadOnlyList<(int Id, string Text)> _stufenEintraege = Array.Empty<(int, string)>();

    protected override void OnParametersSet()
    {
        _gruppenEintraege = Nummeriert(Gruppen);
        _stufenEintraege = Nummeriert(Leistungsstufen);
    }

    protected override void OnInitialized()
    {
        KatalogNeuLaden();

        // SetControls: die erste Zeile ist beim Oeffnen gewaehlt.
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private static IReadOnlyList<(int Id, string Text)> Nummeriert(IReadOnlyList<string> texte)
    {
        var liste = new List<(int, string)>();
        for (int i = 0; i < texte.Count; i++) liste.Add((i, texte[i]));
        return liste;
    }

    // =================================================================================
    // Filter und Listen
    // =================================================================================

    private void KatalogNeuLaden()
    {
        if (Filtern is null) return;

        string gruppe = (_gruppe.HasValue && _gruppe.Value < Gruppen.Count) ? Gruppen[_gruppe.Value] : "";
        _katalog = Filtern(gruppe, _stufe ?? 0);

        // Die gewaehlte Zeile kann aus dem Filter gefallen sein.
        if (_katalogZeile is not null && !_katalog.Contains(_katalogZeile)) _katalogZeile = null;
    }

    private void BeiGruppe(int? id) { _gruppe = id ?? 0; KatalogNeuLaden(); }

    private void BeiStufe(int? id) { _stufe = id ?? 0; KatalogNeuLaden(); }

    /// <summary>
    /// Eine PROJEKTzeile waehlen: Detail aus der Projektkopie, dazu die Traegerliste der
    /// Gruppe mit Vorwahl (<c>ApplySelectedKessel</c>).
    /// </summary>
    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _varianten = Varianten is not null ? Varianten(zeile.CarrierId) : Array.Empty<(int, string)>();
        _detail = (ProjektDetail is not null ? ProjektDetail(zeile.GeraetId) : null) ?? Leer(zeile.Bezeichner);
    }

    /// <summary>
    /// Eine KATALOGzeile waehlen: Detail aus dem Stamm, die Traegerwahl verschwindet
    /// (<c>listBox_Kessel_DB_SelectedIndexChanged</c>).
    /// </summary>
    private void KatalogZeileWaehlen(KatalogZeile zeile)
    {
        _katalogZeile = zeile;
        _projektZeile = null;
        _varianten = Array.Empty<(int, string)>();
        _detail = (KatalogDetail is not null ? KatalogDetail(zeile.Bezeichner) : null) ?? Leer(zeile.Bezeichner);
    }

    private static ErzeugerDetail Leer(string name)
        => new(name, "", Array.Empty<(string, string)>());

    // =================================================================================
    // Hinzufuegen und Entfernen
    // =================================================================================

    /// <summary>
    /// „◀": Erst die Traegerwahl, dann die Aufnahme. Ohne gewaehlten Katalogsatz tut der
    /// Knopf nichts (der Bestand pruefte <c>listBox_Kessel_DB.Text == ""</c>).
    /// </summary>
    private void BeiHinzu()
    {
        if (_katalogZeile is null || Vorbereiten is null || TraegerGaben is null) return;

        TraegerVorbereitung vor = Vorbereiten(_katalogZeile.Id);
        if (!string.IsNullOrEmpty(vor.Meldung))
        {
            Melden(vor.Meldung, true);
            return;
        }

        _traegerGaben = TraegerGaben(vor);
    }

    /// <summary>
    /// Der Traegerdialog ist zu. <c>null</c> = abgebrochen, und dann wird KEIN Kessel
    /// aufgenommen - kein verwaister Eintrag mit ID_Carrier = 0.
    /// </summary>
    private void TraegerFertig(EnergietraegerVarianteErgebnis? ergebnis)
    {
        var katalog = _katalogZeile;
        _traegerGaben = null;

        if (ergebnis is null || katalog is null || Aufnehmen is null) return;

        AufnahmeErgebnis aufnahme = Aufnehmen(katalog.Id, ergebnis);
        if (!string.IsNullOrEmpty(aufnahme.Meldung)) Melden(aufnahme.Meldung, aufnahme.Fehler);

        if (aufnahme.Zeile is null) return;

        Zeilen.Add(aufnahme.Zeile);
        ProjektZeileWaehlen(aufnahme.Zeile);
    }

    /// <summary>
    /// „▶": Die gewaehlte Zeile verschwindet. Ob die Projektkopie mit ihr geht,
    /// entscheidet die Huelle - nur wenn keine zweite Zeile mehr darauf verweist.
    /// </summary>
    private void BeiEntfernen()
    {
        if (_projektZeile is null) return;

        ErzeugerZeile zeile = _projektZeile;
        Zeilen.Remove(zeile);
        Entfernen?.Invoke(zeile);

        _projektZeile = null;
        _detail = Leer("");
        _varianten = Array.Empty<(int, string)>();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
    }

    // =================================================================================
    // Zeilenwerte
    // =================================================================================

    private void BeiTraegerwechsel(int? neu)
    {
        if (_projektZeile is null || !neu.HasValue) return;
        if (neu.Value == _projektZeile.CarrierId) return;   // programmatische Vorwahl

        TraegerWechseln?.Invoke(_projektZeile, neu.Value);
        _projektZeile.CarrierId = neu.Value;
    }

    private void BeiVorlauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Vorlauf = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    private void BeiRuecklauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Ruecklauf = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    // =================================================================================
    // Katalogpflege
    // =================================================================================

    /// <summary>Der Parametersatz der offenen Katalogverwaltung; <c>null</c> = zu.</summary>
    private IReadOnlyDictionary<string, object>? _verwaltungGaben;

    /// <summary>Steht die Katalogverwaltung? (Prüfhilfe für Tests.)</summary>
    public bool VerwaltungOffen => _verwaltungGaben is not null;

    /// <summary>
    /// Nach der Verwaltung die Katalogliste neu ziehen — genau das tat der Vorläufer
    /// nach der Rückkehr aus dem zweiten Fenster.
    /// </summary>
    private void VerwaltungFertig(BrowserErgebnis? ergebnis)
    {
        _verwaltungGaben = null;
        KatalogNeuLaden();
    }

    private void BeiKatalogBearbeiten()
    {
        if (_katalogZeile is null || EditorGaben is null) return;
        _editorGaben = EditorGaben(_katalogZeile.Bezeichner);
    }

    /// <summary>Nach dem Editor die Katalogliste neu ziehen (Bestandsverhalten).</summary>
    private void EditorFertig(string? name)
    {
        _editorGaben = null;
        if (name is null) return;

        KatalogNeuLaden();
        foreach (var z in _katalog)
            if (z.Bezeichner == name) { KatalogZeileWaehlen(z); return; }
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || _katalogZeile is null || KatalogLoeschen is null) return;

        if (!KatalogLoeschen(_katalogZeile.Id))
        {
            Melden(MeldungLoeschFehler, true);
            return;
        }

        _katalogZeile = null;
        _detail = Leer("");
        KatalogNeuLaden();
    }

    private async Task BeiAdmin()
    {
        if (VerwaltungGaben is null) return;
        _verwaltungGaben = VerwaltungGaben();
        await Task.CompletedTask;
    }

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>
    /// Esc schliesst; die Ueberlagerungen werten ihn zuerst fuer sich aus. Enter bleibt
    /// unbelegt (A-7 aus B5b).
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_traegerGaben is not null || _editorGaben is not null || _loeschfrage) return Task.CompletedTask;
        return Geschlossen.InvokeAsync(false);
    }
}
