    /// noch gelesen; ihre Delegaten greifen bei jedem Zugriff neu zu. Die vier Filterfelder
    /// sind Suche und Trichter der Katalogliste (Welle K): Setzen heißt, den Ausdruck in den
    /// Filterstand tippen; die Liste filtert beim nächsten Zeichnen neu.
    /// </summary>
    private GebaeudeKiSicht KiSicht()
    {
        return _kiSicht ??= new GebaeudeKiSicht
        {
            Nutzungsprofile = _raumnutzungKi,
            VerwendungLesen = () => _filterstand.Ausdruck(Katalogfilterprofil.SpVerwendung),
            VerwendungSetzen = w => _filterstand.Setzen(Katalogfilterprofil.SpVerwendung, w),
            VerwendungEintraege = () => Spaltenwahl(Katalogfilterprofil.SpVerwendung),

            FilterGebaeudeartLesen = () => _filterstand.Ausdruck(Katalogfilterprofil.SpGebaeudeart),
            FilterGebaeudeartSetzen = w => _filterstand.Setzen(Katalogfilterprofil.SpGebaeudeart, w),
            GebaeudeartEintraege = () => Spaltenwahl(Katalogfilterprofil.SpGebaeudeart),

            FilterBaujahrLesen = () => _filterstand.Ausdruck(Katalogfilterprofil.SpBaualtersklasse),
            FilterBaujahrSetzen = w => _filterstand.Setzen(Katalogfilterprofil.SpBaualtersklasse, w),
            BaujahrEintraege = () => Spaltenwahl(Katalogfilterprofil.SpBaualtersklasse),

            SucheLesen = () => _filterstand.Suche,
            SucheSetzen = muster => _filterstand.Suche = muster ?? "",

            NameLesen = () => _detailName,
            GebaeudeartLesen = () => _detailArt,
            BeschreibungLesen = () => _detailBeschreibung,
            WohnflaecheLesen = () => _detailWohnflaeche,
            AngabeartLesen = () => Flaechenangabe.Anzeige(_detailEinheit)
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>Kein Speicherweg.</b> Die Maske schreibt nicht: Jede Katalogaktion geht
    /// über ihren eigenen Knopf in die Datenbank, und die Projektliste gehört dem Wirt,
    /// der sie beim OK übernimmt. <c>dialog_speichern</c> lehnt deshalb benannt ab.</para>
    /// <para><b>Kein Schreibschutz.</b> Ob ein Katalogsatz zur Auslieferung gehört,
    /// entscheidet der Löschweg der Hülle und nicht diese Maske.</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>
    /// Zieht die Markierung der Projektliste nach, sobald der Wirt eine ANDERE
    /// Liste hereinreicht (Befund <b>W9‑B‑1</b> der Windows-Abnahme vom 05.09.2026).
    ///
    /// <para><b>Warum das nötig ist.</b> Die Hülle baut die Anzeigeliste bei jedem
    /// <c>Gaben</c>-Aufruf NEU aus ihrer Fachliste (<c>GebaeudeHuelle.Gaben</c>
    /// :113‑114); die Zeilenobjekte sind danach andere. Wer die Markierung an der
    /// Objektgleichheit festmacht, verliert sie bei jedem solchen Austausch — der
    /// Anwender sah sein gespeichertes Gebäude in der Liste stehen, aber unmarkiert,
    /// und der Detailblock hing an einer Zeile, die es nicht mehr gab. Der Schlüssel
    /// ist die <see cref="GebaeudeProjektZeile.IdZ"/> (<c>Z_ProjektGebaeude.ID</c>) —
    /// dieselbe, an der „▶" hängt.</para>
    ///
    /// <para>Und der zweite Fall: Kommt die Liste erst NACH dem ersten Zeichnen
    /// (der Ladeweg des Assistenten läuft im Verlassen der Projektkopfseite), stand
    /// bis hierher für immer keine Markierung. Jetzt markiert die erste Zeile, sobald
    /// eine da ist — wie <c>Form_Gebaeude_Load</c>.</para>
    /// </summary>
    protected override void OnParametersSet()
    {
        // Der Kopf der Wahlspalte der Katalogliste kommt ueber den eigenen Text des
        // Wirtes - dasselbe Wort wie in der Projektliste darueber.
        Filtertexte.SpalteWahl = SpalteWahl;
        ProjektauswahlNachziehen();
    }

    private void ProjektauswahlNachziehen()
    {
        if (_gewaehlt is not null)
        {
            // Dieselbe Zeile noch in der Liste? Dann ist nichts zu tun.
            foreach (GebaeudeProjektZeile z in Zeilen)
                if (ReferenceEquals(z, _gewaehlt)) return;

            // Sonst dieselbe ZUORDNUNG suchen - die IdZ, nicht die Stamm-Id.
            foreach (GebaeudeProjektZeile z in Zeilen)
                if (z.IdZ == _gewaehlt.IdZ) { ProjektzeileWaehlen(z); return; }

            _gewaehlt = null;
        }

        // Der Anwender steht im Katalog - seine Wahl wird nicht ueberschrieben.
        if (_katalogzeile is not null) return;

        if (Zeilen.Count > 0) ProjektzeileWaehlen(Zeilen[0]);
    }

    /// <summary>
    /// Ist diese Zeile die markierte? Verglichen wird über die
    /// <see cref="GebaeudeProjektZeile.IdZ"/>, nicht über die Objektgleichheit
    /// (Befund W9‑B‑1).
    /// </summary>
    private bool IstGewaehlt(GebaeudeProjektZeile z)
        => _gewaehlt is not null && (ReferenceEquals(z, _gewaehlt) || z.IdZ == _gewaehlt.IdZ);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    // =================================================================================
    // Der Katalog - die Katalogliste des Hauses (Stufe G3, Welle K)
    // =================================================================================

    /// <summary>
    /// Liest den Katalog neu — beim Öffnen und nach einem SCHREIBweg (Editor, Import,
    /// Löschen). Der FILTER ruft sie nicht: Er wirkt auf die Anzeige, und die Einschränkung
    /// macht der Kern in der <c>Katalogliste</c>. Die Wahl bleibt am Schlüssel stehen, solange
    /// es den Satz noch gibt.
    /// </summary>
    private void KatalogLaden()
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, TitelText, out _listeFehler);

        _katalogzeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogzeile is null) _katalogGewaehlt = "";
        LoeschsperreLesen();
    }

    /// <summary>Der Katalogsatz zu einem Schlüssel; <c>null</c>, wenn es ihn nicht gibt.</summary>
    private Katalogfilterzeile? Katalogsatz(string schluessel)
    {
        if (string.IsNullOrEmpty(schluessel)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Schluessel == schluessel) return z;
        return null;
    }

    /// <summary>
    /// Die Zeilen, die die Liste gerade ZEIGT — gefiltert und sortiert nach demselben Stand
    /// und derselben Rechnung wie die <c>Katalogliste</c> (<c>Katalogfilter.Anwenden</c>).
    /// Gebraucht nur beim Entfernen, das die erste sichtbare Katalogzeile wählt.
    /// </summary>
    private IReadOnlyList<Katalogfilterzeile> Sichtbar
        => Katalogfilter.Anwenden(Profil, _katalog, _filterstand);

    /// <summary>
    /// Die Einträge eines Filterfeldes für den Assistenten: jeder Wert, der in der Spalte
    /// steht, einmal und sortiert — genau das, was der Trichter treffen kann. Schlüssel ist
    /// der Anzeigetext, denn der Trichter filtert auf dem, was in der Zelle steht.
    /// </summary>
    private IReadOnlyList<KiKern.KiWahleintrag> Spaltenwahl(string spalte)
    {
        var werte = new SortedSet<string>(StringComparer.CurrentCulture);
        foreach (Katalogfilterzeile z in _katalog)
        {
            string text = z.Text(spalte);
            if (!string.IsNullOrWhiteSpace(text) && text != ParameterVerwendung.LEER) werte.Add(text);
        }
        return KiMaskenanmeldung.Eintraege(werte, w => w);
    }

    // =================================================================================
    // Auswahl und Detailblock
    // =================================================================================

    /// <summary>Was die Detailzeile zeigt: die Projektkopie, der Katalogsatz oder keiner (dann bleibt die Satzfläche leer).</summary>
    private Satzmarke SatzArt => _gewaehlt is not null ? Satzmarke.Projektsatz
                               : _katalogzeile is not null ? Satzmarke.Katalogsatz : Satzmarke.Keiner;

    /// <summary>Name des gewählten Satzes in der zugeklappten Detailzeile.</summary>
    private string? SatzName => SatzArt == Satzmarke.Keiner ? null : _detailName;

    private void ProjektzeileWaehlen(GebaeudeProjektZeile z)
    {
        _gewaehlt = z;
        _katalogzeile = null;
        _katalogGewaehlt = "";
        _loeschsperre = "";
        _detailName = z.Name;
        _detailArt = z.Art;
        _detailBeschreibung = z.Beschreibung;
        _detailWohnflaeche = z.Wohnflaeche.ToString("F2");
        _detailEinheit = z.Einheit;
        _detailHges = Leitwert(z.HgesWK);
        _detailRechenweg = z.Rechenweg;
    }

    /// <summary>Der Wärmeleitwert als Anzeige — „—" ohne Wert, nie eine erfundene Zahl.</summary>
    private static string Leitwert(double? wk)
        => wk.HasValue ? wk.Value.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " W/K" : "—";

    /// <summary>
    /// Die Katalogliste meldet eine Zeile: Der Katalogsatz füllt den Detailblock aus den
    /// STAMMDATEN; Einheit „Wohnfläche [m²]" und ein leerer Jahresnutzungsgrad
    /// (<c>listBox_Gebaeude_DB_SelectedIndexChanged</c>:585-592). Die Projektmarkierung fällt.
    /// </summary>
    private void KatalogzeileWaehlen(string schluessel)
    {
        Katalogfilterzeile? k = Katalogsatz(schluessel ?? "");
        if (k is null) return;

        _katalogGewaehlt = k.Schluessel;
        _katalogzeile = k;
        _gewaehlt = null;
        LoeschsperreLesen();

        GebaeudeStammDetail? detail = StammDetail?.Invoke(k.Bezeichner);
        _detailName = detail?.Name ?? k.Bezeichner;
        _detailArt = detail?.Art ?? k.Text(Katalogfilterprofil.SpGebaeudeart);
        _detailBeschreibung = detail?.Beschreibung ?? "";
        _detailWohnflaeche = detail?.Wohnflaeche ?? k.Text(Katalogfilterprofil.SpFlaecheM2);
        _detailEinheit = Flaechenangabe.GESPEICHERT;
        _detailHges = Leitwert(detail?.HgesWK);
        _detailRechenweg = detail?.Rechenweg ?? "";
    }

    // =================================================================================
    // Uebernehmen und Entfernen
    // =================================================================================

    private void BeiHinzu()
    {
        if (_katalogzeile is null || StammSatz is null) return;

        GebaeudeProjektZeile? neu = StammSatz(_katalogzeile.Bezeichner);
        if (neu is null) return;

        Zeilen.Add(neu);
        ProjektzeileWaehlen(neu);
        Geaendert?.Invoke();
        _meldung = "";
    }

    /// <summary>
    /// Entfernt GENAU die gewählte Zeile über ihre <c>IdZ</c> — die Stamm-Id ist bei zwei
    /// gleichen Gebäuden nicht eindeutig (<c>btn_Entfernen_Click</c>:283-287). Ist die
    /// Projektliste danach leer, steht die erste SICHTBARE Katalogzeile im Detailblock.
    /// </summary>
    private void BeiEntfernen()
    {
        if (_gewaehlt is null) return;

        // Stufe G6a (A2): Ein Gebaeude mit Zonen geht erst nach der Rueckfrage - die Kaskade
        // loescht Zonen und Bauteile mit dem Speichern der Liste.
        if (_gewaehlt.Zonenzahl > 0) { _ausProjektFrage = true; return; }
        Entfernen();
    }

    /// <summary>Die Antwort: Ja entfernt die Zeile, Nein lässt alles stehen.</summary>
    private void AusProjektBeantwortet(bool? antwort)
    {
        _ausProjektFrage = false;
        if (antwort == true) Entfernen();
    }

    private void Entfernen()
    {
        if (_gewaehlt is null) return;

        Zeilen.Remove(_gewaehlt);
        _gewaehlt = Zeilen.Count > 0 ? Zeilen[0] : null;

        if (_gewaehlt is not null) ProjektzeileWaehlen(_gewaehlt);
        else
        {
            IReadOnlyList<Katalogfilterzeile> sichtbar = Sichtbar;
            if (sichtbar.Count > 0) KatalogzeileWaehlen(sichtbar[0].Schluessel);
        }
        Geaendert?.Invoke();
        _meldung = "";
    }

    // =================================================================================
    // "In DB uebernehmen" - die Projektkopie als neuer Katalogsatz
    // =================================================================================

    private bool _inDbOffen;
    private GebaeudeProjektZeile? _inDbZeile;
    private string _inDbName = "";
    private string? _inDbNameFehler;
    private string? _inDbFehler;

    /// <summary>Steht die Namensabfrage „In DB übernehmen"? Prüfhilfe für die Tests.</summary>
    public bool InDbOffen => _inDbOffen;

    /// <summary>Der Name im Feld der Abfrage — Prüfhilfe für die Tests.</summary>
    public string InDbName => _inDbName;

    /// <summary>Die Absage am Namensfeld; <c>null</c> = keine. Prüfhilfe für die Tests.</summary>
    public string? InDbNameFehler => _inDbNameFehler;

    /// <summary>Öffnet die Namensabfrage, vorbelegt mit dem Vorschlag der Hülle.</summary>
    private void BeiInDb()
    {
        if (_gewaehlt is null || InDbUebernehmen is null) return;
        // Anwenderentscheid 06.10.2026: eine ungespeicherte Zeile zuerst still speichern; scheitert
        // das, steht die Meldung und es wird nicht übernommen.
        if (!_gewaehlt.HatProjektkopie && !VorherSpeichern(SperreInDb)) return;

        _meldung = "";
        _inDbZeile = _gewaehlt;
        _inDbName = InDbVorschlag?.Invoke(_gewaehlt) ?? _gewaehlt.Name;
        _inDbNameFehler = null;
        _inDbFehler = null;
        _inDbOffen = true;
    }

    private void InDbNameGeaendert(string w)
    {
        _inDbName = w ?? "";
        _inDbNameFehler = null;
        _inDbFehler = null;
    }

    /// <summary>Abbrechen, Esc und das Kreuz: Die Abfrage geht zu, geschrieben wird nichts.</summary>
    private void InDbAbbrechen()
    {
        _inDbOffen = false;
        _inDbZeile = null;
        _inDbName = "";
        _inDbNameFehler = null;
        _inDbFehler = null;
    }

    private void InDbErgebnis(bool ok)
    {
        if (ok) InDbSchreiben();
        else InDbAbbrechen();
    }

    /// <summary>
    /// Das OK der Abfrage schreibt SOFORT. Eine Absage am Namen steht am Feld, jede andere in der
    /// Abfrage; sie bleibt dann offen. Danach liest die Katalogliste neu, der neue Satz ist gewählt
    /// und steht im Detailblock, die Statuszeile meldet die Übernahme.
    /// </summary>
    private void InDbSchreiben()
    {
        if (_inDbZeile is null || InDbUebernehmen is null) { InDbAbbrechen(); return; }

        GebaeudeDbUebernahme e = InDbUebernehmen(_inDbZeile, _inDbName);
        if (!e.Ok)
        {
            if (e.AmNamen) _inDbNameFehler = e.Meldung;
            else _inDbFehler = e.Meldung;
            return;
        }

        InDbAbbrechen();
        KatalogLaden();
        foreach (Katalogfilterzeile k in _katalog)
            if (string.Equals(k.Bezeichner, e.Name, StringComparison.Ordinal)) { KatalogzeileWaehlen(k.Schluessel); break; }
        Melden(e.Meldung, WarnStufe.Erfolg);
    }

