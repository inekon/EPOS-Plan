@* DIE KATALOGSEITE EINES GANGLINIEN-PROJEKTDIALOGS.

   WOZU. Die Katalogpflege einer Zeitreihe bleibt im Projektdialog (Konzept
   Projektdialoge mit Katalogauswahl): Liste mit Beschreibung, Jahresarbeit und
   Spitze, Vergleichen, Schloss setzen/aufheben, Loeschen und Import... - EIN Baustein, damit dieselbe Seite
   jede Zeitreihenart traegt. Der Wirt reicht die Wege seiner Art herein
   (GanglinienKatalogwege); die Fachlogik bleibt in deren Controllern.

   DIE FUSSLEISTE (Katalogauswahl V1, Stufe 4) sind drei Fragmente - Fuss (Vergleichen..., Schloss,
   Loeschen auf der Auswahl), FussRechts (Import...); den Formathinweis (Infoknopf) reicht der Wirt. Mit
   FussImWirt legt der Wirt sie in die Slots KatalogFuss, KatalogFussRechts und KatalogKopf der
   Zweispaltenauswahl und hoert ZustandGeaendert, um sie nachzuzeichnen; ohne (Katalogbetrieb)
   traegt die Seite sie in ihrer eigenen Leiste. Die Liste fuehrt Kaestchen (Mehrfachwahl, 4.5)
   und mit dem Rueckruf Stift den Stift je Zeile (UeS2). Wirft das Lesen der Liste oder das
   Loeschen, nennt ein Banner den Grund (KT-4, Katalogladung).

   DIE WAHL GEHOERT DEM WIRT: Er setzt Gewaehlt (die Markierung haengt am NAMEN)
   und hoert ZeileGewaehlt; nach jeder Aenderung des Katalogs (Import, Loeschen,
   Schloss) meldet die Seite Geaendert.

   LOESCHEN ist WEICH gesperrt (aria-disabled, Grund im title, der Klick meldet
   ihn): Auslieferungssatz, ein anderes Projekt fuehrt die Ganglinie (die Namen
   stehen im Grund) oder das offene Projekt fuehrt sie (ImProjekt). Die letzte
   Pruefung vor der Rueckfrage fragt die Datenbank (HatProjektzuordnung).

   IMPORT... oeffnet eine Ueberlagerung mit Hinweis, Ordner, Dateiwahl,
   Fortschritt und "Einlesen". Gelingt er, ist sie zu, der neue Satz gewaehlt,
   die Statuszeile nennt ihn und die Protokollzeile Format, Anzahl Werte,
   Raster, Jahresarbeit und Spitze. Ohne Einleseweg steht der Knopf nur, wenn
   die Plattform den Grund nennt (ImportAbgelehnt) - weich gesperrt. *@

@namespace EPOS.UI.Bausteine
@using EPOS.UI.Dialoge.Bedarf
@using WindowsFormsApplication1
@using SpeicherEngine

<div class="epos-ganglinie-katalogseite">

    @* KT-4: Wirft das Lesen der Liste, nennt dieser Banner den Grund (Katalogladung.Lesen). *@
    @if (_listeFehler.Length > 0)
    {
        <div class="epos-katalogmeldung">
            <Warnbanner Stufe="@WarnStufe.Warnung" Text="@_listeFehler" />
        </div>
    }

    @* DIE KATALOGLISTE im Kaestchenmodus (Konzept 4.5): Die Zeile ist die Wahl (Detailzeile), das
       Kaestchen waehlt mehrere fuer Vergleichen, Schloss und Loeschen; der Stift je Zeile (UeS2)
       ruft den Wirt. *@
    <Katalogliste @ref="_liste" Profil="@Profil" Zeilen="@_katalog"
                  Filterstand="@Filterstand" Texte="@Filtertexte"
                  Gewaehlt="@Gewaehlt" GewaehltChanged="BeiZeile"
                  ZeileIstWahl="true" Kaestchen="true" Gewaehlte="@_kaestchen"
                  GewaehlteChanged="BeiKaestchen"
                  Bearbeiten="@StiftRueckruf" BearbeitenHinweis="@Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS" />

    @* OHNE ZWEISPALTENAUSWAHL (Katalogbetrieb) traegt die Seite ihre Fussleiste selbst - dieselben
       Fragmente, die der Wirt sonst in die Slots KatalogFuss und KatalogFussRechts legt. *@
    @if (!FussImWirt)
    {
        <div class="epos-leiste epos-ganglinie-katalogfuss">
            @Fuss
            <span class="epos-leiste-fueller"></span>
            @Formathinweis
            @FussRechts
        </div>
    }

    @if (_meldung.Length > 0)
    {
        <div class="epos-katalogmeldung">
            <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
        </div>
    }
    @if (_status.Length > 0)
    {
        <div class="epos-status" role="status">@_status</div>
    }
    @if (_protokoll.Length > 0)
    {
        <Herleitungszeile Text="@_protokoll" />
    }

    <Rueckfrage Offen="@_loeschfrageOffen" Frage="@_loeschfrage" TitelText="@Texte.LoeschenTitel"
                JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="LoeschfrageBeantwortet" />

    @* DER IMPORT ALS UEBERLAGERUNG. Das Kreuz steht beim Titel; waehrend der Kette
       schliessen weder Kreuz noch Esc noch Abbrechen. *@
    <Ueberlagerung Offen="@_importOffen" Titel="@Texte.ImportTitel" Geschlossen="ImportSchliessen">
        <KindInhalt>
            @if (_importOffen)
            {
                <div class="epos-einlesen">
                    @if (_importMeldung.Length > 0)
                    {
                        <Warnbanner Stufe="@_importMeldungStufe" Text="@_importMeldung" />
                    }

                    <Herleitungszeile Text="@Texte.ImportHinweis" />

                    <Formularraster Einspaltig="true">
                        <KindInhalt>
                            @if (Wege.Ordner.Length > 0)
                            {
                                <Textfeld Bezeichnung="@Texte.LabelOrdner" Wert="@Wege.Ordner" NurLesen="true" />
                            }
                            <Dateiwahl Bezeichnung="@Texte.LabelDatei" KnopfText="@Texte.DateiKnopf"
                                       Filter="@Texte.Dateifilter" Pfad="@_pfad" Waehlen="@Wege.DateiWaehlen"
                                       PfadChanged="BeiDatei" Aktiv="@(!_laeuft)" />
                            @if (Wege.NennleistungVorschlagen is not null || Wege.NennleistungAusLesung is not null)
                            {
                                <Zahlenfeld Bezeichnung="@Texte.LabelNennleistung" Einheit="kWp" Wert="@_nennleistung"
                                            WertChanged="BeiNennleistung" Min="0" Nachkommastellen="2"
                                            Feldname="nennleistung" Aktiv="@(!_laeuft)" />
                            }
                        </KindInhalt>
                    </Formularraster>

                    @if (_nennHerkunft.Length > 0)
                    {
                        <Herleitungszeile Text="@_nennHerkunft" />
                    }
                    @if (_nennHinweis.Length > 0)
                    {
                        <Warnbanner Stufe="@WarnStufe.Hinweis" Text="@_nennHinweis" />
                    }

                    <Fortschritt Sichtbar="@_laeuft" Anteil="@_anteil" Text="@_fortschrittText" />

                    <div class="epos-leiste">
                        @if (Wege.MitSystemOeffnen is not null)
                        {
                            <button type="button" class="epos-knopf" disabled="@(!AnzeigenErlaubt)"
                                    @onclick="BeiAnzeigen">@Texte.AnzeigenKnopf</button>
                        }
                        <span class="epos-leiste-fueller"></span>
                        <button type="button" class="epos-knopf" disabled="@_laeuft"
                                @onclick="ImportSchliessen">@Texte.AbbrechenKnopf</button>
                        <button type="button" class="epos-knopf epos-knopf--primaer" disabled="@(!EinlesenErlaubt)"
                                @onclick="BeiEinlesen">@Texte.EinlesenKnopf</button>
                    </div>
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* DER OPTIONENDIALOG "Format und Vorschau" (nur mit Wege.Lesen): Nach der Dateiwahl legt die
       Importkette ihre Entscheidungen (Optionen, Protokoll) als Ueberlagerungen ueber die Import-
       Ueberlagerung - derselbe Baustein wie bei Strom, Lastspitzenkappung und Waermebedarf. *@
    @if (Wege.Lesen is not null)
    {
        <GanglinienImportLauf @ref="_lauf" Einlesen="@LaufEinlesen" Vorschau="@Wege.Vorschau" />
    }

    @* DIE NENNLEISTUNG EINES KATALOGSATZES als kurze Ueberlagerung: OK schreibt sofort an den Katalogsatz
       (wie Loeschen und Schloss), Abbrechen, Kreuz und Esc verwerfen. Der Pruefhinweis des Imports steht
       als Banner, sobald der Wert ihn ausloest - und nach dem Speichern auf der Seite. *@
    <Ueberlagerung Offen="@_nennOffen" Titel="@Texte.NennleistungTitel" Geschlossen="NennleistungSchliessen">
        <KindInhalt>
            @if (_nennOffen)
            {
                <div class="epos-nennleistung-bearbeiten">
                    @if (_nennFehler.Length > 0)
                    {
                        <Warnbanner Stufe="@WarnStufe.Warnung" Text="@_nennFehler" />
                    }
                    <Formularraster Einspaltig="true">
                        <KindInhalt>
                            <Textfeld Bezeichnung="@Texte.LabelName" Wert="@_nennZiel" NurLesen="true" />
                            <Zahlenfeld Bezeichnung="@Texte.LabelNennleistung" Einheit="kWp" Wert="@_nennWert"
                                        WertChanged="BeiNennWert" Min="0" Nachkommastellen="2"
                                        Feldname="nennleistung_bearbeiten" />
                        </KindInhalt>
                    </Formularraster>
                    <Herleitungszeile Text="@Texte.NennleistungLeer" />
                    @if (_nennBearbeitenHinweis.Length > 0)
                    {
                        <Warnbanner Stufe="@WarnStufe.Hinweis" Text="@_nennBearbeitenHinweis" />
                    }
                    <p class="epos-leisezeile">@Texte.NennleistungProjektkopien</p>
                    <SpeichernLeiste OkText="@Texte.OkKnopf" AbbrechenText="@Texte.AbbrechenKnopf"
                                     Ergebnis="BeiNennErgebnis" />
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    /// <summary>Die Wege der Zeitreihenart (Katalog, Verwendung, Löschen, Schloss, Import).</summary>
    [Parameter] public GanglinienKatalogwege Wege { get; set; } = new();

    /// <summary>Die Spalten der Liste — mit Beschreibung, Jahresarbeit und Spitze.</summary>
    [Parameter] public Katalogfilterprofil? Profil { get; set; }

    /// <summary>Der Filterstand der Liste — er gehört dem Wirt.</summary>
    [Parameter] public Katalogfilterstand? Filterstand { get; set; }

    /// <summary>Die Beschriftungen der Liste.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Die Beschriftungen der Seite.</summary>
    [Parameter] public GanglinienKatalogtexte Texte { get; set; } = new();

    /// <summary>Der Bezeichner der gewählten Zeile — die Markierung hängt am NAMEN.</summary>
    [Parameter] public string Gewaehlt { get; set; } = "";

    /// <summary>Eine Zeile wurde gewählt (<c>null</c>: die Wahl steht nicht mehr in der Liste).</summary>
    [Parameter] public EventCallback<Katalogfilterzeile?> ZeileGewaehlt { get; set; }

    /// <summary>
    /// Die Ganglinien des offenen Projekts (Bezeichner) — sie stempeln die Spalte „im
    /// Projekt verwendet" und sperren das Löschen. Ohne Projekt <c>null</c>.
    /// </summary>
    [Parameter] public Func<IEnumerable<string>>? ImProjekt { get; set; }

    /// <summary>Der Katalog hat sich geändert (Import, Löschen, Schloss).</summary>
    [Parameter] public EventCallback Geaendert { get; set; }

    /// <summary>
    /// <b>Die Fußleiste steht beim Wirt</b> (Katalogauswahl V1, Stufe 4): Die Seite zeichnet keine eigene
    /// Leiste; der Wirt legt <see cref="Fuss"/> in den Slot <c>KatalogFuss</c>, <see cref="FussRechts"/> in
    /// <c>KatalogFussRechts</c> und seinen Formathinweis in <c>KatalogKopf</c> der <c>Zweispaltenauswahl</c>.
    /// Ohne (Katalogbetrieb) trägt die Seite dieselben Fragmente in ihrer eigenen Leiste.
    /// </summary>
    [Parameter] public bool FussImWirt { get; set; }

    /// <summary>
    /// AW3b (Knopfleiste am Satz): Steht im Wirt ein PROJEKTsatz, nennt der Wirt über diesen Rückruf den Grund
    /// (<c>AUSWAHL_SPERRE_KATALOGSATZ</c>) — Schloss… und Löschen sind dann weich gesperrt (Klick meldet, schreibt
    /// nichts), Vergleichen… gesperrt (einen Vergleich der Projektzeilen gibt es nicht). <c>null</c> = wie bisher.
    /// Ein Rückruf, kein Wert: Die Fragmente zeichnet der Wirt in seinen Slots, mit seinem Stand dieses Zuges.
    /// </summary>
    [Parameter] public Func<string?>? Sperrgrund { get; set; }

    /// <summary>
    /// Der Zustand der Fragmente hat sich geändert (Wahl, Kästchen, Löschen, Schloss): Der Wirt zeichnet
    /// neu, damit seine Slots nachziehen. Die Seite ruft es auch nach dem ersten Zeichnen.
    /// </summary>
    [Parameter] public EventCallback ZustandGeaendert { get; set; }

    /// <summary>
    /// Der Stift je Katalogzeile (UeS2): Die Liste wählt die Zeile und ruft danach diesen Rückruf. Ohne ihn
    /// trägt die Liste keinen Stift.
    /// </summary>
    [Parameter] public EventCallback<Katalogfilterzeile> Stift { get; set; }

    /// <summary>Der Name der Liste im Grund der Fangstelle (Titel des Wirts); leer = der Bildtitel der Wege.</summary>
    [Parameter] public string Listenname { get; set; } = "";

    private string Liste => Listenname.Length > 0 ? Listenname : Wege.BildTitel;

    /// <summary>
    /// Der Formathinweis des Imports (Infoknopf des Wirts): Ohne Zweispaltenauswahl steht er in der eigenen
    /// Leiste der Seite; mit legt ihn der Wirt in den Slot <c>KatalogKopf</c>.
    /// </summary>
    [Parameter] public RenderFragment? Formathinweis { get; set; }

    private EventCallback<Katalogfilterzeile> StiftRueckruf
        => Stift.HasDelegate ? EventCallback.Factory.Create<Katalogfilterzeile>(this, BeiStift) : default;

    private async Task BeiStift(Katalogfilterzeile zeile)
    {
        if ((_zeile?.Bezeichner ?? "") != zeile.Bezeichner) await Waehlen(zeile.Bezeichner);
        await Stift.InvokeAsync(zeile);
    }

    // =====================================================================
    // Die Fragmente der Fußleiste und des Katalogkopfs (4.2)
    // =====================================================================

    /// <summary>
    /// Links in der Katalog-Fußleiste: Vergleichen… (ab zwei Sätzen), Nennleistung… (nur PV), Schloss
    /// setzen/aufheben…, Löschen — sie wirken auf die Auswahl des Katalogs (Kästchen, sonst die Wahl).
    /// </summary>
    public RenderFragment Fuss => @<text>
        <button type="button" class="epos-knopf epos-knopf--vergleichen"
                title="@Resource.AUSWAHL_BTN_VERGLEICHEN_HINWEIS"
                disabled="@(Ziele().Count < 2 || _laeuft || Sperrgrund?.Invoke() is not null)" @onclick="BeiVergleichen">@Resource.AUSWAHL_BTN_VERGLEICHEN</button>
        @if (Wege.NennleistungSchreiben is not null)
        {
            @* Nur die PV-Ganglinie: die Nennleistung des gewaehlten Katalogsatzes. Ein Auslieferungssatz
               ist weich gesperrt und nennt den Grund. *@
            if (_zeile is not null && _zeile.Geschuetzt)
            {
                <button type="button" class="epos-knopf epos-nennleistungknopf" aria-disabled="true"
                        title="@Texte.NennleistungGesperrt"
                        @onclick="() => Warnen(Texte.NennleistungGesperrt)">@Texte.NennleistungKnopf</button>
            }
            else
            {
                <button type="button" class="epos-knopf epos-nennleistungknopf"
                        disabled="@(_zeile is null || _laeuft)"
                        @onclick="NennleistungOeffnen">@Texte.NennleistungKnopf</button>
            }
        }
        <Katalogschloss @ref="_katalogschloss" Weg="@Wege.Schloss" Zeile="@_zeile" Sperrgrund="@(Sperrgrund?.Invoke())"
                        NurLesen="@_laeuft" JaText="@Texte.Ja" NeinText="@Texte.Nein"
                        Geschaltet="BeiSchlossGeschaltet" Abgelehnt="BeiSchlossAbgelehnt" />
        @if (Wege.Loeschen is not null)
        {
            string grund = Sperrgrund?.Invoke() ?? (Ziele().Count == 1 ? LoeschGrundVon(Ziele()[0]) : "");
            if (grund.Length > 0)
            {
                <button type="button" class="epos-knopf epos-katalog-loeschen" aria-disabled="true"
                        title="@grund" @onclick="() => WarnenUndNachziehen(grund)">@Texte.LoeschenKnopf</button>
            }
            else
            {
                <button type="button" class="epos-knopf epos-katalog-loeschen"
                        disabled="@(Ziele().Count == 0 || _laeuft)"
                        @onclick="BeiLoeschen">@Texte.LoeschenKnopf</button>
            }
        }
    </text>;

    /// <summary>Rechts in der Katalog-Fußleiste: Import… (weich gesperrt, wenn die Plattform den Grund nennt).</summary>
    public RenderFragment FussRechts => @<text>
        @if (Wege.Einlesen is not null)
        {
            <button type="button" class="epos-knopf epos-importknopf" disabled="@_laeuft"
                    @onclick="ImportOeffnen">@Texte.ImportKnopf</button>
        }
        else if (Wege.ImportAbgelehnt.Length > 0)
        {
            <button type="button" class="epos-knopf epos-importknopf" aria-disabled="true"
                    title="@Wege.ImportAbgelehnt"
                    @onclick="() => WarnenUndNachziehen(Wege.ImportAbgelehnt)">@Texte.ImportKnopf</button>
        }
    </text>;

    // =====================================================================
    // Die Mehrfachwahl des Katalogs (4.5)
    // =====================================================================

    private readonly Bereichswahl _wahl = new();
    private IReadOnlyList<string> _kaestchen = new List<string>();
    private Katalogliste? _liste;

    /// <summary>Die Mehrfachwahl des Katalogs — der Wirt reicht sie als <c>KatalogWahl</c> weiter.</summary>
    public Bereichswahl Wahl => _wahl;

    /// <summary>Schlüssel der sichtbaren (gefilterten) Katalogzeilen in Anzeigereihenfolge.</summary>
    public IReadOnlyList<string> Sichtbar => (_liste?.Angezeigt ?? _katalog).Select(z => z.Schluessel).ToList();

    /// <summary>Die Ziele einer Katalogaktion: die angekreuzten Sätze, sonst der gewählte.</summary>
    public IReadOnlyList<Katalogfilterzeile> Ziele()
    {
        if (_wahl.Anzahl > 0)
            return _wahl.Gewaehlte.Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s))
                        .OfType<Katalogfilterzeile>().ToList();
        return _zeile is null ? Array.Empty<Katalogfilterzeile>() : new[] { _zeile };
    }

    private async Task BeiKaestchen(IReadOnlyList<string> gewaehlt)
    {
        _kaestchen = gewaehlt;
        _wahl.Setzen(gewaehlt);
        await Nachziehen();
    }

    private void KaestchenLeeren()
    {
        _wahl.Leeren();
        _kaestchen = new List<string>();
    }

    private async Task BeiVergleichen()
    {
        IReadOnlyList<Katalogfilterzeile> ziele = Ziele();
        if (ziele.Count >= 2) _liste?.Vergleichen(ziele.Select(z => z.Schluessel).ToList());
        await Nachziehen();
    }

    /// <summary>Lässt den Wirt nachzeichnen — seine Slots tragen die Fragmente dieser Seite.</summary>
    private Task Nachziehen() => ZustandGeaendert.HasDelegate ? ZustandGeaendert.InvokeAsync() : Task.CompletedTask;

    private async Task WarnenUndNachziehen(string text)
    {
        Warnen(text);
        await Nachziehen();
    }

    private async Task BeiSchlossAbgelehnt(string grund) => await WarnenUndNachziehen(grund);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && FussImWirt) await Nachziehen();
    }

    private IReadOnlyList<Katalogfilterzeile> _katalog = Array.Empty<Katalogfilterzeile>();
    private IReadOnlyDictionary<string, IReadOnlyList<string>>? _verwendung;
    private Katalogfilterzeile? _zeile;
    private Katalogschloss? _katalogschloss;

    private string _meldung = "";
    private string _listeFehler = "";
    private WarnStufe _meldungStufe = WarnStufe.Hinweis;
    private string _status = "";
    private string _protokoll = "";

    private bool _loeschfrageOffen;
    private string _loeschfrage = "";

    private bool _importOffen;
    private bool _laeuft;
    private double? _anteil;
    private string _fortschrittText = "";
    private string _pfad = "";
    private string _importMeldung = "";
    private WarnStufe _importMeldungStufe = WarnStufe.Hinweis;

    // ---- Prüfhilfen ------------------------------------------------------

    /// <summary>Die Zeilen des Katalogs (Prüfhilfe).</summary>
    public IReadOnlyList<Katalogfilterzeile> Katalog => _katalog;

    /// <summary>Die gewählte Katalogzeile (Prüfhilfe).</summary>
    public Katalogfilterzeile? Zeile => _zeile;

    /// <summary>Das Warnband der Seite (Prüfhilfe).</summary>
    public string Meldung => _meldung;

    /// <summary>Der Grund, wenn die Liste nicht gelesen werden konnte (Prüfhilfe); leer = gelesen.</summary>
    public string Ladefehler => _listeFehler;

    /// <summary>Die Statuszeile (Prüfhilfe).</summary>
    public string Status => _status;

    /// <summary>Die Protokollzeile des letzten Imports (Prüfhilfe).</summary>
    public string Protokoll => _protokoll;

    /// <summary>Das Warnband der Import-Überlagerung (Prüfhilfe).</summary>
    public string Importmeldung => _importMeldung;

    /// <summary>Steht die Import-Überlagerung? (Prüfhilfe.)</summary>
    public bool ImportOffen => _importOffen;

    /// <summary>Steht die Rückfrage vor dem Löschen? (Prüfhilfe.)</summary>
    public bool Loeschfrage => _loeschfrageOffen;

    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe.)</summary>
    public bool Schlossfrage => _katalogschloss?.FrageOffen == true;

    /// <summary>
    /// Hält die Seite Esc bei sich? Solange eine Rückfrage oder der Import offen ist,
    /// schließt der Wirt nicht.
    /// </summary>
    public bool HaeltEsc => _loeschfrageOffen || _importOffen || _nennOffen || Schlossfrage
                            || _lauf?.EtwasOffen == true;

    private bool AnzeigenErlaubt => _pfad.Length > 0 && !_laeuft && Wege.MitSystemOeffnen is not null;
    private bool EinlesenErlaubt => _pfad.Length > 0 && !_laeuft && Wege.Einlesen is not null
                                    && (Wege.Lesen is null || _gelesen is not null);

    protected override async Task OnInitializedAsync() => await Neuladen();

    protected override void OnParametersSet()
    {
        if ((_zeile?.Bezeichner ?? "") != Gewaehlt)
            _zeile = Gewaehlt.Length == 0 ? null : _katalog.FirstOrDefault(z => z.Bezeichner == Gewaehlt);
    }

    /// <summary>
    /// Liest Katalog und Verwendung neu und stempelt die Spalte „im Projekt verwendet".
    /// Steht die Wahl nicht mehr in der Liste, erfährt es der Wirt.
    /// </summary>
    public async Task Neuladen()
    {
        // KT-4/KT-6: Liste und Verwendung über die Fangstelle — wirft die Quelle, ist die Liste leer, der
        // Banner nennt den Grund, und das Ausnahmeprotokoll hat einen Vermerk; der Aufbau bricht nicht ab.
        (_katalog, _listeFehler) = await Katalogladung.LesenAsync(Wege.Katalogzeilen, Liste);
        _verwendung = null;
        if (Wege.Verwendung is not null && _listeFehler.Length == 0)
        {
            (_verwendung, _listeFehler) = await Katalogladung.ZurListeAsync(Wege.Verwendung, Liste);
        }
        _wahl.Bereinigen(_katalog.Select(z => z.Schluessel));
        _kaestchen = _wahl.Gewaehlte.ToList();
        if (ImProjekt is not null)
            Katalogverwendung.Stempeln(_katalog, ImProjekt());

        Katalogfilterzeile? vorher = _zeile;
        _zeile = Gewaehlt.Length == 0 ? null : _katalog.FirstOrDefault(z => z.Bezeichner == Gewaehlt);
        if (vorher is not null && _zeile is null) await ZeileGewaehlt.InvokeAsync(null);
    }

    /// <summary>Wählt eine Zeile über ihren Bezeichner — der Weg der Liste und des Assistenten.</summary>
    public async Task Waehlen(string bezeichner)
    {
        Katalogfilterzeile? zeile = _katalog.FirstOrDefault(z => z.Bezeichner == bezeichner);
        if (zeile is null) return;
        _zeile = zeile;
        _meldung = "";
        await ZeileGewaehlt.InvokeAsync(zeile);
        await Nachziehen();
    }

    private Task BeiZeile(string bezeichner) => Waehlen(bezeichner ?? "");

    private void Warnen(string text)
    {
        _meldung = text ?? "";
        _meldungStufe = WarnStufe.Warnung;
    }

    // =====================================================================
    // Schloss setzen / aufheben
    // =====================================================================

    private async Task BeiSchlossGeschaltet(string status)
    {
        await Neuladen();
        _meldung = "";
        _status = status ?? "";
        await Geaendert.InvokeAsync();
        await Nachziehen();
    }

    // =====================================================================
    // Löschen
    // =====================================================================

    /// <summary>Warum <paramref name="zeile"/> nicht gelöscht werden darf; leer = frei.</summary>
    private string LoeschGrundVon(Katalogfilterzeile zeile)
    {
        string name = zeile.Bezeichner;
        if (ImProjekt is not null && ImProjekt().Contains(name, StringComparer.Ordinal))
            return string.Format(System.Globalization.CultureInfo.CurrentCulture, Texte.ImProjekt, name);
        if (zeile.Geschuetzt) return Texte.Schreibgeschuetzt;
        IReadOnlyList<string> projekte = Ganglinienblatt.Projekte(_verwendung, name);
        return projekte.Count == 0
            ? ""
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, Resource.ADM_AW_LOESCHEN_VERWENDET,
                            Ganglinienblatt.Projektliste(projekte));
    }

    private List<string> _loeschziele = new();
    private List<string> _loeschUebersprungen = new();

    /// <summary>Die Sätze, die die offene Rückfrage löschen würde (Prüfhilfe).</summary>
    public IReadOnlyList<string> Loeschziele => _loeschziele;

    /// <summary>
    /// „Löschen" auf der Auswahl (4.5): Gesperrte, verwendete und zugeordnete Sätze werden übersprungen
    /// und in der EINEN Rückfrage genannt; trifft die Sperre alle (oder den einen), nennt das Warnband den Grund.
    /// </summary>
    private async Task BeiLoeschen()
    {
        IReadOnlyList<Katalogfilterzeile> ziele = Ziele();
        if (_laeuft || ziele.Count == 0 || Wege.Loeschen is null) return;

        var frei = new List<string>();
        var uebersprungen = new List<string>();
        string ersterGrund = "";
        foreach (Katalogfilterzeile z in ziele)
        {
            string grund = LoeschGrundVon(z);
            if (grund.Length == 0 && Wege.HatProjektzuordnung is not null)
            {
                bool zugeordnet;
                try { zugeordnet = await Wege.HatProjektzuordnung(z.Bezeichner); }
                catch (Exception ex)
                {
                    Katalogladung.Loeschen(() => throw ex, z.Bezeichner, out grund);
                    zugeordnet = false;
                }
                if (zugeordnet) grund = Texte.Projektzuordnung;
            }
            if (grund.Length > 0)
            {
                if (ersterGrund.Length == 0) ersterGrund = grund;
                uebersprungen.Add(z.Bezeichner);
            }
            else frei.Add(z.Bezeichner);
        }

        if (frei.Count == 0) { await WarnenUndNachziehen(ersterGrund); return; }

        _meldung = "";
        _loeschziele = frei;
        _loeschUebersprungen = uebersprungen;
        _loeschfrage = frei.Count == 1
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Texte.Loeschfrage, frei[0])
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, Resource.AUSWAHL_FRAGE_LOESCHEN_N,
                            frei.Count, string.Join(", ", frei.Select(n => "\u201e" + n + "\u201c")));
        if (uebersprungen.Count > 0)
            _loeschfrage += " " + string.Format(System.Globalization.CultureInfo.CurrentCulture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                                string.Join(", ", uebersprungen.Select(n => "\u201e" + n + "\u201c")));
        _loeschfrageOffen = true;
        await Nachziehen();
    }

    private async Task LoeschfrageBeantwortet(bool? antwort)
    {
        _loeschfrageOffen = false;
        List<string> namen = _loeschziele;
        _loeschziele = new();
        _loeschUebersprungen = new();
        if (antwort != true || Wege.Loeschen is null || namen.Count == 0) { await Nachziehen(); return; }

        string fehler = "";
        var geloescht = new List<string>();
        foreach (string name in namen)
        {
            // KT-4: Wirft der Loeschweg, nennt die Meldung den Grund (Katalogladung.Loeschen).
            bool ok;
            try { ok = await Wege.Loeschen(name); }
            catch (Exception ex)
            {
                Katalogladung.Loeschen(() => throw ex, name, out string grund);
                fehler = grund;
                continue;
            }
            if (ok) geloescht.Add(name);
            else if (fehler.Length == 0) fehler = Texte.Schreibgeschuetzt;
        }
        if (geloescht.Count > 0) KaestchenLeeren();
        await Neuladen();
        if (fehler.Length > 0) Warnen(fehler);
        if (geloescht.Count > 0)
        {
            _status = geloescht.Count == 1
                ? string.Format(System.Globalization.CultureInfo.CurrentCulture, Texte.Geloescht, geloescht[0])
                : string.Format(System.Globalization.CultureInfo.CurrentCulture, Texte.Geloescht,
                                string.Join(", ", geloescht));
            await Geaendert.InvokeAsync();
        }
        await Nachziehen();
    }

    // =====================================================================
    // Import
    // =====================================================================

    private void ImportOeffnen()
    {
        if (Wege.Einlesen is null || _laeuft) return;
        _meldung = "";
        _importMeldung = "";
        _importOffen = true;
    }

    /// <summary>Kreuz, Esc und „Abbrechen" — nicht, solange die Kette läuft.</summary>
    private void ImportSchliessen()
    {
        if (_laeuft || _lauf?.Laeuft == true) return;
        _importOffen = false;
        _importMeldung = "";
    }

    private async Task BeiDatei(string pfad)
    {
        _importMeldung = "";
        _gelesen = null;
        if (string.IsNullOrEmpty(pfad)) { _pfad = ""; NennleistungLeeren(); return; }
        if (Wege.Ablegen is null) { _pfad = pfad; await NachDateiwahl(); return; }

        // Die verlustfreie Originalablage; ein Fehlschlag ist eine Warnung, der
        // Import laeuft dann mit der Originaldatei.
        AblageErgebnis erg = await Wege.Ablegen(pfad);
        _pfad = erg.Pfad.Length > 0 ? erg.Pfad : pfad;
        if (erg.Meldung.Length > 0)
        {
            _importMeldung = erg.Meldung;
            _importMeldungStufe = WarnStufe.Warnung;
        }
        await NachDateiwahl();
    }

    // ---------------------------------------------------------------------
    // Der Optionendialog "Format und Vorschau" (nur mit Wege.Lesen)
    // ---------------------------------------------------------------------

    private GanglinienImportLauf? _lauf;
    private GanglinienImportErgebnis? _gelesen;

    /// <summary>Die über den Optionendialog gelesene Reihe; <c>null</c> = noch keine (Prüfhilfe).</summary>
    public GanglinienImportErgebnis? Gelesen => _gelesen;

    /// <summary>Der Lauf der Importkette (Prüfhilfe): Steht der Optionendialog?</summary>
    public bool OptionenOffen => _lauf?.EtwasOffen == true;

    private Task<GanglinienImportErgebnis> LaufEinlesen(string pfad, GanglinienRaster raster, GanglinienImportRueckrufe rueckrufe)
        => Wege.Lesen!(pfad, rueckrufe);

    /// <summary>
    /// Nach der Dateiwahl: Mit <see cref="GanglinienKatalogwege.Lesen"/> liest der Optionendialog die
    /// Datei — Abbrechen bricht den Import ab, ein Fehler bleibt als Grund in der Überlagerung stehen —,
    /// danach die Vorbelegung der Nennleistung aus der gelesenen Reihe. Ohne den Weg wie bisher die
    /// Vorbelegung aus der Datei.
    /// </summary>
    private async Task NachDateiwahl()
    {
        if (Wege.Lesen is null || _lauf is null) { await NennleistungVorbelegen(); return; }

        NennleistungLeeren();
        GanglinienImportErgebnis? erg = await _lauf.Starten(_pfad, GanglinienRaster.Unbekannt);
        if (erg is null || erg.Ausgang == ImportAusgang.Abgebrochen)
        {
            // Abbrechen im Optionendialog bricht den Import ab: keine Datei, keine Überlagerung.
            _pfad = "";
            ImportSchliessen();
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (!erg.Erfolgreich)
        {
            _pfad = "";
            PruefMeldung? fehler = erg.Protokoll.FirstOrDefault(m => m.Stufe == PruefStufe.Fehler);
            _importMeldung = erg.Meldung.Length > 0 ? erg.Meldung
                           : fehler is not null ? GanglinienProtokollText.Text(fehler) : Resource.IMPORT_PROT_DATEI_LEER;
            _importMeldungStufe = WarnStufe.Fehler;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _gelesen = erg;
        if (Wege.NennleistungAusLesung is not null)
        {
            GanglinienNennleistungsvorschlag v = await Wege.NennleistungAusLesung(_pfad, erg);
            NennleistungUebernehmen(v);
        }
        await InvokeAsync(StateHasChanged);
    }

    // ---------------------------------------------------------------------
    // Die Nennleistung (nur PV-Ganglinie): Vorbelegung, Pruefung, Eingabe
    // ---------------------------------------------------------------------

    private double? _nennleistung;
    private double _spitzeKw;
    private string _nennHerkunft = "";
    private string _nennHinweis = "";

    /// <summary>Die abgefragte Nennleistung [kWp] (Prüfhilfe).</summary>
    public double? Nennleistung => _nennleistung;

    /// <summary>Der Prüfhinweis zur Nennleistung (Prüfhilfe); "" ohne.</summary>
    public string Nennleistungshinweis => _nennHinweis;

    private void NennleistungLeeren()
    {
        _nennleistung = null;
        _spitzeKw = 0;
        _nennHerkunft = "";
        _nennHinweis = "";
    }

    /// <summary>Nach der Dateiwahl: Vorbelegung aus Dateikopf oder Spitze, dann die Prüfung.</summary>
    private async Task NennleistungVorbelegen()
    {
        NennleistungLeeren();
        if (Wege.NennleistungVorschlagen is null || _pfad.Length == 0) return;
        GanglinienNennleistungsvorschlag v = await Wege.NennleistungVorschlagen(_pfad);
        NennleistungUebernehmen(v);
    }

    /// <summary>Belegt die Nennleistung mit einem Vorschlag vor (Dateikopf oder Spitze) und prüft sie.</summary>
    private void NennleistungUebernehmen(GanglinienNennleistungsvorschlag? v)
    {
        if (v is null || v.VorschlagKwp is null) return;
        _nennleistung = v.VorschlagKwp;
        _spitzeKw = v.SpitzeKw;
        _nennHerkunft = v.AusDateikopf
            ? Texte.NennleistungAusKopf
            : string.Format(System.Globalization.CultureInfo.CurrentCulture, Texte.NennleistungAusSpitze, v.SpitzeKw);
        NennleistungPruefen();
    }

    private void BeiNennleistung(double? wert)
    {
        _nennleistung = wert;
        NennleistungPruefen();
    }

    private void NennleistungPruefen()
        => _nennHinweis = Wege.NennleistungPruefen?.Invoke(_spitzeKw, _nennleistung) ?? "";

    private async Task BeiAnzeigen()
    {
        if (!AnzeigenErlaubt) return;
        await Wege.MitSystemOeffnen!(_pfad);
    }

    /// <summary>
    /// „Einlesen": Gelingt es, schließt die Überlagerung, der neue Satz ist gewählt, die
    /// Statuszeile nennt ihn, die Protokollzeile das Format. Scheitert es, bleibt sie offen
    /// und meldet den Grund — samt Protokoll, wenn die Datei gelesen wurde.
    /// </summary>
    private async Task BeiEinlesen()
    {
        if (!EinlesenErlaubt) return;

        _laeuft = true;
        _anteil = null;
        _fortschrittText = "";
        _importMeldung = "";
        _status = "";
        _protokoll = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            var melder = new Progress<ImportFortschritt>(f =>
            {
                _anteil = f.Anteil;
                _fortschrittText = f.Schluessel;
                _ = InvokeAsync(StateHasChanged);
            });

            // KT-6: Die Aufnahme in den Katalog über die Fangstelle — wirft der Weg, bleibt die Überlagerung
            // mit dem Grund offen (Katalogladung.SchreibenAsync), der Katalog bleibt, wie er war.
            string pfad = _pfad;
            GanglinienImportErgebnis? gelesen = _gelesen;
            double? nennleistung = _nennleistung;
            GanglinienKatalogimport erg = await Katalogladung.SchreibenAsync(
                () => gelesen is not null && Wege.EinlesenGelesen is not null
                    ? Wege.EinlesenGelesen(pfad, gelesen, nennleistung, melder)
                    : Wege.EinlesenMitNennleistung is not null && Wege.NennleistungVorschlagen is not null
                    ? Wege.EinlesenMitNennleistung(pfad, nennleistung, melder)
                    : Wege.Einlesen!(pfad, melder),
                System.IO.Path.GetFileName(pfad),
                g => new GanglinienKatalogimport(false, true, "", g, ""));
            if (erg.Erfolgreich)
            {
                _pfad = "";
                _gelesen = null;
                NennleistungLeeren();
                _importOffen = false;
                _protokoll = erg.Protokoll ?? "";
                await Neuladen();
                await Waehlen(erg.Bezeichner ?? "");
                _status = string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                        Resource.ADM_MSG_EINGELESEN, erg.Bezeichner);
                await Geaendert.InvokeAsync();
            }
            else
            {
                _importMeldung = erg.Protokoll.Length > 0 ? erg.Meldung + " " + erg.Protokoll : erg.Meldung;
                _importMeldungStufe = erg.IstFehler ? WarnStufe.Fehler : WarnStufe.Warnung;
            }
        }
        finally
        {
            _laeuft = false;
            _anteil = null;
            _fortschrittText = "";
        }
        await Nachziehen();
    }

    // =====================================================================
    // Die Nennleistung eines Katalogsatzes bearbeiten (nur PV-Ganglinie)
    // =====================================================================

    private bool _nennOffen;
    private string _nennZiel = "";
    private double? _nennWert;
    private string _nennBearbeitenHinweis = "";
    private string _nennFehler = "";

    /// <summary>Steht die Überlagerung „Nennleistung bearbeiten"? (Prüfhilfe.)</summary>
    public bool NennleistungOffen => _nennOffen;

    /// <summary>Der Prüfhinweis in der Überlagerung (Prüfhilfe); "" ohne.</summary>
    public string NennleistungBearbeitenHinweis => _nennBearbeitenHinweis;

    private void NennleistungOeffnen()
    {
        if (_zeile is null || Wege.NennleistungSchreiben is null) return;
        if (_zeile.Geschuetzt) { Warnen(Texte.NennleistungGesperrt); return; }
        _nennZiel = _zeile.Bezeichner;
        _nennWert = _zeile.Zahl(Katalogfilterprofil.SpNennleistungKwp);
        _nennFehler = "";
        _meldung = "";
        NennWertPruefen();
        _nennOffen = true;
    }

    private void BeiNennWert(double? wert)
    {
        _nennWert = wert;
        _nennFehler = "";
        NennWertPruefen();
    }

    private void NennWertPruefen()
        => _nennBearbeitenHinweis = Wege.NennleistungPruefenFuer?.Invoke(_nennZiel, _nennWert) ?? "";

    private void NennleistungSchliessen()
    {
        _nennOffen = false;
        _nennFehler = "";
        _nennBearbeitenHinweis = "";
    }

    /// <summary>
    /// OK schreibt — scheitert es, bleibt die Überlagerung mit dem Grund offen; sonst liest die Seite neu,
    /// meldet die Wahl erneut (der Detailblock des Wirts zeigt den neuen Wert) und hält den Prüfhinweis
    /// als Banner fest.
    /// </summary>
    private async Task BeiNennErgebnis(bool ok)
    {
        if (!ok || Wege.NennleistungSchreiben is null) { NennleistungSchliessen(); return; }
        // KT-6: Wirft der Schreibweg, bleibt die Überlagerung mit dem Grund offen (Katalogladung.SchreibenAsync).
        Func<string, double?, Task<GanglinienNennleistungsschrieb>> schreiben = Wege.NennleistungSchreiben;
        string ziel0 = _nennZiel;
        double? wert = _nennWert;
        GanglinienNennleistungsschrieb erg = await Katalogladung.SchreibenAsync(
            () => schreiben(ziel0, wert), ziel0, g => new GanglinienNennleistungsschrieb(false, g, ""));
        if (!erg.Erfolgreich)
        {
            _nennFehler = erg.Meldung;
            return;
        }
        string ziel = _nennZiel;
        NennleistungSchliessen();
        await Neuladen();
        _status = erg.Meldung;
        _meldung = erg.Hinweis;
        _meldungStufe = WarnStufe.Hinweis;
        Katalogfilterzeile? zeile = _katalog.FirstOrDefault(z => z.Bezeichner == ziel);
        if (zeile is not null)
        {
            _zeile = zeile;
            await ZeileGewaehlt.InvokeAsync(zeile);
        }
        await Geaendert.InvokeAsync();    await Nachziehen();
    }
}
