    }

    private void ZonenBezugsmengeSetzen(ZapfprofilZoneDaten z, double? wert)
    {
        if (z.Bezugsmenge != wert) PunktUeberholen();
        z.Bezugsmenge = wert;
        Geaendert();
    }

    private void ZonenNiveauSetzen(ZapfprofilZoneDaten z, int? id)
    {
        if (id is not int n || !Enum.IsDefined(typeof(ZapfprofilNiveau), n)) return;
        if (z.Niveau != (ZapfprofilNiveau)n) PunktUeberholen();
        z.Niveau = (ZapfprofilNiveau)n;
        Geaendert();
