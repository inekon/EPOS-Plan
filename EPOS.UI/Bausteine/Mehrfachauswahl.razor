@* Liste mit Haken - der Ersatz fuer die CheckedListBox des Bestands
   (iU9-W4.4, Bausteinluecke 11).

   WOZU. Wo mehrere Eintraege GLEICHZEITIG gelten duerfen, taugt weder eine
   Klappliste (eine Wahl) noch eine Optionsgruppe (eine Wahl). Der Bestand
   nimmt dafuer eine CheckedListBox — etwa die Uebernahme aus dem
   Energietraegerkatalog (Form_Energietraeger.KatalogUebernahme), die die noch
   nicht zugeordneten Traeger zur Auswahl stellt.

   BAUWEISE. Je Eintrag ein Schalter; sie stehen in einem rollenden Bereich,
   damit eine lange Liste den Dialog nicht sprengt. AbsatzNach setzt nach den
   ersten n Eintraegen eine Trennlinie - so steht eine Summenreihe sichtbar
   abgesetzt ueber ihren Summanden, ohne aus der Auswahl herauszufallen. Alles auswaehlen bzw.
   nichts auswaehlen sind zwei Knoepfe — die CheckedListBox konnte das nicht,
   und bei zwanzig Traegern ist es der Unterschied zwischen einem Klick und
   zwanzig.

   Die Auswahl gehoert dem Aufrufer: Gewaehlt kommt herein, GewaehltChanged
   meldet jede Aenderung. Der Baustein haelt keinen eigenen Zustand. *@

@namespace EPOS.UI.Bausteine

<div class="epos-mehrfachauswahl">
    @if (!string.IsNullOrEmpty(Bezeichnung))
    {
        <p class="epos-untergruppe">@Bezeichnung</p>
    }

    @if (MitSammelknoepfen && Eintraege.Count > 1)
    {
        <div class="epos-leiste">
            <button type="button" class="epos-knopf" @onclick="AlleWaehlen">@AlleText</button>
            <button type="button" class="epos-knopf" @onclick="KeineWaehlen">@KeineText</button>
        </div>
    }

    <div class="epos-mehrfachauswahl-liste" role="group" aria-label="@Bezeichnung">
        @for (int i = 0; i < Eintraege.Count; i++)
        {
            int eintragId = Eintraege[i].Id;
            string sperrgrund = Sperre(eintragId);

            @if (sperrgrund.Length > 0)
            {
                @* WEICHE Sperre (Hausregel EPOS.UI): Ein gesperrtes Kaestchen, das
                   seinen Grund nennen soll, darf nicht `disabled` sein - sein
                   Tooltip erschiene nie. aria-disabled plus title, und der Klick
                   laeuft ins Leere statt umzuschalten. *@
                <label class="epos-schalter" title="@sperrgrund">
                    <input class="epos-schalter-kasten" type="checkbox"
                           checked="@Gewaehlt.Contains(eintragId)"
                           aria-disabled="true" @onclick:preventDefault
                           @onclick="Nichts" />
                    <span class="epos-feld-text">@Eintraege[i].Text</span>
                </label>
            }
            else
            {
                <Schalter Bezeichnung="@Eintraege[i].Text" Wert="@Gewaehlt.Contains(eintragId)"
                          Aktiv="@Aktiv"
                          WertChanged="@(w => Umschalten(eintragId, w))" />
            }

            @if (AbsatzNach > 0 && i == AbsatzNach - 1 && i < Eintraege.Count - 1)
            {
                <hr class="epos-mehrfachauswahl-absatz" />
            }
        }
    </div>

    @if (Eintraege.Count == 0)
    {
        <Herleitungszeile Text="@LeerText" />
    }
</div>

@code {
    /// <summary>Ueberschrift ueber der Liste; leer = ohne.</summary>
    [Parameter] public string Bezeichnung { get; set; } = "";

    /// <summary>Die waehlbaren Eintraege in Anzeigereihenfolge.</summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Eintraege { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Die Ids der gewaehlten Eintraege.</summary>
    [Parameter] public IReadOnlyList<int> Gewaehlt { get; set; } = Array.Empty<int>();

    /// <summary>Meldet die neue Auswahl.</summary>
    [Parameter] public EventCallback<IReadOnlyList<int>> GewaehltChanged { get; set; }

    /// <summary>Bedienbar? <c>false</c> sperrt die ganze Liste.</summary>
    [Parameter] public bool Aktiv { get; set; } = true;

    /// <summary>
    /// Setzt nach so vielen Eintraegen eine Trennlinie; 0 = ohne. Damit steht eine
    /// SUMMENreihe sichtbar abgesetzt ueber ihren Summanden, ohne aus der Liste
    /// herauszufallen - „Alle" und „Keine" fassen sie weiter mit. Hinter dem letzten
    /// Eintrag wird nicht getrennt.
    /// </summary>
    [Parameter] public int AbsatzNach { get; set; }

    /// <summary>Zeigt „Alle" und „Keine" ueber der Liste.</summary>
    [Parameter] public bool MitSammelknoepfen { get; set; } = true;

    [Parameter] public string AlleText { get; set; } = "Alle";
    [Parameter] public string KeineText { get; set; } = "Keine";

    /// <summary>Satz, wenn es nichts zu waehlen gibt.</summary>
    [Parameter] public string LeerText { get; set; } = "Keine Einträge zur Auswahl.";

    /// <summary>
    /// <b>Der Grund, warum EIN Eintrag nicht umschaltbar ist</b> (Auftrag PI-1) —
    /// leer oder <c>null</c> heisst „frei". Ohne den Delegaten ist jeder Eintrag
    /// frei, und die Liste verhaelt sich wie bisher.
    ///
    /// <para><b>Warum ein Grund und kein <c>bool</c>.</b> Eine Sperre ohne Grund
    /// ist eine Sackgasse: Der Anwender sieht ein Haekchen, das sich nicht bewegt,
    /// und erfaehrt nicht, warum. Der Satz steht als <c>title</c> am Eintrag, und
    /// die Sperre ist WEICH (<c>aria-disabled</c> statt <c>disabled</c>) — ein
    /// hart gesperrtes Element zeigt seinen Tooltip nicht.</para>
    /// </summary>
    [Parameter] public Func<int, string>? Sperrgrund { get; set; }

    /// <summary>Der Sperrgrund eines Eintrags; leer = frei.</summary>
    private string Sperre(int id)
    {
        if (Sperrgrund is null) return "";
        try { return Sperrgrund(id) ?? ""; }
        catch { return ""; }
    }

    /// <summary>Der Klick auf ein weich gesperrtes Kaestchen laeuft ins Leere.</summary>
    private void Nichts() { }

    private Task Umschalten(int id, bool an)
    {
        var neu = new List<int>(Gewaehlt);
        if (an) { if (!neu.Contains(id)) neu.Add(id); }
        else neu.Remove(id);
        return GewaehltChanged.InvokeAsync(neu);
    }

    private Task AlleWaehlen()
    {
        var neu = new List<int>();
        foreach ((int id, _) in Eintraege) neu.Add(id);
        return GewaehltChanged.InvokeAsync(neu);
    }

    /// <summary>
    /// „Keine" laesst die GESPERRTEN Eintraege stehen — sonst naehme der
    /// Sammelknopf weg, was der Einzelklick nicht wegnehmen darf.
    /// </summary>
    private Task KeineWaehlen()
    {
        var bleibt = new List<int>();
        foreach ((int id, _) in Eintraege)
            if (Sperre(id).Length > 0 && Gewaehlt.Contains(id)) bleibt.Add(id);
        return GewaehltChanged.InvokeAsync(bleibt);
    }
}
