    /// Wärmebild). <c>null</c> = kein Bild.
    /// </summary>
    [Parameter] public Func<bool, Zeichenmodell?>? BildauftragKaelte { get; set; }

    /// <summary>
    /// Die ANZEIGEEINHEIT beim Öffnen — MWh (Vorgabe) oder kWh (Anwenderentscheid
    /// W8‑O‑5 vom 04.09.2026).
    /// </summary>
    [Parameter] public Energieeinheit Einheit { get; set; } = Energieeinheit.MWh;

    /// <summary>Meldet der Hülle die neu gewählte Einheit, damit sie gemerkt wird.</summary>
    [Parameter] public Action<Energieeinheit>? EinheitGewaehlt { get; set; }

    /// <summary>Der Dialog wurde geschlossen — immer mit <c>true</c>, er hat nur OK.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Wärmebedarf Gebäude";
    [Parameter] public string GruppeKennzahlen { get; set; } = "Kennzahlen";
    [Parameter] public string GruppeMonate { get; set; } = "monatlicher Verlauf:";
    [Parameter] public string LabelHeizwaerme { get; set; } = "Wärmebedarf Heizung:";
    [Parameter] public string LabelMaxLast { get; set; } = "max. Wärmelast";
    [Parameter] public string LabelVollbenutzung { get; set; } = "Vollbenutzungsstunden:";

    /// <summary>Beschriftung der Rechenwegzeile (<c>GEB_LBL_RECHENWEG</c>, Stufe G1).</summary>
    [Parameter] public string LabelRechenweg { get; set; } = "Rechenweg:";

    /// <summary>Beschriftung der Warmwasserzeile des Projekts (<c>GEBB_LBL_WARMWASSER_PROJEKT</c>, #573).</summary>
    [Parameter] public string LabelWarmwasserProjekt { get; set; } = "Warmwasser des Projekts:";

    /// <summary>Die Zeile unter den Kennzahlen, wenn das Projekt Warmwasser rechnet.</summary>
    [Parameter] public string HinweisWarmwasserProjekt { get; set; } =
        "Kanal Warmwasser der Projektsimulation, aus den Brauchwasserprofilen bzw. dem Zapfprofil — nicht Teil der Gebäudesimulation und nicht in den Zahlen und Bildern dieses Dialogs.";

    /// <summary>Die Zeile unter den Kennzahlen, wenn dem Projekt kein Profil zugeordnet ist.</summary>
    [Parameter] public string HinweisWarmwasserOhneProfil { get; set; } =
        "Dem Projekt ist kein Brauchwasserprofil zugeordnet — die Simulation rechnet ohne Warmwasser.";
    [Parameter] public string LabelSortiert { get; set; } = "sortiert";
    [Parameter] public string LabelEinheit { get; set; } = "Einheit:";
    [Parameter] public string EinheitKw { get; set; } = "kW";
    [Parameter] public string EinheitStunden { get; set; } = "h/a";
    [Parameter] public string Bildtext { get; set; } = "Wärmelast Jahresganglinie";
    [Parameter] public string BildtextRaumtemperatur { get; set; } = "Raumtemperatur";

