    /// </summary>
    /// <remarks>
    /// <b>Der Speicherweg ist DERSELBE, den „Speichern" ruft</b> — samt der Prüfung,
    /// die darin steckt. Der Assistent ersetzt sie nicht, er löst sie aus; sein
    /// <c>dialog_speichern</c> trägt dafür Bestätigung UND Sicherungspunkt
    /// (Anwenderentscheid KI‑D‑Q4).
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _stand.NurLesen,
        Speichern = KiSpeichern
    };

    /// <summary>Der Speicherweg für <c>dialog_speichern</c> — derselbe wie „Speichern".</summary>
    private Task<KiKern.KiErgebnis> KiSpeichern()
    {
        if (Speichern is null)
            return Task.FromResult(KiKern.KiErgebnis.Abgelehnt(
                Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", _stand.Titel)));

        if (_stand.NurLesen)
            return Task.FromResult(KiKern.KiErgebnis.Abgelehnt(Resource.KI_DLG_KV_NURLESEN_ERL));

        if (!Speichern())
        {
            StatusSetzen(Resource.ADM_STATUS_FEHLER, fehler: true);
            return Task.FromResult(KiKern.KiErgebnis.Fehlgeschlagen(_status));
        }

        // Nach dem Schreiben denselben Weg wie der Knopf: neu laden, Statuszeile setzen.
        KontextLaden(_stand.VarianteId);
        GespeichertMelden();

        return Task.FromResult(KiKern.KiErgebnis.Ok(_status, anzahl: 1));
    }

    protected override void OnInitialized()
    {
        _eintragId = EintragVorwahl ?? (Eintraege.Count > 0 ? Eintraege[0].Id : null);
        _invest = InvestVorwahl;
        KontextLaden(null);
        // Welle KI-F4: Die VARIANTE haengt am Stand, ihre Liste aber auch - eine
        // Begleiteigenschaft VarianteIdWahl gaebe es doppelt. Sie kommt deshalb als
        // benannte Wahlquelle herein.
        // Welle KI-F7: Angemeldet ist seither die SICHTKLASSE. Sie reicht den Stand
        // durch und traegt die drei Groessen, die NICHT an ihm haengen - die
        // Komponentenwahl der Kontextleiste und die zwei Wahlen des Reiters „Ertrag".
        _kiMaske = KiMaskenanmeldung.Fuer(
            KiMaskennamen.KOSTENVERWALTUNG, KiSicht, KiHaken(),
            ("variante", () => KiMaskenanmeldung.Eintraege(
                _stand.Varianten, z => z.Id, z => z.Text)));
    }

