    /// <summary>
    /// <c>SetControls</c>:1063-1104 — Katalog und Bestand laden, dann die
    /// VORWAHLREGEL: Id vor Verwendung vor „erster" vor Neuanlage.
    /// </summary>
    private void Laden()
    {
        if (Dienste is null) return;

        _katalog = Dienste.Katalogzeilen();
        _projekt = Dienste.Projektliste();
        _idPuffer = IdPuffer;

        int gewaehlt = 0;
        if (IdPuffer > 0 && _projekt.Any(z => z.Id == IdPuffer))
        {
            gewaehlt = IdPuffer;
        }
        else if (!string.IsNullOrEmpty(Verwendung))
        {
            // Der Absprung aus dem Senkendialog gibt die gesuchte Verwendung mit; die
            // Huelle hat die Liste bereits danach beurteilt und stellt den passenden
            // Speicher voran (siehe ErsterMitVerwendung in der Huelle).
            gewaehlt = ErsterPassender();
        }
        else if (_projekt.Count > 0)
        {
            gewaehlt = _projekt[0].Id;
        }

        if (gewaehlt > 0) PufferWaehlen(gewaehlt);
        else NeuVorbereiten();
    }

    /// <summary>
    /// Der erste Speicher mit der gewünschten Verwendung. Die Zuordnung trifft die
    /// Hülle: Sie kennt <c>WaermesenkeClass.WirksameVerwendung</c>; hier steht nur die
    /// Reihenfolge.
    /// </summary>
    [Parameter] public IReadOnlyList<int> PasstZurVerwendung { get; set; } = Array.Empty<int>();

    private int ErsterPassender()
    {
        foreach (PspProjektzeile z in _projekt)
            if (PasstZurVerwendung.Contains(z.Id)) return z.Id;
        return 0;
    }

    // --- Bestand ----------------------------------------------------------------

    /// <summary>Einen vorhandenen Speicher laden (<c>PufferAnzeigen</c>:1242-1300).</summary>
    private void PufferWaehlen(int id)
    {
        PspPufferstand? p = Dienste?.PufferLesen(id);
        if (p is null) return;

        _bearbeiteteId = p.Id;
        _idPuffer = p.Id;

        _katalogzeile = -1;                        // ein vorhandener Speicher wird nicht neu uebernommen
        _bezeichner = p.Bezeichner;
        _volumen = p.Gesamtvolumen;
        _verluste = p.Bereitschaftsverluste;
        _klassenSet = Set(p.Heizung, p.Brauchwasser, p.Prozess);

        _vorlauf = p.Vorlauf > 0 ? p.Vorlauf : null;
        _ruecklauf = p.Ruecklauf > 0 ? p.Ruecklauf : null;

        _schwelleEin = p.SchwelleEin;
        _schwelleAus = p.SchwelleAus;
        _schwelleNachrang = p.SchwelleAusNachrang;
        _schwelleReserve = p.SchwelleReserve;
        _entladeprio = p.Entladeprio;

        SchichtdatenAnzeigen(p.Schicht);
        AnzeigenAktualisieren();
    }

    /// <summary>
    /// <c>NeuVorbereiten</c>:1178-1239 — die Vorbelegung eines neuen Speichers,
    /// wörtlich: Verluste „0", Vorlauf/Rücklauf aus den Systemvorgaben oder LEER,
    /// die vier Schwellen auf ihre Vorgaben, Priorität automatisch.
    /// </summary>
    private void NeuVorbereiten()
    {
        _bearbeiteteId = 0;
        _katalogzeile = -1;
        _bezeichner = "";
        _volumen = null;
        _verluste = 0;

        // Die Vorbelegung der Nutzung folgt dem Wunsch des Absprungs; ohne Wunsch
        // Heizung (VerwendungWaehlen:1193-1199 samt KlassenSetSetzen:1205).
        _klassenSet = VorbelegteNutzung;

        // Aus den SYSTEMVORGABEN des Projekts. Fehlen sie, bleiben die Felder LEER -
        // eine erfundene Vorbelegung waere bei einem Niedertemperatursystem falsch.
        (int? v, int? r) = Dienste?.Systemvorgaben() ?? (null, null);
        _vorlauf = v;
        _ruecklauf = r;

        _schwelleEin = SchwelleEinVorgabe;
        _schwelleAus = SchwelleAusVorgabe;
        _schwelleNachrang = SchwelleAusVorgabe;
        _schwelleReserve = SchwelleReserveVorgabe;
        _entladeprio = 0;

        SchichtdatenAnzeigen(new PspSchichtdaten());
        AnzeigenAktualisieren();
    }

    /// <summary>Die drei Schwellenvorgaben — sie stehen im Kern, die Hülle reicht sie herein.</summary>
    [Parameter] public double SchwelleEinVorgabe { get; set; } = 10.0;

    /// <summary>Vorgabe der Abschaltschwelle (auch für die nachrangige).</summary>
    [Parameter] public double SchwelleAusVorgabe { get; set; } = 95.0;

    /// <summary>Vorgabe des Mindestfüllstands.</summary>
    [Parameter] public double SchwelleReserveVorgabe { get; set; } = 10.0;

    /// <summary>Die Nutzung, mit der ein NEUER Speicher aufgeht (aus <see cref="Verwendung"/>).</summary>
    [Parameter] public IReadOnlyList<int> VorbelegteNutzung { get; set; } = new[] { 0 };

    private static IReadOnlyList<int> Set(bool h, bool b, bool p)
    {
        var l = new List<int>();
        if (h) l.Add(0);
        if (b) l.Add(1);
        if (p) l.Add(2);
        return l;
    }

    private void SchichtdatenAnzeigen(PspSchichtdaten d)
    {
        _schichten = d.Schichten < 1 ? 1 : d.Schichten;
        _hoehe = d.Hoehe;
        _lambda = d.LambdaEff;
        _tNutzBW = d.TNutzBW;
        _entnahmeHeizung = d.EntnahmeHeizung;
        _entnahmeBW = d.EntnahmeBW;
        _entnahmeProzess = d.EntnahmeProzess;

        // 0 = unbegrenzt und wird als LEERES Feld gezeigt: Eine "0" in einem
        // Leistungsfeld liest sich wie "keine Leistung" und meint das Gegenteil.
        _ladeleistung = d.LadeleistungMax > 0 ? d.LadeleistungMax : null;
        _entladeleistung = d.EntladeleistungMax > 0 ? d.EntladeleistungMax : null;
    }

    private void KatalogWaehlen(int? zeile)
    {
        _katalogzeile = zeile;
        if (zeile is null || zeile.Value < 0 || zeile.Value >= _katalog.Count) return;

        // cbKatalog_SelectedIndexChanged:1566-1591 - drei Felder aus der Katalogzeile.
        PspKatalogzeile k = _katalog[zeile.Value];
        _bezeichner = k.Bezeichner;
        _volumen = k.Gesamtvolumen;
        _verluste = k.Bereitschaftsverluste;

        AnzeigenAktualisieren();
    }

    private void KlassenSetSetzen(IReadOnlyList<int> set)
    {
        // Das LEERE Set wird hier NICHT abgefangen: Wer von "nur Heizung" auf "nur
        // Brauchwasser" umstellt, muss zwischendurch durch das leere Set gehen. Die
        // Pflichtpruefung sitzt im Uebernehmen.
        _klassenSet = set;
        AnzeigenAktualisieren();
    }

    private void PrioWaehlen(int? prio)
    {
        _entladeprio = prio ?? 0;
        AnzeigenAktualisieren();
    }

    private void Setzen(Action was)
