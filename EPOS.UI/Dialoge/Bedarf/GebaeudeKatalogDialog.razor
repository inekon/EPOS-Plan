    protected override void OnInitialized()
    {
        _typen = Gebaeudetypen?.Invoke() ?? Array.Empty<string>();
        _arten = Gebaeudearten?.Invoke() ?? Array.Empty<string>();

        StandSetzen(Daten ?? new GebaeudeKatalogDaten());

        // Stufe G3: die Zonen eines Gebaeudes im Projekt - ein Katalogsatz traegt keine.
        _arbeit.ZonenLaden(Zonen?.Zonen, Modus == GebaeudeKatalogModus.Projekt && Zonen is not null, Zonen?.Luftstroeme);
        _projektaufbauten = (Zonen?.Projektaufbauten ?? Array.Empty<AufbauWahl>()).ToList();

        if (Modus == GebaeudeKatalogModus.Admin)
        {
            _namen = Katalognamen?.Invoke() ?? Array.Empty<string>();
            if (_namen.Count > 0)
            {
                _namensindex = 0;
                SatzLaden(_namen[0]);
            }
        }

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE_KATALOG,
                                          () => KiSicht(), KiHaken());
    }

    /// <summary>Übernimmt einen Satz als Arbeitsstand — beim Öffnen und beim Namenswechsel.</summary>
    private void StandSetzen(GebaeudeKatalogDaten satz)
    {
        _arbeit.Laden(satz, Modus == GebaeudeKatalogModus.Neu);
        _ursprungsname = _stand.Name ?? "";
    }

    // =================================================================================
    // Der Hilfe-Assistent liest und setzt den Arbeitsstand (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GebaeudeKatalogKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten. Beide Reiterblätter greifen auf den ARBEITSSTAND zu — er
    /// wird beim Namenswechsel ausgetauscht, deshalb Delegaten und keine Instanz. Gebaut
    /// wird sie vom Arbeitsstand selbst (<see cref="GebaeudeArbeitsstand.KiSicht"/>) —
    /// dieselbe Sicht, die das Stammblatt der Gebäudeverwaltung anmeldet (#465); hier
    /// kommen nur Name, Betriebsart und die Einträge der Klapplisten dazu.
    /// </summary>
    private GebaeudeKatalogKiSicht KiSicht()
    {
        return _kiSicht ??= _arbeit.KiSicht(new GebaeudeKiWege
        {
            NameLesen = () => _stand.Name,
            NameSetzen = KiNameSetzen,
            BetriebsartLesen = () => Modus.ToString(),

            TypEintraege = () => KiMaskenanmeldung.Eintraege(
                Typeintraege, e => e.Text, e => e.Text),
            GebaeudeartEintraege = () => KiMaskenanmeldung.Eintraege(
                Arteintraege, e => e.Text, e => e.Text),
            BaualtersklasseEintraege = () => KiMaskenanmeldung.Eintraege(
                Klasseneintraege, e => e.Id, e => e.Text),
            BauartEintraege = () => KiMaskenanmeldung.Eintraege(
                Bauarteintraege, e => e.Id, e => e.Text),
            VerwendungEintraege = KiVerwendungseintraege,

            // Welle #458 Stufe 3b: die Randbedingung des Hüll-Rasters und die Ferien.
            RandbedingungEintraege = () => KiMaskenanmeldung.Eintraege(
                Randeintraege, e => e.Id, e => e.Text),
            Ferienname = Ferienname,
            Texte = Texte
        });
    }

    /// <summary>Die Verwendungen: Schlüssel ist der STEUERWERT, Text der Eintrag der Maske.</summary>
    private IReadOnlyList<KiWahleintrag> KiVerwendungseintraege()
    {
        var liste = new List<KiWahleintrag>();
        for (int i = 0; i < Verwendungswerte.Count && i < Verwendungen.Count; i++)
            liste.Add(new KiWahleintrag(Verwendungswerte[i], Verwendungen[i]));
        return liste;
    }

    /// <summary>In der KATALOGVERWALTUNG WÄHLT der Name den Satz, sonst BENENNT er ihn.</summary>
    private void KiNameSetzen(string wert)
    {
        if (Modus != GebaeudeKatalogModus.Admin) { _stand.Name = wert ?? ""; return; }

        for (int i = 0; i < _namen.Count; i++)
            if (string.Equals(_namen[i], wert, StringComparison.Ordinal)) { NamenWaehlen(i); return; }
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf. <b>„Speichern" ist der OK-Weg
    /// ohne Schließen</b>: dieselben Prüfregeln, derselbe Schreibweg; der Dialog bleibt
    /// stehen. <c>Pruefen</c> ist dieselbe Prüfung wie am OK-Knopf.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => Pruefen(Modus == GebaeudeKatalogModus.Neu) ? "" : _meldung,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (Speichern is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", TitelText));

        bool istNeu = Modus == GebaeudeKatalogModus.Neu;
        bool ok = Modus == GebaeudeKatalogModus.Projekt
            ? SchreibenProjekt()
            : Schreiben(istNeu, istNeu ? _stand.Name : _ursprungsname);
        return ok ? KiKern.KiErgebnis.Ok(_stand.Name, anzahl: 1)
                  : KiKern.KiErgebnis.Abgelehnt(_meldung);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =================================================================================
    // Klapplisten
    // =================================================================================

    private IReadOnlyList<(int Id, string Text)> Eintraege(IReadOnlyList<string> quelle, string bestand)
    {
        var l = new List<(int, string)>();

        // Ein Bestandswert, den die Liste nicht (mehr) fuehrt, wird vorangestellt.
        if (!string.IsNullOrEmpty(bestand) && !quelle.Contains(bestand)) l.Add((-1, bestand));
        for (int i = 0; i < quelle.Count; i++) l.Add((i, quelle[i]));
        return l;
    }

    private static int? Index(IReadOnlyList<string> quelle, string wert)
    {
        if (string.IsNullOrEmpty(wert)) return null;
        for (int i = 0; i < quelle.Count; i++)
            if (string.Equals(quelle[i], wert, StringComparison.Ordinal)) return i;
        return -1;
    }

    private IReadOnlyList<(int Id, string Text)> Typeintraege => Eintraege(_typen, _stand.Typ);
    private int? Typindex => Index(_typen, _stand.Typ);

    private IReadOnlyList<(int Id, string Text)> Arteintraege => Eintraege(_arten, _stand.Gebaeudeart);
    private int? Artindex => Index(_arten, _stand.Gebaeudeart);

    private IReadOnlyList<(int Id, string Text)> Namenseintraege => Liste(_namen);
    private IReadOnlyList<(int Id, string Text)> Klasseneintraege => Liste(Baualtersklassen);
    private IReadOnlyList<(int Id, string Text)> Bauarteintraege => Liste(Bauarten);
    private IReadOnlyList<(int Id, string Text)> Verwendungseintraege => Liste(Verwendungen);

    private static IReadOnlyList<(int Id, string Text)> Liste(IReadOnlyList<string> quelle)
    {
        var l = new List<(int, string)>();
        for (int i = 0; i < quelle.Count; i++) l.Add((i, quelle[i]));
        return l;
    }

    private IReadOnlyList<(int Id, string Text)> Rechenwegeintraege => new[]
    {
        (0, Texte.RechenwegVdi6007),
        (1, Texte.RechenwegTagesbilanz)
    };

