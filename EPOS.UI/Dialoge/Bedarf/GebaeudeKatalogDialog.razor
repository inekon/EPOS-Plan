    private void TypWaehlen(int? i)
    {
        if (i is null) { Daten.Typ = ""; return; }
        if (i.Value >= 0 && i.Value < _typen.Count) Daten.Typ = _typen[i.Value];
    }

    private void ArtWaehlen(int? i)
    {
