#35105=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('201f0d3e-74e4-4c6e-af66-141192f0e99f'),$);
#35106=IFCPROPERTYENUMERATEDVALUE('LoadBearingType','Kennung f\X\FCr die Tragf\X\E4higkeit des Bauteils',(IFCLABEL('elbNone')),$);
#35107=IFCPROPERTYSINGLEVALUE('Name','Name des Bauteils',IFCLABEL('F 018-1'),$);
