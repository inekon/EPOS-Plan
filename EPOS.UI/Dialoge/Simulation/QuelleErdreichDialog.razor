    private IReadOnlyList<(int Id, string Text)> Klimazonen
    {
        get
        {
            var l = new List<(int, string)> { (0, ZoneNichtZugeordnet) };
            for (int z = 1; z <= VDI4640Pruefung.KLIMAZONEN; z++) l.Add((z, Zonentext(z)));
            return l;
        }
    }

    /// <summary>Die 15 Zonen für die Karte — Pfad und Volllaststunden.</summary>
    private IReadOnlyList<KlimazonenkarteDialog.Zone> Kartenzonen
    {
        get
        {
            var l = new List<KlimazonenkarteDialog.Zone>();
            foreach ((int zone, string pfad) in KlimazonenPfade.Alle())
                l.Add(new KlimazonenkarteDialog.Zone(
                    zone, pfad, VDI4640Pruefung.VolllaststundenZone(zone)));
            return l;
        }
