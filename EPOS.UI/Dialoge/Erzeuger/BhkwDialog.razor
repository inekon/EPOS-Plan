    private void KatalogNeuLaden()
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, TitelText, out _listeFehler);
        VerwendungStempeln();
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
    }

    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _varianten = Varianten is not null ? Varianten(zeile.CarrierId) : Array.Empty<(int, string)>();
        _detail = Katalogladung.Satz(() => ProjektDetail is not null ? ProjektDetail(zeile.Bezeichner) : null,
                                     zeile.Bezeichner, out _satzFehler) ?? Leer(zeile.Bezeichner);
        KostenNachziehen();
        FelderNachziehen();
    }

    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _projektZeile = null;
        _varianten = Array.Empty<(int, string)>();
        _detail = Katalogladung.Satz(() => KatalogDetail is not null ? KatalogDetail(_katalogGewaehlt) : null,
                                     _katalogGewaehlt, out _satzFehler)
                  ?? Leer(_katalogGewaehlt);
        FelderNachziehen();
    }

    private static ErzeugerDetail Leer(string name)
        => new(name, "", Array.Empty<(string, string)>());

    // =================================================================================
    // Hinzufuegen und Entfernen (Sammeluebernahme: eine Traegerwahl je Traegergruppe)
    // =================================================================================

    private void BeiHinzu()
    {
        if (Vorbereiten is null || TraegerGaben is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        _aufnahmen.Clear();
        _traegerJeGruppe.Clear();
        foreach (Katalogfilterzeile z in ziele) _aufnahmen.Enqueue(z.Id);
        NaechsteAufnahme();
    }

    private readonly Queue<int> _aufnahmen = new();
    private readonly Dictionary<string, EnergietraegerVarianteErgebnis> _traegerJeGruppe = new(StringComparer.Ordinal);
    private int _aufnahmeId;
    private string _aufnahmeGruppe = "";

    private void NaechsteAufnahme()
    {
        while (_aufnahmen.Count > 0)
        {
            int id = _aufnahmen.Dequeue();
            TraegerVorbereitung vor = Vorbereiten!(id);
            if (!string.IsNullOrEmpty(vor.Meldung))
            {
                Melden(vor.Meldung, true);
                continue;
            }
            string gruppe = string.Join(",", vor.Energietraeger.Select(e => e.Id));
            if (_traegerJeGruppe.TryGetValue(gruppe, out EnergietraegerVarianteErgebnis? bekannt))
            {
                Aufnahme(id, bekannt);
                continue;
            }
            _aufnahmeId = id;
            _aufnahmeGruppe = gruppe;
            _traegerGaben = TraegerGaben!(vor);
            return;
        }
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
    }

    private void TraegerFertig(EnergietraegerVarianteErgebnis? ergebnis)
    {
        _traegerGaben = null;
        if (ergebnis is null || Aufnehmen is null)
        {
            _aufnahmen.Clear();
            return;
        }
        _traegerJeGruppe[_aufnahmeGruppe] = ergebnis;
        Aufnahme(_aufnahmeId, ergebnis);
        NaechsteAufnahme();
    }

    private void Aufnahme(int stammId, EnergietraegerVarianteErgebnis ergebnis)
    {
        if (Aufnehmen is null) return;
        AufnahmeErgebnis aufnahme = Aufnehmen(stammId, ergebnis);
        if (!string.IsNullOrEmpty(aufnahme.Meldung)) Melden(aufnahme.Meldung, aufnahme.Fehler);
        if (aufnahme.Zeile is null) return;
        Zeilen.Add(aufnahme.Zeile);
        VerwendungStempeln();                 // Q12
        ProjektZeileWaehlen(aufnahme.Zeile);
        SummeNachziehen();
    }

    private void BeiEntfernen()
    {
        List<ErzeugerZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;
        foreach (ErzeugerZeile zeile in ziele)
        {
            Zeilen.Remove(zeile);
            Entfernen?.Invoke(zeile);
        }
        VerwendungStempeln();                 // Q12
        _projektWahl.Leeren();
        _projektZeile = null;
        _detail = Leer("");
        _varianten = Array.Empty<(int, string)>();
        SummeNachziehen();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
        else if (_katalog.Count > 0) KatalogZeileWaehlen(_katalog[0].Bezeichner);
    }

    // =================================================================================
    // Zeilenwerte der Anlage (nur Projektsatz)
    // =================================================================================

    private void BeiTraegerwechsel(int? neu)
    {
        if (_projektZeile is null || !neu.HasValue) return;
        if (neu.Value == _projektZeile.CarrierId) return;   // programmatische Vorwahl
        TraegerWechseln?.Invoke(_projektZeile, neu.Value);
        _projektZeile.CarrierId = neu.Value;
    }

    private void BeiGrenzleistung(double? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Grenzleistung = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    /// <summary>
    /// Die Herleitung der Grenzleistung (W6-E-7): Steht am Modul 0, rechnet es mit der
    /// Projektvorgabe; <c>null</c> = keine Zeile (eigener Wert oder Vorgabe unbekannt).
    /// </summary>
    private string? Grenzleistungherleitung
    {
        get
        {
            if (_projektZeile is null) return null;
            if (Projektvorgabe is null) return null;
            if ((_projektZeile.Grenzleistung ?? 0) != 0) return null;
            return Projektvorgabe.Value == 0
                ? HerleitungKeine
                : string.Format(CultureInfo.CurrentCulture, HerleitungVorgabe, Projektvorgabe.Value);
        }
    }

    private void BeiVorlauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Vorlauf = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    private void BeiRuecklauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Ruecklauf = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    // =================================================================================
    // Alle Daten: beim Katalogsatz der Katalog, beim Projektsatz die Projektkopie
    // =================================================================================

    private void ParameterUmschalten()
    {
        _parameterOffen = !_parameterOffen;
        if (_parameterOffen) FelderHolen();
    }

    private void FelderHolen()
    {
        _felder = _projektZeile is not null
            ? Katalogladung.SatzDazu(() => ProjektsatzWege?.Lesen(_projektZeile.GeraetId), _projektZeile.Bezeichner,
                                     ref _satzFehler)
            : Katalogfelder is null || _katalogZeile is null
                ? null
                : Katalogladung.SatzDazu(() => Katalogfelder(_katalogZeile.Bezeichner), _katalogZeile.Bezeichner,
                                         ref _satzFehler);
        _felderGeaendert = false;
        _feldFehler = false;
    }

    private void FelderNachziehen()
    {
        if (_parameterOffen && (_katalogZeile is not null || _projektZeile is not null)) { FelderHolen(); return; }
        _felder = null;
        _felderGeaendert = false;
        _feldFehler = false;
    }

    private void BeiFeldFehler((string Feldname, bool Fehler) meldung)
        => _feldFehler = meldung.Fehler;

    private void FeldGeaendert()
    {
        _felderGeaendert = true;
    }

    private void FelderSpeichern()
    {
        _letzterSpeicherfehler = null;
        if (_felder is null) return;
        KatalogSpeicherErgebnis ergebnis;
        if (_projektZeile is not null)
        {
            if (ProjektsatzWege?.Speichern is null) return;
            ergebnis = Katalogladung.Schreiben(
                () => ProjektsatzWege.Speichern(new[] { (_projektZeile.GeraetId, _felder) }), _projektZeile.Bezeichner,
                g => new KatalogSpeicherErgebnis(false, g, _projektZeile.Bezeichner));
        }
        else
        {
            if (KatalogfelderSpeichern is null || _katalogZeile is null) return;
            ergebnis = Katalogladung.Schreiben(
                () => KatalogfelderSpeichern(_katalogZeile.Bezeichner, _felder), _katalogZeile.Bezeichner,
                g => new KatalogSpeicherErgebnis(false, g, _katalogZeile.Bezeichner));
        }
        if (!ergebnis.Ok)
        {
            Melden(ergebnis.Meldung, true);
            _letzterSpeicherfehler = ergebnis.Meldung;
            return;
        }
        _felderGeaendert = false;
        _meldung = "";
        _felderErfolg = ergebnis.Meldung;
        if (_projektZeile is not null) ProjektNeuLesen();
        else KatalogNeuLaden();
    }

    /// <summary>Grund der letzten Ablehnung von <see cref="FelderSpeichern"/>; <c>null</c> = gespeichert.</summary>
    private string? _letzterSpeicherfehler;

    // =================================================================================
    // Die Satz-Ueberlagerung (UeS1): „Bearbeiten…" eines Satzes und „Vergrößern"
    // =================================================================================

    private Zweispaltenauswahl? _zweispalten;

    /// <summary>Steht die Satz-Überlagerung offen? Dann trägt sie das Fragment und ihr OK speichert.</summary>
    private bool _satzGross;

    /// <summary>Grund einer abgelehnten Übernahme, in der Fußleiste der Überlagerung.</summary>
    private string? _satzUeberlagerungFehler;

    /// <summary>Der Stand der anlagenbezogenen Felder der Projektzeile beim Öffnen der Überlagerung.</summary>
    private Anlagenmerker? _anlagenmerker;

    /// <summary>Steht die Satz-Überlagerung offen? (Prüfhilfe.)</summary>
    public bool SatzUeberlagerungOffen => _satzGross;

    /// <summary>
    /// Die Überlagerung ist aufgegangen: „Alle Daten" aufgeklappt — frisch gelesen, wenn der
    /// Aufklapper zu war; ein offener Aufklapper behält seine Eingaben.
    /// Träger, Grenzleistung, Vorlauf und Rücklauf gehen schon bei der Eingabe in die Anlage — der Merker hält ihren Stand für „Abbrechen".
    /// </summary>
    private void BeiSatzVergroessert()
    {
        _satzGross = true;
        _satzUeberlagerungFehler = null;
        _anlagenmerker = _projektZeile is not null ? Anlagenmerker.Von(_projektZeile) : null;
        if (AlleDatenDa && (!_parameterOffen || _felder is null))
        {
            _parameterOffen = true;
            FelderHolen();
        }
    }

    /// <summary>
    /// OK der Überlagerung: derselbe Speicherweg wie der Knopf der Satzfläche
    /// (<see cref="FelderSpeichern"/> über <c>Katalogladung.Schreiben</c>, KT‑4-Fangweg).
    /// Lehnt er ab, bleibt die Überlagerung mit dem Grund offen.
    /// </summary>
    private void BeiSatzUebernommen()
    {
        if (FelderSpeicherbar && _felder is not null && _felderGeaendert)
        {
            FelderSpeichern();
            if (_letzterSpeicherfehler is not null)
            {
                _satzUeberlagerungFehler = _letzterSpeicherfehler;
                _zweispalten?.SatzOffenHalten();
                return;
            }
        }
        _satzGross = false;
        _satzUeberlagerungFehler = null;
        _anlagenmerker = null;
        KostenNachziehen();   // die Kostenknoepfe der Ueberlagerung koennen die Summen geaendert haben
    }

    /// <summary>
    /// Abbrechen, ✕, Esc oder Schließen der Überlagerung: der Satz wird neu gelesen, Änderungen
    /// verworfen — auch die anlagenbezogenen Felder stehen wieder wie beim Öffnen.
    /// </summary>
    private void BeiSatzVerworfen()
    {
        _satzGross = false;
        _satzUeberlagerungFehler = null;
        if (_anlagenmerker is { } merker && _projektZeile is not null)
            merker.Zurueckschreiben(_projektZeile, TraegerWechseln, Uebernehmen);
        _anlagenmerker = null;
        if (_felder is not null) FelderHolen();
        KostenNachziehen();
    }

    /// <summary>Nach dem Speichern einer Projektkopie: Kenndaten und Summe neu.</summary>
    private void ProjektNeuLesen()
    {
        if (_projektZeile is null) return;
        _detail = Katalogladung.SatzDazu(() => ProjektDetail is not null ? ProjektDetail(_projektZeile.Bezeichner) : null,
                                         _projektZeile.Bezeichner, ref _satzFehler) ?? _detail;
        SummeNachziehen();
    }

    // =================================================================================
    // Katalogpflege und Bearbeiten je Bereich (4.6, KA-E-8, KA-E-13)
    // =================================================================================

    /// <summary>
    /// „Bearbeiten…" im Katalogfuss: ein einzelner ungesperrter Satz oeffnet den vollen
    /// Katalogeditor (KA-E-13), mehrere oder gesperrte Saetze die Satzbearbeitung -
    /// gesperrte uebersprungen, alle gesperrt nur lesend.
    /// </summary>
    private async Task BeiKatalogBearbeiten()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1 && !ziele[0].Geschuetzt && EditorGaben is not null)
        {
            _editorGaben = EditorGaben(ziele[0].Bezeichner);
            return;
        }
        // UeS1: EIN gesperrter Satz oeffnet nur lesend in der Satz-Ueberlagerung („Erst Schloss aufheben").
        if (ziele.Count == 1 && ziele[0].Geschuetzt && Katalogfelder is not null && _zweispalten is not null)
        {
            if (_katalogZeile?.Bezeichner != ziele[0].Bezeichner) KatalogZeileWaehlen(ziele[0].Bezeichner);
            await _zweispalten.SatzUeberlagerungOeffnen();
            return;
        }
        if (KatalogsatzWege is not null)
        {
            _bearbeitung = (Satzmarke.Katalogsatz,
                            ziele.Select(z => new Bearbeitungssatz(z.Id, z.Bezeichner, z.Geschuetzt)).ToList());
            return;
        }
        if (ziele.All(z => z.Geschuetzt)) BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
    }

    /// <summary>„Bearbeiten…" im Projektbereich: EINE Projektkopie öffnet die Satz-Überlagerung (UeS1), mehrere die Satzbearbeitung.</summary>
    private async Task BeiProjektBearbeiten()
    {
        if (ProjektsatzWege is null) return;
        List<ErzeugerZeile> ziele = ProjektZiele();
        var saetze = ziele.GroupBy(z => z.GeraetId)
            .Select(g => new Bearbeitungssatz(g.Key, g.First().Bezeichner, false)).ToList();
        if (saetze.Count == 0) return;
        // UeS1: EINE Projektkopie oeffnet die Satz-Ueberlagerung, mehrere die Satzbearbeitung.
        if (saetze.Count == 1 && _zweispalten is not null)
        {
            if (_projektZeile?.GeraetId != saetze[0].Id) ProjektZeileWaehlen(ziele.First(z => z.GeraetId == saetze[0].Id));
            await _zweispalten.SatzUeberlagerungOeffnen();
            return;
        }
        _bearbeitung = (Satzmarke.Projektsatz, saetze);
    }

    /// <summary>
    /// UeS2: der Stift einer Projektzeile — sie wird gewählt (ohne die Kästchen der
    /// Mehrfachwahl anzufassen) und ihre Projektkopie öffnet in der Satz-Überlagerung.
    /// </summary>
    private async Task BeiProjektStift(ErzeugerZeile zeile)
    {
        if (ProjektsatzWege is null || _zweispalten is null) return;
        if (_projektZeile != zeile) ProjektZeileWaehlen(zeile);
        await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// UeS2: der Stift einer Katalogzeile (die Katalogliste hat sie schon gewählt) — ein
    /// gesperrter Satz öffnet nur lesend in der Satz-Überlagerung, ein ungesperrter den
    /// Katalogeditor (KA‑E‑13); ohne Editor die Überlagerung.
    /// </summary>
    private async Task BeiKatalogStift(Katalogfilterzeile zeile)
    {
        if (_katalogZeile?.Bezeichner != zeile.Bezeichner) KatalogZeileWaehlen(zeile.Bezeichner);
        if (!zeile.Geschuetzt && EditorGaben is not null)
        {
            _editorGaben = EditorGaben(zeile.Bezeichner);
            return;
        }
        if (Katalogfelder is not null && _zweispalten is not null)
        {
            await _zweispalten.SatzUeberlagerungOeffnen();
            return;
        }
        if (zeile.Geschuetzt) BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
    }

    // =================================================================================
    // Die Zusammenfassung der Detailzeile (UeS2)
    // =================================================================================

    /// <summary>Die Kostensummen der gewählten Projektzeile — gelesen bei der Wahl und nach der Überlagerung.</summary>
    private (double Invest, double Betrieb)? _kosten;

    private void KostenNachziehen()
    {
        _kosten = null;
        if (Wizard || Kostensumme is null || _projektZeile is null) return;
        try { _kosten = Kostensumme(_projektZeile); }
        catch { _kosten = null; }   // die Zusammenfassung ist Anzeige; ohne Summe fehlt die Angabe
    }

    /// <summary>Der Wert des Detailfelds mit dieser Beschriftung; <c>null</c>, wenn es fehlt oder leer ist.</summary>
    private string? Detailwert(string beschriftung)
        => _detail.Felder.Where(f => f.Feld == beschriftung && !string.IsNullOrWhiteSpace(f.Wert))
                         .Select(f => f.Wert).FirstOrDefault();

    /// <summary>
    /// <b>Die Kurzangaben des gewählten Satzes</b> für die Detailzeile. Projektsatz: P_el/P_th,
    /// Brennstoff, Träger, Grenzleistung, Vorlauf/Rücklauf, Invest, Betrieb, Senken. Katalogsatz:
    /// Hersteller, Brennstoff, P_el, P_th aus den Spalten des Katalogprofils. Ohne Satz eine leere
    /// Liste — nie <c>null</c>, sonst zeichnete der Baustein das Fragment in der Detailzeile.
    /// </summary>
    internal IReadOnlyList<Satzangabe> Zusammenfassung()
    {
        var liste = new List<Satzangabe>();
        CultureInfo k = CultureInfo.CurrentCulture;
        if (_projektZeile is ErzeugerZeile p)
        {
            var leistung = new List<string>();
            if (Detailwert(Resource.BHKWV_LBL_PEL) is { } pel) leistung.Add(pel + " kWel");
            if (Detailwert(Resource.BHKWV_LBL_PTHERM) is { } pth) leistung.Add(pth + " kWth");
            if (leistung.Count > 0) liste.Add(new(Resource.AUSWAHL_ZF_LEISTUNG, string.Join(" / ", leistung)));
            if (Detailwert(LabelBrennstofftyp) is { } brennstoff) liste.Add(new(Resource.AUSWAHL_ZF_BRENNSTOFF, brennstoff));
            string traeger = _varianten.Where(v => v.Id == p.CarrierId).Select(v => v.Text).FirstOrDefault() ?? "";
            if (traeger.Length > 0) liste.Add(new(Resource.AUSWAHL_ZF_TRAEGER, traeger));
            if (p.Grenzleistung is double grenze)
                liste.Add(new(Resource.AUSWAHL_ZF_GRENZLEISTUNG, grenze.ToString("0.##", k) + " %"));
            Satzangaben.Temperaturpaar(liste, p.Vorlauf, p.Ruecklauf);
            Satzangaben.Kosten(liste, _kosten);
            Satzangaben.Senken(liste, p.Senken);
        }
        else if (_katalogZeile is Katalogfilterzeile z && Katalogprofil is not null)
        {
            Satzangaben.Katalog(liste, z, Katalogprofil, Katalogfilterprofil.SpHersteller, Katalogfilterprofil.SpPel,
                                Katalogfilterprofil.SpPtherm, Katalogfilterprofil.SpBrennstoff);
        }
        return liste;
    }

    /// <summary>Die Satzbearbeitung ist zu; gespeichert: Listen, Detail und Summe neu.</summary>
    private void BearbeitungFertig(bool gespeichert)
    {
        Satzmarke? art = _bearbeitung?.Art;
        _bearbeitung = null;
        if (!gespeichert) return;
        if (art == Satzmarke.Katalogsatz)
        {
            KatalogNeuLaden();
            if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
        }
        else if (_projektZeile is not null)
        {
            ProjektZeileWaehlen(_projektZeile);
        }
        SummeNachziehen();
    }

    /// <summary>„In die Datenbank übernehmen…" (KA-E-9): die Rueckfrage zu den Projektkopien der Auswahl.</summary>
    private void BeiRueckweg()
    {
        if (RueckwegWege is null) return;
        var ids = ProjektZiele().Select(z => z.GeraetId).Where(id => id > 0).Distinct().ToList();
        if (ids.Count == 0) return;
        IReadOnlyList<Rueckwegvorschlag> zeilen = RueckwegWege.Vorschau(ids);
        if (zeilen.Count == 0) return;
        _rueckweg = zeilen;
    }

    private void RueckwegFertig(string? meldung)
    {
        _rueckweg = null;
        if (meldung is null) return;
        Melden(meldung, false);
        KatalogNeuLaden();
    }

    private void BeiVergleichen()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count >= 2) _katalogliste?.Vergleichen(ziele.Select(z => z.Schluessel).ToList());
    }

    private void BeiNeuemNamen(string? name)
    {
        _namensfrage = false;
        if (name is null || EditorGabenNeu is null) return;
        _editorGaben = EditorGabenNeu(name);
    }

    private void EditorFertig(string? name)
    {
        _editorGaben = null;
        if (name is null) return;
        KatalogNeuLaden();
        foreach (var z in _katalog)
            if (z.Bezeichner == name) { KatalogZeileWaehlen(z.Bezeichner); return; }
    }

    /// <summary>„Löschen": ein Satz fragt nach; bei mehreren werden gesperrte uebersprungen und genannt.</summary>
    private void BeiLoeschenGefragt()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1)
        {
            _loeschziele = ziele;
            _loeschUebersprungen = new();
        }
        else
        {
            _loeschziele = ziele.Where(z => !z.Geschuetzt).ToList();
            _loeschUebersprungen = ziele.Where(z => z.Geschuetzt).ToList();
            if (_loeschziele.Count == 0)
            {
                BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
                return;
            }
        }
        _loeschfrage = true;
    }

    private string LoeschfrageText
    {
        get
        {
            string text = _loeschziele.Count <= 1
                ? string.Format(FrageLoeschen, _loeschziele.FirstOrDefault()?.Bezeichner ?? "")
                : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, _loeschziele.Count,
                                string.Join(", ", _loeschziele.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschUebersprungen.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                            string.Join(", ", _loeschUebersprungen.Select(z => "„" + z.Bezeichner + "“")));
            return text;
        }
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || KatalogLoeschen is null || ziele.Count == 0) return;
        string fehler = "";
        bool fokusWeg = false;
        int geloescht = 0;
        foreach (Katalogfilterzeile z in ziele)
        {
            // KT-4: Wirft der Löschweg, kommt sein Grund wie eine Ablehnung zurück.
            string grund = Katalogladung.Loeschen(() => KatalogLoeschen(z.Id) ?? "", z.Bezeichner, g => g);
            if (grund.Length > 0) { fehler = grund; continue; }
            geloescht++;
            if (z.Bezeichner == _katalogGewaehlt) fokusWeg = true;
        }
        if (fehler.Length > 0) Melden(fehler, true);
        if (geloescht == 0) return;
        KatalogKaestchenLeeren();
        if (fokusWeg)
        {
            _katalogZeile = null;
            _katalogGewaehlt = "";
            _detail = Leer("");
        }
        KatalogNeuLaden();
    }

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Der Abbrechen-Weg: schliesst ohne zu speichern. Esc und das ✕ im Kopf rufen ihn.</summary>
    private Task Abbrechen() => BeiErgebnis(false);

    /// <summary>Esc schliesst; die Ueberlagerungen werten ihn zuerst fuer sich aus. Enter bleibt unbelegt.</summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_traegerGaben is not null || _editorGaben is not null || _bearbeitung is not null || _rueckweg is not null ||
            _namensfrage || _loeschfrage || _satzGross)
            return Task.CompletedTask;
        return Abbrechen();
    }

    // =================================================================================
    // Schloss setzen / aufheben (AD-Q15) - derselbe Baustein wie in den Verwaltungen
    // =================================================================================

    [Parameter] public Schlossweg? Schloss { get; set; }
    private Katalogschloss? _katalogschloss;
    private bool KatalogsatzGesperrt => _katalogZeile?.Geschuetzt == true;
    /// <summary>Ist die Rueckfrage des Schlosses offen (Prüfhilfe)?</summary>
    public bool Schlossfrage => _katalogschloss?.FrageOffen == true;

    private void BeiSchlossGeschaltet(string status)
    {
        KatalogNeuLaden();
        FelderNachziehen();
        _meldung = status ?? "";
        _meldungStufe = WarnStufe.Hinweis;
    }

    private void BeiSchlossAbgelehnt(string grund)
    {
        _meldung = grund ?? "";
        _meldungStufe = WarnStufe.Warnung;
    }
}
