@* GEBAEUDEEXPORT (gbXML oder IFC) - die Daten EINES Projektgebaeudes als Datei ausgeben
   (Gebaeudesimulation G7a/G7c; Softwarearchitektur 3.2; Ueberlagerung im Gebaeudedialog hinter dem
   Knopf "Exportieren...").

   DAS FORMAT waehlt eine Optionsgruppe (Formate der Huelle: Steuerwert GebaeudeQuelle.FORMAT_*,
   Anzeigetext und Umfang aus den Ressourcen; Vorgabe der erste Eintrag, gbXML). Der Umfang steht als
   Text daneben. Ein Formatwechsel bildet den Plan sofort neu - die Meldungen unterscheiden sich je
   Format - und nimmt die Bestaetigung zurueck. Fuehrt das Format eine Exportzusage (IFC: die IDS der
   Auslieferung), steht ein Knopf, der sie oeffnet (Windows) bzw. teilt (iOS). Ohne Formatliste
   (aeltere Wirte) steht das Format als Text. Frei ist dazu die Postleitzahl; sie wird nicht
   gespeichert und bestimmt, ob die Datei einen Standort und eine Nordrichtung traegt.

   VOR DEM SCHREIBEN steht die Meldungsliste des Kerns (GebaeudeExportAblauf.Vorbereiten): was fehlt,
   ersetzt oder gewechselt wird, der Vorbehalt der Ersatzschichtung - und eine Ablehnung. Eine
   Ablehnung nennt ihren Grund im Banner und bietet KEIN Speichern an; die Leiste traegt dann nur
   "Schliessen". Sonst ist "Speichern..." weich gesperrt, bis der Anwender die Meldungen bestaetigt;
   der Versuch nennt den Grund. Die Bestaetigung ist eine Handlung des Anwenders - der Assistent
   liest sie, setzt sie aber nicht.

   DER PLAN FOLGT DER POSTLEITZAHL: Die Huelle liest den Satz einmal (Vorbereiten beim Oeffnen) und
   bildet den Plan zu jeder Eingabe neu, ohne Datenbank; die Neubildung laeuft entprellt
   (Entprellung, Vorgabe 400 ms, 0 = sofort). Speichern bildet den Plan zur letzten Eingabe noch
   einmal selbst.

   GESCHRIEBEN WIRD NUR IM OK-WEG ("Speichern..."): Der Speicherweg der Huelle fragt die Dateiwahl der
   Plattform und schreibt; eine abgebrochene Dateiwahl laesst den Dialog offen und still, ein Fehler
   steht im Banner - ein abgebrochenes Schreiben (Schemapruefung des IFC-Schreibers) samt seinen
   Meldungen in der Liste, ohne Datei und ohne Teilen -, ein Erfolg schliesst den Dialog und gibt die Rueckmeldung (mit Pfad) an den
   Wirt. Abbrechen, Esc und das Kreuz geben null und rufen den Speicherweg nie.

   DIE ORIGINALDATEI ANREICHERN (Stufe G7d, Datenaustauschkonzept 6.6): Fuehrt das gewaehlte Format die
   Anreicherung (IFC) und hat das Gebaeude eine Importquelle des Formats (Gabe AnreicherungMoeglich), steht
   eine zweite Wahl "Eigene Datei schreiben" / "Originaldatei anreichern" (Vorgabe: eigene Datei). Beim
   Anreichern waehlt der Anwender die Originaldatei erneut (Gabe OriginalWaehlen); der Dialog zeigt
   Dateiname, Importquelle und die Meldungen der Vorschau. Eine Verweigerung nennt ihren Grund und bietet
   "Stattdessen eigene Datei schreiben" (wechselt mit denselben Eingaben auf die erste Wahl); eine Freigabe
   verlangt die Bestaetigung des Beipackzettels - erst dann ruft "Speichern..." den Anreicherungsweg
   (Gabe Anreichern), der unter neuem Namen speichert.

   TASTATUR: Esc schliesst wie Abbrechen. Enter ist nicht belegt. *@

@namespace EPOS.UI.Dialoge.Export
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-gebexport-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@Texte.Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@Texte.Titel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Abbrechen" />
        }
    </div>

    @if (Ablehnungstext.Length > 0)
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@Ablehnungstext" />
    }
    else if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    @if (Formate.Count > 1)
    {
        <Optionsgruppe Bezeichnung="@Texte.Format" Eintraege="@Formateintraege" Auswahl="@Formatindex"
                       AuswahlChanged="BeiFormat" Aktiv="@(!_speichertGerade)" />
        <dl class="epos-gebexport-kopf">
            <dt>@Texte.Stufe</dt><dd>@Umfangtext</dd>
        </dl>
    }
    else
    {
        <dl class="epos-gebexport-kopf">
            <dt>@Texte.Format</dt><dd>@(AktuellesFormat?.Text ?? Texte.FormatGbxml)</dd>
            <dt>@Texte.Stufe</dt><dd>@Umfangtext</dd>
        </dl>
    }

    @if (AktuellesFormat is { MitZusage: true } && ZusageOeffnen is not null)
    {
        <div class="epos-gebexport-zusage">
            <button type="button" class="epos-knopf epos-gebexport-zusageknopf" disabled="@_speichertGerade"
                    @onclick="BeiZusage">@Texte.Zusage</button>
            <Herleitungszeile Text="@Texte.ZusageHinweis" />
        </div>
    }

    @if (AnreicherungSichtbar)
    {
        <Optionsgruppe Bezeichnung="@Texte.Weg" Eintraege="@Wegeintraege" Auswahl="@_weg"
                       AuswahlChanged="BeiWeg" Aktiv="@(!_speichertGerade && !_waehltGerade)" />
        @if (Anreichernd)
        {
            <div class="epos-gebexport-anreicherung">
                <Herleitungszeile Text="@Texte.AnreicherungHinweis" />
                <button type="button" class="epos-knopf epos-gebexport-originalknopf"
                        disabled="@(_speichertGerade || _waehltGerade)" @onclick="BeiOriginalWaehlen">@Texte.OriginalWaehlen</button>
                @if (_wahl is not null)
                {
                    <dl class="epos-gebexport-kopf epos-gebexport-original">
                        <dt>@Texte.Originaldatei</dt><dd class="epos-gebexport-originalname">@_wahl.Dateiname</dd>
                        <dt>@Texte.Importquelle</dt><dd class="epos-gebexport-quelle">@_wahl.Quelle</dd>
                    </dl>
                    @if (_wahl.Grund is string grund)
                    {
                        <Warnbanner Stufe="WarnStufe.Fehler" Text="@Format(Texte.Verweigert, grund)" />
                        <button type="button" class="epos-knopf epos-gebexport-stattknopf"
                                disabled="@_speichertGerade" @onclick="BeiStattEigene">@Texte.StattEigene</button>
                    }
                    @if (_wahl.Meldungen.Count > 0)
                    {
                        <div class="epos-raster-huelle">
                            <table class="epos-raster epos-gebexport-anrmeldungen">
                                <thead>
                                    <tr>
                                        <th>@Texte.SpalteStufe</th>
                                        <th>@Texte.SpalteMeldung</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < _wahl.Meldungen.Count; i++)
                                    {
                                        GebaeudeExportMeldung m = _wahl.Meldungen[i];
                                        <tr @key="i" class="@Meldungsklasse(m)" data-schluessel="@m.Schluessel">
                                            <td>@m.Stufentext</td>
                                            <td class="epos-gebexport-meldungstext">@m.Text</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    @if (!_wahl.Verweigert)
                    {
                        <Schalter Bezeichnung="@Texte.BeipackBestaetigen" Wert="@_beipackBestaetigt"
                                  WertChanged="BeiBeipack" Aktiv="@(!_speichertGerade)" />
                    }
                }
            </div>
        }
    }

    <Formularraster Einspaltig="true">
        <KindInhalt>
            <Textfeld Bezeichnung="@Texte.Plz" Wert="@_plz" WertChanged="BeiPlz" Kurz="true" Hoechstlaenge="12" />
            <Herleitungszeile Text="@Texte.PlzHinweis" />
        </KindInhalt>
    </Formularraster>

    @if (GespeicherterStand)
    {
        <p class="epos-leisezeile epos-gebexport-gespeichert">@Texte.GespeicherterStand</p>
    }

    <Gruppenkopf Titel="@Texte.GruppeMeldungen" />
    @if (_ansicht is null)
    {
        <p class="epos-leisezeile epos-gebexport-vorbereitung">@Texte.Vorbereitung</p>
    }
    else if (_ansicht.Meldungen.Count == 0)
    {
        <p class="epos-leisezeile">@Texte.KeineMeldungen</p>
    }
    else
    {
        <div class="epos-raster-huelle">
            <table class="epos-raster epos-gebexport-meldungen">
                <thead>
                    <tr>
                        <th>@Texte.SpalteStufe</th>
                        <th>@Texte.SpalteMeldung</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < _ansicht.Meldungen.Count; i++)
                    {
                        GebaeudeExportMeldung m = _ansicht.Meldungen[i];
                        <tr @key="i" class="@Meldungsklasse(m)" data-schluessel="@m.Schluessel">
                            <td>@m.Stufentext</td>
                            <td class="epos-gebexport-meldungstext">@m.Text</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_ansicht is { Abgelehnt: false })
    {
        <Schalter Bezeichnung="@Texte.Bestaetigen" Wert="@_bestaetigt" WertChanged="BeiBestaetigung"
                  Aktiv="@(!_speichertGerade)" />
    }

    @if (_ansicht is { Abgelehnt: true })
    {
        @* Eine Ablehnung bietet kein Speichern an: der einzige Knopf schliesst wie Abbrechen. *@
        <SpeichernLeiste OkText="@Texte.Schliessen" MitAbbrechen="false" Ergebnis="_ => Abbrechen()" />
    }
    else
    {
        <SpeichernLeiste OkText="@Texte.Speichern" AbbrechenText="@Texte.Abbrechen"
                         OkErlaubt="@(_ansicht is not null && !_speichertGerade)" OkSperrgrund="@OkSperrgrund"
                         Ergebnis="BeiErgebnis" />
    }
</div>

@code {
    // =====================================================================
    // Gaben - die Datenseite liegt in der Huelle (GebaeudeExportHuelle)
    // =====================================================================

    /// <summary>
    /// Bildet den Plan zur Postleitzahl und gibt seine Ansicht (Meldungen, Ablehnung). Der erste Aufruf
    /// liest die Daten; jeder weitere bildet den Plan ohne Datenbank neu. Kein Delegat = keine Meldungen,
    /// und Speichern bleibt gesperrt.
    /// </summary>
    [Parameter] public Func<GebaeudeExportEingabe, Task<GebaeudeExportAnsicht>>? Vorbereiten { get; set; }

    /// <summary>
    /// Der Speicherweg: Plan zur Postleitzahl, Dateiwahl der Plattform, Schreiben (auf iOS danach Teilen).
    /// Gerufen NUR im OK-Weg, nach der Bestätigung.
    /// </summary>
    [Parameter] public Func<GebaeudeExportEingabe, Task<GebaeudeExportErgebnis>>? Speichern { get; set; }

    /// <summary>
    /// Die wählbaren Formate (Stufe G7c) in Anzeigereihenfolge; das erste ist die Vorgabe. Leer = ein
    /// fester Weg ohne Wahl (der Text <see cref="GebaeudeExportTexte.FormatGbxml"/> steht im Kopf).
    /// </summary>
    [Parameter] public IReadOnlyList<GebaeudeExportFormat> Formate { get; set; } = Array.Empty<GebaeudeExportFormat>();

    /// <summary>
    /// Öffnet (Windows) bzw. teilt (iOS) die Exportzusage des Formats — die IDS der Auslieferung. Gibt
    /// <c>null</c> bei Erfolg, sonst den benannten Grund (fehlende Datei, kein Programm). Kein Delegat =
    /// kein Knopf.
    /// </summary>
    [Parameter] public Func<Task<string?>>? ZusageOeffnen { get; set; }

    /// <summary>
    /// Hat das Gebäude eine Importquelle, deren Originaldatei angereichert werden kann (Stufe G7d)? Gerufen
    /// einmal beim Öffnen. Kein Delegat oder <c>false</c> = keine Wahl des Ausgabewegs.
    /// </summary>
    [Parameter] public Func<Task<bool>>? AnreicherungMoeglich { get; set; }

    /// <summary>
    /// Die Wahl der Originaldatei: Dateiwähler der Plattform, Importquelle und Vorschau (Sperren oder
    /// Beipackzettel). <c>null</c> = die Dateiwahl ist abgebrochen.
    /// </summary>
    [Parameter] public Func<Task<GebaeudeAnreicherungWahl?>>? OriginalWaehlen { get; set; }

    /// <summary>
    /// Der Anreicherungsweg (Stufe G7d): Anreichern der gewählten Originaldatei, Dateiwahl unter neuem Namen,
    /// Schreiben (auf iOS danach Teilen). Gerufen NUR im OK-Weg, nach beiden Bestätigungen.
    /// </summary>
    [Parameter] public Func<GebaeudeExportEingabe, Task<GebaeudeExportErgebnis>>? Anreichern { get; set; }

    /// <summary>Hat der Wirt ungespeicherte Änderungen an dieser Zeile? Dann steht der Hinweis „gespeicherter Stand".</summary>
    [Parameter] public bool GespeicherterStand { get; set; }

    /// <summary>Das Ergebnis: die Rückmeldung nach dem Schreiben; <c>null</c> bei Abbrechen, Esc und dem Kreuz.</summary>
    [Parameter] public EventCallback<GebaeudeExportErgebnis?> Geschlossen { get; set; }

    /// <summary>Die Anzeigetexte (ein Bündel).</summary>
    [Parameter] public GebaeudeExportTexte Texte { get; set; } = new();

    /// <summary>Zeigt der Dialog seinen eigenen Kopf — Titel UND Schließkreuz?</summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "GebaeudeExport.btn_Help";

    /// <summary>Entprellung der Neubildung nach einer Eingabe der Postleitzahl [ms]; 0 = sofort (Prüfstand).</summary>
    [Parameter] public int Entprellung { get; set; } = 400;

    // --- Stand -----------------------------------------------------------------

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private string _plz = "";
    private string _format = "";
    private bool _bestaetigt;
    private bool _speichertGerade;
    private GebaeudeExportAnsicht? _ansicht;
    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Warnung;
    private CancellationTokenSource? _entprellung;
    private int _fassung;

    /// <summary>Der Ausgabeweg als Position der Optionsgruppe — nie als Anzeigetext.</summary>
    private const int WEG_EIGEN = 0, WEG_ANREICHERN = 1;
    private int _weg = WEG_EIGEN;
    private bool _anreicherbar;
    private bool _waehltGerade;
    private bool _beipackBestaetigt;
    private GebaeudeAnreicherungWahl? _wahl;

    /// <summary>Wird die Originaldatei angereichert? (Prüfhilfe für die Tests.)</summary>
    public bool Anreichernd => AnreicherungSichtbar && _weg == WEG_ANREICHERN;

    /// <summary>Die gewählte Originaldatei (Prüfhilfe für die Tests); <c>null</c> = keine.</summary>
    public GebaeudeAnreicherungWahl? Wahl => _wahl;

    /// <summary>Ist der Beipackzettel bestätigt? (Prüfhilfe für die Tests.)</summary>
    public bool BeipackBestaetigt => _beipackBestaetigt;

    /// <summary>Die Ansicht des Plans (Prüfhilfe für die Tests); <c>null</c>, solange sie gelesen wird.</summary>
    public GebaeudeExportAnsicht? Ansicht => _ansicht;

    /// <summary>Die stehende Meldung (Prüfhilfe für die Tests).</summary>
    public string Meldung => _meldung;

    /// <summary>Die Stufe der stehenden Meldung (Prüfhilfe für die Tests).</summary>
    public WarnStufe MeldungStufe => _meldungStufe;

    /// <summary>Sind die Meldungen bestätigt? (Prüfhilfe für die Tests.)</summary>
    public bool Bestaetigt => _bestaetigt;

    /// <summary>Der Steuerwert des gewählten Formats; leer ohne Formatliste (Prüfhilfe für die Tests).</summary>
    public string Formatwert => _format;

    /// <summary>Hält das gewählte Format in der Liste; ohne gültige Wahl gilt das erste (gbXML).</summary>
    protected override void OnParametersSet() => FormatAbgleichen();

    private void FormatAbgleichen()
    {
        if (Formate.Count > 0 && !Formate.Any(f => f.Wert == _format)) _format = Formate[0].Wert;
    }

    protected override void OnInitialized()
    {
        FormatAbgleichen();   // vor dem ersten Plan (OnInitializedAsync läuft vor OnParametersSet)
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE_EXPORT, () => KiSicht(), KiHaken());
    }

    protected override async Task OnInitializedAsync()
    {
        await Neubilden();
        if (AnreicherungMoeglich is not null && Anreichern is not null && OriginalWaehlen is not null)
        {
            try { _anreicherbar = await AnreicherungMoeglich(); }
            catch (Exception) { _anreicherbar = false; }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    // =================================================================================
    // Der Hilfe-Assistent setzt die Postleitzahl und liest die Bestaetigung
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GebaeudeExportKiSicht? _kiSicht;

    private GebaeudeExportKiSicht KiSicht()
    {
        return _kiSicht ??= new GebaeudeExportKiSicht
        {
            PlzLesen = () => _plz,
            PlzSetzen = w => { _plz = w ?? ""; _ = InvokeAsync(() => BeiPlz(_plz)); },
            BestaetigtLesen = () => _bestaetigt
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf: <c>Pruefen</c> ist dieselbe Prüfung wie am
    /// Speicherknopf. Bestätigen und Speichern bleiben Klicks des Anwenders.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => Pruefen() ?? ""
    };

    /// <inheritdoc/>
    public void Dispose()
    {
        _entprellung?.Cancel();
        _entprellung?.Dispose();
        _kiMaske?.Dispose();
    }

    // =================================================================================
    // Anzeige
    // =================================================================================

    /// <summary>Der Bannertext einer Ablehnung; leer = keine.</summary>
    private string Ablehnungstext
        => _ansicht is { Ablehnung: string grund } ? Format(Texte.Abgelehnt, grund) : "";

    /// <summary>Das gewählte Format; <c>null</c> ohne Formatliste.</summary>
    private GebaeudeExportFormat? AktuellesFormat => Formate.FirstOrDefault(f => f.Wert == _format);

    /// <summary>Der Umfang der Datei zum gewählten Format.</summary>
    private string Umfangtext => AktuellesFormat?.Umfang ?? Texte.StufeDaten;

    /// <summary>Die Einträge der Optionsgruppe: Position und Anzeigetext — der Steuerwert bleibt in <see cref="Formate"/>.</summary>
    private IReadOnlyList<(int Id, string Text)> Formateintraege
        => Formate.Select((f, i) => (i, f.Text)).ToList();

    private int? Formatindex
    {
        get
        {
            for (int i = 0; i < Formate.Count; i++)
                if (Formate[i].Wert == _format) return i;
            return null;
        }
    }

    private GebaeudeExportEingabe Eingabe() => new(_plz, _format);

    /// <summary>Steht die Wahl des Ausgabewegs? Nur beim Format mit Anreicherung und mit Importquelle.</summary>
    private bool AnreicherungSichtbar => _anreicherbar && AktuellesFormat is { MitAnreicherung: true };

    /// <summary>Die Einträge der Wegwahl: Position und Anzeigetext.</summary>
    private IReadOnlyList<(int Id, string Text)> Wegeintraege
        => new[] { (WEG_EIGEN, Texte.WegEigen), (WEG_ANREICHERN, Texte.WegAnreichern) };

    /// <summary>Der Grund der weichen Sperre von „Speichern…": die fehlende Bestätigung.</summary>
    private string? OkSperrgrund => _ansicht is null ? null : Pruefen();

    private static string Meldungsklasse(GebaeudeExportMeldung m) => m.Stufe switch
    {
        WarnStufe.Fehler => "epos-gebexport-meldung--fehler",
        WarnStufe.Warnung => "epos-gebexport-meldung--warnung",
        _ => "epos-gebexport-meldung--hinweis",
    };

    private static string Format(string vorlage, params object?[] werte)
    {
        try { return string.Format(CultureInfo.CurrentCulture, vorlage ?? "", werte); }
        catch (FormatException) { return vorlage ?? ""; }
    }

    // =================================================================================
    // Format, Exportzusage, Postleitzahl und Neubildung des Plans
    // =================================================================================

    /// <summary>
    /// Ein Formatwechsel bildet den Plan sofort neu (die Meldungen unterscheiden sich je Format) und
    /// nimmt die Bestätigung zurück: Bestätigt waren die Meldungen des anderen Formats.
    /// </summary>
    private async Task BeiFormat(int? index)
    {
        if (index is not int i || i < 0 || i >= Formate.Count || _speichertGerade) return;
        if (Formate[i].Wert == _format) return;
        _format = Formate[i].Wert;
        _bestaetigt = false;
        _meldung = "";
        _entprellung?.Cancel();
        _ansicht = null;
        await Neubilden();
    }

    /// <summary>Der Ausgabeweg: eigene Datei oder Originaldatei anreichern. Die gewählte Datei bleibt stehen.</summary>
    private void BeiWeg(int? id)
    {
        if (id is not int w || _speichertGerade || _waehltGerade) return;
        if (w != WEG_EIGEN && w != WEG_ANREICHERN) return;
        _weg = w;
        _meldung = "";
    }

    /// <summary>Wählt die Originaldatei; eine abgebrochene Dateiwahl lässt die bisherige stehen.</summary>
    private async Task BeiOriginalWaehlen()
    {
        if (OriginalWaehlen is null || _waehltGerade || _speichertGerade) return;
        _waehltGerade = true;
        _meldung = "";
        GebaeudeAnreicherungWahl? wahl;
        try { wahl = await OriginalWaehlen(); }
        finally { _waehltGerade = false; }
        if (wahl is null) return;
        _wahl = wahl;
        _beipackBestaetigt = false;
    }

    /// <summary>Nach einer Verweigerung: dieselben Eingaben, aber eine eigene Datei.</summary>
    private void BeiStattEigene()
    {
        if (_speichertGerade) return;
        _weg = WEG_EIGEN;
        _meldung = "";
    }

    private void BeiBeipack(bool wert)
    {
        _beipackBestaetigt = wert;
        if (wert && _meldung == Texte.SperreBeipack) _meldung = "";
    }

    /// <summary>Die Exportzusage öffnen bzw. teilen; ein Grund steht im Banner.</summary>
    private async Task BeiZusage()
    {
        if (ZusageOeffnen is null) return;
        string? grund = await ZusageOeffnen();
        _meldung = grund ?? "";
        _meldungStufe = WarnStufe.Fehler;
    }

    private async Task BeiPlz(string wert)
    {
        _plz = wert ?? "";
        _meldung = "";
        _entprellung?.Cancel();
        _entprellung?.Dispose();
        _entprellung = null;
        if (Entprellung <= 0)
        {
            await Neubilden();
            return;
        }

        var cts = new CancellationTokenSource();
        _entprellung = cts;
        try { await Task.Delay(Entprellung, cts.Token); }
        catch (OperationCanceledException) { return; }
        await Neubilden();
        StateHasChanged();
    }

    /// <summary>
    /// Bildet den Plan zur aktuellen Postleitzahl. Eine ältere Antwort, die nach einer neueren eintrifft,
    /// wird verworfen (Fassungsnummer).
    /// </summary>
    private async Task Neubilden()
    {
        if (Vorbereiten is null) return;
        int fassung = ++_fassung;
        GebaeudeExportAnsicht ansicht = await Vorbereiten(Eingabe());
        if (fassung != _fassung) return;
        bool warAbgelehnt = _ansicht?.Abgelehnt ?? false;
        _ansicht = ansicht;
        if (ansicht.Abgelehnt != warAbgelehnt) _bestaetigt = false;
    }

    private void BeiBestaetigung(bool wert)
    {
        _bestaetigt = wert;
        if (wert && _meldung == Texte.SperreBestaetigen) _meldung = "";
    }

    // =================================================================================
    // Pruefen und Schliessen
    // =================================================================================

    /// <summary>
    /// Die Prüfregel — genau einmal, für „Speichern…" und den Assistenten: gelesen, nicht abgelehnt,
    /// bestätigt. <c>null</c> = es darf gespeichert werden.
    /// </summary>
    private string? Pruefen()
    {
        if (_ansicht is null) return Texte.Vorbereitung;
        if (_ansicht.Abgelehnt) return Ablehnungstext;
        if (!_bestaetigt) return Texte.SperreBestaetigen;
        if (Anreichernd)
        {
            if (_wahl is null) return Texte.SperreOriginal;
            if (_wahl.Grund is string grund) return Format(Texte.Verweigert, grund);
            if (!_beipackBestaetigt) return Texte.SperreBeipack;
        }
        return null;
    }

    private async Task BeiErgebnis(bool ok)
    {
        if (!ok) { await Abbrechen(); return; }
        if (_speichertGerade) return;

        string? fehler = Pruefen();
        if (fehler is not null)
        {
            _meldung = fehler;
            _meldungStufe = WarnStufe.Hinweis;
            return;
        }
        Func<GebaeudeExportEingabe, Task<GebaeudeExportErgebnis>>? weg = Anreichernd ? Anreichern : Speichern;
        if (weg is null) return;

        _entprellung?.Cancel();
        _meldung = "";
        _speichertGerade = true;
        GebaeudeExportErgebnis ergebnis;
        try
        {
            ergebnis = await weg(Eingabe());
        }
        finally
        {
            _speichertGerade = false;
        }

        if (ergebnis.Abgebrochen) return;
        if (!ergebnis.Gespeichert)
        {
            if (ergebnis.Meldungen is not null)
                _ansicht = new GebaeudeExportAnsicht(ergebnis.Meldungen, null);
            _meldung = ergebnis.Text;
            _meldungStufe = WarnStufe.Fehler;
            return;
        }
        await Geschlossen.InvokeAsync(ergebnis);
    }

    private Task BeiTaste(KeyboardEventArgs e)
        => e.Key == "Escape" && !_speichertGerade ? Abbrechen() : Task.CompletedTask;

    /// <summary>Abbrechen — von Esc und vom Schliesskreuz gleichermaßen gerufen. Ruft den Speicherweg nie.</summary>
    private Task Abbrechen()
    {
        _entprellung?.Cancel();
        return Geschlossen.InvokeAsync(null);
    }
}
