<Project Sdk="Microsoft.NET.Sdk">

  <!-- Proben zur Zugriffsschicht (Arbeitspaket S4a, Implementierungskonzept
       DB-Migration SQLite). Eigenstaendiges Konsolenprojekt mit EIGENER Projektmappe:
       Es haengt per ProjectReference an der Anwendung, gehoert aber bewusst NICHT in
       deren Projektmappe - die Proben sollen den Ausrollstand nicht beeinflussen.

       net8.0-windows + UseWindowsForms, weil die Zugriffsschicht ueber FehlerMelden
       an System.Windows.Forms haengt. Die Proben fahren deshalb durchgaengig in
       DataRepository.EngineModus(): dort wandert jede Meldung in die stille Sammlung
       statt in eine MessageBox, die einen unbeaufsichtigten Lauf blockieren wuerde. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ZugriffsschichtProben</AssemblyName>
    <RootNamespace>ZugriffsschichtProben</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WindowsFormsApplication1\WindowsFormsApplication1.csproj" />
  </ItemGroup>

</Project>
