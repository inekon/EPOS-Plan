@* SCHRITT 3 des Modus „Einzelspeicher" — BERECHNUNGSART, ZIELFUNKTION UND
   LEISTUNGSPREIS (aus SpeicherOptimierungDialog; Anwenderentscheid W11b-E-3 vom
   10.09.2026).

   WARUM DIESE DREI ZUSAMMEN STEHEN. Die Berechnungsart entscheidet die
   ZIELFUNKTION, und bei der Lastspitzenkappung entscheidet der LEISTUNGSPREIS,
   was eine gekappte Spitze wert ist. Im abgeloesten Dialog standen sie
   untereinander in einem Blatt mit dem Suchraum; in der Ablaufleiste ist das der
   Schritt „Betriebsfuehrung" — dasselbe, was bei der Flotte das Betriebsziel ist.

   DER LEISTUNGSPREIS SCHREIBT SOFORT. Es ist dasselbe Feld
   Tab_StromspeicherVariante.L_P, das der Reiter „Parameter" und die
   Peak-Shaving-Maske pflegen — EINE Pflegestelle. Ohne Schreibdelegat bleibt es
   Anzeige („Kein Delegat ist kein Knopf"); der Suchlauf rechnet dann mit dem
   vorbelegten Wert. Die Klappliste bietet NUR gepflegte Quellen an; eine Liste
   mit Nullen waere keine Auswahl, sondern eine Falle. *@

@namespace EPOS.UI.Seiten.Strom
@using System.Globalization
@using SpeicherEngine
@using WindowsFormsApplication1

<section class="epos-speicheropt-blatt" aria-label="@Resource.OPT_LBL_STRATEGIE">

    <div class="epos-speicheropt-suchraum">
        <Formularraster>
            <KindInhalt>
                <Formulargruppe Titel="@Resource.OPT_LBL_STRATEGIE">
                    <KindInhalt>
                        <Auswahlfeld Bezeichnung="@Resource.OPT_LBL_STRATEGIE" Eintraege="@STRATEGIEN"
                                     Auswahl="@((int)Wert.Strategie)" Aktiv="@Aktiv"
                                     AuswahlChanged="StrategieGewaehlt" />
                        <Schalter Bezeichnung="@Resource.OPT_CHK_KVER" Wert="@Wert.KVerInZielfunktion" Aktiv="@Aktiv"
                                  WertChanged="@(w => { Wert.KVerInZielfunktion = w; return Geaendert.InvokeAsync(); })" />
                    </KindInhalt>
                </Formulargruppe>
            </KindInhalt>
        </Formularraster>
    </div>

    @if (Kappung)
    {
        <div class="epos-speicheropt-suchraum">
            <Formularraster>
                <KindInhalt>
                    <Formulargruppe Titel="@Resource.SP_BERECHNUNG_ANZEIGE_LASTSPITZENKAPPUNG">
                        <KindInhalt>
                            <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_LEISTUNGSPREIS" Einheit="€/(kW·a)" Min="0"
                                        Wert="@Wert.LeistungspreisEurProKwA"
                                        Aktiv="@(Aktiv && LeistungspreisSchreiben.HasDelegate)"
                                        WertChanged="LeistungspreisGesetzt" />

                            @if (Quellen.Count > 0)
                            {
                                <Auswahlfeld Bezeichnung="@Resource.OPT_LBL_LP_QUELLE" Eintraege="@Quellenliste"
                                             Auswahl="@_quelle" Platzhalter="@Resource.OPT_LBL_LP_QUELLE"
                                             Aktiv="@(Aktiv && LeistungspreisSchreiben.HasDelegate)"
                                             AuswahlChanged="QuelleGewaehlt" />
                            }
                        </KindInhalt>
                    </Formulargruppe>
                </KindInhalt>
            </Formularraster>
        </div>
    }

    <Herleitungszeile Text="@Zielfunktion" />

    @if (Wert.KVerInZielfunktion)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@Resource.OPT_HINWEIS_KVER" />
    }
</section>

@code {
    /// <summary>
    /// Die drei Betriebsstrategien als Einträge der Klappliste. Die Id ist der Zahlenwert
    /// von <see cref="OptimiererStrategie"/> — Anzeigetext und Steuerwert bleiben getrennt.
    /// </summary>
    private static IReadOnlyList<(int Id, string Text)> STRATEGIEN =>
        SpeicherOptimierungCtrl.Strategien().Select((text, i) => (Id: i, Text: text)).ToList();

    /// <summary>Der Arbeitsstand der Seite; er wird AN ORT UND STELLE geschrieben.</summary>
    [Parameter, EditorRequired] public SpeicherOptimierungEingaben Wert { get; set; } = new();

    /// <summary>Ein Feld hat geschrieben.</summary>
    [Parameter] public EventCallback Geaendert { get; set; }

    /// <summary>Darf bearbeitet werden?</summary>
    [Parameter] public bool Aktiv { get; set; } = true;

    /// <summary>Die angebotenen Leistungspreis-Quellen; leer = keine gepflegt.</summary>
    [Parameter] public IReadOnlyList<SpeicherOptimierungLeistungspreisQuelle> Quellen { get; set; }
        = Array.Empty<SpeicherOptimierungLeistungspreisQuelle>();

    /// <summary>
    /// Schreibt den Leistungspreis L_P [€/(kW·a)] SOFORT in die aktive Speichervariante;
    /// ohne Rückruf bleibt das Feld Anzeige.
    /// </summary>
    [Parameter] public EventCallback<double> LeistungspreisSchreiben { get; set; }

    /// <summary>Die zuletzt gewählte Quelle (Index); <c>null</c> = keine.</summary>
    private int? _quelle;

    /// <summary>Steht die Klappliste auf der Lastspitzenkappung? (Prüfhilfe)</summary>
    public bool Kappung => Wert.Strategie == OptimiererStrategie.Lastspitzenkappung;

    private IReadOnlyList<(int Id, string Text)> Quellenliste =>
        Quellen.Select((q, i) => (Id: i, Text: q.Bezeichnung)).ToList();

    private string Zielfunktion => Kappung
        ? Resource.OPT_HINWEIS_ZIEL_LASTSPITZE
        : Resource.OPT_HINWEIS_ZIELFUNKTION;

    private Task StrategieGewaehlt(int? index)
    {
        // Der Zahlenwert der Klappliste IST der der Aufzaehlung (W11b-E-3): 0 = Dauer-,
        // 1 = Nachtnutzung, 2 = Lastspitzenkappung. Ein unbekannter Index faellt auf die
        // Dauernutzung zurueck.
        Wert.Strategie = index switch
        {
            1 => OptimiererStrategie.Nachtnutzung,
            2 => OptimiererStrategie.Lastspitzenkappung,
            _ => OptimiererStrategie.Dauernutzung
        };
        return Geaendert.InvokeAsync();
    }

    /// <summary>Das Feld hat geschrieben: erst in den Suchraum, dann in die Variante.</summary>
    private async Task LeistungspreisGesetzt(double? wert)
    {
        if (!wert.HasValue) return;

        Wert.LeistungspreisEurProKwA = wert.Value;
        _quelle = null;                       // von Hand geaendert - keine Quelle mehr
        await Geaendert.InvokeAsync();

        if (LeistungspreisSchreiben.HasDelegate)
            await LeistungspreisSchreiben.InvokeAsync(wert.Value);
    }

    /// <summary>
    /// Eine Quelle wurde gewählt: Ihr Wert geht ins Feld UND in die Variante — die
    /// Übernahme ist ein Schreibvorgang, kein Vorschlag (W11b‑E‑3).
    /// </summary>
    private async Task QuelleGewaehlt(int? index)
    {
        _quelle = index;
        if (!index.HasValue || index.Value < 0 || index.Value >= Quellen.Count) return;

        double wert = Quellen[index.Value].WertEurProKwA;
        Wert.LeistungspreisEurProKwA = wert;
        await Geaendert.InvokeAsync();

        if (LeistungspreisSchreiben.HasDelegate)
            await LeistungspreisSchreiben.InvokeAsync(wert);
    }
}
