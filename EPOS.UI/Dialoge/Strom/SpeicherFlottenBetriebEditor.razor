@* DER BAUSTEIN DER BETRIEBSFUEHRUNG. Er steht an ZWEI Stellen - im Dialog
   "Speicherflotte & Auslegung" (ueber SpeicherFlottenEditor) und im Reiter
   "Stromspeicher" der Ergebnisseite. Das Mehrspeicherkonzept will das so:
   "ueber denselben Baustein editierbar".

   DESHALB STEHT DIE PLANERSPERRE HIER (Auftrag #170c): Drei der fuenf
   Betriebsziele PLANEN und brauchen einen Fahrplan-Loeser (IFlottenPlaner).
   Registriert wird der nur von der Windows-Anwendung; auf dem iPad und in den
   Linux-Pruefstaenden gibt es keinen. Ohne diesen Riegel endete die Wahl eines
   planenden Ziels erst IM LAUF mit einer InvalidOperationException - eine
   Maske, die eine Wahl anbietet, die sie nicht halten kann. Jetzt sind die drei
   Eintraege gesperrt und sagen im Tooltip warum; ein GESPEICHERTES planendes
   Profil wird mit einem Banner erklaert, statt zu werfen. Die zwei Ausnahmen im
   Kern bleiben als letzte Schranke stehen. *@

@namespace EPOS.UI.Dialoge.Strom
@using System.Globalization
@using SpeicherEngine
@using WindowsFormsApplication1

<section class="epos-flotte-abschnitt epos-flotte-betrieb" aria-labelledby="flotte-betrieb-titel">
    <h3 id="flotte-betrieb-titel">@Resource.FLOTTE_BETRIEB_TITEL</h3>
    <div class="epos-flotte-feldraster epos-flotte-feldraster--kompakt">
        <Auswahlfeld Bezeichnung="@Resource.FLOTTE_BETRIEB_LBL_ZIEL" Eintraege="@Betriebsziele"
                       Auswahl="@((int)_wert.Betriebsziel)" Aktiv="@Aktiv"
                       GesperrteEintraege="@GesperrteZiele"
                       GesperrtHinweis="@(PlanerFehlt ? Resource.FLOTTE_PLANER_ZIEL_GESPERRT : "")"
                       AuswahlChanged="BetriebszielSetzen" />
        <Auswahlfeld Bezeichnung="@Resource.FLOTTE_BETRIEB_LBL_VERTEILUNG" Eintraege="@Verteilungen"
                       Auswahl="@((int)_wert.Verteilung)" Aktiv="@Aktiv"
                       AuswahlChanged="VerteilungSetzen" />
        <Auswahlfeld Bezeichnung="@Resource.FLOTTE_BETRIEB_LBL_PRIORITAET" Eintraege="@ErzeugerPrioritaeten"
                       Auswahl="@((int)_wert.ErzeugerPrioritaet)" Aktiv="@Aktiv"
                       AuswahlChanged="ErzeugerPrioritaetSetzen" />
        @if (HatPeakZiel)
        {
            <Zahlenfeld Bezeichnung="@Resource.FLOTTE_BETRIEB_LBL_PEAKZIEL" Einheit="kW"
                        Wert="@_wert.WirtschaftlicherPeakZielwertKw" Min="0" Aktiv="@Aktiv"
                        WertChanged="PeakZielSetzen" />
        }
        <Schalter Bezeichnung="@Resource.FLOTTE_BETRIEB_CHK_NETZLADUNG" Wert="@_wert.NetzladungErlaubt"
                   Aktiv="@Aktiv" WertChanged="NetzladungSetzen" />
        <Schalter Bezeichnung="@Resource.FLOTTE_BETRIEB_CHK_EXPORT" Wert="@_wert.BatterieexportErlaubt"
                   Aktiv="@Aktiv" WertChanged="BatterieexportSetzen" />
    </div>
    @if (PlanerFehlt && FlottenPlanerLage.IstPlanend(_wert.Betriebsziel))
    {
        <Warnbanner Stufe="WarnStufe.Warnung"
                    Text="@string.Format(CultureInfo.CurrentCulture, Resource.FLOTTE_PLANER_PROFIL, Zielname(_wert.Betriebsziel))" />
    }
    else if (PlanerFehlt)
    {
        <Warnbanner Stufe="WarnStufe.Hinweis" Text="@Resource.FLOTTE_PLANER_FEHLT" />
    }
    <p class="epos-flotte-hinweis">@ZielHinweis</p>
</section>

@code {
    [Parameter] public FlottenSimulationOptionen Wert { get; set; } = new();
    [Parameter] public EventCallback<FlottenSimulationOptionen> WertChanged { get; set; }
    [Parameter] public bool Aktiv { get; set; } = true;

    /// <summary>
    /// Ist ein Fahrplan-Loeser da? <c>null</c> = die Auskunft des Kerns fragen
    /// (<see cref="FlottenPlanerLage.Verfuegbar"/>) - das ist der Betriebsfall. Ein
    /// Pruefstand setzt den Wert ausdruecklich und braucht dann keine statische Fabrik.
    /// </summary>
    [Parameter] public bool? PlanerVerfuegbar { get; set; }

    private FlottenSimulationOptionen _wert = new();
    private FlottenSimulationOptionen? _eingangReferenz;

    private bool PlanerFehlt => !(PlanerVerfuegbar ?? FlottenPlanerLage.Verfuegbar);

    /// <summary>Die drei planenden Ziele - gesperrt, solange kein Fahrplan-Loeser da ist.</summary>
    private IReadOnlyCollection<int> GesperrteZiele => PlanerFehlt ? PlanendeIds : Array.Empty<int>();

    private static readonly int[] PlanendeIds =
    {
        (int)FlottenBetriebsziel.PvPlanung,
        (int)FlottenBetriebsziel.Arbitrage,
        (int)FlottenBetriebsziel.MultiUse
    };

    private static string Zielname(FlottenBetriebsziel ziel) =>
        Betriebsziele.FirstOrDefault(x => x.Id == (int)ziel).Text ?? ziel.ToString();

    // KEIN static readonly: Die Texte kommen aus den Ressourcen, und die Sprache
    // wechselt zur Laufzeit (Sprachumschaltung im Rahmen). Ein einmal gefuellter
    // statischer Vorrat zeigte nach dem Wechsel weiter die alte Sprache.
    private static IReadOnlyList<(int Id, string Text)> Betriebsziele => new[]
    {
        (0, Resource.FLOTTE_ZIEL_PVGREEDY), (1, Resource.FLOTTE_ZIEL_PEAKSHAVING),
        (2, Resource.FLOTTE_ZIEL_PVPLANUNG), (3, Resource.FLOTTE_ZIEL_ARBITRAGE),
        (4, Resource.FLOTTE_ZIEL_MULTIUSE)
    };
    private static IReadOnlyList<(int Id, string Text)> Verteilungen => new[]
    {
        (0, Resource.FLOTTE_VERT_KAPAZITAET), (1, Resource.FLOTTE_VERT_KASKADE),
        (2, Resource.FLOTTE_VERT_GRENZKOSTEN)
    };
    private static IReadOnlyList<(int Id, string Text)> ErzeugerPrioritaeten => new[]
    {
        (0, Resource.FLOTTE_PRIO_PV_VOR_BHKW), (1, Resource.FLOTTE_PRIO_BHKW_VOR_PV)
    };

    private bool HatPeakZiel => _wert.Betriebsziel is FlottenBetriebsziel.PeakShaving or FlottenBetriebsziel.MultiUse;
    private string ZielHinweis => _wert.Betriebsziel switch
    {
        FlottenBetriebsziel.PeakShaving => Resource.FLOTTE_BETRIEB_HINWEIS_PEAK,
        FlottenBetriebsziel.PvPlanung => Resource.FLOTTE_BETRIEB_HINWEIS_PVPLANUNG,
        FlottenBetriebsziel.Arbitrage => Resource.FLOTTE_BETRIEB_HINWEIS_ARBITRAGE,
        FlottenBetriebsziel.MultiUse => Resource.FLOTTE_BETRIEB_HINWEIS_MULTIUSE,
        _ => Resource.FLOTTE_BETRIEB_HINWEIS_REAKTIV
    };

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_eingangReferenz, Wert)) return;
        _eingangReferenz = Wert;
        _wert = Kopie(Wert ?? new FlottenSimulationOptionen());
    }

    private async Task BetriebszielSetzen(int? wert)
    {
        if (!wert.HasValue) { await Melden(); return; }
        var ziel = (FlottenBetriebsziel)wert.Value;
        // Zweiter Riegel hinter der Sperre im Auswahlfeld: ein planendes Ziel wird ohne
        // Fahrplan-Loeser nicht uebernommen und auch nicht nach oben gemeldet.
        if (PlanerFehlt && FlottenPlanerLage.IstPlanend(ziel)) return;
        _wert.Betriebsziel = ziel;
        await Melden();
    }

    private async Task VerteilungSetzen(int? wert)
    {
        if (wert.HasValue) _wert.Verteilung = (FlottenVerteilung)wert.Value;
        await Melden();
    }

    private async Task ErzeugerPrioritaetSetzen(int? wert)
    {
        if (wert.HasValue) _wert.ErzeugerPrioritaet = (FlottenErzeugerPrioritaet)wert.Value;
        await Melden();
    }

    private async Task PeakZielSetzen(double? wert)
    {
        _wert.WirtschaftlicherPeakZielwertKw = wert;
        await Melden();
    }

    private async Task NetzladungSetzen(bool wert)
    {
        _wert.NetzladungErlaubt = wert;
        await Melden();
    }

    private async Task BatterieexportSetzen(bool wert)
    {
        _wert.BatterieexportErlaubt = wert;
        await Melden();
    }

    private Task Melden() => WertChanged.InvokeAsync(Kopie(_wert));

    private static FlottenSimulationOptionen Kopie(FlottenSimulationOptionen q) => new()
    {
        Betriebsziel = q.Betriebsziel,
        Verteilung = q.Verteilung,
        NetzbezugGrenzeKw = q.NetzbezugGrenzeKw,
        NetzeinspeisungGrenzeKw = q.NetzeinspeisungGrenzeKw,
        NetzladungErlaubt = q.NetzladungErlaubt,
        BatterieexportErlaubt = q.BatterieexportErlaubt,
        WirtschaftlicherPeakZielwertKw = q.WirtschaftlicherPeakZielwertKw,
        ArbitrageLadepreisSchwelle = q.ArbitrageLadepreisSchwelle,
        ArbitrageEntladepreisSchwelle = q.ArbitrageEntladepreisSchwelle,
        PrognoseArt = q.PrognoseArt,
        ErzeugerPrioritaet = q.ErzeugerPrioritaet,
        PlanungshorizontIntervalle = q.PlanungshorizontIntervalle,
        NeuplanungAlleIntervalle = q.NeuplanungAlleIntervalle,
        Endbedingung = q.Endbedingung,
        EndenergieZielKWh = new List<double>(q.EndenergieZielKWh ?? new List<double>()),
        EnergieAusgleichEuroProKWh = q.EnergieAusgleichEuroProKWh,
        PrognoseFallbackErlaubt = q.PrognoseFallbackErlaubt
    };
}
