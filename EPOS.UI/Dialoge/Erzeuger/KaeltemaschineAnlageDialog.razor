    // Der Hilfe-Assistent
    // =====================================================================

    private KiMaskenanmeldung? _kiMaske;
    private KaeltemaschineAnlageKiSicht? _kiSicht;

    /// <summary>Die Sicht des Assistenten: die Anlagenwahl nimmt den Weg eines Klicks, die Felder den Arbeitsstand.</summary>
    private KaeltemaschineAnlageKiSicht KiSicht()
    {
        return _kiSicht ??= new KaeltemaschineAnlageKiSicht
        {
            AnlageLesen = () => _gewaehlt,
            AnlageSetzen = Waehlen,
            AnlageEintraege = () => KiMaskenanmeldung.Eintraege(Sichtbare, z => z.Schluessel, z => z.Arbeit.Bezeichner),
            Stromtraeger = () => Stromtraeger,
            ArbeitLesen = () => Aktuell?.Arbeit,
            Geaendert = () => _ = InvokeAsync(StateHasChanged)
        };
    }

    /// <summary>„OK" ist der Weg des Knopfes, die Prüfung dieselbe.</summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => Aktuell is Zeile a ? Pruefbefund(a.Arbeit) ?? "" : "",
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (Speichern is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", Texte.Titel));
        bool ok = Schreiben();
        _ = InvokeAsync(StateHasChanged);
        return ok ? KiKern.KiErgebnis.Ok(Texte.Titel, anzahl: Sichtbare.Count) : KiKern.KiErgebnis.Abgelehnt(_meldung);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();
}
