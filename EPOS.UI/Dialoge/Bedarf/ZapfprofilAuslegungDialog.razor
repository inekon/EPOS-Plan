    private void BedarfstagWaehlen(int? id)
    {
        switch (id ?? WAHL_VORGABE)
        {
            case WAHL_VORGABE:
                _eingabe.Quelle = ZapfprofilBedarfstagquelle.Vorgaberegel;
                _eingabe.IdBedarfstag = null;
                break;
            case WAHL_STUNDENPROFIL:
                _eingabe.Quelle = ZapfprofilBedarfstagquelle.Stundenprofil;
                _eingabe.IdBedarfstag = null;
                break;
            case WAHL_DIN4708:
                _eingabe.Quelle = ZapfprofilBedarfstagquelle.Din4708Profil;
                _eingabe.IdBedarfstag = null;
                break;
            case WAHL_ENTWURF:
                _eingabe.Quelle = ZapfprofilBedarfstagquelle.Konstruktor;
                _eingabe.IdBedarfstag = null;
                break;
            case WAHL_A100:
            case WAHL_ECODESIGN:
                // Gesperrt: Die Wahl kommt im Browser nicht an; über eine nachgereichte Zuweisung
                // nennt die leise Zeile den Grund, die Eingaben bleiben.
                _hinweis = Sperrgruende.TryGetValue(id!.Value, out string? grund) ? grund : "";
                return;
            default:
                ZapfprofilBedarfstagDaten? t = Daten.Bedarfstage.FirstOrDefault(x => x.Id == id);
                if (t is not null && !t.Waehlbar) return;
                _eingabe.Quelle = t?.Quelle ?? ZapfprofilBedarfstagquelle.Konstruktor;
                _eingabe.IdBedarfstag = id;
                break;
        }
        Geaendert();
    }

