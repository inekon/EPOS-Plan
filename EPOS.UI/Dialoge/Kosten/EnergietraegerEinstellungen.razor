@* Die Traegerkarte der Energietraegerverwaltung (iU9-W4.4).

   Vorbild: Views/Kosten/ucFuelSettings.cs (2 103 Z.) und .Designer.cs — der
   groesste Baustein der Kostenseite, gewachsen ueber die Etappen K3
   (Umrechnungsblock), AP4 (Zerlegung), B2 (Preisbestandteile), KD4
   (Leistungspreis-Modus und Saisonreihen) und E3 (Emissions-Reiter).

   WAS DIE KOMPONENTE NICHT MEHR TUT. Der Vorlaeufer las und schrieb selbst:
   neun SQL-Anweisungen standen in der Maske. Sie stehen seit dieser Welle im
   Kern-Controller EnergietraegerPreisCtrl, und die Huelle verbindet beides
   (Regel F5). Ebenso wenig rechnet sie: Preis je kWh, Effektivzeile,
   Verstosshinweis und die Summen der beiden Preisbloecke kommen als fertige
   Texte herein — die Formeln stehen in der Engine bzw. im Pruefer
   EnergieEinheitenPruefung, und es soll sie nur einmal geben.

   VIER BLOECKE STATT ZWEI REITERN (Anwenderwunsch 18.09.2026, Entscheide
   ET-D-1..3). Reiter verstecken die Haelfte der Karte: Wer den Arbeitspreis
   pflegte, sah die Emissionen nicht, und wer die Emissionen pflegte, sah den
   Preis nicht - dabei gehoert beides zu demselben Traeger. Die Karte zeigt
   jetzt alles auf einmal, geordnet nach dem, was zusammengehoert:

     A  Preis und Heizwert              links, oben
     B  Preisbestandteile / Strompreis  rechts daneben (Umbruch < 900 px)
     C  Emissionen                      volle Breite
     D  Einheiten und Umrechnung        volle Breite, AUFKLAPPBAR, Vorgabe zu

   Block D ist der Pruefblock: Die Umrechnungsregeln pruefen die
   Einheitenkette, sie RECHNEN nicht mehr. Gerechnet wird mit Heizwert und
   Brennwert - die Preisbasis „kWh" traegt den Heizwert als Faktor
   (Befund UR-1, EnergietraegerPreisCtrl.Preisbasen).

   DIE PREISBASIS STEHT AM ARBEITSPREIS (Entscheid ET-D-4, loest die Anordnung
   aus ET-D-3 ab): Wer den Preis eintraegt, waehlt dort auch, ob in €/Nm³ oder
   in €/kWh - im zugeklappten Block D fand sie niemand.

   HISTORIE UND SPEICHERN STEHEN UNTER DEN BLOECKEN: Der Speichern-Knopf gilt
   fuer die ganze Karte.

   OHNE ARTENKATALOG (Migrationsschritt 57 nicht gelaufen) bleiben die drei
   Bestandsfelder CO2/SO2/NOx sichtbar. Eine leere Emissionsmaske waere
   schlechter als die alte. *@

@namespace EPOS.UI.Dialoge.Kosten
@using WindowsFormsApplication1

<div class="epos-traegerkarte">

    <p class="epos-traeger-name">@Stand.TraegerZeile</p>
    <p class="epos-traeger-gruppe">@Stand.GruppeZeile</p>

    @* =========================================== A und B nebeneinander *@
    <div class="epos-blockspalten">

        @* ------------------------------------ Block A: Preis und Heizwert *@
        <div class="epos-blockspalte">
            <Gruppenkopf Titel="@TitelBlockPreis">
                <KindInhalt>
                    @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben dem
                       Feld, Zahlenfelder kurz mit der Einheit dahinter. *@
                    <Formularraster>
                        <KindInhalt>
                            <Zahlenfeld Bezeichnung="@LabelArbeitspreis" Einheit="@Stand.EinheitArbeitspreis"
                                        Wert="@Stand.Arbeitspreis"
                                        WertChanged="@(w => Feld(() => Stand.Arbeitspreis = w ?? Stand.Arbeitspreis))" />

                            @* ET-D-4: Die Preisbasis steht DIREKT unter dem Arbeitspreis, ohne
                               eigene Beschriftung - dasselbe Muster wie der Leistungspreis-Modus
                               darunter; die Sprachausgabe hoert den Kurznamen. Sie sagt nur, in
                               welcher Einheit der Preis EINGEGEBEN wird; gespeichert wird immer je
                               Mengeneinheit. Fuehrt der Traeger nur eine Einheit (Strom,
                               Fernwaerme, kein Heizwert), steht keine Liste da - dann genuegt die
                               Einheit am Feld. *@
                            @if (Stand.Preisbasen.Count > 1)
                            {
                                <Auswahlfeld Eintraege="@Stand.Preisbasen" Auswahl="@Stand.PreisbasisId"
                                             Kurzname="@LabelPreisbasisAria"
                                             AuswahlChanged="BeiPreisbasis" />
                            }

                            <Zahlenfeld Bezeichnung="@LabelGrundpreis" Einheit="@Stand.EinheitGrundpreis"
                                        Wert="@Stand.Grundpreis"
                                        WertChanged="@(w => Feld(() => Stand.Grundpreis = w ?? Stand.Grundpreis))" />

                            @if (Stand.MitLeistungspreis)
                            {
                                <Zahlenfeld Bezeichnung="@LabelLeistungspreis" Einheit="@Stand.EinheitLeistungspreis"
                                            Wert="@Stand.Leistungspreis"
                                            WertChanged="@(w => Feld(() => Stand.Leistungspreis = w ?? Stand.Leistungspreis))" />
                                <Auswahlfeld Eintraege="@LEISTUNGSMODI"
                                             Auswahl="@(Stand.LeistungsModusMonat ? 1 : 0)"
                                             AuswahlChanged="BeiLeistungsModus" />
                            }

                            @* Q11 (Entscheid 22.09.2026, Weg 2 aus Nach #291): Die zweistufige
                               Leistungspreis-Staffel steht hier, neben der Energiepreisstruktur -
                               nur beim Stromtraeger im Projektkontext. Ein GELEERTES Feld heisst
                               "nicht gepflegt" (NULL), nicht "Wert von vorhin": Anders als die
                               Preise oben laesst sich die Staffel so wieder abschalten. *@
                            @if (Stand.MitStaffel)
                            {
                                <Formulargruppe Titel="@TitelStaffel">
                                    <KindInhalt>
                                        <Zahlenfeld Bezeichnung="@LabelStaffelGrenze" Einheit="kW"
                                                    Wert="@Stand.StaffelGrenze" Min="0" Nachkommastellen="0"
                                                    WertChanged="@(w => Feld(() => Stand.StaffelGrenze = w))" />
                                        <Zahlenfeld Bezeichnung="@LabelStaffelPreis1" Einheit="€/(kW·a)"
                                                    Wert="@Stand.StaffelPreis1" Min="0" Nachkommastellen="2"
                                                    WertChanged="@(w => Feld(() => Stand.StaffelPreis1 = w))" />
                                        <Zahlenfeld Bezeichnung="@LabelStaffelPreis2" Einheit="€/(kW·a)"
                                                    Wert="@Stand.StaffelPreis2" Min="0" Nachkommastellen="2"
                                                    WertChanged="@(w => Feld(() => Stand.StaffelPreis2 = w))" />
                                    </KindInhalt>
                                </Formulargruppe>
                            }

                            @if (Stand.MitHeizwert)
                            {
                                <Zahlenfeld Bezeichnung="@LabelHeizwert" Einheit="@Stand.EinheitHeizwert"
                                            Wert="@Stand.Heizwert"
                                            WertChanged="@(w => Feld(() => Stand.Heizwert = w ?? Stand.Heizwert))" />
                            }
                            @if (Stand.MitBrennwert)
                            {
                                <Zahlenfeld Bezeichnung="@LabelBrennwert" Einheit="@Stand.EinheitBrennwert"
                                            Wert="@Stand.Brennwert"
                                            WertChanged="@(w => Feld(() => Stand.Brennwert = w ?? Stand.Brennwert))" />
                            }
                        </KindInhalt>
                    </Formularraster>

                    @* Die beiden Zeilen zur Preisbasis stehen wie die Staffelzeile AUSSERHALB
                       des Rasters: Saetze, keine Felder. Die erste sagt, warum „€/kWh" fehlt
                       (Heizwert noch nicht gepflegt), die zweite, warum die Karte die
                       Mengeneinheit zeigt (Schemastand vor 112 - kein stiller Rueckfall). *@
                    @if (!string.IsNullOrEmpty(Stand.PreisbasisHinweis))
                    {
                        <Herleitungszeile Text="@Stand.PreisbasisHinweis" />
                    }
                    @if (!string.IsNullOrEmpty(Stand.PreisbasisHerleitung))
                    {
                        <Herleitungszeile Text="@Stand.PreisbasisHerleitung" />
                    }

                    @* Die Erklaerzeile der Staffel steht AUSSERHALB des Rasters: ein Satz,
                       kein Feld - in einer Rasterzelle fiele er auf halbe Breite. *@
                    @if (Stand.MitStaffel)
                    {
                        <Herleitungszeile Text="@HinweisStaffel" />
                    }

                    @* ETAPPE E9b (Konzept § 2.11.5, Pflege; E9b-Q1): JE PREIS EIN ±-KNOPF -
                       dasselbe Muster wie an der Kostenposition. Er oeffnet den
                       CaseEingabeDialog als Szenariopaar in der Ueberlagerung des Wirts;
                       geschrieben wird mit der Karte (Speichern/OK). Das Kennzeichen am
                       Knopf sagt, ob ein Paar gepflegt ist; ein gepflegter Preis OHNE
                       Erwartet-Preis traegt das Warnzeichen und eine Zeile darunter
                       (E9b-Q4: warnen, nicht verweigern). Ein Szenario-Leistungspreis neben
                       einer Staffel oder Saisonreihe bleibt ohne Wirkung - die
                       Kohaerenzzeile sagt es (E9a-Q3). Nur im Projektkontext: Die
                       Szenariopreise stehen an der Projektuebersteuerung. *@
                    @if (Stand.MitSzenario && SzenarioPflegen.HasDelegate)
                    {
                        <div class="epos-szenarioleiste" role="group" aria-label="@TitelSzenario">
                            <SzenarioKnopf Text="@LabelArbeitspreis" Gepflegt="@Stand.SzenarioArbeitGepflegt"
                                           Warnung="@(Stand.SzenarioArbeitGepflegt && Stand.SzenarioArbeitOhneErwartet)"
                                           Kurztext="@SzenarioKurztext(PREIS_ARBEIT)"
                                           GepflegtText="@SzenarioGepflegtText" WarnungText="@SzenarioWarnungText"
                                           Angefordert="() => SzenarioPflegen.InvokeAsync(PREIS_ARBEIT)" />
                            <SzenarioKnopf Text="@LabelGrundpreis" Gepflegt="@Stand.SzenarioGrundGepflegt"
                                           Kurztext="@SzenarioKurztext(PREIS_GRUND)"
                                           GepflegtText="@SzenarioGepflegtText" WarnungText="@SzenarioWarnungText"
                                           Angefordert="() => SzenarioPflegen.InvokeAsync(PREIS_GRUND)" />
                            @if (Stand.MitLeistungspreis)
                            {
                                <SzenarioKnopf Text="@LabelLeistungspreis" Gepflegt="@Stand.SzenarioLeistungGepflegt"
                                               Warnung="@(Stand.SzenarioLeistungGepflegt && Stand.SzenarioLeistungOhneErwartet)"
                                               Kurztext="@SzenarioKurztext(PREIS_LEISTUNG)"
                                               GepflegtText="@SzenarioGepflegtText" WarnungText="@SzenarioWarnungText"
                                               Angefordert="() => SzenarioPflegen.InvokeAsync(PREIS_LEISTUNG)" />
                            }
                        </div>
                        <Herleitungszeile Text="@HinweisSzenario" />
                        @foreach (string zeile in SzenarioZeilen)
                        {
                            <Kohaerenzzeile Text="@zeile" Zustand="KohaerenzZustand.Abweichend" />
                        }
                    }

                    @* Die Effektivzeile steht bei Hi und Hs, nicht bei den Regeln: Sie
                       faellt AUS ihnen. *@
                    @if (!string.IsNullOrEmpty(Stand.EffektivText))
                    {
                        <Herleitungszeile Text="@Stand.EffektivText" />
                    }

                    @if (Stand.MitFormel)
                    {
                        @if (!string.IsNullOrEmpty(Stand.HerleitungPreis))
                        {
                            <Herleitungszeile Text="@Stand.HerleitungPreis" />
                        }
                        <Herleitungszeile Text="@($"{LabelFormel} {Stand.FormelText}")" />
                    }

                    @* ETAPPE E2 (Mockup-Prüfung 03/#41): EINE Leiste für beide Knöpfe.
                       Sie standen in zwei eigenen `.epos-leiste`-Kästen untereinander,
                       obwohl sie dasselbe tun — Sätze dieses Trägers pflegen. Zwei
                       Leisten sind zwei Bedienblöcke; hier gibt es nur einen. Die
                       Bedingungen bleiben je Knopf, die Leiste entfällt mit beiden.

                       B3: Die Katalogwerte der Administration in das Projekt holen — eine
                       einmalige Kopie. Geschrieben wird erst mit „Speichern"/„OK", damit
                       daraus eine Historienzeile wird. *@
                    @if (Stand.MitLeistungspreis || Stand.MitKatalogUebernahme)
                    {
                        <div class="epos-leiste">
                            @if (Stand.MitLeistungspreis)
                            {
                                <button type="button" class="epos-knopf"
                                        @onclick="() => SaisonSaetze.InvokeAsync()">@SaisonText</button>
                            }
                            @if (Stand.MitKatalogUebernahme)
                            {
                                <button type="button" class="epos-knopf"
                                        @onclick="() => KatalogUebernehmen.InvokeAsync()">@KatalogUebernehmenText</button>
                            }
                        </div>
                        @if (Stand.MitLeistungspreis && !string.IsNullOrEmpty(Stand.ReihenStatus))
                        {
                            <Herleitungszeile Text="@Stand.ReihenStatus" />
                        }
                        @if (Stand.MitKatalogUebernahme && !string.IsNullOrEmpty(Stand.UebernahmeHinweis))
                        {
                            <Herleitungszeile Text="@Stand.UebernahmeHinweis" />
                        }
                    }

                    @* Fehlende Preise: Hinweis am Ort der Pflege, daneben der Weg. Der
                       Hinweis sperrt nichts - ein halbgepflegter Traeger muss sich
                       anlegen lassen. Geschrieben wird erst, was der Anwender in der
                       Rueckfrage bestaetigt. *@
                    @foreach (Wertluecke luecke in Preisluecken)
                    {
                        @if (!string.IsNullOrEmpty(luecke.Hinweis))
                        {
                            <Warnbanner Stufe="WarnStufe.Hinweis" Text="@luecke.Hinweis" />
                        }
                        @if (!string.IsNullOrEmpty(luecke.KnopfText))
                        {
                            <div class="epos-leiste">
                                <button type="button" class="epos-knopf"
                                        @onclick="() => LueckeUebernehmen.InvokeAsync(luecke.Groesse)">@luecke.KnopfText</button>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(luecke.Leihzeile))
                        {
                            <Herleitungszeile Text="@luecke.Leihzeile" />
                        }
                    }
                </KindInhalt>
            </Gruppenkopf>
        </div>

        @* ---------------- Block B: Preisbestandteile bzw. Strompreis Details *@
        <div class="epos-blockspalte">
            @if (Stand.Zerlegung is not null)
            {
                <StrompreisDetails @attributes="ZerlegungTexte" Stand="@Stand.Zerlegung"
                                   Anzeige="@ZerlegungAnzeige"
                                   ArbeitspreisCtKwh="@ArbeitspreisCtKwh"
                                   BeschaffungVorschlag="@BeschaffungVorschlag"
                                   SatzRegelfall="@SatzRegelfall" SatzReduziert="@SatzReduziert"
                                   VorgabeOffen="true"
                                   Geaendert="BeiPreisblock"
                                   InArbeitspreis="() => InArbeitspreis.InvokeAsync()" />
            }

            @if (Stand.Bestandteile is not null)
            {
                <BrennstoffBestandteile @attributes="BestandteilTexte"
                                        Stand="@Stand.Bestandteile" Anzeige="@BestandteilAnzeige"
                                        ArbeitspreisCtKwh="@ArbeitspreisCtKwh"
                                        Heizwert="@BestandteilHeizwert"
                                        Einheit="@BestandteilEinheit"
                                        HinweisOhneHeizwert="@BestandteilHinweis"
                                        HerleitungEnergiesteuer="@HerleitungEnergiesteuer"
                                        HerleitungCo2="@HerleitungCo2"
                                        VertriebVorschlag="@VertriebVorschlag"
                                        SatzRegel="@SatzRegel" Satz53a="@Satz53a" Satz54="@Satz54"
                                        SatzCo2="@SatzCo2"
                                        Geaendert="BeiPreisblock"
                                        InArbeitspreis="() => InArbeitspreis.InvokeAsync()" />
            }
        </div>
    </div>

    @* ==================================================== Block C: Emissionen *@
    <Gruppenkopf Titel="@TitelBlockEmissionen">
        <KindInhalt>
            @* Derselbe Weg wie bei den Preisen, nur fuer den CO2-Wert - er wird
               hier gepflegt, also steht der Hinweis hier. *@
            @foreach (Wertluecke luecke in Co2luecken)
            {
                @if (!string.IsNullOrEmpty(luecke.Hinweis))
                {
                    <Warnbanner Stufe="WarnStufe.Hinweis" Text="@luecke.Hinweis" />
                }
                @if (!string.IsNullOrEmpty(luecke.KnopfText))
                {
                    <div class="epos-leiste">
                        <button type="button" class="epos-knopf"
                                @onclick="() => LueckeUebernehmen.InvokeAsync(luecke.Groesse)">@luecke.KnopfText</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(luecke.Leihzeile))
                {
                    <Herleitungszeile Text="@luecke.Leihzeile" />
                }
            }

            @if (!Stand.EmissionenVerfuegbar)
            {
                <Warnbanner Stufe="WarnStufe.Warnung" Text="@KeinKatalogText" />
                <Formularraster>
                    <KindInhalt>
                        <Zahlenfeld Bezeichnung="@LabelCo2" Einheit="g/kWh" Wert="@Stand.AltCO2"
                                    WertChanged="@(w => Feld(() => Stand.AltCO2 = w ?? Stand.AltCO2))" />
                        <Zahlenfeld Bezeichnung="@LabelSo2" Einheit="g/kWh" Wert="@Stand.AltSO2"
                                    WertChanged="@(w => Feld(() => Stand.AltSO2 = w ?? Stand.AltSO2))" />
                        <Zahlenfeld Bezeichnung="@LabelNox" Einheit="g/kWh" Wert="@Stand.AltNOx"
                                    WertChanged="@(w => Feld(() => Stand.AltNOx = w ?? Stand.AltNOx))" />
                    </KindInhalt>
                </Formularraster>
            }
            else
            {
                @* ET-D-2: Die Bilanzierungsmethode ist eine WAHL AUS ZWEIEN und steht
                   deshalb als Klappliste da - eine Optionsgruppe kostete zwei Zeilen
                   fuer dieselbe Aussage. Im Katalogkontext ist sie Projektsache und
                   nur lesbar; der Grund steht darunter. *@
                <div class="epos-feldpaar">
                    <Auswahlfeld Bezeichnung="@LabelModus" Eintraege="@MODI"
                                 Auswahl="@(Stand.ModusCo2e ? 1 : 0)"
                                 Aktiv="@(!Stand.ModusNurLesend)"
                                 AuswahlChanged="BeiModus" />
                    <Herleitungszeile Text="@Stand.ModusOrt" />
                </div>
                @if (!string.IsNullOrEmpty(Stand.ModusHinweis))
                {
                    <Herleitungszeile Text="@Stand.ModusHinweis" />
                }

                <Raster TZeile="EmissionsFeldZeile" Zeilen="@Stand.Emissionszeilen.AsQueryable()"
                        Bearbeitbar="true">
                    <KindInhalt>
                        <TemplateColumn TGridItem="EmissionsFeldZeile" Title="@SpalteArt">
                            @context.Name
                        </TemplateColumn>
                        <TemplateColumn TGridItem="EmissionsFeldZeile" Title="@SpalteWert">
                            <Zahlenfeld Wert="@context.Wert" Aktiv="@(!context.NurLesend)"
                                        WertChanged="@(w => EmissionsWert(context, w))" />
                        </TemplateColumn>
                        <TemplateColumn TGridItem="EmissionsFeldZeile" Title="@SpalteEinheit">
                            @context.Einheit
                        </TemplateColumn>
                        <TemplateColumn TGridItem="EmissionsFeldZeile" Title="@SpalteHerkunft">
                            <span title="@context.Herkunft">@context.Herkunft</span>
                        </TemplateColumn>
                        <TemplateColumn TGridItem="EmissionsFeldZeile" Title="">
                            <button type="button" class="epos-knopf" disabled="@context.NurLesend"
                                    @onclick="@(() => KatalogFuerZeile.InvokeAsync(context.Kuerzel))">@KatalogZeileText</button>
                        </TemplateColumn>
                    </KindInhalt>
                </Raster>

                <Kohaerenzzeile Text="@Stand.EmissionsSumme" />
                @if (!string.IsNullOrEmpty(Stand.EmissionsFussnote))
                {
                    <Herleitungszeile Text="@Stand.EmissionsFussnote" />
                }
                @if (!string.IsNullOrEmpty(Stand.EmissionsHinweis))
                {
                    <Warnbanner Stufe="WarnStufe.Hinweis" Text="@Stand.EmissionsHinweis" />
                }
                <button type="button" class="epos-knopf"
                        @onclick="() => KatalogVerwalten.InvokeAsync()">@KatalogVerwaltenText</button>
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ======================================= Block D: Einheiten und Umrechnung *@
    <Gruppenkopf Titel="@TitelBlockEinheiten">
        <KindInhalt>
            <div class="epos-modulparameter">
                <button type="button" class="epos-modulparameter-knopf"
                        aria-expanded="@(_einheitenOffen ? "true" : "false")"
                        @onclick="() => _einheitenOffen = !_einheitenOffen">
                    <span class="epos-modulparameter-pfeil" aria-hidden="true">@(_einheitenOffen ? "▾" : "▸")</span>
                    <span>@TitelBlockEinheiten</span>
                </button>

                @if (_einheitenOffen)
                {
                    @* Die Preisbasis steht am Arbeitspreis (Block A, ET-D-4); hier bleibt
                       die Einheit, in der die Regelkette beginnt. *@
                    <Herleitungszeile Text="@($"{LabelBasiseinheit} {Stand.Basiseinheit}")" />

                    <Raster TZeile="UmrechnungsregelZeile" Zeilen="@Stand.Regeln.AsQueryable()"
                            Bearbeitbar="true">
                        <KindInhalt>
                            <TemplateColumn TGridItem="UmrechnungsregelZeile" Title="@SpalteName">
                                <Textfeld Wert="@context.Name"
                                          WertChanged="@(w => Regel(context, () => context.Name = w))" />
                            </TemplateColumn>
                            <TemplateColumn TGridItem="UmrechnungsregelZeile" Title="@SpalteVon">
                                <Textfeld Wert="@context.Von"
                                          WertChanged="@(w => Regel(context, () => context.Von = w))" />
                            </TemplateColumn>
                            <TemplateColumn TGridItem="UmrechnungsregelZeile" Title="@SpalteNach">
                                <Textfeld Wert="@context.Nach"
                                          WertChanged="@(w => Regel(context, () => context.Nach = w))" />
                            </TemplateColumn>
                            <TemplateColumn TGridItem="UmrechnungsregelZeile" Title="@SpalteFaktor">
                                <Zahlenfeld Wert="@context.Faktor" Min="0"
                                            WertChanged="@(w => Faktor(context, w))" />
                            </TemplateColumn>
                            <TemplateColumn TGridItem="UmrechnungsregelZeile" Title="@SpalteAktiv">
                                <Schalter Wert="@context.Aktiv"
                                          WertChanged="@(w => Abschalten(context, w))" />
                            </TemplateColumn>
                        </KindInhalt>
                    </Raster>

                    <div class="epos-leiste">
                        <button type="button" class="epos-knopf"
                                @onclick="() => RegelNeu.InvokeAsync()">@RegelNeuText</button>
                    </div>

                    @* ETAPPE E2 (Mockup-Prüfung 03/#42): Das Verstoßbanner steht VOR der
                       Erklärzeile. Ein Banner meldet einen Zustand, den der Anwender
                       beheben muss; die leise Regelzeile erklärt ihn. Stand die
                       Erklärung darüber, las er zuerst die Regel und erst danach, dass
                       sie verletzt ist — gestaffelt wird von der Meldung zum Grund. *@
                    @if (!string.IsNullOrEmpty(Stand.VerstossText))
                    {
                        <Warnbanner Stufe="WarnStufe.Warnung" Text="@Stand.VerstossText" />
                    }

                    <Herleitungszeile Text="@HinweisRegeln" />
                }
            </div>
        </KindInhalt>
    </Gruppenkopf>

    @* ================================================ Historie und Speichern *@
    <Gruppenkopf Titel="@TitelHistorie">
        <KindInhalt>
            <div class="epos-feldpaar">
                @* Das Datum ist eine Eingabe wie jede andere: Es meldet sich beim Wirt,
                   damit ein Vermerk „gespeichert" wegfaellt und Speichern wieder geht. *@
                <Datumsfeld Bezeichnung="@LabelGueltigAb" Wert="@Stand.GueltigAb"
                            WertChanged="@(w => Feld(() => Stand.GueltigAb = w))" />
                <button type="button" class="epos-knopf epos-knopf--primaer"
                        disabled="@SpeichernGesperrt"
                        title="@(SpeichernGesperrt ? Resource.ADM_TIP_SPEICHERN_UNVERAENDERT : null)"
                        @onclick="() => Speichern.InvokeAsync()">@SpeichernText</button>
                @* Die Rueckmeldung steht neben dem Knopf, der geklickt wurde - dieselbe
                   Statusspanne wie in der SpeichernLeiste, derselbe Text. *@
                @if (!string.IsNullOrEmpty(SpeichernVermerk))
                {
                    <span class="epos-status @(SpeichernVermerkFehler ? "epos-status--fehler" : "")"
                          role="status">@SpeichernVermerk</span>
                }
            </div>

            <Raster TZeile="PreishistorieZeile" Zeilen="@Stand.Historie.AsQueryable()">
                <KindInhalt>
                    <PropertyColumn TGridItem="PreishistorieZeile" TProp="string"
                                    Property="@(z => z.GueltigAb)" Title="@SpalteGueltigAb" />
                    <PropertyColumn TGridItem="PreishistorieZeile" TProp="string"
                                    Property="@(z => z.Heizwert)" Title="@SpalteHeizwertMitEinheit" />
                    <PropertyColumn TGridItem="PreishistorieZeile" TProp="string"
                                    Property="@(z => z.Basiseinheit)" Title="@SpalteBasisEinheit" />
                    <PropertyColumn TGridItem="PreishistorieZeile" TProp="string"
                                    Property="@(z => z.Arbeitspreis)" Title="@SpalteArbeitspreis" />
                    <PropertyColumn TGridItem="PreishistorieZeile" TProp="string"
                                    Property="@(z => z.Grundpreis)" Title="@SpalteGrundpreis" />
                    <PropertyColumn TGridItem="PreishistorieZeile" TProp="string"
                                    Property="@(z => z.Leistungspreis)" Title="@SpalteLeistungspreis" />
                    @* Die Aktionsspalte steht HINTEN und traegt einen Kopf mit
                       Beschriftung; der Knopf ist immer sichtbar (Hausregel). *@
                    <TemplateColumn TGridItem="PreishistorieZeile" Title="@HistorieLoeschenText">
                        <button type="button" class="epos-knopf" title="@HistorieLoeschTitel"
                                disabled="@(HistorieLoeschen is null)"
                                @onclick="@(() => LoeschenFragen(context))">@HistorieLoeschenText</button>
                    </TemplateColumn>
                </KindInhalt>
            </Raster>

            @if (!string.IsNullOrEmpty(Stand.HistorieHinweis))
            {
                <Herleitungszeile Text="@Stand.HistorieHinweis" />
            }
        </KindInhalt>
    </Gruppenkopf>

    <Rueckfrage Offen="@(_loeschzeile is not null)" TitelText="@HistorieLoeschTitel"
                JaText="@JaText" NeinText="@NeinText" VorgabeNein="true"
                Frage="@(string.Format(VorlageHistorieLoeschen, _loeschzeile?.GueltigAb ?? ""))"
                Beantwortet="BeiLoeschfrage" />
</div>

@code {
    /// <summary>
    /// Steht Block D („Einheiten und Umrechnung") offen? Vorgabe ist ZU: Der
    /// Block prüft die Einheitenkette und wird selten gebraucht.
    /// </summary>
    private bool _einheitenOffen;

    /// <summary>Prüfhilfe für die Tests: Ist Block D gerade aufgeklappt?</summary>
    public bool EinheitenOffen => _einheitenOffen;

    /// <summary>Der Bearbeitungsstand der Trägerkarte.</summary>
    [Parameter] public EnergietraegerStand Stand { get; set; } = new();

    /// <summary>Summen- und Restzeile des Strom-Zerlegungsblocks (von der Hülle gerechnet).</summary>
    [Parameter] public PreisblockAnzeige ZerlegungAnzeige { get; set; } = new("", "", false);

    /// <summary>Dasselbe für die Preiszerlegung.</summary>
    [Parameter] public PreisblockAnzeige BestandteilAnzeige { get; set; } = new("", "", false);

    /// <summary>Der Arbeitspreis in ct/kWh — Bezugsgröße der Restzeile.</summary>
    [Parameter] public double ArbeitspreisCtKwh { get; set; }

    /// <summary>
    /// Die Texte des Strom-Zerlegungsblocks (<c>MyResource.PREIS_*</c>) — sie kommen
    /// als Satz herein, damit der verschachtelte Baustein sie nicht einzeln
    /// durchgereicht bekommen muss. Leer = die deutschen Vorgaben der Komponente.
    /// </summary>
    [Parameter] public IReadOnlyDictionary<string, object>? ZerlegungTexte { get; set; }

    /// <summary>Dasselbe für die Preiszerlegung (<c>BB_*</c>).</summary>
    [Parameter] public IReadOnlyDictionary<string, object>? BestandteilTexte { get; set; }

    // ---- Die Anzeigekante der Preisbestandteile (ET-D-1) ------------------

    /// <summary>Heizwert je Abrechnungseinheit [kWh]; 0 = keiner.</summary>
    [Parameter] public double BestandteilHeizwert { get; set; }

    /// <summary>„€/m³" bzw. „ct/kWh" — die Einheit der Bestandteilfelder.</summary>
    [Parameter] public string BestandteilEinheit { get; set; } = "ct/kWh";

    /// <summary>Warum die Bestandteile in ct/kWh stehen; leer = sie tun es nicht.</summary>
    [Parameter] public string BestandteilHinweis { get; set; } = "";

    /// <summary>„5,50 €/MWh (Hs)" — Herleitung der Energiesteuerzeile.</summary>
    [Parameter] public string HerleitungEnergiesteuer { get; set; } = "";

    /// <summary>„65 €/t × 2,109 kg/m³" — Herleitung der BEHG-Zeile.</summary>
    [Parameter] public string HerleitungCo2 { get; set; } = "";

    /// <summary>Der Rest-Vorschlag für „Beschaffung und Vertrieb" [ct/kWh].</summary>
    [Parameter] public double? VertriebVorschlag { get; set; }

    [Parameter] public Schnellwahlsatz? SatzRegelfall { get; set; }
    [Parameter] public Schnellwahlsatz? SatzReduziert { get; set; }
    [Parameter] public Schnellwahlsatz? SatzRegel { get; set; }
    [Parameter] public Schnellwahlsatz? Satz53a { get; set; }
    [Parameter] public Schnellwahlsatz? Satz54 { get; set; }
    [Parameter] public Schnellwahlsatz? SatzCo2 { get; set; }

    /// <summary>Ein Feld hat sich geändert — die Hülle rechnet Formel, Effektivzeile
    /// und Preisblöcke nach.</summary>
    [Parameter] public EventCallback Geaendert { get; set; }

    /// <summary>Die Preisbasis wurde gewechselt — die Hülle rechnet alle Felder um.</summary>
    [Parameter] public EventCallback<int> PreisbasisGewechselt { get; set; }

    /// <summary>Der Leistungspreis-Modus wurde umgestellt (KATALOGsache je Träger).</summary>
    [Parameter] public EventCallback<bool> LeistungsModusGewechselt { get; set; }

    /// <summary>„Saisonale Sätze…" (FK6a).</summary>
    [Parameter] public EventCallback SaisonSaetze { get; set; }

    /// <summary>„Regel hinzufügen" (K3).</summary>
    [Parameter] public EventCallback RegelNeu { get; set; }

    /// <summary>
    /// DER RIEGEL (§ 4.3): Die Regel, die den Träger nach kWh trägt, lässt sich
    /// nicht abschalten. Gefragt wird der Prüfer in der Hülle — damit gibt es
    /// keine zweite Fassung der Fachregel. Rückgabe <c>false</c> = bleibt an.
    /// </summary>
    [Parameter] public Func<UmrechnungsregelZeile, bool, bool>? RegelAbschalten { get; set; }

    /// <summary>„In Arbeitspreis übernehmen" der Preiszerlegung.</summary>
    [Parameter] public EventCallback InArbeitspreis { get; set; }

    /// <summary>Der Rest-Vorschlag für die Beschaffung [ct/kWh]; <c>null</c> = keiner.</summary>
    [Parameter] public double? BeschaffungVorschlag { get; set; }

    /// <summary>„Katalog…" einer Emissionszeile (E4), mit dem Kürzel der Art.</summary>
    [Parameter] public EventCallback<string> KatalogFuerZeile { get; set; }

    /// <summary>„Emissionsarten &amp; Katalog verwalten…".</summary>
    [Parameter] public EventCallback KatalogVerwalten { get; set; }

    /// <summary>„💾 Speichern" der Trägerkarte.</summary>
    [Parameter] public EventCallback Speichern { get; set; }

    /// <summary>
    /// Rückmeldung des Wirts nach „Speichern" (etwa „Gespeichert um 14:02:33"),
    /// neben dem Knopf gezeigt; leer = kein Vermerk.
    /// </summary>
    [Parameter] public string SpeichernVermerk { get; set; } = "";

    /// <summary>Ist <see cref="SpeichernVermerk"/> eine Fehlermeldung?</summary>
    [Parameter] public bool SpeichernVermerkFehler { get; set; }

    /// <summary>
    /// Seit dem letzten Speichern nichts geändert: Der Knopf ist gedämpft, bis die
    /// nächste Eingabe kommt — wie „Speichern" in der <c>SpeichernLeiste</c>.
    /// </summary>
    [Parameter] public bool SpeichernGesperrt { get; set; }

    /// <summary>
    /// B3: „Katalogwerte übernehmen" — holt die Werte der Administration in die
    /// Felder. Eine einmalige Kopie; geschrieben wird erst mit „Speichern".
    /// </summary>
    [Parameter] public EventCallback KatalogUebernehmen { get; set; }

    /// <summary>
    /// „Wert aus der Kategorie übernehmen…" — mit dem Schlüssel der Größe. Der
    /// Wirt legt die Kandidaten zur Bestätigung vor; diese Karte schreibt nichts.
    /// </summary>
    [Parameter] public EventCallback<string> LueckeUebernehmen { get; set; }

    // ---- ETAPPE E9b: die ±-Knöpfe der Preise (Konzept § 2.11.5, Pflege) ------

    /// <summary>ETAPPE E9b: der Schlüssel des Arbeitspreises für <see cref="SzenarioPflegen"/>.</summary>
    public const string PREIS_ARBEIT = "ARBEIT";

    /// <summary>ETAPPE E9b: der Schlüssel des Grundpreises.</summary>
    public const string PREIS_GRUND = "GRUND";

    /// <summary>ETAPPE E9b: der Schlüssel des Leistungspreises.</summary>
    public const string PREIS_LEISTUNG = "LEISTUNG";

    /// <summary>
    /// ETAPPE E9b: „±" an einem Preis — mit dem Schlüssel der Preisart
    /// (<see cref="PREIS_ARBEIT"/> …). Der Wirt öffnet den <c>CaseEingabeDialog</c> als
    /// Szenariopaar; diese Karte schreibt nichts. Kein Delegat, kein Knopf.
    /// </summary>
    [Parameter] public EventCallback<string> SzenarioPflegen { get; set; }

    /// <summary>ETAPPE E9b (ETV_SZ_TITEL): der Name der Knopfgruppe für die Sprachausgabe.</summary>
    [Parameter] public string TitelSzenario { get; set; } = "Szenariopreise Best/Worst";

    /// <summary>ETAPPE E9b (ETV_SZ_HINWEIS): die leise Zeile unter den ±-Knöpfen.</summary>
    [Parameter] public string HinweisSzenario { get; set; }
        = "± je Preis: Best (Günstig) und Worst (Ungünstig) — leer heißt „wie Erwartet“; "
        + "geschrieben wird mit der Karte.";

    /// <summary>ETAPPE E9b (ETV_SZ_OHNE_ERWARTET): Kohärenzzeile eines gepflegten Paars ohne
    /// Erwartet-Preis, <c>{0}</c> = die Preisart.</summary>
    [Parameter] public string VorlageSzenarioOhneErwartet { get; set; }
        = "{0}: Szenariopreis ohne Erwartet-Preis — Günstig und Ungünstig rechnen damit, "
        + "Erwartet zeigt die Datenlücke.";

    /// <summary>ETAPPE E9b (SZP_GEPFLEGT): das Wort im aria-label eines gepflegten Knopfes.</summary>
    [Parameter] public string SzenarioGepflegtText { get; set; } = "gepflegt";

    /// <summary>ETAPPE E9b (SZP_OHNE_ERWARTET_KURZ): das Wort im aria-label bei Warnung.</summary>
    [Parameter] public string SzenarioWarnungText { get; set; } = "ohne Erwartet-Wert";

    /// <summary>
    /// ETAPPE E9b: der Kurztext eines ±-Knopfes — was er tut und, wenn gepflegt, die zwei
    /// Werte in der Einheit des Feldes daneben.
    /// </summary>
    private string SzenarioKurztext(string preisart) => preisart switch
    {
        PREIS_GRUND => Szenariopaar.Kurztext(Stand.SzenarioGrundBest, Stand.SzenarioGrundWorst,
                                             Stand.Grundpreis, Stand.EinheitGrundpreis, 2),
        PREIS_LEISTUNG => Szenariopaar.Kurztext(Stand.SzenarioLeistungBest, Stand.SzenarioLeistungWorst,
                                                Stand.Leistungspreis, Stand.EinheitLeistungspreis, 2),
        _ => Szenariopaar.Kurztext(Stand.SzenarioArbeitBest, Stand.SzenarioArbeitWorst,
                                   Stand.Arbeitspreis, Stand.EinheitArbeitspreis, 4)
    };

    /// <summary>
    /// ETAPPE E9b: die Kohärenzzeilen unter den ±-Knöpfen — ein gepflegtes Paar ohne
    /// Erwartet-Preis (E9b‑Q4) und ein Szenario-Leistungspreis neben Staffel oder
    /// Saisonreihe (E9a‑Q3). Nur, was gepflegt ist, bekommt eine Zeile.
    /// </summary>
    public IReadOnlyList<string> SzenarioZeilen
    {
        get
        {
            var liste = new List<string>();
            if (Stand.SzenarioArbeitGepflegt && Stand.SzenarioArbeitOhneErwartet)
                liste.Add(string.Format(VorlageSzenarioOhneErwartet, LabelArbeitspreis));
            if (Stand.MitLeistungspreis && Stand.SzenarioLeistungGepflegt)
            {
                if (Stand.SzenarioLeistungOhneErwartet)
                    liste.Add(string.Format(VorlageSzenarioOhneErwartet, LabelLeistungspreis));
                if (!string.IsNullOrEmpty(Stand.SzenarioLeistungOhneWirkung))
                    liste.Add(Stand.SzenarioLeistungOhneWirkung);
            }
            return liste;
        }
    }

    /// <summary>Die Lückenzeilen der beiden Preise (Arbeits- und Leistungspreis).</summary>
    private IEnumerable<Wertluecke> Preisluecken => Luecken(false);

    /// <summary>Die Lückenzeile des CO₂-Wertes.</summary>
    private IEnumerable<Wertluecke> Co2luecken => Luecken(true);

    private IEnumerable<Wertluecke> Luecken(bool co2)
    {
        foreach (Wertluecke l in Stand.Wertluecken)
        {
            bool istCo2 = string.Equals(l.Groesse, EnergietraegerRueckfall.GROESSE_CO2,
                                        StringComparison.Ordinal);
            if (istCo2 == co2) yield return l;
        }
    }

    /// <summary>
    /// Löscht EINE Zeile der Preishistorie (Anwenderwunsch 14.09.2026). Der Wirt
    /// schreibt und meldet: <c>true</c> = gelöscht, <c>false</c> = abgelehnt, den
    /// Grund nennt er selbst. <c>null</c> = die Karte zeigt den Knopf gesperrt.
    /// </summary>
    [Parameter] public Func<PreishistorieZeile, bool>? HistorieLoeschen { get; set; }

    // ---- Texte ----------------------------------------------------------

    /// <summary>Blocktitel A.</summary>
    [Parameter] public string TitelBlockPreis { get; set; } = "Preis und Heizwert";

    /// <summary>Blocktitel C.</summary>
    [Parameter] public string TitelBlockEmissionen { get; set; }
        = "Emissionen — Anzeige folgt der Bilanzierungsvorgabe des Projekts";

    /// <summary>Blocktitel D (der Aufklappknopf trägt denselben Text).</summary>
    [Parameter] public string TitelBlockEinheiten { get; set; } = "Einheiten und Umrechnung";

    /// <summary>Die leise Zeile unter dem Regelblock: wozu die Regeln da sind.</summary>
    [Parameter] public string HinweisRegeln { get; set; }
        = "Diese Regeln prüfen die Einheitenkette; gerechnet wird mit Heizwert und Brennwert.";

    [Parameter] public string TitelHistorie { get; set; } = "Preishistorie";
    /// <summary>
    /// Der Kurzname der Preisbasis-Liste für die Sprachausgabe — sie steht ohne
    /// sichtbare Beschriftung unter dem Arbeitspreis (ET-D-4).
    /// </summary>
    [Parameter] public string LabelPreisbasisAria { get; set; } = "Einheit des Arbeitspreises";
    [Parameter] public string LabelBasiseinheit { get; set; } = "Basiseinheit:";
    [Parameter] public string LabelArbeitspreis { get; set; } = "Arbeitspreis";
    [Parameter] public string LabelLeistungspreis { get; set; } = "Leistungspreis";
    [Parameter] public string LabelGrundpreis { get; set; } = "Grundpreis";
    [Parameter] public string LabelHeizwert { get; set; } = "Heizwert";
    [Parameter] public string LabelBrennwert { get; set; } = "Brennwert";
    [Parameter] public string LabelFormel { get; set; } = "Formel:";
    [Parameter] public string ModusJahrText { get; set; } = "Jahresleistungspreis";
    [Parameter] public string ModusMonatText { get; set; } = "Monatsleistungspreis";
    [Parameter] public string SaisonText { get; set; } = "Saisonale Sätze…";

    // Q11: die zweistufige Leistungspreis-Staffel des Stromträgers (ETV_STAFFEL_*).
    [Parameter] public string TitelStaffel { get; set; }
        = "Leistungspreis-Staffel (auf die Jahres-Bezugsspitze)";
    [Parameter] public string LabelStaffelGrenze { get; set; } = "Staffelgrenze";
    [Parameter] public string LabelStaffelPreis1 { get; set; } = "Preis bis zur Grenze";
    [Parameter] public string LabelStaffelPreis2 { get; set; } = "Preis über der Grenze";
    [Parameter] public string HinweisStaffel { get; set; }
        = "Bemessen an der Viertelstundenspitze des Netzbezugs im Jahr: bis zur Grenze gilt "
        + "der erste, darüber der zweite Preis. Eine gepflegte Staffel ersetzt Leistungspreis "
        + "und saisonale Sätze dieses Stromträgers; leere Preise heißen „keine Staffel“.";
    [Parameter] public string SpalteName { get; set; } = "Name";
    [Parameter] public string SpalteVon { get; set; } = "von";
    [Parameter] public string SpalteNach { get; set; } = "nach";
    [Parameter] public string SpalteFaktor { get; set; } = "Faktor";
    [Parameter] public string SpalteAktiv { get; set; } = "aktiv";
    [Parameter] public string RegelNeuText { get; set; } = "Regel hinzufügen";
    [Parameter] public string LabelModus { get; set; } = "Bilanzierungsmethode";
    [Parameter] public string ModusCo2Text { get; set; } = "CO₂ direkt — reale Bilanz, heizwertbezogen";
    [Parameter] public string ModusCo2eText { get; set; } = "CO₂-Äquivalent (GWP₁₀₀)";
    [Parameter] public string SpalteArt { get; set; } = "Art";
    [Parameter] public string SpalteWert { get; set; } = "Wert";
    [Parameter] public string SpalteEinheit { get; set; } = "Einheit";
    [Parameter] public string SpalteHerkunft { get; set; } = "Quelle";
    [Parameter] public string KatalogZeileText { get; set; } = "Katalog…";
    [Parameter] public string KatalogVerwaltenText { get; set; }
        = "Emissionsarten & Katalog verwalten…";
    [Parameter] public string KeinKatalogText { get; set; }
        = "Der Emissionsarten-Katalog ist auf dieser Datenbank nicht verfügbar "
        + "(Migrationsschritt 57 fehlt). Es gelten die drei Bestandsfelder.";
    [Parameter] public string LabelCo2 { get; set; } = "CO2  [g/kWh]";
    [Parameter] public string LabelSo2 { get; set; } = "SO2  [g/kWh]";
    [Parameter] public string LabelNox { get; set; } = "NOx  [g/kWh]";
    [Parameter] public string LabelGueltigAb { get; set; } = "Gültig ab";
    [Parameter] public string SpeichernText { get; set; } = "💾 Speichern";
    [Parameter] public string SpalteGueltigAb { get; set; } = "Gültig ab";
    [Parameter] public string SpalteHeizwert { get; set; } = "Heizwert";

    /// <summary>Derselbe Spaltenkopf MIT Einheit — <c>{0}</c> ist kWh/&lt;Abrechnungseinheit&gt;.</summary>
    [Parameter] public string SpalteHeizwertVorlage { get; set; } = "Heizwert [{0}]";

    [Parameter] public string SpalteBasisEinheit { get; set; } = "Basis Einheit";
    [Parameter] public string SpalteArbeitspreis { get; set; } = "Arbeitspreis";
    [Parameter] public string SpalteGrundpreis { get; set; } = "Grundpreis [€/a]";
    [Parameter] public string SpalteLeistungspreis { get; set; } = "Leistungspreis";
    [Parameter] public string KatalogUebernehmenText { get; set; } = "Katalogwerte übernehmen";
    [Parameter] public string HistorieLoeschenText { get; set; } = "Löschen";
    [Parameter] public string HistorieLoeschTitel { get; set; } = "Preisstand löschen";
    [Parameter] public string VorlageHistorieLoeschen { get; set; } = "Preisstand vom {0} löschen?";
    [Parameter] public string JaText { get; set; } = "Ja";
    [Parameter] public string NeinText { get; set; } = "Nein";

    /// <summary>
    /// Der Spaltenkopf der Historie nennt die Einheit des Heizwerts
    /// (<c>kWh/&lt;Abrechnungseinheit&gt;</c>) — ohne Heizwert bleibt es beim
    /// nackten Wort, denn dann führt der Träger keinen.
    /// </summary>
    private string SpalteHeizwertMitEinheit
        => Stand.MitHeizwert && !string.IsNullOrEmpty(Stand.EinheitHeizwert)
            ? string.Format(SpalteHeizwertVorlage, Stand.EinheitHeizwert)
            : SpalteHeizwert;

    private (int Id, string Text)[] LEISTUNGSMODI
        => new[] { (0, ModusJahrText), (1, ModusMonatText) };

    private (int Id, string Text)[] MODI
        => new[] { (0, ModusCo2Text), (1, ModusCo2eText) };

    private void Feld(Action aendern)
    {
        aendern();
        Geaendert.InvokeAsync();
    }

    private Task BeiPreisbasis(int? id)
    {
        if (!id.HasValue) return Task.CompletedTask;
        Stand.PreisbasisId = id;
        return PreisbasisGewechselt.InvokeAsync(id.Value);
    }

    private Task BeiLeistungsModus(int? id)
    {
        Stand.LeistungsModusMonat = id == 1;
        return LeistungsModusGewechselt.InvokeAsync(Stand.LeistungsModusMonat);
    }

    private Task BeiModus(int? id)
    {
        Stand.ModusCo2e = id == 1;
        return Geaendert.InvokeAsync();
    }

    private Task BeiPreisblock() => Geaendert.InvokeAsync();

    private void Regel(UmrechnungsregelZeile zeile, Action aendern)
    {
        aendern();
        Geaendert.InvokeAsync();
    }

    /// <summary>
    /// Eine unbrauchbare Eingabe wird NICHT übernommen — das Zahlenfeld färbt
    /// sich und meldet nichts nach außen (Hausregel). Hier bleibt deshalb nur
    /// die zweite Bedingung des Vorläufers: ein Faktor muss größer null sein.
    /// </summary>
    private void Faktor(UmrechnungsregelZeile zeile, double? wert)
    {
        if (!wert.HasValue || wert.Value <= 0) return;
        zeile.Faktor = wert.Value;
        Geaendert.InvokeAsync();
    }

    private void Abschalten(UmrechnungsregelZeile zeile, bool an)
    {
        if (!an && RegelAbschalten is not null && !RegelAbschalten(zeile, false)) return;
        zeile.Aktiv = an;
        Geaendert.InvokeAsync();
    }

    private void EmissionsWert(EmissionsFeldZeile zeile, double? wert)
    {
        zeile.Wert = wert;
        Geaendert.InvokeAsync();
    }

    /// <summary>Die Zeile, nach der gerade gefragt wird; <c>null</c> = keine Frage.</summary>
    private PreishistorieZeile? _loeschzeile;

    /// <summary>
    /// Vor dem Löschen wird gefragt — ein Preisstand ist Geschichte, die sich
    /// nicht zurückholen lässt. Vorgabeknopf ist „Nein" (Hausregel für Fragen,
    /// deren „Ja" sofort löscht).
    /// </summary>
    private void LoeschenFragen(PreishistorieZeile zeile)
    {
        if (HistorieLoeschen is null) return;
        _loeschzeile = zeile;
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        PreishistorieZeile? zeile = _loeschzeile;
        _loeschzeile = null;
        if (antwort != true || zeile is null || HistorieLoeschen is null) return;

        // Der Wirt schreibt und meldet; die Tabelle zeichnet danach den Stand,
        // den die Hülle neu gelesen hat.
        HistorieLoeschen(zeile);
    }
}
