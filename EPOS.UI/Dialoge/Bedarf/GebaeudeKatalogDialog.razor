    protected override void OnInitialized()
    {
        _typen = Gebaeudetypen?.Invoke() ?? Array.Empty<string>();
        _arten = Gebaeudearten?.Invoke() ?? Array.Empty<string>();

        if (Modus == GebaeudeKatalogModus.Admin)
        {
            _namen = Katalognamen?.Invoke() ?? Array.Empty<string>();
            if (_namen.Count > 0)
            {
                _namensindex = 0;
                SatzLaden(_namen[0]);
            }
        }

        _ursprungsname = Daten.Name ?? "";
        ZweitenReiterFuellen();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

