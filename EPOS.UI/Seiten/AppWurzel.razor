    /// <summary>
    /// Fragt die stehende Assistentenseite und wechselt DANACH — oder gar nicht.
    /// </summary>
    /// <remarks>
    /// Der Wechsel kann nicht synchron bleiben: Die Rückfrage ist eine
    /// <c>Ueberlagerung</c> in derselben WebView, und ihre Antwort kommt erst mit
    /// dem nächsten Klick. <see cref="Zeige"/> meldet deshalb „behandelt" und
    /// schiebt die Arbeit hierher.
    /// </remarks>
    private async Task VerlassenUndZeigen(string maske, int? betriebsart)
    {
        EPOS.UI.Seiten.Assistent.AssistentSeite? seite = _assistentSeite;
        if (seite is null) return;

        EPOS.UI.Seiten.Assistent.AssistentVerlassen weg = await seite.FrageVerlassen();
        if (weg == EPOS.UI.Seiten.Assistent.AssistentVerlassen.Bleiben) return;

        if (weg == EPOS.UI.Seiten.Assistent.AssistentVerlassen.Gespeichert)
            _statuszeile = MeldungGespeichert;

        _assistentGeklaert = true;
        _assistent = null;

        if (!Zeige(maske, betriebsart) && !Zeige(Startansicht))
            _ansicht = Seitenschluessel.Projektliste;

        // Ein gespeicherter Lauf hat ein Projekt angelegt oder fortgeschrieben.
        Laden();
        StateHasChanged();
    }

    // =====================================================================
    // Die Stromspeicher-Auslegung verlassen (Auftrag #192, Muster 62b-E-1)
    // =====================================================================

    /// <summary>
    /// Der RUECKWEG einer freien Ansicht mit Rückkehr — der Auslegung (#192) und
    /// seit #207 auch der Simulation: dorthin, woher man kam, mit der Marke, mit
    /// der man ging. Lässt sich keine Ansicht des Stapels mehr aufbauen, gilt der
    /// gewöhnliche Rückweg zur Startansicht.
    /// </summary>
    private void ZurueckZumAufrufer()
    {
        // Die Seite hat sich SELBST verabschiedet - hier wird nicht noch einmal gefragt.
        _auslegungGeklaert = true;
        _simulationGeklaert = true;

        _auslegung = null;
        _simulation = null;

        if (Zurueck()) return;

        ZurueckZurListe();
    }

    /// <summary>Fragt die stehende Simulationsansicht und wechselt DANACH — oder gar nicht.</summary>
    private async Task SimulationVerlassenUndZeigen(string maske, int? betriebsart)
    {
        EPOS.UI.Seiten.Simulation.SimulationSeite? seite = _simulationSeite;
        if (seite is null) return;

        EPOS.UI.Seiten.Assistent.AssistentVerlassen weg = await seite.FrageVerlassen();
        if (weg == EPOS.UI.Seiten.Assistent.AssistentVerlassen.Bleiben) return;

        _simulationGeklaert = true;
        _simulation = null;

        if (!Zeige(maske, betriebsart) && !Zeige(Startansicht))
            _ansicht = Seitenschluessel.Projektliste;

        StateHasChanged();
    }

    /// <summary>Fragt die stehende Auslegungsansicht und wechselt DANACH — oder gar nicht.</summary>
    private async Task AuslegungVerlassenUndZeigen(string maske, int? betriebsart)
    {
        EPOS.UI.Seiten.Strom.StromspeicherAuslegungSeite? seite = _auslegungSeite;
        if (seite is null) return;

        EPOS.UI.Seiten.Assistent.AssistentVerlassen weg = await seite.FrageVerlassen();
        if (weg == EPOS.UI.Seiten.Assistent.AssistentVerlassen.Bleiben) return;

        _auslegungGeklaert = true;
        _auslegung = null;

        if (!Zeige(maske, betriebsart) && !Zeige(Startansicht))
            _ansicht = Seitenschluessel.Projektliste;

        StateHasChanged();
    }

    /// <inheritdoc />
    public bool VerlassenFraglich
        => (_ansicht == Seitenschluessel.Assistent
            && !_assistentGeklaert
            && _assistentSeite is not null
            && _assistentSeite.Ungespeichert)
        || (_ansicht == Seitenschluessel.StromspeicherAuslegung
            && !_auslegungGeklaert
            && _auslegungSeite is not null
            && _auslegungSeite.Ungespeichert)
        || (_ansicht == Seitenschluessel.Simulation
            && !_simulationGeklaert
            && _simulationSeite is not null
            && _simulationSeite.Ungespeichert);

    /// <inheritdoc />
    public Task<bool> DarfVerlassen()
    {
        // DREI Ansichten haben etwas zu verlieren - der Assistent (62b-E-1), die
        // Stromspeicher-Auslegung (#192) und die Simulation (#207); jede andere
        // schreibt beim Verlassen nichts.
        if (!VerlassenFraglich) return Task.FromResult(true);

        if (_ansicht == Seitenschluessel.Simulation)
        {
            var simulation = new TaskCompletionSource<bool>();
            _ = InvokeAsync(async () =>
            {
                try
                {
                    EPOS.UI.Seiten.Simulation.SimulationSeite? seite = _simulationSeite;
                    if (seite is null) { simulation.TrySetResult(true); return; }

                    EPOS.UI.Seiten.Assistent.AssistentVerlassen weg = await seite.FrageVerlassen();
                    bool frei = weg != EPOS.UI.Seiten.Assistent.AssistentVerlassen.Bleiben;
                    if (frei) _simulationGeklaert = true;
                    simulation.TrySetResult(frei);
                }
                catch (Exception) { simulation.TrySetResult(true); }
            });
            return simulation.Task;
        }

        if (_ansicht == Seitenschluessel.StromspeicherAuslegung)
        {
            var auslegung = new TaskCompletionSource<bool>();
            _ = InvokeAsync(async () =>
            {
                try
                {
                    EPOS.UI.Seiten.Strom.StromspeicherAuslegungSeite? seite = _auslegungSeite;
                    if (seite is null) { auslegung.TrySetResult(true); return; }

                    EPOS.UI.Seiten.Assistent.AssistentVerlassen weg = await seite.FrageVerlassen();
                    bool frei = weg != EPOS.UI.Seiten.Assistent.AssistentVerlassen.Bleiben;
                    if (frei) _auslegungGeklaert = true;
                    auslegung.TrySetResult(frei);
                }
                catch (Exception) { auslegung.TrySetResult(true); }
            });
            return auslegung.Task;
        }

        if (_assistentSeite is null) return Task.FromResult(true);

        var antwort = new TaskCompletionSource<bool>();

        // Gefragt wird auf dem RENDERFADEN - der Aufrufer ist unter Windows der
        // Oberflaechenfaden im FormClosing, und gezeichnet wird nur hier.
        _ = InvokeAsync(async () =>
        {
            try
            {
                EPOS.UI.Seiten.Assistent.AssistentSeite? seite = _assistentSeite;
                if (seite is null) { antwort.TrySetResult(true); return; }

                EPOS.UI.Seiten.Assistent.AssistentVerlassen weg = await seite.FrageVerlassen();
                bool frei = weg != EPOS.UI.Seiten.Assistent.AssistentVerlassen.Bleiben;
                if (frei) _assistentGeklaert = true;
                antwort.TrySetResult(frei);
            }
            catch (Exception)
            {
                // Eine gescheiterte Rueckfrage darf das Programm nicht festhalten.
                antwort.TrySetResult(true);
            }
        });

        return antwort.Task;
    }

    private void BeiBhkwFertig(EPOS.UI.Dialoge.Wirtschaftlichkeit.BhkwWirtschaftlichkeitErgebnis ergebnis)
    {
        _statuszeile = ergebnis is { Gespeichert: true } ? MeldungGespeichert : "";
        ZurueckZurListe();
