    /// <summary>Warum der Übernahmeknopf gesperrt ist; <c>null</c> = frei. Prüfhilfe für die Tests.</summary>
    public string? UebernahmeSperre
    {
        get
        {
            if (Modus != GebaeudeKatalogModus.Projekt || Zonen?.Uebernehmen is null) return ZonenTexte.SperreKatalog;
            if (_arbeit.Zonen.Count == 1) return string.Format(CultureInfo.CurrentCulture, ZonenTexte.SperreZone, _arbeit.Zonen[0].Bezeichner);
            if (_arbeit.Zonen.Count > 1) return string.Format(CultureInfo.CurrentCulture, ZonenTexte.SperreZonen, _arbeit.Zonen.Count);
            if (!_arbeit.IstVdi6007) return ZonenTexte.SperreTagesbilanz;
            if (_uebernahmeLaeuft) return ZonenTexte.SperreLaeuft;
            return null;
        }
    }

    /// <summary>
    /// Warum „+ Neue Zone …" und „Duplizieren" gesperrt sind; <c>null</c> = frei (G6a). Dieselben Gründe
    /// wie bei der Übernahme — Katalogsatz, Tagesbilanz-Weg —, aber nicht „Zone schon da"; dazu die
    /// Höchstzahl der Regelklasse. Prüfhilfe für die Tests.
    /// </summary>
    public string? NeueZoneSperre
    {
        get
        {
            if (Modus != GebaeudeKatalogModus.Projekt || Zonen is null) return ZonenTexte.SperreKatalog;
            if (!_arbeit.IstVdi6007) return ZonenTexte.SperreTagesbilanz;
            int grenze = GebaeudeZonenregeln.Hoechstzahl();
            return _arbeit.Zonen.Count < grenze ? null
                : string.Format(CultureInfo.CurrentCulture, ZonenTexte.SperreHoechstzahl, grenze);
        }
    }

