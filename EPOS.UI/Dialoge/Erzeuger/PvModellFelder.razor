@* Die PV-MODELLFELDER einer Projektzeile - Paket A und B des PV-Ertragsmodells
   (Konzept_Photovoltaik_Ertragsmodell_EPOS-Plan.md), mit Merge 5 am 05.09.2026 aus
   Form_PV (PvAnlagenfelderAnlegen, Z. 8-128) und Form_PVModell (225 Z.) nachgezogen,
   nachdem beide WinForms-Masken mit iU9-W6.5 gefallen waren.

   VORBILD. Form_PV zeigte im Anlagenpanel drei Zusatzfelder - das Rechenmodell
   (Klappliste Einfach/Erweitert), den Wechselrichter-Wirkungsgrad und die
   Systemverluste - und den Knopf "Wechselrichter...", der Form_PVModell oeffnete:
   AC-Nennleistung, die drei Stuetzstellen der Teillast-Kennlinie und die
   DC/AC-Anzeige. Hier ist der Zweitdialog eine UEBERLAGERUNG (Hausregel R2), kein
   zweites Fenster.

   DIE REGELN DES VORBILDS, woertlich uebernommen:
     * Modell EINFACH sperrt den Knopf und laesst den Wirkungsgrad frei; ERWEITERT
       umgekehrt (ModellUmschalten, Form_PV Z. 118-124). Der feste Wirkungsgrad gilt
       nur im einfachen Modell; im erweiterten rechnet die Kennlinie.
     * Leer heisst NULL - 0,95 beim Wirkungsgrad, 0 % bei den Verlusten (PvWertAusFeld).
     * Im Wechselrichterdialog heisst 0 "nicht bekannt" und wird NULL (Form_PVModell.Wert).
     * Die DC/AC-Anzeige braucht die kWp der Anlage (Modulleistung mal Anzahl) - die
       kennt die Komponente nicht; sie bekommt sie fertig als Parameter.

   KEINE DATENBANK (Hausregel EPOS.UI): Die Werte stehen in der ErzeugerZeile, die
   Huelle schreibt sie in das WErzeugerModel (PhotovoltaikHuelle.Uebernehmen). Jede
   Aenderung meldet Geaendert - derselbe Weg wie Neigung, Azimut und Anzahl. *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Bausteine
@using System.Globalization

<div class="epos-pvmodell">
    <div title="@Texte.TipModell">
        <Auswahlfeld Bezeichnung="@Texte.LabelModell" Eintraege="@_modelle"
                     Auswahl="@(Zeile.ModellErweitert ? 1 : 0)" AuswahlChanged="BeiModell" />
    </div>
    <div title="@Texte.TipWrWirkungsgrad">
        <Zahlenfeld Bezeichnung="@Texte.LabelWrWirkungsgrad" Wert="@Zeile.WrWirkungsgrad"
                    WertChanged="BeiWirkungsgrad" Min="0" Max="1" Nachkommastellen="3"
                    Aktiv="@(!Zeile.ModellErweitert)" Feldname="WrWirkungsgrad" />
    </div>
    <div title="@Texte.TipSystemverluste">
        <Zahlenfeld Bezeichnung="@Texte.LabelSystemverluste" Wert="@Zeile.Systemverluste"
                    WertChanged="BeiSystemverluste" Min="0" Max="100" Nachkommastellen="2"
                    Feldname="Systemverluste" />
    </div>
    <button type="button" class="epos-knopf epos-pvmodell-wechselrichter" title="@Texte.TipWechselrichter"
            disabled="@(!Zeile.ModellErweitert)" @onclick="Oeffnen">@Texte.BtnWechselrichter</button>

    @* --- Ueberlagerung: die Wechselrichterdaten (Form_PVModell) ------------------ *@
    <Ueberlagerung Offen="@_offen" Titel="@Titel" Geschlossen="() => _offen = false">
        <KindInhalt>
            <p class="epos-kontextzeile">@(Zeile.ModellErweitert ? Texte.KopfErweitert : Texte.KopfEinfach)</p>
            <div title="@Texte.TipNennleistung">
                <Zahlenfeld Bezeichnung="@Texte.LabelNennleistung" Wert="@_nenn"
                            WertChanged="@(w => _nenn = w)" Min="0" Max="100000" Nachkommastellen="2"
                            Aktiv="@Zeile.ModellErweitert" Feldname="WrNennleistung" />
            </div>
            <div title="@Texte.TipEta">
                <Zahlenfeld Bezeichnung="@Texte.LabelEta10" Wert="@_eta10"
                            WertChanged="@(w => _eta10 = w)" Min="0" Max="1" Nachkommastellen="3"
                            Aktiv="@Zeile.ModellErweitert" Feldname="WrEta10" />
                <Zahlenfeld Bezeichnung="@Texte.LabelEta50" Wert="@_eta50"
                            WertChanged="@(w => _eta50 = w)" Min="0" Max="1" Nachkommastellen="3"
                            Aktiv="@Zeile.ModellErweitert" Feldname="WrEta50" />
                <Zahlenfeld Bezeichnung="@Texte.LabelEta100" Wert="@_eta100"
                            WertChanged="@(w => _eta100 = w)" Min="0" Max="1" Nachkommastellen="3"
                            Aktiv="@Zeile.ModellErweitert" Feldname="WrEta100" />
            </div>
            <p class="epos-pvmodell-dcac"><b>@DcAcText</b></p>
            <SpeichernLeiste OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen" Ergebnis="BeiErgebnis" />
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    /// <summary>Die Projektzeile, deren Felder hier stehen. Wird IN PLACE geaendert.</summary>
    [Parameter, EditorRequired] public ErzeugerZeile Zeile { get; set; } = new();

    /// <summary>kWp der Anlage (Modulleistung mal Anzahl) fuer die DC/AC-Anzeige; 0 = unbekannt.</summary>
    [Parameter] public double KwpAnlage { get; set; }

    /// <summary>Die Beschriftungen; fuellen sich selbst aus MyResource.</summary>
    [Parameter] public PvModellTexte Texte { get; set; } = new();

    /// <summary>Meldet jede Aenderung an der Zeile - die Huelle schreibt dann in das Modell.</summary>
    [Parameter] public EventCallback Geaendert { get; set; }

    private IReadOnlyList<(int Id, string Text)> _modelle = Array.Empty<(int, string)>();
    private bool _offen;
    private double? _nenn, _eta10, _eta50, _eta100;

    /// <summary>Steht die Wechselrichter-Ueberlagerung? (Pruefhilfe fuer Tests.)</summary>
    public bool WechselrichterOffen => _offen;

    /// <summary>Die DC/AC-Zeile der Ueberlagerung (Pruefhilfe fuer Tests).</summary>
    public string DcAcText
    {
        get
        {
            if (!_nenn.HasValue || _nenn.Value <= 0.0 || KwpAnlage <= 0.0) return Texte.DcAcOhne;
            return string.Format(CultureInfo.CurrentCulture, Texte.DcAc,
                                 KwpAnlage, _nenn.Value, KwpAnlage / _nenn.Value);
        }
    }

    private string Titel => string.Format(CultureInfo.CurrentCulture, Texte.DialogTitel, Zeile.Bezeichner);

    protected override void OnParametersSet()
    {
        _modelle = new[] { (0, Texte.ModellEinfach), (1, Texte.ModellErweitert) };
    }

    private Task BeiModell(int? id)
    {
        Zeile.ModellErweitert = id == 1;
        return Geaendert.InvokeAsync();
    }

    private Task BeiWirkungsgrad(double? wert)
    {
        // Leer = NULL = 0,95 (Bestand). Ein Wert ausserhalb 0..1 ist eine Fehleingabe,
        // die das Feld faerbt (Zahlenfeld); uebernommen wird er nicht.
        Zeile.WrWirkungsgrad = wert.HasValue && wert.Value > 0.0 && wert.Value <= 1.0 ? wert : null;
        return Geaendert.InvokeAsync();
    }

    private Task BeiSystemverluste(double? wert)
    {
        Zeile.Systemverluste = wert.HasValue && wert.Value > 0.0 ? wert : null;
        return Geaendert.InvokeAsync();
    }

    private void Oeffnen()
    {
        _nenn = Zeile.WrNennleistungKw;
        _eta10 = Zeile.WrEta10;
        _eta50 = Zeile.WrEta50;
        _eta100 = Zeile.WrEta100;
        _offen = true;
    }

    /// <summary>OK uebernimmt die vier Werte (0 = nicht bekannt = NULL); Abbrechen verwirft sie.</summary>
    private async Task BeiErgebnis(bool ok)
    {
        _offen = false;
        if (!ok) return;
        Zeile.WrNennleistungKw = Positiv(_nenn);
        Zeile.WrEta10 = Positiv(_eta10);
        Zeile.WrEta50 = Positiv(_eta50);
        Zeile.WrEta100 = Positiv(_eta100);
        await Geaendert.InvokeAsync();
    }

    private static double? Positiv(double? wert) => wert.HasValue && wert.Value > 0.0 ? wert : null;
}
