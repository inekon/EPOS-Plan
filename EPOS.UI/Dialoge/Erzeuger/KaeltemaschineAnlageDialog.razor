                                      string Anzahl, string Traeger, string Zaehler, string Rang, Zeile? Km, WpEintrag? Wp);

    private readonly List<WpEintrag> _wp = new();
    /// <summary>Die Wärmepumpen, deren Kühlbetrieb die Sitzung eingeschaltet hat (Abbrechen schaltet sie wieder aus).</summary>
    private readonly HashSet<int> _wpEingeschaltet = new();
    /// <summary>Die Übernahmen der Sitzung (Abbrechen nimmt sie zurück, jüngste zuerst).</summary>
    private readonly List<object> _wpUebernahmen = new();
