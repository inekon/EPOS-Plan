    public IReadOnlyList<int> WaermepumpenEntfernt => _wp.Where(w => w.Entfernt).Select(w => w.Daten.IdWp).ToList();
    /// <summary>Die Summe der Nennkälteleistung über beide Arten (Kältemaschine × Anzahl, Wärmepumpe × Anlagen).</summary>
    public string Summentext => Zahl(Sichtbare.Sum(z => (z.Arbeit.Geraet?.Nennkaelteleistung ?? 0) * Math.Max(1, z.Arbeit.Anzahl ?? 1))
                                     + SichtbareWp.Sum(w => (w.Daten.KuehlleistungKw ?? 0) * Math.Max(1, w.Daten.Anlagen)), 1);

    // =====================================================================
    // Aufbau
    // =====================================================================

    /// <summary>
    /// Liest Anlagen, Katalog und Wärmepumpen. Wirft eine Gabe, bricht der Aufbau nicht ab (KT-2/KT-3): Die Liste
    /// bleibt leer, der Banner nennt die Meldung.
    /// </summary>
    protected override void OnInitialized()
    {
        var fehler = new List<string>();
        try
        {
            foreach (KaeltemaschineAnlageDaten d in Anlagen?.Invoke() ?? Array.Empty<KaeltemaschineAnlageDaten>())
                _zeilen.Add(new Zeile { Schluessel = NeuerSchluessel(), Original = d.Kopie(), Gelesen = d, Arbeit = d.Kopie() });
        }
        catch (Exception ex)
        {
            _zeilen.Clear();
            fehler.Add(string.Format(CultureInfo.CurrentCulture, Texte.LadenFehler, ex.Message));
        }
        try
        {
            WpNeuLesen();
            _raengeBeimOeffnen = KaelteRaenge?.Invoke() ?? new Dictionary<int, int>();
            _raenge = _raengeBeimOeffnen;
        }
        catch (Exception ex)
        {
            _wp.Clear();
            fehler.Add(string.Format(CultureInfo.CurrentCulture, Texte.WaermepumpenLadenFehler, ex.Message));
        }
        _meldung = string.Join(" ", fehler);
        _filterstand = Profil.Schluessel.StartsWith("ANLAGE_", StringComparison.Ordinal)
            ? Katalogfilterregister.Stand(Profil.Art) : Katalogfilterregister.Stand(Profil.Schluessel);
        KatalogNeuLaden();
        if (_zeilen.FirstOrDefault() is Zeile erste) ProjektZeileWaehlen(erste);
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.KAELTEMASCHINE_ANLAGE, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    private string NeuerSchluessel() => (_naechsterSchluessel++).ToString(CultureInfo.InvariantCulture);

    // =====================================================================
    // Listen und Wahl
    // =====================================================================

    private void KatalogNeuLaden()
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, Texte.Titel, out _listeFehler);
        VerwendungStempeln();
        _katalogZeile = _katalog.FirstOrDefault(z => z.Schluessel == _katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
        _bilder.Clear();
    }

    /// <summary>Die Verwendungsmarke „im Projekt": über den Gerätenamen der Projektkopie.</summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Sichtbare.Select(z => z.Arbeit.Geraet?.Bezeichner ?? z.Arbeit.Bezeichner)
                                                .Concat(SichtbareWp.Select(w => w.Daten.Bezeichner)));

    /// <summary>
    /// KM-K1: liest die Projektwärmepumpen im Kühlbetrieb neu; vorgemerkte Ausschaltungen bleiben stehen, eine wieder
    /// übernommene Wärmepumpe verliert ihre Vormerkung.
    /// </summary>
    private void WpNeuLesen(int? wiederAn = null)
    {
        var entfernt = new HashSet<int>(_wp.Where(w => w.Entfernt).Select(w => w.Daten.IdWp));
        if (wiederAn is int id) entfernt.Remove(id);
        _wp.Clear();
        foreach (KuehlWaermepumpeZeile d in KuehlWaermepumpen?.Invoke() ?? Array.Empty<KuehlWaermepumpeZeile>())
            _wp.Add(new WpEintrag { Schluessel = WpSchluessel(d.IdWp), Daten = d, Entfernt = entfernt.Contains(d.IdWp) });
    }

    private static string RangText(int? rang) => rang is int r ? r.ToString(CultureInfo.CurrentCulture) : "";

    private string RangKm(Zeile z) => z.Arbeit.AnlagenId > 0 && _raenge.TryGetValue(z.Arbeit.AnlagenId, out int r)
        ? r.ToString(CultureInfo.CurrentCulture) : "";

    /// <summary>Die gemeinsame Projektliste: erst die Kältemaschinen, dann die Wärmepumpen (KA-E-26).</summary>
    private List<Listenzeile> Projektzeilen()
    {
        var liste = Sichtbare.Select(z => new Listenzeile(z.Schluessel, Resource.KMA_ART_KAELTEMASCHINE, z.Arbeit.Bezeichner,
            Zahl(z.Arbeit.Geraet?.Nennkaelteleistung, 1), EerText(z.Arbeit.Geraet), z.Arbeit.Geraet?.Rueckkuehlart ?? "",
            AnzahlText(z.Arbeit), TraegerText(z.Arbeit), z.Arbeit.KuehlEigenerZaehler ? Texte.Ja : Texte.Nein, RangKm(z), z, null)).ToList();
        liste.AddRange(SichtbareWp.Select(w => new Listenzeile(w.Schluessel, Resource.KMA_ART_WAERMEPUMPE, w.Daten.Bezeichner,
            Zahl(w.Daten.KuehlleistungKw, 1), Zahl(w.Daten.Eer, 2), "", w.Daten.Anlagen.ToString(CultureInfo.CurrentCulture),
            w.Daten.Kuehltraeger, w.Daten.EigenerZaehler ? Texte.Ja : Texte.Nein, RangText(w.Daten.Rang), null, w)));
        return liste;
    }

    private IReadOnlyList<string> ProjektSchluessel() => Projektzeilen().Select(z => z.Schluessel).ToList();


    private IReadOnlyList<string> KatalogSichtbar()
        => (_katalogliste?.Angezeigt ?? _katalog).Select(z => z.Schluessel).ToList();

    /// <summary>Die Ziele einer Projektaktion: die angekreuzten Zeilen, sonst die gewählte.</summary>
    private List<Zeile> ProjektZiele()
    {
        if (_projektWahl.Anzahl > 0)
            return _projektWahl.Gewaehlte.Select(s => Sichtbare.FirstOrDefault(z => z.Schluessel == s)).OfType<Zeile>().ToList();
        return Aktuell is Zeile a ? new() { a } : new();
    }

    /// <summary>Die Ziele einer Katalogaktion: die angekreuzten Sätze, sonst der gewählte.</summary>
    private List<WpEintrag> WpZiele()
    {
        if (_projektWahl.Anzahl > 0)
            return _projektWahl.Gewaehlte.Select(s => SichtbareWp.FirstOrDefault(w => w.Schluessel == s)).OfType<WpEintrag>().ToList();
        return AktuellWp is WpEintrag w ? new() { w } : new();
    }

    private List<Katalogfilterzeile> KatalogZiele()
    {
        if (_katalogWahl.Anzahl > 0)
            return _katalogWahl.Gewaehlte.Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s)).OfType<Katalogfilterzeile>().ToList();
        return _katalogZeile is null ? new() : new() { _katalogZeile };
    }

    /// <summary>
    /// Klick in eine Projektzeile (AW3b, wie Heizkessel): Die Zeile wird der gewählte Satz, die Detailzeile folgt;
    /// die Kästchen der Mehrfachwahl bleiben unberührt — wie in der Katalogliste.
    /// </summary>
    private void ProjektZeileKlick(Zeile zeile)
    {
        if (zeile.Schluessel != _gewaehlt) ProjektZeileWaehlen(zeile);
    }

    /// <summary>Die Hervorhebung der gewählten Projektzeile — dieselbe Klasse wie in der Katalogliste.</summary>
    private void ProjektZeileKlick(string schluessel)
    {
        if (schluessel != _gewaehlt) Waehlen(schluessel);
    }

