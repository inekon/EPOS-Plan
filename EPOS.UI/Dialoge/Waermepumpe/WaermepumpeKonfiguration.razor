    /// <summary>
    /// Die Lesewerte der Gruppe als Zeilen (Mockup): höchster Vorlauf mit Verweis auf „Betriebszeiten", Spreizungen,
    /// Mindestvolumenstrom, höchster Rücklauf je mit Herkunft und Herleitung, die R744-Zeile und der Pflegehinweis.
    /// </summary>
    public static IReadOnlyList<string> Lesewertzeilen(WaermepumpeAnlageDaten daten, WaermepumpeBivalenzWerte? werte,
                                                       WaermepumpeKonfigurationTexte texte)
    {
        var k = System.Globalization.CultureInfo.CurrentCulture;
        var zeilen = new List<string>();
        double vorlauf = daten.VorlaufMax is double v ? v : daten.Vorlauf is int p && p > 0 ? p : double.NaN;
        zeilen.Add(texte.LabelHoechstvorlaufLesen + ": " + (double.IsNaN(vorlauf) ? "—" : vorlauf.ToString("0.#", k) + " °C")
                   + " · " + texte.GruppeBetriebszeiten);
        if (werte?.Grenzen is not WaermepumpeGrenzwerte g) return zeilen;
        zeilen.Add(texte.LabelSpreizungAuslegung + " / " + texte.LabelSpreizungMax + " / " + texte.LabelSpreizungMin + ": "
                   + WaermepumpeBivalenzText.Spreizungen(g) + " K · " + WaermepumpeBivalenzText.Herkunft(g.SpreizungHerkunft, texte));
        zeilen.Add(texte.LabelMindestvolumenstrom + ": " + (g.MindestvolumenstromAnteil * 100.0).ToString("0", k) + " % · "
                   + WaermepumpeBivalenzText.Herkunft(g.MindestvolumenstromHerkunft, texte));
        zeilen.Add(texte.LabelRuecklaufMax + ": " + (double.IsNaN(g.RuecklaufMaxC) ? "—" : g.RuecklaufMaxC.ToString("0.#", k) + " °C")
                   + " · " + WaermepumpeBivalenzText.Herkunft(g.RuecklaufHerkunft, texte));
        if (WaermepumpeBivalenzText.RuecklaufZeile(g, texte) is { Length: > 0 } herleitung
            && g.RuecklaufHerkunft == GrenzwertHerkunft.Abgeleitet)
            zeilen.Add(herleitung);
        zeilen.Add(texte.LabelRuecklaufR744 + ": " + WaermepumpeBivalenzText.R744Werte(g) + " °C · %/K · °C"
                   + (g.RuecklaufGrenzeR744C is null ? " · " + texte.HerkunftNurR744 : " · " + WaermepumpeBivalenzText.Herkunft(g.RuecklaufHerkunft, texte)));
        if (g.RuecklaufGrenzeR744C is not null && WaermepumpeBivalenzText.RuecklaufZeile(g, texte) is { Length: > 0 } r744)
            zeilen.Add(r744);
        zeilen.Add(texte.HinweisGeraetegrenzen);
        return zeilen;
    }

