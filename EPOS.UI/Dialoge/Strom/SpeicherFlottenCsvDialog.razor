@namespace EPOS.UI.Dialoge.Strom
@using SpeicherEngine
@using WindowsFormsApplication1

<div class="epos-dialog" role="dialog" aria-modal="true">
    <div class="epos-dialog-kopf"><h1 class="epos-dialog-titel">@Titel</h1></div>
    <Herleitungszeile Text="@Datei.Dateiname" />
    <p class="epos-herleitung">@Texte.Hinweis</p>

    <Formularraster>
        <KindInhalt>
            <Formulargruppe Titel="@Texte.CsvFormat">
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@Texte.Trennzeichen" Eintraege="@Trennzeichen"
                                   Auswahl="@TrennzeichenIndex" AuswahlChanged="TrennzeichenSetzen" />
                    <Auswahlfeld Bezeichnung="@Texte.Dezimaltrenner" Eintraege="@Dezimaltrenner"
                                   Auswahl="@DezimalIndex" AuswahlChanged="DezimalSetzen" />
                    <Auswahlfeld Bezeichnung="@Texte.Kodierung" Eintraege="@Kodierungen"
                                   Auswahl="@((int)_optionen.Zeitbasis.Encoding)" AuswahlChanged="KodierungSetzen" />
                    <Schalter Bezeichnung="@Texte.Kopfzeile" Wert="@_optionen.Zeitbasis.Kopfzeile"
                              WertChanged="KopfzeileSetzen" />
                    <Ganzzahlfeld Bezeichnung="@Texte.Ueberspringen" Wert="@_optionen.Zeitbasis.ZuUeberspringendeZeilen"
                                  Min="0" WertChanged="UeberspringenSetzen" />
                </KindInhalt>
            </Formulargruppe>

            <Formulargruppe Titel="@Texte.Zeit">
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@Texte.Zeitangabe" Eintraege="@Zeitarten"
                                   Auswahl="@(_getrennteZeit ? 1 : 0)" AuswahlChanged="ZeitartSetzen" />
                    @if (!_getrennteZeit)
                    {
                        <Auswahlfeld Bezeichnung="@Texte.Zeitstempelspalte" Eintraege="@Pflichtspalten"
                                       Auswahl="@_optionen.Zeitbasis.ZeitstempelSpalte" AuswahlChanged="ZeitstempelSpalteSetzen" />
                        <Textfeld Bezeichnung="@Texte.Zeitstempelformat" Wert="@_optionen.Zeitbasis.ZeitstempelFormat"
                                  WertChanged="ZeitstempelFormatSetzen" />
                    }
                    else
                    {
                        <Auswahlfeld Bezeichnung="@Texte.Datumsspalte" Eintraege="@Pflichtspalten"
                                       Auswahl="@_optionen.Zeitbasis.DatumSpalte" AuswahlChanged="DatumSpalteSetzen" />
                        <Auswahlfeld Bezeichnung="@Texte.Uhrzeitspalte" Eintraege="@Pflichtspalten"
                                       Auswahl="@_optionen.Zeitbasis.UhrzeitSpalte" AuswahlChanged="UhrzeitSpalteSetzen" />
                        <Textfeld Bezeichnung="@Texte.Datumsformat" Wert="@_optionen.Zeitbasis.DatumFormat"
                                  WertChanged="DatumFormatSetzen" />
                        <Textfeld Bezeichnung="@Texte.Uhrzeitformat" Wert="@_optionen.Zeitbasis.UhrzeitFormat"
                                  WertChanged="UhrzeitFormatSetzen" />
                    }
                    <Textfeld Bezeichnung="@Texte.Zeitzone" Wert="@_optionen.Zeitbasis.ZeitzoneId" WertChanged="ZeitzoneSetzen" />
                    <Auswahlfeld Bezeichnung="@Texte.Intervalllage" Eintraege="@Konventionen"
                                   Auswahl="@((int)_optionen.Zeitbasis.Konvention)" AuswahlChanged="KonventionSetzen" />
                </KindInhalt>
            </Formulargruppe>

            <Formulargruppe Titel="@Texte.Wertspalten">
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@Texte.Last" Eintraege="@Pflichtspalten" Auswahl="@_optionen.LastSpalte"
                                   AuswahlChanged="@(v => SpalteSetzen(x => _optionen.LastSpalte = x, v))" />
                    <Auswahlfeld Bezeichnung="@Texte.Pv" Eintraege="@OptionaleSpalten" Auswahl="@_optionen.PvSpalte"
                                   AuswahlChanged="@(v => SpalteSetzen(x => _optionen.PvSpalte = x, v))" />
                    <Auswahlfeld Bezeichnung="@Texte.Bhkw" Eintraege="@OptionaleSpalten" Auswahl="@_optionen.BhkwSpalte"
                                   AuswahlChanged="@(v => SpalteSetzen(x => _optionen.BhkwSpalte = x, v))" />
                    <Auswahlfeld Bezeichnung="@Texte.Bezug" Eintraege="@Pflichtspalten" Auswahl="@_optionen.BezugSpalte"
                                   AuswahlChanged="@(v => SpalteSetzen(x => _optionen.BezugSpalte = x, v))" />
                    <Auswahlfeld Bezeichnung="@Texte.PvPreis" Eintraege="@OptionaleSpalten" Auswahl="@_optionen.PvPreisSpalte"
                                   AuswahlChanged="@(v => SpalteSetzen(x => _optionen.PvPreisSpalte = x, v))" />
                    <Auswahlfeld Bezeichnung="@Texte.BhkwPreis" Eintraege="@OptionaleSpalten" Auswahl="@_optionen.BhkwPreisSpalte"
                                   AuswahlChanged="@(v => SpalteSetzen(x => _optionen.BhkwPreisSpalte = x, v))" />
                    <Auswahlfeld Bezeichnung="@Texte.BatteriePreis" Eintraege="@OptionaleSpalten" Auswahl="@_optionen.BatteriePreisSpalte"
                                   AuswahlChanged="@(v => SpalteSetzen(x => _optionen.BatteriePreisSpalte = x, v))" />
                    <Auswahlfeld Bezeichnung="@Texte.LeistungEinheit" Eintraege="@LeistungEinheiten"
                                   Auswahl="@((int)_optionen.LeistungEinheit)" AuswahlChanged="LeistungEinheitSetzen" />
                    <Auswahlfeld Bezeichnung="@Texte.PreisEinheit" Eintraege="@PreisEinheiten"
                                   Auswahl="@((int)_optionen.PreisEinheit)" AuswahlChanged="PreisEinheitSetzen" />
                </KindInhalt>
            </Formulargruppe>

            @if (Prognosen)
            {
                <Formulargruppe Titel="@Texte.Prognosezuordnung">
                    <KindInhalt>
                        <Auswahlfeld Bezeichnung="@Texte.SnapshotId" Eintraege="@Pflichtspalten" Auswahl="@_optionen.SnapshotIdSpalte"
                                       AuswahlChanged="@(v => SpalteSetzen(x => _optionen.SnapshotIdSpalte = x, v))" />
                        <Auswahlfeld Bezeichnung="@Texte.BekanntSeit" Eintraege="@Pflichtspalten" Auswahl="@_optionen.BekanntSeitSpalte"
                                       AuswahlChanged="@(v => SpalteSetzen(x => _optionen.BekanntSeitSpalte = x, v))" />
                        <Auswahlfeld Bezeichnung="@Texte.Entscheidung" Eintraege="@Pflichtspalten" Auswahl="@_optionen.EntscheidungSpalte"
                                       AuswahlChanged="@(v => SpalteSetzen(x => _optionen.EntscheidungSpalte = x, v))" />
                    </KindInhalt>
                </Formulargruppe>
            }
        </KindInhalt>
    </Formularraster>

    @if (!string.IsNullOrEmpty(_fehler))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" />
    }
    @if (_vorschau is not null)
    {
        <section aria-label="@Texte.Vorschau">
            <Gruppenkopf Titel="@Texte.Vorschau" />
            <div class="epos-raster-huelle">
                <table class="epos-tabelle">
                    <thead><tr>@for (int i = 0; i < _vorschau.Spaltenzahl; i++) { <th>Spalte @(i + 1)</th> }</tr></thead>
                    <tbody>@foreach (string[] zeile in _vorschau.Zeilen) { <tr>@foreach (string feld in zeile) { <td>@feld</td> }</tr> }</tbody>
                </table>
            </div>
        </section>
    }

    <div class="epos-leiste">
        <button type="button" class="epos-knopf" @onclick="Geschlossen">@Texte.Abbrechen</button>
        <button type="button" class="epos-knopf epos-knopf--primaer" disabled="@(_vorschau is null)" @onclick="Uebernehmen">@Texte.Uebernehmen</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SpeicherImportDatei Datei { get; set; } = new();
    [Parameter] public bool Prognosen { get; set; }
    [Parameter] public SpeicherFlottenCsvOptionen? Optionen { get; set; }
    [Parameter] public Func<List<FlottenProjektjahr>, SpeicherFlottenCsvOptionen, Task>? JahresdatenUebernommen { get; set; }
    [Parameter] public Func<List<FlottenPrognoseSnapshot>, SpeicherFlottenCsvOptionen, Task>? PrognosenUebernommen { get; set; }
    [Parameter] public EventCallback Geschlossen { get; set; }
    [Parameter] public SpeicherFlottenCsvTexte Texte { get; set; } = new();

    private SpeicherFlottenCsvOptionen _optionen = new();
    private SpeicherZeitreihenVorschau? _vorschau;
    private string _fehler = "";
    private bool _getrennteZeit;
    private bool _initialisiert;

    private string Titel => Prognosen ? Texte.PrognosenTitel : Texte.JahresdatenTitel;
    // KEIN static readonly: Die Texte kommen aus den Ressourcen, und die Sprache
    // wechselt zur Laufzeit (#184). Reine Einheitenzeichen (kW, MW, €/kWh) bleiben
    // Literale - sie werden nicht uebersetzt.
    private static IReadOnlyList<(int Id, string Text)> Trennzeichen => new[]
        { (0, Resource.FLOTTE_CSV_SEP_SEMIKOLON), (1, Resource.FLOTTE_CSV_SEP_KOMMA), (2, Resource.FLOTTE_CSV_SEP_TABULATOR) };
    private static IReadOnlyList<(int Id, string Text)> Dezimaltrenner => new[]
        { (0, Resource.FLOTTE_CSV_DEZ_KOMMA), (1, Resource.FLOTTE_CSV_DEZ_PUNKT) };
    private static readonly IReadOnlyList<(int Id, string Text)> Kodierungen = new[] { (0, "UTF-8"), (1, "Windows-1252") };
    private static IReadOnlyList<(int Id, string Text)> Zeitarten => new[]
        { (0, Resource.FLOTTE_CSV_ZEIT_EINE_SPALTE), (1, Resource.FLOTTE_CSV_ZEIT_GETRENNT) };
    private static IReadOnlyList<(int Id, string Text)> Konventionen => new[]
        { (0, Resource.FLOTTE_CSV_KONV_ANFANG), (1, Resource.FLOTTE_CSV_KONV_ENDE) };
    private static IReadOnlyList<(int Id, string Text)> LeistungEinheiten => new[]
        { (0, "kW"), (1, "MW"), (2, Resource.FLOTTE_CSV_LEISTUNG_KWH) };
    private static readonly IReadOnlyList<(int Id, string Text)> PreisEinheiten = new[] { (3, "€/kWh"), (4, "ct/kWh"), (5, "€/MWh") };
    private IReadOnlyList<(int Id, string Text)> Pflichtspalten => Enumerable.Range(0, Math.Max(1, _vorschau?.Spaltenzahl ?? 2))
        .Select(i => (i, string.Format(System.Globalization.CultureInfo.CurrentCulture, Resource.FLOTTE_CSV_SPALTE, i + 1))).ToArray();
    private IReadOnlyList<(int Id, string Text)> OptionaleSpalten => new[] { (-1, Texte.NichtVorhanden) }.Concat(Pflichtspalten).ToArray();
    private int TrennzeichenIndex => _optionen.Zeitbasis.Trennzeichen switch { ',' => 1, '\t' => 2, _ => 0 };
    private int DezimalIndex => _optionen.Zeitbasis.Dezimaltrenner == '.' ? 1 : 0;

    protected override void OnParametersSet()
    {
        if (_initialisiert) return;
        _initialisiert = true;
        try
        {
            _optionen = Optionen is null
                ? SpeicherFlottenCsvImport.Vorbelegung(Datei.Inhalt, Prognosen)
                : SpeicherAuslegungKopie.Von(Optionen);
            _getrennteZeit = _optionen.Zeitbasis.ZeitstempelSpalte < 0;
            VorschauLesen();
        }
        catch (Exception ex)
        {
            _fehler = ex.Message;
            _vorschau = null;
        }
    }

    private void VorschauLesen()
    {
        try { _vorschau = SpeicherZeitreihenImport.Vorschau(Datei.Inhalt, _optionen.Zeitbasis); _fehler = ""; }
        catch (Exception ex) { _vorschau = null; _fehler = ex.Message; }
    }

    private void FormatGeaendert() => VorschauLesen();
    private void TrennzeichenSetzen(int? v) { _optionen.Zeitbasis.Trennzeichen = v switch { 1 => ',', 2 => '\t', _ => ';' }; FormatGeaendert(); }
    private void DezimalSetzen(int? v) { _optionen.Zeitbasis.Dezimaltrenner = v == 1 ? '.' : ','; FormatGeaendert(); }
    private void KodierungSetzen(int? v) { _optionen.Zeitbasis.Encoding = (SpeicherZeitreihenEncoding)(v ?? 0); FormatGeaendert(); }
    private void KopfzeileSetzen(bool v) { _optionen.Zeitbasis.Kopfzeile = v; FormatGeaendert(); }
    private void UeberspringenSetzen(int? v) { if (v.HasValue) _optionen.Zeitbasis.ZuUeberspringendeZeilen = v.Value; FormatGeaendert(); }
    private void ZeitartSetzen(int? v) { _getrennteZeit = v == 1; if (_getrennteZeit) { _optionen.Zeitbasis.ZeitstempelSpalte = -1; _optionen.Zeitbasis.DatumSpalte = 0; _optionen.Zeitbasis.UhrzeitSpalte = 1; } else { _optionen.Zeitbasis.ZeitstempelSpalte = 0; _optionen.Zeitbasis.DatumSpalte = -1; _optionen.Zeitbasis.UhrzeitSpalte = -1; } EingabeGeaendert(); }
    private void ZeitstempelSpalteSetzen(int? v) { _optionen.Zeitbasis.ZeitstempelSpalte = v ?? 0; EingabeGeaendert(); }
    private void DatumSpalteSetzen(int? v) { _optionen.Zeitbasis.DatumSpalte = v ?? 0; EingabeGeaendert(); }
    private void UhrzeitSpalteSetzen(int? v) { _optionen.Zeitbasis.UhrzeitSpalte = v ?? 1; EingabeGeaendert(); }
    private void ZeitstempelFormatSetzen(string v) { _optionen.Zeitbasis.ZeitstempelFormat = v; EingabeGeaendert(); }
    private void DatumFormatSetzen(string v) { _optionen.Zeitbasis.DatumFormat = v; EingabeGeaendert(); }
    private void UhrzeitFormatSetzen(string v) { _optionen.Zeitbasis.UhrzeitFormat = v; EingabeGeaendert(); }
    private void ZeitzoneSetzen(string v) { _optionen.Zeitbasis.ZeitzoneId = v; EingabeGeaendert(); }
    private void KonventionSetzen(int? v) { _optionen.Zeitbasis.Konvention = v == 1 ? IntervallKonvention.Ende : IntervallKonvention.Anfang; EingabeGeaendert(); }
    private void LeistungEinheitSetzen(int? v) { _optionen.LeistungEinheit = (SpeicherZeitreihenEinheit)(v ?? 0); EingabeGeaendert(); }
    private void PreisEinheitSetzen(int? v) { _optionen.PreisEinheit = (SpeicherZeitreihenEinheit)(v ?? 3); EingabeGeaendert(); }
    private void SpalteSetzen(Action<int> setzen, int? v) { setzen(v ?? -1); EingabeGeaendert(); }
    private void EingabeGeaendert() => _fehler = "";

    private async Task Uebernehmen()
    {
        try
        {
            if (Prognosen)
            {
                if (PrognosenUebernommen is null) throw new InvalidOperationException("Die Übernahme der Prognosen ist nicht verfügbar.");
                await PrognosenUebernommen(SpeicherFlottenCsvImport.PrognosenLesen(Datei, _optionen), SpeicherAuslegungKopie.Von(_optionen));
            }
            else
            {
                if (JahresdatenUebernommen is null) throw new InvalidOperationException("Die Übernahme der Projektjahre ist nicht verfügbar.");
                await JahresdatenUebernommen(SpeicherFlottenCsvImport.JahresdatenLesen(Datei, _optionen), SpeicherAuslegungKopie.Von(_optionen));
            }
            _fehler = "";
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }

    public sealed class SpeicherFlottenCsvTexte
    {
        public string PrognosenTitel { get; set; } = Resource.FLOTTE_CSV_TITEL_PROGNOSEN;
        public string JahresdatenTitel { get; set; } = Resource.FLOTTE_CSV_TITEL_JAHRE;
        public string Hinweis { get; set; } = Resource.FLOTTE_CSV_HINWEIS;
        public string CsvFormat { get; set; } = Resource.FLOTTE_CSV_FORMAT;
        public string Trennzeichen { get; set; } = Resource.FLOTTE_CSV_TRENNZEICHEN;
        public string Dezimaltrenner { get; set; } = Resource.FLOTTE_CSV_DEZIMALTRENNER;
        public string Kodierung { get; set; } = Resource.FLOTTE_CSV_KODIERUNG;
        public string Kopfzeile { get; set; } = Resource.FLOTTE_CSV_KOPFZEILE;
        public string Ueberspringen { get; set; } = Resource.FLOTTE_CSV_UEBERSPRINGEN;
        public string Zeit { get; set; } = Resource.FLOTTE_CSV_ZEIT;
        public string Zeitangabe { get; set; } = Resource.FLOTTE_CSV_ZEITANGABE;
        public string Zeitstempelspalte { get; set; } = Resource.FLOTTE_CSV_ZEITSTEMPELSPALTE;
        public string Datumsspalte { get; set; } = Resource.FLOTTE_CSV_DATUMSSPALTE;
        public string Uhrzeitspalte { get; set; } = Resource.FLOTTE_CSV_UHRZEITSPALTE;
        public string Zeitstempelformat { get; set; } = Resource.FLOTTE_CSV_ZEITSTEMPELFORMAT;
        public string Datumsformat { get; set; } = Resource.FLOTTE_CSV_DATUMSFORMAT;
        public string Uhrzeitformat { get; set; } = Resource.FLOTTE_CSV_UHRZEITFORMAT;
        public string Zeitzone { get; set; } = Resource.FLOTTE_CSV_ZEITZONE;
        public string Intervalllage { get; set; } = Resource.FLOTTE_CSV_INTERVALLLAGE;
        public string Wertspalten { get; set; } = Resource.FLOTTE_CSV_WERTSPALTEN;
        public string Last { get; set; } = Resource.FLOTTE_CSV_LAST;
        public string Pv { get; set; } = Resource.FLOTTE_CSV_PV;
        public string Bhkw { get; set; } = Resource.FLOTTE_CSV_BHKW;
        public string Bezug { get; set; } = Resource.FLOTTE_CSV_BEZUG;
        public string PvPreis { get; set; } = Resource.FLOTTE_CSV_PVPREIS;
        public string BhkwPreis { get; set; } = Resource.FLOTTE_CSV_BHKWPREIS;
        public string BatteriePreis { get; set; } = Resource.FLOTTE_CSV_BATTERIEPREIS;
        public string LeistungEinheit { get; set; } = Resource.FLOTTE_CSV_LEISTUNGSEINHEIT;
        public string PreisEinheit { get; set; } = Resource.FLOTTE_CSV_PREISEINHEIT;
        public string Prognosezuordnung { get; set; } = Resource.FLOTTE_CSV_PROGNOSEZUORDNUNG;
        public string SnapshotId { get; set; } = Resource.FLOTTE_CSV_SNAPSHOT_ID;
        public string BekanntSeit { get; set; } = Resource.FLOTTE_CSV_BEKANNT_SEIT;
        public string Entscheidung { get; set; } = Resource.FLOTTE_CSV_ENTSCHEIDUNG;
        public string NichtVorhanden { get; set; } = Resource.FLOTTE_CSV_NICHT_VORHANDEN;
        public string Vorschau { get; set; } = Resource.FLOTTE_CSV_VORSCHAU;
        public string Abbrechen { get; set; } = Resource.FLOTTE_CSV_ABBRECHEN;
        public string Uebernehmen { get; set; } = Resource.FLOTTE_CSV_UEBERNEHMEN;
    }
}
