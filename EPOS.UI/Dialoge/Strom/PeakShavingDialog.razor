    private Katalogfilterzeile? Fokuszeile => _zeilen.FirstOrDefault(z => z.Schluessel == _gewaehlt);

    private string Fokusname => Fokuszeile?.Bezeichner ?? "";

    private EventCallback BlattOeffnenWeg => _blattOffen ? default : _blattOeffnen;

    /// <summary>Eine Zeile wählen: den Lastgang laden und ein Ergebnis verwerfen. Während eines Laufs hält die Wahl.</summary>
    private async Task BeiZeile(string schluessel)
    {
        if (_laeuft || schluessel == _gewaehlt) return;
        if (_zeilen.All(z => z.Schluessel != schluessel)) return;
        _gewaehlt = schluessel;
        _meldung = "";
        await LastgangLaden();
    }

    /// <summary>
    /// Lädt die Reihe der gewählten Zeile und verwirft ein vorhandenes Ergebnis — wörtlich
    /// <c>QuelleGeaendert</c> (:268-295).
    /// </summary>
    private async Task LastgangLaden()
    {
        ErgebnisLeeren();

        if (_gewaehlt.StartsWith(DATEI, StringComparison.Ordinal))
        {
            _lastgang = _dateiwerte.TryGetValue(_gewaehlt, out double[]? w) ? w : null;
            ReiheAnzeigen(Fokusname);
            return;
        }

        int? platz = GanglinienPlatz;
        if (platz is null || Werte is null) { _lastgang = null; ReiheAnzeigen(""); return; }

        _lastgang = await Werte(platz.Value);
        ReiheAnzeigen(Fokusname);
    }

    private void ReiheAnzeigen(string bezeichner)
    {
        if (_lastgang is null || _lastgang.Length == 0)
        {
            _reiheText = TextKeineReihe;
            return;
        }

        var kultur = CultureInfo.CurrentCulture;
        _reiheText = string.Format(kultur, VorlageReihe, bezeichner ?? "",
                                   _lastgang.Length.ToString("N0", kultur),
                                   Maximum(_lastgang).ToString("0.#", kultur));
    }

    private static double Maximum(double[] reihe)
    {
        double max = double.NegativeInfinity;
        for (int i = 0; i < reihe.Length; i++) if (reihe[i] > max) max = reihe[i];
        return max;
    }

