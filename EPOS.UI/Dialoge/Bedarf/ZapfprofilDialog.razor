        _eingabe.SchwelleKw = wert;
        Geaendert();
    }

    /// <summary>Die Optionsgruppe „Rechenweg der Jahresreihe": deterministisch oder stochastisch (die Vorschau bleibt deterministisch).</summary>
    private void RechenwegSetzen(int? id)
    {
        bool stochastisch = id == RECHENWEG_STOCHASTISCH;
        if (_eingabe.JahresreiheStochastisch == stochastisch) return;
        _eingabe.JahresreiheStochastisch = stochastisch;
        // Nur das Feld, das verschwindet, nimmt seine Fehleingabe mit — der Seed bleibt stehen.
        if (!stochastisch) _fehlfelder.Remove(Texte.LabelRealisierungen);
        Geaendert();
    }

