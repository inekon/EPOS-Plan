<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    RAZOR-SDK statt Microsoft.NET.Sdk (Umsetzungskonzept iOS, Paket iU8,
    Strang B). Das ist KEINE Web-Anwendung: Die Anwendung bleibt WinExe und
    WinForms. Der Razor-SDK wird gebraucht, damit die statischen Web-Anteile
    der Bibliothek EPOS.UI ueberhaupt hier ankommen - Komponenten-CSS,
    help_icon.png, epos-ui.css und blazor.webview.js.

    Belegt in der Vermessung zu iU8 (Gegenprobe b2): Mit dem einfachen
    Microsoft.NET.Sdk uebersetzt alles fehlerfrei, aber der Veroeffentlichungs-
    ordner enthaelt KEIN wwwroot - weder index.html noch _content noch
    _framework/blazor.webview.js. Der erste Blazor-Dialog bliebe damit auf dem
    Anwenderrechner leer. Der Razor-SDK bringt das StaticWebAssets-Ziel mit,
    das die Anteile einsammelt.

    Die Umstellung kostet keine Warnung: Der Bauvergleich vor/nach zeigt
    dieselben Warnungscodes (WFO1000, CS0108, CS0109, WFO0003, CA2255).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>

    <RootNamespace>WindowsFormsApplication1</RootNamespace>
    <!-- Umbenennung Stufe 0 (Anwenderauftrag 29.08.2026): Die Anwendung heisst
         nach aussen EPOS_Plan - EXE, DLL und Prozessname. Der RootNamespace
         bleibt BEWUSST WindowsFormsApplication1: Ihn umzustellen hiesse ~370
         Dateien (93 davon CP1252), XAML-Klassenpfade, Ressourcen-Manifestnamen
         und den Settings-Sektionsnamen anzufassen - das ist Stufe 1 und braucht
         ein eigenes Konzept. Die user.config-Ablage wandert mit dem Namen; im
         Bestand war nie eine gespeichert (LocalAppData am 29.08.2026 geprueft),
         eine Uebernahme entfaellt deshalb. Referenzlauf-Werkzeug haengt per
         ProjectReference und zieht automatisch mit. -->
    <AssemblyName>EPOS_Plan</AssemblyName>

    <!-- DPI-Awareness wird ausschließlich über app.manifest gesetzt
         (dpiAwareness=PerMonitorV2). Nicht zusätzlich ApplicationHighDpiMode,
         sonst gibt es WFAC010. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- AssemblyInfo.cs liefert die Attribute selbst -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- x64 - Microsoft.ACE.OLEDB.12.0 muss als 64-Bit-Engine vorliegen (Konzept_Umstellung_64Bit_EPOS-Plan.md, P2) -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <Nullable>disable</Nullable>

    <!-- Tolerant gegenüber Legacy-Warnungen:
         CA1416  - WinForms-APIs nur unter Windows (wir TARGETEN net10.0-windows, also irrelevant)
         MSB3568 - doppelte Ressourcennamen aus historischem WinForms-Designer (ignoriert, harmlos)
         CS1701/1702/NU1701 - Mixed-Framework-Hinweise
         NETSDK1206 - RID-Hinweise -->
    <NoWarn>$(NoWarn);CA1416;MSB3568;CS1701;CS1702;NU1701;MSB3277;NETSDK1206;WFAC010</NoWarn>

    <!-- Satellitenkulturen (de-DE/en-US) wie zuvor -->
    <SatelliteResourceLanguages>de-DE;en-US</SatelliteResourceLanguages>
	<DefaultItemExcludes>$(DefaultItemExcludes);.claude\**</DefaultItemExcludes>
  </PropertyGroup>
  
  <ItemGroup>
  <Compile Remove=".claude\**" />
  <EmbeddedResource Remove=".claude\**" />
  <None Remove=".claude\**" />
</ItemGroup>

  <!-- Die Ausschlussliste "Dateien auf der Platte, die nie ins alte Projekt
       aufgenommen waren" ist mit iU9-W0 entfallen: Die Kurzansicht der Simulation,
       die "- Kopie"-Dateien und der zweite Diagrammverwalter sind geloescht
       (Anwenderentscheid iF29). Was nicht uebersetzt werden soll, liegt damit auch
       nicht mehr im Baum. -->

  <!-- Projektreferenzen -->
  <ItemGroup>
    <!-- DER RECHENKERN (Umsetzungskonzept iOS, iU4-5). Die 168 Kerndateien
         liegen seit iU4-5 unter ..\EPOS.Kern\ und werden von diesem Projekt
         NICHT mehr uebersetzt - eine Fachaenderung am Rechenkern wird an genau
         einer Stelle gemacht. Der Kern bringt den generierten Typkatalog aus
         sql\schema und den Anzeigetext-Katalog MyResource\Resource.resx samt
         Satellit mit; beide waren bis iU4-4 hier eingebunden. -->
    <ProjectReference Include="..\EPOS.Kern\EPOS.Kern.csproj" />

    <!-- Stromspeicher-Modul AP1: UI-freie Rechenbibliothek (net10.0, AnyCPU).
         Die Engine hat selbst keine Referenzen und bindet nichts nach.
         Bleibt hier eingetragen, obwohl EPOS.Kern sie ebenfalls referenziert -
         Views\ spricht sie direkt an. -->
    <ProjectReference Include="..\SpeicherEngine\SpeicherEngine.csproj" />

    <!-- KI-Assistent B1: UI-freier, DB-freier Kern der Aufgabensteuerung
         (net10.0, AnyCPU, ohne Paketreferenzen). Fachkonzept KI-Assistent 3.7. -->
    <ProjectReference Include="..\KiKern\KiKern.csproj" />

    <!-- Erststart-Assistent S8: derselbe Migrationskern, den auch die Konsolenfassung
         EposSqliteMigrator.exe fuer Kundenbestaende benutzt (net10.0, x64, Schema als
         eingebettete Ressource). EINE Migrationslogik fuer beide Wege - eine zweite
         waere die Stelle, an der die Ergebnisse auseinanderlaufen.
         Das Projekt liegt in der EIGENEN Projektmappe EposSqliteMigrator\; es ist
         seit S8 zusaetzlich in WP-Plan.sln eingetragen, damit Visual Studio die
         Referenz aufloest (MSBuild baut sie ueber diese ProjectReference ohnehin). -->
    <ProjectReference Include="..\EposSqliteMigrator\Kern\EposSqliteMigrator.Kern.csproj" />

    <!-- DIE OBERFLAECHENBIBLIOTHEK (iU8). Razor-Komponenten ohne WinForms,
         ohne System.Drawing und ohne Datenbank; sie laufen hier in einer
         BlazorWebView und auf iOS unveraendert in einer WKWebView. Jeder NEUE
         Dialog entsteht dort, diese Anwendung liefert nur noch die Huelle
         (Allgemein\Blazor\BlazorDialogForm.cs). -->
    <ProjectReference Include="..\EPOS.UI\EPOS.UI.csproj" />
  </ItemGroup>

  <!-- NuGet-Pakete -->
  <ItemGroup>
    <!-- Chart-Ersatz: Port mit identischem Namespace System.Windows.Forms.DataVisualization.Charting -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <PackageReference Include="WinForms.DataVisualization" />

    <!-- Berichtsmodul Phase 4: Excel-Ausgabe ohne Office (MIT-Lizenz).
         SixLabors.Fonts bewusst auf 1.0.x gepinnt — ab 2.x gilt die Six Labors
         Split License (Release-Checkliste: dotnet list package - -include-transitive). -->
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="SixLabors.Fonts" />

    <!-- Datenzugriff: SQLite (Arbeitspaket S4a). Gleiche Version wie der
         EposSqliteMigrator - beide muessen dieselbe SQLite-Engine mitbringen. -->
    <PackageReference Include="Microsoft.Data.Sqlite" />

    <!-- BLEIBT: OleDbParameter ist nach der Umstellung nur noch DATENTRAEGER an den
         ~2.300 Aufrufstellen; DataRepository uebersetzt innen (Konzept 2). -->
    <PackageReference Include="System.Data.OleDb" />

    <!-- Konfiguration / Settings -->
    <PackageReference Include="System.Configuration.ConfigurationManager" />

    <!-- Lizenzverwaltung: Ed25519-Signaturprüfung + DPAPI-Ablage -->
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />

    <!-- Originalbestand -->
    <PackageReference Include="Humanizer.Core" />
    <PackageReference Include="JsonSchema.Net" />
    <PackageReference Include="JsonSchema.Net.Generation" />
    <PackageReference Include="MathNet.Numerics" />
    <PackageReference Include="Mscc.GenerativeAI" />
    <PackageReference Include="ScottPlot.WinForms" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" />

    <!-- Microsoft.Extensions.* (Mscc.GenerativeAI 3.1 fordert >= 10.0.3) -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />

    <!-- Semantische Doku-Suche (H10): oertliche Einbettungen, CPU, x64.
         Beide MIT; die Modelldateien liegen NICHT im Repo, sondern werden
         einmalig nach %APPDATA%\wp-plan\semantik\ geholt (SemantikModell). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />

    <!-- Blazor-Huelle (iU8): BlazorWebView fuer WinForms. Zieht
         Microsoft.Web.WebView2 mit (SDK und WebView2Loader.dll) - NICHT die
         Laufzeit selbst. Die Evergreen-Runtime bringt das Setup mit
         (Setup\EPOS-Plan.iss, WebView2Vorhanden). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.WindowsForms" />
  </ItemGroup>

  <!-- Entwurfszeit-Verknuepfung. Properties\Settings.* und
       MyResource\Resource.* sind mit iU4-5 nach EPOS.Kern gezogen; ihre
       Verknuepfungen stehen jetzt dort. -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- Hilfesystem: Zuordnung Steuerelement -> Hilfeseite (Konzept Hilfesystem, F2).
       Die Datei wird EINGEBETTET mitgeliefert, damit die Hilfe nicht daran scheitert,
       dass eine Textdatei beim Ausrollen vergessen wurde. Eine gleichnamige Datei
       NEBEN DER EXE übersteuert sie zur Laufzeit — deshalb wird sie bewusst NICHT in
       den Ausgabeordner kopiert. LogicalName festgeschrieben, damit der Ressourcenname
       nicht am Ordnerpfad hängt. -->
  <ItemGroup>
    <None Remove="Allgemein\Hilfe\help_mapping.txt" />
    <None Remove="Views\Hauptformular\Form_Start.cs.bak" />
    <EmbeddedResource Include="Allgemein\Hilfe\help_mapping.txt">
      <LogicalName>help_mapping.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Hilfesystem: Startbestand des Katalogs (Konzept Hilfesystem, F6).
       Ohne Netz UND ohne vorherigen Onlinelauf wäre die Hilfe beim allerersten
       Start sonst vollständig leer. Der Bestand ist am 22.08.2026 gegen
       https://epos-plan.de/wp-json/wp/v2/pages erhoben worden: 116 Seiten,
       geschlüsselt über den Link-Pfad (F7) — ein slug-geschlüsselter Bestand
       verlöre acht Seiten. Rangfolge zur Laufzeit:
       Online > AppData-Sicherung > dieser Startbestand.
       Reines ASCII (Umlaute als \uXXXX), damit keine Kodierung daran scheitern
       kann. LogicalName festgeschrieben, damit der Ressourcenname nicht am
       Ordnerpfad hängt; NICHT in den Ausgabeordner kopiert — zur Laufzeit
       schreibt die Anwendung ihre eigene Sicherung nach AppData. -->
  <ItemGroup>
    <None Remove="Allgemein\Hilfe\help_cache.json" />
    <EmbeddedResource Include="Allgemein\Hilfe\help_cache.json">
      <LogicalName>help_cache.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Klimazonenkarte DIN 4710 (Anwenderwunsch 29.08.2026): das vom Anwender
       erstellte Kartenbild (PNG) als Anzeige plus seine SVG-Quelle, aus der
       KlimazonenKarte zur Laufzeit die 15 Zonenpolygone fuer Hit-Test und
       Hervorhebung liest (Gruppen "zonenflaechen"/"zonennummern", reine
       M/L/Z-Pfade). Quelle im Repo: "Klimazonen DIN4710\" in der Wurzel.
       LogicalName festgeschrieben, damit der Ressourcenname nicht am
       Ordnerpfad haengt (Muster help_cache.json). -->
  <ItemGroup>
    <None Remove="Ressourcen\Zonenkarte_Klimazonen.png" />
    <None Remove="Ressourcen\Zonenkarte_Klimazonen.svg" />
    <EmbeddedResource Include="Ressourcen\Zonenkarte_Klimazonen.png">
      <LogicalName>Zonenkarte_Klimazonen.png</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Ressourcen\Zonenkarte_Klimazonen.svg">
      <LogicalName>Zonenkarte_Klimazonen.svg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Resources-Generator-Verknüpfungen -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ClickOnce-Signaturdatei nicht kompilieren -->
  <ItemGroup>
    <None Include="WindowsFormsApplication1_TemporaryKey.pfx" />
  </ItemGroup>

  <!-- Berichtsmodul: Word-Rahmenvorlage in den Ausgabeordner kopieren
       (WordBerichtGenerator.FindeVorlage sucht unter Vorlagen\Berichtsvorlage.docx) -->
  <ItemGroup>
    <None Update="Allgemein\Bericht\Vorlagen\Berichtsvorlage.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Vorlagen\Berichtsvorlage.docx</Link>
      <TargetPath>Vorlagen\Berichtsvorlage.docx</TargetPath>
    </None>
  </ItemGroup>

  <!-- Die Startseite der Huelle. HostPage="wwwroot\index.html" sucht sie neben
       der EXE; ohne diese Zeile stuende sie nur im Quellbaum. Die Anteile aus
       EPOS.UI (_content\EPOS.UI\*) und das Blazor-Skript (_framework\*) legt
       der Razor-SDK selbst daneben. -->
  <ItemGroup>
    <Content Update="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
