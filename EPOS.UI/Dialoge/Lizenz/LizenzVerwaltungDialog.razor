@* Lizenzverwaltung (Administration -> Lizenz): Status, Aktivierung per
   Schluessel oder .lic-Datei, Testversion und Geraetefreigabe.
   iU9-W15c.5, Ersatz fuer Views/Admin/Form_LizenzVerwaltung.{cs,Designer.cs,resx}
   (302 + 246 + 119 Z.). Die Anzeigetexte stehen seit W15c-O-2 (04.09.2026)
   gebuendelt in LizenzTexte.Verwaltung statt als 29 Einzelparameter.

   DREI GRUPPEN WIE IM VORLAEUFER: Status | Aktivieren | Weitere Aktionen, dazu
   eine Fusszeile mit Hinweisplatz und "Schliessen".

   KEIN OK/ABBRECHEN-PAAR (Entscheid E-3, bitgleich): "die Aktivierung laeuft in
   Aktivieren_Click sofort gegen den Lizenzserver und ist beim Schliessen
   laengst geschehen; ein 'Abbrechen' wuerde eine Ruecknahme zusagen, die der
   Dialog nicht leisten kann" (Form_LizenzVerwaltung.cs:82-86).

   DIE KOMPONENTE KENNT DEN LIZENZKERN NICHT (Regel S-2, Befund W15c-B13): kein
   LizenzManager, kein LizenzServerClient, kein GeraeteId, keine
   Signaturpruefung, nur Delegaten der Huelle - auf iOS liest Pruefe() den
   Schluesselbund synchron, und eine Komponente ruft immer vom Zeichenfaden.

   DER SCHLUESSEL VERLAESST DIE KOMPONENTE NUR RICHTUNG "Aktivieren" (Regel S-4):
   nach einem Erfolg wird das Feld GELEERT (_schluessel.Clear(), :184), keine
   Meldung wiederholt ihn, nichts wird abgelegt. Grossgeschrieben wird er
   zweifach - text-transform fuer die Anzeige, ToUpperInvariant fuer den WERT;
   zusammen ist das CharacterCasing = Upper des Designers (:112).

   NEUN MESSAGEBOX WERDEN EIN WARNBANNER UND EINE RUECKFRAGE. Acht unterbrachen
   nur und stehen jetzt an Ort und Stelle; die neunte ("Geraet von der Lizenz
   loesen?") ist eine echte Entscheidung und bleibt eine Rueckfrage - mit
   VorgabeNein, weil die Folge eine Neuaktivierung ist. *@

@namespace EPOS.UI.Dialoge.Lizenz

<div class="epos-lizverw">

    @* ---- Gruppe 1: Lizenzstatus auf diesem Arbeitsplatz ---------------- *@
    <section class="epos-lizverw-gruppe" aria-labelledby="lizverw-status-kopf">
        <h2 class="epos-lizverw-kopf" id="lizverw-status-kopf">@Wortlaut.GruppeStatus</h2>

        <p class="epos-lizverw-status epos-lizverw-status--@Stufe" role="status">@Lage.Statustext</p>
        <p class="epos-lizverw-detail">@Lage.Detailtext</p>

        @if (!string.IsNullOrEmpty(Lage.PortalUrl))
        {
            @* Ein Verweis, kein Process.Start: Die WebView oeffnet ihn im
               Systembrowser, auf iOS das Teilen-Blatt der Plattform. *@
            <p class="epos-lizverw-portal">
                <a href="@Lage.PortalUrl" target="_blank" rel="noopener noreferrer">@Wortlaut.LinkPortal</a>
            </p>
        }
    </section>

    @* ---- Gruppe 2: Aktivieren ----------------------------------------- *@
    <section class="epos-lizverw-gruppe" aria-labelledby="lizverw-aktiv-kopf">
        <h2 class="epos-lizverw-kopf" id="lizverw-aktiv-kopf">@Wortlaut.GruppeAktivieren</h2>

        <div class="epos-lizverw-zeile">
            <label class="epos-feld epos-lizverw-schluessel">
                <span class="epos-feld-text">@Wortlaut.LabelSchluessel</span>
                <span class="epos-feld-zeile">
                    @* text-transform macht die Anzeige gross, ToUpperInvariant den
                       WERT - beides zusammen ist CharacterCasing = Upper. *@
                    <input class="epos-eingabe epos-lizverw-grossschrift" type="text"
                           value="@_schluessel" disabled="@_laeuft"
                           autocomplete="off" spellcheck="false"
                           @oninput="SchluesselGeaendert" />
                </span>
            </label>

            <button type="button" class="epos-knopf epos-lizverw-lic"
                    disabled="@_laeuft" @onclick="LicLaden">@Wortlaut.KnopfLic</button>
        </div>

        <div class="epos-lizverw-zeile">
            <label class="epos-feld epos-lizverw-email">
                <span class="epos-feld-text">@Wortlaut.LabelEmail</span>
                <span class="epos-feld-zeile">
                    <input class="epos-eingabe" type="email" value="@_email"
                           disabled="@_laeuft" autocomplete="off" spellcheck="false"
                           @oninput="EmailGeaendert" />
                </span>
            </label>
        </div>

        <div class="epos-lizverw-zeile">
            <button type="button" class="epos-knopf epos-knopf--primaer"
                    disabled="@_laeuft" @onclick="Aktivieren">@Wortlaut.KnopfAktivieren</button>
        </div>

        <p class="epos-lizverw-hinweis">@Wortlaut.HinweisAktivierung</p>
    </section>

    @* ---- Gruppe 3: Weitere Aktionen ------------------------------------ *@
    <section class="epos-lizverw-gruppe" aria-labelledby="lizverw-aktionen-kopf">
        <h2 class="epos-lizverw-kopf" id="lizverw-aktionen-kopf">@Wortlaut.GruppeAktionen</h2>

        <div class="epos-lizverw-zeile">
            @* Bitgleich zu StatusAnzeigen(): "Testversion" nur OHNE Token,
               "Geraet loesen" nur MIT. Waehrend einer Aktion beide gesperrt. *@
            <button type="button" class="epos-knopf"
                    disabled="@(_laeuft || Lage.HatToken)" @onclick="Trial">@Wortlaut.KnopfTrial</button>

            <button type="button" class="epos-knopf"
                    disabled="@(_laeuft || !Lage.HatToken)" @onclick="FreigebenFragen">@Wortlaut.KnopfFreigeben</button>
        </div>
    </section>

    @* ---- Fusszeile ------------------------------------------------------ *@
    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungsstufe" Text="@_meldung" />
    }

    <div class="epos-lizverw-fuss">
        <InfoKnopf Schluessel="Form_LizenzVerwaltung.btn_Help" />
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="Schliessen">@Wortlaut.KnopfSchliessen</button>
    </div>
</div>

<Rueckfrage Offen="@_freigabeFrage"
            Frage="@Wortlaut.MsgFreigebenFrage"
            TitelText="@Wortlaut.Titel"
            VorgabeNein="true"
            JaText="@Wortlaut.Ja"
            NeinText="@Wortlaut.Nein"
            Beantwortet="FreigebenBeantwortet" />

@code {
    // ==================================================================
    //  Anzeige
    // ==================================================================

    /// <summary>Das Lagebild der Lizenz — von der Huelle gebaut (siehe <see cref="LizenzGaben"/>).</summary>
    [Parameter] public LizenzGaben Lage { get; set; } = LizenzGaben.Leer;

    /// <summary>Vorbelegung des E-Mail-Feldes aus dem Token; der SCHLUESSEL nie (Regel S-4).</summary>
    [Parameter] public string EmailVorgabe { get; set; } = "";

    /// <summary>
    /// Alle Anzeigetexte in EINEM Satz (W15c-O-2). Ohne Angabe füllt sich das
    /// Bündel aus <c>MyResource</c>; die Hülle überschreibt nur den Fenstertitel.
    /// </summary>
    [Parameter] public LizenzTexte Texte { get; set; } = new();

    /// <summary>Kurzform für den eigenen Teil des Bündels.</summary>
    private LizenzVerwaltungTexte Wortlaut => Texte.Verwaltung;

    // ==================================================================
    //  Wege nach draussen
    // ==================================================================

    /// <summary>Aktivierung: Schluessel und E-Mail hinein, Erfolg und Meldung heraus.</summary>
    [Parameter] public Func<string, string, Task<(bool Ok, string Meldung)>>? Aktivierenweg { get; set; }

    /// <summary>Eine <c>.lic</c>-Datei waehlen und lesen; leerer Schluessel = nichts gefunden.</summary>
    [Parameter] public Func<Task<(string Schluessel, string Email, string Meldung)>>? LicLesen { get; set; }

    /// <summary>Testversion anfordern; der Schluessel kommt per E-Mail.</summary>
    [Parameter] public Func<string, Task<(bool Ok, string Meldung)>>? Trialweg { get; set; }

    /// <summary>Geraet von der Lizenz loesen. Ein Netzfehler ist KEIN Ablehnungsgrund.</summary>
    [Parameter] public Func<Task<(bool Ok, bool Netzfehler, string Meldung)>>? Freigebenweg { get; set; }

    /// <summary>Das Lagebild neu holen — nach JEDER Aktion, wie <c>StatusAnzeigen()</c>.</summary>
    [Parameter] public Func<Task<LizenzGaben>>? Auffrischen { get; set; }

    /// <summary>
    /// Die E-Mail-Regel des KERNS (<c>LizenzCtrl.EmailGueltig</c>) als Delegat — eine
    /// zweite Fassung hier wäre eine zweite Wahrheit. Ohne Delegat entscheidet der Server.
    /// </summary>
    [Parameter] public Func<string, bool>? EmailPruefen { get; set; }

    /// <summary>Der Dialog ist zu.</summary>
    [Parameter] public EventCallback Geschlossen { get; set; }

    // ==================================================================
    //  Zustand — zwei Zeichenketten und die Sperre, mehr nicht
    // ==================================================================

    private string _schluessel = "";
    private string _email = "";
    private bool _laeuft;
    private bool _freigabeFrage;
    private string _meldung = "";
    private WarnStufe _meldungsstufe = WarnStufe.Hinweis;

    /// <summary>
    /// Die drei Stufen der Statusanzeige — bitgleich zu den drei Farben des Vorlaeufers
    /// (<c>:134-137</c>): gruen fuer <c>Gueltig</c>, orange fuer die zwei
    /// Fristzustaende, rot fuer den Rest.
    /// </summary>
    private string Stufe => Lage.Zustand switch
    {
        "GUELTIG" => "gut",
        "KULANZ" or "NACHPRUEFUNG" => "warn",
        _ => "schlecht"
    };

    protected override void OnParametersSet()
    {
        // Die E-Mail wird vorbelegt, solange der Anwender nichts eingetippt hat.
        if (_email.Length == 0 && !string.IsNullOrEmpty(EmailVorgabe)) _email = EmailVorgabe;
    }

    private void SchluesselGeaendert(ChangeEventArgs e) => _schluessel = e.Value?.ToString() ?? "";

    private void EmailGeaendert(ChangeEventArgs e) => _email = e.Value?.ToString() ?? "";

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungsstufe = stufe;
    }

    // ==================================================================
    //  Die vier Aktionen
    // ==================================================================

    /// <summary>
    /// „Jetzt aktivieren": leere Eingabe und ungueltige Adresse melden sofort,
    /// sonst laeuft der Delegat. Bei Erfolg wird das Schluesselfeld GELEERT
    /// (Regel S-4); danach wird IMMER aufgefrischt.
    /// </summary>
    private async Task Aktivieren()
    {
        string schluessel = (_schluessel ?? "").Trim().ToUpperInvariant();
        string email = (_email ?? "").Trim();

        if (schluessel.Length == 0 || email.Length == 0)
        {
            Melden(Wortlaut.MsgEingabeFehlt, WarnStufe.Hinweis);
            return;
        }
        if (!EmailTaugt(email))
        {
            Melden(string.Format(Wortlaut.MsgEmailUngueltig, email), WarnStufe.Hinweis);
            return;
        }
        if (Aktivierenweg is null) return;

        _laeuft = true;
        Melden(Wortlaut.StatusAktivierung, WarnStufe.Hinweis);
        StateHasChanged();

        (bool ok, string meldung) = await Aktivierenweg(schluessel, email);

        _laeuft = false;
        if (ok)
        {
            _schluessel = "";                       // Regel S-4
            Melden(Wortlaut.MsgAktiviert, WarnStufe.Hinweis);
        }
        else
        {
            Melden(string.IsNullOrEmpty(meldung) ? Wortlaut.MsgAktivierungFehler : meldung, WarnStufe.Fehler);
        }

        await LageHolen();
    }

    /// <summary>
    /// „Lizenzdatei (.lic)…": Die Huelle waehlt und liest, hier landen nur die beiden
    /// Eingabewerte. Ein leerer Schluessel meldet <c>LIZ_MSG_LIC_OHNE_SCHLUESSEL</c>.
    /// </summary>
    private async Task LicLaden()
    {
        if (LicLesen is null) return;

        (string schluessel, string email, string meldung) = await LicLesen();

        // Abgebrochener Waehler: kein Schluessel UND keine Meldung - dann bleibt alles.
        if (string.IsNullOrWhiteSpace(schluessel) && string.IsNullOrEmpty(meldung))
            return;

        if (string.IsNullOrWhiteSpace(schluessel))
        {
            Melden(Wortlaut.MsgLicOhneSchluessel, WarnStufe.Fehler);
            return;
        }

        _schluessel = schluessel;
        if (!string.IsNullOrWhiteSpace(email)) _email = email;
        Melden(Wortlaut.HinweisLicGeladen, WarnStufe.Hinweis);
    }

    /// <summary>„Testversion anfordern…": Die Adresse wird VORHER geprueft — der
    /// Schluessel wird an sie geschickt, eine falsche Adresse liefe ins Leere.</summary>
    private async Task Trial()
    {
        string email = (_email ?? "").Trim();
        if (email.Length == 0 || !EmailTaugt(email))
        {
            Melden(Wortlaut.MsgTrialEmail, WarnStufe.Hinweis);
            return;
        }
        if (Trialweg is null) return;

        _laeuft = true;
        Melden(Wortlaut.StatusTrial, WarnStufe.Hinweis);
        StateHasChanged();

        (bool ok, string meldung) = await Trialweg(email);

        _laeuft = false;
        Melden(string.IsNullOrEmpty(meldung) ? (ok ? Wortlaut.MsgTrialOk : Wortlaut.MsgTrialFehler) : meldung,
               ok ? WarnStufe.Hinweis : WarnStufe.Fehler);
    }

    /// <summary>„Gerät von der Lizenz lösen" — erst die Rückfrage.</summary>
    private void FreigebenFragen() => _freigabeFrage = true;

    /// <summary>Die Antwort auf die Rueckfrage. „Nein" tut nichts — genau wie
    /// <c>if (wahl != DialogResult.Yes) return;</c> im Vorlaeufer.</summary>
    private async Task FreigebenBeantwortet(bool? antwort)
    {
        _freigabeFrage = false;
        if (antwort != true) return;
        if (Freigebenweg is null) return;

        _laeuft = true;
        Melden(Wortlaut.StatusFreigabe, WarnStufe.Hinweis);
        StateHasChanged();

        (bool ok, bool netzfehler, string meldung) = await Freigebenweg();

        _laeuft = false;

        // Bitgleich: gemeldet wird NUR der Netzfehler; eine fachliche Ablehnung
        // loescht das Token und zeigt sich im neuen Lagebild.
        if (!ok && netzfehler) Melden(Wortlaut.MsgServerNichtErreichbar, WarnStufe.Fehler);
        else Melden(string.IsNullOrEmpty(meldung) ? "" : meldung, WarnStufe.Hinweis);

        await LageHolen();
    }

    private async Task LageHolen()
    {
        if (Auffrischen is null) return;
        Lage = await Auffrischen() ?? LizenzGaben.Leer;
        StateHasChanged();
    }

    private Task Schliessen() => Geschlossen.InvokeAsync();

    /// <summary>Die E-Mail-Regel des KERNS, durch den Delegaten (Regel 6 der Zerlegung).</summary>
    private bool EmailTaugt(string email) => EmailPruefen is null || EmailPruefen(email);
}
