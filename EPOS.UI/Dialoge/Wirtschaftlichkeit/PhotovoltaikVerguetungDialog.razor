    /// <summary>Der Statussatz der Gruppe § 51 (Pruefhilfe fuer Tests).</summary>
    public string Par51Status
    {
        get
        {
            if (Modell.Inbetriebnahme < PvErloesRechner.Par51Stichtag) return _t.Altanlage;
            double grenze = KatalogWert(DbWerte.GESETZ_EEG_51_GRENZE_KW, 100) ?? 100;
            if (Kwp >= grenze) return _t.Greift;
            if (Modell.IMSys_Einbaujahr.HasValue)
                return string.Format(Kultur, _t.GreiftImSys, Modell.IMSys_Einbaujahr.Value + 1);
            return _t.Verschont;
        }
    }

    /// <summary>Der Statussatz der Kappungsgruppe (Pruefhilfe fuer Tests).</summary>
    public string KappungStatus
    {
        get
        {
            int stellung = PvSchalterwahlen.Index(Modell.Kappung60_Anwenden);
            if (stellung == 2) return _t.KappungAus;
            bool automatisch = VermarktungNr == 0 && !Modell.IMSys_Einbaujahr.HasValue;
            return stellung == 1 || automatisch ? _t.KappungAn : _t.KappungInaktiv;
        }
    }

    // =====================================================================
    // Vorschau
    // =====================================================================

    // Merge 5 (PB1c): Eigenverbrauch des Basisjahres und Strompreis gehen wie in der
    // WinForms-Vorschau mit - sonst fehlte der Vorschau der vermiedene Bezug.
    //
    // W8-O-5c / S1.2 (Befund U6): Der Rechner erwartet den Eigenverbrauch in kWh, der
    // Dialog fuehrt MWh. Umgerechnet wird ueber Energieeinheit - in EPOS.UI steht auf
    // einer Energiemenge kein nackter Faktor 1000 (Waechter EinheitenWacheTests).
    private PvErloesErgebnis Erloes => PvErloesRechner.Rechne(
        Modell, KwpRechnerisch, EinspeisungMWh, null, null, 20,
        Katalog, Jahresmarktwert ?? (jahr => null), Kultur,
        Energieeinheit.KWh.AusMWh(Math.Max(0.0, ErzeugungMWh - EinspeisungMWh)),
        StrompreisEurKwh ?? 0.0);

    /// <summary>Die Vorschauzeile (Pruefhilfe fuer Tests).</summary>
    public string VorschauText
    {
        get
        {
            if (EinspeisungMWh <= 0) return _t.VorschauOhneErgebnis;
            PvErloesErgebnis e = Erloes;
            return string.Format(Kultur, _t.Vorschau,
                EinspeisungMWh, e.SatzJahr1Ct,
                e.JeJahr != null && e.JeJahr.Length > 1 ? e.JeJahr[1] : 0,
                e.VerguetungsausfallKwh, e.VerguetungsausfallEur,
                e.Kompensation51aEur, e.LetztesVerguetungsjahr);
        }
    }

    /// <summary>Die Kennzahlzeile (P6, N.3 Nr. 3).</summary>
    public string KennzahlText
    {
        get
        {
            if (ErzeugungMWh <= 0 || WirtParameter is null) return "—";
            PvKennzahlen k = PvKennzahlenRechner.Rechne(
                ErzeugungMWh, EinspeisungMWh, BedarfMWh,
                EvQuoteSpeicher, AutarkieSpeicher, InvestPv, BetriebPv,
                WirtParameter.Zinssatz, WirtParameter.Betrachtungszeitraum,
                WirtParameter.PreissteigerungEnergie,
                StrompreisEurKwh, Erloes.JeJahr, Kultur);
            return PvKennzahlenRechner.Anzeige(k, Kultur);
        }
    }

