    // Assistenten ueber ihre Zeile (ZapfprofilZoneKiZeile). Der Name aendert die
    // Auslegung nicht; Nutzungsart, Bezugsmenge und Niveau machen ihren Punkt ueberholt.

    private void ZonennameSetzen(ZapfprofilZoneDaten z, string name)
    {
        z.Name = name ?? "";
        Geaendert();
    }

    private void ZonenNutzungsartSetzen(ZapfprofilZoneDaten z, int? id)
