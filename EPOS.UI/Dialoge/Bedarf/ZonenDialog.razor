    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private ZoneDaten _stand = new();
    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Warnung;

    /// <summary>Die Bearbeitung der Zonenmatrix am Ort dieser Zone (Stufe KP2, Welle U4).</summary>
    private KonditionierungBearbeitung _kond = default!;

    /// <summary>Die Bearbeitung der Zonenmatrix. Prüfhilfe für die Tests.</summary>
    public KonditionierungBearbeitung Konditionierungsbearbeitung => _kond;
    private readonly HashSet<string> _fehlerfelder = new();

    private BauteilDaten? _bauteil;
    private bool _bauteilNeu;
    private int _bauteilIndex = -1;

    /// <summary>Der Arbeitsstand. Prüfhilfe für die Tests.</summary>
    public ZoneDaten Arbeitsstand => _stand;

    /// <summary>Die stehende Meldung. Prüfhilfe für die Tests.</summary>
    public string Meldung => _meldung;

    /// <summary>Steht der Bauteildialog? Prüfhilfe für die Tests.</summary>
    public bool BauteilOffen => _bauteil is not null;

    /// <summary>Die Vorgabenkaskade des Arbeitsstands (<see cref="Zonenvorgaben"/>); <c>null</c> ohne Gebäude.</summary>
    private Zonenvorgaben? _vorgaben;

    protected override void OnInitialized()
    {
        _stand = (Zone ?? new ZoneDaten()).Kopie();
        VorgabenNachziehen();
        _kond = new KonditionierungBearbeitung(Gebaeudestand ?? new GebaeudeArbeitsstand(), _stand, () => Konditionierung,
                                               () => KonditionierungTexte, () => KonditionierungFragen)
        {
            Melden = (text, stufe) => { _meldung = text ?? ""; _meldungStufe = stufe; },
            Bestandserbe = Bestandserbe
        };
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.ZONE, () => KiSicht(), KiHaken());
    }

    /// <summary>
    /// Eine Handlung der Zonenmatrix hat den Arbeitsstand geändert: Die Vorgaben der übrigen Felder
    /// ziehen nach (etwa der Luftwechsel), eine alte Meldung fällt, wenn die Handlung keine neue brachte.
    /// </summary>
    private void KonditionierungGeaendert() => VorgabenNachziehen();

    /// <summary>
    /// Was eine leere Bestandszelle der Zone vom Gebäude erbt, wo der Weg kein Erbe liefert (ohne
    /// Konditionierungstabellen, ohne Gaben): dieselbe Vorgabenkaskade wie die übrigen Felder.
    /// </summary>
    private double? Bestandserbe(KonditionierungGroesse g, KonditionierungZeile z)
    {
        if (_vorgaben is null) return null;
        return (g, z) switch
        {
            (KonditionierungGroesse.Heizen, KonditionierungZeile.Tag) => _vorgaben.SollTag.Wert,
            (KonditionierungGroesse.Heizen, KonditionierungZeile.Nacht) => _vorgaben.SollNacht.Wert,
            (KonditionierungGroesse.Heizen, KonditionierungZeile.Wochenende) => _vorgaben.SollWochenende.Wert,
            (KonditionierungGroesse.Heizen, KonditionierungZeile.Ferien) => _vorgaben.SollFerien.Wert,
            (KonditionierungGroesse.Kuehlen, KonditionierungZeile.Tag) => _vorgaben.KuehlSollwert.Wert,
            (KonditionierungGroesse.Kuehlen, KonditionierungZeile.Nacht) => _vorgaben.KuehlSollwertNacht.Wert,
            (KonditionierungGroesse.Lueftung, KonditionierungZeile.Nennwert) => _vorgaben.LuftwechselInfiltration.Wert,
            (KonditionierungGroesse.Lueftung, KonditionierungZeile.Tag) => _vorgaben.LuftwechselNutzer.Wert,
            (KonditionierungGroesse.Geraete, KonditionierungZeile.Nennwert) => _vorgaben.InterneWaermegewinne.Wert,
            _ => null
        };
    }

    /// <summary>Setzt einen Wert der Zone und zieht die Vorgaben nach — Tastatur und Assistent gehen diesen Weg.</summary>
    private void Setzen(Action setzen)
    {
        setzen();
        VorgabenNachziehen();
    }

    private void VorgabenNachziehen()
    {
        _vorgaben = Gebaeude is null ? null : Zonenvorgaben.Bilden(_stand.Eingaben(), Gebaeude, Math.Max(1, Zonenzahl));
        // E63: eine Fehleingabe in einem ausgeblendeten Uebergabefeld haelt das OK nicht mehr an.
        if (!UebergabeFelderSichtbar)
            foreach (string f in UebergabeFeldnamen) _fehlerfelder.Remove(f);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    // =================================================================================
    // Der Hilfe-Assistent liest und setzt den Arbeitsstand
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private ZonenKiSicht? _kiSicht;

    private ZonenKiSicht KiSicht()
    {
        return _kiSicht ??= new ZonenKiSicht
        {
            BezeichnungLesen = () => _stand.Bezeichner,
            BezeichnungSetzen = w => _stand.Bezeichner = w ?? "",
            NutzflaecheLesen = () => _stand.Nutzflaeche,
            NutzflaecheSetzen = w => Setzen(() => _stand.Nutzflaeche = w),
            // Stufe G6b (W2): die Werte der Zone - Setzen nimmt denselben Weg wie die Tastatur; die
            // Bestandszellen der Matrix (Sollwerte, Lueftung, Gewinne) gehen ueber ihre Zelle (KP2 U4).
            RaumhoeheLesen = () => _stand.Raumhoehe,
            RaumhoeheSetzen = w => Setzen(() => _stand.Raumhoehe = w),
            VolumenLesen = () => _stand.Volumen,
            VolumenSetzen = w => Setzen(() => _stand.Volumen = w),
            BeheiztLesen = () => _stand.IstBeheizt,
            BeheiztSetzen = w => Setzen(() => _stand.IstBeheizt = w),
            SollTagLesen = () => _stand.SollTag,
            SollTagSetzen = w => Zelle(KonditionierungGroesse.Heizen, KonditionierungZeile.Tag, w),
            SollNachtLesen = () => _stand.SollNacht,
            SollNachtSetzen = w => Zelle(KonditionierungGroesse.Heizen, KonditionierungZeile.Nacht, w),
            SollWochenendeLesen = () => _stand.SollWochenende,
            SollWochenendeSetzen = w => Zelle(KonditionierungGroesse.Heizen, KonditionierungZeile.Wochenende, w),
            SollFerienLesen = () => _stand.SollFerien,
            SollFerienSetzen = w => Zelle(KonditionierungGroesse.Heizen, KonditionierungZeile.Ferien, w),
            MaxTemperaturLesen = () => _stand.Maximaleraumtemperatur,
            MaxTemperaturSetzen = w => Setzen(() => _stand.Maximaleraumtemperatur = w),
            InfiltrationLesen = () => _stand.LuftwechselInfiltration,
            InfiltrationSetzen = w => Zelle(KonditionierungGroesse.Lueftung, KonditionierungZeile.Nennwert, w),
            NutzerlueftungLesen = () => _stand.LuftwechselNutzer,
            NutzerlueftungSetzen = w => Zelle(KonditionierungGroesse.Lueftung, KonditionierungZeile.Tag, w),
            GewinneLesen = () => _stand.InterneWaermegewinne,
            GewinneSetzen = w => Zelle(KonditionierungGroesse.Geraete, KonditionierungZeile.Nennwert, w),
            BewohnerLesen = () => _stand.Bewohner,
            BewohnerSetzen = w => Setzen(() => _stand.Bewohner = w),
            StrahlungsanteilLesen = () => _stand.HeizungStrahlungsanteil,
            StrahlungsanteilSetzen = w => Setzen(() => _stand.HeizungStrahlungsanteil = w),
            HeizleistungMaxLesen = () => _stand.HeizleistungMaxKw,
            HeizleistungMaxSetzen = w => Setzen(() => _stand.HeizleistungMaxKw = w),
            KuehlungAktivLesen = () => _stand.KuehlungAktiv,
            KuehlungAktivSetzen = w => Setzen(() => _stand.KuehlungAktiv = w),
            KuehlleistungMaxLesen = () => _stand.KuehlleistungMaxKw,
            KuehlleistungMaxSetzen = w => Setzen(() => _stand.KuehlleistungMaxKw = w),
            // E63 (AK1z): die Uebergabe je Zone - leer = wie Gebaeude; die Art prueft ihren Wert.
            UebergabeArtLesen = () => _stand.UebergabeArt,
            UebergabeArtSetzen = UebergabeArtSetzenKi,
            UebergabeExponentLesen = () => _stand.UebergabeExponent,
            UebergabeExponentSetzen = w => Setzen(() => _stand.UebergabeExponent = w),
            UebergabeNennleistungLesen = () => _stand.UebergabeLeistungNennKw,
            UebergabeNennleistungSetzen = w => Setzen(() => _stand.UebergabeLeistungNennKw = w),
            AuslegungVorlaufLesen = () => _stand.AuslegungVorlauf,
            AuslegungVorlaufSetzen = w => Setzen(() => _stand.AuslegungVorlauf = w),
            AuslegungRuecklaufLesen = () => _stand.AuslegungRuecklauf,
            AuslegungRuecklaufSetzen = w => Setzen(() => _stand.AuslegungRuecklauf = w),
            AuslegungRaumLesen = () => _stand.AuslegungRaumtemperatur,
            AuslegungRaumSetzen = w => Setzen(() => _stand.AuslegungRaumtemperatur = w),
            ProportionalbandLesen = () => _stand.ReglerProportionalband,
            ProportionalbandSetzen = w => Setzen(() => _stand.ReglerProportionalband = w),
            UebergabeWirksamLesen = () => UebergabeWirksam,
            // Stufe NP3b: das zuletzt übernommene Nutzungsprofil, sonst die Nutzung der Kalender (alte Kennungen übersetzt).
            NutzungsprofilLesen = () => !string.IsNullOrWhiteSpace(_stand.Nutzungsprofil)
                ? _stand.Nutzungsprofil!.Trim()
                : string.IsNullOrWhiteSpace(_stand.Kalendernutzung) ? "" : KonditionierungTexte.Nutzungsanzeige(_stand.Kalendernutzung),
            BauteileLesen = () => _stand.Bauteile,
            ArtText = ArtText,
            RandText = RandText,
            NachbarText = NachbarText,
            // Stufe KP2, Welle U4: die Zonenmatrix als Feldtafel - über dieselbe Bearbeitung wie die Zellen.
            Konditionierung = _kond
        };
    }

    /// <summary>
    /// Eine Bestandszelle der Zone über die Bearbeitung der Zonenmatrix (Stufe KP2, Welle U4) — derselbe
    /// Weg wie ihr Feld in der Matrix (Zonenregel, Zellenort); eine Ablehnung trägt den Grund des Reiters.
    /// </summary>
    private void Zelle(KonditionierungGroesse g, KonditionierungZeile z, double? wert)
    {
        if (!_kond.WertSetzen(g, z, wert)) throw KonditionierungKiTafel.Ablehnung(_kond);
        VorgabenNachziehen();
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf: <c>Pruefen</c> ist dieselbe Prüfung wie am
    /// OK-Knopf. Bauteile anlegen, öffnen und entfernen bleiben Klicks des Anwenders; einen Speicherweg
    /// hat die Maske nicht — das OK des Gebäudeeditors schreibt.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => Pruefen() ?? ""
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

