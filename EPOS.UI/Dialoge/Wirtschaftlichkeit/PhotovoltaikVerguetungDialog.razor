    private double? KatalogWert(string schluessel, double rueckfall)
    {
        if (Katalog is null) return rueckfall;
        return Katalog(schluessel, Jahr) ?? rueckfall;
    }

    /// <summary>Der anzulegende Wert samt Herleitung (Pruefhilfe fuer Tests).</summary>
    public EegSatzErgebnis Satz => EegSatzRechner.AnzulegenderWert(
        Math.Max(0.001, Kwp), Modell.Inbetriebnahme, Modell.Einspeiseart, Katalog, Kultur);

    private double Aw => Modell.AwOverride ?? Satz.AwMixCt;

    private string AwText
    {
        get
        {
            string s = string.Format(Kultur, _t.AwZeile, Aw);
            if (Modell.AwOverride.HasValue) s += " " + _t.AwOverrideZusatz;
            return s;
        }
    }

    private string EvText
    {
        get
        {
            double abschlag = KatalogWert(DbWerte.GESETZ_EEG_EV_ABSCHLAG, 0.4) ?? 0.4;
            return string.Format(Kultur, _t.EvSatz, abschlag, Math.Max(0, Aw - abschlag));
        }
    }

    // =====================================================================
    // Vermarktung
    // =====================================================================

    private int? VermarktungNr =>
        string.Equals(Modell.Vermarktungsform, DbWerte.PV_VERMARKTUNG_MARKTPRAEMIE, StringComparison.Ordinal) ? 1
        : string.Equals(Modell.Vermarktungsform, DbWerte.PV_VERMARKTUNG_SONSTIGE_DV, StringComparison.Ordinal) ? 2
        : string.Equals(Modell.Vermarktungsform, DbWerte.PV_VERMARKTUNG_KEINE, StringComparison.Ordinal) ? 3
        : 0;

    private void VermarktungGewaehlt(int? nummer)
    {
        Modell.Vermarktungsform = nummer switch
        {
            1 => DbWerte.PV_VERMARKTUNG_MARKTPRAEMIE,
            2 => DbWerte.PV_VERMARKTUNG_SONSTIGE_DV,
            3 => DbWerte.PV_VERMARKTUNG_KEINE,
            _ => DbWerte.PV_VERMARKTUNG_EV
        };
    }

    private bool IstMarktpraemie => VermarktungNr == 1;
    private bool IstPpa => VermarktungNr == 2;

    /// <summary>Feste EV nur bis 100 kW (N3), unentgeltlich nur unter 200 kW (N4).</summary>
    private bool EvErlaubt => Kwp <= (KatalogWert(DbWerte.GESETZ_EEG_EV_GRENZE_KW, 100) ?? 100) + 0.0001;
    private bool KeineErlaubt => Kwp < (KatalogWert(DbWerte.GESETZ_EEG_UNENTGELTLICH_GRENZE_KW, 200) ?? 200);

    /// <summary>Die gesperrten Optionen (Pruefhilfe fuer Tests).</summary>
    public IReadOnlyList<int> GesperrteFormen
    {
        get
        {
            var l = new List<int>(2);
            if (!EvErlaubt) l.Add(0);
            if (!KeineErlaubt) l.Add(3);
            return l;
        }
    }

    /// <summary>
    /// Wird die GEWAEHLTE Vermarktungsform unzulaessig, schaltet der Dialog wie
    /// der Vorlaeufer auf Marktpraemie um — sonst stuende eine Wahl im Modell,
    /// die es nicht geben darf. Geprueft wird, wo sich die Grenzen aendern
    /// koennen: bei der Leistung und beim Inbetriebnahmejahr.
    /// </summary>
    private void ZulaessigkeitPruefen()
    {
        if ((!EvErlaubt && VermarktungNr == 0) || (!KeineErlaubt && VermarktungNr == 3))
            Modell.Vermarktungsform = DbWerte.PV_VERMARKTUNG_MARKTPRAEMIE;
    }

    private void LeistungGeaendert(double? wert)
    {
        Modell.KwpOverride = wert > 0 ? wert : null;
        ZulaessigkeitPruefen();
    }

    /// <summary>Degradation: 0 heisst „keine" und wird als NULL gefuehrt (E2.4).</summary>
    private void DegradationGeaendert(double? wert)
    {
        Modell.Degradation = wert > 0 ? wert : null;
    }

    private void IbnGeaendert(DateOnly? datum)
    {
        Ibn = datum;
        ZulaessigkeitPruefen();
    }

    private string VermarktungHinweis => EvErlaubt ? _t.Hinweis21c : _t.EvGesperrt;

    // =====================================================================
    // ETAPPE E9b — die ±-Knöpfe an DV-Entgelt und PPA-Preis
    // =====================================================================

    /// <summary>ETAPPE E9b: der Schlüssel des DV-Entgelts für <see cref="PvSzenarioOeffnen"/>.</summary>
    public const string PV_DV = "DV";

    /// <summary>ETAPPE E9b: der Schlüssel des PPA-Preises.</summary>
    public const string PV_PPA = "PPA";

    private readonly SzenariopaarTexte _sz = new();
    private IReadOnlyDictionary<string, object>? _szenarioGaben;
    private string _szenarioTitel = "";
    private string _szenarioArt = "";

    /// <summary>Steht die Überlagerung eines Szenariopaars? (Prüfhilfe für Tests)</summary>
    public bool SzenarioOffen => _szenarioGaben is not null;

    /// <summary>ETAPPE E9b: Trägt das DV-Entgelt ein gepflegtes Paar (1e−9-Regel)?</summary>
    public bool DvSzenarioGepflegt =>
        Szenariopaar.Gepflegt(Modell.DvEntgeltBest, Modell.DvEntgeltWorst, Modell.DvEntgelt ?? 0.0);

    /// <summary>ETAPPE E9b: Trägt der PPA-Preis ein gepflegtes Paar?</summary>
    public bool PpaSzenarioGepflegt =>
        Szenariopaar.Gepflegt(Modell.PpaPreisBest, Modell.PpaPreisWorst, Modell.PpaPreis ?? 0.0);

    private string PvSzenarioKurztext(string art) => art == PV_PPA
        ? Szenariopaar.Kurztext(Modell.PpaPreisBest, Modell.PpaPreisWorst, Modell.PpaPreis ?? 0.0, "ct/kWh", 2)
        : Szenariopaar.Kurztext(Modell.DvEntgeltBest, Modell.DvEntgeltWorst, Modell.DvEntgelt ?? 0.0, "ct/kWh", 2);

    /// <summary>
    /// ETAPPE E9b: die Kohärenzzeilen der zwei Paare — nur, was gepflegt ist und im Lauf
    /// nicht wirkt: die Vergütung ist nicht angewendet, oder die Vermarktungsform liest den
    /// Satz nicht (DV-Entgelt nur bei Marktprämie, PPA-Preis nur bei sonstiger
    /// Direktvermarktung).
    /// </summary>
    public IReadOnlyList<string> PvSzenarioZeilen
    {
        get
        {
            var liste = new List<string>();
            bool dv = DvSzenarioGepflegt, ppa = PpaSzenarioGepflegt;
            if (!dv && !ppa) return liste;
            if (!Modell.Aktiv)
            {
                liste.Add(_t.SzInaktiv);
                return liste;
            }
            if (dv && !IstMarktpraemie) liste.Add(_t.SzDvOhneWirkung);
            if (ppa && !IstPpa) liste.Add(_t.SzPpaOhneWirkung);
            return liste;
        }
    }

    /// <summary>
    /// ETAPPE E9b: „±" an DV-Entgelt bzw. PPA-Preis — der <c>CaseEingabeDialog</c> als
    /// Szenariopaar gegen den Wert des Feldes daneben (ct/kWh, zwei Stellen, Grenzen wie
    /// das Feld). Keine Warnung ohne Erwartet-Wert: Ein fehlender Satz ist hier keine
    /// Datenlücke. Die Kohärenzzeilen dieses Dialogs gehen mit hinein.
    /// </summary>
    private void PvSzenarioOeffnen(string art)
    {
        bool ppa = art == PV_PPA;
        string feld = ppa ? _t.SzPpa : _t.SzDv;
        _szenarioArt = ppa ? PV_PPA : PV_DV;
        _szenarioTitel = Szenariopaar.Titel(feld);
        _szenarioGaben = ppa
            ? Szenariopaar.Gaben(feld, feld, "ct/kWh", Modell.PpaPreis, Modell.PpaPreisBest,
                                 Modell.PpaPreisWorst, 2, 100, PvSzenarioZeilen, warnenOhneErwartet: false)
            : Szenariopaar.Gaben(feld, feld, "ct/kWh", Modell.DvEntgelt, Modell.DvEntgeltBest,
                                 Modell.DvEntgeltWorst, 2, 10, PvSzenarioZeilen, warnenOhneErwartet: false);
        _hinweis = ""; _fehler = "";
    }

    /// <summary>ETAPPE E9b: das Ergebnis auf das Modell — 0 heißt „wie Erwartet".
    /// Geschrieben wird mit „Übernehmen".</summary>
    private void PvSzenarioFertig(CaseEingabeErgebnis? ergebnis)
    {
        string art = _szenarioArt;
        _szenarioGaben = null;
        _szenarioArt = "";
        if (ergebnis is null) return;

        if (art == PV_PPA)
        {
            Modell.PpaPreisBest = Szenariopaar.Wert(ergebnis.BestCase);
            Modell.PpaPreisWorst = Szenariopaar.Wert(ergebnis.WorstCase);
        }
        else
        {
            Modell.DvEntgeltBest = Szenariopaar.Wert(ergebnis.BestCase);
            Modell.DvEntgeltWorst = Szenariopaar.Wert(ergebnis.WorstCase);
        }
    }

