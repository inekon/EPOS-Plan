@* Verwaltung Photovoltaik Module - der PROJEKTDIALOG (iU9-W6.5).

   VORBILD. Views/Photovoltaik/Form_PV (338 Z.). Dasselbe Muster wie Heizkessel, BHKW und
   Stromspeicher: links die Module im Projekt, rechts der Katalog, unten die Detailzeile
   „gewaehlter Satz". Die Projektzeile traegt drei eigene Werte - Neigung, Azimut und
   Anzahl Module - und ihre Straenge.

   KATALOGAUSWAHL V1, STUFE 3 (Konzept Projektdialoge mit Katalogauswahl 4.2, 4.6, 4.9):
   Summe kWp in der Projekt-Kopfleiste, Bearbeiten… und „In die Datenbank übernehmen…" im
   Projekt, Vergleichen…, Schloss…, Loeschen, Bearbeiten… im Katalogfuss (ohne Neu… - neu
   angelegt wird im Katalogeditor), beim Projektsatz Kosten, Stueckzahl, Neigung, Azimut,
   Albedo (Ertragsmodell) und die Ueberlagerung „Stränge und Wechselrichter…" (KA-E-11).

   DIE PROJEKTKOPIE. „In das Projekt übernehmen" legt sie ausserhalb des Assistenten sofort
   an (Muster BHKW, Projektkopievormerkung in der Huelle); Felder desselben Moduls teilen
   sich die Kopie gleichen Namens. Die Detailzeile des Projektsatzes liest sie ueber die
   Geraete-ID - der Name der Anlage darf vom Modul abweichen.

   DIE GESAMTLEISTUNG (W6-O-5) ist die Summe aus Anzahl Module mal Modulleistung [W] ueber
   alle Zeilen, in kW; die Komponente rechnet sie NICHT, sie zeigt, was die Huelle reicht.

   BEFUND A-5 bleibt behoben: Entfernt wird die ZEILE selbst, nicht ihr Index - im
   Assistenten fuehrt dieselbe Liste alle Erzeugertypen.

   TASTATUR wie in den uebrigen Erzeugerdialogen: Esc schliesst (zuerst die offene
   Ueberlagerung), Enter ist nicht belegt.

   ENTSCHEID #76 (05.09.2026). Die zwei Listen stehen im Baustein Zweispaltenauswahl - EIN
   Aufbau fuer alle Projekt/Datenbank-Dialoge des Hauses. *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Kosten
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* KONTEXT IM DIALOGKOPF (Katalogauswahl V1, 4.1 und 4.8). *@
    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <span class="epos-dialog-kontext" title="@KopfbandText">@KopfbandText</span>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="Abbrechen" />
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }
    @* KT-3: Wirft das Lesen der Katalogliste, nennt dieser Banner den Grund (Katalogladung). *@
    @if (!string.IsNullOrEmpty(_listeFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_listeFehler" />
    }
    @* KT-4: Wirft das Lesen des gewählten Satzes, nennt dieser Banner den Grund (Katalogladung.Satz). *@
    @if (!string.IsNullOrEmpty(_satzFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_satzFehler" />
    }

    @* P = Kopfleiste „Im Projekt" (Summe kWp, Bearbeiten…, In die Datenbank übernehmen…,
       Entfernen), K = Kopf- und Fussleiste des Katalogs, S = Detailzeile „gewaehlter Satz",
       D = Kopf und Fuss des Dialogs. Beide Listen fuehren eine Mehrfachwahl. *@
    <Zweispaltenauswahl Dialogname="Photovoltaik" LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                        KatalogZeile="@((int)Katalogliste.ZEILENHOEHE_ZEILENWAHL)"
                        UebernehmenText="@LabelHinzu"
                        UebernehmenGesperrt="@(KatalogZiele().Count == 0)" Uebernehmen="BeiHinzu"
                        EntfernenText="@LabelEntfernen"
                        EntfernenGesperrt="@(ProjektZiele().Count == 0)" Entfernen="BeiEntfernen"
                        ProjektWahl="@_projektWahl" ProjektSichtbar="@ProjektSchluessel()"
                        KatalogWahl="@_katalogWahl" KatalogSichtbar="@KatalogSichtbar()"
                        WahlGeaendert="BeiWahlGeaendert"
                        KatalogFussName="@_katalogZeile?.Bezeichner"
                        SatzArt="@SatzArt" SatzName="@SatzName" SatzKenndaten="@SatzKenndaten"
                        SatzNurLesen="@(!FelderSpeicherbar)" SatzUebernehmenGesperrt="@_feldFehler"
                        SatzFehler="@_satzUeberlagerungFehler" SatzVergroessert="BeiSatzVergroessert"
                        SatzUebernommen="BeiSatzUebernommen" SatzVerworfen="BeiSatzVerworfen"
                        @ref="_zweispalten">

        <ProjektKopf>
            @if (Gesamtleistung is not null)
            {
                <span class="epos-zweispalten-summe">@LabelSumme <b>@_gesamtleistung</b></span>
            }
        </ProjektKopf>

        <Leistenzusatz>
            @if (ProjektsatzWege is not null)
            {
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--bearbeiten-projekt"
                        title="@Resource.AUSWAHL_BTN_BEARBEITEN_PROJEKT_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiProjektBearbeiten">@Resource.AUSWAHL_BTN_BEARBEITEN</button>
            }
            @if (RueckwegWege is not null)
            {
                @* KA-E-9: der Rueckweg in die Datenbank, wirksam auf die Auswahl der Projektliste. *@
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--rueckweg"
                        title="@Resource.KATRUECK_BTN_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiRueckweg">@Resource.KATRUECK_BTN</button>
            }
        </Leistenzusatz>

        <Links>
            <Raster TZeile="ErzeugerZeile" Zeilen="@Zeilen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="ErzeugerZeile" Class="epos-spalte-kaestchen">
                        <HeaderTemplate>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" />
                        </HeaderTemplate>
                        <ChildContent>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" Schluessel="@Projektschluessel(context)"
                                           Kurztext="@context.Bezeichner" />
                        </ChildContent>
                    </TemplateColumn>
                    <TemplateColumn TGridItem="ErzeugerZeile" Title="@SpalteWahl">
                        <Zeilenwahl Gewaehlt="@(_projektZeile == context)" Kurztext="@SpalteWahl"
                                    Gewaehltwerden="() => ProjektZeileKlick(context)" />
                    </TemplateColumn>
                    <PropertyColumn TGridItem="ErzeugerZeile" TProp="string"
                                    Property="@(z => z.Bezeichner)" Title="@LabelProjektliste" />
                </KindInhalt>
            </Raster>
        </Links>

        <Rechts>
            @* DIE EINE KATALOGLISTE (W14a-E-10) im Kaestchenmodus: Die Zeile ist die Wahl
               (Detailzeile), das Kaestchen waehlt mehrere fuer die Bereichsaktionen. Der
               Hersteller ist eine Spalte mit Trichter - fuer die 20 749 Module des
               CEC-Katalogs der Unterschied zu einer Klappliste mit 258 Eintraegen. *@
            <Katalogliste @ref="_katalogliste" Profil="@Katalogprofil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_katalogGewaehlt" GewaehltChanged="KatalogZeileWaehlen"
                          Vergleichsparameter="@Vergleichsparameter"
                          ZeileIstWahl="true" Kaestchen="true" Gewaehlte="@_katalogKaestchen"
                          GewaehlteChanged="BeiKatalogKaestchen" Gefiltert="BeiGefiltert" />
        </Rechts>

        <KatalogFuss>
            <button type="button" class="epos-knopf epos-knopf--vergleichen"
                    title="@Resource.AUSWAHL_BTN_VERGLEICHEN_HINWEIS"
                    disabled="@(KatalogZiele().Count < 2)" @onclick="BeiVergleichen">@Resource.AUSWAHL_BTN_VERGLEICHEN</button>
            <Katalogschloss @ref="_katalogschloss" Weg="@Schloss" Zeile="@_katalogZeile"
                            Ungespeichert="@_felderGeaendert" JaText="@JaText" NeinText="@NeinText"
                            Geschaltet="BeiSchlossGeschaltet" Abgelehnt="BeiSchlossAbgelehnt" />
            @if (KatalogLoeschen is not null)
            {
                <button type="button" class="epos-knopf epos-knopf--loeschen" disabled="@(KatalogZiele().Count == 0)"
                        @onclick="BeiLoeschenGefragt">@BtnLoeschenText</button>
            }
            <button type="button" class="epos-knopf epos-knopf--bearbeiten-katalog"
                    title="@(KatalogZiele().Count > 0 && KatalogZiele().All(z => z.Geschuetzt) ? Resource.ADM_SCHLOSS_ERST_AUFHEBEN : Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS)"
                    disabled="@(KatalogZiele().Count == 0)" @onclick="BeiKatalogBearbeiten">@BtnBearbeitenText</button>
        </KatalogFuss>

        <Satz>
        @* DIE KNOPFZEILE DER SATZFLAECHE: beim Projektsatz die Kostenknoepfe (KA-E-12),
           rechts der Weg in die Wikirubriken Grundlagen und Berechnung (H13). *@
        <div class="epos-leiste">
            @if (!Wizard && _projektZeile is not null)
            {
                <KostenKnoepfeLeiste KostenOeffnen="@KostenLeiste" EnergiekostenOeffnen="@EnergieLeiste"
                                     InvestText="@KostenInvestText" BetriebText="@KostenBetriebText"
                                     EnergieText="@KostenEnergieText" />
            }
            <span class="epos-leiste-fueller"></span>
            <span class="epos-berechnungshilfe">
                <InfoKnopf Schluessel="Form_PV.Grundlagen"
                           StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
                <InfoKnopf Schluessel="Form_PV.Berechnung"
                           StandardKurztext="Berechnungsweg Photovoltaik" MitAssistent="false" />
            </span>
        </div>

        @if (_projektZeile is null && _katalogZeile is null)
        {
            <p class="epos-zweispalten-satzleer">@Resource.AUSWAHL_SATZ_LEER</p>
        }
        else
        {
            <Formularraster>
                <KindInhalt>
                <Textfeld Bezeichnung="@LabelName" Wert="@_detail.Bezeichner" NurLesen="true" />
                @foreach (var feld in _detail.Felder)
                {
                    <Textfeld Bezeichnung="@feld.Feld" Wert="@feld.Wert" NurLesen="true"
                              Kurz="@ErzeugerDetail.IstZahl(feld.Wert)" />
                }
                <Textfeld Bezeichnung="@LabelBeschreibung" Wert="@_detail.Beschreibung"
                          NurLesen="true" Mehrzeilig="true" Zeilen="2" />
                </KindInhalt>
            </Formularraster>

            @* DER PROJEKTSATZ (4.9): Stueckzahl, Neigung, Azimut und Energietraeger der Anlage,
               darunter das Ertragsmodell samt Albedo (PvModellFelder) und der Knopf zur
               Ueberlagerung „Stränge und Wechselrichter…" (KA-E-11). Der gestrichelte Rahmen
               sagt „diese Werte gehoeren zur markierten Anlage". *@
            @if (_projektZeile is not null)
            {
                <div class="epos-anlagenblock">
                    <Formularraster>
                        <KindInhalt>
                    <Ganzzahlfeld Bezeichnung="@LabelNeigung" Wert="@_projektZeile.Neigung"
                                  WertChanged="BeiNeigung" />
                    <Ganzzahlfeld Bezeichnung="@LabelAzimut" Wert="@_projektZeile.Azimut"
                                  WertChanged="BeiAzimut" />
                    @if (Traegerkatalog.Count > 0)
                    {
                        <EnergietraegerWahl Eintraege="@Traegerkatalog"
                                            LabelGruppe="@LabelTraegerGruppe" LabelArt="@LabelTraegerArt"
                                            Auswahl="@(_projektZeile.CarrierId > 0 ? _projektZeile.CarrierId : null)"
                                            AuswahlChanged="BeiTraegerwechsel" />
                    }
                    @* ANZAHL MODULE - abgeleitet, sobald ein Strang besteht (Q9, „eine
                       Wahrheit"): die Summe aus Reihe x Parallel ueber alle Straenge. *@
                    @if (_projektZeile.Straenge.Count > 0)
                    {
                        <Textfeld Bezeichnung="@LabelAnzahl" Wert="@ModulzahlText" NurLesen="true"
                                  Kurz="true" Einheit="@LabelAnzahlAbgeleitet" />
                    }
                    else
                    {
                        <Zahlenfeld Bezeichnung="@LabelAnzahl" Wert="@_projektZeile.AnzahlModule"
                                    WertChanged="BeiAnzahl" />
                    }
                        </KindInhalt>
                    </Formularraster>
                </div>
                <PvModellFelder Zeile="@_projektZeile"
                                Geaendert="@(() => Uebernehmen?.Invoke(_projektZeile!))" />
                <div class="epos-leiste epos-pv-straengeleiste">
                    <button type="button" class="epos-knopf epos-knopf--straenge"
                            @onclick="BeiStraengeOeffnen">@BtnStraengeText</button>
                    <span class="epos-pv-straengestand">@StraengeStand</span>
                </div>
            }

            @* ALLE DATEN DES GEWAEHLTEN SATZES, aufklappbar und BEARBEITBAR: beim Katalogsatz der
               Katalog (gesperrt nur lesen), beim Projektsatz die Projektkopie - dieselben Felder
               wie im Modulkatalog, dazu die Koeffizienten alpha_SC und beta_OC als Lesewerte. *@
            @if (AlleDatenDa)
            {
                <div class="epos-modulparameter">
                    <button type="button" class="epos-modulparameter-knopf"
                            aria-expanded="@(_parameterOffen ? "true" : "false")"
                            @onclick="ParameterUmschalten">
                        <span class="epos-modulparameter-pfeil" aria-hidden="true">@(_parameterOffen ? "▾" : "▸")</span>
                        <span>@LabelAlleParameter</span>
                    </button>

                    @if (_parameterOffen && _felder is not null)
                    {
                        @if (KatalogsatzGesperrt)
                        {
                            <p class="epos-satzbearbeitung-hinweis" role="note">@Resource.SATZBEARB_NUR_LESEN @Resource.ADM_SCHLOSS_ERST_AUFHEBEN</p>
                        }
                        <Katalogfelder Felder="@_felder" NurLesen="@(!FelderSpeicherbar)"
                                       Geaendert="FeldGeaendert"
                                       FehlerZustand="BeiFeldFehler" />

                        @* In der Satz-Ueberlagerung speichert ihr OK - kein zweiter Knopf. *@
                        @if (FelderSpeicherbar && !_satzGross)
                        {
                            <div class="epos-leiste">
                                <Speichervermerk @ref="_felderVermerk" Text="@BtnFelderSpeichernText"
                                                 Geaendert="@_felderGeaendert" Gesperrt="@_feldFehler"
                                                 Satz="@SatzName" Speichern="FelderSpeichern" />
                            </div>
                        }
                    }
                </div>
            }
        }
        </Satz>
    </Zweispaltenauswahl>

    @if (!Wizard)
    {
        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }

    @* --- Ueberlagerung 1: Stränge und Wechselrichter des Projektsatzes (KA-E-11) ----- *@
    @* Stufe S2 des Wechselrichterkonzepts (W6-E-2 und W6-E-3), in der Sache unveraendert:
       die zwei Optionen, die Strangtabelle mit der Ampel, der Vorschlag und, als
       Anlagenrueckfall, die fuenf Anlagenwerte. Die Hilfe zum Wechselrichter steht
       unmittelbar darueber (Konzept Technikdokumentation, Abschnitt 7). *@
    <Ueberlagerung Offen="@(_straengeOffen && _projektZeile is not null)"
                   Titel="@StraengeTitel" Kopfzusatz="@MarkeProjektsatz"
                   Geschlossen="BeiStraengeSchliessen">
        <KindInhalt>
            @if (_straengeOffen && _projektZeile is not null)
            {
                <div class="epos-berechnungshilfe">
                    <InfoKnopf Schluessel="Form_PV_Wechselrichter.btn_Help"
                               StandardKurztext="@Resource.HILFE_WECHSELRICHTER_KNOPF" />
                    <InfoKnopf Schluessel="Form_PV_Wechselrichter.Grundlagen"
                               StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
                </div>
                <PvStraengeFelder @ref="_straenge"
                                  Zeile="@_projektZeile"
                                  NeigungAnlage="@_projektZeile.Neigung"
                                  AzimutAnlage="@_projektZeile.Azimut"
                                  KwpAnlage="@KwpDer(_projektZeile)"
                                  Geraete="@Wechselrichter"
                                  GeraetUebernehmen="@WechselrichterUebernehmen"
                                  Hersteller="@WechselrichterHersteller"
                                  GeraeteFiltern="@WechselrichterFiltern"
                                  GeraeteBewerten="@WechselrichterBewerten"
                                  AuslegungVorschlagen="@AuslegungVorschlagen"
                                  WechselrichterVorschlagen="@WechselrichterVorschlagen"
                                  TrackerZahl="@Trackerzahl"
                                  Modulhersteller="@ModulherstellerDer(_projektZeile)"
                                  Module="@ProjektmoduleFuerStraenge()"
                                  ModulUebernehmen="@ModulUebernehmen"
                                  Pruefen="@StraengePruefen"
                                  TKalt="@_tKalt"
                                  THeiss="@_tHeiss"
                                  TKaltVorgabe="@AuslegungKaltVorgabe"
                                  THeissVorgabe="@AuslegungHeissVorgabe"
                                  TemperaturenSetzen="@TemperaturenWeg"
                                  TemperaturenVorschlagen="@Temperaturvorschlag"
                                  Geaendert="BeiStrangaenderung" />
                <div class="epos-leiste">
                    <span class="epos-leiste-fueller"></span>
                    <button type="button" class="epos-knopf" @onclick="BeiStraengeSchliessen">@OkText</button>
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 2: der Katalogeditor (ein ungesperrter Katalogsatz, KA-E-13) --- *@
    <Ueberlagerung Offen="@(_editorGaben is not null)" Schliessbar="false"
                   Titel="" Geschlossen="() => EditorFertig(null)">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                <ModulKatalogDialog @attributes="_editorGaben" Geschlossen="EditorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 3: Bearbeiten… je Bereich, auch mehrere Saetze (4.6) ---- *@
    <Ueberlagerung Offen="@(_bearbeitung is not null)"
                   Titel="@(_bearbeitung is null ? "" : Satzbearbeitungsregel.Titel(_bearbeitung.Value.Art, _bearbeitung.Value.Saetze))"
                   Kopfzusatz="@(_bearbeitung?.Art == Satzmarke.Projektsatz ? MarkeProjektsatz : MarkeKatalogsatz)"
                   Geschlossen="() => BearbeitungFertig(false)">
        <KindInhalt>
            @if (_bearbeitung is { } b)
            {
                <Satzbearbeitung Art="@b.Art" Saetze="@b.Saetze"
                                 Wege="@(b.Art == Satzmarke.Projektsatz ? ProjektsatzWege : KatalogsatzWege)"
                                 Geschlossen="BearbeitungFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 4: Rueckfrage „In die Datenbank übernehmen…" (5.2, KA-E-9) - immer vor dem Schreiben *@
    <Ueberlagerung Offen="@(_rueckweg is not null)"
                   Titel="@(_rueckweg is null ? "" : Rueckwegregel.Titel(_rueckweg))"
                   Kopfzusatz="@MarkeKatalogsatz" Geschlossen="() => RueckwegFertig(null)">
        <KindInhalt>
            @if (_rueckweg is not null && RueckwegWege is not null)
            {
                <Rueckwegfrage Zeilen="@_rueckweg" Wege="@RueckwegWege" BleibtText="@RueckwegBleibtText"
                               Geschlossen="RueckwegFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Rueckfrage vor dem Loeschen aus dem KATALOG ------------------------- *@
    <Rueckfrage Offen="@_loeschfrage" TitelText="@TitelLoeschen" JaText="@JaText" NeinText="@NeinText"
                Frage="@LoeschfrageText" Beantwortet="BeiLoeschfrage" />
</div>

@code {
    /// <summary>Die Zeilen der linken Liste — sie gehört der Hülle und wird in place bearbeitet.</summary>
    [Parameter] public List<ErzeugerZeile> Zeilen { get; set; } = new();

    /// <summary>
    /// <b>Die Spalten der Katalogliste</b> — <c>Katalogfilterprofil.MitVerwendung(
    /// Anlagenart.Photovoltaik, uebersetzer)</c>.
    /// </summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }
    /// <summary>
    /// <b>Die Zeilen des VERGLEICHS</b> (Frage <b>Q3</b>, Stufe S3.3) — derselbe Weg,
    /// aus dem die Parameterübersicht (W14a‑E‑8) ihre Zeilen holt. Ohne ihn
    /// vergleicht die <c>Katalogliste</c> ihre eigenen Spalten.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Vergleichsparameter { get; set; }


    /// <summary>
    /// Die Zeilen des Katalogs, UNGEFILTERT —
    /// <c>PhotovoltaikStammCtrl.Katalogfilterzeilen()</c>. Für die 20 749 Module
    /// heißt das: Das Raster bekommt nach dem Filtern wenige Zeilen und
    /// virtualisiert gar nicht mehr — den Übergang deckt der <c>@@key</c>-Fix
    /// W6‑B‑2 ab (Konzept 5.6.6).
    /// </summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste; sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>
    /// <b>Ein eigener Filterstand statt des Registers</b> — dasselbe Muster wie
    /// <c>ProfilVorgabe</c>. Ohne ihn holt der Dialog seinen Stand aus dem
    /// <c>Katalogfilterregister</c> (S2.5: je Katalog EINER, für die Sitzung,
    /// gemeinsam mit den anderen Dialogen desselben Katalogs). Ein Prüfstand gibt
    /// hier seinen eigenen herein und bleibt damit von den anderen Fällen getrennt;
    /// dass das Register wirklich teilt, prüft <c>KatalogfilterstandTests</c>.
    /// </summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }


    /// <summary>Der Detailblock eines KATALOGsatzes nach Namen; ohne <see cref="ProjektDetail"/> auch der der Projektzeile.</summary>
    [Parameter] public Func<string, ErzeugerDetail?>? Detail { get; set; }

    /// <summary>
    /// Der Detailblock einer Projektzeile — aus der Projektkopie über die Geräte-ID (im Assistenten aus dem
    /// Katalog). Die Zeile, nicht ihr Name: Der Name der Anlage darf vom Modul abweichen.
    /// </summary>
    [Parameter] public Func<ErzeugerZeile, ErzeugerDetail?>? ProjektDetail { get; set; }

    /// <summary>
    /// Der Name des MODULS einer Projektzeile (der Projektkopie, er ist der des Katalogsatzes) — das Band der
    /// Strangtabelle zum Katalog, wenn die Zeile die Projektkopie trägt. <c>null</c> = der Name der Zeile.
    /// </summary>
    [Parameter] public Func<ErzeugerZeile, string>? Modulname { get; set; }

    /// <summary>
