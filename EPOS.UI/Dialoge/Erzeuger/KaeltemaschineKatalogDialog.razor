@* Die Verwaltung "Kaeltemaschinen" (KU3-1, Teil 2) - der Katalog Tab_Kaeltemaschine_STAMM samt
   Kennlinie.

   GERUEST DER VERWALTUNGEN (Vorbild BaustoffKatalogDialog): Katalograhmen, Katalogliste mit
   ZeileIstWahl, Auswahlleiste, Stammblatt, Fussleiste Speichern - Verwerfen - Status - Neu... -
   Beenden. Eine freie Ansicht der AppWurzel auf beiden Plattformen; die Datenseite liegt in der
   Huelle (EPOS.UI.Daten, KaeltemaschineKatalogHuelle) ueber KaeltemaschineStammCtrl.

   DIE LISTE: Bezeichner, Hersteller, Typ, Nennkaelteleistung, Nenn-EER, Rueckkuehlung - Profil und
   Zeilen aus dem Kern (Katalogfilterprofil.Finde(Anlagenart.Kaeltemaschine),
   KaeltemaschineStammCtrl.Katalogfilterzeilen); das Schloss steht hinter dem Bezeichner.

   DAS STAMMBLATT: zwei Gruppen - Kenndaten und Kennlinie. Die Rueckkuehlart ist eine Auswahl ueber
   den LISTENPLATZ; der Anzeigetext ist nie ein Steuerwert. Die Kennlinie ist ein Zeilenraster
   (Rueckkuehltemperatur, Kaltwassertemperatur, EER, Kaelteleistung; Punkt hinzufuegen, entfernen).
   Ein Auslieferungssatz steht als Text. Geschrieben wird allein mit "Speichern" - Kopf und
   Kennlinie in EINEM Vorgang, die Pruefregeln des Kerns (KaeltemaschineStammCtrl.Pruefen, darunter
   das Temperaturpaar je Geraet eindeutig) genau dort.

   TASTATUR: Esc schliesst stufenweise (Ueberlagerung, Rueckfrage, schmales Blatt, Dialog). *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-katalog-dialog epos-kaeltemaschine-admin" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@Texte.Titel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="Schliessen" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_meldung" />
    }
    @if (_katalog.Count == 0)
    {
        <p class="epos-leisezeile epos-kaeltemaschine-leer">@Texte.LeerKatalog</p>
    }

    <Katalograhmen BlattOffen="@_auswahl.BlattOffen">
        <Liste>
            <Katalogliste Profil="@Profil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_gewaehlt" GewaehltChanged="BeiZeile" ZeileIstWahl="true"
                          Kaestchen="true" Gewaehlte="@_auswahl.Gewaehlte"
                          GewaehlteChanged="BeiKaestchen" />
        </Liste>

        <Auswahl>
            <Auswahlleiste Fokus="@Fokusname" Anzahl="@_auswahl.Anzahl"
                           Handlungen="@Handlungen()"
                           Aufheben="BeiAufheben" Gesperrt="Warnen"
                           Stammblatt="@BlattOeffnenWeg" />
        </Auswahl>

        <Blatt>
            <Stammblatt Name="@_daten.Bezeichner" Unterzeile="@Unterzeile"
                        Auslieferung="@_auslieferung" SchlossText="@Filtertexte.Schloss"
                        Entsperrt="@(!_auslieferung && _schloss.Entsperrt(ZeileZu(_gewaehlt)))"
                        Kennzahlen="@Kennzahlen" Hinweis="@Aenderungshinweis"
                        ZurListe="@_blattSchliessen"
                        Vergleichskoepfe="@(_auswahl.Vergleich ? _vergleichskoepfe : null)"
                        Vergleichszeilen="@(_auswahl.Vergleich ? _vergleichszeilen : null)"
                        VergleichZurueck="BeiVergleichZurueck">
                <Gruppen>
                    @* KENNDATEN: direkt bedienbar; ein Auslieferungssatz als TEXT. *@
                    <Stammblattgruppe Titel="@Texte.GruppeKenndaten" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Kenndatenwerte(_daten) : null)">
                        <KindInhalt>
                            @Kenndatenfelder(_arbeit)
                        </KindInhalt>
                    </Stammblattgruppe>

                    @* KENNLINIE: ein Zeilenraster; ein Auslieferungssatz als TEXT. *@
                    <Stammblattgruppe Titel="@Texte.GruppeKennlinie" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Kennlinienwerte(_daten) : null)">
                        <KindInhalt>
                            @Kennlinienfelder(_arbeit)
                        </KindInhalt>
                    </Stammblattgruppe>
                </Gruppen>
            </Stammblatt>
        </Blatt>
    </Katalograhmen>

    @* DIE FUSSLEISTE DER VERWALTUNG (V15): Speichern - Verwerfen - Fueller (Statuszeile) -
       Neu... - Beenden. Duplizieren..., Schloss und Loeschen stehen in der Auswahlleiste. *@
    <div class="epos-leiste">
        @if (Speichern is not null)
        {
            @if (_auslieferung)
            {
                <button type="button" class="epos-knopf" aria-disabled="true"
                        title="@Texte.SpeichernGesperrt" @onclick="BeiSpeichern">@Texte.KnopfSpeichern</button>
            }
            else
            {
                <button type="button" class="epos-knopf" disabled="@(!_geaendert)"
                        @onclick="BeiSpeichern">@Texte.KnopfSpeichern</button>
            }
            <button type="button" class="epos-knopf" disabled="@(!_geaendert)"
                    @onclick="BeiVerwerfen">@Texte.KnopfVerwerfen</button>
        }
        <span class="epos-leiste-fueller epos-status@(_statusFehler ? " epos-status--fehler" : "")" role="status">@_status</span>
        @if (Speichern is not null)
        {
            <button type="button" class="epos-knopf" @onclick="BeiNeu">@Texte.KnopfNeu</button>
        }
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="Schliessen">@Texte.KnopfBeenden</button>
    </div>

    @* --- "Neu...": dieselben Kenndaten, OK prueft und legt an; die Kennlinie folgt im Blatt --- *@
    <Ueberlagerung Offen="@_neuOffen" Titel="@Texte.TitelNeu" Geschlossen="NeuSchliessen">
        <KindInhalt>
            @if (_neuOffen)
            {
                <div class="epos-kaeltemaschine-neu">
                    @if (_neuMeldung.Length > 0)
                    {
                        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_neuMeldung" />
                    }
                    @Kenndatenfelder(_neu)
                    <SpeichernLeiste OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen" Ergebnis="NeuErgebnis" />
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Namensabfrage von "Duplizieren..." (AD-Q11): Vorbelegung "... (Kopie)" -------- *@
    <Ueberlagerung Offen="@_duplizierfrage" Titel="@Texte.KnopfDuplizieren"
                   Geschlossen="() => _duplizierfrage = false">
        <KindInhalt>
            @if (_duplizierfrage)
            {
                <NamensDialog TitelText="" FrageText="@Texte.LabelBezeichner"
                              Vorbelegung="@_kopievorschlag"
                              MeldungLeer="@Texte.NameLeer" Pruefung="NameBelegt"
                              OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen"
                              Geschlossen="BeiDuplizierName" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Rueckfrage Offen="@_loeschfrage" TitelText="@Texte.KnopfLoeschen"
                Frage="@_loeschfrageText"
                JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiLoeschfrage" />

    @* --- Rueckfrage vor dem Umschalten des Schlosses (AD-Q15, Vorgabe Nein) *@
    <Rueckfrage Offen="@_schloss.FrageOffen" TitelText="@_schloss.Titel" Frage="@_schloss.Frage"
                VorgabeNein="true" JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiSchlossAntwort" />
</div>

@code {
    // =====================================================================
    // Gaben — die Datenseite liegt in der Hülle (KaeltemaschineKatalogHuelle)
    // =====================================================================

    /// <summary>Die Zeilen der Liste (<c>KaeltemaschineStammCtrl.Katalogfilterzeilen</c>); ohne sie ist die Liste leer.</summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    /// <summary>Die Spalten — <c>Katalogfilterprofil.Finde(Anlagenart.Kaeltemaschine)</c>; ohne sie das Profil mit den Ressourcentexten.</summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste — sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Ein eigener Filterstand statt des Registers (Muster der Verwaltungen).</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>
    /// Die Anzeigetexte der Rückkühlarten in der Reihenfolge der Listenplätze (aus dem Kern); ohne sie die
    /// Texte des Bündels. Der Listenplatz ist der Steuerwert.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? Rueckkuehlarten { get; set; }

    /// <summary>Lädt eine Kältemaschine samt Kennlinie über ihre Id; <c>null</c> = es gibt sie nicht (mehr).</summary>
    [Parameter] public Func<int, KaeltemaschineDaten?>? Lies { get; set; }

    /// <summary>
    /// Die Prüfung des Kerns (<c>KaeltemaschineStammCtrl.Pruefen</c>) — <c>null</c> oder leer = gültig.
    /// Gerufen genau einmal, im Speicherweg (Stammblatt und „Neu…"), und vom Assistenten.
    /// </summary>
    [Parameter] public Func<KaeltemaschineDaten, string?>? Pruefen { get; set; }

    /// <summary>Schreibt einen Satz samt Kennlinie — Id 0 legt an. Ohne ihn weder „Speichern" noch „Neu…".</summary>
    [Parameter] public Func<KaeltemaschineDaten, KaeltemaschineSpeicherErgebnis>? Speichern { get; set; }

    /// <summary>Löscht einen Satz (<c>KaeltemaschineStammCtrl.Loeschen</c>); ohne ihn keine Handlung.</summary>
    [Parameter] public Func<int, KaeltemaschineSpeicherErgebnis>? Loeschen { get; set; }

    /// <summary>„Duplizieren…" (<c>KaeltemaschineStammCtrl.Duplizieren</c>); ohne ihn keine Handlung.</summary>
    [Parameter] public Func<int, string, KaeltemaschineSpeicherErgebnis>? Duplizieren { get; set; }

    /// <summary>„Schloss setzen…" / „Schloss aufheben…" (AD-Q15, <c>KaeltemaschineStammCtrl.SchlossSetzen</c>).</summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    /// <summary>Der Dialog wurde geschlossen („Beenden", Esc, Kreuz) — immer <c>true</c>.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    /// <summary>Die Anzeigetexte (ein Bündel).</summary>
    [Parameter] public KaeltemaschineKatalogTexte Texte { get; set; } = new();

    /// <summary>Der Titel im Dialogkopf; leer = eingebettet, die Überlagerung des Wirts trägt Titel und Kreuz.</summary>
    [Parameter] public string TitelText { get; set; } = Resource.KM_TITEL;

    /// <summary>Schlüssel des Hilfeknopfes — die Hilfeseite folgt mit dem Wiki (KU3-4).</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "KaeltemaschineKatalog.btn_Help";

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private Katalogfilterprofil? _profil;
    private IReadOnlyList<Katalogfilterzeile> _katalog = Array.Empty<Katalogfilterzeile>();
    private Katalogfilterstand _filterstand = new();
    private string _gewaehlt = "";
    private bool _auslieferung;

    /// <summary>Der GESPEICHERTE Stand des gewählten Satzes.</summary>
    private KaeltemaschineDaten _daten = new();

    /// <summary>Der ARBEITSSTAND des Stammblatts — die Felder schreiben hierhin, „Speichern" schreibt ihn.</summary>
    private KaeltemaschineDaten _arbeit = new();
    private bool _geaendert;

    private bool _neuOffen;
    private KaeltemaschineDaten _neu = new();
    private string _neuMeldung = "";

    private bool _duplizierfrage;
    private string _kopievorschlag = "";
    private string _duplizierQuelle = "";

    private bool _loeschfrage;
    private string _loeschfrageText = "";
    private List<string> _loeschziele = new();
    private int _loeschBleiben;

    private readonly Zeilenauswahl _auswahl = new();
    private IReadOnlyList<string>? _vergleichskoepfe;
    private IReadOnlyList<Vergleichszeile>? _vergleichszeilen;

    private string _meldung = "";

    /// <summary>Die Statuszeile der Fußleiste; rot färbt allein <see cref="SpeichernAbgelehnt"/>.</summary>
    private string _status
    {
        get => _statusText;
        set { _statusText = value; _statusFehler = false; }
    }
    private string _statusText = "";
    private bool _statusFehler;

    private EventCallback _vergleichen;
    private EventCallback _duplizieren;
    private EventCallback _schlossHandlung;
    private EventCallback _loeschen;
    private readonly Schlossumschaltung _schloss = new();
    private EventCallback _blattOeffnen;
    private EventCallback _blattSchliessen;

    // ---- Prüfhilfen für die Tests ---------------------------------------
    /// <summary>Die Namen der Liste in Listenreihenfolge (Prüfhilfe).</summary>
    public IReadOnlyList<string> Namensliste => _katalog.Select(z => z.Bezeichner).ToList();
    /// <summary>Der Schlüssel (die Id) der gewählten Zeile (Prüfhilfe).</summary>
    public string Gewaehlt => _gewaehlt;
    /// <summary>Der Arbeitsstand des Stammblatts (Prüfhilfe).</summary>
    public KaeltemaschineDaten Arbeitsstand => _arbeit;
    /// <summary>Die stehende Meldung (Prüfhilfe).</summary>
    public string Meldung => _meldung;
    /// <summary>Die Statuszeile der Fußleiste (Prüfhilfe).</summary>
    public string Status => _status;
    /// <summary>Trägt das Stammblatt geänderte Werte? (Prüfhilfe)</summary>
    public bool Geaendert => _geaendert;
    /// <summary>Ist der gewählte Satz ein Auslieferungssatz? (Prüfhilfe)</summary>
    public bool Auslieferung => _auslieferung;
    /// <summary>Steht die Überlagerung „Neu…"? (Prüfhilfe)</summary>
    public bool NeuOffen => _neuOffen;
    /// <summary>Steht die Löschrückfrage? (Prüfhilfe)</summary>
    public bool Loeschfrage => _loeschfrage;
    /// <summary>Steht die Namensabfrage von „Duplizieren…"? (Prüfhilfe)</summary>
    public bool Duplizierfrage => _duplizierfrage;
    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe)</summary>
    public bool Schlossfrage => _schloss.FrageOffen;

    private Katalogfilterprofil Profil
        => _profil ??= Katalogprofil
                       ?? Katalogfilterprofil.Finde(Anlagenart.Kaeltemaschine, s => Resource.ResourceManager.GetString(s) ?? s);

    /// <summary>Die Anzeigetexte der Rückkühlarten — aus der Hülle, sonst aus dem Bündel.</summary>
    private IReadOnlyList<string> Rueckkuehltexte => Rueckkuehlarten ?? Texte.Rueckkuehlarten;

    // =====================================================================
    // Aufbau
    // =====================================================================

    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _duplizieren = EventCallback.Factory.Create(this, BeiDuplizieren);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _loeschen = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Profil.Schluessel);
        ListeLaden();

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.KAELTEMASCHINE_KATALOG, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =====================================================================
    // Der Hilfe-Assistent
    // =====================================================================

    private KiMaskenanmeldung? _kiMaske;
    private KaeltemaschineKatalogKiSicht? _kiSicht;

    /// <summary>Die Sicht des Assistenten: Die Satzwahl nimmt den Weg eines Klicks, die Felder den Arbeitsstand.</summary>
    private KaeltemaschineKatalogKiSicht KiSicht()
    {
        return _kiSicht ??= new KaeltemaschineKatalogKiSicht
        {
            SatzLesen = () => _gewaehlt,
            SatzSetzen = BeiZeile,
            SatzEintraege = () => KiMaskenanmeldung.Eintraege(_katalog, z => z.Schluessel, z => z.Bezeichner),
            Rueckkuehlarten = () => Rueckkuehltexte,
            ArbeitLesen = () => _daten.Id > 0 && !_auslieferung ? _arbeit : null,
            Geaendert = Nachziehen
        };
    }

    /// <summary>„Speichern" ist der Weg des Knopfes, die Prüfung dieselbe; der Schreibschutz ist der des Satzes.</summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _auslieferung,
        Schreibschutzgrund = () => Texte.SpeichernGesperrt,
        Pruefen = () => Pruefbefund(_arbeit) ?? "",
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (Speichern is null || _daten.Id <= 0)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", Texte.Titel));
        if (_auslieferung) return KiKern.KiErgebnis.Abgelehnt(Texte.SpeichernGesperrt);
        if (!_geaendert) return KiKern.KiErgebnis.Ok(_daten.Bezeichner, anzahl: 0);

        BeiSpeichern();
        return _meldung.Length > 0
                   ? KiKern.KiErgebnis.Abgelehnt(_meldung)
                   : KiKern.KiErgebnis.Ok(_daten.Bezeichner, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    // =====================================================================
    // Liste und Wahl
    // =====================================================================

    /// <summary>Lädt die Liste; die bisherige Wahl bleibt, sonst die erste Zeile.</summary>
    private void ListeLaden(string? wunsch = null)
    {
        _katalog = Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();

        _auswahl.Abgleichen(_katalog.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        string ziel = wunsch ?? _gewaehlt;
        if (_katalog.Count == 0) { SatzWaehlen(""); return; }
        SatzWaehlen(_katalog.Any(z => z.Schluessel == ziel) ? ziel : _katalog[0].Schluessel);
    }

    /// <summary>Die Liste meldet eine Zeile. Geänderte Werte halten die Wahl (Konzept 3.3).</summary>
    private void BeiZeile(string schluessel)
    {
        if (_geaendert && schluessel != _gewaehlt)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return;
        }
        SatzWaehlen(schluessel);
    }

    private void SatzWaehlen(string schluessel)
    {
        _meldung = "";
        _gewaehlt = schluessel ?? "";
        Katalogfilterzeile? zeile = ZeileZu(_gewaehlt);
        KaeltemaschineDaten? gelesen = zeile is not null ? Lies?.Invoke(zeile.Id) : null;
        _daten = gelesen ?? (zeile is null ? new KaeltemaschineDaten() : new KaeltemaschineDaten { Id = zeile.Id, Bezeichner = zeile.Bezeichner });
        _auslieferung = zeile?.Geschuetzt == true || _daten.Auslieferung;
        Zuruecksetzen();
    }

    /// <summary>Der Arbeitsstand wird wieder der gespeicherte (Wahl, Verwerfen, nach dem Speichern).</summary>
    private void Zuruecksetzen()
    {
        _arbeit = _daten.Kopie();
        _geaendert = false;
    }

    private Katalogfilterzeile? ZeileZu(string schluessel) => _katalog.FirstOrDefault(z => z.Schluessel == schluessel);

    private string Fokusname => ZeileZu(_gewaehlt)?.Bezeichner ?? "";

    // =====================================================================
    // Stammblatt
    // =====================================================================

    /// <summary>Die Einträge der Rückkühlart: Listenplatz → Anzeigetext.</summary>
    private IReadOnlyList<(int Id, string Text)> Rueckkuehleintraege
        => Rueckkuehltexte.Select((t, i) => (i, t)).ToList();

    private string RueckkuehlText(int? platz)
        => platz is int p && p >= 0 && p < Rueckkuehltexte.Count ? Rueckkuehltexte[p] : "";

    /// <summary>Die zwölf Kenndaten als Felder — im Stammblatt und in „Neu…" dieselben.</summary>
    private RenderFragment Kenndatenfelder(KaeltemaschineDaten d) => __builder =>
    {
        <Formularraster>
            <KindInhalt>
                <Textfeld Bezeichnung="@Texte.LabelBezeichner" Wert="@d.Bezeichner"
                          WertChanged="w => Feld(d, () => d.Bezeichner = w ?? string.Empty)" />
                <Textfeld Bezeichnung="@Texte.LabelFirma" Wert="@d.Firma"
                          WertChanged="w => Feld(d, () => d.Firma = w ?? string.Empty)" />
                <Textfeld Bezeichnung="@Texte.LabelTyp" Wert="@d.Typ"
                          WertChanged="w => Feld(d, () => d.Typ = w ?? string.Empty)" />
                <Textfeld Bezeichnung="@Texte.LabelBeschreibung" Wert="@d.Beschreibung"
                          WertChanged="w => Feld(d, () => d.Beschreibung = w ?? string.Empty)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelNennkaelteleistung" Einheit="@Texte.EinheitKw"
                            Feldname="@Texte.LabelNennkaelteleistung"
                            Wert="@d.Nennkaelteleistung" WertChanged="w => Feld(d, () => d.Nennkaelteleistung = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelNennEer" Feldname="@Texte.LabelNennEer"
                            Wert="@d.NennEer" WertChanged="w => Feld(d, () => d.NennEer = w)" />
                <Textfeld Bezeichnung="@Texte.LabelKaeltemittel" Wert="@d.Kaeltemittel"
                          WertChanged="w => Feld(d, () => d.Kaeltemittel = w ?? string.Empty)" />
                <Auswahlfeld Bezeichnung="@Texte.LabelRueckkuehlart" Eintraege="@Rueckkuehleintraege"
                             Platzhalter="@Texte.RueckkuehlartKeine"
                             Auswahl="@d.RueckkuehlartIndex" AuswahlChanged="w => Feld(d, () => d.RueckkuehlartIndex = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelMindestteillast" Einheit="@Texte.EinheitProzent"
                            Feldname="@Texte.LabelMindestteillast"
                            Wert="@d.Mindestteillast" WertChanged="w => Feld(d, () => d.Mindestteillast = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelHilfsstrom" Einheit="@Texte.EinheitKw"
                            Feldname="@Texte.LabelHilfsstrom" Platzhalter="@Texte.HilfsstromLeer"
                            Wert="@d.Hilfsstrom" WertChanged="w => Feld(d, () => d.Hilfsstrom = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelKaltwasserMin" Einheit="@Texte.EinheitGradC"
                            Feldname="@Texte.LabelKaltwasserMin"
                            Wert="@d.KaltwasserMin" WertChanged="w => Feld(d, () => d.KaltwasserMin = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelModulkosten" Einheit="@Texte.EinheitEuro"
                            Feldname="@Texte.LabelModulkosten"
                            Wert="@d.Modulkosten" WertChanged="w => Feld(d, () => d.Modulkosten = w)" />
            </KindInhalt>
        </Formularraster>
    };

    /// <summary>Die Kennlinie als Zeilenraster: vier Zahlen je Punkt, Entfernen je Zeile, Hinzufügen darunter.</summary>
    private RenderFragment Kennlinienfelder(KaeltemaschineDaten d) => __builder =>
    {
        <Zeilenraster Bezeichnung="@Texte.KennlinieRaster" Spalten="@KennlinienSpalten"
                      Spaltenmass="minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) auto">
            <KindInhalt>
                @for (int i = 0; i < d.Kennlinie.Count; i++)
                {
                    int index = i;
                    KaeltemaschinePunktDaten p = d.Kennlinie[index];
                    string nummer = string.Format(CultureInfo.CurrentCulture, Texte.Punkt, index + 1);
                    <div class="epos-zr-zeile epos-kaeltemaschine-punkt" role="row" @key="p">
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Rueckkuehltemperatur" Titel="@(nummer + " – " + Texte.SpalteRueckkuehltemperatur)"
                                        Feldname="@(nummer + " – " + Texte.SpalteRueckkuehltemperatur)"
                                        WertChanged="w => Punktfeld(() => p.Rueckkuehltemperatur = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Kaltwassertemperatur" Titel="@(nummer + " – " + Texte.SpalteKaltwassertemperatur)"
                                        Feldname="@(nummer + " – " + Texte.SpalteKaltwassertemperatur)"
                                        WertChanged="w => Punktfeld(() => p.Kaltwassertemperatur = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Eer" Titel="@(nummer + " – " + Texte.SpalteEer)"
                                        Feldname="@(nummer + " – " + Texte.SpalteEer)"
                                        WertChanged="w => Punktfeld(() => p.Eer = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Kaelteleistung" Titel="@(nummer + " – " + Texte.SpalteKaelteleistung)"
                                        Feldname="@(nummer + " – " + Texte.SpalteKaelteleistung)"
                                        WertChanged="w => Punktfeld(() => p.Kaelteleistung = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <span class="epos-zr-aktionen">
                                <button type="button" class="epos-knopf epos-zr-knopf" title="@Texte.PunktEntfernen"
                                        aria-label="@(nummer + " – " + Texte.PunktEntfernen)"
                                        @onclick="() => PunktEntfernen(index)"><span aria-hidden="true">✕</span></button>
                            </span>
                        </div>
                    </div>
                }
            </KindInhalt>
            <AbschlussZeile>
                <div class="epos-zr-neuzeile epos-kaeltemaschine-punkt-neu" role="row">
                    @if (d.Kennlinie.Count == 0)
                    {
                        <p class="epos-leisezeile">@Texte.KennlinieLeer</p>
                    }
                    <button type="button" class="epos-textknopf" @onclick="PunktAnlegen">@Texte.PunktNeu</button>
                </div>
            </AbschlussZeile>
        </Zeilenraster>
    };

    private IReadOnlyList<string> KennlinienSpalten => new[]
    {
        Texte.SpalteRueckkuehltemperatur + " [" + Texte.EinheitGradC + "]",
        Texte.SpalteKaltwassertemperatur + " [" + Texte.EinheitGradC + "]",
        Texte.SpalteEer,
        Texte.SpalteKaelteleistung + " [" + Texte.EinheitKw + "]",
        ""
    };

    /// <summary>Eine Eingabe in ein Feld — im Stammblatt zieht sie „geändert" nach, in „Neu…" nicht.</summary>
    private void Feld(KaeltemaschineDaten d, Action schritt)
    {
        if (ReferenceEquals(d, _arbeit) && _auslieferung) return;
        schritt();
        if (ReferenceEquals(d, _arbeit)) Nachziehen();
        else _neuMeldung = "";
    }

    private void Punktfeld(Action schritt)
    {
        if (_auslieferung) return;
        schritt();
        Nachziehen();
    }

    private void PunktAnlegen()
    {
        if (_auslieferung || _daten.Id <= 0) return;
        _arbeit.Kennlinie.Add(new KaeltemaschinePunktDaten());
        Nachziehen();
    }

    private void PunktEntfernen(int index)
    {
        if (_auslieferung || index < 0 || index >= _arbeit.Kennlinie.Count) return;
        _arbeit.Kennlinie.RemoveAt(index);
        Nachziehen();
    }

    private void Nachziehen()
    {
        _geaendert = _arbeit.Abweichungen(_daten) > 0;
        _meldung = "";
        _status = "";
    }

    /// <summary>„Hersteller · Luftgekühlt · Auslieferungssatz".</summary>
    private string Unterzeile
    {
        get
        {
            if (_daten.Bezeichner.Length == 0) return "";
            var teile = new List<string>(3);
            if (_daten.Firma.Length > 0) teile.Add(_daten.Firma);
            string art = RueckkuehlText(_daten.RueckkuehlartIndex);
            if (art.Length > 0) teile.Add(art);
            teile.Add(_auslieferung ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ);
            return string.Join(" · ", teile);
        }
    }

    /// <summary>Nennkälteleistung, Nenn-EER und die Zahl der Kennlinienpunkte des gespeicherten Standes.</summary>
    private IReadOnlyList<Stammblattkennzahl> Kennzahlen
    {
        get
        {
            if (_daten.Bezeichner.Length == 0) return Array.Empty<Stammblattkennzahl>();
            return new[]
            {
                new Stammblattkennzahl(Zahl(_daten.Nennkaelteleistung, "0.#", Texte.EinheitKw), Texte.LabelNennkaelteleistung),
                new Stammblattkennzahl(Zahl(_daten.NennEer, "0.0#", ""), Texte.LabelNennEer),
                new Stammblattkennzahl(_daten.Kennlinie.Count.ToString(CultureInfo.CurrentCulture), Texte.GruppeKennlinie)
            };
        }
    }

    private static string Zahl(double? wert, string format, string einheit)
        => wert.HasValue ? (wert.Value.ToString(format, CultureInfo.CurrentCulture) + " " + einheit).Trim() : "–";

    private IReadOnlyList<Stammblattwert> Kenndatenwerte(KaeltemaschineDaten d) => new[]
    {
        new Stammblattwert(Texte.LabelBezeichner, d.Bezeichner),
        new Stammblattwert(Texte.LabelFirma, d.Firma),
        new Stammblattwert(Texte.LabelTyp, d.Typ),
        new Stammblattwert(Texte.LabelBeschreibung, d.Beschreibung),
        new Stammblattwert(Texte.LabelNennkaelteleistung, Zahl(d.Nennkaelteleistung, "0.###", ""), d.Nennkaelteleistung.HasValue ? Texte.EinheitKw : ""),
        new Stammblattwert(Texte.LabelNennEer, Zahl(d.NennEer, "0.0##", "")),
        new Stammblattwert(Texte.LabelKaeltemittel, d.Kaeltemittel),
        new Stammblattwert(Texte.LabelRueckkuehlart, d.RueckkuehlartIndex.HasValue ? RueckkuehlText(d.RueckkuehlartIndex) : Texte.RueckkuehlartKeine),
        new Stammblattwert(Texte.LabelMindestteillast, Zahl(d.Mindestteillast, "0.#", ""), d.Mindestteillast.HasValue ? Texte.EinheitProzent : ""),
        new Stammblattwert(Texte.LabelHilfsstrom, d.Hilfsstrom.HasValue ? Zahl(d.Hilfsstrom, "0.###", "") : Texte.HilfsstromLeer,
                           d.Hilfsstrom.HasValue ? Texte.EinheitKw : ""),
        new Stammblattwert(Texte.LabelKaltwasserMin, Zahl(d.KaltwasserMin, "0.#", ""), d.KaltwasserMin.HasValue ? Texte.EinheitGradC : ""),
        new Stammblattwert(Texte.LabelModulkosten, Zahl(d.Modulkosten, "#,##0.##", ""), d.Modulkosten.HasValue ? Texte.EinheitEuro : "")
    };

    /// <summary>Die Kennlinie als Text — je Punkt „35 °C / 7 °C" → „EER 3,6 · 98 kW".</summary>
    private IReadOnlyList<Stammblattwert> Kennlinienwerte(KaeltemaschineDaten d)
    {
        if (d.Kennlinie.Count == 0) return new[] { new Stammblattwert(Texte.GruppeKennlinie, Texte.KennlinieLeer) };
        return d.Kennlinie.Select(p => new Stammblattwert(
                    Zahl(p.Rueckkuehltemperatur, "0.#", Texte.EinheitGradC) + " / " + Zahl(p.Kaltwassertemperatur, "0.#", Texte.EinheitGradC),
                    Texte.SpalteEer + " " + Zahl(p.Eer, "0.0#", "") + " · " + Zahl(p.Kaelteleistung, "0.#", Texte.EinheitKw)))
                .ToList();
    }

    private string Aenderungshinweis
    {
        get
        {
            if (!_geaendert) return "";
            int n = _arbeit.Abweichungen(_daten);
            return n == 1 ? Resource.ADM_SB_GEAENDERT_EINS
                 : string.Format(CultureInfo.CurrentCulture, Resource.ADM_SB_GEAENDERT, n);
        }
    }

    // =====================================================================
    // Speichern, Verwerfen, Neu — der EINE Schreibweg
    // =====================================================================

    /// <summary>Die Prüfung des Kerns; <c>null</c> = gültig.</summary>
    private string? Pruefbefund(KaeltemaschineDaten d)
    {
        string? befund = Pruefen?.Invoke(d);
        return string.IsNullOrEmpty(befund) ? null : befund;
    }

    /// <summary>
    /// „Speichern": die Prüfregeln EINMAL, dann der Schreibweg der Hülle (Kopf und Kennlinie in einem
    /// Vorgang); danach liest die Liste neu, die Wahl bleibt. Ein Auslieferungssatz ist weich gesperrt.
    /// </summary>
    private void BeiSpeichern()
    {
        _meldung = "";
        if (_auslieferung) { SpeichernAbgelehnt(Texte.SpeichernGesperrt); return; }
        if (!_geaendert || _daten.Id <= 0 || Speichern is null) return;

        string? befund = Pruefbefund(_arbeit);
        if (befund is not null) { SpeichernAbgelehnt(befund); return; }

        KaeltemaschineSpeicherErgebnis e = Speichern(_arbeit);
        if (!e.Ok) { SpeichernAbgelehnt(e.Meldung.Length > 0 ? e.Meldung : Texte.Fehler); return; }

        _geaendert = false;
        ListeLaden(e.Id.ToString(CultureInfo.InvariantCulture));
        _status = string.Format(CultureInfo.CurrentCulture, Resource.ADM_STATUS_GESPEICHERT,
                                DateTime.Now.ToString("HH:mm", CultureInfo.CurrentCulture));
    }

    private void BeiVerwerfen()
    {
        Zuruecksetzen();
        _meldung = "";
    }

    private void BeiNeu()
    {
        if (Speichern is null) return;
        if (_geaendert) { Warnen(Resource.ADM_MSG_UNGESPEICHERT); return; }
        _meldung = "";
        _neu = new KaeltemaschineDaten();
        _neuMeldung = "";
        _neuOffen = true;
    }

    private void NeuSchliessen()
    {
        _neuOffen = false;
        _neuMeldung = "";
    }

    /// <summary>„Neu…" — OK prüft (dieselbe Prüfung wie „Speichern") und legt an; die neue Zeile ist danach gewählt.</summary>
    private void NeuErgebnis(bool ok)
    {
        if (!ok) { NeuSchliessen(); return; }
        if (Speichern is null) return;

        _neu.Id = 0;
        string? befund = Pruefbefund(_neu);
        if (befund is not null) { _neuMeldung = befund; return; }

        KaeltemaschineSpeicherErgebnis e = Speichern(_neu);
        if (!e.Ok) { _neuMeldung = e.Meldung.Length > 0 ? e.Meldung : Texte.Fehler; return; }

        string name = _neu.Bezeichner.Trim();
        NeuSchliessen();
        _auswahl.Aufheben();
        _vergleichszeilen = null;
        ListeLaden(e.Id.ToString(CultureInfo.InvariantCulture));
        _status = string.Format(CultureInfo.CurrentCulture, Texte.Angelegt, name);
    }

    // =====================================================================
    // Auswahlleiste: Vergleichen, Duplizieren..., Schloss, Löschen
    // =====================================================================

    private EventCallback BlattOeffnenWeg => _auswahl.BlattOffen ? default : _blattOeffnen;

    private IReadOnlyList<Auswahlhandlung> Handlungen()
    {
        var liste = new List<Auswahlhandlung>(4)
        {
            new(Filtertexte.Vergleichen, _vergleichen)
            {
                Mindestens = 2,
                ZahlGrund = Resource.ADM_AW_VERGLEICHEN_GRUND,
                Gedrueckt = _auswahl.Vergleich
            }
        };
        if (Duplizieren is not null)
            liste.Add(new(Texte.KnopfDuplizieren, _duplizieren)
            {
                Hoechstens = 1,
                ZahlGrund = Resource.ADM_AW_DUPLIZIEREN_GRUND
            });
        if (_schloss.Handlung(Schloss, _schlossHandlung, SchlossZiele, false) is { } schloss)
            liste.Add(schloss);
        if (Loeschen is not null)
            liste.Add(new(Texte.KnopfLoeschen, _loeschen) { Sperrgrund = LoeschSperrgrund });
        return liste;
    }

    private bool Geschuetzt(string schluessel) => ZeileZu(schluessel)?.Geschuetzt == true;

    /// <summary>Ist JEDE Zielzeile ein Auslieferungssatz, ist „Löschen" weich gesperrt.</summary>
    private string LoeschSperrgrund
    {
        get
        {
            IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
            if (ziele.Count == 0 || ziele.Any(z => !Geschuetzt(z))) return "";
            return Resource.ADM_AW_LOESCHEN_GESPERRT;
        }
    }

    private void Warnen(string text) => _meldung = text ?? "";

    /// <summary>Ein Speichern ist abgelehnt: der Grund im Warnband UND rot in der Statuszeile.</summary>
    private void SpeichernAbgelehnt(string grund)
    {
        Warnen(grund);
        _status = grund ?? "";
        _statusFehler = true;
    }

    private void BeiKaestchen(IReadOnlyList<string> gewaehlte)
    {
        _auswahl.Setzen(gewaehlte);
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiAufheben()
    {
        _auswahl.Aufheben();
        _vergleichszeilen = null;
    }

    private void BeiVergleichen()
    {
        if (_auswahl.VergleichUmschalten()) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiVergleichZurueck()
    {
        _auswahl.VergleichBeenden();
        _vergleichszeilen = null;
    }

    /// <summary><b>Der Vergleich</b> (V12): die Kenndaten der gewählten Geräte nebeneinander, dazu die Herkunft.</summary>
    private void VergleichBauen()
    {
        IReadOnlyList<string> schluessel = _auswahl.Gewaehlte;
        _vergleichskoepfe = schluessel.Select(s => ZeileZu(s)?.Bezeichner ?? s).ToList();

        var saetze = new List<IReadOnlyList<Vergleichsfeld>>(schluessel.Count);
        foreach (string s in schluessel)
        {
            Katalogfilterzeile? z = ZeileZu(s);
            KaeltemaschineDaten d = (z is null ? null : Lies?.Invoke(z.Id)) ?? new KaeltemaschineDaten();
            var felder = Kenndatenwerte(d)
                .Skip(1)
                .Select((w, i) => new Vergleichsfeld("F" + i, w.Name, (w.Wert + " " + w.Einheit).Trim()))
                .ToList();
            felder.Add(new("KENNLINIE", Texte.GruppeKennlinie,
                string.Format(CultureInfo.CurrentCulture, Texte.KennlinieAnzahl, d.Kennlinie.Count)));
            felder.Add(new("HERKUNFT", Resource.ADM_VG_HERKUNFT,
                Geschuetzt(s) ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ));
            saetze.Add(felder);
        }
        _vergleichszeilen = Vergleichsbau.AusFeldern(saetze);
    }

    /// <summary>
    /// <b>„Löschen"</b> (V8, AD-Q9): wirkt auf die gewählten Zeilen, sonst auf die Fokuszeile;
    /// Auslieferungssätze bleiben stehen. Fragt zurück.
    /// </summary>
    private void BeiLoeschen()
    {
        if (Loeschen is null) return;
        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count == 0) return;

        var loeschbar = ziele.Where(z => !Geschuetzt(z)).ToList();
        var geschuetzt = ziele.Where(Geschuetzt).Select(z => ZeileZu(z)?.Bezeichner ?? z).ToList();
        if (loeschbar.Count == 0) { Warnen(LoeschSperrgrund); return; }

        _loeschziele = loeschbar;
        _loeschBleiben = geschuetzt.Count;

        var namen = loeschbar.Select(z => ZeileZu(z)?.Bezeichner ?? z).ToList();
        string frage = namen.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, Texte.FrageLoeschen, namen[0])
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_FRAGE_MEHR,
                            namen.Count, string.Join(", ", namen));
        if (geschuetzt.Count > 0)
            frage += " " + string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_BLEIBEN,
                                         string.Join(", ", geschuetzt));
        _loeschfrageText = frage;
        _loeschfrage = true;
    }

    private void BeiLoeschfrage(bool? ja)
    {
        _loeschfrage = false;
        if (ja != true || Loeschen is null) return;

        int geloescht = 0;
        string einzeln = "";
        string fehler = "";
        foreach (string s in _loeschziele)
        {
            Katalogfilterzeile? z = ZeileZu(s);
            if (z is null) continue;
            KaeltemaschineSpeicherErgebnis e = Loeschen(z.Id);
            if (e.Ok) { geloescht++; einzeln = z.Bezeichner; }
            else if (fehler.Length == 0) fehler = e.Meldung.Length > 0 ? e.Meldung : Texte.Fehler;
        }

        int ziele = _loeschziele.Count + _loeschBleiben;
        int blieben = ziele - geloescht;
        _loeschziele = new List<string>();

        if (geloescht > 0) ListeLaden();
        if (fehler.Length > 0) Warnen(fehler);
        if (geloescht == 0) return;

        _status = ziele == 1
            ? string.Format(CultureInfo.CurrentCulture, Texte.Geloescht, einzeln)
            : blieben > 0
                ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT_BLEIBEN, geloescht, blieben)
                : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT, geloescht);
    }

    private void BeiDuplizieren()
    {
        if (Duplizieren is null) return;
        if (_geaendert) { Warnen(Resource.ADM_MSG_UNGESPEICHERT); return; }
        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count != 1) return;

        _duplizierQuelle = ziele[0];
        _meldung = "";
        _kopievorschlag = Katalogkopie.Namensvorschlag(ZeileZu(_duplizierQuelle)?.Bezeichner ?? "", NameVergeben);
        _duplizierfrage = true;
    }

    /// <summary>Belegt ist ein Name, den ein Satz des Katalogs schon trägt (der Bezeichner ist eindeutig).</summary>
    private bool NameVergeben(string name)
        => _katalog.Any(z => string.Equals(z.Bezeichner, (name ?? "").Trim(), StringComparison.Ordinal));

    private string? NameBelegt(string name) => NameVergeben(name) ? Texte.NameBelegt : null;

    private void BeiDuplizierName(string? name)
    {
        _duplizierfrage = false;
        if (name is null || Duplizieren is null) return;

        Katalogfilterzeile? zeile = ZeileZu(_duplizierQuelle);
        if (zeile is null) return;

        KaeltemaschineSpeicherErgebnis e = Duplizieren(zeile.Id, name);
        if (!e.Ok) { Warnen(e.Meldung.Length > 0 ? e.Meldung : Texte.Fehler); return; }

        _auswahl.Aufheben();
        _vergleichszeilen = null;
        ListeLaden(e.Id.ToString(CultureInfo.InvariantCulture));
        _status = string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_DUPLIZIERT, zeile.Bezeichner, name.Trim());
    }

    // =====================================================================
    // „Schloss setzen…" / „Schloss aufheben…" (Entscheid AD-Q15)
    // =====================================================================

    private IReadOnlyList<Katalogfilterzeile> SchlossZiele
        => Schlossumschaltung.Zeilen(_auswahl.Ziele(_gewaehlt), _katalog);

    private void BeiSchloss()
    {
        string? grund = _schloss.Fragen(Schloss, SchlossZiele, _geaendert);
        if (grund is not null) { Warnen(grund); return; }
        _meldung = "";
    }

    private void BeiSchlossAntwort(bool? antwort)
    {
        Schlossausgang a = _schloss.Beantwortet(antwort, Schloss);
        if (!a.Geschrieben)
        {
            if (a.Fehler.Length > 0) Warnen(a.Fehler);
            return;
        }
        ListeLaden();
        _meldung = "";
        _status = a.Status;
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _neuOffen || _loeschfrage || _duplizierfrage || _schloss.FrageOffen)
            return Task.CompletedTask;

        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }
        return Schliessen();
    }

    /// <summary>Schließen — „Beenden", Esc und Schliesskreuz, immer mit <c>true</c>. Geänderte Werte halten an.</summary>
    private Task Schliessen()
    {
        if (_geaendert)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(true);
    }
}
