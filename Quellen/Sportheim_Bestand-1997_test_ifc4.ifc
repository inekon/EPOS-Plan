#19142=IFCPROPERTYENUMERATEDVALUE('ElementType','Kennung Elementtyp',(IFCLABEL('bctWall')),$);
#19143=IFCPROPERTYENUMERATEDVALUE('EmbeddedSystemPositionType','Kennung f\X\FCr die Position von fl\X\E4chenintegrierten Systemen innerhalb des Geb\X\E4udeelementes Anhand der Eigenschaft wird festgelegt, ob ein fl\X\E4chenintegriertes System innerhalb des Geb\X\E4udebauteils installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein fl\X\E4chenintegriertes System vorgesehen ist. Wenn die Position des fl\X\E4chenintegrierten Systems noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
#19144=IFCPROPERTYENUMERATEDVALUE('Generator','Kennung f\X\FCr den Ersteller/Bearbeiter des Geb\X\E4udeelementes. Der Generator dient nur zur Information. Die Kennung darf nicht f\X\FCr die Identifizierung von Modellobjekten verwendet werden.',(IFCLABEL('mgt2D3D')),$);
#19145=IFCPROPERTYSINGLEVALUE('GUID','Bezeichner, der w\X\E4hrend der Lebenszeit des Modellobjektes erhalten bleibt. Der Bezeichner ist nicht eindeutig.',IFCLABEL('1430dde2-d2b6-4851-a7f3-a52da3459a06'),$);
#19146=IFCPROPERTYSINGLEVALUE('ID','Kennung f\X\FCr das Modellobjekt. MUSS innerhalb des Projektes eindeutig sein.',IFCIDENTIFIER('-1'),$);
#19147=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('23d4050d-0d8e-41f4-89b5-3babc5aaad80'),$);
#19148=IFCPROPERTYENUMERATEDVALUE('LoadBearingType','Kennung f\X\FCr die Tragf\X\E4higkeit des Bauteils',(IFCLABEL('elbNone')),$);
#19149=IFCPROPERTYSINGLEVALUE('Name','Name des Bauteils',IFCLABEL('AW 014-2'),$);
#19150=IFCPROPERTYSINGLEVALUE('Number','Kurzbeschreibung des Objektes. (50 Zeichen)',IFCLABEL(''),$);
#19151=IFCPROPERTYSINGLEVALUE('Orientation (\X\B0)','Orientierung betogen auf das Bauteil',IFCLABEL('0'),$);
#19152=IFCPROPERTYENUMERATEDVALUE('Orientation.Type','Orientierung Type (Enum)',(IFCLABEL('botN')),$);
#19153=IFCPROPERTYENUMERATEDVALUE('RadiatorPositionType','Kennung f\X\FCr die Position des Heizk\X\F6rpers zum Geb\X\E4udeelement Anhand der Eigenschaft wird festgelegt, ob ein Heizk\X\F6rper an dem Geb\X\E4udebauteil installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein Heizk\X\F6rper vorgesehen ist. Wenn die Position des Heizk\X\F6rpers noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
