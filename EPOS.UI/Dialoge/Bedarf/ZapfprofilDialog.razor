    /// <summary>Gibt es einen Punkt, der überholt werden kann: den übernommenen oder den des Stands beim Öffnen?</summary>
    private bool PunktVorhanden
        => !_eingabe.PunktUeberholt
           && (_eingabe.Auslegung is { } a ? a.PunktVolumenL.HasValue || a.PunktLeistungKw.HasValue : Daten.MitPunkt);

    /// <summary>
    /// Eine Zonenänderung, die die Auslegung ändert: Der Punkt ist überholt — der übernommene
    /// fällt aus dem Arbeitsstand, ein Punkt des Stands beim Öffnen wird beim Speichern
    /// verworfen. Der Name einer Zone ändert die Auslegung nicht.
    /// </summary>
    private void PunktUeberholen()
    {
        if (!PunktVorhanden) return;
        if (_eingabe.Auslegung is { } a)
        {
            a.PunktVolumenL = null;
            a.PunktLeistungKw = null;
        }
        _eingabe.PunktUeberholt = true;
    }

    private void AnsichtWaehlen(int? id) => _ansicht = id ?? 0;

    /// <summary>
    /// Eine Eingabe hat den Arbeitsstand geändert: die Vorschau ist überholt und wird entprellt
    /// neu gerechnet; ein Lauf der Jahresreihe gehört zum alten Stand — er bricht ab, sein
    /// Ergebnis fällt weg.
    /// </summary>
    private void Geaendert(bool ansichtZuruecksetzen = false)
    {
        _okMeldung = "";
        _okKennung = null;
        _hinweis = "";
        _editorStatus = "";
        _kalibrierstatus = "";
        _vorschauAktuell = false;
        _ladehilfeAktuell = false;
        JahresreiheVerwerfen();
        // Ein Vergleich gehört zu dem Stand, gegen den er gerechnet wurde: Er bleibt sichtbar,
        // trägt aber den Veraltet-Vermerk; ein laufender bricht ab. Eine laufende Kalibrierung
        // gehört demselben alten Stand — sie bricht ab, ohne Felder zu setzen.
        VergleichVeralten();
        KalibrierLaufVerwerfen();
        if (ansichtZuruecksetzen) _ansicht = 0;
        VorschauEntprellen();
    }

    // =================================================================================
    // Vorschau - entprellt (EPOS.UI/CLAUDE.md, "Zeichenlaeufe")
    // =================================================================================

    private void VorschauEntprellen()
    {
        EntprellungAbbrechen();
        if (Vorschau is null) return;
        if (EntprellungMs <= 0)
        {
            VorschauRechnen();
            return;
        }

        var quelle = new CancellationTokenSource();
        _entprellung = quelle;
        _ = EntprellungAbwarten(quelle);
    }

    private async Task EntprellungAbwarten(CancellationTokenSource quelle)
    {
        try
        {
            await Task.Delay(EntprellungMs, quelle.Token);
            if (quelle.IsCancellationRequested) return;
            await InvokeAsync(() =>
            {
                if (quelle.IsCancellationRequested) return;
                VorschauRechnen();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { /* eine neue Eingabe war schneller */ }
        catch (ObjectDisposedException) { /* der Dialog ist gegangen */ }
    }

    private void EntprellungAbbrechen()
    {
        CancellationTokenSource? offen = _entprellung;
        _entprellung = null;
        if (offen is null) return;
        try { offen.Cancel(); } catch (ObjectDisposedException) { }
        offen.Dispose();
    }

    private void VorschauRechnen()
    {
        if (Vorschau is null) return;
        _vorschau = Vorschau(_eingabe.Kopie());
        _vorschauAktuell = _vorschau is not null;
        if (_vorschau is not null && _ansicht >= _vorschau.Ansichten.Count) _ansicht = 0;
        LadehilfeRechnen();
    }

    // =================================================================================
    // Ergebnis
    // =================================================================================

    /// <summary>
    /// OK prüft über den Delegaten der Hülle — dieselbe Regel für jeden Weg, der übernimmt
    /// —, meldet eine Lücke als Banner und hält den Dialog offen; sonst geht der Arbeitsstand
    /// mit dem Weg „Generator" zurück (ZU4: das OK stellt die Optionsgruppe um).
    /// </summary>
    private async Task BeiErgebnis(bool ok)
    {
        if (!ok)
        {
            await Abbrechen();
            return;
        }

        // Die wirksame Bezugsmenge einer Wohnungstabelle rechnet der Kern (Vorschau): vor der Prüfung
        // frisch rechnen — die teure Stufe läuft sofort vor dem Übernehmen — und in die Bezugsgröße nehmen.
        if (!_vorschauAktuell && Vorschau is not null)
        {
            EntprellungAbbrechen();
            VorschauRechnen();
        }
        WirksameMengenUebernehmen();

        (string befund, string? kennung) = OkBefund();
        if (befund.Length > 0)
        {
            _okMeldung = befund;
            _okKennung = kennung;
            return;
        }

        // Die Jahresreihe zieht der Lauf der Simulation selbst; ein offener Lauf des Dialogs endet hier.
        EntprellungAbbrechen();
        JahresreiheVerwerfen();
        KalibrierLaufVerwerfen();
        ZapfprofilEingabeDaten ergebnis = _eingabe.Kopie();
        ergebnis.Weg = ZapfprofilWeg.Generator;
        await Geschlossen.InvokeAsync(new ZapfprofilErgebnisDaten(ergebnis));
    }

    /// <summary>
    /// Übernimmt die wirksame Bezugsmenge des Kerns für jede Zone, deren Wohnungstabelle bei ihrer
    /// Nutzungsart wirkt (4.1: die Menge kommt aus der Tabelle) — die Bezugsgröße der Zone und die
    /// gespeicherte Menge sagen dann dasselbe. Eine Übernahme ändert die Auslegung nicht: Der Kern
    /// rechnete schon mit dieser Menge.
    /// </summary>
    private void WirksameMengenUebernehmen()
    {
        for (int i = 0; i < _eingabe.Zonen.Count; i++)
        {
            ZapfprofilZoneDaten z = _eingabe.Zonen[i];
            if (WirksameMenge(z, Nutzungsart(z.IdNutzungsart)) is double wirksam && wirksam > 0) z.Bezugsmenge = wirksam;
        }
    }

    /// <summary>Abbrechen — von Esc, vom Schliesskreuz und vom Knopf gleichermaßen gerufen; verwirft ohne Prüfung.</summary>
    private Task Abbrechen()
    {
        EntprellungAbbrechen();
        JahresreiheVerwerfen();
        KalibrierLaufVerwerfen();
        return Geschlossen.InvokeAsync(null);
    }

    /// <summary>
    /// Esc schließt nur, wenn KEINE Überlagerung offen ist — sonst schließt sie sich selbst. Geprüft
    /// werden alle sechs Schalter (Auslegung, Tagesgang, Zapfkategorien, Typtage, Messdaten,
    /// Kalibriervorschlag) und die offene Rückfrage.
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
        => e.Key == "Escape" && _auslegungGaben is null && _tagesgangGaben is null && _kategorienGaben is null
           && _typtagGaben is null && _messreihenGaben is null && _vorschlag is null && !_frageOffen
            ? Abbrechen() : Task.CompletedTask;

    /// <summary>
    /// Der Befund des OK — eine Fehleingabe (Seed, Realisierungen) oder die Fehler der
    /// Pflichtprüfung der Hülle; leer = in Ordnung. Dieselbe Prüfung am Knopf und beim
    /// Assistenten (<see cref="KiHaken"/>).
    /// </summary>
    private (string Text, string? Kennung) OkBefund()
    {
        // Ein Feld mit ungültigem Text (Seed, Realisierungen) hielte sonst still den alten Wert.
        if (_fehlfelder.Count > 0)
            return (Format(Texte.MeldungFehleingabe, string.Join(", ", _fehlfelder)), "ZPG_MSG_FEHLEINGABE");

        IReadOnlyList<ZapfprofilMeldung> fehler = (Pruefen?.Invoke(_eingabe) ?? Array.Empty<ZapfprofilMeldung>())
            .Where(m => m.Art == ZapfprofilMeldungsart.Fehler).ToList();
        return fehler.Count > 0
            ? (string.Join(" ", fehler.Select(m => m.Text)), fehler[0].Kennung)
            : ("", null);
    }

