@* Dialog "PV-Verguetung (EEG)" - die Razor-Fassung (iU9-W2.4).

   HERKUNFT. Die WinForms-Fassung Views/Wirtschaftlichkeit/
   Form_PhotovoltaikVerguetung (Designer + 422 Zeilen Code, Etappe P5/P6) ist
   mit dieser Komponente GELOESCHT - Regel M1. Uebernommen sind Feldbestand
   (Feldkarte 36 Zeilen), Reihenfolge, Wertebereiche, die Nullsemantik
   "0 = keiner" und die gesamte Live-Logik aus Aktualisieren() wortgleich; die
   Beschriftungen kommen aus denselben Schluesseln PVW_*.

   ER RECHNET NICHTS SELBST. Saetze, Erloesreihe und Kennzahlen kommen aus den
   Bestandsrechnern des Kerns - EegSatzRechner, PvErloesRechner,
   PvKennzahlenRechner. Sie sind datenbankfrei und nehmen ihren Zugang zum
   Gesetzeskatalog als Delegat (Leitentscheidung L9); genau so bekommt ihn
   diese Komponente. Eine Zweitrechnung waere die zweite Wahrheit, die V4/F7
   verhindern soll.

   ER KENNT KEINE DATENBANK (Hausregel EPOS.UI). Modell, Mengen des letzten
   Laufs, Kosten und Wirtschaftlichkeitsparameter kommen fertig geladen als
   [Parameter] herein; geschrieben wird ueber den Rueckruf Speichern
   (ProjektPhotovoltaikCtrl.Speichern).

   LIVE. Die WinForms-Fassung rief Aktualisieren() nach jeder Eingabe und
   schrieb die Ergebnisse in Labels. Hier ist jede dieser Groessen eine
   Eigenschaft, die beim Zeichnen gelesen wird - dasselbe Ergebnis, nur ohne
   den Zwischenschritt ueber Steuerelemente. Die Zulaessigkeitsregel
   (feste EV nur bis 100 kW, unentgeltlich < 200 kW) schaltet dabei wie bisher
   auf Marktpraemie um, sobald die gewaehlte Form unzulaessig wird.

   TASTATUR. Esc schliesst, Enter bleibt unbelegt (A-7 aus B5b). *@

@namespace EPOS.UI.Dialoge.Wirtschaftlichkeit

@using System.Globalization
@using WindowsFormsApplication1
@using EPOS.UI.Dialoge.Kosten
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: eingebettet in der Ueberlagerung "Photovoltaik-Verguetung"
       (WirtschaftlichkeitSeite) traegt DIE den Titel; der Wirt setzt dort
       TitelAnzeigen="false" - dann bleiben Titel und Kreuz hier aus, die
       Ueberlagerung traegt beides. Der Titel kommt aus dem Textbuendel _t, nicht
       aus einem leerbaren TitelText. *@
    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@_t.Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="@(() => Schliessen(PvSprung.Keiner))" />
        }
    </div>

    <Schalter Bezeichnung="@_t.Aktiv" Wert="@Modell.Aktiv"
              WertChanged="@(w => Modell.Aktiv = w)" />

    @* KONZEPT § 2.16 - die HERKUNFT der Verguetung dieses Stands. Sie steht unter
       dem Schalter, weil sie fuer ALLES darunter gilt: Wer uebernimmt, sieht die
       Werte des Stamms und aendert sie nicht hier, sondern nimmt "eigene Werte".
       Der Reiter Ertrag/Bonus ist der Ort der WAHL (VV-Q3); dieser Dialog zeigt sie
       und bietet den einen Weg heraus. *@
    @if (!string.IsNullOrEmpty(HerkunftText))
    {
        <Herleitungszeile Text="@HerkunftText" />
    }
    @if (Uebernommen && EigeneWerte.HasDelegate)
    {
        <button type="button" class="epos-knopf" @onclick="EigeneWerteKlick">@_t.BtnEigeneWerte</button>
    }

    @* ---------------------------------------------------------- Anlage *@
    <Gruppenkopf Titel="@_t.GAnlage" Symbol="☀">
        <KindInhalt>
            <Herleitungszeile Text="@_t.Kwp" Formel="@KwpText" />

            @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben dem
               Feld, Zahlenfelder kurz mit der Einheit dahinter. Die Herleitungs-
               und Warnzeilen bleiben ausserhalb - sie sind Saetze, keine Felder. *@
            <Formularraster>
                <KindInhalt>
                    <Zahlenfeld Bezeichnung="@_t.KwpOverride" Wert="@(Modell.KwpOverride ?? 0)"
                                WertChanged="@LeistungGeaendert"
                                Min="0" Max="100000" Nachkommastellen="2" />

                    <Datumsfeld Bezeichnung="@_t.Ibn" Wert="@Ibn"
                                WertChanged="@IbnGeaendert" />

                    @* Degradation (Paket B, Stufe E2.4 - mit Merge 5 aus Form_PhotovoltaikVerguetung
                       nachgezogen): wirkt allein in der Erloesreihe, nicht in der Stundensimulation.
                       Der Tooltip-Wirt ist DURCHSICHTIG (epos-formulargruppe, display: contents),
                       damit das Feld direktes Rasterkind bleibt (Zusammenfuehrung Rechner 2 / P2). *@
                    <div class="epos-formulargruppe" title="@_t.DegradationTip">
                        <Zahlenfeld Bezeichnung="@_t.Degradation" Wert="@(Modell.Degradation ?? 0)"
                                    WertChanged="@DegradationGeaendert"
                                    Min="0" Max="20" Nachkommastellen="2" />
                    </div>

                    <Optionsgruppe Bezeichnung="@_t.GEinspeiseart" Eintraege="@_einspeisearten"
                                   Auswahl="@EinspeiseartNr" AuswahlChanged="EinspeiseartGewaehlt" />
                </KindInhalt>
            </Formularraster>

            @foreach (string warnung in Anlagenwarnungen)
            {
                <Warnbanner Stufe="WarnStufe.Warnung" Text="@warnung" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* --------------------------------------------- Anzulegender Wert *@
    <Gruppenkopf Titel="@_t.GAw" Symbol="€">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                    <Zahlenfeld Bezeichnung="@_t.AwOverride" Wert="@(Modell.AwOverride ?? 0)"
                                WertChanged="@(w => Modell.AwOverride = w > 0 ? w : null)"
                                Min="0" Max="100" Nachkommastellen="2" />
                </KindInhalt>
            </Formularraster>

            <Herleitungszeile Text="@AwText" />
            <Herleitungszeile Text="@Satz.Herleitung" />
            <Herleitungszeile Text="@EvText" />
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------------------ Vermarktung *@
    <Gruppenkopf Titel="@_t.GVermarktung" Symbol="⇄">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                    <Optionsgruppe Eintraege="@_vermarktungsformen" Gesperrt="@GesperrteFormen"
                                   Auswahl="@VermarktungNr" AuswahlChanged="VermarktungGewaehlt" />

                    <Zahlenfeld Bezeichnung="@_t.Dv" Wert="@(Modell.DvEntgelt ?? 0)"
                                WertChanged="@(w => Modell.DvEntgelt = w)"
                                Min="0" Max="10" Nachkommastellen="2" Aktiv="@IstMarktpraemie" />
                    <Zahlenfeld Bezeichnung="@_t.PpaPreis" Wert="@(Modell.PpaPreis ?? 0)"
                                WertChanged="@(w => Modell.PpaPreis = w > 0 ? w : null)"
                                Min="0" Max="100" Nachkommastellen="2" Aktiv="@IstPpa" />
                    <Zahlenfeld Bezeichnung="@_t.PpaAufschlag" Wert="@(Modell.PpaSpotAufschlag ?? 0)"
                                WertChanged="@(w => Modell.PpaSpotAufschlag = w != 0 ? w : null)"
                                Min="-100" Max="100" Nachkommastellen="2" Aktiv="@IstPpa" />
                </KindInhalt>
            </Formularraster>

            @* ETAPPE E9b (Konzept § 2.11.5, Pflege; E9b-Q1): je ein ±-Knopf an DV-Entgelt
               und PPA-Preis - dasselbe Muster wie an der Kostenposition. Die Paare stehen
               am Modell (DvEntgeltBest/Worst, PpaPreisBest/Worst, Schemaschritt 118) und
               gehen mit "Uebernehmen" in die Zeile. Die Knoepfe folgen der Sperre ihres
               Feldes; der Spot-Aufschlag und die Marktwertfelder sind nicht szenariert
               (E9a-Q1). Ein gepflegtes Paar, das im Lauf nicht wirkt, nennt eine
               Kohaerenzzeile. *@
            <div class="epos-szenarioleiste">
                <SzenarioKnopf Text="@_t.SzDv" Aktiv="@IstMarktpraemie" Gepflegt="@DvSzenarioGepflegt"
                               Kurztext="@PvSzenarioKurztext(PV_DV)"
                               GepflegtText="@_sz.Gepflegt" WarnungText="@_sz.OhneErwartetKurz"
                               Angefordert="() => PvSzenarioOeffnen(PV_DV)" />
                <SzenarioKnopf Text="@_t.SzPpa" Aktiv="@IstPpa" Gepflegt="@PpaSzenarioGepflegt"
                               Kurztext="@PvSzenarioKurztext(PV_PPA)"
                               GepflegtText="@_sz.Gepflegt" WarnungText="@_sz.OhneErwartetKurz"
                               Angefordert="() => PvSzenarioOeffnen(PV_PPA)" />
            </div>
            @foreach (string zeile in PvSzenarioZeilen)
            {
                <Kohaerenzzeile Text="@zeile" Zustand="KohaerenzZustand.Abweichend" />
            }

            <Herleitungszeile Text="@VermarktungHinweis" />
        </KindInhalt>
    </Gruppenkopf>

    @* -------------------------------------------------- § 51 / § 51a *@
    <Gruppenkopf Titel="@_t.G51">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@_t.Anwenden"
                                 Eintraege="@TarifWahlen.Eintraege(_schalter)"
                                 Auswahl="@PvSchalterwahlen.Index(Modell.Par51_Anwenden)"
                                 AuswahlChanged="@(n => Modell.Par51_Anwenden = PvSchalterwahlen.Wert(n))" />

                    <Ganzzahlfeld Bezeichnung="@_t.IMSys" Wert="@(Modell.IMSys_Einbaujahr ?? 0)"
                                  WertChanged="@(w => Modell.IMSys_Einbaujahr = w >= 2000 ? w : null)"
                                  Min="0" Max="2100" />

                    <Zahlenfeld Bezeichnung="@_t.Ausfall" Wert="@(Modell.AusfallanteilProzent ?? 0)"
                                WertChanged="@(w => Modell.AusfallanteilProzent = w)"
                                Min="0" Max="100" Nachkommastellen="1" Einheit="%" />

                    <Schalter Bezeichnung="@_t.Par51a" Wert="@Modell.Par51a_Kompensieren"
                              WertChanged="@(w => Modell.Par51a_Kompensieren = w)" />
                </KindInhalt>
            </Formularraster>

            <Herleitungszeile Text="@Par51Status" />
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------------- Bezugsbewertung *@
    <Gruppenkopf Titel="@_t.GBezug">
        <KindInhalt>
            <Schalter Bezeichnung="@_t.BezugReihe" Wert="@Modell.BezugAusPreisreihe"
                      WertChanged="@(w => Modell.BezugAusPreisreihe = w)" />
            <Herleitungszeile Text="@_t.Stromsteuer" />
        </KindInhalt>
    </Gruppenkopf>

    @* ---------------------------------------------------------- Kappung *@
    <Gruppenkopf Titel="@_t.GKappung">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@_t.Anwenden"
                                 Eintraege="@TarifWahlen.Eintraege(_schalter)"
                                 Auswahl="@PvSchalterwahlen.Index(Modell.Kappung60_Anwenden)"
                                 AuswahlChanged="@(n => Modell.Kappung60_Anwenden = PvSchalterwahlen.Wert(n))" />
                </KindInhalt>
            </Formularraster>
            <Herleitungszeile Text="@KappungStatus" />
        </KindInhalt>
    </Gruppenkopf>

    @* --------------------------------------------------------- Vorschau *@
    <Gruppenkopf Titel="@_t.GVorschau" Symbol="Σ">
        <KindInhalt>
            <Herleitungszeile Text="@VorschauText" />
            <Herleitungszeile Text="@KennzahlText" />
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------------------- Sprungwege *@
    @if (MarktwerteImportieren is not null)
    {
        <button type="button" class="epos-knopf epos-sprung"
                @onclick="MarktwerteKlick">@_t.BtnMarktwerte</button>
    }
    <button type="button" class="epos-knopf epos-sprung"
            @onclick="TarifKlick">@_t.BtnTarif</button>
    <Herleitungszeile Text="@_t.SprungHinweis" />

    @if (!string.IsNullOrEmpty(_hinweis))
    {
        <Warnbanner Stufe="WarnStufe.Hinweis" Text="@_hinweis" />
    }
    @if (!string.IsNullOrEmpty(_fehler))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" />
    }

    <SpeichernLeiste OkText="@_t.BtnUebernehmen" AbbrechenText="@_t.BtnAbbrechen"
                     Ergebnis="BeiErgebnis" />

    @* ETAPPE E9b: das Szenariopaar von DV-Entgelt bzw. PPA-Preis - der CaseEingabeDialog
       als allgemeiner Baustein (E9b-Q1). Ein Titel, eine Stelle: Die Ueberlagerung traegt
       Titel und Kreuz, TitelText="" steht RECHTS vom Satz. OK legt die Werte auf das
       Modell; geschrieben wird mit "Uebernehmen". *@
    <Ueberlagerung Offen="@(_szenarioGaben is not null)" Titel="@_szenarioTitel"
                   Geschlossen="() => PvSzenarioFertig(null)">
        <KindInhalt>
            @if (_szenarioGaben is not null)
            {
                <CaseEingabeDialog @attributes="_szenarioGaben" TitelText=""
                                   Geschlossen="PvSzenarioFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    // =====================================================================
    // Was hereinkommt
    // =====================================================================

    /// <summary>
    /// Der Vergütungssatz des Stammprojekts
    /// (<c>ProjektPhotovoltaikCtrl.LiesOderVorbelegt</c>), fertig geladen. Der
    /// Dialog schreibt seine Eingaben in DIESES Objekt zurück; die Hülle
    /// speichert danach denselben Satz. Felder, die der Dialog nicht führt
    /// (Marktwert-Override, Marktwertentwicklung), bleiben damit erhalten.
    /// </summary>
    [Parameter] public ProjektPhotovoltaikModel Modell { get; set; } = new ProjektPhotovoltaikModel();

    /// <summary>Rechnerische Leistung aus den Anlagen des Projekts
    /// (<c>PhotovoltaikCtrl.KwpDesProjekts</c>).</summary>
    [Parameter] public double KwpRechnerisch { get; set; }

    /// <summary>Einspeisemenge des letzten Simulationsergebnisses [MWh/a];
    /// 0 = noch kein Lauf.</summary>
    [Parameter] public double EinspeisungMWh { get; set; }

    /// <summary>Stromproduktion des letzten Laufs [MWh/a].</summary>
    [Parameter] public double ErzeugungMWh { get; set; }

    /// <summary>Strombedarf des letzten Laufs [MWh/a].</summary>
    [Parameter] public double BedarfMWh { get; set; }

    /// <summary>Eigenverbrauchsquote MIT Speicher [%]; <c>null</c> = keine
    /// Speicherrechnung. Sie kommt STETS im Paar mit der Autarkie (N.3).</summary>
    [Parameter] public double? EvQuoteSpeicher { get; set; }

    /// <summary>Autarkiegrad MIT Speicher [%].</summary>
    [Parameter] public double? AutarkieSpeicher { get; set; }

    /// <summary>Investition der Komponente Photovoltaik [€]; <c>null</c> = keine Zeile.</summary>
    [Parameter] public double? InvestPv { get; set; }

    /// <summary>Betriebskosten der Komponente Photovoltaik [€/a]; <c>null</c> = keine Zeile.</summary>
    [Parameter] public double? BetriebPv { get; set; }

    /// <summary>Arbeitspreis Strom [€/kWh] aus der Vorrangkette der Energiekosten.</summary>
    [Parameter] public double? StrompreisEurKwh { get; set; }

    /// <summary>Zins, Betrachtungszeitraum und Preissteigerung für die Kennzahlen;
    /// <c>null</c> = keine Kennzahlzeile.</summary>
    [Parameter] public WirtschaftlichkeitParameter? WirtParameter { get; set; }

    /// <summary>Lesefassade auf <c>Tab_Gesetzesparameter</c>
    /// (<c>GesetzKatalog.Wert</c>) — dieselbe Übergabe als Delegat, die
    /// <c>EegSatzRechner</c> und <c>PvErloesRechner</c> selbst verlangen.</summary>
    [Parameter] public Func<string, int, double?>? Katalog { get; set; }

    /// <summary>Kalenderjahr → amtlicher Jahresmarktwert Solar [ct/kWh]
    /// (<c>ProjektPhotovoltaikCtrl.Jahresmarktwert</c>).</summary>
    [Parameter] public Func<int, double?>? Jahresmarktwert { get; set; }

    /// <summary>Schreibt den Satz fort. <c>true</c> = gespeichert.</summary>
    [Parameter] public Func<bool>? Speichern { get; set; }

    /// <summary>
    /// Der Marktwert-Import (P6): Dateiauswahl und Einlesen liegen in der Hülle
    /// — <c>null</c> als Rückgabe heißt „abgebrochen". <c>null</c> als Delegat
    /// heißt „diese Umgebung kann keine Datei wählen"; dann fehlt der Knopf.
    ///
    /// <para><b>Asynchron</b>, weil die Hülle den Dateiwähler seit E3 Schritt 2
    /// über <c>Dienste.Datei.DateiOeffnenAsync</c> öffnet: Ein Wähler, der
    /// unmittelbar aus dem Blazor-Ereignis erschiene, pumpte dort eine
    /// verschachtelte Nachrichtenschleife (Regel (b) der Hüllenschicht).</para>
    /// </summary>
    [Parameter] public Func<Task<MarktwertImport?>>? MarktwerteImportieren { get; set; }

    /// <summary>Was der Dialog beim Schließen meldet.</summary>
    [Parameter] public EventCallback<PvVerguetungErgebnis> Geschlossen { get; set; }

    // ---- KONZEPT § 2.16: die Herkunft der Vergütung ----------------------

    /// <summary>
    /// Zeigt dieser Stand eine ÜBERNOMMENE Vergütung? Dann gehören die Felder dem
    /// Stammprojekt — „Übernehmen" schriebe sie in die Zeile des geöffneten
    /// Projekts, und der Weg dahin ist ausdrücklich der Knopf „eigene Werte".
    /// </summary>
    [Parameter] public bool Uebernommen { get; set; }

    /// <summary>
    /// Die Hinweiszeile unter dem Schalter: „Vergütung dieser Variante: eigene
    /// Werte", „übernommen von ‹Stamm›" oder „Stammprojekt — ‹n› Varianten
    /// übernehmen diese Vergütung". Sie kommt FERTIG herein; der Dialog kennt weder
    /// Datenbank noch Variantenbaum.
    /// </summary>
    [Parameter] public string HerkunftText { get; set; } = "";

    /// <summary>
    /// „Eigene Werte": kopiert die Stammwerte in die Zeile dieses Stands und setzt
    /// die Wahl auf „eigene" (VV‑Q6). Die HÜLLE tut das; <c>null</c> als Delegat
    /// heißt „hier gibt es nichts zu lösen" — dann fehlt der Knopf.
    /// </summary>
    [Parameter] public EventCallback EigeneWerte { get; set; }

    /// <summary>Schlüssel des Hilfeknopfes — dieselbe Wikiseite wie bisher.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_PhotovoltaikVerguetung.btn_Help";

    /// <summary>
    /// Zeigt der Dialog seinen eigenen Kopf — Titel UND Schließkreuz? Vorgabe
    /// <c>true</c> — im eigenen Fenster der Windows-Schale trägt ihn sonst
    /// niemand. Steckt der Dialog dagegen in einer <c>Ueberlagerung</c>, die
    /// denselben Titel schon führt, setzt die Einbettungsstelle <c>false</c>:
    /// Ein Titel, eine Stelle. Und weil „das Kreuz beim Titel steht", trägt
    /// dann auch die <c>Ueberlagerung</c> das Kreuz, nicht dieser Dialog.
    /// </summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

    // =====================================================================
    // Zustand
    // =====================================================================

    private readonly PhotovoltaikVerguetungTexte _t = new();
    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private IReadOnlyList<Steuerwahl> _schalter = Array.Empty<Steuerwahl>();
    private IReadOnlyList<(int Id, string Text)> _einspeisearten = Array.Empty<(int, string)>();
    private IReadOnlyList<(int Id, string Text)> _vermarktungsformen = Array.Empty<(int, string)>();

    private string _hinweis = "";
    private string _fehler = "";
    private bool _gespeichert;

    /// <summary>ETAPPE E2 (Q12): der Wertabzug des Modells BEIM LADEN — Maßstab der
    /// Änderungsprüfung des Sprungknopfs.</summary>
    private string _abzugBeimLaden = "";

    protected override void OnInitialized()
    {
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.PV_VERGUETUNG,
                                          () => KiSicht(), KiHaken());

        _schalter = PvSchalterwahlen.Liste(_t);
        _einspeisearten = new[] { (0, _t.Ueberschuss), (1, _t.Voll) };
        _vermarktungsformen = new[]
        {
            (0, _t.Ev), (1, _t.Marktpraemie), (2, _t.Ppa), (3, _t.Keine)
        };

        ZulaessigkeitPruefen();

        // ETAPPE E2 (Q12): Der Maßstab der Änderungsprüfung wird NACH der
        // Zulässigkeitsregel genommen. Sie kann die Vermarktungsform umstellen, und
        // das ist eine Korrektur des Dialogs, keine Eingabe des Anwenders — sie darf
        // den Sprungknopf nicht zu einem Schreibzugriff machen.
        _abzugBeimLaden = Abzug();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <summary>Die Kultur der Anzeige — dieselbe wie Bericht und Reiter.</summary>
    private static CultureInfo Kultur => BhwTexte.Kultur;

    // =====================================================================
    // Anlage
    // =====================================================================

    /// <summary>Inbetriebnahme als Kalendertag; <c>null</c> = nicht angegeben.</summary>
    private DateOnly? Ibn
    {
        get => Modell.Inbetriebnahme > DateTime.MinValue
             ? DateOnly.FromDateTime(Modell.Inbetriebnahme) : null;
        set => Modell.Inbetriebnahme = value.HasValue
             ? value.Value.ToDateTime(TimeOnly.MinValue) : DateTime.MinValue;
    }

    /// <summary>Das Jahr, mit dem die Kataloge gelesen werden.</summary>
    private int Jahr => Modell.Inbetriebnahme > DateTime.MinValue
                      ? Modell.Inbetriebnahme.Year : DateTime.Now.Year;

    /// <summary>Die geltende Leistung: Override, sonst rechnerisch (V3).</summary>
    public double Kwp => Modell.KwpOverride ?? KwpRechnerisch;

    private int? EinspeiseartNr => string.Equals(Modell.Einspeiseart,
        DbWerte.PV_EINSPEISEART_VOLL, StringComparison.Ordinal) ? 1 : 0;

    private void EinspeiseartGewaehlt(int? nummer)
    {
        Modell.Einspeiseart = nummer == 1
            ? DbWerte.PV_EINSPEISEART_VOLL : DbWerte.PV_EINSPEISEART_UEBERSCHUSS;
    }

    private string KwpText
    {
        get
        {
            string s = string.Format(Kultur, _t.KwpWert, KwpRechnerisch);
            if (Modell.KwpOverride.HasValue)
                s += string.Format(Kultur, _t.KwpOverrideZusatz, Modell.KwpOverride.Value);
            return s;
        }
    }

    /// <summary>
    /// U36 (18.09.2026): Die Warnungen der Gruppe Anlage (§ 7 Punkt 1) —
    /// NEBENEINANDER, nicht als Kette.
    ///
    /// <para><b>Der Fehler.</b> Die beiden Grenzen standen als <c>?:</c>-Kette: über
    /// 1 MW die Ausschreibungswarnung, SONST über 2 MW die Stromsteuerwarnung. Der
    /// zweite Zweig konnte nie greifen — jede Anlage über 2 MW ist auch über 1 MW.
    /// Eine 2,5-MW-Anlage las damit nichts über die Stromsteuer auf ihren
    /// Eigenverbrauch. Es sind zwei UNABHÄNGIGE Schwellen aus zwei Gesetzen; jede
    /// wird für sich geprüft.</para>
    ///
    /// <para><b>Die Grenzen kommen aus dem Gesetzeskatalog</b> — § 22 EEG
    /// (Ausschreibung, 1 000 kW) und § 9 Abs. 1 Nr. 3 StromStG (Befreiung, 2 000 kW).
    /// Sie standen hier als nackte Zahlen, also ein zweites Mal; ändert der Gesetzgeber
    /// eine Grenze, ändert sich der Katalog und der Dialog folgt.</para>
    /// </summary>
    public IReadOnlyList<string> Anlagenwarnungen
    {
        get
        {
            var liste = new List<string>();
            if (Kwp > (KatalogWert(DbWerte.GESETZ_EEG_AUSSCHREIBUNG_GRENZE_KW, 1000) ?? 1000))
                liste.Add(_t.WarnAusschreibung);
            if (Kwp > (KatalogWert(DbWerte.GESETZ_STROMST_GRENZE_BEFREIUNG, 2000) ?? 2000))
                liste.Add(_t.WarnStromsteuer);
            return liste;
        }
    }

    /// <summary>Dieselben Warnungen in EINER Zeile — Prüfhilfe für Tests und
    /// Auskunft für Aufrufer, die nur einen Text aufnehmen können.</summary>
    public string Anlagenwarnung => string.Join(" ", Anlagenwarnungen);

