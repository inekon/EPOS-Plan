    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _ersterAufbau)
        {
            _ersterAufbau = false;
            await _wurzel.FocusAsync();
            await BildZeichnen();
        }
    }

    // --- Eingaben ---------------------------------------------------------------

    private void Setzen(Action was)
    {
        was();
        Aktualisieren();
        _ = BildZeichnen();
    }

    /// <summary>
    /// Umschalten Kollektor ↔ Sonde. Es SPERRT nur — beide Zweige behalten ihre Werte
    /// (Abweichung A-4, Befund W10-B11).
    /// </summary>
    private void SystemUmschalten(int? welches)
    {
        _sonde = welches == SONDE;
        Aktualisieren();
        _ = BildZeichnen();
    }

    private void BodentypWaehlen(int? index)
    {
        _bodenIndex = index;
        Aktualisieren();
        _ = BildZeichnen();
    }

    private void ZoneWaehlen(int? zone)
    {
        _zone = zone ?? 0;
        Aktualisieren();
    }

    /// <summary>
    /// Die Karte hat eine Zone geliefert — sie geht in die AUSWAHLLISTE, genau wie im
    /// Vorläufer (<c>btnKarte_Click</c>:1079-1087). <c>null</c> heißt „nichts
    /// übernommen"; die Liste bleibt dann, wie sie war.
    /// </summary>
    private void ZoneVonKarte(int? zone)
    {
        _karteOffen = false;
        if (zone is null) return;
        _zone = zone;
        Aktualisieren();
    }

    // --- Anzeige ----------------------------------------------------------------

    /// <summary>
    /// Der gemeinsame Weg aller sechs Eingaben (<c>Aktualisieren</c>:800-860):
    /// Bodenkennwerte, Kennwertzeile, Auslegungsprüfung und Änderungshinweis.
    /// Das BILD zeichnet <see cref="BildZeichnen"/> — es läuft auf einem anderen Faden.
    /// </summary>
    private void Aktualisieren()
    {
        string boden = Bodentyp;
        ErdreichTemperatur.Bodenkennwerte k = ErdreichTemperatur.Bodentyp(boden);
        var ci = System.Globalization.CultureInfo.CurrentCulture;

        _bodenkennwerte = string.Format(ci, BodenkennwerteText,
            k.Lambda.ToString("0.0", ci),
            k.RhoCp.ToString("0.00", ci),
            k.A_mm2s.ToString("0.00", ci),
            k.Daempfungstiefe.ToString("0.00", ci),
            VDI4640Pruefung.BodenartAusBodentyp(boden));

        double[] profil = Profil();
        ErdreichTemperatur.Kennwerte kw = ErdreichTemperatur.ProfilKennwerte(profil);
        ErdreichTemperatur.Jahresgang jg =
            ErdreichTemperatur.AnalysiereJahresgang(Daten.Aussentemperatur);
        _kennwertzeile = kw.Zeile() + (jg.AusKlimadaten ? "" : OhneKlimadaten);

        PruefungAktualisieren(boden);
        AenderungshinweisAktualisieren();
    }

    /// <summary>Das Quelltemperaturprofil des gewählten Zweigs.</summary>
    private double[] Profil()
        => _sonde
            ? ErdreichTemperatur.JahresprofilSonde(Daten.Aussentemperatur, _laenge ?? 0)
            : ErdreichTemperatur.JahresprofilKollektor(Daten.Aussentemperatur, _tiefe ?? 0, Bodentyp);

    /// <summary>
    /// Der Bereich der Auslegungsprüfung (<c>PruefungAktualisieren</c>:863-909).
    /// Ohne Lauf steht der Hinweis da und NICHTS wird gerechnet.
    /// </summary>
    private void PruefungAktualisieren(string boden)
    {
        if (!_lauf.ErgebnisseVorhanden)
        {
            _pruefung = _lauf.HinweisErgebnis.Length > 0 ? _lauf.HinweisErgebnis : PruefungKeinLauf;
            _pruefungWarnt = false;
            return;
        }

        VDI4640Pruefung.Ergebnis erg;
        if (_sonde)
        {
            double anzahl = _anzahl ?? 0;
            erg = VDI4640Pruefung.PruefeSonde(
                ErdreichTemperatur.Bodentyp(boden).Lambda,
                (int)Math.Max(1, anzahl),
                VDI4640Pruefung.Volllaststunden(_lauf.VolllastStunden, Klimazone),
                VDI4640Pruefung.Sondenmeter(_laenge ?? 0, anzahl),
                _lauf.MaxEntzugW, boden);
        }
        else
        {
            erg = VDI4640Pruefung.PruefeKollektor(
                Klimazone, VDI4640Pruefung.BodenartAusBodentyp(boden),
                _flaeche ?? 0, _lauf.MaxEntzugW, _lauf.JahresentzugKWh, boden);
        }

        string text = erg.Anzeigetext();
        if (erg.Moeglich && erg.FestgesteinNaeherung) text += HinweisFestgestein;
        if (_lauf.HinweisVorbehalt.Length > 0)
            text += string.Format(HinweisVorbehalt, _lauf.HinweisVorbehalt);
        if (_lauf.HinweisFrost.Length > 0) text += "\n  " + _lauf.HinweisFrost;

        _pruefung = text;

        // Firebrick des Vorlaeufers (:908) - hier die Warnstufe des Banners.
        _pruefungWarnt = erg.Moeglich && erg.Warnung;
    }

    /// <summary>
    /// Der Eingabestand als Vergleichsschlüssel (<c>Eingabestand</c>:933-941). Er
    /// enthält alle sechs Größen, die in die Prüfung eingehen; das Trennzeichen kommt
    /// in keinem Wert vor.
    /// </summary>
    private string Eingabestand()
        => (_sonde ? "S" : "K") + "" + _tiefe + "" + _flaeche + "" +
           _laenge + "" + _anzahl + "" + _bodenIndex + "" +
           _zone + "" + _spreizung;

    /// <summary>
    /// Die drei Zustände des Änderungshinweises
    /// (<c>AenderungshinweisAktualisieren</c>:961-974). Ohne Lauf oder ohne Änderung
    /// steht keiner; sonst entscheidet, ob HIER gerechnet wurde.
    /// </summary>
    private void AenderungshinweisAktualisieren()
    {
        bool geaendert = !string.Equals(Eingabestand(), _standGeladen, StringComparison.Ordinal);

        _aenderungshinweis = (!_lauf.ErgebnisseVorhanden || !geaendert)
            ? ""
            : _laufAusDialog ? SimNurGespeichert : AenderungHinweis;
    }

    private async Task BildZeichnen()
    {
        if (Jahresgangmodell is null) return;

        double[] profil = Profil();
        var quelle = new double[profil.Length];
        for (int i = 0; i < profil.Length; i++) quelle[i] = profil[i];

        double[]? aussen = null;
        double[]? a = Daten.Aussentemperatur;
        if (a is not null && a.Length >= ErdreichTemperatur.STUNDEN_JAHR)
        {
            aussen = new double[ErdreichTemperatur.STUNDEN_JAHR];
            for (int i = 0; i < aussen.Length; i++) aussen[i] = a[i];
        }

        _modell = await Jahresgangmodell(quelle, aussen);
        StateHasChanged();
    }

    // --- Simulationslauf --------------------------------------------------------

    /// <summary>
    /// <c>btnSimulation_Click</c>:1014-1069 — nur läuft der Lauf hier auf einem
    /// eigenen Faden, und die Wartemeldung ist eine Überlagerung statt einer Sanduhr
    /// (Abweichung A-5, Befund W10-B9).
    /// </summary>
    private async Task SimulationStarten()
    {
        if (Simulieren is null || _laeuft) return;

        if (Daten.IdProjekt <= 0)
        {
            Melden(MsgSimOhneProjekt, WarnStufe.Hinweis);
            return;
        }

        _meldung = "";
        _laeuft = true;
        StateHasChanged();

        (ErdreichAuswertung.ErdreichLaufErgebnis? erg, string? fehler) antwort;
        try
        {
            antwort = await Simulieren(Daten.IdProjekt);
        }
        finally
        {
            _laeuft = false;
        }

        if (!string.IsNullOrEmpty(antwort.fehler))
        {
            Melden(string.Format(MsgSimFehler, antwort.fehler), WarnStufe.Warnung);
            return;
        }

        if (antwort.erg is null || !antwort.erg.Vorhanden)
        {
            Melden(MsgSimOhneErgebnis, WarnStufe.Hinweis);
            return;
        }

        _lauf = antwort.erg;
        _laufAusDialog = true;
        _meldung = "";
        Aktualisieren();
        await BildZeichnen();
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text;
        _meldungStufe = stufe;
    }

    // --- Ergebnis ---------------------------------------------------------------

    /// <summary>
    /// Die ACHT Prüfregeln aus <c>btnOk_Click</c>:1194-1264, in derselben Reihenfolge
    /// und mit demselben Wortlaut. Jede meldet und lässt den Dialog offen.
    /// </summary>
    private Task BeiErgebnis(bool ok)
    {
        if (!ok) return Geschlossen.InvokeAsync(null);

        double tiefe = 0, flaeche = 0, laenge = 0;
        int anzahl = 0;

        if (!_sonde)
        {
            if (_tiefe is null || _flaeche is null) return Meldet(MsgZahlKollektor);
            tiefe = _tiefe.Value;
            flaeche = _flaeche.Value;

            if (tiefe <= 0) return Meldet(MsgTiefeNull);
            if (tiefe > 10) return Meldet(MsgTiefeMax);
            if (flaeche <= 0) return Meldet(MsgFlaeche);
        }
        else
        {
            if (_laenge is null || _anzahl is null) return Meldet(MsgZahlSonde);
            laenge = _laenge.Value;
            anzahl = _anzahl.Value;

            if (laenge <= 0) return Meldet(MsgLaengeNull);
            if (anzahl < 1) return Meldet(MsgAnzahlMin);
        }

        if (_spreizung is null || _spreizung.Value <= 0) return Meldet(MsgSpreizung);

        _meldung = "";

        // Rueckschreiben je Zweig - :1224-1227 bzw. :1248-1251, woertlich.
        return Geschlossen.InvokeAsync(Daten with
        {
            Quellsystem = _sonde
                ? ErdreichTemperatur.QUELLSYSTEM_SONDE
                : ErdreichTemperatur.QUELLSYSTEM_KOLLEKTOR,
            Tiefe = _sonde ? laenge : tiefe,
            Flaeche = _sonde ? 0 : flaeche,
            Anzahl = _sonde ? anzahl : 0,
            Spreizung = _spreizung.Value,
            Bodentyp = Bodentyp,
            Klimazone = Klimazone
        });
    }

    private Task Meldet(string text)
    {
        Melden(text, WarnStufe.Warnung);
        return Task.CompletedTask;
    }

    /// <summary>Esc: erst die Karte, dann der Dialog (Hausregel der Überlagerungen).</summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_laeuft) return Task.CompletedTask;      // ein Lauf laesst sich nicht wegdruecken
        if (_karteOffen) { _karteOffen = false; return Task.CompletedTask; }
        return Geschlossen.InvokeAsync(null);
    }
}
