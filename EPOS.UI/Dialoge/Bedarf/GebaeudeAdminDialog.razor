    private string Flaechentext
        => _satz?.Wohnflaeche is double w
            ? w.ToString("N0", CultureInfo.CurrentCulture) + " m²"
            : ParameterVerwendung.LEER;

    private static IReadOnlyList<(int Id, string Text)> Liste(IReadOnlyList<string> quelle)
    {
        var l = new List<(int, string)>(quelle.Count);
        for (int i = 0; i < quelle.Count; i++) l.Add((i, quelle[i]));
        return l;
    }

    /// <summary>Die Einträge einer Klappliste; ein BESTANDSWERT, den die Liste nicht führt, steht vorn (-1).</summary>
    private static IReadOnlyList<(int Id, string Text)> MitBestand(IReadOnlyList<string> quelle, string bestand)
    {
        var l = new List<(int, string)>();
        if (!string.IsNullOrEmpty(bestand) && !quelle.Contains(bestand)) l.Add((-1, bestand));
        for (int i = 0; i < quelle.Count; i++) l.Add((i, quelle[i]));
        return l;
    }

    private static int? Index(IReadOnlyList<string> quelle, string wert)
    {
        if (string.IsNullOrEmpty(wert)) return null;
        for (int i = 0; i < quelle.Count; i++)
            if (string.Equals(quelle[i], wert, StringComparison.Ordinal)) return i;
        return -1;
    }

    private IReadOnlyList<(int Id, string Text)> Typeintraege => MitBestand(_typen, _arbeit.Stand.Typ);
    private IReadOnlyList<(int Id, string Text)> Arteintraege => MitBestand(_arten, _arbeit.Stand.Gebaeudeart);
    private IReadOnlyList<(int Id, string Text)> Klasseneintraege => Liste(Baualtersklassen);
    private IReadOnlyList<(int Id, string Text)> Verwendungseintraege => Liste(Verwendungen);
    private IReadOnlyList<(int Id, string Text)> Bauarteintraege => Liste(Beschriftungen.Bauarten);

    private int? Verwendungsindex(string steuerwert)
    {
        for (int i = 0; i < Verwendungswerte.Count; i++)
            if (string.Equals(Verwendungswerte[i], steuerwert, StringComparison.Ordinal)) return i;
        return null;
    }

    private string Verwendungstext(string steuerwert)
    {
        int? i = Verwendungsindex(steuerwert);
        return i is int n && n < Verwendungen.Count ? Verwendungen[n] : steuerwert;
    }

    private string Klassentext(int? index)
        => index is int i && i >= 0 && i < Baualtersklassen.Count ? Baualtersklassen[i] : "";

    private string Bauarttext(int index)
        => index >= 0 && index < Beschriftungen.Bauarten.Count ? Beschriftungen.Bauarten[index] : "";

