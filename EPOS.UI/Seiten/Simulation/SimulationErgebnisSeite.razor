@* Das SIMULATIONSERGEBNIS als Seite (iU9-W11b.13).

   VORBILD. WindowsFormsApplication1/Views/Simulation/Form_Simulation_Detail
   (7 629 Z. + 3 082 Designer) samt DashboardForm, NavigatorUebersicht,
   NavigatorStrom, NavigatorWaerme und Form_SpeicherVariantenVergleich - sechs
   Masken, 11 031 Zeilen, 21 MessageBox.

   ENTSCHEID R-W11-1. Die Komponente ist eine SEITE: SeitenZustand fuer den
   Projektwechsel, ein Eintrag in Seitenschluessel und ein Zweig in AppWurzel,
   damit iOS sie erreicht. Unter Windows erscheint sie BIS W16 in einer modalen
   Dialoghuelle (BlazorDialogForm<SimulationErgebnisSeite>, 1 474 x 821,
   Sizable) - nicht in einem neuen nicht-modalen Fenster. Gruende: (1) die
   beiden Bedarfsobjekte gehoeren Form_Start und werden von hier
   weitergeschrieben (Befund W11-B3) - nebeneinander offen waeren beide Fenster
   im Streit; (2) dieselbe Entscheidung wie W10b; (3) die Nebenlaeufigkeit des
   Laufs braucht kein nicht-modales Fenster, nur Task.Run in der Huelle.

   EIN REITER FUER ZEHN BLAETTER (Befund W11-B11). Der Vorlaeufer fuehrte DREI
   Navigationen fuer dieselbe Sache: die Reiterleiste tabControl_Simulation (auf
   drei Reiter reduziert), die Menueliste listViewQuellen (acht Fachreiter, per
   STEUERELEMENT-AUSLEIHE) und den TabListMapper, der tabControl_Einstellungen
   noch einmal in eine Menueliste umbaute - zusammen rund 700 Zeilen. Der
   Behaelter-Reiter „Simulation" (R3) war kein Fachreiter, sondern genau diese
   Menueliste; er entfaellt, und aus elf Reitern werden ZEHN Blaetter.

   BILDER ERST BEIM BETRETEN. Zwoelf PNG je Lauf im Voraus zu rechnen waere zu
   teuer (Risiko der Vermessung § 11.5). Jedes Blatt fordert seine Bilder selbst
   an, und die Seite haelt sie in einem Zwischenspeicher, dessen Schluessel die
   Schalterstellung traegt. Ein neuer Lauf leert ihn.

   DER AUTOMATIKSTART BLEIBT WOERTLICH (Befund W11-B48): Beim Oeffnen laeuft die
   Simulation von selbst an, wenn das Projekt eine Konfigurationszeile fuehrt -
   nur eben nebenlaeufig, mit Balken und Abbrechen (W11a.4). Die sichtbare
   ENDLAGE ist wie bisher die „Uebersicht". *@

@namespace EPOS.UI.Seiten.Simulation
@implements IDisposable

<div class="epos-simerg">

    @* KEIN EIGENER KOPF MEHR (Windows-Abnahme #216 vom 11.09.2026, Punkt 2).
       W11b-B-9 hatte den Titel gestrichen, weil der Wirt ihn schon trug; der
       Hilfeknopf blieb stehen - und damit stand seit #207 ein ZWEITES Paar
       [i] [KI] unmittelbar unter dem der Ansicht (Bild 1 der Abnahme). Ein Paar
       je Ansicht: Es steht in der Werkzeugleiste der SimulationSeite, und sein
       Hilfeschluessel ist derselbe (Form_Simulation_Detail.btn_Help), sobald
       Schritt ③ vorn ist. *@

    @if (_daten.Gesperrt)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_daten.Sperrgrund" />
    }

    <Fortschritt Sichtbar="@_laeuft" Anteil="@_anteil" Text="@_fortschrittText"
                 Abbrechen="@(Dienste?.Abbrechen is null ? null : EventCallback.Factory.Create(this, Abbrechen))"
                 AbbrechenText="@Resource.OPT_BTN_ABBRUCH" />

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    @* Die Laufmeldungen als anklickbares Banner - der Vorlaeufer zeigte den
       Volltext als ToolTip an einem programmatischen Label und beim Klick als
       MessageBox (:3862). *@
    @if (_daten.LaufmeldungenAnzahl > 0)
    {
        <button type="button" class="epos-simerg-knopf" @onclick="() => _volltext = true">
            @(_daten.LaufmeldungenAnzahl == 1
                ? Resource.SIM_LAUFMELDUNG_EINER
                : string.Format(Resource.SIM_LAUFMELDUNG_MEHRERE, _daten.LaufmeldungenAnzahl))
        </button>
    }

    <fieldset class="epos-simerg-bereich" disabled="@_daten.Gesperrt">

        <Reiter @ref="_reiter" @bind-Aktiv="_blatt" Bezeichnung="@Resource.SIMERG_TITEL">
            <KindInhalt>

                @* DER REITER „PARAMETER" IST MIT #216 GEFALLEN (Windows-Abnahme
                   11.09.2026, Punkt 3: „Nimm Parameter heraus"). Seine vier
                   Unterblaetter stehen jetzt in Schritt ①: die Netzverluste im
                   Abschnitt „Waermebedarf", die drei Erzeugerwerte in der
                   jeweiligen Erzeugerkarte. Damit ist die UEBERSICHT das erste
                   Blatt (Punkt 4: „Stelle die Uebersicht als erstes dar"). *@

                <Reiterblatt Schluessel="@Blatt.Uebersicht" Titel="@Resource.SIMERG_TAB_UEBERSICHT">
                    <KindInhalt>
                        <UebersichtReiter Kennzahlen="@_daten.Kennzahlen" Daten="@_daten.Uebersicht"
                                          Kuchen="@Bild(Bilder.UebersichtKuchen)"
                                          RingWaerme="@Bild(Bilder.RingWaerme)"
                                          RingStrom="@Bild(Bilder.RingStrom)"
                                          BedarfDetails="@(BedarfGabenDa ? EventCallback.Factory.Create(this, () => BedarfOeffnen(true)) : default)" />
                    </KindInhalt>
                </Reiterblatt>

                <Reiterblatt Schluessel="@Blatt.Bedarf" Titel="@Resource.SIMERG_TAB_BEDARF">
                    <KindInhalt>
                        <BedarfReiter Daten="@_daten.Bedarf" Bild="BildHolen"
                                      WaermeDetails="@(BedarfGabenDa ? EventCallback.Factory.Create(this, () => BedarfOeffnen(true)) : default)"
                                      StromDetails="@(BedarfGabenDa ? EventCallback.Factory.Create(this, () => BedarfOeffnen(false)) : default)"
                                      Csv="@Rueckruf(Dienste?.CsvBedarf)" />
                    </KindInhalt>
                </Reiterblatt>

                @if (_daten.ReiterWaermepumpe)
                {
                    <Reiterblatt Schluessel="@Blatt.Waermepumpe" Titel="@Resource.SIM_ERZEUGERNAME_WAERMEPUMPE">
                        <KindInhalt>
                            <WaermepumpeReiter Daten="@_daten.Waermepumpe" Bild="BildHolen"
                                               Speichertemperaturen="@_daten.Speichertemperaturen"
                                               ModulOeffnen="@(WpGabenDa ? EventCallback.Factory.Create(this, WaermepumpeOeffnen) : default)"
                                               Csv="@Rueckruf(Dienste?.CsvWaermepumpe)" />
                        </KindInhalt>
                    </Reiterblatt>
                }

                @if (_daten.ReiterHeizkessel)
                {
                    <Reiterblatt Schluessel="@Blatt.Heizkessel" Titel="@Resource.SIM_ERZEUGERNAME_HEIZKESSEL">
                        <KindInhalt>
                            <HeizkesselReiter Daten="@_daten.Heizkessel" Bild="BildHolen"
                                              Brennstoffe="@_daten.KesselBrennstoffe"
                                              BedarfVorhanden="@_daten.Uebersicht.WaermebedarfVorhanden"
                                              Csv="@Rueckruf(Dienste?.CsvHeizkessel)" />
                        </KindInhalt>
                    </Reiterblatt>
                }

                @if (_daten.ReiterSolarthermie)
                {
                    <Reiterblatt Schluessel="@Blatt.Solarthermie" Titel="@Resource.SIM_ERZEUGERNAME_SOLARTHERMIE">
                        <KindInhalt>
                            <SolarthermieReiter Daten="@_daten.Solarthermie" Bild="BildHolen" />
                        </KindInhalt>
                    </Reiterblatt>
                }

                @if (_daten.ReiterBhkw)
                {
                    <Reiterblatt Schluessel="@Blatt.Bhkw" Titel="@Resource.SIM_ERZEUGERNAME_BHKW">
                        <KindInhalt>
                            <BhkwReiter Daten="@_daten.Bhkw" Bild="BildHolen"
                                        Brennstoffe="@_daten.BhkwBrennstoffe"
                                        Praesent="@_daten.Uebersicht.Bhkw"
                                        WaermebedarfVorhanden="@_daten.Uebersicht.WaermebedarfVorhanden"
                                        StrombedarfVorhanden="@_daten.Uebersicht.StrombedarfVorhanden" />
                        </KindInhalt>
                    </Reiterblatt>
                }

                @if (_daten.ReiterPhotovoltaik)
                {
                    <Reiterblatt Schluessel="@Blatt.Photovoltaik" Titel="@Resource.SIM_PHOTOVOLTAIK">
                        <KindInhalt>
                            <PhotovoltaikReiter Daten="@_daten.Photovoltaik" Bild="BildHolen" />
                        </KindInhalt>
                    </Reiterblatt>
                }

                @if (_daten.ReiterStromspeicher)
                {
                    <Reiterblatt Schluessel="@Blatt.Stromspeicher" Titel="@Resource.SIM_STROMSPEICHER">
                        <KindInhalt>
                            @* W11b-B-28: Parameter, Dienste und der Optimierungsknopf
                               kommen aus dem Reiter "Parameter" hierher. Seit
                               W11b-B-29 schreibt der Block jedes Feld sofort - die
                               Uebergabe IST sein Arbeitsstand, und ein neuer
                               Lesestand nach einem Lauf loest ihn schlicht ab. *@
                            <StromspeicherReiter Daten="@_daten.Speicher" Bild="BildHolen"
                                                 Parameter="@_daten.Parameter.Speicher"
                                                 Dienste="@Dienste" Gesperrt="@_daten.Gesperrt"
                                                 OptimierungMoeglich="@(Dienste?.AuslegungOeffnen is not null)"
                                                 Optimierung="Optimierung"
                                                 Csv="@Rueckruf(Dienste?.CsvSpeicher)"
                                                 Vergleich="@(Dienste?.VergleichRechnen is null ? default : EventCallback.Factory.Create(this, VergleichOeffnen))" />
                        </KindInhalt>
                    </Reiterblatt>
                }

                <Reiterblatt Schluessel="@Blatt.Ergebnis" Titel="@Resource.SIM_ERGEBNIS">
                    <KindInhalt>
                        <ErgebnisReiter Autarkie="@_daten.Autarkie" Bild="BildHolen"
                                        KapazitaetGeaendert="KapazitaetGeaendert"
                                        UebersichtInhalt="@UebersichtNavigator"
                                        WaermegangInhalt="@Waermegang"
                                        StromgangInhalt="@Stromgang" />
                    </KindInhalt>
                </Reiterblatt>

            </KindInhalt>
        </Reiter>

    </fieldset>

    @* DIE FUSSLEISTE IST MIT #216 GEFALLEN (Windows-Abnahme 11.09.2026, Punkt 2:
       „Bringe die Elemente aus dem Dialog auf die rechte Seite"). #207 hatte aus
       vier Fussknoepfen zwei gemacht und die zwei stehen lassen, weil die Seite
       auch ohne Leiste ueber sich rechnen koennen sollte; seither standen
       „Simulation starten ▶" und „Ergebnis speichern" ZWEIMAL untereinander - in
       der Ablaufleiste und hier. Beide traegt jetzt die Werkzeugleiste der
       SimulationSeite, auf BEIDEN Plattformen dieselbe (iOS, Stufe S2):
       LaufStarten() und ErgebnisSpeichern() sind oeffentlich, SpeichernMoeglich
       sagt, ob der zweite Knopf handeln darf. *@

    @* ================================================================
       Die Ueberlagerungen - alles in EINEM Fenster (Risiko R2)
       ================================================================ *@

    @if (_volltext)
    {
        <Ueberlagerung Offen="true" Titel="@Resource.SIM_TITEL_MELDUNGEN_LAUF"
                       Geschlossen="() => _volltext = false">
            <KindInhalt>
                <Textfeld Wert="@_daten.Laufmeldungen" Mehrzeilig="true" Zeilen="12"
                          NurLesen="true" Festbreite="true" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @* DIE KONFIGURATION STAND HIER als zweite UEBERLAGERUNG in der Ueberlagerung,
       die diese Seite selbst war - Fenster im Fenster im Fenster. Seit Auftrag
       #207 ist sie Schritt ① DERSELBEN Ansicht (Anwenderentscheid SIM-Q1); ein
       Klick auf die Ablaufleiste bringt sie, und die Seite hier weiss nichts mehr
       davon. *@

    @if (_bedarf is not null)
    {
        <Ueberlagerung Offen="true" Titel="@Resource.SIMERG_TAB_BEDARF" Geschlossen="() => _bedarf = null">
            <KindInhalt>
                <EPOS.UI.Dialoge.Bedarf.BedarfErgebnisDialog @attributes="_bedarf"
                                                             Geschlossen="() => _bedarf = null" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @if (_waermepumpe is not null)
    {
        <Ueberlagerung Offen="true" Titel="@Resource.SIM_ERZEUGERNAME_WAERMEPUMPE"
                       Geschlossen="() => _waermepumpe = null">
            <KindInhalt>
                <EPOS.UI.Dialoge.Waermepumpe.WaermepumpenDialog @attributes="_waermepumpe"
                                                                Geschlossen="WaermepumpeFertig" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @* Die AUSLEGUNGSOPTIMIERUNG stand hier bis Paket P3 (#192) als UEBERLAGERUNG
       (W11b-B-5) - und davor als modales WinForms-Fenster. Der Anwender hat beides
       zurueckgegeben: „Fenster in Fenster ist nicht gut" (11.09.2026). Sie ist jetzt
       eine FREIE ANSICHT der AppWurzel (STROMSPEICHER_AUSLEGUNG); der Knopf des
       Stromspeicher-Reiters WECHSELT die Ansicht, statt eine Ueberlagerung
       aufzuziehen - dasselbe Muster wie W16c-E-3 bei „Varianten und Bericht…". *@

    @if (_vergleichOffen)
    {
        <Ueberlagerung Offen="true" Titel="@Resource.VAR_VGL_TITEL" Geschlossen="VergleichSchliessen">
            <KindInhalt>
                <SpeicherVariantenVergleich Daten="@_vergleich" Laeuft="@_vergleichLaeuft"
                                            Anteil="@_vergleichAnteil"
                                            FortschrittText="@_vergleichText"
                                            AktivSetzen="VarianteAktivSetzen"
                                            Csv="@(Dienste?.VergleichCsv is null ? default : EventCallback.Factory.Create(this, VergleichCsv))"
                                            Geschlossen="VergleichSchliessen" />
            </KindInhalt>
        </Ueberlagerung>
    }

</div>

@code {
    /// <summary>
    /// Die sprachneutralen Schluessel der NEUN Blaetter.
    ///
    /// <para><b>Es waren zehn.</b> Mit Auftrag #216 (Windows-Abnahme 11.09.2026,
    /// Punkte 3 und 4) ist „PARAMETER" gefallen — seine Felder stehen in Schritt ①
    /// —, und die UEBERSICHT steht vorn: „Stelle die Uebersicht als erstes dar".</para>
    /// </summary>
    public static class Blatt
    {
        public const string Uebersicht = "UEBERSICHT";
        public const string Bedarf = "BEDARF";
        public const string Waermepumpe = "WAERMEPUMPE";
        public const string Heizkessel = "HEIZKESSEL";
        public const string Solarthermie = "SOLARTHERMIE";
        public const string Bhkw = "BHKW";
        public const string Photovoltaik = "PHOTOVOLTAIK";
        public const string Stromspeicher = "STROMSPEICHER";
        public const string Ergebnis = "ERGEBNIS";
    }

    // =====================================================================
    // Parameter
    // =====================================================================

    /// <summary>Die Datenseite; ohne sie zeigt die Seite ein leeres Ergebnis.</summary>
    [Parameter] public SimulationErgebnisDienste? Dienste { get; set; }

    /// <summary>Der geteilte Zustand der Huelle: Projektwechsel und Auffrischen.</summary>
    [Parameter] public EPOS.UI.Dienste.SeitenZustand? Zustand { get; set; }

    /// <summary>Das Projekt beim Aufbau, wenn kein <see cref="Zustand"/> gesetzt ist.</summary>
    [Parameter] public int StartProjekt { get; set; }

    /// <summary>
    /// Startet der Lauf beim Oeffnen von selbst? Woertlich <c>true</c>
    /// (Befund W11-B48); die Proben schalten ihn ab.
    /// </summary>
    /// <remarks>
    /// <b>Die Ansicht SIMULATION schaltet ihn AB</b> (Auftrag #207): Dort ist der
    /// Lauf Schritt ② der Ablaufleiste und damit ein bewusster Klick. Der
    /// Automatikstart war die Antwort darauf, dass ein Ergebnisfenster ohne Lauf
    /// leer gewesen waere; in der Ablaufansicht ist ③ ohne Lauf gar nicht erst
    /// betretbar, und ein zweiter Lauf bei jeder Rueckkehr aus der
    /// Stromspeicher-Auslegung waere reine Wartezeit.
    /// </remarks>
    [Parameter] public bool Automatikstart { get; set; } = true;

    /// <summary>
    /// Der Stand hat sich geaendert, an dem die Werkzeugleiste des Wirts haengt
    /// (Auftrag #216) — ein Lauf hat begonnen oder geendet, ein Ergebnis wurde
    /// gespeichert, die Seite hat neu geladen.
    /// </summary>
    [Parameter] public EventCallback StandGeaendert { get; set; }

    /// <summary>
    /// Das Reiterblatt, mit dem die Seite aufmacht (einer der Schluessel aus
    /// <see cref="Blatt"/>); leer = die Vorgabe. Sie liest ihn EINMAL beim Aufbau.
    /// </summary>
    /// <remarks>
    /// Die MARKE des Rueckwegstapels kommt hier an (Auftrag #207): Wer die
    /// Stromspeicher-Auslegung verlaesst, steht wieder auf dem Reiter
    /// „Stromspeicher" und liest dort das Banner „Flotte geaendert".
    /// </remarks>
    [Parameter] public string StartBlatt { get; set; } = "";

    // Der Parameter HilfeSchluessel ist mit #216 entfallen: Die Seite traegt
    // keinen Infoknopf mehr, und den der Ansicht setzt SimulationSeite.

    // =====================================================================
    // Zustand
    // =====================================================================

    private SimulationErgebnisDaten _daten = new SimulationErgebnisDaten();
    private readonly Dictionary<string, byte[]?> _bilder = new Dictionary<string, byte[]?>();

    private Reiter? _reiter;

    /// <summary>
    /// Das sichtbare Blatt. Vorgabe ist die UEBERSICHT (Windows-Abnahme #216,
    /// Punkt 4) — bis dahin stand der Reiter „Parameter" vorn und der
    /// Automatikstart schaltete danach auf die Uebersicht weiter.
    /// </summary>
    private string _blatt = Blatt.Uebersicht;

    private bool _laeuft;
    private double? _anteil;
    private string _fortschrittText = "";

    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Warnung;

    private bool _volltext;
    private IReadOnlyDictionary<string, object>? _bedarf;
    private IReadOnlyDictionary<string, object>? _waermepumpe;

    private bool _vergleichOffen;
    private bool _vergleichLaeuft;
    private double? _vergleichAnteil;
    private string _vergleichText = "";
    private VergleichDaten _vergleich = new VergleichDaten();

    private bool _startGelaufen;

    /// <summary>Das offene Projekt.</summary>
    public int IdProjekt => Zustand?.ProjektId ?? StartProjekt;

    /// <summary>Das sichtbare Blatt (Pruefhilfe).</summary>
    public string AktivesBlatt => _reiter?.AktiverSchluessel ?? _blatt;

    /// <summary>Laeuft die Simulation gerade? (Pruefhilfe)</summary>
    public bool Laeuft => _laeuft;

    private bool BedarfGabenDa => Dienste?.BedarfGaben is not null;
    private bool WpGabenDa => Dienste?.WaermepumpenGaben is not null;

    // =====================================================================
    // Laden
    // =====================================================================

    protected override void OnInitialized()
    {
        if (Zustand is not null) Zustand.Geaendert += BeiZustand;
        if (!string.IsNullOrEmpty(StartBlatt)) _blatt = StartBlatt;
        Neuladen();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (Zustand is not null) Zustand.Geaendert -= BeiZustand;
    }

    private void BeiZustand()
        => _ = InvokeAsync(() => { Neuladen(); StateHasChanged(); });

    private void Neuladen()
    {
        _bilder.Clear();
        _daten = Dienste?.Laden?.Invoke(IdProjekt) ?? new SimulationErgebnisDaten();
    }

    /// <summary>
    /// Der AUTOMATIKSTART (Befund W11-B48) — woertlich wie in
    /// <c>Form_Simulation_Detail_Load</c> :3325-3336: Bei Sperre geht es ohne Lauf
    /// auf die „Uebersicht"; sonst laeuft die Simulation an, und die sichtbare
    /// Endlage ist ebenfalls die „Uebersicht".
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _startGelaufen) return;
        _startGelaufen = true;

        if (_daten.Gesperrt)
        {
            Blattwahl(Blatt.Uebersicht);
            StateHasChanged();
            return;
        }

        // OHNE Automatikstart bleibt das Blatt stehen, mit dem die Seite aufgemacht
        // hat - die Marke aus dem Rueckwegstapel (#207) oder die Vorgabe.
        if (!Automatikstart || Dienste?.Laufen is null) return;

        await LaufStarten();
        Blattwahl(Blatt.Uebersicht);
        StateHasChanged();
    }

    private void Blattwahl(string schluessel)
    {
        // Der Reiter liest Aktiv beim naechsten Zeichnen - das Bindepaar
        // gehoert dem Wirt (Baustein Reiter, Kopfkommentar).
        _blatt = schluessel;
    }

    /// <summary>
    /// Stellt das Reiterblatt von aussen ein (Auftrag #207) — der Weg der MARKE,
    /// wenn die Seite schon steht und <see cref="StartBlatt"/> deshalb nicht mehr
    /// gelesen wird. Ein unbekanntes Blatt lässt der Baustein <c>Reiter</c> von
    /// selbst liegen.
    /// </summary>
    public void BlattWaehlen(string schluessel)
    {
        if (string.IsNullOrEmpty(schluessel)) return;

        Blattwahl(schluessel);
        StateHasChanged();
    }

    // =====================================================================
    // Der Lauf
    // =====================================================================

    /// <summary>
    /// Startet den Lauf — der Fussknopf dieser Seite und Schritt ② der Ansicht
    /// SIMULATION gehen denselben Weg (Auftrag #207). Ein laufender Lauf wird
    /// nicht zweimal gestartet.
    /// </summary>
    public async Task LaufStarten()
    {
        if (_laeuft || Dienste?.Laufen is null) return;

        _laeuft = true;
        _anteil = null;
        _fortschrittText = Resource.SIMERG_LAUF_LAEUFT;
        _meldung = "";
        StateHasChanged();
        Melden();

        Rueckmeldung antwort;
        try
        {
            antwort = await Dienste.Laufen(Melden);
        }
        finally
        {
            _laeuft = false;
        }

        Neuladen();

        if (!antwort.Erfolg && !string.IsNullOrEmpty(antwort.Text))
        {
            _meldung = antwort.Text;
            _meldungStufe = WarnStufe.Fehler;
        }

        StateHasChanged();
        Melden();
    }

    /// <summary>
    /// Die Phasenmeldung des Kerns. Sie kommt aus dem Hintergrundfaden ueber
    /// <c>Progress&lt;T&gt;</c> - also bereits auf dem Bedienfaden.
    /// </summary>
    private void Melden(double? anteil, string text)
    {
        _anteil = anteil;
        _fortschrittText = string.IsNullOrEmpty(text) ? Resource.SIMERG_LAUF_LAEUFT : text;
        _ = InvokeAsync(StateHasChanged);
    }

    private void Abbrechen() => Dienste?.Abbrechen?.Invoke();

    /// <summary>
    /// „Ergebnis speichern" — seit #216 der Weg der WERKZEUGLEISTE der Ansicht
    /// (der Fussknopf dieser Seite ist mit ihr gefallen).
    /// </summary>
    public void ErgebnisSpeichern()
    {
        Rueckmeldung antwort = Dienste?.Speichern?.Invoke() ?? Rueckmeldung.Still;
        _meldung = antwort.Text;
        _meldungStufe = antwort.Erfolg ? WarnStufe.Erfolg : WarnStufe.Fehler;
        StateHasChanged();
        Melden();
    }

    /// <summary>
    /// Darf „Ergebnis speichern" handeln? Nur nach einem VOLLSTAENDIGEN Lauf und
    /// nicht waehrend eines laufenden — die Zustandsmaschine aus Nacharbeit
    /// Paket 8, Befund N1, unveraendert; sie steht seit #216 nur an einem anderen
    /// Knopf.
    /// </summary>
    public bool SpeichernMoeglich => !_laeuft && _daten.ErgebnisGueltig;

    /// <summary>
    /// Sagt dem Wirt, dass sich der Stand geaendert hat, an dem seine
    /// Werkzeugleiste haengt (<see cref="SpeichernMoeglich"/>). Ohne diese
    /// Meldung bliebe „Ergebnis speichern" nach einem Lauf gesperrt stehen, bis
    /// den Wirt etwas anderes neu zeichnet.
    /// </summary>
    private void Melden()
    {
        if (StandGeaendert.HasDelegate) _ = StandGeaendert.InvokeAsync();
    }

    // =====================================================================
    // Bilder - erst beim Betreten, dann zwischengespeichert
    // =====================================================================

    private byte[]? BildHolen(Bildauftrag auftrag)
    {
        if (Dienste?.Bild is null) return null;

        string schluessel = auftrag.Schluessel;
        if (_bilder.TryGetValue(schluessel, out byte[]? vorhanden)) return vorhanden;

        byte[]? neu = Dienste.Bild(auftrag);
        _bilder[schluessel] = neu;
        return neu;
    }

    private byte[]? Bild(string bild) => BildHolen(new Bildauftrag(bild));

    // =====================================================================
    // Die Ueberlagerungen
    // =====================================================================

    private void BedarfOeffnen(bool waerme) => _bedarf = Dienste?.BedarfGaben?.Invoke(waerme);

    private void WaermepumpeOeffnen() => _waermepumpe = Dienste?.WaermepumpenGaben?.Invoke();

    /// <summary>
    /// Der Waermepumpendialog meldet <c>true</c>, wenn die Auswahl uebernommen
    /// wurde; dann schreibt die Huelle die Anlagen um und die Seite laedt neu
    /// (woertlich <c>listView_SimWP_MouseDown</c> :5145-5150).
    /// </summary>
    private void WaermepumpeFertig(bool uebernommen)
    {
        _waermepumpe = null;
        Dienste?.WaermepumpenFertig?.Invoke(uebernommen);
        Neuladen();
    }

    /// <summary>
    /// Wechselt auf die Ansicht „Stromspeicher-Auslegung" (Paket P3, #192).
    /// </summary>
    /// <remarks>
    /// <para><b>Ansicht wechseln statt Überlagerung</b> — Muster <b>W16c‑E‑3</b>. Bis
    /// hierher zog dieser Knopf eine modale Überlagerung über die Ergebnisseite auf,
    /// und deren CSV-Unterdialog eine zweite darin; der Anwender hat genau das
    /// zurückgegeben („Fenster in Fenster ist nicht gut", 11.09.2026).</para>
    /// <para>Die Hülle stellt dabei ihren gerechneten Simulationslauf bereit — die
    /// EPOS-Zeitreihen der Auslegung stammen aus IHM — und meldet danach den
    /// Seitenschlüssel an die Wurzel.</para>
    /// </remarks>
    private void Optimierung() => Dienste?.AuslegungOeffnen?.Invoke();

    private async Task VergleichOeffnen()
    {
        if (Dienste?.VergleichRechnen is null) return;

        _vergleichOffen = true;
        _vergleichLaeuft = true;
        _vergleichAnteil = null;
        _vergleichText = "";
        StateHasChanged();

        try
        {
            _vergleich = await Dienste.VergleichRechnen(VergleichMelden);
        }
        finally
        {
            _vergleichLaeuft = false;
        }

        StateHasChanged();
    }

    private void VergleichMelden(double? anteil, string text)
    {
        _vergleichAnteil = anteil;
        _vergleichText = text;
        _ = InvokeAsync(StateHasChanged);
    }

    private void VergleichSchliessen()
    {
        _vergleichOffen = false;
        _vergleich = new VergleichDaten();
    }

    /// <summary>
    /// Nach dem Umstellen der aktiven Variante laedt die Parameterseite neu — sie
    /// zeigt immer die AKTIVE Variante. Neu gerechnet wird bewusst nicht
    /// (<c>btn_SpVariantenVergleich_Click</c> :7259-7267).
    /// </summary>
    private void VarianteAktivSetzen(int idAnlage)
    {
        Rueckmeldung antwort = Dienste?.VarianteAktivSetzen?.Invoke(idAnlage) ?? Rueckmeldung.Still;
        if (!antwort.Erfolg)
        {
            _meldung = antwort.Text;
            _meldungStufe = WarnStufe.Fehler;
            return;
        }

        Neuladen();
    }

    private async Task VergleichCsv()
    {
        if (Dienste?.VergleichCsv is null) return;

        Rueckmeldung antwort = await Dienste.VergleichCsv();
        if (!string.IsNullOrEmpty(antwort.Text))
        {
            _meldung = antwort.Text;
            _meldungStufe = antwort.Erfolg ? WarnStufe.Erfolg : WarnStufe.Fehler;
        }
    }

    private void KapazitaetGeaendert(double kwh)
    {
        AutarkieDaten? neu = Dienste?.AutarkieRechnen?.Invoke(kwh);
        if (neu is null) return;

        _daten.Autarkie = neu;

        // Das Monatsbild haengt an der Kapazitaet - sein Schluessel traegt sie,
        // der Zwischenspeicher trennt die Staende also von selbst.
        StateHasChanged();
    }

    // =====================================================================
    // Die Inhalte des Ergebnisreiters
    // =====================================================================

    private RenderFragment UebersichtNavigator => @<UebersichtReiter
        Kennzahlen="@_daten.Kennzahlen" Daten="@_daten.Uebersicht" NurNavigator="true"
        RingWaerme="@Bild(Bilder.RingWaerme)" RingStrom="@Bild(Bilder.RingStrom)"
        BedarfDetails="@(BedarfGabenDa ? EventCallback.Factory.Create(this, () => BedarfOeffnen(true)) : default)" />;

    private RenderFragment Waermegang => @<WaermegangReiter
        Daten="@_daten.Waermegang" Bild="BildHolen"
        Csv="@(Dienste?.CsvWaermegang is null ? default
                : EventCallback.Factory.Create<(int, IReadOnlyList<string>, IReadOnlyList<string>)>(
                      this, w => Dienste!.CsvWaermegang!(w.Item1, w.Item2, w.Item3)))" />;

    private RenderFragment Stromgang => @<StromgangReiter
        Daten="@_daten.Stromgang" Bild="BildHolen"
        Csv="@(Dienste?.CsvStromgang is null ? default
                : EventCallback.Factory.Create<IReadOnlyList<string>>(this, r => Dienste!.CsvStromgang!(r)))" />;

    /// <summary>Ein Rueckruf aus einem Delegaten; ohne Delegat bleibt der Knopf weg.</summary>
    private EventCallback Rueckruf(Action? aktion)
        => aktion is null ? default : EventCallback.Factory.Create(this, aktion);
}
