    protected override void OnInitialized()
    {
        // Der Filterstand je Katalog ueber die Sitzung - derselbe Eintrag wie in der
        // Gebaeudeverwaltung (Schluessel des Profils, "GEBAEUDE").
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Profil.Schluessel);

        KatalogLaden();
        ProjektauswahlNachziehen();

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE, () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent liest die Maske und stellt ihren Filter (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GebaeudeKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten auf die LEBENDEN Felder — einmal gebaut, danach nur
    /// noch gelesen; ihre Delegaten greifen bei jedem Zugriff neu zu. Die vier Filterfelder
    /// sind Suche und Trichter der Katalogliste (Welle K): Setzen heißt, den Ausdruck in den
    /// Filterstand tippen; die Liste filtert beim nächsten Zeichnen neu.
    /// </summary>
    private GebaeudeKiSicht KiSicht()
    {
        return _kiSicht ??= new GebaeudeKiSicht
        {
            VerwendungLesen = () => _filterstand.Ausdruck(Katalogfilterprofil.SpVerwendung),
            VerwendungSetzen = w => _filterstand.Setzen(Katalogfilterprofil.SpVerwendung, w),
            VerwendungEintraege = () => Spaltenwahl(Katalogfilterprofil.SpVerwendung),

            FilterGebaeudeartLesen = () => _filterstand.Ausdruck(Katalogfilterprofil.SpGebaeudeart),
            FilterGebaeudeartSetzen = w => _filterstand.Setzen(Katalogfilterprofil.SpGebaeudeart, w),
            GebaeudeartEintraege = () => Spaltenwahl(Katalogfilterprofil.SpGebaeudeart),

            FilterBaujahrLesen = () => _filterstand.Ausdruck(Katalogfilterprofil.SpBaualtersklasse),
            FilterBaujahrSetzen = w => _filterstand.Setzen(Katalogfilterprofil.SpBaualtersklasse, w),
            BaujahrEintraege = () => Spaltenwahl(Katalogfilterprofil.SpBaualtersklasse),

            SucheLesen = () => _filterstand.Suche,
            SucheSetzen = muster => _filterstand.Suche = muster ?? "",

            NameLesen = () => _detailName,
            GebaeudeartLesen = () => _detailArt,
            BeschreibungLesen = () => _detailBeschreibung,
            WohnflaecheLesen = () => _detailWohnflaeche,
            AngabeartLesen = () => _detailEinheit
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>Kein Speicherweg.</b> Die Maske schreibt nicht: Jede Katalogaktion geht
    /// über ihren eigenen Knopf in die Datenbank, und die Projektliste gehört dem Wirt,
    /// der sie beim OK übernimmt. <c>dialog_speichern</c> lehnt deshalb benannt ab.</para>
    /// <para><b>Kein Schreibschutz.</b> Ob ein Katalogsatz zur Auslieferung gehört,
    /// entscheidet der Löschweg der Hülle und nicht diese Maske.</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>
    /// Zieht die Markierung der Projektliste nach, sobald der Wirt eine ANDERE
    /// Liste hereinreicht (Befund <b>W9‑B‑1</b> der Windows-Abnahme vom 05.09.2026).
    ///
    /// <para><b>Warum das nötig ist.</b> Die Hülle baut die Anzeigeliste bei jedem
    /// <c>Gaben</c>-Aufruf NEU aus ihrer Fachliste (<c>GebaeudeHuelle.Gaben</c>
    /// :113‑114); die Zeilenobjekte sind danach andere. Wer die Markierung an der
    /// Objektgleichheit festmacht, verliert sie bei jedem solchen Austausch — der
    /// Anwender sah sein gespeichertes Gebäude in der Liste stehen, aber unmarkiert,
    /// und der Detailblock hing an einer Zeile, die es nicht mehr gab. Der Schlüssel
    /// ist die <see cref="GebaeudeProjektZeile.IdZ"/> (<c>Z_ProjektGebaeude.ID</c>) —
    /// dieselbe, an der „▶" hängt.</para>
    ///
    /// <para>Und der zweite Fall: Kommt die Liste erst NACH dem ersten Zeichnen
    /// (der Ladeweg des Assistenten läuft im Verlassen der Projektkopfseite), stand
    /// bis hierher für immer keine Markierung. Jetzt markiert die erste Zeile, sobald
    /// eine da ist — wie <c>Form_Gebaeude_Load</c>.</para>
    /// </summary>
    protected override void OnParametersSet()
    {
        // Der Kopf der Wahlspalte der Katalogliste kommt ueber den eigenen Text des
        // Wirtes - dasselbe Wort wie in der Projektliste darueber.
        Filtertexte.SpalteWahl = SpalteWahl;
        ProjektauswahlNachziehen();
    }

    private void ProjektauswahlNachziehen()
    {
        if (_gewaehlt is not null)
        {
            // Dieselbe Zeile noch in der Liste? Dann ist nichts zu tun.
            foreach (GebaeudeProjektZeile z in Zeilen)
                if (ReferenceEquals(z, _gewaehlt)) return;

            // Sonst dieselbe ZUORDNUNG suchen - die IdZ, nicht die Stamm-Id.
            foreach (GebaeudeProjektZeile z in Zeilen)
                if (z.IdZ == _gewaehlt.IdZ) { ProjektzeileWaehlen(z); return; }

            _gewaehlt = null;
        }

        // Der Anwender steht im Katalog - seine Wahl wird nicht ueberschrieben.
        if (_katalogzeile is not null) return;

        if (Zeilen.Count > 0) ProjektzeileWaehlen(Zeilen[0]);
    }

    /// <summary>
    /// Ist diese Zeile die markierte? Verglichen wird über die
    /// <see cref="GebaeudeProjektZeile.IdZ"/>, nicht über die Objektgleichheit
    /// (Befund W9‑B‑1).
    /// </summary>
    private bool IstGewaehlt(GebaeudeProjektZeile z)
        => _gewaehlt is not null && (ReferenceEquals(z, _gewaehlt) || z.IdZ == _gewaehlt.IdZ);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =================================================================================
    // Der Katalog - die Katalogliste des Hauses (Stufe G3, Welle K)
    // =================================================================================

    /// <summary>
    /// Liest den Katalog neu — beim Öffnen und nach einem SCHREIBweg (Editor, Import,
    /// Löschen). Der FILTER ruft sie nicht: Er wirkt auf die Anzeige, und die Einschränkung
    /// macht der Kern in der <c>Katalogliste</c>. Die Wahl bleibt am Schlüssel stehen, solange
    /// es den Satz noch gibt.
    /// </summary>
    private void KatalogLaden()
    {
        _katalog = Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();

        _katalogzeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogzeile is null) _katalogGewaehlt = "";
    }

    /// <summary>Der Katalogsatz zu einem Schlüssel; <c>null</c>, wenn es ihn nicht gibt.</summary>
    private Katalogfilterzeile? Katalogsatz(string schluessel)
    {
        if (string.IsNullOrEmpty(schluessel)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Schluessel == schluessel) return z;
        return null;
    }

    /// <summary>
    /// Die Zeilen, die die Liste gerade ZEIGT — gefiltert und sortiert nach demselben Stand
    /// und derselben Rechnung wie die <c>Katalogliste</c> (<c>Katalogfilter.Anwenden</c>).
    /// Gebraucht nur beim Entfernen, das die erste sichtbare Katalogzeile wählt.
    /// </summary>
    private IReadOnlyList<Katalogfilterzeile> Sichtbar
        => Katalogfilter.Anwenden(Profil, _katalog, _filterstand);

    /// <summary>
    /// Die Einträge eines Filterfeldes für den Assistenten: jeder Wert, der in der Spalte
    /// steht, einmal und sortiert — genau das, was der Trichter treffen kann. Schlüssel ist
    /// der Anzeigetext, denn der Trichter filtert auf dem, was in der Zelle steht.
    /// </summary>
    private IReadOnlyList<KiKern.KiWahleintrag> Spaltenwahl(string spalte)
    {
        var werte = new SortedSet<string>(StringComparer.CurrentCulture);
        foreach (Katalogfilterzeile z in _katalog)
        {
            string text = z.Text(spalte);
            if (!string.IsNullOrWhiteSpace(text) && text != ParameterVerwendung.LEER) werte.Add(text);
        }
        return KiMaskenanmeldung.Eintraege(werte, w => w);
    }

    // =================================================================================
    // Auswahl und Detailblock
    // =================================================================================

    private void ProjektzeileWaehlen(GebaeudeProjektZeile z)
    {
        _gewaehlt = z;
        _katalogzeile = null;
        _katalogGewaehlt = "";
        _detailName = z.Name;
        _detailArt = z.Art;
        _detailBeschreibung = z.Beschreibung;
        _detailWohnflaeche = z.Wohnflaeche.ToString("F2");
        _detailEinheit = z.Einheit;
        _detailHges = Leitwert(z.HgesWK);
        _detailRechenweg = z.Rechenweg;
    }

    /// <summary>Der Wärmeleitwert als Anzeige — „—" ohne Wert, nie eine erfundene Zahl.</summary>
    private static string Leitwert(double? wk)
        => wk.HasValue ? wk.Value.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " W/K" : "—";

    /// <summary>
    /// Die Katalogliste meldet eine Zeile: Der Katalogsatz füllt den Detailblock aus den
    /// STAMMDATEN; Einheit „Wohnfläche [m²]" und ein leerer Jahresnutzungsgrad
    /// (<c>listBox_Gebaeude_DB_SelectedIndexChanged</c>:585-592). Die Projektmarkierung fällt.
    /// </summary>
    private void KatalogzeileWaehlen(string schluessel)
    {
        Katalogfilterzeile? k = Katalogsatz(schluessel ?? "");
        if (k is null) return;

        _katalogGewaehlt = k.Schluessel;
        _katalogzeile = k;
        _gewaehlt = null;

        GebaeudeStammDetail? detail = StammDetail?.Invoke(k.Bezeichner);
        _detailName = detail?.Name ?? k.Bezeichner;
        _detailArt = detail?.Art ?? k.Text(Katalogfilterprofil.SpGebaeudeart);
        _detailBeschreibung = detail?.Beschreibung ?? "";
        _detailWohnflaeche = detail?.Wohnflaeche ?? k.Text(Katalogfilterprofil.SpFlaecheM2);
        _detailEinheit = "Wohnfläche [m²]";
        _detailHges = Leitwert(detail?.HgesWK);
        _detailRechenweg = detail?.Rechenweg ?? "";
    }

    // =================================================================================
    // Uebernehmen und Entfernen
    // =================================================================================

    private void BeiHinzu()
    {
        if (_katalogzeile is null || StammSatz is null) return;

        GebaeudeProjektZeile? neu = StammSatz(_katalogzeile.Bezeichner);
        if (neu is null) return;

        Zeilen.Add(neu);
        ProjektzeileWaehlen(neu);
        Geaendert?.Invoke();
        _meldung = "";
    }

    /// <summary>
    /// Entfernt GENAU die gewählte Zeile über ihre <c>IdZ</c> — die Stamm-Id ist bei zwei
    /// gleichen Gebäuden nicht eindeutig (<c>btn_Entfernen_Click</c>:283-287). Ist die
    /// Projektliste danach leer, steht die erste SICHTBARE Katalogzeile im Detailblock.
    /// </summary>
    private void BeiEntfernen()
    {
        if (_gewaehlt is null) return;

        // Stufe G6a (A2): Ein Gebaeude mit Zonen geht erst nach der Rueckfrage - die Kaskade
        // loescht Zonen und Bauteile mit dem Speichern der Liste.
        if (_gewaehlt.Zonenzahl > 0) { _ausProjektFrage = true; return; }
        Entfernen();
    }

    /// <summary>Die Antwort: Ja entfernt die Zeile, Nein lässt alles stehen.</summary>
    private void AusProjektBeantwortet(bool? antwort)
    {
        _ausProjektFrage = false;
        if (antwort == true) Entfernen();
    }

    private void Entfernen()
    {
        if (_gewaehlt is null) return;

        Zeilen.Remove(_gewaehlt);
        _gewaehlt = Zeilen.Count > 0 ? Zeilen[0] : null;

        if (_gewaehlt is not null) ProjektzeileWaehlen(_gewaehlt);
        else
        {
            IReadOnlyList<Katalogfilterzeile> sichtbar = Sichtbar;
            if (sichtbar.Count > 0) KatalogzeileWaehlen(sichtbar[0].Schluessel);
        }
        Geaendert?.Invoke();
        _meldung = "";
    }

    // =================================================================================
    // Ueberlagerungen
    // =================================================================================

    private void BeiKatalogAendern()
    {
        if (KatalogGaben is null) return;
        if (_katalogzeile is null) { Melden(MeldungKeineWahl, WarnStufe.Warnung); return; }

        _meldung = "";
        _katalogGaben = KatalogGaben(_katalogzeile.Bezeichner);
    }

    private void BeiKatalogNeu()
    {
        if (KatalogGaben is null) return;
        _meldung = "";
        _katalogGaben = KatalogGaben("");
    }

    /// <summary>
    /// Der Katalogeditor ist zu — <paramref name="gespeichert"/> ist sein Ausgang (<c>true</c>
    /// nach einem Speichern). Kam er aus einem Import, nimmt der Dialog das neue Gebäude jetzt in
    /// die Projektliste auf — derselbe Weg wie „In das Projekt übernehmen", Arbeitsstand bis zum OK
    /// dieses Dialogs; ohne Speichern verfällt der Import samt Herkunft.
    /// </summary>
    private void KatalogeditorFertig(bool gespeichert)
    {
        _katalogGaben = null;
        GebaeudeImportweg? import = _importweg;
        _importweg = null;
        KatalogLaden();   // SetGebaeudeDB() nach dem Schliessen

        if (import is null || !gespeichert) return;
        GebaeudeProjektZeile? neu = import.Aufnehmen();
        if (neu is null) return;

        Zeilen.Add(neu);
        ProjektzeileWaehlen(neu);
        Geaendert?.Invoke();
        Melden(Format(MeldungImportAufgenommen, neu.Name), WarnStufe.Hinweis);
    }

    // =================================================================================
    // Der Gebaeudeimport (Stufe G4, Welle 4; A17)
    // =================================================================================

    /// <summary>„Importieren (gbXML, IFC)…" — der Zuordnungsdialog als Überlagerung.</summary>
    private void BeiImport()
    {
        if (ImportGaben is null) return;
        _meldung = "";
        _importweg = ImportGaben();
        _importGaben = _importweg?.Gaben;
        if (_importGaben is null) _importweg = null;
    }

    /// <summary>
    /// Der Zuordnungsdialog ist zu: mit Ergebnis nach seinem OK (der <c>Uebernehmen</c>-Delegat
    /// des Wirts hat die Vorbelegung gebaut) — dann öffnet der Katalogeditor im Modus Neu,
    /// vorbelegt; <c>null</c> bei Abbrechen, ✕ und Esc — dann ist nichts geschehen.
    /// </summary>
    private void ImportFertig(GebaeudeImportErgebnis? ergebnis)
    {
        _importGaben = null;
        if (ergebnis is null || _importweg is null)
        {
            _importweg = null;
            return;
        }

        _katalogGaben = _importweg.EditorGaben();
        if (_katalogGaben is null) _importweg = null;
    }

    private static string Format(string vorlage, params object?[] werte)
    {
        try { return string.Format(System.Globalization.CultureInfo.CurrentCulture, vorlage ?? "", werte); }
        catch (FormatException) { return vorlage ?? ""; }
    }

    private void BeiAendern()
    {
        if (_gewaehlt is null || WohnflaecheGaben is null) return;
        _meldung = "";
        _wohnflaecheGaben = WohnflaecheGaben(_gewaehlt);
    }

    /// <summary>
    /// „Hülle und Zonen…" (G3, Welle D2) — der Editor der Projektkopie als Überlagerung. Ohne
    /// Projektkopie meldet der Knopf seinen Grund.
    /// </summary>
    private void BeiProjekt()
    {
        if (_gewaehlt is null || ProjektGaben is null) return;
        if (!_gewaehlt.HatProjektkopie) { Melden(SperreNeueZeile, WarnStufe.Hinweis); return; }
        _meldung = "";
        _projektGaben = ProjektGaben(_gewaehlt);
        if (_projektGaben is null) Melden(SperreNeueZeile, WarnStufe.Hinweis);
    }

    /// <summary>
    /// Der Editor der Projektkopie ist zu: Hat er geschrieben, liest die Zeile Rechenweg,
    /// Wärmeleitwert und Zone neu (der Detailblock zieht nach). Die Projektliste selbst ist davon
    /// unberührt — sie schreibt weiter erst das OK dieses Dialogs.
    /// </summary>
    private void ProjekteditorFertig(bool gespeichert)
    {
        _projektGaben = null;
        KatalogLaden();   // "Speichern unter" legt einen Katalogsatz an
        if (!gespeichert || _gewaehlt is null) return;
        ZeileAuffrischen?.Invoke(_gewaehlt);
        ProjektzeileWaehlen(_gewaehlt);
    }

    /// <summary>
    /// „Exportieren (gbXML)…" (G7a, Welle W3) — der Exportdialog als Überlagerung. Ohne Projektkopie
    /// meldet der Knopf seinen Grund.
    /// </summary>
    private void BeiExport()
    {
        if (_gewaehlt is null || ExportGaben is null) return;
        if (!_gewaehlt.HatProjektkopie) { Melden(SperreExport, WarnStufe.Hinweis); return; }
        _meldung = "";
        _exportGaben = ExportGaben(_gewaehlt, _geaenderteZeilen.Contains(_gewaehlt));
        if (_exportGaben is null) Melden(SperreExport, WarnStufe.Hinweis);
    }

    /// <summary>„Baustoff-Zuordnungen…" (Nacharbeit G4b) — die Ansicht als Überlagerung, je Klick neu gelesen.</summary>
    private void BeiBaustoffzuordnungen()
    {
        if (BaustoffzuordnungenGaben is null) return;
        _meldung = "";
        _baustoffzuordnungenGaben = BaustoffzuordnungenGaben();
    }

    /// <summary>
    /// Die Ansicht ist zu: nach OK mit der Zahl der entfernten Zuordnungen (sie sind dann geschrieben) —
    /// ab einer steht der Hinweis im Banner; <c>null</c> bei Abbrechen, ✕ und Esc.
    /// </summary>
    private void BaustoffzuordnungenFertig(int? entfernt)
    {
        _baustoffzuordnungenGaben = null;
        if (entfernt is > 0) Melden(Format(MeldungBaustoffzuordnungenEntfernt, entfernt.Value), WarnStufe.Hinweis);
    }

    /// <summary>
    /// Der Exportdialog ist zu: nach dem Schreiben steht seine Rückmeldung (mit Pfad) im Banner;
    /// <c>null</c> bei Abbrechen, ✕ und Esc — dann ist nichts geschrieben.
    /// </summary>
    private void ExportFertig(GebaeudeExportErgebnis? ergebnis)
    {
        _exportGaben = null;
        if (ergebnis is { Gespeichert: true }) Melden(ergebnis.Text, WarnStufe.Erfolg);
    }

    /// <summary>
    /// Das Ergebnis der Wohnflächenangabe geht in die MARKIERTE Zeile zurück
    /// (<c>btn_Aendern_Click</c>:445-469, dort über <c>ID_Z</c>).
    /// </summary>
    private void WohnflaecheFertig(GebaeudeWohnflaecheErgebnis? ergebnis)
    {
        _wohnflaecheGaben = null;
        if (ergebnis is null || _gewaehlt is null) return;

        _gewaehlt.Wohnflaeche = ergebnis.Wert;
        _gewaehlt.Einheit = ergebnis.Einheit;
        _gewaehlt.Jahresnutzungsgrad = ergebnis.Jahresnutzungsgrad;
        _gewaehlt.DezentralWarmwasser = ergebnis.DezentralWarmwasser;
        _geaenderteZeilen.Add(_gewaehlt);

        ProjektzeileWaehlen(_gewaehlt);
        Geaendert?.Invoke();
    }

    /// <summary>
    /// „Simulation…" — der Wärmebedarf GENAU DIESES Gebäudes (Anwenderwunsch
    /// <b>W9‑E‑2</b> vom 05.09.2026).
    ///
    /// <para>Die Rechnung macht der Kern; die Hülle reicht ihr Ergebnis als
    /// Parametersatz herein. Kommt <c>null</c> zurück — die Zeile ist noch nicht
    /// gespeichert, oder das Projekt führt keine Klimaregion —, MELDET der Dialog das,
    /// statt eine leere Überlagerung aufzumachen.</para>
    /// </summary>
    private void BeiSimulation()
    {
        if (_gewaehlt is null || BedarfGaben is null) return;

        _meldung = "";
        IReadOnlyDictionary<string, object>? gaben = BedarfGaben(_gewaehlt);
        if (gaben is null)
        {
            // Stufe G6a: der benannte Grund der Fassade statt der allgemeinen Meldung.
            string? grund = BedarfBefund?.Invoke();
            Melden(string.IsNullOrWhiteSpace(grund)
                       ? MeldungKeinBedarf
                       : string.Format(System.Globalization.CultureInfo.CurrentCulture, MeldungKeinBedarfGrund, grund),
                   WarnStufe.Warnung);
            return;
        }

        _bedarfGaben = gaben;
    }

    private void BedarfFertig() => _bedarfGaben = null;

    /// <summary>
    /// „Gebäude in DB löschen" — ohne markierten Katalogsatz die Bitte um eine Wahl; ist
    /// der Satz gesperrt (Auslieferungssatz, von einem Projekt geführt), steht der
    /// benannte Grund als Warnung, und es wird nicht erst nachgefragt. Sonst die Rückfrage.
    /// </summary>
    private void BeiKatalogLoeschen()
    {
        if (_katalogzeile is null) { Melden(MeldungKeineWahl, WarnStufe.Warnung); return; }

        string sperre = KatalogLoeschsperre?.Invoke(_katalogzeile.Bezeichner) ?? "";
        if (sperre.Length > 0) { Melden(sperre, WarnStufe.Warnung); return; }

        _meldung = "";
        _loeschfrage = true;
    }

    /// <summary>
    /// Die Antwort auf die Rückfrage — nach dem Löschen „Gebäude gelöscht!"
    /// (<c>btn_GebLoeschen_DB_Click</c>:548-566); lehnt der Schreibweg ab, steht die
    /// Absage da, statt still nichts zu tun.
    /// </summary>
    private void LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || _katalogzeile is null || KatalogLoeschen is null) return;

        if (!KatalogLoeschen(_katalogzeile.Bezeichner))
        {
            string sperre = KatalogLoeschsperre?.Invoke(_katalogzeile.Bezeichner) ?? "";
            Melden(sperre.Length > 0 ? sperre : MeldungLoeschFehler, WarnStufe.Warnung);
            return;
        }

        _katalogzeile = null;
        _katalogGewaehlt = "";
        KatalogLaden();
        Melden(MeldungGeloescht, WarnStufe.Hinweis);
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Abbrechen — von Esc (nach den Wächtern) und vom Schliesskreuz gleichermaßen gerufen.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Die Ueberlagerungen werten Esc zuerst fuer sich aus.
        if (e.Key != "Escape" || _katalogGaben is not null || _importGaben is not null ||
            _wohnflaecheGaben is not null || _bedarfGaben is not null || _gebaeudetypOffen ||
            _loeschfrage || _ausProjektFrage || _projektGaben is not null || _exportGaben is not null ||
            _baustoffzuordnungenGaben is not null) return Task.CompletedTask;
        return Abbrechen();
    }
}
