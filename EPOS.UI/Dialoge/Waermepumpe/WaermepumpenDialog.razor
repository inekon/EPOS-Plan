    private string Projektschluessel(WaermepumpeAnlageDaten z)
    {
        if (!_schluessel.TryGetValue(z, out int n)) _schluessel[z] = n = _naechsterSchluessel++;
        return n.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private IReadOnlyList<string> ProjektSchluessel() => Zeilen.Select(Projektschluessel).ToList();
    private IReadOnlyList<string> KatalogSichtbar()
        => (_katalogliste?.Angezeigt ?? _katalog).Select(z => z.Schluessel).ToList();

    /// <summary>Die Ziele einer Projektaktion: die angekreuzten Zeilen, sonst die zuletzt gewählte.</summary>
    private List<WaermepumpeAnlageDaten> ProjektZiele()
    {
        if (_projektWahl.Anzahl > 0)
            return _projektWahl.Gewaehlte
                .Select(s => Zeilen.FirstOrDefault(z => Projektschluessel(z) == s))
                .OfType<WaermepumpeAnlageDaten>().ToList();
        return _gewaehlt is null ? new() : new() { _gewaehlt };
    }

    /// <summary>Die Ziele einer Katalogaktion: die angekreuzten Sätze, sonst der gewählte.</summary>
    private List<Katalogfilterzeile> KatalogZiele()
    {
        if (_katalogWahl.Anzahl > 0)
            return _katalogWahl.Gewaehlte
                .Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s))
                .OfType<Katalogfilterzeile>().ToList();
        return _katalogZeile is null ? new() : new() { _katalogZeile };
    }

    /// <summary>Umstellen braucht GENAU eine Projektzeile und GENAU einen Katalogsatz (4.2).</summary>
    private bool UmstellenMoeglich
        => Umstellen is not null && ProjektZielEiner() is not null && KatalogZiele().Count == 1;

    /// <summary>Die eine Projektzeile des Umstellens: die gewählte, solange höchstens sie angekreuzt ist.</summary>
    private WaermepumpeAnlageDaten? ProjektZielEiner()
    {
        if (_projektWahl.Anzahl > 1) return null;
        if (_projektWahl.Anzahl == 1) return ProjektZiele().FirstOrDefault();
        return _gewaehlt;
    }

    private Satzmarke SatzArt => _gewaehlt is not null ? Satzmarke.Projektsatz
                               : _katalogZeile is not null ? Satzmarke.Katalogsatz : Satzmarke.Keiner;
    private string? SatzName => _gewaehlt?.Bezeichner ?? _katalogZeile?.Bezeichner;

    /// <summary>Die Kenndaten der zugeklappten Detailzeile: Hersteller, Nennleistung, Heizstab; beim gesperrten Satz der Hinweis.</summary>
    private string? SatzKenndaten
    {
        get
        {
            if (SatzArt == Satzmarke.Keiner) return null;
            var teile = new List<string>();
            if (_satz is not null)
            {
                if (!string.IsNullOrWhiteSpace(_satz.Firma)) teile.Add(_satz.Firma);
                if (_satz.Nennleistung is int pn) teile.Add(_felderTexte.LabelNennleistung + " " + pn.ToString(System.Globalization.CultureInfo.CurrentCulture) + " " + _felderTexte.EinheitKw);
                if (_satz.Heizstab is int hs && hs > 0) teile.Add(_felderTexte.LabelHeizstab + " " + hs.ToString(System.Globalization.CultureInfo.CurrentCulture) + " " + _felderTexte.EinheitKw);
            }
            if (_gewaehlt is not null && _gewaehlt.Vorlauf is int vl) teile.Add(SpalteVorlauf + " " + vl.ToString(System.Globalization.CultureInfo.CurrentCulture));
            if (_katalogZeile?.Geschuetzt == true && _gewaehlt is null) teile.Add(Resource.AUSWAHL_SATZ_NUR_LESEN);
            return string.Join(" · ", teile);
        }
    }

    private RenderFragment MarkeProjektsatz => @<span class="epos-zweispalten-marke epos-zweispalten-marke--satz">@Resource.AUSWAHL_MARKE_PROJEKTSATZ</span>;
    private RenderFragment MarkeKatalogsatz => @<span class="epos-zweispalten-marke epos-zweispalten-marke--satz">@Resource.AUSWAHL_MARKE_KATALOGSATZ</span>;

    private string AnlageTitel => string.Format(Resource.Culture, AnlageTitelFormat, _gewaehlt?.Bezeichner ?? "");

    private void ProjektZeileKlick(WaermepumpeAnlageDaten zeile)
    {
        _projektWahl.Klick(Projektschluessel(zeile), strg: false, umschalt: false, ProjektSchluessel());
        ProjektZeileWaehlen(zeile);
    }

    private void BeiWahlGeaendert(Auswahlbereich bereich)
    {
        if (bereich != Auswahlbereich.Projekt || _projektWahl.Zuletzt is not string s) return;
        if (!_projektWahl.IstGewaehlt(s)) return;
        WaermepumpeAnlageDaten? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == s);
        if (zeile is not null && zeile != _gewaehlt) ProjektZeileWaehlen(zeile);
    }

    private void BeiKatalogKaestchen(IReadOnlyList<string> gewaehlt)
    {
        _katalogKaestchen = gewaehlt;
        _katalogWahl.Setzen(gewaehlt);
    }

    private void KatalogKaestchenLeeren()
    {
        _katalogWahl.Leeren();
        _katalogKaestchen = new List<string>();
    }

    private void ProjektZeileWaehlen(WaermepumpeAnlageDaten zeile)
    {
        _gewaehlt = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        DetailNachziehen();
    }

    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _gewaehlt = null;
        DetailNachziehen();
    }

    /// <summary>Kenndaten und Kennlinie des gewählten Satzes — Projektkopie bzw. Katalogsatz.</summary>
    private void DetailNachziehen()
    {
        if (_gewaehlt is not null)
        {
            _satz = ProjektSatz?.Invoke(_gewaehlt);
            _bilder = ProjektBilder?.Invoke(_gewaehlt);
        }
        else if (_katalogZeile is not null)
        {
            _satz = KatalogSatz?.Invoke(_katalogZeile.Id);
            _bilder = KatalogBilder?.Invoke(_katalogZeile.Id);
        }
        else
        {
            _satz = null;
            _bilder = null;
        }
    }

    // =================================================================================
    // Der Katalog
    // =================================================================================

    /// <summary>Liest den Katalog neu — nach einem Schreibweg. Der Filter ruft sie nicht.</summary>
    private void KatalogNeuLaden()
    {
        _katalog = Katalog?.Invoke() ?? Array.Empty<Katalogfilterzeile>();
        VerwendungStempeln();
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
    }

    /// <summary>Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste.</summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    // =================================================================================
    // Hinzufuegen, Entfernen, Umstellen
    // =================================================================================

    /// <summary>
    /// „In das Projekt übernehmen": je gewähltem Katalogsatz eine Zeile; sie steht sofort in Liste und Modell. Eine
    /// EINZELNE neue Zeile öffnet gleich „Anlage…" — sie braucht Betriebsart und Temperaturen.
    /// </summary>
    private void BeiHinzu()
    {
        if (Anlegen is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        WaermepumpeAnlageDaten? letzte = null;
        int neu = 0;
        foreach (Katalogfilterzeile z in ziele)
        {
            WaermepumpeAnlageDaten? zeile = Anlegen(z.Bezeichner);
            if (zeile is null) continue;
            Zeilen.Add(zeile);
            Uebernehmen?.Invoke(zeile);
            _ungeprueft.Add(zeile);
            letzte = zeile;
            neu++;
        }
        VerwendungStempeln();
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
        if (letzte is null) return;
        _meldung = "";
        ProjektZeileWaehlen(letzte);
        if (neu == 1 && AnlageGaben is not null) AnlageOeffnen();
    }

    /// <summary>„Aus dem Projekt entfernen": GENAU die gewählten Zeilen (nicht ihr Index).</summary>
    private void BeiLoeschen()
    {
        List<WaermepumpeAnlageDaten> ziele = ProjektZiele();
        if (ziele.Count == 0) return;
        foreach (WaermepumpeAnlageDaten zeile in ziele)
        {
            Zeilen.Remove(zeile);
            _ungeprueft.Remove(zeile);
            Entfernen?.Invoke(zeile);
        }
        VerwendungStempeln();
        _projektWahl.Leeren();
        _meldung = "";
        _gewaehlt = null;
        DetailNachziehen();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
    }

    /// <summary>
    /// „Umstellen": die eine Projektzeile wird zum einen Katalogsatz — über die Hülle, die Gerät, Gerätefelder und
    /// Kennlinien nachzieht. Betriebsdaten und Kosten der Zeile bleiben.
    /// </summary>
    private void BeiUmstellen()
    {
        WaermepumpeAnlageDaten? zeile = ProjektZielEiner();
        List<Katalogfilterzeile> satz = KatalogZiele();
        if (Umstellen is null || zeile is null || satz.Count != 1) return;
        if (!Umstellen(zeile, satz[0].Id)) return;
        _meldung = "";
        VerwendungStempeln();
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
        ProjektZeileWaehlen(zeile);
    }

    // =================================================================================
    // "Anlage…" - die Anlagenseite als Ueberlagerung (KA-E-11)
    // =================================================================================

    private void AnlageOeffnen()
    {
        if (_gewaehlt is null || AnlageGaben is null) return;
        _schnappschuss = _gewaehlt.Schnappschuss();
        _anlageGaben = AnlageGaben(_gewaehlt);
    }

    /// <summary>OK: die Zeile geht ins Modell (die Anlagenseite hat geprüft). Abbrechen: der Stand beim Öffnen.</summary>
    private void AnlageFertig(bool ok)
    {
        WaermepumpeAnlageDaten? zeile = _gewaehlt;
        if (zeile is not null)
        {
            if (ok)
            {
                _ungeprueft.Remove(zeile);
                _meldung = "";
                Uebernehmen?.Invoke(zeile);
            }
            else if (_schnappschuss is not null)
            {
                zeile.WerteVon(_schnappschuss);
            }
        }
        _schnappschuss = null;
        _anlageGaben = null;
        _anlage = null;
        DetailNachziehen();
    }

    // --- Die Bruecke zur Kostenleiste ------------------------------------------
    private Func<bool, Task>? KostenLeiste
        => KostenOeffnen is null ? null : (Func<bool, Task>)BeiKosten;
    private Func<Task>? EnergieLeiste
        => EnergiekostenOeffnen is null ? null : (Func<Task>)BeiEnergiekosten;
    private Task BeiKosten(bool betrieb)
        => _gewaehlt is null || KostenOeffnen is null ? Task.CompletedTask : KostenOeffnen(_gewaehlt, betrieb);
    private Task BeiEnergiekosten()
        => _gewaehlt is null || EnergiekostenOeffnen is null ? Task.CompletedTask : EnergiekostenOeffnen(_gewaehlt);

    // =================================================================================
    // Katalogpflege und Bearbeiten je Bereich (4.6, KA-E-8, KA-E-13)
    // =================================================================================

    /// <summary>
    /// „Bearbeiten…" im Katalogfuß: ein einzelner ungesperrter Satz öffnet den vollen Katalogeditor (KA-E-13),
    /// mehrere oder gesperrte Sätze die Satzbearbeitung — gesperrte übersprungen, alle gesperrt nur lesend.
    /// </summary>
    private void BeiKatalogBearbeiten()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1 && !ziele[0].Geschuetzt && EditorGaben is not null)
        {
            _editorGaben = EditorGaben(ziele[0].Bezeichner);
            return;
        }
        if (KatalogsatzWege is not null)
        {
            _bearbeitung = (Satzmarke.Katalogsatz,
                            ziele.Select(z => new Bearbeitungssatz(z.Id, z.Bezeichner, z.Geschuetzt)).ToList());
            return;
        }
        if (ziele.All(z => z.Geschuetzt)) BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
    }

    /// <summary>„Bearbeiten…" im Projektbereich: die Projektkopien der Auswahl, je Gerät einmal.</summary>
    private void BeiProjektBearbeiten()
    {
        if (ProjektsatzWege is null) return;
        var saetze = ProjektZiele().Where(z => z.IdWp > 0).GroupBy(z => z.IdWp)
            .Select(g => new Bearbeitungssatz(g.Key, g.First().Bezeichner, false)).ToList();
        if (saetze.Count == 0) return;
        _bearbeitung = (Satzmarke.Projektsatz, saetze);
    }

    /// <summary>Die Satzbearbeitung ist zu; gespeichert: Katalog bzw. Detail neu.</summary>
    private void BearbeitungFertig(bool gespeichert)
    {
        Satzmarke? art = _bearbeitung?.Art;
        _bearbeitung = null;
        if (!gespeichert) return;
        if (art == Satzmarke.Katalogsatz)
        {
            KatalogNeuLaden();
            if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
        }
        else
        {
            DetailNachziehen();
        }
    }

    /// <summary>Nach dem Katalogeditor: die Katalogliste neu ziehen und den gewählten Satz neu lesen.</summary>
    private void EditorFertig(bool _)
    {
        _editorGaben = null;
        KatalogNeuLaden();
        if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
        else DetailNachziehen();
    }

    /// <summary>„In die Datenbank übernehmen…" (KA-E-9): die Rückfrage zu den Projektkopien der Auswahl.</summary>
    private void BeiRueckweg()
    {
        if (RueckwegWege is null) return;
        var ids = ProjektZiele().Select(z => z.IdWp).Where(id => id > 0).Distinct().ToList();
        if (ids.Count == 0) return;
        IReadOnlyList<Rueckwegvorschlag> zeilen = RueckwegWege.Vorschau(ids);
        if (zeilen.Count == 0) return;
        _rueckweg = zeilen;
    }

    private void RueckwegFertig(string? meldung)
    {
        _rueckweg = null;
        if (meldung is null) return;
        Melden(meldung, false);
        KatalogNeuLaden();
    }

    /// <summary>„Löschen": ein Satz fragt nach; bei mehreren werden gesperrte übersprungen und genannt.</summary>
    private void BeiLoeschenGefragt()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1)
        {
            _loeschziele = ziele;
            _loeschUebersprungen = new();
        }
        else
        {
            _loeschziele = ziele.Where(z => !z.Geschuetzt).ToList();
            _loeschUebersprungen = ziele.Where(z => z.Geschuetzt).ToList();
            if (_loeschziele.Count == 0)
            {
                BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
                return;
            }
        }
        _loeschfrage = true;
    }

    private string LoeschfrageText
    {
        get
        {
            string text = _loeschziele.Count <= 1
                ? string.Format(FrageLoeschen, _loeschziele.FirstOrDefault()?.Bezeichner ?? "")
                : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, _loeschziele.Count,
                                string.Join(", ", _loeschziele.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschUebersprungen.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                            string.Join(", ", _loeschUebersprungen.Select(z => "„" + z.Bezeichner + "“")));
            return text;
        }
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || KatalogLoeschen is null || ziele.Count == 0) return;
        string fehler = "";
        bool fokusWeg = false;
        int geloescht = 0;
        foreach (Katalogfilterzeile z in ziele)
        {
            string grund = KatalogLoeschen(z.Id) ?? "";
            if (grund.Length > 0) { fehler = grund; continue; }
            geloescht++;
            if (z.Bezeichner == _katalogGewaehlt) fokusWeg = true;
        }
        if (fehler.Length > 0) Melden(fehler, true);
        if (geloescht == 0) return;
        KatalogKaestchenLeeren();
        if (fokusWeg)
        {
            _katalogZeile = null;
            _katalogGewaehlt = "";
        }
        KatalogNeuLaden();
        DetailNachziehen();
    }

    private void BeiSchlossGeschaltet(string status)
    {
        KatalogNeuLaden();
        DetailNachziehen();
        Melden(status ?? "", false);
    }

    private void BeiSchlossAbgelehnt(string grund) => Melden(grund ?? "", true);

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    /// <summary>
    /// OK: Eine in dieser Sitzung aufgenommene Zeile, deren Anlagenseite noch nicht mit OK bestätigt ist, hält das OK
    /// an — „Anlage…" geht für sie auf, das Band nennt sie.
    /// </summary>
    private Task BeiErgebnis(bool ok)
    {
        if (ok)
        {
            WaermepumpeAnlageDaten? offen = Zeilen.FirstOrDefault(z => _ungeprueft.Contains(z));
            if (offen is not null && AnlageGaben is not null)
            {
                Melden(string.Format(MangelFormat, offen.Bezeichner, TextAnlagePruefen), true);
                ProjektZeileWaehlen(offen);
                AnlageOeffnen();
                return Task.CompletedTask;
            }
        }
        return Geschlossen.InvokeAsync(ok);
    }

    /// <summary>Abbrechen — von Esc und vom Schliesskreuz gerufen: schliesst ohne zu speichern.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(false);

    /// <summary>Esc schließt; die Überlagerungen werten ihn zuerst für sich aus. Enter bleibt unbelegt.</summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        if (_anlageGaben is not null || _editorGaben is not null || _bearbeitung is not null || _rueckweg is not null ||
            _loeschfrage)
            return Task.CompletedTask;
        return Abbrechen();
    }
}
