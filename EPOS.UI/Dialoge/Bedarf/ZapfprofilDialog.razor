    private string Titel => string.IsNullOrEmpty(Daten.Kontext?.Projekt)
        ? Texte.Titel : Format(Texte.TitelProjekt, Daten.Kontext.Projekt);

    /// <summary>Die Kontextzeile: Projekt · Klimaregion · Kalender · Bilanzgrenze (leere Teile fallen weg).</summary>
    private string Kontexttext
    {
        get
        {
            ZapfprofilKontextDaten k = Daten.Kontext ?? new ZapfprofilKontextDaten();
            var teile = new[] { k.Projekt, k.Klimaregion, k.Kalender, k.Bilanzgrenze }
                .Where(t => !string.IsNullOrWhiteSpace(t));
            return string.Join(" · ", teile);
        }
    }

    /// <summary>
    /// Der Zähler „n Werte überschrieben": die Größen der höheren Stufen je Zone und die der
    /// Stochastik — der Rechenweg „stochastisch", ein Seed oder eine Zahl der Realisierungen
    /// abseits der Vorgabe. Die Stufe blendet nur aus, die Überschreibung bleibt.
    /// </summary>
    private int Ueberschrieben
    {
        get
        {
            int n = _eingabe.Zonen.Sum(z => z.Ueberschrieben);
            if (_eingabe.JahresreiheStochastisch) n++;
            if (_eingabe.Seed is int seed && Daten.SeedVorgabe is int sv && seed != sv) n++;
            if (_eingabe.Realisierungen is int r && Daten.RealisierungenVorgabe is int rv && r != rv) n++;
            return n;
        }
    }

