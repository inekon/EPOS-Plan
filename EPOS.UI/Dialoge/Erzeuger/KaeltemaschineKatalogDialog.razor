    // Schluss
    // =====================================================================

    // =====================================================================
    // KM1: "Import..." und "Typkennfelder laden..."
    // =====================================================================

    /// <summary>
    /// Der Parametersatz des Katalogimports der Art Kältemaschine (Windows: <c>KatalogImportHuelle.Gaben</c>);
    /// <c>null</c> = die Plattform führt keinen Dateiimport — der Knopf lehnt dann benannt ab.
    /// </summary>
    [Parameter] public Func<IReadOnlyDictionary<string, object>?>? ImportGaben { get; set; }

    /// <summary>Lädt die eingebauten Typkennfelder in den Katalog (<c>KaeltemaschinenTypkennfelder.Einspielen</c>).</summary>
    [Parameter] public Func<KaeltemaschineTypkennfelderErgebnis>? TypkennfelderLaden { get; set; }

    /// <summary>Die Zahl der eingebauten Typkennfelder — für den Text der Rückfrage.</summary>
    [Parameter] public int TypkennfelderAnzahl { get; set; }

    private IReadOnlyDictionary<string, object>? _importGaben;
    private HashSet<string> _vorImport = new(StringComparer.Ordinal);
    private bool _typfrage;

    private string TypfrageText => string.Format(CultureInfo.CurrentCulture, Texte.FrageTypkennfelder, TypkennfelderAnzahl);

    /// <summary>„Import…" öffnet den Katalogimport; ohne Weg die benannte Ablehnung, geänderte Felder halten an.</summary>
    private void ImportOeffnen()
    {
        if (_geaendert) { Warnen(Resource.ADM_MSG_UNGESPEICHERT); return; }
        IReadOnlyDictionary<string, object>? gaben = ImportGaben?.Invoke();
        if (gaben is null) { Warnen(Texte.ImportPlattform); return; }
        _meldung = "";
        _vorImport = new HashSet<string>(_katalog.Select(z => z.Bezeichner), StringComparer.Ordinal);
        _importGaben = gaben;
    }

    /// <summary>Der Import ist zu; hat er geschrieben, liest die Liste neu und die Statuszeile nennt die neuen Sätze.</summary>
    private void ImportFertig(bool geschrieben)
    {
        _importGaben = null;
        if (!geschrieben) return;
        ListeLaden();
        var neu = _katalog.Where(z => !_vorImport.Contains(z.Bezeichner)).ToList();
        if (neu.Count == 0) return;
        _status = neu.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_EINGELESEN, neu[0].Bezeichner)
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_IMPORTIERT, neu.Count);
    }

    private void TypkennfelderFragen()
    {
        if (TypkennfelderLaden is null) return;
        if (_geaendert) { Warnen(Resource.ADM_MSG_UNGESPEICHERT); return; }
        _meldung = "";
        _typfrage = true;
    }

    private void BeiTypfrage(bool? ja)
    {
        _typfrage = false;
        if (ja != true || TypkennfelderLaden is null) return;
        KaeltemaschineTypkennfelderErgebnis e = TypkennfelderLaden();
        if (!e.Ok) { Warnen(e.Meldung.Length > 0 ? e.Meldung : Texte.Fehler); return; }
        if (e.Neu > 0) ListeLaden();
        _status = string.Format(CultureInfo.CurrentCulture, Texte.TypkennfelderGeladen, e.Neu, e.Uebersprungen);
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _neuOffen || _loeschfrage || _duplizierfrage || _schloss.FrageOffen
            || _typfrage || _importGaben is not null)
            return Task.CompletedTask;

        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }
        return Schliessen();
    }

    /// <summary>Schließen — „Beenden", Esc und Schliesskreuz, immer mit <c>true</c>. Geänderte Werte halten an.</summary>
    private Task Schliessen()
    {
        if (_geaendert)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(true);
    }
}
