    private Task BeiWeg(int? id)
    {
        // Der Schalter PARKT die Zuordnung, er loescht sie nicht (Konzept 7.1, Grund 1):
        // Der Planer verloere sonst genau die Arbeit, die er vergleichen will.
        Zeile.MitWechselrichter = id == WEG_KATALOG;
        Nachpruefen();
        return Geaendert.InvokeAsync();
    }

    // =================================================================================
    // W6-B-3: die Katalogwahl ueber der Tabelle
    // =================================================================================

    /// <summary>
    /// Merkt das Geraet fuer den NAECHSTEN Strang. Uebernommen (<c>CopyFromStamm</c>)
    /// wird es erst beim Anlegen — eine Klapplistenwahl allein darf keine Projektkopie
    /// anlegen, sonst fuellte ein Durchblaettern die Projekttabelle.
    /// </summary>
    private void BeiNeuemGeraet(int? id)
    {
        _neuesGeraet = id ?? 0;
    }

    /// <summary>Fuehrt der Katalog diesen Stammsatz (gefiltert oder ungefiltert)?</summary>
    private bool ImKatalog(int stammId)
    {
        foreach (var e in _gefiltert) if (e.Id == stammId) return true;
        return false;
    }

    // =================================================================================
    // Die Strangtabelle
    // =================================================================================

    private Task StrangAnlegen()
    {
        var neu = new StrangZeile { Rang = Zeile.Straenge.Count + 1 };

        // W6-B-3: Der neue Strang traegt das Geraet der Katalogwahl - das ist der
        // Sinn der Zeile darueber. "(kein Geraet)" legt wie bisher eine leere Zeile
        // an; die Ampel sagt dann, was fehlt.
        int? trackerzahl = null;
        if (_neuesGeraet is int stammId && stammId > 0 && GeraetUebernehmen is not null)
        {
            GeraetWahl wahl = GeraetUebernehmen(stammId);
            neu.WechselrichterId = wahl.Id;
            neu.WechselrichterName = wahl.Name;
            trackerzahl = TrackerZahl?.Invoke(stammId);
        }

        Vorbelegen(neu, trackerzahl);

        Zeile.Straenge.Add(neu);
        _gewaehlt = neu;

        // Der erste Strang macht die Wahl "mit Wechselrichter" moeglich - und wer
        // einen Strang anlegt, will ihn auch gerechnet sehen.
        Zeile.MitWechselrichter = true;

        Nachpruefen();
        return Geaendert.InvokeAsync();
    }

    /// <summary>
    /// <b>Womit der neue Strang anfängt</b> (<b>W6‑B‑4</b>). Bis zur Windows-Abnahme
    /// vom 07.09.2026 waren alle vier Zahlenfelder leer, und die Ampel meldete
    /// darunter „0 Module in Reihe … Werte fehlen: Module in Reihe" — der Anwender las
    /// das als Fehler und fragte „Anzahl Module fehlt?".
    ///
    /// <para><b>Gerechnet wird im KERN</b> (<c>Strangvorbelegung.FuerNeuenStrang</c>);
    /// die Komponente sammelt nur, was der Kern wissen muss: die Modulzahl der Anlage,
    /// die Zahl der bestehenden Stränge, ihre Modulsumme und den höchsten schon
    /// belegten Tracker AM SELBEN Gerät.</para>
    /// </summary>
    private void Vorbelegen(StrangZeile neu, int? trackerzahl)
    {
        int belegteModule = 0;
        int hoechsterMppt = 0;

        foreach (StrangZeile s in Zeile.Straenge)
        {
            belegteModule += s.Modulzahl;

            // Nur Stränge AM SELBEN Gerät belegen dessen Tracker.
            if (s.WechselrichterId == neu.WechselrichterId &&
                (s.Geraetenummer ?? 1) == 1 && (s.Mppt ?? 1) > hoechsterMppt)
                hoechsterMppt = s.Mppt ?? 1;
        }

        Strangvorbelegung.Vorschlag v = Strangvorbelegung.FuerNeuenStrang(
            Zeile.AnzahlModule ?? 0.0, Zeile.Straenge.Count, belegteModule,
            hoechsterMppt, trackerzahl);

        neu.ModuleReihe = v.ModuleReihe;
        neu.StraengeParallel = v.StraengeParallel;
        neu.Mppt = v.Mppt;
        neu.Geraetenummer = v.Geraetenummer;
    }

    private Task StrangEntfernen()
    {
        if (_gewaehlt is null) return Task.CompletedTask;

        Zeile.Straenge.Remove(_gewaehlt);
        _gewaehlt = null;
        Raengeneu();
        Nachpruefen();
        return Geaendert.InvokeAsync();
    }

    /// <summary>Die Raenge bleiben lueckenlos ab 1 — dieselbe Regel wie im Controller.</summary>
    private void Raengeneu()
    {
        for (int i = 0; i < Zeile.Straenge.Count; i++) Zeile.Straenge[i].Rang = i + 1;
    }

    /// <summary>Setzt einen Wert, prueft nach und meldet — der Weg jeder Zellenaenderung.</summary>
    private Task Setzen(StrangZeile s, Action aenderung)
    {
        aenderung();
        Nachpruefen();
        return Geaendert.InvokeAsync();
    }

    // =================================================================================
    // W6-O-4: der Herstellerfilter ueber der Tabelle
    // =================================================================================

    /// <summary>
    /// Zieht die Geraeteliste zum gewaehlten Hersteller. Ohne Delegat bleibt es bei
    /// <see cref="Geraete"/> — der Filter ist dann eine Anzeige ohne Wirkung, und das
    /// ist besser als eine leere Klappliste.
    /// </summary>
    private void GeraeteNeuLaden()
    {
        if (GeraeteFiltern is null)
        {
            _gefiltert = Geraete;
        }
        else
        {
            string hersteller = (_hersteller.HasValue && _hersteller.Value < Hersteller.Count)
                              ? Hersteller[_hersteller.Value] : "";
            _gefiltert = GeraeteFiltern(hersteller) ?? Array.Empty<(int, string)>();
        }

        var liste = new List<(int, string)> { (0, Texte.KeinGeraet) };
        foreach (var g in _gefiltert) liste.Add(g);
        _geraetewahl = liste;

        // W6-B-3: Fuehrt die Klappliste das vorgemerkte Geraet nicht mehr - der
        // Anwender hat den Herstellerfilter umgestellt, oder der Katalogsatz ist fort -,
        // faellt die Katalogwahl auf "(kein Geraet)" zurueck. Sonst naehme
        // "Strang anlegen" ein Geraet mit, das in der Liste gar nicht mehr steht.
        if (_neuesGeraet is int vorgemerkt && vorgemerkt > 0 && !ImKatalog(vorgemerkt))
            _neuesGeraet = 0;
    }

    private void BeiHersteller(int? id)
    {
        _hersteller = id ?? 0;
        GeraeteNeuLaden();
    }

    // =================================================================================
    // W6-E-6: die Vorauswahl des Filters auf den Modulhersteller
    // =================================================================================

    /// <summary>
    /// Kuerzeste Namenslaenge, mit der der zweite Versuch („beginnt mit") noch zaehlt.
    /// Ein Praefix von einem oder zwei Buchstaben traefe zu viel — „S" stuende auf
    /// „Siemens" so gut wie auf „SMA".
    /// </summary>
    private const int PRAEFIX_MINDESTLAENGE = 3;

    /// <summary>
    /// Stellt den Herstellerfilter auf den Modulhersteller vor (<b>W6‑E‑6</b>) — aber
    /// nur beim ERSTEN Zeichnen und bei jedem WECHSEL des Anlagenmoduls.
    ///
    /// <para><b>Warum nicht bei jedem <c>OnParametersSet</c>.</b> Die Hülle zeichnet
    /// nach jeder Zellenänderung neu (jede Änderung meldet <c>Geaendert</c>); ein
    /// Vorstellen bei jedem Durchlauf nähme dem Anwender seine eigene Filterwahl im
    /// selben Augenblick wieder ab, in dem er sie trifft. Gemerkt wird deshalb, WOFÜR
    /// zuletzt vorgestellt wurde: Bleibt das Anlagenmodul dasselbe, gehört der Filter
    /// dem Anwender; wechselt es, gilt die Vorauswahl von Neuem.</para>
    /// </summary>
    private void Vorstellen()
    {
        string modul = (Modulhersteller ?? "").Trim();
        if (_vorgestelltFuer is not null &&
            string.Equals(_vorgestelltFuer, modul, StringComparison.Ordinal)) return;

        _vorgestelltFuer = modul;
        int treffer = Herstellertreffer(modul);
        _vorauswahlTrifft = treffer > 0;
        _hersteller = treffer;
    }

    /// <summary>
    /// Der Eintrag der Herstellerliste, der zum Modulhersteller passt; <c>0</c> = keiner,
    /// also „Alle". Index 0 ist „Alle" selbst und bleibt draussen.
    ///
    /// <para><b>Zwei Versuche</b>, weil Modul- und Gerätekatalog aus verschiedenen
    /// Quellen stammen und denselben Hersteller verschieden schreiben: erst GLEICHHEIT
    /// ohne Rücksicht auf Gross-/Kleinschreibung und Randleerzeichen, dann „der eine
    /// Name beginnt mit dem anderen" — in BEIDE Richtungen, denn mal ist der
    /// Katalogname der längere („SMA" → „SMA America"), mal der Modulname
    /// („SMA Solar Technology" → „SMA"). Mehrere Treffer entscheidet der ERSTE der
    /// Liste; sie ist sortiert, die Vorauswahl damit wiederholbar.</para>
    /// </summary>
    private int Herstellertreffer(string modulhersteller)
    {
        if (modulhersteller.Length == 0) return 0;

        for (int i = 1; i < Hersteller.Count; i++)
            if (string.Equals((Hersteller[i] ?? "").Trim(), modulhersteller,
                              StringComparison.OrdinalIgnoreCase)) return i;

        for (int i = 1; i < Hersteller.Count; i++)
        {
            string katalog = (Hersteller[i] ?? "").Trim();
            if (Math.Min(katalog.Length, modulhersteller.Length) < PRAEFIX_MINDESTLAENGE) continue;

            if (katalog.StartsWith(modulhersteller, StringComparison.OrdinalIgnoreCase)
                || modulhersteller.StartsWith(katalog, StringComparison.OrdinalIgnoreCase)) return i;
        }

        return 0;
    }

    /// <summary>
    /// Die Zeile unter dem Filter: woher die Vorauswahl kommt — und dass sie nichts
    /// sperrt. Ohne bekannten Modulhersteller bleibt nur der zweite Halbsatz übrig.
    /// </summary>
    private string Filterherleitung
    {
        get
        {
            string modul = _vorgestelltFuer ?? "";
            if (modul.Length == 0) return Texte.HerleitungFilterFrei;

            return string.Format(CultureInfo.CurrentCulture,
                                 _vorauswahlTrifft ? Texte.HerleitungFilter
                                                   : Texte.HerleitungFilterOhne,
                                 modul);
        }
    }

    /// <summary>
    /// Die Klappliste DIESER Zeile. Der Filter engt die Auswahl ein — <b>das bereits
    /// gewaehlte Geraet bleibt aber sichtbar</b>, auch wenn es von einem anderen
    /// Hersteller stammt: Sonst stuende in der Zeile nichts, und der Anwender hielte
    /// die Zuordnung fuer verloren.
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Geraetewahl(StrangZeile s)
    {
        if (s.WechselrichterId <= 0 || s.WechselrichterName.Length == 0) return _geraetewahl;

        foreach (var g in _gefiltert)
            if (string.Equals(g.Text, s.WechselrichterName, StringComparison.Ordinal))
                return _geraetewahl;

        foreach (var g in Geraete)
            if (string.Equals(g.Text, s.WechselrichterName, StringComparison.Ordinal))
            {
                var liste = new List<(int, string)>(_geraetewahl) { g };
                return liste;
            }

        return _geraetewahl;
    }

    /// <summary>
    /// Der gewaehlte Eintrag der Geraeteklappliste. Das Band zwischen Zeile und Liste
    /// ist der BEZEICHNER: Katalogsatz und Projektkopie tragen denselben, und genau
    /// darueber findet <c>CopyFromStamm</c> eine vorhandene Kopie wieder. Ist der
    /// Katalogsatz inzwischen geloescht, steht nichts gewaehlt da — die Zeile behaelt
    /// ihr Geraet trotzdem.
    /// </summary>
    private int? GeraetAuswahl(StrangZeile s)
    {
        if (s.WechselrichterId <= 0) return 0;
        foreach (var g in Geraete)
            if (string.Equals(g.Text, s.WechselrichterName, StringComparison.Ordinal)) return g.Id;
        return null;
    }

    // =================================================================================
    // W6-O-6: das Modul je Strang
    // =================================================================================

    /// <summary>
    /// Die Modulklappliste DIESER Zeile — <c>_modulwahl</c>, ergaenzt um das bereits
    /// gewaehlte Modul, falls der Katalog es nicht (mehr) fuehrt. Derselbe Gedanke wie
    /// bei <see cref="Geraetewahl"/>.
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Modulwahl(StrangZeile s)
    {
        if (s.ModulId <= 0 || s.ModulName.Length == 0) return _modulwahl;

        foreach (var m in Module)
            if (string.Equals(m.Text, s.ModulName, StringComparison.Ordinal)) return _modulwahl;

        var liste = new List<(int, string)>(_modulwahl) { (-1, s.ModulName) };
        return liste;
    }

    /// <summary>
    /// Der Werkzeugtipp der Modulspalte (<b>W6‑B‑4</b>): der volle Modulname, wenn der
    /// Strang einen eigenen trägt — sonst der Satz, was „leer" bedeutet. Die Spalte ist
    /// gedeckelt und schneidet ab; die Auskunft darf dabei nicht verlorengehen.
    /// </summary>
    private string Modultipp(StrangZeile s)
        => s.ModulName.Length > 0 ? s.ModulName : Texte.HerleitungModul;

    /// <summary>
    /// Der gewaehlte Eintrag der Modulklappliste; 0 heisst „das Modul der Anlage".
    /// Das Band ist wieder der BEZEICHNER (siehe <see cref="GeraetAuswahl"/>).
    /// </summary>
    private int? ModulAuswahl(StrangZeile s)
    {
        if (s.ModulId <= 0) return 0;
        foreach (var m in Module)
            if (string.Equals(m.Text, s.ModulName, StringComparison.Ordinal)) return m.Id;
        return -1;
    }

    /// <summary>
    /// Ein anderer Modultyp fuer DIESEN Strang. „(Modul der Anlage)" nimmt die
    /// Abweichung wieder heraus — der Rueckweg muss ausdruecklich moeglich sein, sonst
    /// waere eine einmal gesetzte Abweichung nicht mehr aufzuheben.
    /// </summary>
    private Task BeiModul(StrangZeile s, int? stammId)
    {
        if (stammId is null or 0)
        {
            s.ModulId = 0;
            s.ModulName = "";
        }
        else if (stammId.Value > 0 && ModulUebernehmen is not null)
        {
            GeraetWahl wahl = ModulUebernehmen(stammId.Value);
            s.ModulId = wahl.Id;
            s.ModulName = wahl.Name;
        }

        Nachpruefen();
        return Geaendert.InvokeAsync();
    }

    private Task BeiGeraet(StrangZeile s, int? stammId)
    {
        if (stammId is null or 0)
        {
            s.WechselrichterId = 0;
            s.WechselrichterName = "";
        }
        else if (GeraetUebernehmen is not null)
        {
            GeraetWahl wahl = GeraetUebernehmen(stammId.Value);
            s.WechselrichterId = wahl.Id;
            s.WechselrichterName = wahl.Name;
        }

        Nachpruefen();
        return Geaendert.InvokeAsync();
    }

    /// <summary>Fragt den Pruefstand des Kerns; ohne Delegat bleibt die Ampel leer.</summary>
    private void Nachpruefen()
    {
        _befund = Pruefen is null ? StrangBefund.Leer : Pruefen(Zeile, Zeile.Straenge);
    }

    private static string Ampelklasse(Ampelfarbe f) => f switch
    {
        Ampelfarbe.Rot => "epos-ampel--rot",
        Ampelfarbe.Gelb => "epos-ampel--gelb",
        _ => "epos-ampel--gruen"
    };

    private static string Chipklasse(Ampelfarbe f) => f switch
    {
        Ampelfarbe.Rot => "epos-chip--rot",
        Ampelfarbe.Gelb => "epos-chip--warnung",
        _ => "epos-chip--gruen"
    };

    /// <summary>
    /// Der geerbte Anlagenwert als PLATZHALTER in Klammern (Konzept 7): Die Klammer
    /// zeigt, dass der Wert von der Anlage kommt und nicht in dieser Zeile steht. Wer
    /// hineinschreibt, macht das Teilfeld eigenstaendig; wer das Feld leert, erbt wieder.
    /// </summary>
    private static string Geerbt(int? anlagenwert)
        => anlagenwert.HasValue
            ? "(" + anlagenwert.Value.ToString(CultureInfo.CurrentCulture) + ")"
            : "";

    /// <summary>Die Zeile des Weges „vereinfacht" — mit dem Wirkungsgrad, der wirklich gilt.</summary>
    private string VereinfachtText
        => string.Format(CultureInfo.CurrentCulture, Texte.HinweisVereinfacht,
                         (Zeile.WrWirkungsgrad ?? 0.95).ToString("N3", CultureInfo.CurrentCulture));

    // =================================================================================
    // Die Ueberlagerung mit den fuenf Anlagenwerten
    // =================================================================================

    private string Titel => string.Format(CultureInfo.CurrentCulture,
                                          AnlagenTexte.DialogTitel, Zeile.Bezeichner);

    /// <summary>Die DC/AC-Zeile der Ueberlagerung (Pruefhilfe fuer Tests).</summary>
    public string DcAcText
    {
        get
        {
            if (!_nenn.HasValue || _nenn.Value <= 0.0 || KwpAnlage <= 0.0) return AnlagenTexte.DcAcOhne;
            return string.Format(CultureInfo.CurrentCulture, AnlagenTexte.DcAc,
                                 KwpAnlage, _nenn.Value, KwpAnlage / _nenn.Value);
        }
    }

    private void Oeffnen()
    {
        _nenn = Zeile.WrNennleistungKw;
        _eta10 = Zeile.WrEta10;
        _eta50 = Zeile.WrEta50;
        _eta100 = Zeile.WrEta100;
        _offen = true;
    }

    /// <summary>OK uebernimmt die vier Werte (0 = nicht bekannt = NULL); Abbrechen verwirft sie.</summary>
    private async Task BeiErgebnis(bool ok)
    {
        _offen = false;
        if (!ok) return;
        Zeile.WrNennleistungKw = Positiv(_nenn);
        Zeile.WrEta10 = Positiv(_eta10);
        Zeile.WrEta50 = Positiv(_eta50);
        Zeile.WrEta100 = Positiv(_eta100);
        await Geaendert.InvokeAsync();
    }

    private static double? Positiv(double? wert) => wert.HasValue && wert.Value > 0.0 ? wert : null;
}
