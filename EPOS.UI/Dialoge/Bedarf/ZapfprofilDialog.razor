    private IReadOnlyList<(int Id, string Text)> JaNein => new[] { (JA, Texte.OptionJa), (NEIN, Texte.OptionNein) };


    private IReadOnlyList<(int Id, string Text)> Messwerteinheiten => new[]
    {
        ((int)ZapfprofilMesswerteinheit.KwhJeJahr, Texte.MesswertKwh),
        ((int)ZapfprofilMesswerteinheit.KubikmeterJeJahr, Texte.MesswertM3)
    };

