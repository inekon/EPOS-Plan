@* Die Verwaltung "Kaeltemaschinen" (KU3-1, Teil 2) - der Katalog Tab_Kaeltemaschine_STAMM samt
   Kennlinie.

   GERUEST DER VERWALTUNGEN (Vorbild BaustoffKatalogDialog): Katalograhmen, Katalogliste mit
   ZeileIstWahl, Auswahlleiste, Stammblatt, Fussleiste Speichern - Verwerfen - Status - Neu... -
   Beenden. Unter Windows ein eigenes Fenster, auf iOS eine freie Ansicht der AppWurzel; die Datenseite liegt in der
   Huelle (EPOS.UI.Daten, KaeltemaschineKatalogHuelle) ueber KaeltemaschineStammCtrl.

   DIE LISTE: Bezeichner, Hersteller, Typ, Nennkaelteleistung, Nenn-EER, Rueckkuehlung - Profil und
   Zeilen aus dem Kern (Katalogfilterprofil.Finde(Anlagenart.Kaeltemaschine),
   KaeltemaschineStammCtrl.Katalogfilterzeilen); das Schloss steht hinter dem Bezeichner.

   DAS STAMMBLATT: zwei Gruppen - Kenndaten und Kennlinie. Die Rueckkuehlart ist eine Auswahl ueber
   den LISTENPLATZ; der Anzeigetext ist nie ein Steuerwert. Die Kennlinie ist ein Zeilenraster
   (Rueckkuehltemperatur, Kaltwassertemperatur, EER, Kaelteleistung; Punkt hinzufuegen, entfernen).
   Ein Auslieferungssatz steht als Text. Geschrieben wird allein mit "Speichern" - Kopf und
   Kennlinie in EINEM Vorgang, die Pruefregeln des Kerns (KaeltemaschineStammCtrl.Pruefen, darunter
   das Temperaturpaar je Geraet eindeutig) genau dort.

   TASTATUR: Esc schliesst stufenweise (Ueberlagerung, Rueckfrage, schmales Blatt, Dialog). *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-katalog-dialog epos-kaeltemaschine-admin" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@Texte.Titel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="Schliessen" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_meldung" />
    }
    @* KT-3: Wirft das Lesen der Katalogliste, nennt dieser Banner den Grund (Katalogladung). *@
    @if (!string.IsNullOrEmpty(_listeFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_listeFehler" />
    }
    @* KT-4: Wirft das Lesen des gewählten Satzes, nennt dieser Banner den Grund (Katalogladung.Satz). *@
    @if (!string.IsNullOrEmpty(_satzFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_satzFehler" />
    }
    @if (_katalog.Count == 0)
    {
        <p class="epos-leisezeile epos-kaeltemaschine-leer">@Texte.LeerKatalog</p>
    }

    <Katalograhmen BlattOffen="@_auswahl.BlattOffen">
        <Liste>
            <Katalogliste Profil="@Profil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_gewaehlt" GewaehltChanged="BeiZeile" ZeileIstWahl="true"
                          Vergleichsparameter="@Uebersicht"
                          Kaestchen="true" Gewaehlte="@_auswahl.Gewaehlte"
                          GewaehlteChanged="BeiKaestchen">
                <Werkzeug>
                    @* "TYPKENNFELDER AUSBLENDEN" nach dem Muster "nur mit Kuehlfunktion" der
                       Waermepumpenverwaltung: kein eigener Zustand, der Schalter setzt den
                       verneinten Trichter auf die Spalte Herkunft (KaeltemaschineStammCtrl.
                       AusdruckOhneTypkennfelder) - "Filter zuruecksetzen" nimmt ihn mit. *@
                    <Schalter Bezeichnung="@Texte.SchalterOhneTypkennfelder" Wert="@OhneTypkennfelder"
                              WertChanged="OhneTypkennfelderGesetzt" />
                </Werkzeug>
            </Katalogliste>
        </Liste>

        <Auswahl>
            <Auswahlleiste Fokus="@Fokusname" Anzahl="@_auswahl.Anzahl"
                           Handlungen="@Handlungen()"
                           Aufheben="BeiAufheben" Gesperrt="Warnen"
                           Stammblatt="@BlattOeffnenWeg" />
        </Auswahl>

        <Blatt>
            <Stammblatt Name="@_daten.Bezeichner" Unterzeile="@Unterzeile"
                        Auslieferung="@_auslieferung" SchlossText="@Filtertexte.Schloss"
                        Entsperrt="@(!_auslieferung && _schloss.Entsperrt(ZeileZu(_gewaehlt)))"
                        Kennzahlen="@Kennzahlen" Hinweis="@Aenderungshinweis"
                        ZurListe="@_blattSchliessen"
                        Vergleichskoepfe="@(_auswahl.Vergleich ? _vergleichskoepfe : null)"
                        Vergleichszeilen="@(_auswahl.Vergleich ? _vergleichszeilen : null)"
                        VergleichZurueck="BeiVergleichZurueck">
                <Gruppen>
                    @* KENNDATEN: direkt bedienbar; ein Auslieferungssatz als TEXT. *@
                    <Stammblattgruppe Titel="@Texte.GruppeKenndaten" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Kenndatenwerte(_daten) : null)">
                        <KindInhalt>
                            @Kenndatenfelder(_arbeit)
                        </KindInhalt>
                    </Stammblattgruppe>

                    @* TEILLAST UND TAKTEN (KM3-E3-a, Fachkonzept Teillast und Takten 7.1): Teillastrechnung,
                       Verdichterregelung, Kurve a/b/c, ihre Gueltigkeit, C_d und Kennfeldrand; darunter die Lesezeile
                       g(0,25)/g(0,5)/g(0,75), die kleine Kurve, die Schnellwahlen und die Auskunft. Die Mindestteillast
                       bleibt in den Kenndaten. Ein Auslieferungssatz als TEXT, Lesezeile, Kurve und Auskunft bleiben. *@
                    <Stammblattgruppe Titel="@Texte.GruppeTeillast" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Teillastwerte(_daten) : null)">
                        <KindInhalt>
                            @Teillastfelder(_arbeit)
                            @Teillastlesung(_arbeit)
                        </KindInhalt>
                        <Nachsatz>
                            @Teillastlesung(_daten)
                        </Nachsatz>
                    </Stammblattgruppe>

                    @* KENNLINIE: ein Zeilenraster; ein Auslieferungssatz als TEXT. *@
                    @* KENNLINIE (KD-3): ueber dem Zeilenraster die zwei Bilder EER und Kaelteleistung in Reitern -
                       wie die Waermepumpe; das Bild folgt jeder Aenderung des Rasters. Ein Auslieferungssatz zeigt
                       die Punkte als TEXT und darunter dieselben Bilder. *@
                    <Stammblattgruppe Titel="@Texte.GruppeKennlinie" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Kennlinienwerte(_daten) : null)">
                        <KindInhalt>
                            @Kennlinienbild(_arbeit)
                            @Kennlinienfelder(_arbeit)
                        </KindInhalt>
                        <Nachsatz>
                            @Kennlinienbild(_daten)
                        </Nachsatz>
                    </Stammblattgruppe>
                </Gruppen>
            </Stammblatt>
        </Blatt>
    </Katalograhmen>

    @* DIE FUSSLEISTE DER VERWALTUNG (V15): Speichern - Verwerfen - Fueller (Statuszeile) -
       Neu... - Beenden. Duplizieren..., Schloss und Loeschen stehen in der Auswahlleiste. *@
    <div class="epos-leiste">
        @if (Speichern is not null)
        {
            @if (_auslieferung)
            {
                <button type="button" class="epos-knopf" aria-disabled="true"
                        title="@Texte.SpeichernGesperrt" @onclick="BeiSpeichern">@Texte.KnopfSpeichern</button>
            }
            else
            {
                <button type="button" class="epos-knopf" disabled="@(!_geaendert)"
                        @onclick="BeiSpeichern">@Texte.KnopfSpeichern</button>
            }
            <button type="button" class="epos-knopf" disabled="@(!_geaendert)"
                    @onclick="BeiVerwerfen">@Texte.KnopfVerwerfen</button>
        }
        <span class="epos-leiste-fueller epos-status@(_statusFehler ? " epos-status--fehler" : "")" role="status">@_status</span>
        @if (Speichern is not null)
        {
            @* KM1: "Import..." (Copper-Kurvendatei, CSV-Kennfeldvorlage) und "Typkennfelder laden...".
               Ohne Importweg (iOS: keine Dateiwahl) lehnt der Knopf benannt ab statt zu fehlen. *@
            <button type="button" class="epos-knopf epos-importknopf" @onclick="ImportOeffnen">@Texte.KnopfImport</button>
            @if (TypkennfelderLaden is not null)
            {
                <button type="button" class="epos-knopf epos-kaeltemaschine-typkennfelder"
                        @onclick="TypkennfelderFragen">@Texte.KnopfTypkennfelder</button>
            }
            <button type="button" class="epos-knopf" @onclick="BeiNeu">@Texte.KnopfNeu</button>
        }
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="Schliessen">@Texte.KnopfBeenden</button>
    </div>

    @* --- "Neu...": dieselben Kenndaten, OK prueft und legt an; die Kennlinie folgt im Blatt --- *@
    <Ueberlagerung Offen="@_neuOffen" Titel="@Texte.TitelNeu" Geschlossen="NeuSchliessen">
        <KindInhalt>
            @if (_neuOffen)
            {
                <div class="epos-kaeltemaschine-neu">
                    @if (_neuMeldung.Length > 0)
                    {
                        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_neuMeldung" />
                    }
                    @Kenndatenfelder(_neu)
                    <SpeichernLeiste OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen" Ergebnis="NeuErgebnis" />
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- KM3-E3-a: Wahl eines Typkennfelds - "Kurve aus Typkennfeld..." uebernimmt Beiwerte, x_u und Regelung
           in den Arbeitsstand; "Typkennfeld auf Datenblatt skalieren..." fuehrt mit dem skalierten Satz in "Neu..." --- *@
    <Ueberlagerung Offen="@(_typwahl != Typwahl.Zu)" Titel="@TypwahlTitel" Geschlossen="TypwahlSchliessen">
        <KindInhalt>
            @if (_typwahl != Typwahl.Zu)
            {
                <div class="epos-kaeltemaschine-typwahl">
                    @if (_typwahlMeldung.Length > 0)
                    {
                        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_typwahlMeldung" />
                    }
                    <Formularraster>
                        <KindInhalt>
                            <Auswahlfeld Bezeichnung="@Texte.LabelTypkennfeld" Eintraege="@Typkennfeldeintraege"
                                         Platzhalter="@Texte.TypkennfeldWaehlen"
                                         Auswahl="@_typwahlPlatz" AuswahlChanged="w => { _typwahlPlatz = w; _typwahlMeldung = string.Empty; }" />
                            @if (_typwahl == Typwahl.Skalieren)
                            {
                                <Zahlenfeld Bezeichnung="@Texte.LabelNennkaelteleistung" Einheit="@Texte.EinheitKw"
                                            Feldname="@(Texte.KnopfSkalieren + " – " + Texte.LabelNennkaelteleistung)"
                                            Wert="@_skalierLeistung" WertChanged="w => _skalierLeistung = w" />
                                <Zahlenfeld Bezeichnung="@Texte.LabelNennEer"
                                            Feldname="@(Texte.KnopfSkalieren + " – " + Texte.LabelNennEer)"
                                            Wert="@_skalierEer" WertChanged="w => _skalierEer = w" />
                            }
                        </KindInhalt>
                    </Formularraster>
                    @if (_typwahl == Typwahl.Skalieren)
                    {
                        <p class="epos-leisezeile">@Texte.SkalierenHinweis</p>
                    }
                    <SpeichernLeiste OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen" Ergebnis="TypwahlErgebnis" />
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- KM3-E3-a: Auskunft "Teillastpunkte pruefen..." (Fachkonzept 3.7) - bis zu vier Paare aus
           Aussentemperatur und Lastgrad, gerechnet aus dem eigenen Kennfeld; keine Normtafel, keine
           voreingetragenen Punkte, keine Speicherung. --- *@
    <Ueberlagerung Offen="@_auskunftOffen" Titel="@Texte.KnopfTeillastpunkte" Geschlossen="AuskunftSchliessen">
        <KindInhalt>
            @if (_auskunftOffen)
            {
                <div class="epos-kaeltemaschine-auskunft">
                    <p class="epos-leisezeile">@Texte.AuskunftHinweis</p>
                    @if (_auskunftMeldung.Length > 0)
                    {
                        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_auskunftMeldung" />
                    }
                    <Formularraster>
                        <KindInhalt>
                            @for (int i = 0; i < _auskunftEingaben.Length; i++)
                            {
                                int index = i;
                                string punkt = string.Format(CultureInfo.CurrentCulture, Texte.AuskunftPunkt, AuskunftName(index));
                                <Zahlenfeld Bezeichnung="@(punkt + " – " + Texte.AuskunftAussen)" Einheit="@Texte.EinheitGradC"
                                            Feldname="@(punkt + " – " + Texte.AuskunftAussen)"
                                            Wert="@_auskunftEingaben[index].Aussen" WertChanged="w => _auskunftEingaben[index].Aussen = w" />
                                <Zahlenfeld Bezeichnung="@(punkt + " – " + Texte.AuskunftLastgrad)" Einheit="@Texte.EinheitProzent"
                                            Feldname="@(punkt + " – " + Texte.AuskunftLastgrad)"
                                            Wert="@_auskunftEingaben[index].Lastgrad" WertChanged="w => _auskunftEingaben[index].Lastgrad = w" />
                            }
                        </KindInhalt>
                    </Formularraster>
                    <button type="button" class="epos-knopf epos-kaeltemaschine-rechnen" @onclick="AuskunftRechnen">@Texte.AuskunftRechnen</button>
                    @if (_auskunftZeilen is { Count: > 0 })
                    {
                        <table class="epos-raster epos-kaeltemaschine-auskunfttafel">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@Texte.AuskunftAussen [@Texte.EinheitGradC]</th>
                                    <th>@Texte.AuskunftRueckkuehl [@Texte.EinheitGradC]</th>
                                    <th>@Texte.AuskunftKaelte [@Texte.EinheitKw]</th>
                                    <th>@Texte.AuskunftLastgradMaschine [@Texte.EinheitProzent]</th>
                                    <th>@Texte.AuskunftLeistungsaufnahme [@Texte.EinheitKw]</th>
                                    <th>@Texte.SpalteEer</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (KaeltemaschineAuskunftZeile z in _auskunftZeilen)
                                {
                                    <tr @key="z.Name">
                                        <td>@z.Name</td>
                                        <td>@z.AussenC.ToString("0.#", CultureInfo.CurrentCulture)</td>
                                        <td>@z.RueckkuehlC.ToString("0.#", CultureInfo.CurrentCulture)</td>
                                        <td>@z.KaelteKw.ToString("0.0", CultureInfo.CurrentCulture)</td>
                                        <td>@((z.LastgradMaschine * 100).ToString("0", CultureInfo.CurrentCulture))</td>
                                        <td>@z.LeistungsaufnahmeKw.ToString("0.00", CultureInfo.CurrentCulture)</td>
                                        <td>@z.Eer.ToString("0.00", CultureInfo.CurrentCulture)</td>
                                        <td>@AuskunftVermerk(z)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    <div class="epos-leiste">
                        <button type="button" class="epos-knopf" @onclick="AuskunftSchliessen">@Texte.Ok</button>
                    </div>
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Namensabfrage von "Duplizieren..." (AD-Q11): Vorbelegung "... (Kopie)" -------- *@
    <Ueberlagerung Offen="@_duplizierfrage" Titel="@Texte.KnopfDuplizieren"
                   Geschlossen="() => _duplizierfrage = false">
        <KindInhalt>
            @if (_duplizierfrage)
            {
                <NamensDialog TitelText="" FrageText="@Texte.LabelBezeichner"
                              Vorbelegung="@_kopievorschlag"
                              MeldungLeer="@Texte.NameLeer" Pruefung="NameBelegt"
                              OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen"
                              Geschlossen="BeiDuplizierName" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Rueckfrage Offen="@_loeschfrage" TitelText="@Texte.KnopfLoeschen"
                Frage="@_loeschfrageText"
                JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiLoeschfrage" />

    @* --- KM1: Rueckfrage vor dem Laden der eingebauten Typkennfelder ------------------- *@
    <Rueckfrage Offen="@_typfrage" TitelText="@Texte.KnopfTypkennfelder" Frage="@TypfrageText"
                JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiTypfrage" />

    @* --- KM1: "Import..." als Ueberlagerung; Titel und Kreuz traegt der Importdialog selbst *@
    <EPOS.UI.Dialoge.Import.ImportUeberlagerung KatalogGaben="@_importGaben" Geschlossen="ImportFertig" />

    @* --- Rueckfrage vor dem Umschalten des Schlosses (AD-Q15, Vorgabe Nein) *@
    <Rueckfrage Offen="@_schloss.FrageOffen" TitelText="@_schloss.Titel" Frage="@_schloss.Frage"
                VorgabeNein="true" JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiSchlossAntwort" />
</div>

@code {
    // =====================================================================
    // Gaben — die Datenseite liegt in der Hülle (KaeltemaschineKatalogHuelle)
    // =====================================================================

    /// <summary>Die Zeilen der Liste (<c>KaeltemaschineStammCtrl.Katalogfilterzeilen</c>); ohne sie ist die Liste leer.</summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    /// <summary>Die Spalten — <c>Katalogfilterprofil.Finde(Anlagenart.Kaeltemaschine)</c>; ohne sie das Profil mit den Ressourcentexten.</summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste — sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Ein eigener Filterstand statt des Registers (Muster der Verwaltungen).</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>
    /// Die Anzeigetexte der Rückkühlarten in der Reihenfolge der Listenplätze (aus dem Kern); ohne sie die
    /// Texte des Bündels. Der Listenplatz ist der Steuerwert.
    /// </summary>
    [Parameter] public IReadOnlyList<string>? Rueckkuehlarten { get; set; }

    /// <summary>Lädt eine Kältemaschine samt Kennlinie über ihre Id; <c>null</c> = es gibt sie nicht (mehr).</summary>
    [Parameter] public Func<int, KaeltemaschineDaten?>? Lies { get; set; }

    /// <summary>
    /// Die Prüfung des Kerns (<c>KaeltemaschineStammCtrl.Pruefen</c>) — <c>null</c> oder leer = gültig.
    /// Gerufen genau einmal, im Speicherweg (Stammblatt und „Neu…"), und vom Assistenten.
    /// </summary>
    [Parameter] public Func<KaeltemaschineDaten, string?>? Pruefen { get; set; }

    /// <summary>Schreibt einen Satz samt Kennlinie — Id 0 legt an. Ohne ihn weder „Speichern" noch „Neu…".</summary>
    [Parameter] public Func<KaeltemaschineDaten, KaeltemaschineSpeicherErgebnis>? Speichern { get; set; }

    /// <summary>Löscht einen Satz (<c>KaeltemaschineStammCtrl.Loeschen</c>); ohne ihn keine Handlung.</summary>
    [Parameter] public Func<int, KaeltemaschineSpeicherErgebnis>? Loeschen { get; set; }

    /// <summary>„Duplizieren…" (<c>KaeltemaschineStammCtrl.Duplizieren</c>); ohne ihn keine Handlung.</summary>
    [Parameter] public Func<int, string, KaeltemaschineSpeicherErgebnis>? Duplizieren { get; set; }

    /// <summary>„Schloss setzen…" / „Schloss aufheben…" (AD-Q15, <c>KaeltemaschineStammCtrl.SchlossSetzen</c>).</summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    // ---- Teillast und Takten (KM3-E3-a): Rechnungen des Kerns über die Hülle ----

    /// <summary>Die Namen der eingebauten Typkennfelder (Schnellwahlen); ohne sie keine Schnellwahl.</summary>
    [Parameter] public IReadOnlyList<string>? Typkennfeldnamen { get; set; }

    /// <summary>„Kurve aus Typkennfeld…": die Teillastfelder eines Typkennfelds; <c>null</c> = unbekannt.</summary>
    [Parameter] public Func<string, KaeltemaschineTypkurve?>? KurveAusTypkennfeld { get; set; }

    /// <summary>„Typkennfeld auf Datenblatt skalieren…" (Typkennfeld, Nennkälteleistung, Nenn-EER) — nur Rückgabe.</summary>
    [Parameter] public Func<string, double?, double?, KaeltemaschineSkalierErgebnis>? Skalieren { get; set; }

    /// <summary>„Teillastpunkte prüfen…": rechnet die Paare am Stand, ohne Speicherung.</summary>
    [Parameter] public Func<KaeltemaschineDaten, IReadOnlyList<KaeltemaschineAuskunftEingabe>, KaeltemaschineAuskunftErgebnis>? Auskunft { get; set; }

    /// <summary>Die Lesezeile g(0,25)/g(0,5)/g(0,75) samt Hinweis; ohne sie keine Lesezeile.</summary>
    [Parameter] public Func<KaeltemaschineDaten, KaeltemaschineTeillastLesestand>? Lesezeile { get; set; }

    /// <summary>Der Kontrollwert Nenn-EER (<c>KaeltemaschineStammCtrl.NennEerHinweis</c>); <c>null</c> = kein Hinweis.</summary>
    [Parameter] public Func<KaeltemaschineDaten, string?>? NennEerHinweis { get; set; }

    /// <summary>Die kleine Kurve „EER-Verhältnis über dem Lastgrad" (<c>KaeltemaschineTeillastbild</c>); ohne sie kein Bild.</summary>
    [Parameter] public Func<KaeltemaschineDaten, WindowsFormsApplication1.Zeichnung.Zeichenmodell?>? Teillastbild { get; set; }

    /// <summary>
    /// KD-3: die zwei Kennlinienbilder (EER, Kälteleistung) zum Arbeitsstand (<c>KaeltemaschineKennlinienbild</c>);
    /// ohne sie kein Bild, das Zeilenraster bleibt.
    /// </summary>
    [Parameter] public Func<KaeltemaschineDaten, KaeltemaschineKennlinienbilder>? Kennlinienbilder { get; set; }

    /// <summary>
    /// KD-3: die Parameterübersicht eines Satzes über seinen Bezeichner (<c>KaeltemaschineParameteruebersicht.Werte</c>)
    /// — die Katalogliste vergleicht damit statt über ihre Spalten.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Uebersicht { get; set; }

    /// <summary>
    /// KD-3: dieselbe Übersicht über die Id (<c>KaeltemaschineParameteruebersicht.WerteZuId</c>) — „Vergleichen" im
