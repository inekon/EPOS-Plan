    // Bild
    // =================================================================================

    /// <summary>
    /// Die gerechneten Zeichenmodelle, nach Schalterstellung getrennt.
    ///
    /// <para><b>Der Zwischenspeicher ist hier mehr als eine Ersparnis:</b> Der
    /// Baustein <c>DiagrammSvg</c> baut seinen Knotenbaum nur neu, wenn die REFERENZ
    /// des Modells wechselt. Ein Modell, das je Zeichenlauf neu entstünde, verwürfe
    /// mit dem Baum auch Zoom, Zeigerstelle und abgewählte Reihen.</para>
    /// </summary>
    private readonly Dictionary<bool, Zeichenmodell?> _modelle
        = new Dictionary<bool, Zeichenmodell?>();

    private Zeichenmodell? Modell
    {
        get
        {
            if (_bildzone > 0) return Zonenmodell;
            if (Bildauftrag is null) return null;
            if (_modelle.TryGetValue(_sortiert, out Zeichenmodell? vorhanden)) return vorhanden;

            Zeichenmodell? neu = Bildauftrag(_sortiert);
            _modelle[_sortiert] = neu;
            return neu;
        }
    }

    // ---- Die Diagrammwahl je Zone (Stufe G6b, Mehrzonenkonzept 2.8) ----------------

    /// <summary>0 = das ganze Gebäude, k ≥ 1 = die Zone auf Platz k − 1.</summary>
    private int _bildzone;

    /// <summary>Die gewählte Stelle der Diagrammwahl — Prüfhilfe für die Tests.</summary>
    public int Bildzone => _bildzone;

    /// <summary>
    /// Die Einträge der Diagrammwahl: das ganze Gebäude und jede Zone; leer bei höchstens einer
    /// Zone oder ohne Bildauftrag der Zonen.
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Diagrammwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            if (Daten.Zonen.Count < 2 || (BildauftragZone is null && BildauftragRaumtemperaturZone is null)) return liste;
            liste.Add((0, ZonenTexte.EintragGebaeude));
            for (int i = 0; i < Daten.Zonen.Count; i++) liste.Add((i + 1, Daten.Zonen[i].Name));
            return liste;
        }
    }

    /// <summary>Der Zusatz der Bildkennung — die Zone, damit jedes Bild seinen Ausschnitt führt.</summary>
    private string Zonenzusatz => _bildzone > 0 ? "-zone" + _bildzone.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";

    /// <summary>Die gewählte Zone; <c>null</c> für das ganze Gebäude.</summary>
    private GebaeudeBedarfZoneDaten? Bildzonensatz
        => _bildzone > 0 && _bildzone <= Daten.Zonen.Count ? Daten.Zonen[_bildzone - 1] : null;

    /// <summary>Der Platzhalter des Wärmelastbilds: bei einer unbeheizten Zone ihr Grund.</summary>
    private string PlatzhalterLast
        => Bildzonensatz is { IstBeheizt: false } z
            ? string.Format(System.Globalization.CultureInfo.CurrentCulture, ZonenTexte.BildUnbeheizt, z.Name)
            : PlatzhalterBild;

    private void DiagrammWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n > Daten.Zonen.Count || Diagrammwahl.Count == 0) return;
        _bildzone = n;
    }

    /// <summary>Die Wärmelastbilder der Zonen, nach Zone und Schalterstellung zwischengespeichert.</summary>
    private readonly Dictionary<(int, bool), Zeichenmodell?> _zonenmodelle = new();

    private Zeichenmodell? Zonenmodell
    {
        get
        {
            if (BildauftragZone is null) return null;
            var schluessel = (_bildzone, _sortiert);
            if (_zonenmodelle.TryGetValue(schluessel, out Zeichenmodell? vorhanden)) return vorhanden;
            Zeichenmodell? neu = BildauftragZone(_bildzone - 1, _sortiert);
            _zonenmodelle[schluessel] = neu;
            return neu;
        }
    }

    /// <summary>Die Raumtemperaturbilder der Zonen, je Zone einmal gerechnet.</summary>
    private readonly Dictionary<int, Zeichenmodell?> _zonenraummodelle = new();

    /// <summary>„35,3 / 32,1 °C" — die beiden Mittel des Heizkreises; ohne Heizstunde der Leertext.</summary>
    private string VorlaufRuecklaufWert
        => Daten.VorlaufMittelC is double v && Daten.RuecklaufMittelC is double r
            ? v.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " / "
              + r.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " °C"
            : LeerText;

    /// <summary>„211 h" — die Stunden mit begrenzter Übergabe, auf ganze Stunden.</summary>
    private string BegrenztWert
        => Daten.UebergabeBegrenztStundenH is double h
            ? h.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) + " " + EinheitStundenZahl
            : LeerText;

    /// <summary>Das Bild „Vorlauf und Rücklauf" — einmal gerechnet, damit der Zoom stehen bleibt.</summary>
    private Zeichenmodell? _vorlaufmodell;
    private bool _vorlaufmodellGerechnet;

    private Zeichenmodell? Vorlaufmodell
    {
        get
        {
            if (BildauftragVorlauf is null) return null;
            if (!_vorlaufmodellGerechnet)
            {
                _vorlaufmodell = BildauftragVorlauf();
                _vorlaufmodellGerechnet = true;
            }
            return _vorlaufmodell;
        }
    }

    /// <summary>„18,0 / 18,8 °C" — die beiden Mittel des Kältekreises (E37); ohne Kühlstunde der Leertext.</summary>
    private string KuehlvorlaufWert
        => Daten.KuehlVorlaufMittelC is double v && Daten.KuehlRuecklaufMittelC is double r
            ? v.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " / "
              + r.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " °C"
            : LeerText;

    /// <summary>„29 h" — die Stunden mit begrenzter Kühlübergabe, auf ganze Stunden.</summary>
    private string KuehlBegrenztWert
        => Daten.KuehlUebergabeBegrenztStundenH is double h
            ? h.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) + " " + EinheitStundenZahl
            : LeerText;

    /// <summary>Das Bild „Kühlvorlauf und Kühlrücklauf" — einmal gerechnet, damit der Zoom stehen bleibt.</summary>
    private Zeichenmodell? _kuehlvorlaufmodell;
    private bool _kuehlvorlaufmodellGerechnet;

    private Zeichenmodell? Kuehlvorlaufmodell
    {
        get
        {
            if (BildauftragKuehlvorlauf is null) return null;
            if (!_kuehlvorlaufmodellGerechnet)
            {
                _kuehlvorlaufmodell = BildauftragKuehlvorlauf();
                _kuehlvorlaufmodellGerechnet = true;
            }
            return _kuehlvorlaufmodell;
        }
    }

    /// <summary>Das Bild „Raumtemperatur" — einmal gerechnet, damit der Zoom stehen bleibt.</summary>
    private Zeichenmodell? _raummodell;
    private bool _raummodellGerechnet;

    private Zeichenmodell? Raummodell
    {
        get
        {
            if (_bildzone > 0)
            {
                if (BildauftragRaumtemperaturZone is null) return null;
                if (_zonenraummodelle.TryGetValue(_bildzone, out Zeichenmodell? zm)) return zm;
                Zeichenmodell? neuZ = BildauftragRaumtemperaturZone(_bildzone - 1);
                _zonenraummodelle[_bildzone] = neuZ;
                return neuZ;
            }
            if (BildauftragRaumtemperatur is null) return null;
            if (!_raummodellGerechnet)
            {
                _raummodell = BildauftragRaumtemperatur();
                _raummodellGerechnet = true;
            }
            return _raummodell;
        }
    }

    /// <summary>
    /// Das Bild der Kältelast (Stufe KU1) — nach Schalterstellung getrennt zwischengespeichert,
    /// aus demselben Grund wie <see cref="Modell"/>.
    /// </summary>
    private readonly Dictionary<bool, Zeichenmodell?> _kaeltemodelle
        = new Dictionary<bool, Zeichenmodell?>();

    private Zeichenmodell? Kaeltemodell
    {
        get
        {
            if (BildauftragKaelte is null) return null;
            if (_kaeltemodelle.TryGetValue(_sortiert, out Zeichenmodell? vorhanden)) return vorhanden;

            Zeichenmodell? neu = BildauftragKaelte(_sortiert);
            _kaeltemodelle[_sortiert] = neu;
            return neu;
        }
    }

    /// <summary>Trägt die Monatsübersicht die Spalte „Kühlung"? Nur mit Abschnitt und zwölf Werten.</summary>
    private bool KuehlspalteDa => Daten.KaelteAbschnitt && Daten.KuehlMonatswerteMwh.Count >= 12;

    private string Kuehlmonatswert(int m)
        => (Daten.KuehlMonatswerteMwh.Count > m)
            ? _einheit.Formatiere(_einheit.AusMWh(Daten.KuehlMonatswerteMwh[m]))
            : LeerText;

    /// <summary>
    /// Ganglinie und Dauerlinie sind zwei Bilder; der Schalter tauscht das Modell,
    /// und mit ihm beginnt der Zoom des Bildes von vorn. Er gilt für BEIDE Bilder, das der
    /// Wärmelast und das der Kältelast.
    /// </summary>
    private void SortiertGesetzt(bool wert) => _sortiert = wert;

    // =================================================================================

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Schließen — von Esc, Enter und dem Schliesskreuz gleichermaßen gerufen. Der
    /// Dialog zeigt nur an und trägt einen einzigen Knopf, deshalb immer <c>true</c>:
    /// Das Kreuz kopiert Esc, es erfindet keine neue Semantik.
    /// </summary>
    private Task Schliessen() => Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Esc UND Enter schließen. Der Dialog zeigt nur an und trägt einen einzigen Knopf —
    /// hier kann Enter nichts versehentlich schreiben (Regel aus <c>EPOS.UI/CLAUDE.md</c>).
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
        => (e.Key == "Escape" || e.Key == "Enter") ? Schliessen() : Task.CompletedTask;
}
