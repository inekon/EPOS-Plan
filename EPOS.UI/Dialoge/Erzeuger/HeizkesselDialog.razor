    private string? SatzKenndaten
    {
        get
        {
            if (SatzArt == Satzmarke.Keiner) return null;
            var teile = _detail.Felder.Where(f => !string.IsNullOrWhiteSpace(f.Wert)).Take(3)
                .Select(f => f.Feld.TrimEnd(':', ' ') + " " + f.Wert).ToList();
            if (KatalogsatzGesperrt) teile.Add(Resource.AUSWAHL_SATZ_NUR_LESEN);
            return string.Join(" · ", teile);
        }
    }

