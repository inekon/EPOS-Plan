    /// und überlebt den Satzwechsel, wird aber nirgends abgelegt (W6‑E‑1).
    /// </summary>
    /// <remarks>
    /// <b>Vorgabe OFFEN</b> (Anwenderentscheid 16.09.2026). Deshalb holt schon die
    /// ERSTE Wahl eines Katalogsatzes die Felder — <see cref="FelderNachziehen"/> tut
    /// das für jeden Satzwechsel, und ohne gewählten Satz gibt es den Block nicht.
    /// </remarks>
    private bool _parameterOffen = true;

    /// <summary>Steht der Parameterblock offen? (Prüfhilfe für Tests, W6‑E‑1.)</summary>
    public bool ParameterOffen => _parameterOffen;

    /// <summary>Die Felder des gewählten Satzes; <c>null</c> = noch nicht geholt.</summary>
    private IReadOnlyList<BrowserFeldwert>? _felder;

    /// <summary>Hat der Anwender im Aufklapper etwas geändert?</summary>
    private bool _felderGeaendert;

    /// <summary>Knopf „Speichern" des Aufklappers samt Rückmeldung daneben.</summary>
    private Speichervermerk? _felderVermerk;

    /// <summary>Meldung des Katalogs zum letzten gelungenen Speichern — für den Assistenten, nicht als Band.</summary>
    private string _felderErfolg = "";

    /// <summary>Steht in einem Zahlenfeld des Aufklappers etwas Ungültiges?</summary>
    private bool _feldFehler;

    /// <summary>
    /// Auf- und zuklappen - und beim AUFklappen die Felder holen.
    /// </summary>
    /// <remarks>
    /// <b>Der Knopf bleibt, die Vorgabe ist offen.</b> Wer zuklappt und wieder
    /// aufklappt, sieht den Stand von JETZT und nicht den von der Auswahl.
    /// </remarks>
    private void ParameterUmschalten()
    {
        _parameterOffen = !_parameterOffen;
        if (_parameterOffen) FelderHolen();
    }

    /// <summary>Holt die Felder des gewählten Katalogsatzes neu.</summary>
    private void FelderHolen()
    {
        _felder = Katalogfelder is null || _katalogZeile is null
            ? null
            : Katalogfelder(_katalogZeile.Bezeichner);
        _felderGeaendert = false;
        _feldFehler = false;
    }

    /// <summary>
    /// Nach einem SATZWECHSEL: Der offene Aufklapper zeigt die Felder des JETZT
    /// gewählten Satzes, der geschlossene gar keine.
    /// </summary>
    /// <remarks>
    /// <b>Sonst speicherte der Knopf fremde Werte.</b> <see cref="FelderSpeichern"/>
    /// schreibt <c>_felder</c> unter dem Bezeichner der GEWÄHLTEN Zeile zurück — bliebe
    /// der alte Feldsatz stehen, landeten die Werte des vorigen Kessels im neuen.
    /// </remarks>
    private void FelderNachziehen()
    {
        if (_parameterOffen && _katalogZeile is not null) { FelderHolen(); return; }

        _felder = null;
        _felderGeaendert = false;
        _feldFehler = false;
    }

    /// <summary>Ein Zahlenfeld des Aufklappers meldet einen ungültigen Zustand.</summary>
    private void BeiFeldFehler((string Feldname, bool Fehler) meldung)
        => _feldFehler = meldung.Fehler;

    /// <summary>Eine Eingabe im Aufklapper: Speichern geht wieder, der Vermerk fällt weg.</summary>
    private void FeldGeaendert()
    {
        _felderGeaendert = true;
        _felderVermerk?.Leeren();
    }

    /// <summary>
    /// Schreibt die geänderten Felder zurück und lädt Liste und Detailblock neu.
    /// </summary>
    /// <remarks>
    /// <b>Der Befund des Katalogs zählt, nicht die Absicht.</b> Lehnt der Speicherweg ab
    /// (Schreibschutz der Auslieferung, Prüfmeldung), bleibt der geänderte Stand im
    /// Aufklapper stehen - der Anwender soll ihn verbessern können, statt ihn zu
    /// verlieren.
    /// </remarks>
    private void FelderSpeichern()
    {
        if (KatalogfelderSpeichern is null || _felder is null || _katalogZeile is null) return;

        KatalogSpeicherErgebnis ergebnis = KatalogfelderSpeichern(_katalogZeile.Bezeichner, _felder);
        if (!ergebnis.Ok)
        {
            // Das Band oben bleibt fuer den Fehler - dazu der Grund rot am Knopf.
            Melden(ergebnis.Meldung, true);
            _felderVermerk?.Fehler(ergebnis.Meldung);
            return;
        }

        // Der Erfolg steht nur noch am Knopf; ein Band einer frueheren Ablehnung faellt weg.
        _felderGeaendert = false;
        _meldung = "";
        _felderErfolg = ergebnis.Meldung;
        _felderVermerk?.Gespeichert();
        KatalogNeuLaden();
    }

    private IReadOnlyDictionary<string, object>? _traegerGaben;
    private IReadOnlyDictionary<string, object>? _editorGaben;
