                            <span class="epos-pausl-beschriftung">@Texte.Kriterium(k.Kennung)</span>
                            <span>@Kriteriumswert(k)</span>
                            @if (AbStandard && k.Rechenweg.Length > 0)
                            {
                                <span class="epos-pausl-rechenweg">@k.Rechenweg</span>
                            }
                        </div>
