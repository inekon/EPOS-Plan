    // =====================================================================
    // Übernahme aus der Kategorie — erst fragen, dann schreiben
    // =====================================================================

    /// <summary>
    /// Öffnet die Rückfrage zu einer Größe. Gibt die Kategorie nichts her, sagt
    /// der Weg das und bietet NICHTS an — dann bleibt es bei der Lücke.
    /// </summary>
    private void LueckeOeffnen(string groesse)
    {
        Melden("");
        if (LueckenWahl is null) return;

        Uebernahmewahl wahl = LueckenWahl(groesse);
        if (wahl.Kandidaten.Count == 0)
        {
            Melden(wahl.LeerText, WarnStufe.Hinweis);
            return;
        }

        // Auch der einzige Kandidat wird VORGELEGT, nicht gesetzt: geschrieben
        // wird erst mit „Übernehmen".
        _lueckeWahl = wahl.Kandidaten[0].Id;
        _luecke = wahl;
    }

    private void LueckeAusfuehren()
    {
        Uebernahmewahl? wahl = _luecke;
        int? geber = _lueckeWahl;
        _luecke = null;
        _lueckeWahl = null;

        if (wahl is null || geber is null || LueckeUebernehmen is null) return;
        if (!LueckeUebernehmen(wahl.Groesse, geber.Value)) return;

        // Die Hülle hat geschrieben und die Karte nachgezogen; die Ansicht folgt,
        // damit Wert und Herleitungszeile sofort dastehen.
        Melden("");
        Nachziehen();
    }

