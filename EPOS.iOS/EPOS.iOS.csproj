<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    EPOS.iOS - die iOS-HUELLE von EPOS-Plan (Umsetzungskonzept iOS, Paket iU10).

    WAS SIE IST. Eine MAUI-App mit genau EINER ContentPage, und in dieser eine
    BlazorWebView. Die Oberflaeche selbst liegt unveraendert in EPOS.UI, der
    Rechenweg unveraendert in EPOS.Kern. Diese Huelle traegt nur, was die
    Plattform beisteuert: den Einstiegspunkt, die neun Dienstadapter, den Weg
    zur Datenbank in der Sandbox und - fuer die CI - den Pruefmodus.

    WARUM MAUI UND NICHT EIN REINES Microsoft.iOS-PROJEKT. Fuer net10.0-ios gibt
    es ausserhalb von Microsoft.AspNetCore.Components.WebView.Maui keinen
    BlazorWebView-Host; das Basispaket Components.WebView ist abstrakt, ein
    eigener WebViewManager ueber WKWebView waere ungestuetzter Eigenbau. Dazu
    decken die MAUI-Essentials sechs der neun Adapter ab (Preferences,
    SecureStorage, FilePicker, Share, Launcher, FileSystem). Die MAUI-Flaeche
    bleibt trotzdem minimal: keine Shell, kein XAML, keine MAUI-Navigation -
    die Navigation lebt in Blazor (EPOS.UI/Seiten/AppWurzel).

    WARUM Microsoft.NET.Sdk.Razor UND NICHT Microsoft.NET.Sdk. Dieselbe Wahl wie
    in der Windows-Huelle (iU8-6): Nur das Razor-SDK packt die statischen
    Web-Bestaende einer Razor-Klassenbibliothek mit ein. Ohne es fehlte
    "_content/EPOS.UI/epos-ui.css" im Anwendungspaket und die Oberflaeche waere
    ungestaltet. wwwroot wird dadurch automatisch aufgenommen und braucht KEINE
    eigene MauiAsset-Zeile.

    WARUM EINE EIGENE PROJEKTMAPPE (EPOS.iOS.sln; Praezedenz Proben/ChartProben
    und Werkzeuge/Formularkarte). Dieses Projekt steht bewusst NICHT in
    WP-Plan.sln und nicht im Solution-Filter: Auf ubuntu und windows gibt es die
    iOS-Workload nicht, jeder Restore dort braeche mit NETSDK1147.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <!-- Platforms\iOS\ wird zur Plattformmappe; damit findet die Buildkette
         Info.plist, AppDelegate und die Ressourcen an ihrem MAUI-ueblichen Ort. -->
    <SingleProject>true</SingleProject>
    <!-- Implizite MAUI-Referenzen auf die CPM-Fassung von WebView.Maui heben:
         Das Workload-Set 10.0.400.1 bringt MAUI 10.0.20 mit, die letzte stabile
         WebView.Maui-Fassung ist 10.0.100 und haengt an Microsoft.Maui.Controls
         DERSELBEN Fassung - ohne Angleich NU1605 (iR-b). -->
    <MauiVersion>10.0.100</MauiVersion>

    <RootNamespace>EPOS.iOS</RootNamespace>
    <AssemblyName>EPOS.iOS</AssemblyName>
    <ApplicationTitle>EPOS-Plan</ApplicationTitle>
    <ApplicationId>de.inekon.eposplan</ApplicationId>
    <!-- Gleiche Version wie Windows (WindowsFormsApplication1\Properties\AssemblyInfo.cs),
         Update-Logbuch 1.2.0.1. CFBundleShortVersionString traegt nach Apples Vorgabe
         drei Zahlen, deshalb bleibt die Anzeige 1.2.0 und die Revision zaehlt in
         ApplicationVersion (CFBundleVersion) hoch. -->
    <ApplicationDisplayVersion>1.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>

    <!-- 17.0: von SkiaSharp.NativeAssets.iOS 3.119 (net8.0-ios17.0) erzwungen;
         MAUI 10 selbst kaeme mit 15.0 aus (iF28 - iPads ab 2018). -->
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <!-- KEIN RuntimeIdentifiers HIER. Die Kennung kommt je Bau mit -r:
         iossimulator-arm64 (Simulator, ios.yml) oder ios-arm64 (Geraet); ohne -r
         waehlt das SDK den Simulator der Rechnerarchitektur. Eine Liste
         "iossimulator-arm64;ios-arm64" machte den Geraetebau zum Simulatorbau:
         Xamarin.Shared.Sdk.props setzt _SdkIsSimulator, sobald RuntimeIdentifier
         ODER RuntimeIdentifiers "simulator" enthaelt, und das VOR der Stelle
         (Xamarin.Shared.Sdk.DefaultItems.targets), an der ein -r die Liste
         verwirft. Folge mit -r ios-arm64: Link gegen das Simulator-SDK, kein AOT,
         ComputedPlatform=iPhoneSimulator - und SQLitePCLRaw.lib.e_sqlite3.ios
         haengt die Geraete-e_sqlite3.a (RuntimeIdentifier=ios-arm64) UND die des
         Simulators (ComputedPlatform) an; ld bricht an der Geraetebibliothek ab.
         Ohne -r waere die gemischte Liste ein Fehler des SDK (Geraet und
         Simulator in einem Bau). -->

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <SatelliteResourceLanguages>de-DE;en-US</SatelliteResourceLanguages>

    <!-- Rechen- und Anzeigekultur wie auf den drei anderen Laeufern (ICU, kein
         Hybrid). HybridGlobalization=false ist der Riegel gegen iR-d: Mit der
         Hybridfassung rechnete iOS mit anderen Zahlenformaten als Windows, und
         der Ergebnisvergleich maesse Kulturdrift statt Plattformdrift. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <HybridGlobalization>false</HybridGlobalization>

    <!-- Seed-Datenbank: in der CI die eingecheckte Testdatenbank; ein Produktbau
         uebergibt -p:SeedDb=<Pfad> (iF25). -->
    <SeedDb Condition="'$(SeedDb)' == ''">..\Referenzlaeufe\Kenndaten_Test.sqlite</SeedDb>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EPOS.Kern\EPOS.Kern.csproj" />
    <ProjectReference Include="..\EPOS.UI\EPOS.UI.csproj" />
    <!-- Die DATENSEITE der Oberflaeche (Auftrag #208): die plattformfreien Huellen,
         die aus Kern-Controllern die DTO der Razor-Seiten bauen. Ohne sie muesste
         diese Huelle den Ladeweg der Simulation nachbauen - genau die Doppelpflege,
         die Modell C abschafft. -->
    <ProjectReference Include="..\EPOS.UI.Daten\EPOS.UI.Daten.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seit .NET 8 fuegt das MAUI-Workload Microsoft.Maui.Controls NICHT mehr implizit
         hinzu; die Vorlage referenziert es ausdruecklich (Befund zweiter CI-Lauf 03.09.2026:
         CS0234 "Microsoft.Maui" fehlt trotz UseMaui). Fassung aus Directory.Packages.props. -->
    <PackageReference Include="Microsoft.Maui.Controls" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" />

    <!-- iOS-Native des Kern-Renderers - Gegenstueck zu den drei bedingten
         Nativen in EPOS.Kern.csproj (Win32, Linux, macOS). -->
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />

    <!-- AUSDRUECKLICH, obwohl Microsoft.Data.Sqlite es ohnehin transitiv zieht:
         Auf iOS liefert dieses Paket "provider.internal" (DllImport __Internal)
         und eine STATISCH gelinkte e_sqlite3.a je Geraet und Simulator. Damit
         faehrt iOS dieselbe SQLite 3.53.3 wie Windows, Linux und der macOS-CI -
         die Voraussetzung fuer die 114 STRICT-Tabellen der Datenbank (iF27). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />

    <!-- KI-SEMANTIKSUCHE IST AUF iOS NICHT ERREICHBAR (iF26). Die native
         Haelfte von OnnxRuntime ist eine 46 MB grosse xcframework, die statisch
         mit -lc++ gelinkt wuerde. Sie bleibt draussen; SemantikModell scheitert
         damit erst beim Aufruf und nicht beim Start. Aufheben = diese Zeile
         loeschen. Chat und Wiki laufen ueber REST und sind unberuehrt. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" ExcludeAssets="native;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- Seed-Datenbank und Berichtsvorlagen liegen als Anwendungsbestand im
         Paket; gelesen werden sie ueber FileSystem.OpenAppPackageFileAsync.
         Die Vorlagen tragen denselben Unterordner Vorlagen\ wie unter Windows
         (Lieferweg dort: WindowsFormsApplication1.csproj; Konzept
         Berichtsvorlagen 6.3 und 8.4; die Wache
         EPOS.Kern.Tests/AuslieferungsvorlagenWacheTests haelt beide Lieferwege).
         Berichtsvorlage.docx ist die Stilvorlage des WordBerichtGenerator, die
         FindeVorlage unter Vorlagen\ sucht, und bleibt als Rueckfall des Codes
         ausgeliefert.
         Berichtsvorlage_Standard.docx ist die Standardvorlage mit Platzhaltern
         im vollen Aufbau.
         Berichtsvorlage_Kurzbericht.docx und Berichtsvorlage_Kurzbericht_en.docx
         sind der Kurzbericht je Sprache, nur als Kopie ueber "Neue Vorlage..."
         waehlbar.
         Berichtsvorlage_Ausfuehrlich.docx und Berichtsvorlage_Ausfuehrlich_en.docx
         sind die ausfuehrliche Vorlage je Sprache (der volle Bericht aus
         Einzelelementen), ebenfalls nur als Kopie waehlbar.
         Berichtsvorlage_Bausteine.dotx und Berichtsvorlage_Bausteine_en.dotx
         sind die Bausteinvorlage je Sprache (jeder Platzhalter als
         Schnellbaustein), fuer den Musterordner.
         Berichtsvorlage_Excel_Ausfuehrlich.xlsx und Berichtsvorlage_Excel_Ausfuehrlich_en.xlsx
         sind die ausfuehrliche Excel-Vorlage je Sprache (BV-E9), in der Zeile
         "Excel-Vorlage" direkt waehlbar.
         Berichtsvorlage_Beispiel.docx (Anschauung) wird nicht ausgeliefert. -->
    <MauiAsset Include="$(SeedDb)" LogicalName="Kenndaten.sqlite" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage.docx"
               LogicalName="Vorlagen\Berichtsvorlage.docx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Standard.docx"
               LogicalName="Vorlagen\Berichtsvorlage_Standard.docx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Kurzbericht.docx"
               LogicalName="Vorlagen\Berichtsvorlage_Kurzbericht.docx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Kurzbericht_en.docx"
               LogicalName="Vorlagen\Berichtsvorlage_Kurzbericht_en.docx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Ausfuehrlich.docx"
               LogicalName="Vorlagen\Berichtsvorlage_Ausfuehrlich.docx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Ausfuehrlich_en.docx"
               LogicalName="Vorlagen\Berichtsvorlage_Ausfuehrlich_en.docx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Bausteine.dotx"
               LogicalName="Vorlagen\Berichtsvorlage_Bausteine.dotx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Bausteine_en.dotx"
               LogicalName="Vorlagen\Berichtsvorlage_Bausteine_en.dotx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Excel_Ausfuehrlich.xlsx"
               LogicalName="Vorlagen\Berichtsvorlage_Excel_Ausfuehrlich.xlsx" />
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Bericht\Vorlagen\Berichtsvorlage_Excel_Ausfuehrlich_en.xlsx"
               LogicalName="Vorlagen\Berichtsvorlage_Excel_Ausfuehrlich_en.xlsx" />

    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#0F1F3D" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F5F4EF" BaseSize="128,128" />

    <!-- Die Zuordnungsdatei der Hilfe - DIESELBE Datei, die auch die
         Windows-Huelle als eingebettete Ressource mitliefert. Sie ist die
         einzige Stelle, an der Hilfe gepflegt wird; zwei Fassungen waeren zwei
         Wahrheiten. -->
    <MauiAsset Include="..\WindowsFormsApplication1\Allgemein\Hilfe\help_mapping.txt"
               LogicalName="help_mapping.txt" />
  </ItemGroup>

  <!-- ================================================================== -->
  <!-- PRUEFMODUS FUER DIE CI (iU10-6, Abnahmeziel iZ6)                    -->
  <!--                                                                    -->
  <!-- Die beiden Bausteine des Referenzlaufs werden VERLINKT, nicht       -->
  <!-- kopiert - genau wie EPOS.Referenzlauf sie verlinkt. Damit gibt es   -->
  <!-- weiterhin EINE Fassung des CSV-Exports; ein iOS-Ergebnis, das       -->
  <!-- anders aussieht, ist dann eine Plattformabweichung und kein         -->
  <!-- anderer Exportweg.                                                  -->
  <!--                                                                    -->
  <!-- ZWEI WARNUNGEN BLEIBEN STEHEN. Beide Dateien sind - wie das         -->
  <!-- Werkzeug, aus dem sie stammen - ohne Nullbarkeitsangaben            -->
  <!-- geschrieben (Referenzlauf.csproj setzt Nullable=disable). In diesem -->
  <!-- Projekt gilt Nullable=enable; daraus entstehen genau zwei           -->
  <!-- Warnungen, CS8602 in Ergebnisexport und CS8604 in Protokoll. Ein    -->
  <!-- NoWarn dagegen gaelte fuer die GANZE Huelle - die soll scharf       -->
  <!-- bleiben. Die zwei Zeilen sind der Preis dafuer, dass es weiterhin   -->
  <!-- nur EINE Fassung des Exports gibt.                                  -->
  <!-- ================================================================== -->
  <ItemGroup>
    <Compile Include="..\Referenzlauf\Ergebnisexport.cs" Link="Pruefung\Ergebnisexport.cs" />
    <Compile Include="..\Referenzlauf\Protokoll.cs" Link="Pruefung\Protokoll.cs" />
  </ItemGroup>

  <!-- ================================================================== -->
  <!-- IMPORTPROBE (G4-8, Umsetzungskonzept Gebaeudesimulation 3.6)        -->
  <!--                                                                    -->
  <!-- Vier kleine Proben (zusammen rund 80 KB) fuer den Gebaeudeimport im -->
  <!-- Pruefmodus (Pruefung/Importprobe.cs). Sie kommen NUR mit            -->
  <!-- -p:Importproben=true ins Paket - so baut der Abnahmeweg von ios.yml -->
  <!-- (Eingang abnahme_g4a); jeder andere Bau, auch der gewoehnliche      -->
  <!-- Rauchtest, bleibt ohne sie. Flache Namen im Paketstamm, gelesen ueber -->
  <!-- FileSystem.OpenAppPackageFileAsync wie die Seed-Datenbank.          -->
  <!-- ================================================================== -->
  <ItemGroup Condition="'$(Importproben)' == 'true'">
    <MauiAsset Include="..\Referenzlaeufe\Importproben\gbxml_haus_si.xml" LogicalName="importprobe_gbxml_haus_si.xml" />
    <MauiAsset Include="..\Referenzlaeufe\Importproben\ifc4_haus.ifc" LogicalName="importprobe_ifc4_haus.ifc" />
    <MauiAsset Include="..\Referenzlaeufe\Importproben\ifc4_haus.ifczip" LogicalName="importprobe_ifc4_haus.ifczip" />
    <MauiAsset Include="..\Referenzlaeufe\Importproben\ifc2x3_haus.ifc" LogicalName="importprobe_ifc2x3_haus.ifc" />
  </ItemGroup>

  <!-- ================================================================== -->
  <!-- KATALOGPROBE (ZU26, Umsetzungskonzept Zapfprofilgenerator 5.5)      -->
  <!--                                                                    -->
  <!-- Das erfundene Probepaket der Brauchwasser-Nutzungsarten - sieben     -->
  <!-- CSV, zusammen rund 3 KB - fuer die Katalogprobe des Pruefmodus      -->
  <!-- (Pruefung/Katalogprobe.cs). ANDERS ALS DIE IMPORTPROBEN ohne        -->
  <!-- Schalter: Sie sind so klein, dass ein eigener Bauweg mehr kostet    -->
  <!-- als sie selbst, und die Probe laeuft trotzdem nur mit               -->
  <!-- EPOS_PRUEFLAUF_KATALOGIMPORT. Die Schale packt sie zur Laufzeit in  -->
  <!-- EIN ZIP-Archiv - genau das, was der Anwender auf dem iPad waehlt.   -->
  <!-- Flache Namen im Paketstamm, gelesen ueber                            -->
  <!-- FileSystem.OpenAppPackageFileAsync wie die Seed-Datenbank.          -->
  <!-- ================================================================== -->
  <ItemGroup>
    <MauiAsset Include="..\EPOS.Kern.Tests\Proben\Zapfprofil\Katalogpaket\Tab_TwwTagesgangsatz_STAMM.csv" LogicalName="katalogprobe_Tab_TwwTagesgangsatz_STAMM.csv" />
    <MauiAsset Include="..\EPOS.Kern.Tests\Proben\Zapfprofil\Katalogpaket\Tab_TwwTagesgang_STAMM.csv" LogicalName="katalogprobe_Tab_TwwTagesgang_STAMM.csv" />
    <MauiAsset Include="..\EPOS.Kern.Tests\Proben\Zapfprofil\Katalogpaket\Tab_TwwNutzungsart_STAMM.csv" LogicalName="katalogprobe_Tab_TwwNutzungsart_STAMM.csv" />
    <MauiAsset Include="..\EPOS.Kern.Tests\Proben\Zapfprofil\Katalogpaket\Tab_TwwZapfkategorie_STAMM.csv" LogicalName="katalogprobe_Tab_TwwZapfkategorie_STAMM.csv" />
    <MauiAsset Include="..\EPOS.Kern.Tests\Proben\Zapfprofil\Katalogpaket\Tab_TwwBedarfstag_STAMM.csv" LogicalName="katalogprobe_Tab_TwwBedarfstag_STAMM.csv" />
    <MauiAsset Include="..\EPOS.Kern.Tests\Proben\Zapfprofil\Katalogpaket\Tab_TwwBedarfstagEreignis_STAMM.csv" LogicalName="katalogprobe_Tab_TwwBedarfstagEreignis_STAMM.csv" />
    <MauiAsset Include="..\EPOS.Kern.Tests\Proben\Zapfprofil\Katalogpaket\Tab_TwwParameter_STAMM.csv" LogicalName="katalogprobe_Tab_TwwParameter_STAMM.csv" />
  </ItemGroup>

  <!-- ================================================================== -->
  <!-- BAU OHNE xBIM (-p:OhneXbim=true; ADR-003 Aufgabe 7)                 -->
  <!--                                                                    -->
  <!-- Nur fuer den Groessenvergleich des Geraetebaus in ios.yml: Der Kern -->
  <!-- baut dann ohne die Paketzeile Xbim.IO.MemoryModel (siehe            -->
  <!-- EPOS.Kern.csproj), und die Importprobe faellt mit ihr weg - sie     -->
  <!-- misst ueber Importmessung auch xBIM. Die Eigenschaft gilt als       -->
  <!-- globale Eigenschaft des Aufrufs fuer alle referenzierten Projekte.  -->
  <!-- ================================================================== -->
  <PropertyGroup Condition="'$(OhneXbim)' == 'true'">
    <DefineConstants>$(DefineConstants);OHNE_XBIM</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(OhneXbim)' == 'true'">
    <Compile Remove="Pruefung\Importprobe.cs;Pruefung\Prozessspeicher.cs" />
  </ItemGroup>

</Project>
