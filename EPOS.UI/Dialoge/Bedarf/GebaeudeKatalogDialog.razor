    private IReadOnlyList<(int Id, string Text)> Eintraege(IReadOnlyList<string> quelle, string bestand)
    {
        var l = new List<(int, string)>();

        // Ein Bestandswert, den die Liste nicht (mehr) fuehrt, wird vorangestellt.
        if (!string.IsNullOrEmpty(bestand) && !quelle.Contains(bestand)) l.Add((-1, bestand));
        for (int i = 0; i < quelle.Count; i++) l.Add((i, quelle[i]));
        return l;
    }

    private static int? Index(IReadOnlyList<string> quelle, string wert)
    {
        if (string.IsNullOrEmpty(wert)) return null;
        for (int i = 0; i < quelle.Count; i++)
            if (string.Equals(quelle[i], wert, StringComparison.Ordinal)) return i;
        return -1;
    }

    private IReadOnlyList<(int Id, string Text)> Typeintraege => Eintraege(_typen, _stand.Typ);
    private int? Typindex => Index(_typen, _stand.Typ);

    private IReadOnlyList<(int Id, string Text)> Arteintraege => Eintraege(_arten, _stand.Gebaeudeart);
    private int? Artindex => Index(_arten, _stand.Gebaeudeart);

    private IReadOnlyList<(int Id, string Text)> Namenseintraege => Liste(_namen);
    private IReadOnlyList<(int Id, string Text)> Klasseneintraege => Liste(Baualtersklassen);
    private IReadOnlyList<(int Id, string Text)> Bauarteintraege => Liste(Bauarten);
    private IReadOnlyList<(int Id, string Text)> Verwendungseintraege => Liste(Verwendungen);

    private static IReadOnlyList<(int Id, string Text)> Liste(IReadOnlyList<string> quelle)
    {
        var l = new List<(int, string)>();
        for (int i = 0; i < quelle.Count; i++) l.Add((i, quelle[i]));
        return l;
    }

