    /// <summary>
    /// Liest Anlagen, Katalog und Wärmepumpen. Wirft eine Gabe, bricht der Aufbau nicht ab (KT-2/KT-3): Die Liste
    /// bleibt leer, der Banner nennt die Meldung.
    /// </summary>
    protected override void OnInitialized()
    {
        var fehler = new List<string>();
        try
        {
            foreach (KaeltemaschineAnlageDaten d in Anlagen?.Invoke() ?? Array.Empty<KaeltemaschineAnlageDaten>())
                _zeilen.Add(new Zeile { Schluessel = NeuerSchluessel(), Original = d.Kopie(), Gelesen = d, Arbeit = d.Kopie() });
        }
        catch (Exception ex)
        {
            _zeilen.Clear();
            fehler.Add(string.Format(CultureInfo.CurrentCulture, Texte.LadenFehler, ex.Message));
        }
        try
        {
            _wpGelesen = Waermepumpen?.Invoke() ?? Array.Empty<KuehlWaermepumpe>();
        }
        catch (Exception ex)
        {
            _wpGelesen = Array.Empty<KuehlWaermepumpe>();
            fehler.Add(string.Format(CultureInfo.CurrentCulture, Texte.WaermepumpenLadenFehler, ex.Message));
        }
        _meldung = string.Join(" ", fehler);
        _filterstand = Katalogfilterregister.Stand(Profil.Art);
        KatalogNeuLaden();
        if (_zeilen.FirstOrDefault() is Zeile erste) ProjektZeileWaehlen(erste);
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.KAELTEMASCHINE_ANLAGE, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    private string NeuerSchluessel() => (_naechsterSchluessel++).ToString(CultureInfo.InvariantCulture);

