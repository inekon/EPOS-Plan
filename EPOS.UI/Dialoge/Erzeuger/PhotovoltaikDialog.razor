    private KiMaskenanmeldung? _kiMaske;

    /// <summary>
    /// Was der Assistent über den Feldwert hinaus darf: Speichern ist der Knopf des Aufklappers „Alle Daten";
    /// ohne geänderte Felder übernimmt er die Anlagenwerte der gewählten Zeile.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _projektZeile?.NurLesen ?? false,
        // Sperrgrund je Feld vor der Bestätigung: Energieträger nur von Hand, ohne gewählte
        // Zeile (und ohne Einzelwahl) keine Zeilenfelder.
        Sperrgrund = f => KiSicht() is { } sicht ? sicht.Sperrgrund(f) : ErzeugerSperre.Grund(f, false, () => 0, mitTraeger: true),
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>„Speichern" des Assistenten — der Weg des Knopfes im Aufklapper, sonst die Übernahme der Anlage.</summary>
    private KiKern.KiErgebnis KiSpeichern()
    {
        if (!_felderGeaendert) return KiUebernehmen();
        FelderSpeichern();
        return _felderGeaendert
            ? KiKern.KiErgebnis.Abgelehnt(_meldung.Length > 0 ? _meldung
                  : Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText))
            : KiKern.KiErgebnis.Ok(_felderErfolg, anzahl: 1);
    }

    private KiKern.KiErgebnis KiUebernehmen()
    {
        if (_projektZeile is null || Uebernehmen is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText));
        Uebernehmen(_projektZeile);
        return KiKern.KiErgebnis.Ok(_projektZeile.Bezeichner, anzahl: 1);
    }

