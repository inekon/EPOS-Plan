    // =====================================================================

    /// <summary>Ä13: OK = speichern und verlassen.</summary>
    private Task BeiOk()
    {
        Speichern?.Invoke();
        return Geschlossen.InvokeAsync(true);
    }

    /// <summary>Ä12/Ä19: Speichern, Dialog bleibt offen; die Statuszeile bestätigt.</summary>
    private void BeiSpeichern()
    {
        if (Speichern is not null && !Speichern())
        {
            // Nicht geschrieben: Das sagt die Leiste dort, wo geklickt wurde.
            StatusSetzen(Resource.ADM_STATUS_FEHLER, fehler: true);
            return;
        }
        KontextLaden(_stand.VarianteId);
        GespeichertMelden();
    }

    /// <summary>Der Vermerk „gespeichert … Uhr" in der Statuszeile der Leiste.</summary>
    private void GespeichertMelden()
    {
        StatusSetzen(string.Format(VorlageGespeichert, DateTime.Now.ToString("HH:mm")));
        _vermerkGespeichert = true;
    }

    /// <summary>Ä12: schließen OHNE Datenübernahme.</summary>
    private Task BeiAbbrechen() => Geschlossen.InvokeAsync(false);

    /// <summary>
    /// DL-2 (Nr. 6): Die <c>SpeichernLeiste</c> meldet OK und Abbrechen über EIN
    /// Ergebnis; die beiden Wege dahinter sind dieselben wie zuvor.
    /// </summary>
    private Task BeiErgebnis(bool ok) => ok ? BeiOk() : BeiAbbrechen();

    /// <summary>
    /// Der Statustext steht seit DL-2 in der Fußleiste. Das Feld bleibt der
    /// Wortlaut (Prüfhilfe <see cref="Status"/>), die Leiste zeigt ihn an.
    /// </summary>
    private void StatusSetzen(string text, bool fehler = false)
    {
        _status = text;
        _vermerkGespeichert = false;
        // Über den Verteiler: Der Assistent speichert von außerhalb des Oberflächenfadens
        // (KiSpeichern); auf dem Verteiler läuft der Schritt sofort.
        SpeichernLeiste? leiste = _leiste;
        if (leiste is not null) _ = InvokeAsync(() => leiste.Zeigen(text, fehler));
    }

    private void Melden(string text, WarnStufe stufe = WarnStufe.Fehler)
    {
        _meldung = text;
        _meldungStufe = stufe;
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Enter ist NICHT belegt (A-7 aus B5b). Esc geht zuerst an eine offene
        // Überlagerung — sie fängt die Taste selbst ab und meldet nicht weiter.
        if (e.Key != "Escape" || UeberlagerungOffen) return Task.CompletedTask;
        return BeiAbbrechen();
    }
}
