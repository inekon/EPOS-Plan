    {
        get
        {
            var liste = new List<(int, string)>(_stand.Bausteine.Count);
            for (int i = 0; i < _stand.Bausteine.Count; i++)
                liste.Add((i, _stand.Bausteine[i].Titel));
            return liste;
        }
    }

    private IReadOnlyList<int> GewaehlteBausteine
    {
        get
        {
            var liste = new List<int>();
            for (int i = 0; i < _stand.Bausteine.Count; i++)
                if (_bausteine.Contains(_stand.Bausteine[i].Schluessel)) liste.Add(i);
            return liste;
        }
    }

    protected override void OnInitialized()
    {
        Auffrischen();

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.BERICHTSEITE,
                                          () => KiSicht(), KiHaken());
    }

    /// <summary>
    /// BV-E1: Die Werte der Gruppe sind der Anfangsstand — ein NEUER Wert der Hülle
    /// ersetzt den Stand, derselbe (ein Zeichenlauf des Rahmens mit demselben Gabensatz)
    /// lässt die Wahl und das Nachgeladene stehen.
    /// </summary>
    protected override void OnParametersSet()
    {
        bool neu = !_gesehen
                   || !ReferenceEquals(Vorlagen, _gesehenVorlagen)
                   || VorlageId != _gesehenVorlageId
                   || !ReferenceEquals(Vorlagenhandlungen, _gesehenHandlungen)
                   || !Equals(Pruefzeile, _gesehenPruefzeile)
                   || !Equals(Startrueckfrage, _gesehenStartrueckfrage)
                   || !Equals(Kapitelstand, _gesehenKapitelstand);
        if (!neu) return;

        _gesehen = true;
        _gesehenVorlagen = Vorlagen;
        _gesehenVorlageId = VorlageId;
        _gesehenHandlungen = Vorlagenhandlungen;
        _gesehenPruefzeile = Pruefzeile;
        _gesehenStartrueckfrage = Startrueckfrage;
        _gesehenKapitelstand = Kapitelstand;

        _vorlagen = Vorlagen ?? Array.Empty<Vorlagenzeile>();
        _vorlageId = VorlageId;
        _handlungen = Vorlagenhandlungen ?? Array.Empty<Handlung>();
        _pruefzeile = Pruefzeile;
        _startrueckfrage = Startrueckfrage;
        _kapitel = Kapitelstand;
    }

    // =====================================================================
    // Der Hilfe-Assistent (Welle KI-F6)
    // =====================================================================

    private KiMaskenanmeldung? _kiMaske;
    private BerichtSeiteKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: Ausgabeformat und Zielordner als Einstellwerte,
    /// die zwei Mengen als Aufstellung — dazu (BV-E1) die Vorlagenwahl als Wahlfeld,
    /// die Prüfzeile als Anzeige und die Suche des Platzhalterkatalogs.
    /// </summary>
    private BerichtSeiteKiSicht KiSicht()
    {
        return _kiSicht ??= new BerichtSeiteKiSicht
        {
            AusgabeLesen = () => _stand.AusgabeId,
            AusgabeSetzen = BeiAusgabe,
            AusgabeEintraege = () => KiMaskenanmeldung.Eintraege(
                Ausgabeformen, z => z.Id, z => z.Text),

            ZielordnerLesen = () => _stand.Zielordner,
            ZielordnerSetzen = BeiZielordner,

            VariantenLesen = KiVariantenzeile,
            BausteineLesen = KiBausteinzeile,
            StatusLesen = () => _status,

            VorlageLesen = () => _vorlageId,
            VorlageSetzen = KiVorlageSetzen,
            VorlageEintraege = () => KiMaskenanmeldung.Eintraege(_vorlagen, z => z.Id, z => z.Text),
            PruefzeileLesen = () => _pruefzeile?.Text ?? "",
            KatalogsucheLesen = () => _katalogsuche,
            KatalogsucheSetzen = text =>
            {
                _katalogsuche = text ?? "";
                _ = InvokeAsync(StateHasChanged);
            }
        };
    }

    /// <summary>
    /// Die Vorlagenwahl des Assistenten — derselbe Weg wie das Auswahlfeld. Wo der
    /// Anwender nicht wählen könnte, lehnt sie BENANNT ab: während eines Laufs, bei
    /// einem gesperrten Eintrag und bei einer Id, die die Liste nicht kennt.
    /// </summary>
    private void KiVorlageSetzen(int? id)
    {
        if (GruppeGesperrt) throw new InvalidOperationException(Sperrgrund);

        Vorlagenzeile? zeile = id.HasValue ? _vorlagen.FirstOrDefault(v => v.Id == id.Value) : null;
        if (zeile is null) throw new InvalidOperationException(Vt.NichtWaehlbar);
        if (zeile.Gesperrt) throw new InvalidOperationException(Sperrhinweis(zeile));

        _ = InvokeAsync(() => BeiVorlage(id));
    }

    /// <summary>Die angehakten Versionen als Aufstellung — je Zeile ihr Klartext.</summary>
    private string KiVariantenzeile()
    {
        var namen = new List<string>();
        foreach (VarianteZeile z in _stand.Varianten)
            if (_gewaehlt.Contains(z.IdProjekt))
                namen.Add(string.IsNullOrEmpty(z.Projektname) ? z.Bezeichner : z.Projektname);
        return string.Join("; ", namen);
    }

    /// <summary>
    /// Die gewählten Bausteine als Aufstellung — je Baustein sein Titel; BV-E2: ein ausgegrauter mit
    /// dem Grund in Klammern — so, wie die Seite ihn zeigt. Steht statt der Liste die leise Zeile, ist
    /// sie die Aufstellung.
    /// </summary>
    private string KiBausteinzeile()
    {
        if (InhaltAusVorlage) return Vt.InhaltAusVorlage;

        var titel = new List<string>();
        foreach (var b in _stand.Bausteine)
            if (_bausteine.Contains(b.Schluessel))
                titel.Add(Ausgegraut(b) ? b.Titel + " (" + Grund(b) + ")" : b.Titel);
        return string.Join("; ", titel);
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> „Erstellen" rechnet den Bericht und schreibt eine
    /// Datei — eine Aktion der Stufen 2 und 3 mit eigener Rückfrage.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <summary>
    /// Liest Konfiguration, Variantenliste und Bausteine neu ein (Vorbild
    /// <c>UcBericht.LadeDaten</c>; nach jedem Lauf erneut gerufen).
    /// </summary>
    public void Auffrischen()
    {
        _stand = Laden?.Invoke() ?? new BerichtStand();

        _gewaehlt.Clear();
        foreach (int id in _stand.GewaehlteVarianten) _gewaehlt.Add(id);
        foreach (VarianteZeile z in _stand.Varianten)
            if (z.IstStamm && !_gewaehlt.Contains(z.IdProjekt)) _gewaehlt.Add(z.IdProjekt);

        _bausteine.Clear();
        foreach (string s in _stand.AktiveBausteine) _bausteine.Add(s);

        _status = "";
        StateHasChanged();
    }

    // =====================================================================
    // Auswahl
    // =====================================================================

    private bool Gewaehlt(int id) => _gewaehlt.Contains(id);

    private void VarianteUmschalten(VarianteZeile z, bool an)
    {
        if (z.IstStamm)
        {
            // Der Haken ist gesperrt; kommt es doch hierher, gilt derselbe Satz
            // wie im ItemCheck des Vorlaeufers.
            _status = MeldungStammReferenz;
            return;
        }

        if (an) { if (!_gewaehlt.Contains(z.IdProjekt)) _gewaehlt.Add(z.IdProjekt); }
        else _gewaehlt.Remove(z.IdProjekt);
    }

    private void AlleWaehlen()
    {
        _gewaehlt.Clear();
        foreach (VarianteZeile z in _stand.Varianten) _gewaehlt.Add(z.IdProjekt);
    }

    private void KeineWaehlen()
    {
        _gewaehlt.Clear();
        foreach (VarianteZeile z in _stand.Varianten)
            if (z.IstStamm) _gewaehlt.Add(z.IdProjekt);
    }

    private void BausteineGesetzt(IReadOnlyList<int> nummern)
    {
        bool wirtschaftNeu = false;
        var neu = new List<string>();
        foreach (int n in nummern)
        {
            if (n < 0 || n >= _stand.Bausteine.Count) continue;
            string schluessel = _stand.Bausteine[n].Schluessel;
            neu.Add(schluessel);
            if (!string.IsNullOrEmpty(BausteinWirtschaft)
                && string.Equals(schluessel, BausteinWirtschaft, StringComparison.Ordinal)
                && !_bausteine.Contains(schluessel))
                wirtschaftNeu = true;
        }

        _bausteine.Clear();
        _bausteine.AddRange(neu);

        // Hinweis beim Aktivieren der Wirtschaftlichkeit: der Berichtslauf
        // rechnet sie selbst mit (Vorbild clbBausteine_ItemCheck).
        if (wirtschaftNeu && !string.IsNullOrEmpty(MeldungWirtschaftHinweis))
            _status = MeldungWirtschaftHinweis;
    }

    private void BeiAusgabe(int? id) => _stand.AusgabeId = id ?? 0;

    private void BeiZielordner(string pfad) => _stand.Zielordner = pfad ?? "";

    // =====================================================================
    // Läufe
    // =====================================================================

    private BerichtAuftrag Auftrag(string vorlagenweg = "")
    {
        var varianten = new List<int>();
        int mitStamm = 0;
        foreach (VarianteZeile z in _stand.Varianten)
        {
            if (!_gewaehlt.Contains(z.IdProjekt)) continue;
            mitStamm++;
            if (!z.IstStamm) varianten.Add(z.IdProjekt);
        }

        return new BerichtAuftrag
        {
            VariantenIds = varianten,
            Bausteine = new List<string>(_bausteine),
            AusgabeId = _stand.AusgabeId,
            Zielordner = _stand.Zielordner,
            AnzahlMitStamm = mitStamm,
            VorlageId = _vorlageId,
            Vorlagenweg = vorlagenweg ?? ""
        };
    }

    private void ErstellenFragen()
    {
        if (_laeuft || Erstellen is null) return;
        _menueOffen = false;

        // BV-E1 (Konzept 6.8): Die Schnellprüfung läuft vor JEDEM Start — der frische
        // Stand entscheidet, welche Rückfrage steht.
        VorlagenNachziehen(mitMeldung: false);

        int anzahl = Auftrag().AnzahlMitStamm;
        if (_startrueckfrage is not null)
        {
            _frage = Frageart.Vorlage;
            _fragetitel = string.IsNullOrWhiteSpace(_startrueckfrage.Titel) ? TitelErstellen : _startrueckfrage.Titel;
            _fragetext = Startfragetext(_startrueckfrage, anzahl);
            return;
        }

        _frage = Frageart.Erstellen;
        _fragetitel = TitelErstellen;
        _fragetext = string.Format(FrageStart, anzahl);
    }

    private async Task Beantwortet(bool? antwort)
    {
        Frageart war = _frage;
        Startrueckfrage? erweitert = _startrueckfrage;
        _frage = Frageart.Keine;

        // BV-E1: Die erweiterte Frage kennt drei Antworten — auch „Abbrechen" wird gemeldet.
        if (war == Frageart.Vorlage)
        {
            string weg = Startantwort(antwort, erweitert?.EigeneMoeglich ?? true);
            await StartGewaehlt.InvokeAsync(weg);
            if (weg != Startweg.Abbruch) await ErstellenLaufen(weg);
            return;
        }

        // BV-E1: Die Handlung des Menüs „…" geht erst auf „Ja" hinaus.
        if (war == Frageart.Handlung)
        {
            Handlung? handlung = _frageHandlung;
            _frageHandlung = null;
            if (antwort == true && handlung is not null)
                await Gruppenhandlung(() => HandlungGewaehlt.InvokeAsync(handlung.Id));
            return;
        }

        if (antwort != true) return;

        switch (war)
        {
            case Frageart.Erstellen:
                await ErstellenLaufen("");
                break;
            case Frageart.Oeffnen:
                if (DateiOeffnen is not null && !string.IsNullOrEmpty(_oeffnen))
                    await DateiOeffnen(_oeffnen);
                break;
        }
    }

    private async Task ErstellenLaufen(string vorlagenweg)
    {
        if (Erstellen is null) return;

        LaufBeginnen();
        try
        {
            LaufErgebnis erg = await Erstellen(Auftrag(vorlagenweg), Melden);
            Auffrischen();          // Zeitstempel in der Liste auffrischen
            VorlagenNachziehen(mitMeldung: false);
            ErgebnisZeigen(erg);    // NACH dem Auffrischen, das die Statuszeile leert
        }
        finally { LaufBeenden(); }
    }

    /// <summary>
    /// Die Antwort der erweiterten Startrückfrage als Weg: Mit eigenem Weg ist Ja = eigene,
    /// Nein = Standard, Abbrechen/Esc = Abbruch; ohne ihn ist Ja = Standard, sonst Abbruch.
    /// </summary>
    private static string Startantwort(bool? antwort, bool eigeneMoeglich) => eigeneMoeglich
        ? antwort switch { true => Startweg.Eigene, false => Startweg.Standard, _ => Startweg.Abbruch }
        : antwort == true ? Startweg.Standard : Startweg.Abbruch;

    /// <summary>
    /// Der Text der erweiterten Rückfrage: der Satz der Hülle (ein <c>{0}</c> wird die
    /// Versionszahl — ersetzt, nicht formatiert, damit ein <c>{{…}}</c> darin stehen bleibt),
    /// darunter je Befund eine Zeile.
    /// </summary>
    private static string Startfragetext(Startrueckfrage frage, int anzahl)
    {
        var text = new StringBuilder((frage.Text ?? "").Replace("{0}",
            anzahl.ToString(CultureInfo.CurrentCulture), StringComparison.Ordinal));

        bool erster = true;
        foreach (string befund in frage.Befunde ?? Array.Empty<string>())
        {
            if (string.IsNullOrWhiteSpace(befund)) continue;
            if (erster) { text.Append('\n'); erster = false; }
            text.Append("\n• ").Append(befund.Trim());
        }

        return text.ToString();
    }

    private bool ErweiterteFrage => _frage == Frageart.Vorlage && _startrueckfrage is not null;

    private bool EigeneMoeglich => _startrueckfrage?.EigeneMoeglich ?? true;

    private string FrageJaText => !ErweiterteFrage ? JaText
        : EigeneMoeglich ? Beschriftung(_startrueckfrage!.WegEigene, Vt.WegEigene)
                         : Beschriftung(_startrueckfrage!.WegStandard, Vt.WegStandard);

    private string FrageNeinText => !ErweiterteFrage ? NeinText
        : EigeneMoeglich ? Beschriftung(_startrueckfrage!.WegStandard, Vt.WegStandard)
                         : Beschriftung(_startrueckfrage!.WegAbbrechen, Vt.WegAbbrechen);

    private bool FrageMitAbbrechen => ErweiterteFrage && EigeneMoeglich;

    private string FrageAbbrechenText => ErweiterteFrage
        ? Beschriftung(_startrueckfrage!.WegAbbrechen, Vt.WegAbbrechen)
        : AbbrechenText;

    private static string Beschriftung(string? text, string rueckfall)
        => string.IsNullOrWhiteSpace(text) ? rueckfall : text;

    private void LaufBeginnen()
    {
        _laeuft = true;
        _aktuell = 0;
        _gesamt = 1;
        _meldung = "";
        _fehler = "";
        StateHasChanged();
    }

    private void LaufBeenden()
    {
        _laeuft = false;
        StateHasChanged();
    }

    private void ErgebnisZeigen(LaufErgebnis erg)
    {
        if (erg.Abgebrochen) { _status = StatusAbgebrochen; return; }

        _status = erg.Statuszeile ?? "";
        _fehler = erg.Fehler ?? "";
        _meldung = erg.Meldung ?? "";

        if (erg.Erfolg && !string.IsNullOrEmpty(erg.Frage) && DateiOeffnen is not null)
        {
            _oeffnen = erg.Datei ?? "";
            _frage = Frageart.Oeffnen;
            _fragetitel = TitelErstellen;
            _fragetext = erg.Frage;
        }
    }

    private void Melden(Laufschritt s)
    {
        _ = InvokeAsync(() =>
        {
            if (s.Gesamt > 0) { _gesamt = s.Gesamt; _aktuell = Math.Min(s.Aktuell, s.Gesamt); }
            _status = s.Gesamt > 0 ? $"({s.Aktuell}/{s.Gesamt}) {s.Text}" : s.Text;
            StateHasChanged();
        });
    }

    private void LaufAbbrechen() => Abbrechen?.Invoke();

    // =====================================================================
    // BV-E1 — die Gruppe „Vorlage"
    // =====================================================================

    /// <summary>Die Beschriftungen der Gruppe — nie <c>null</c>, auch wenn die Hülle es reicht.</summary>
    private BerichtSeiteVorlagentexte Vt => Vorlagentexte ?? _vorlagentexteVorgabe;

    /// <summary>Kein Delegat, kein Knopf: Ohne Vorlagen und ohne Rückrufe steht die Gruppe nicht da.</summary>
    private bool VorlagengruppeSichtbar
        => _vorlagen.Count > 0 || _pruefzeile is not null
           || NeueVorlage.HasDelegate || Hinzufuegen.HasDelegate || Pruefen.HasDelegate
           || PlatzhalterkatalogGaben is not null;

    /// <summary>Das Menü „…" steht nur mit Einträgen UND Rückruf.</summary>
    private bool MenueMoeglich => _handlungen.Count > 0 && HandlungGewaehlt.HasDelegate;

    /// <summary>Die Knopfleiste der Gruppe steht nur, wenn sie wenigstens einen Knopf trägt.</summary>
    private bool KnoepfeSichtbar
        => NeueVorlage.HasDelegate || Hinzufuegen.HasDelegate || Pruefen.HasDelegate
           || PlatzhalterkatalogGaben is not null || MenueMoeglich;

    private string MenueId => _menueId;

    /// <summary>Weich gesperrt: während eines Laufs und solange eine Handlung der Gruppe läuft.</summary>
    private bool GruppeGesperrt => _laeuft || _vorlageBeschaeftigt;

    private string Sperrgrund => _laeuft ? Vt.GesperrtLauf : Vt.GesperrtBeschaeftigt;

    /// <summary><c>aria-disabled</c> der Knöpfe der Gruppe — gesetzt nur, solange sie gesperrt sind.</summary>
    private string? Sperrattribut => GruppeGesperrt ? "true" : null;

    /// <summary>Der Kurztext am Knopf: frei die Erklärung, gesperrt der Grund.</summary>
    private string? Knopftitel(string kurztext)
        => GruppeGesperrt ? Sperrgrund : (string.IsNullOrWhiteSpace(kurztext) ? null : kurztext);

    /// <summary>
    /// Die weiche Sperre MELDET den Versuch (Hausregel „Bedienung"): Das Banner in der Gruppe
    /// nennt den Grund und verfällt. <c>true</c> = gesperrt, der Klick endet hier.
    /// </summary>
    private bool GesperrtMelden()
    {
        if (!GruppeGesperrt) return false;
        _sperrmeldung = Sperrgrund;
        return true;
    }

    private void SperrmeldungVerfallen() => _sperrmeldung = "";

    private IReadOnlyList<(int Id, string Text)> Vorlageneintraege
        => _vorlagen.Where(v => v is not null).Select(v => (v.Id, v.Text)).ToList();

    private IReadOnlyCollection<int> GesperrteVorlagen
        => _vorlagen.Where(v => v is not null && v.Gesperrt).Select(v => v.Id).ToList();

    private IReadOnlyDictionary<int, string> Vorlagensperrgruende
    {
        get
        {
            var gruende = new Dictionary<int, string>();
            foreach (Vorlagenzeile v in _vorlagen)
                if (v is not null && v.Gesperrt && !gruende.ContainsKey(v.Id)) gruende[v.Id] = Sperrhinweis(v);
            return gruende;
        }
    }

    private Vorlagenzeile? GewaehlteVorlage
        => _vorlageId.HasValue ? _vorlagen.FirstOrDefault(v => v is not null && v.Id == _vorlageId.Value) : null;

    private string Sperrhinweis(Vorlagenzeile zeile)
        => string.IsNullOrWhiteSpace(zeile.GesperrtHinweis) ? Vt.NichtWaehlbar : zeile.GesperrtHinweis;

    private string Anzeigentext
        => string.IsNullOrWhiteSpace(_pruefzeile?.Knopftext) ? Vt.Anzeigen : _pruefzeile!.Knopftext;

    /// <summary>
    /// Übernimmt den frischen Stand der Hülle (<c>VorlagenNeuLaden</c>); ohne Delegat oder
    /// ohne Antwort bleibt der Stand, wie er ist.
    /// </summary>
    private void VorlagenNachziehen(bool mitMeldung)
    {
        Vorlagenstand? neu = VorlagenNeuLaden?.Invoke();
        if (neu is null) return;

        _vorlagen = neu.Vorlagen ?? Array.Empty<Vorlagenzeile>();
        _vorlageId = neu.VorlageId;
        _handlungen = neu.Handlungen ?? Array.Empty<Handlung>();
        _pruefzeile = neu.Pruefzeile;
        _startrueckfrage = neu.Startrueckfrage;
        _kapitel = neu.Kapitelstand;
        _bausteinmeldung = "";
        _gruppenfehler = neu.Fehler ?? "";
        if (mitMeldung && !string.IsNullOrWhiteSpace(neu.Meldung)) _status = neu.Meldung;
    }

    /// <summary>
    /// Eine Handlung der Gruppe: Die Knöpfe sind währenddessen weich gesperrt, danach holt
    /// die Seite den frischen Stand — auch wenn die Handlung scheitert.
    /// </summary>
    private async Task Gruppenhandlung(Func<Task> handlung)
    {
        _vorlageBeschaeftigt = true;
        _menueOffen = false;
        _sperrmeldung = "";
        _gruppenfehler = "";
        try { await handlung(); }
        finally
        {
            _vorlageBeschaeftigt = false;
            VorlagenNachziehen(mitMeldung: true);
        }
    }

    private async Task BeiVorlage(int? id)
    {
        if (id == _vorlageId) return;
        _vorlageId = id;
        await Gruppenhandlung(() => VorlageIdChanged.InvokeAsync(id));
    }

    // ---- „Neue Vorlage…" --------------------------------------------------

    private void NeuFragen()
    {
        if (GesperrtMelden()) return;
        _menueOffen = false;
        _neuMuster = Vorlagenmuster is { Count: > 0 } ? Vorlagenmuster[0].Id : null;
        _namensdialogOffen = true;
    }

    private void NamensdialogAbbrechen() => _namensdialogOffen = false;

    private async Task NamensdialogGeschlossen(string? name)
    {
        _namensdialogOffen = false;
        if (string.IsNullOrWhiteSpace(name)) return;
        string neu = name.Trim();
        if (NeueVorlageAus.HasDelegate && _neuMuster.HasValue)
        {
            var wahl = new Neuvorlage(neu, _neuMuster.Value);
            await Gruppenhandlung(() => NeueVorlageAus.InvokeAsync(wahl));
            return;
        }
        await Gruppenhandlung(() => NeueVorlage.InvokeAsync(neu));
    }

    // ---- „Hinzufügen…" und „Prüfen" -----------------------------------------

    private async Task HinzufuegenKlick()
    {
        if (GesperrtMelden()) return;
        await Gruppenhandlung(() => Hinzufuegen.InvokeAsync());
    }

    private async Task PruefenKlick()
    {
        if (GesperrtMelden()) return;
        await Gruppenhandlung(() => Pruefen.InvokeAsync());
    }

    // ---- Das Menü „…" ---------------------------------------------------------

    private void MenueUmschalten()
    {
        if (GesperrtMelden()) { _menueOffen = false; return; }
        _menueOffen = !_menueOffen;
    }

    private void MenueSchliessen() => _menueOffen = false;

    private void BeiMenuetaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") _menueOffen = false;
    }

    private async Task HandlungKlick(Handlung h)
    {
        _menueOffen = false;
        if (GesperrtMelden()) return;
        if (!h.Aktiv)
        {
            // Der inaktive Eintrag MELDET seinen Grund, statt zu handeln.
            _sperrmeldung = string.IsNullOrWhiteSpace(h.Grund) ? Vt.NichtWaehlbar : h.Grund;
            return;
        }
        if (!string.IsNullOrWhiteSpace(h.Rueckfrage))
        {
            // Erst fragen (Vorgabe „Nein"), dann handeln - im selben Fenster.
            _frageHandlung = h;
            _frage = Frageart.Handlung;
            _fragetitel = h.Text;
            _fragetext = h.Rueckfrage;
            return;
        }
        await Gruppenhandlung(() => HandlungGewaehlt.InvokeAsync(h.Id));
    }

    /// <summary>Der Kurztext eines Menüeintrags: frei die Erklärung, gesperrt der Grund.</summary>
    private static string? Eintragstitel(Handlung h)
    {
        string text = h.Aktiv ? h.Kurztext : h.Grund;
        return string.IsNullOrWhiteSpace(text) ? null : text;
    }

    // ---- Prüfliste und Platzhalterkatalog (Überlagerungen) -----------------------

    private void PrueflisteOeffnen()
    {
        if (GesperrtMelden() || PrueflisteGaben is null) return;
        _menueOffen = false;
        IReadOnlyDictionary<string, object>? gaben = PrueflisteGaben();
        if (gaben is null) return;
        _prueflisteGaben = gaben;
    }

    private void PrueflisteSchliessen() => _prueflisteGaben = null;

    private void KatalogOeffnen()
    {
        if (GesperrtMelden() || PlatzhalterkatalogGaben is null) return;
        _menueOffen = false;
        IReadOnlyDictionary<string, object>? gaben = PlatzhalterkatalogGaben();
        if (gaben is null) return;
        _katalogGaben = gaben;
    }

    private void KatalogSchliessen() => _katalogGaben = null;

    private void BeiKatalogsuche(string text) => _katalogsuche = text ?? "";

    // =====================================================================
    // BV-E2 — die Häkchen folgen der Vorlage (Konzept 10.2, „Häkchen (BV-Q1 c)")
    // =====================================================================

    /// <summary>Die Ausgabeformate (<see cref="BerichtStand.AusgabeId"/>): 0 = Word, 1 = Excel, 2 = beide.</summary>
    private const int AUSGABE_WORD = 0, AUSGABE_EXCEL = 1, AUSGABE_BEIDE = 2;

    /// <summary>
    /// Steht statt der Liste die leise Zeile? Nur wenn die Vorlage kein Kapitel führt (nur
    /// Einzelplatzhalter) UND allein Word entsteht — mit Excel bleibt die Liste, denn die Mappe folgt
    /// den Häkchen wie heute (BV-Q2).
    /// </summary>
    private bool InhaltAusVorlage => _kapitel is { InhaltAusVorlage: true } && _stand.AusgabeId == AUSGABE_WORD;

    /// <summary>
    /// Trägt die Vorlage diesen Baustein selbst — das Deckblatt aus Platzhaltern
    /// (<see cref="Kapitelstand.DeckblattAusVorlage"/>)?
    /// </summary>
    private bool AusVorlage(BausteinZeile? b)
        => b is not null && _kapitel?.DeckblattAusVorlage is { } deckblatt
           && string.Equals(b.Schluessel, deckblatt, StringComparison.Ordinal);

    /// <summary>
    /// Steht der Eintrag ausgegraut da? Nur mit einem Kapitelstand der Hülle, nur wenn Word entsteht
    /// und die Vorlage das Kapitel nicht führt oder den Baustein selbst trägt — und wird Excel mit
    /// ausgegeben, nur wenn auch die Mappe ihn nicht führt (Konzept 10.2: weder Word- noch Excel-Vorlage).
    /// </summary>
    private bool Ausgegraut(BausteinZeile? b)
    {
        if (_kapitel is null || b is null || _stand.AusgabeId == AUSGABE_EXCEL) return false;
        IReadOnlyList<string> fehlen = _kapitel.NichtEnthalten ?? Array.Empty<string>();
        if (!fehlen.Contains(b.Schluessel, StringComparer.Ordinal) && !AusVorlage(b)) return false;
        return !(_stand.AusgabeId == AUSGABE_BEIDE && b.InExcel);
    }

    /// <summary>Der Grund eines ausgegrauten Eintrags: „Deckblatt kommt aus der Vorlage" oder „in dieser Vorlage nicht enthalten".</summary>
    private string Grund(BausteinZeile b) => AusVorlage(b) ? Vt.DeckblattAusVorlage : Vt.NichtEnthalten;

    /// <summary>
    /// Der Sperrgrund eines Eintrags der Liste (Nummer = Stelle in <see cref="BerichtStand.Bausteine"/>);
    /// leer = frei. Der Eintrag bleibt sichtbar, sein Häkchen gespeichert.
    /// </summary>
    private string BausteinSperrgrund(int nummer)
        => nummer >= 0 && nummer < _stand.Bausteine.Count && Ausgegraut(_stand.Bausteine[nummer])
           ? Grund(_stand.Bausteine[nummer]) : "";

    /// <summary>
    /// Die weiche Sperre MELDET den Versuch (Hausregel „Bedienung"): ein Banner mit Verfall unter
    /// der Liste nennt den Grund und dass das Häkchen gespeichert bleibt.
    /// </summary>
    private void BausteinGesperrtVersucht(int nummer)
    {
        if (nummer < 0 || nummer >= _stand.Bausteine.Count) return;
        string muster = (AusVorlage(_stand.Bausteine[nummer]) ? Vt.MeldungDeckblattAusVorlage : Vt.MeldungNichtEnthalten) ?? "";
        string titel = _stand.Bausteine[nummer].Titel ?? "";
        try { _bausteinmeldung = string.Format(CultureInfo.CurrentCulture, muster, titel); }
        catch (FormatException) { _bausteinmeldung = muster; }
    }

    private void BausteinmeldungVerfallen() => _bausteinmeldung = "";

    /// <summary>
    /// BV-E2: Ist der Baustein in der jetzigen Wahl von Vorlage und Ausgabe weich gesperrt?
    /// (Prüfhilfe — dieselbe Regel wie die Liste.)
    /// </summary>
    public bool BausteinGesperrt(string schluessel)
        => Ausgegraut(_stand.Bausteine.FirstOrDefault(b => b is not null
               && string.Equals(b.Schluessel, schluessel, StringComparison.Ordinal)));

    /// <summary>BV-E2: Steht statt der Liste die leise Zeile „Den Inhalt bestimmt die Vorlage"? (Prüfhilfe.)</summary>
    public bool InhaltBestimmtDieVorlage => InhaltAusVorlage;
}
