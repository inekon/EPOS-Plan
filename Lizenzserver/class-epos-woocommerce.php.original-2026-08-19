	/* ------------------------------------------------- Dokumente */

	/**
	 * Vertragsdokument eines Tarifs (bzw. 'support') aus der Mediathek.
	 *
	 * @return array|null
	 */
	public static function dokument( $schluessel ) {
		$opt = self::optionen();
		$id  = isset( $opt[ 'dok_' . $schluessel ] ) ? (int) $opt[ 'dok_' . $schluessel ] : 0;
		if ( ! $id ) {
			return null;
		}
		$pfad = get_attached_file( $id );
		if ( ! $pfad || ! file_exists( $pfad ) ) {
			return null;
		}
		// SHA-256 der Fassung (Spezifikation Abschnitt 5/6), je Datei-Stand zwischengespeichert
		$cache = '_epos_sha256_' . md5( $pfad . '|' . filemtime( $pfad ) );
		$hash  = get_post_meta( $id, $cache, true );
		if ( ! $hash ) {
			$hash = hash_file( 'sha256', $pfad );
			update_post_meta( $id, $cache, $hash );
		}
		return array(
			'id'    => $id,
			'url'   => wp_get_attachment_url( $id ),
			'pfad'  => $pfad,
			'stand' => isset( $opt[ 'stand_' . $schluessel ] ) ? $opt[ 'stand_' . $schluessel ] : '',
			'hash'  => $hash,
		);
	}

	/* ------------------------------------------------- Produkte */

	/** Tarif-Produkte einmalig anlegen; Altprodukt „EPOS-Plan Basic" auf Entwurf. */
	public static function produkte_sicherstellen() {
		if ( ! current_user_can( 'manage_options' ) || ! function_exists( 'wc_get_product' ) ) {
			return;
		}
		$opt = self::optionen();

		// Einmalige Zuordnung der neuen Tarife (Campus/Student, Einzel 3 Monate) inkl. Lizenzvereinbarungen.
		if ( empty( $opt['neue_tarife_2026'] ) ) {
			if ( empty( $opt['produkt_campus'] ) && get_post( 5018 ) ) {
				$opt['produkt_campus'] = 5018;
			}
			if ( empty( $opt['produkt_einzel3m'] ) && get_post( 5019 ) ) {
				$opt['produkt_einzel3m'] = 5019;
			}
			if ( empty( $opt['dok_campus'] ) && get_post( 5020 ) ) {
				$opt['dok_campus']   = 5020;
				$opt['stand_campus'] = '11.08.2026';
			}
			if ( empty( $opt['dok_einzel3m'] ) && get_post( 5021 ) ) {
				$opt['dok_einzel3m']   = 5021;
				$opt['stand_einzel3m'] = '11.08.2026';
			}
			$opt['neue_tarife_2026'] = time();
			update_option( self::OPTION, $opt );
		}

		if ( $opt['produkte_angelegt'] ) {
			// Einmalige Korrektur: Mengenkauf erlauben (mehrere Lizenzen je Bestellung)
			if ( empty( $opt['mengen_erlaubt'] ) ) {
				foreach ( array( 'einzel', 'team', 'teamplus' ) as $mk ) {
					if ( ! empty( $opt[ 'produkt_' . $mk ] ) ) {
						update_post_meta( (int) $opt[ 'produkt_' . $mk ], '_sold_individually', 'no' );
					}
				}
				$opt['mengen_erlaubt'] = time();
				update_option( self::OPTION, $opt );
			}
			// Einmalige Korrektur: Produktbilder der Tarife setzen (Mediathek-IDs)
			if ( empty( $opt['bilder_gesetzt'] ) ) {
				$bilder = array( 'einzel' => 4819, 'team' => 4820, 'teamplus' => 4821 );
				foreach ( $bilder as $bk => $bild_id ) {
					if ( ! empty( $opt[ 'produkt_' . $bk ] ) && get_post( $bild_id ) ) {
						update_post_meta( (int) $opt[ 'produkt_' . $bk ], '_thumbnail_id', (int) $bild_id );
					}
				}
				$opt['bilder_gesetzt'] = time();
				update_option( self::OPTION, $opt );
			}
			// Einmalig: Supportvertrag als eigenes (im Katalog verstecktes) Produkt anlegen
			if ( empty( $opt['support_produkt_angelegt'] ) ) {
				$sid       = 0;
				$vorhanden = get_posts( array( 'post_type' => 'product', 'title' => 'Supportvertrag EPOS-Plan', 'post_status' => 'any', 'numberposts' => 1, 'fields' => 'ids' ) );
				if ( $vorhanden ) {
					$sid = (int) $vorhanden[0];
				} else {
					$sid = wp_insert_post( array(
						'post_type'    => 'product',
						'post_status'  => 'publish',
						'post_title'   => 'Supportvertrag EPOS-Plan',
						'post_excerpt' => 'Mindestabnahme eine Stunde pro Vertragsjahr (hier berechnet); 200,00 € netto je Stunde zzgl. gesetzl. USt., darüber hinausgehende Aufwände in 15-Minuten-Schritten. Erstlaufzeit bis zum Ende des laufenden Kalenderjahres, danach Verlängerung auf unbestimmte Zeit mit einer Kündigungsfrist von einem Monat (Kündigung in Textform oder über die Kündigungsschaltfläche „Verträge hier kündigen“).',
					) );
					if ( is_wp_error( $sid ) ) {
						$sid = 0;
					}
					if ( $sid ) {
						update_post_meta( $sid, '_regular_price', 200 );
						update_post_meta( $sid, '_price', 200 );
						update_post_meta( $sid, '_virtual', 'yes' );
						update_post_meta( $sid, '_sold_individually', 'yes' );
						update_post_meta( $sid, '_manage_stock', 'no' );
						update_post_meta( $sid, '_tax_status', 'taxable' );
						wp_set_object_terms( $sid, 'simple', 'product_type' );
						wp_set_object_terms( $sid, array( 'exclude-from-catalog', 'exclude-from-search' ), 'product_visibility' );
					}
				}
				if ( $sid ) {
					$opt['produkt_support'] = (int) $sid;
				}
				$opt['support_produkt_angelegt'] = time();
				update_option( self::OPTION, $opt );
			}
			return;
		}
		foreach ( self::tarife() as $key => $t ) {
			$id = (int) $opt[ 'produkt_' . $key ];
			if ( $id && get_post( $id ) ) {
				continue;
			}
			$vorhanden = get_posts( array( 'post_type' => 'product', 'title' => $t['produkt'], 'post_status' => 'any', 'numberposts' => 1, 'fields' => 'ids' ) );
			if ( $vorhanden ) {
				$id = (int) $vorhanden[0];
			} else {
				$kurz = sprintf(
					'Jahreslizenz EPOS-Plan, Tarif „%1$s" (%2$s). %3$d,00 € netto pro Jahr zzgl. gesetzl. USt. — Jahresvertrag, Abrechnung jährlich im Voraus.',
					$t['name'], $t['nutzer_text'], $t['preis']
				);
				$lang = $kurz . ' Erstlaufzeit 12 Monate, danach Verlängerung auf unbestimmte Zeit mit einer Kündigungsfrist von einem Monat; Kündigung in Textform oder über die Kündigungsschaltfläche. Bestellbar für Unternehmen, Freiberufler, Behörden, Bildungseinrichtungen, Vereine und Privatpersonen (auch Studierende, Schülerinnen und Schüler sowie Auszubildende).';
				$id   = wp_insert_post( array(
					'post_type'    => 'product',
					'post_status'  => 'publish',
					'post_title'   => $t['produkt'],
					'post_excerpt' => $kurz,
					'post_content' => $lang,
				) );
				if ( is_wp_error( $id ) || ! $id ) {
					continue;
				}
				update_post_meta( $id, '_regular_price', $t['preis'] );
				update_post_meta( $id, '_price', $t['preis'] );
				update_post_meta( $id, '_virtual', 'yes' );
				update_post_meta( $id, '_sold_individually', 'no' );
				update_post_meta( $id, '_manage_stock', 'no' );
				update_post_meta( $id, '_tax_status', 'taxable' );
				wp_set_object_terms( $id, 'simple', 'product_type' );
			}
			$opt[ 'produkt_' . $key ] = (int) $id;
		}
		$basic = get_posts( array( 'post_type' => 'product', 'title' => 'EPOS-Plan Basic', 'post_status' => 'publish', 'numberposts' => 1, 'fields' => 'ids' ) );
		if ( $basic ) {
			wp_update_post( array( 'ID' => (int) $basic[0], 'post_status' => 'draft' ) );
		}
		$opt['produkte_angelegt'] = time();
		update_option( self::OPTION, $opt );
	}

	/** Tarif-Schlüssel zum Produkt im Warenkorb (oder '' wenn keiner). */
	private static function tarif_im_warenkorb() {
		if ( ! function_exists( 'WC' ) || ! WC()->cart ) {
			return '';
		}
		$opt = self::optionen();
		foreach ( WC()->cart->get_cart() as $item ) {
			$pid = (int) $item['product_id'];
			foreach ( self::tarife() as $key => $t ) {
				if ( $pid && $pid === (int) $opt[ 'produkt_' . $key ] ) {
					return $key;
				}
			}
		}
		return '';
	}

	/** Tarif-Schlüssel einer Bestellung. */
	public static function tarif_der_bestellung( $order ) {
		$tarif = (string) $order->get_meta( '_epos_tarif' );
		if ( $tarif ) {
			return $tarif;
		}
		$opt = self::optionen();
		foreach ( $order->get_items() as $item ) {
			$pid = (int) $item->get_product_id();
			foreach ( self::tarife() as $key => $t ) {
				if ( $pid && $pid === (int) $opt[ 'produkt_' . $key ] ) {
					return $key;
				}
			}
		}
		return '';
	}

	/* ------------------------------------------------- Checkout */

	/** Schritt 2: Pflichtfelder (Firma) und optionale USt-IdNr. */
	public static function pflichtfelder( $fields ) {
		if ( ! self::tarif_im_warenkorb() ) {
			return $fields;
		}
		$firma_vorhanden = isset( $fields['billing']['billing_company'] ) ? $fields['billing']['billing_company'] : array();
		$fields['billing']['billing_company'] = wp_parse_args( array(
			'label'    => 'Firma',
			'required' => false,
			'class'    => array( 'form-row-wide' ),
			'priority' => 30,
			'type'     => 'text',
		), $firma_vorhanden );
		$fields['billing']['billing_vat_id'] = array(
			'label'    => 'USt-IdNr.',
			'required' => false,
			'class'    => array( 'form-row-wide' ),
			'priority' => 35,
			'type'     => 'text',
		);
		return $fields;
	}

	/** Schritte 3–6: Checkboxen, Bestellübersicht, Button-Logik. */
	public static function checkout_checkboxen() {
		$tarif = self::tarif_im_warenkorb();
		if ( ! $tarif ) {
			return;
		}
		$alle = self::tarife();
		$t    = $alle[ $tarif ];
		$dok  = self::dokument( $tarif );
		$sup  = self::dokument( 'support' );

		echo '<div class="epos-vertrag" style="margin:1.2em 0;padding:14px 16px;border:1px solid #ddd;border-radius:4px">';
		echo '<h3 style="margin-top:0;font-size:1.05em">Vertragsschluss</h3>';

		$netto_t  = (float) $t['preis'];
		$brutto_t = $netto_t * 1.19;
		$monate_t = isset( $t['monate'] ) ? (int) $t['monate'] : 12;
		$zeit_t   = ( 12 === $monate_t ) ? 'pro Jahr' : 'für ' . $monate_t . ' Monate';
		$lauf_t = ( ! empty( $t['auto_ende'] ) )
	? 'Feste Laufzeit von ' . $monate_t . ' Monaten; der Vertrag endet automatisch, eine Kündigung ist nicht erforderlich und es findet keine automatische Verlängerung statt.'
	: 'Erstlaufzeit ' . $monate_t . ' Monate, danach Verlängerung auf unbestimmte Zeit mit einer Kündigungsfrist von einem Monat.';
		echo '<p style="font-size:0.92em;">Tarif <strong>' . esc_html( $t['name'] ) . '</strong> (' . esc_html( $t['nutzer_text'] ) . ') — '
			. esc_html( number_format( $netto_t, 2, ',', '.' ) ) . ' € netto ' . esc_html( $zeit_t ) . ' zzgl. gesetzl. USt. — Endpreis '
			. esc_html( number_format( $brutto_t, 2, ',', '.' ) ) . ' € inkl. 19 ' . '%' . ' USt. Abrechnung im Voraus. '
			. esc_html( $lauf_t ) . '</p>';

		if ( ! $dok ) {
			echo '<p style="color:#d63638"><strong>Die Lizenzvereinbarung ist derzeit nicht abrufbar. Eine Bestellung ist im Moment nicht möglich — bitte wenden Sie sich an ' . esc_html( Epos_Woocommerce::KONTAKT_EMAIL ) . '.</strong></p></div>';
			return;
		}

		// Schritt 3: Unternehmerbestätigung (Pflicht, nicht vorbelegt)
		echo '<p style="margin-bottom:10px"><label style="display:flex;gap:8px;align-items:flex-start;font-size:0.92em">';
		echo '<input type="checkbox" name="epos_unternehmer" id="epos_unternehmer" value="1" style="margin-top:4px"' . checked( true === self::checkbox_zustand( 'epos_unternehmer' ), true, false ) . '> ';
		echo '<span>Optional: Ich bestelle als Unternehmer im Sinne des § 14 BGB, als juristische Person des öffentlichen Rechts oder als öffentlich-rechtliches Sondervermögen (Angabe nur für Rechnung und Netto-Preisausweis). Privatpersonen, Verbraucher (§ 13 BGB), Studierende, Schülerinnen und Schüler sowie Auszubildende lassen dieses Feld einfach leer und können ebenso bestellen; für Verbraucher gilt das gesetzliche Widerrufsrecht. </span>';
		echo '</label></p>';

		// Schritt 4: Zustimmung zur Lizenzvereinbarung (Pflicht, nicht vorbelegt, PDF verlinkt)
