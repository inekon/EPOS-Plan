    protected override void OnInitialized()
        => _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.KLIMADATEN,
                                             () => KiSicht(), KiHaken());

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await RegionenLaden();
        await _wurzel.FocusAsync();
        StateHasChanged();
    }

