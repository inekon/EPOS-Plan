@* Eingabe der Solarkollektoren - der PROJEKTDIALOG (iU9-W7.7).

   VORBILD. Views/Solarthermie/Form_SolarKollektoren (513 Z., lokalisiert
   de/en, 26 Kartenzeilen plus die Gruppe "Kollektor", 3 MessageBox, ein
   Paint-Rahmen). Derselbe Aufbau wie die fuenf Erzeugerdialoge der Welle 6 -
   links "ausgewaehlt im Projekt", rechts "aus Datenbank", dazwischen ◀ und ▶,
   unten der Detailblock -, deshalb dieselbe Datenform ErzeugerAuswahlDaten.

   EINE GRUPPE MEHR. Anders als die fuenf traegt diese Maske unter dem
   Modulblock eine zweite Gruppe "Kollektor": Modulanzahl, Neigung, Azimut
   und die gerechnete Aperturflaeche. Vor- und Ruecklauf fuehrt sie nicht - sie
   haben beim Solarkollektor keinen Rechenweg. Sie erscheint nur bei
   einer PROJEKTZEILE - ein Katalogsatz hat keine Ausrichtung
   (dataGridView1_Click:289 blendete sie aus, ApplySelectedSolar:324 ein).

   GESCHRIEBEN WIRD NUR MIT "UEBERNEHMEN"; dabei bleibt es.

   DER BILDBLITZ WIRD EIN HINWEIS. "Uebernehmen" zeigte eine PictureBox fuer
   500 ms und hielt dafuer den Oberflaechenfaden mit Thread.Sleep an. In der
   WebView waere das ein eingefrorener Dialog; stattdessen steht ein
   Warnbanner "uebernommen" (A-24).

   TASTATUR: Esc schliesst, aber erst, wenn keine Ueberlagerung und keine
   Rueckfrage offen ist. Enter ist nicht belegt.

   ENTSCHEID #76 (05.09.2026). Die zwei Listen und die Pfeilspalte stehen im
   Baustein Zweispaltenauswahl - EIN Aufbau fuer alle Projekt/Datenbank-Dialoge
   des Hauses. Nebeneinander wie im BHKW-PLAN, auf schmalem Schirm untereinander;
   die Knoepfe tragen seither Klartext, das Zeichen setzt der Baustein je nach
   Anordnung (◀▶ nebeneinander, ▲▼ untereinander). *@

@namespace EPOS.UI.Dialoge.Solarthermie
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Kosten
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="@(() => Geschlossen.InvokeAsync(false))" />
    </div>

    <p class="epos-kontextzeile">@KopfbandText</p>

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    <Zweispaltenauswahl LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                        UebernehmenText="@LabelHinzu"
                        UebernehmenGesperrt="@(_katalogZeile is null)" Uebernehmen="BeiHinzu"
                        EntfernenText="@LabelEntfernen"
                        EntfernenGesperrt="@(_projektZeile is null)" Entfernen="BeiEntfernen">

        <Links>
            <div class="epos-raster-huelle">
                <table class="epos-raster">
                    <thead>
                        <tr>
                            <th>@SpalteWahl</th>
                            <th>@SpalteName</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ErzeugerZeile zeile in Zeilen)
                        {
                            ErzeugerZeile z = zeile;
                            <tr class="@(z == _projektZeile ? "epos-zeile--markiert" : null)">
                                <td>
                                    <Zeilenwahl Gewaehlt="@(z == _projektZeile)" Kurztext="@SpalteWahl"
                                                Gewaehltwerden="() => ProjektZeileWaehlen(z)" />
                                </td>
                                <td>@z.Bezeichner</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Links>

        <Rechts>
            @* DIE EINE KATALOGLISTE (W14a-E-10, Stufe S2.1). Der Kollektorkatalog
               hatte gar keinen Filter - bei sieben Saetzen fiel das nicht auf,
               nach dem VDI-Import (Hunderte) schon. Statt der Sammelspalte
               "Eigenschaften" stehen jetzt SECHS Spalten mit Sortierpfeil und
               Trichter. *@
            <Katalogliste Profil="@Katalogprofil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_katalogGewaehlt" GewaehltChanged="KatalogZeileWaehlen"
                          Vergleichsparameter="@Vergleichsparameter" />

            @* NUR NOCH „neu…" und „löschen" (Anwenderentscheid 15.09.2026). Der dritte
               Knopf, „Kollektor in DB ändern…", ist als „Bearbeiten…" in den
               Modulbereich gewandert - dorthin, wo der gewaehlte Satz steht und wo auch
               die Kostenknoepfe sitzen. Diese beiden bleiben HIER: Sie wirken auf die
               LISTE (einen Satz anlegen, einen entfernen), nicht auf den Modulblock. *@
            <div class="epos-leiste">
                <button type="button" class="epos-knopf"
                        @onclick="() => _namensfrage = true">@BtnKatalogNeuText</button>
                <button type="button" class="epos-knopf" disabled="@(_katalogZeile is null)"
                        @onclick="() => _loeschfrage = true">@BtnKatalogLoeschenText</button>
            </div>
        </Rechts>

    </Zweispaltenauswahl>

    <Gruppenkopf Titel="@GruppeModul">
        <KindInhalt>
            @* DIE KNOPFZEILE STEHT OBEN (Anwenderentscheid 16.09.2026: "Der
               Bearbeiten-Button soll weiter oben, z. B. unter der blauen Zeile Modul
               stehen, so dass er besser sichtbar ist"). EINE Zeile unmittelbar unter
               dem Gruppenkopf: links die Kostenknoepfe, rechts "Bearbeiten…",
               dazwischen der Fueller. Dieselbe Bauart in allen sechs
               Erzeugerdialogen; die Knoepfe selbst sind unveraendert - ohne gewaehlten
               Katalogsatz bleibt "Bearbeiten…" tot. *@
            <div class="epos-leiste">
                @if (!Wizard && KostenOeffnen is not null)
                {
                    <KostenKnoepfeLeiste KostenOeffnen="@KostenLeiste"
                                         InvestText="@KostenInvestText" BetriebText="@KostenBetriebText" />
                }
                <span class="epos-leiste-fueller"></span>
                <button type="button" class="epos-knopf" disabled="@(_katalogZeile is null)"
                        @onclick="() => KatalogEditor(false)">@BtnBearbeitenText</button>
            </div>

            @* Formularraster (iU8-E-2, Paket P1): Der Detailblock stand zuvor als
               eine Spalte voller Felder ueber die ganze Breite. *@
            <Formularraster>
                <KindInhalt>
            <Textfeld Bezeichnung="@LabelName" Wert="@_detail.Bezeichner" NurLesen="true" />
            @foreach (var feld in _detail.Felder)
            {
                @* Eine Zahl bekommt die kurze Feldbreite (iU8-E-2, Paket P1). *@
                <Textfeld Bezeichnung="@feld.Feld" Wert="@feld.Wert" NurLesen="true"
                          Kurz="@ErzeugerDetail.IstZahl(feld.Wert)" />
            }
                </KindInhalt>
            </Formularraster>

            @* ALLE DATEN DES GEWAEHLTEN KATALOGSATZES, aufklappbar und BEARBEITBAR
               (Anwenderentscheid 15.09.2026, Muster HeizkesselDialog): Der
               Bearbeiten-Dialog traegt keine Kosten mehr, gepflegt wird der Preis hier.
               Das Raster ist DASSELBE, das der Katalogbrowser zeigt - der Baustein
               Katalogfelder; er fuehrt die vierzehn Spalten des Kollektorsatzes.

               AUFGEKLAPPT IST DIE VORGABE (Anwenderentscheid 16.09.2026: "Unter
               Bearbeiten sollen alle Parameter angezeigt werden und bearbeitbar sein").
               Wer einen Kollektor waehlt, sieht seine Daten sofort; zuklappen kann er
               sie weiterhin mit demselben Knopf. Ohne gewaehlten Katalogsatz gibt es den
               Block gar nicht, und dann wird auch nichts abgefragt. Der Zustand gehoert
               der Dialogsitzung. *@
            @if (Katalogfelder is not null && _katalogZeile is not null)
            {
                <div class="epos-modulparameter">
                    <button type="button" class="epos-modulparameter-knopf"
                            aria-expanded="@(_parameterOffen ? "true" : "false")"
                            @onclick="ParameterUmschalten">
                        <span class="epos-modulparameter-pfeil" aria-hidden="true">@(_parameterOffen ? "▾" : "▸")</span>
                        <span>@LabelAlleParameter</span>
                    </button>

                    @if (_parameterOffen && _felder is not null)
                    {
                        <Katalogfelder Felder="@_felder" NurLesen="@(KatalogfelderSpeichern is null)"
                                       Geaendert="FeldGeaendert"
                                       FehlerZustand="BeiFeldFehler" />

                        @if (KatalogfelderSpeichern is not null)
                        {
                            @* Die Rueckmeldung steht AM Knopf (Speichervermerk): „Gespeichert um …"
                               bzw. der Grund der Ablehnung rot; ohne Aenderung weich gesperrt. *@
                            <div class="epos-leiste">
                                <Speichervermerk @ref="_felderVermerk" Text="@BtnFelderSpeichernText"
                                                 Geaendert="@_felderGeaendert" Gesperrt="@_feldFehler"
                                                 Satz="@_katalogZeile?.Bezeichner" Speichern="FelderSpeichern" />
                            </div>
                        }
                    }
                </div>
            }

            @* HIER STANDEN DIE KOSTENKNOEPFE UND „Bearbeiten…" (15.09.2026). Sie sind am
               16.09.2026 an den KOPF des Modulbereichs gewandert - unter die blaue Zeile
               "Modul", wo der Anwender sie sieht, ohne an den Parametern
               vorbeizurollen. *@
        </KindInhalt>
    </Gruppenkopf>

    @* Die Kollektorgruppe steht NUR bei einer Projektzeile. *@
    @if (_projektZeile is not null)
    {
        <Gruppenkopf Titel="@GruppeKollektor">
            <KindInhalt>
                @* H13 (06.09.2026): Der Weg in die Wikirubrik "Berechnung". Er sitzt
                   HIER, weil dieser Abschnitt den Rechenweg parametriert - Anzahl
                   (mit ihr die Aperturflaeche), Neigung und Azimut. Vor- und
                   Ruecklauf gehoeren nicht dazu: Der Ertrag rechnet mit fester
                   Speichertemperatur. Der Fensterknopf oben rechts bleibt, was er
                   ist. *@
                <div class="epos-berechnungshilfe">
                    <InfoKnopf Schluessel="Form_SolarKollektoren.Berechnung"
                               StandardKurztext="Berechnungsweg Solarthermie" />
                </div>
                @* Die Feldpaare von Hand entfallen - das Formularraster stellt zwei
                   Feldpaare je Zeile, sobald die Spalte breit genug ist
                   (iU8-E-2, Paket P1). *@
                <Formularraster>
                    <KindInhalt>
                <Ganzzahlfeld Bezeichnung="@LabelAnzahl" Feldname="@LabelAnzahl"
                              Wert="@_eingaben.Anzahl" WertChanged="w => { _eingaben.Anzahl = w; }" />
                <Textfeld Bezeichnung="@LabelAperturflaeche" Wert="@Gesamtflaeche" NurLesen="true"
                          Kurz="true" />
                <Ganzzahlfeld Bezeichnung="@LabelNeigung" Feldname="@LabelNeigung"
                              Wert="@_eingaben.Neigung" WertChanged="w => { _eingaben.Neigung = w; }" />
                <Ganzzahlfeld Bezeichnung="@LabelAzimut" Feldname="@LabelAzimut"
                              Wert="@_eingaben.Azimut" WertChanged="w => { _eingaben.Azimut = w; }" />
                @* DIE SENKEN DER ANLAGE (Anwenderentscheid 23.09.2026) - wortgleich zum
                   HeizkesselDialog: fertig formuliert von der Huelle, leer = keine Zeile.
                   Bei der Solarthermie besonders wichtig: Ohne Senke fuer ihren Bedarf
                   findet das Kollektorfeld keinen Abnehmer. *@
                @if (!string.IsNullOrEmpty(_projektZeile.Senken))
                {
                    <Herleitungszeile Text="@_projektZeile.Senken" />
                }
                    </KindInhalt>
                </Formularraster>
                <div class="epos-leiste">
                    <button type="button" class="epos-knopf" @onclick="BeiUebernehmen">@BtnUebernehmenText</button>
                </div>
            </KindInhalt>
        </Gruppenkopf>
    }

    @if (!Wizard)
    {
        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }

    @* --- Ueberlagerung 1: der Katalogeditor (W7.6) --------------------------- *@
    <Ueberlagerung Offen="@(_editorGaben is not null)"
                   Titel="@BtnKatalogAendernText" Geschlossen="() => _editorGaben = null">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                @* Ein Titel, eine Stelle: die Ueberlagerung traegt Titel UND Kreuz,
                   also zeigt der Editor keinen eigenen Kopf. TitelText="" steht
                   RECHTS vom Satz und gilt deshalb auch dann, wenn er einen Titel
                   mitbraechte. *@
                <SolarkollektorKatalogDialog @attributes="_editorGaben" TitelText=""
                                             Geschlossen="EditorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 2: die Namensabfrage vor "Kollektor in DB neu..." ----- *@
    <Ueberlagerung Offen="@_namensfrage" Titel="@BtnKatalogNeuText"
                   Geschlossen="() => _namensfrage = false">
        <KindInhalt>
            <NamensDialog TitelText="" FrageText="@LabelName"
                          OkText="@OkText" AbbrechenText="@AbbrechenText"
                          Geschlossen="NameFertig" />
        </KindInhalt>
    </Ueberlagerung>

    <Rueckfrage Offen="@_loeschfrage" Frage="@FrageLoeschen" TitelText="@BtnKatalogLoeschenText"
                JaText="@JaText" NeinText="@NeinText" Beantwortet="LoeschfrageBeantwortet" />
</div>

@code {
    /// <summary>
    /// Die Solarkollektoren des Projekts — die Liste gehört der Hülle und wird an Ort
    /// und Stelle bearbeitet (wie in den fünf Erzeugerdialogen der Welle 6).
    /// </summary>
    [Parameter] public List<ErzeugerZeile> Zeilen { get; set; } = new();

    /// <summary>
    /// <b>Die Spalten der Katalogliste</b> — <c>Katalogfilterprofil.MitVerwendung(
    /// Anlagenart.Solarkollektoren, uebersetzer)</c>.
    /// </summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }
    /// <summary>
    /// <b>Die Zeilen des VERGLEICHS</b> (Frage <b>Q3</b>, Stufe S3.3) — derselbe Weg,
    /// aus dem die Parameterübersicht (W14a‑E‑8) ihre Zeilen holt. Ohne ihn
    /// vergleicht die <c>Katalogliste</c> ihre eigenen Spalten.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Vergleichsparameter { get; set; }


    /// <summary>
    /// Die Zeilen des Katalogs, UNGEFILTERT —
    /// <c>SolarkollektorenStammCtrl.Katalogfilterzeilen()</c>.
    /// </summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste; sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>
    /// <b>Ein eigener Filterstand statt des Registers</b> — dasselbe Muster wie
    /// <c>ProfilVorgabe</c>. Ohne ihn holt der Dialog seinen Stand aus dem
    /// <c>Katalogfilterregister</c> (S2.5: je Katalog EINER, für die Sitzung,
    /// gemeinsam mit den anderen Dialogen desselben Katalogs). Ein Prüfstand gibt
    /// hier seinen eigenen herein und bleibt damit von den anderen Fällen getrennt;
    /// dass das Register wirklich teilt, prüft <c>KatalogfilterstandTests</c>.
    /// </summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }


    /// <summary>Der Detailblock zu einem Kollektor — für beide Listen dieselbe Quelle.</summary>
    [Parameter] public Func<string, ErzeugerDetail?>? Detail { get; set; }

    /// <summary>
    /// Die Aperturfläche EINES Moduls [m²] — sie mal der Modulanzahl ergibt die
    /// Gesamtfläche. Der Vorläufer las dafür die Spalte <c>Aperturflaeche</c> des
    /// Stammsatzes (die lokale Variable dort heißt <c>modulflaeche</c>).
    /// </summary>
    [Parameter] public Func<string, double>? Modulflaeche { get; set; }

    /// <summary>Nimmt den Kollektor in das Projekt auf („◀").</summary>
    [Parameter] public Func<int, AufnahmeErgebnis>? Aufnehmen { get; set; }

    /// <summary>Entfernt die Zeile aus der geteilten Liste („▶").</summary>
    [Parameter] public Action<ErzeugerZeile>? Entfernen { get; set; }

    /// <summary>Übernimmt die Kollektorgruppe in das Modell („Übernehmen").</summary>
    [Parameter] public Action<ErzeugerZeile>? Uebernehmen { get; set; }

    /// <summary>Der Parametersatz des Katalogeditors; zweiter Wert <c>true</c> = anlegen.</summary>
    [Parameter] public Func<string, bool, IReadOnlyDictionary<string, object>>? EditorGaben { get; set; }

    /// <summary>Löscht einen Katalogsatz.</summary>
    [Parameter] public Func<string, bool>? KatalogLoeschen { get; set; }

    /// <summary>
    /// ALLE Felder eines Katalogsatzes — derselbe Weg, aus dem der Katalogbrowser sein
    /// Raster speist (<c>KatalogBrowserWege.Detail</c>). Ohne ihn gibt es den Aufklapper
    /// „Alle Daten anzeigen" nicht.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<BrowserFeldwert>?>? Katalogfelder { get; set; }

    /// <summary>
    /// Schreibt die geänderten Felder zurück; <c>null</c> = der Katalog hat keinen
    /// Speicherweg, dann ist der Aufklapper reine Anzeige.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<BrowserFeldwert>, KatalogSpeicherErgebnis>? KatalogfelderSpeichern { get; set; }

    /// <summary>
    /// Öffnet die Kostenverwaltung zur GEWÄHLTEN Projektzeile; der zweite Parameter ist
    /// der Schalter <c>betrieb</c> (<c>false</c> = Investitions-, <c>true</c> =
    /// Betriebskosten). Ohne Delegat fehlt die Leiste.
    /// </summary>
    /// <remarks>
    /// <b>Kein dritter Knopf.</b> „Energiekosten…" führt in die
    /// Energieträgerverwaltung — die Sonne ist kein gekaufter Träger, also gibt es den
    /// Weg hier nicht (die Leiste zeichnet ohne Delegat nichts).
    /// </remarks>
    [Parameter] public Func<ErzeugerZeile?, bool, Task>? KostenOeffnen { get; set; }

    /// <summary>Assistentenbetrieb: keine OK/Abbrechen-Leiste und keine Kostenleiste.</summary>
    [Parameter] public bool Wizard { get; set; }

    /// <summary><c>true</c> = OK, <c>false</c> = Abbrechen.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Eingabe der Solarkollektoren";
    [Parameter] public string KopfbandText { get; set; } = "Eingabe der Solarkollektoren";
    [Parameter] public string LabelProjektliste { get; set; } = "Auswahl in Projekt:";
    [Parameter] public string LabelKatalogliste { get; set; } = "Auswahl in DB:";

    /// <summary>
    /// Kopf der NAMENSSPALTE der Projektliste. Die Katalogliste braucht ihn seit
    /// S2.1 nicht mehr — dort kommen die Spaltenköpfe aus dem <c>Katalogprofil</c>.
    /// </summary>
    [Parameter] public string SpalteName { get; set; } = "Name";
    [Parameter] public string SpalteWahl { get; set; } = "Wahl";
    [Parameter] public string LabelHinzu { get; set; } = "In das Projekt übernehmen";
    [Parameter] public string LabelEntfernen { get; set; } = "Aus dem Projekt entfernen";
    [Parameter] public string GruppeModul { get; set; } = "Modul";
    [Parameter] public string GruppeKollektor { get; set; } = "Kollektor";
    [Parameter] public string LabelName { get; set; } = "Name:";
    [Parameter] public string LabelAnzahl { get; set; } = "Modulanzahl:";
    [Parameter] public string LabelAperturflaeche { get; set; } = "Aperturfläche [m²]:";
    [Parameter] public string LabelNeigung { get; set; } = "Neigung [°]:";
    [Parameter] public string LabelAzimut { get; set; } = "Azimut [°]:";
    [Parameter] public string BtnUebernehmenText { get; set; } = "Übernehmen";

    /// <summary>
    /// Der Knopf im MODULBEREICH (15.09.2026) — er trägt seit dem Entscheid dieselbe
    /// Beschriftung wie in den fünf Schwesterdialogen (<c>HZK_BTN_BEARBEITEN</c>).
    /// </summary>
    [Parameter] public string BtnBearbeitenText { get; set; } = "Bearbeiten...";

    /// <summary>
    /// Der TITEL der Überlagerung über dem Katalogeditor — der alte Knopftext, der als
    /// Überschrift weiter sagt, worum es geht.
    /// </summary>
    [Parameter] public string BtnKatalogAendernText { get; set; } = "Kollektor in DB ändern...";
    [Parameter] public string BtnKatalogNeuText { get; set; } = "Kollektor in DB neu...";
    [Parameter] public string BtnKatalogLoeschenText { get; set; } = "Kollektor in DB löschen";

    /// <summary>Beschriftung des Aufklappers über den übrigen Katalogwerten.</summary>
    [Parameter] public string LabelAlleParameter { get; set; } = "Alle Daten anzeigen";

    /// <summary>Beschriftung des Speicherknopfs im Aufklapper.</summary>
    [Parameter] public string BtnFelderSpeichernText { get; set; } = "Speichern";
    [Parameter] public string KostenInvestText { get; set; } = "Investitionskosten…";
    [Parameter] public string KostenBetriebText { get; set; } = "Betriebskosten…";
    [Parameter] public string OkText { get; set; } = "OK";
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";
    [Parameter] public string JaText { get; set; } = "Ja";
    [Parameter] public string NeinText { get; set; } = "Nein";
    [Parameter] public string FrageLoeschen { get; set; } = "Wollen Sie wirklich den Solarkollektor löschen?";
    [Parameter] public string MeldungUebernommen { get; set; } = "Die Angaben sind übernommen.";

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_SolarKollektoren.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private ErzeugerZeile? _projektZeile;
    private Katalogfilterzeile? _katalogZeile;
    private IReadOnlyList<Katalogfilterzeile> _katalog = Array.Empty<Katalogfilterzeile>();

    /// <summary>Der gewählte Bezeichner der KATALOGliste — die Markierung hängt am NAMEN.</summary>
    private string _katalogGewaehlt = "";

    /// <summary>Der Filterstand je Katalog über die Sitzung (S2.5, Frage Q2).</summary>
    private Katalogfilterstand _filterstand = new();
    private ErzeugerDetail _detail = new("", "", Array.Empty<(string, string)>());
    private double _modulflaeche;

    /// <summary>
    /// Der ARBEITSSTAND der Kollektorgruppe. Er wird AN ORT UND STELLE gefüllt und nie
    /// ersetzt — der Getter der Maskenanmeldung zeigt damit immer auf den lebenden
    /// Stand (<see cref="SolarkollektorenEingaben"/>).
    /// </summary>
    private readonly SolarkollektorenEingaben _eingaben = new();

    private IReadOnlyDictionary<string, object>? _editorGaben;
    private bool _namensfrage;
    private bool _loeschfrage;
    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Hinweis;

    /// <summary>Die gewählte Projektzeile — Prüfhilfe für die Tests.</summary>
    public ErzeugerZeile? Projektzeile => _projektZeile;

    /// <summary>Die gewählte Katalogzeile — Prüfhilfe für die Tests.</summary>
    public Katalogfilterzeile? Katalogzeile => _katalogZeile;

    /// <summary>Die Zeilen des Katalogs (Pruefhilfe fuer Tests).</summary>
    public IReadOnlyList<Katalogfilterzeile> Katalog => _katalog;

    /// <summary>Der Filterzustand des Katalogs (Pruefhilfe fuer Tests).</summary>
    public Katalogfilterstand Filterstand => _filterstand;

    /// <summary>Steht der Katalogeditor? Prüfhilfe für die Tests.</summary>
    public bool EditorOffen => _editorGaben is not null;

    /// <summary>
    /// Steht der Aufklapper „Alle Daten" offen? Der Zustand gehört der Dialogsitzung
    /// und wird nirgends abgelegt. <b>Vorgabe OFFEN</b> (Anwenderentscheid 16.09.2026).
    /// </summary>
    /// <remarks>
    /// Weil er offen beginnt, holt schon die ERSTE Wahl eines Katalogsatzes die Felder:
    /// <c>KatalogZeileWaehlen</c> ruft <c>FelderHolen</c>, sobald er offen steht. Ohne
    /// gewählten Satz gibt es den Block nicht — dann wird auch nichts abgefragt.
    /// </remarks>
    private bool _parameterOffen = true;

    /// <summary>Steht der Parameterblock offen? (Prüfhilfe für Tests.)</summary>
    public bool ParameterOffen => _parameterOffen;

    /// <summary>Die Felder des gewählten Satzes; <c>null</c> = noch nicht geholt.</summary>
    private IReadOnlyList<BrowserFeldwert>? _felder;

    /// <summary>Hat der Anwender im Aufklapper etwas geändert?</summary>
    private bool _felderGeaendert;

    /// <summary>Steht in einem Zahlenfeld des Aufklappers etwas Ungültiges?</summary>
    private bool _feldFehler;

    /// <summary>
    /// Die Gesamtfläche — Modulfläche mal Anzahl, live (<c>textBox_Anzahl_TextChanged</c>:367),
    /// auf höchstens zwei Nachkommastellen gerundet und in der Kultur des Anwenders
    /// (sonst stand dort das Produkt zweier Gleitkommazahlen mit allen Stellen, etwa
    /// „25,080000000000002").
    /// </summary>
    private string Gesamtflaeche => (_modulflaeche * (_eingaben.Anzahl ?? 0))
        .ToString("0.##", System.Globalization.CultureInfo.CurrentCulture);

    protected override void OnParametersSet()
    {
        Filtertexte.SpalteWahl = SpalteWahl;
    }

    protected override void OnInitialized()
    {
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Katalogprofil?.Art ?? Anlagenart.Solarkollektoren);

        KatalogNeuLaden();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);

        // Welle KI-F1: den ARBEITSSTAND der Kollektorgruppe beim Hilfe-Assistenten
        // anmelden - nicht die Projektzeile. Der Anwender sieht diesen Stand, und
        // "Uebernehmen" traegt ihn in die Zeile; eine Setzung in die Zeile bliebe auf
        // der Maske unsichtbar. Ohne gewaehlte Zeile gibt es die Kollektorgruppe nicht,
        // dann sind die Felder leer.
        // Welle #458, Stufe 2: angemeldet ist seither die SICHTKLASSE - sie reicht den
        // Arbeitsstand durch und traegt den Aufklapper „Alle Daten" als Feldtafel.
        _kiMaske = KiMaskenanmeldung.Fuer(
            KiMaskennamen.SOLARKOLLEKTOREN_PROJEKT, () => KiSicht(), KiHaken());
    }

    private SolarkollektorenKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: der Arbeitsstand der Kollektorgruppe (nur mit gewählter
    /// Projektzeile) und der Aufklapper „Alle Daten" des gewählten Katalogsatzes.
    /// </summary>
    private SolarkollektorenKiSicht KiSicht() => _kiSicht ??= new SolarkollektorenKiSicht
    {
        Eingabenquelle = () => _projektZeile is null ? null : _eingaben,
        AlleDaten = new AlleDatenTafel
        {
            Felder = () => _parameterOffen ? _felder : null,
            Sperrgrund = () => AlleDatenTafel.Grund(_parameterOffen ? _felder : null, KatalogfelderSpeichern is not null,
                                                    _katalogZeile?.Geschuetzt == true),
            Gesetzt = () => _felderGeaendert = true
        }
    };

    // =================================================================================
    // Der Hilfe-Assistent liest und setzt die Kollektorgruppe (Welle KI-F1)
    // =================================================================================

    /// <summary>
    /// Die Anmeldung bei der <c>KiMaskenbruecke</c>. Sie hält die Getter auf den
    /// Arbeitsstand der Kollektorgruppe und fällt mit dem Dialog.
    /// </summary>
    /// <remarks>
    /// <b>Angemeldet heißt nicht übertragen.</b> Ob ein Feldwert hinausgeht,
    /// entscheiden der Schalter „Feldwerte mitsenden" im Chat und die
    /// Einwilligungsstufe „Dialogdaten" (KI‑D‑Q2).
    /// </remarks>
    private KiMaskenanmeldung? _kiMaske;

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>„Speichern" ist der Knopf „Übernehmen"</b> — derselbe Weg, den die fünf
    /// Zahlen von Hand gehen: aus dem Arbeitsstand in die gewählte Projektzeile und von
    /// dort über den Delegaten in das Modell. Ohne gewählte Zeile gibt es nichts zu
    /// übernehmen, und die Aktion lehnt benannt ab.</para>
    /// <para><b>Keine eigene Prüfung</b> — die fünf Ganzzahlfelder färben sich
    /// selbst.</para>
    /// <para><b>Der SCHREIBSCHUTZ hängt am Gerät</b>, auf das die gewählte Zeile
    /// verweist (<c>ErzeugerZeile.NurLesen</c>).</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _projektZeile?.NurLesen ?? false,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>
    /// „Speichern" des Assistenten: Trägt der Aufklapper „Alle Daten" Änderungen, geht
    /// er den Weg SEINES Knopfes (<see cref="FelderSpeichern"/>) — sonst wird die
    /// Kollektorgruppe übernommen wie bisher (Welle #458, Stufe 2).
    /// </summary>
    private KiKern.KiErgebnis KiSpeichern()
    {
        if (!_felderGeaendert) return KiUebernehmen();

        FelderSpeichern();
        return _felderGeaendert
            ? KiKern.KiErgebnis.Abgelehnt(_meldung.Length > 0 ? _meldung
                  : Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText))
            : KiKern.KiErgebnis.Ok(_felderErfolg, anzahl: 1);
    }

    private KiKern.KiErgebnis KiUebernehmen()
    {
        if (_projektZeile is null || Uebernehmen is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", TitelText));

        BeiUebernehmen();
        return KiKern.KiErgebnis.Ok(_projektZeile.Bezeichner, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <summary>
    /// Liest den Katalog neu — nach einem SCHREIBweg (Editor, Neu…, Löschen). Der
    /// FILTER ruft sie nicht: Er wirkt auf die Anzeige, nie auf die Auswahl.
    /// </summary>
    private void KatalogNeuLaden()
    {
        _katalog = Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();
        VerwendungStempeln();

        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
    }

    /// <summary>Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste.</summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    /// <summary>Der Katalogsatz zu einem Bezeichner; <c>null</c>, wenn es ihn nicht gibt.</summary>
    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    private void DetailSetzen(string name)
    {
        _detail = (Detail is not null ? Detail(name) : null) ?? new ErzeugerDetail(name, "", Array.Empty<(string, string)>());
        _modulflaeche = Modulflaeche?.Invoke(name) ?? 0;
    }

    /// <summary>Projektzeile: Detail UND Kollektorgruppe (<c>ApplySelectedSolar</c>:324).</summary>
    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _meldung = "";
        _felder = null;                       // der Aufklapper gehoert dem KATALOGsatz
        DetailSetzen(zeile.Bezeichner);

        _eingaben.Anzahl = (int?)(zeile.AnzahlModule ?? 0);
        _eingaben.Neigung = zeile.Neigung ?? 0;
        _eingaben.Azimut = zeile.Azimut ?? 0;
    }

    /// <summary>Katalogzeile: nur das Detail, KEINE Kollektorgruppe (<c>dataGridView1_Click</c>:289).</summary>
    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _projektZeile = null;
        _meldung = "";
        DetailSetzen(_katalogGewaehlt);

        // Der offene Aufklapper zeigt den NEUEN Satz, der geschlossene holt nichts.
        if (_parameterOffen) FelderHolen(); else _felder = null;
    }

    // =================================================================================
    // Der Aufklapper „Alle Daten anzeigen" (Anwenderentscheid 15.09.2026)
    // =================================================================================

    /// <summary>Auf- und zuklappen - und beim AUFklappen die Felder holen.</summary>
    /// <remarks>
    /// <b>Der Knopf bleibt, die Vorgabe ist offen.</b> Wer zuklappt und wieder
    /// aufklappt, sieht den Stand von JETZT und nicht den von der Auswahl.
    /// </remarks>
    private void ParameterUmschalten()
    {
        _parameterOffen = !_parameterOffen;
        if (_parameterOffen) FelderHolen();
    }

    /// <summary>Holt die Felder des gewählten Katalogsatzes neu.</summary>
    private void FelderHolen()
    {
        _felder = Katalogfelder is null || _katalogZeile is null
            ? null
            : Katalogfelder(_katalogZeile.Bezeichner);
        _felderGeaendert = false;
        _feldFehler = false;
    }

    /// <summary>Ein Zahlenfeld des Aufklappers meldet einen ungültigen Zustand.</summary>
    private void BeiFeldFehler((string Feldname, bool Fehler) meldung)
        => _feldFehler = meldung.Fehler;

    /// <summary>Knopf „Speichern" des Aufklappers samt Rückmeldung daneben.</summary>
    private Speichervermerk? _felderVermerk;

    /// <summary>Meldung des Katalogs zum letzten gelungenen Speichern — für den Assistenten, nicht als Band.</summary>
    private string _felderErfolg = "";

    /// <summary>Eine Eingabe im Aufklapper: Speichern geht wieder, der Vermerk fällt weg.</summary>
    private void FeldGeaendert()
    {
        _felderGeaendert = true;
        _felderVermerk?.Leeren();
    }

    /// <summary>
    /// Schreibt die geänderten Felder zurück und lädt die Katalogliste neu.
    /// </summary>
    /// <remarks>
    /// <b>Der Befund des Katalogs zählt, nicht die Absicht.</b> Lehnt der Speicherweg ab
    /// (Schreibschutz der Auslieferung, Prüfmeldung), bleibt der geänderte Stand im
    /// Aufklapper stehen - der Anwender soll ihn verbessern können, statt ihn zu
    /// verlieren.
    /// </remarks>
    private void FelderSpeichern()
    {
        if (KatalogfelderSpeichern is null || _felder is null || _katalogZeile is null) return;

        KatalogSpeicherErgebnis ergebnis = KatalogfelderSpeichern(_katalogZeile.Bezeichner, _felder);
        if (!ergebnis.Ok)
        {
            // Das Band oben bleibt fuer den Fehler - dazu der Grund rot am Knopf.
            _meldung = ergebnis.Meldung;
            _meldungStufe = WarnStufe.Warnung;
            _felderVermerk?.Fehler(ergebnis.Meldung);
            return;
        }

        // Der Erfolg steht nur noch am Knopf; ein Band einer frueheren Ablehnung faellt weg.
        _felderGeaendert = false;
        _meldung = "";
        _felderErfolg = ergebnis.Meldung;
        _felderVermerk?.Gespeichert();

        // Die Liste zeigt Kollektortyp und Aperturflaeche - beide koennen sich gerade
        // geaendert haben; das Detail des gewaehlten Satzes ebenso.
        KatalogNeuLaden();
        DetailSetzen(_katalogGewaehlt);
    }

    // --- Die Bruecke zur Kostenleiste ------------------------------------------
    // Ohne Delegat KEIN Rueckruf - sonst zeichnete die Leiste einen Knopf, der
    // nichts tut (ihre eigene Regel).

    private Func<bool, Task>? KostenLeiste
        => KostenOeffnen is null ? null : (Func<bool, Task>)BeiKosten;

    /// <summary>Reicht die gewählte Projektzeile an die Kostenverwaltung durch.</summary>
    private Task BeiKosten(bool betrieb)
        => KostenOeffnen?.Invoke(_projektZeile, betrieb) ?? Task.CompletedTask;

    // =================================================================================
    // Aufnehmen und Entfernen
    // =================================================================================

    private void BeiHinzu()
    {
        if (_katalogZeile is null || Aufnehmen is null) return;

        AufnahmeErgebnis aufnahme = Aufnehmen(_katalogZeile.Id);
        if (aufnahme.Meldung.Length > 0)
        {
            _meldung = aufnahme.Meldung;
            _meldungStufe = aufnahme.Fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
        }
        if (aufnahme.Zeile is null) return;

        Zeilen.Add(aufnahme.Zeile);
        VerwendungStempeln();                 // Q12
        ProjektZeileWaehlen(aufnahme.Zeile);
    }

    /// <summary>
    /// „▶": Die GEWÄHLTE Zeile geht. Ob die Projektkopie mitgeht, entscheidet die
    /// Hülle — sie bleibt stehen, solange eine zweite Zeile darauf verweist
    /// (<c>btn_Entfernen_Click</c>:251).
    /// </summary>
    private void BeiEntfernen()
    {
        if (_projektZeile is null) return;

        ErzeugerZeile zeile = _projektZeile;
        Zeilen.Remove(zeile);
        Entfernen?.Invoke(zeile);
        VerwendungStempeln();                 // Q12

        _projektZeile = null;
        _meldung = "";

        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
        else if (_katalog.Count > 0) KatalogZeileWaehlen(_katalog[0].Bezeichner);
        else _detail = new ErzeugerDetail("", "", Array.Empty<(string, string)>());
    }

    /// <summary>
    /// „Übernehmen": die drei Ganzzahlen in das Modell (<c>btn_Speichern_Click</c>:387).
    /// Leer gilt als 0 — dort steht <c>leerErlaubt: true</c>. Vor- und Rücklauf der
    /// Anlagenzeile schreibt der Dialog nicht; sie haben beim Solarkollektor keinen
    /// Rechenweg.
    /// </summary>
    private void BeiUebernehmen()
    {
        if (_projektZeile is null) return;

        _projektZeile.AnzahlModule = _eingaben.Anzahl ?? 0;
        _projektZeile.Neigung = _eingaben.Neigung ?? 0;
        _projektZeile.Azimut = _eingaben.Azimut ?? 0;

        Uebernehmen?.Invoke(_projektZeile);

        _meldung = MeldungUebernommen;
        _meldungStufe = WarnStufe.Hinweis;
    }

    // =================================================================================
    // Katalogpflege
    // =================================================================================

    private void KatalogEditor(bool neu, string? name = null)
    {
        if (EditorGaben is null) return;
        string bezeichner = name ?? _katalogZeile?.Bezeichner ?? "";
        if (bezeichner.Length == 0) return;

        _editorGaben = EditorGaben(bezeichner, neu);
    }

    private void NameFertig(string? name)
    {
        _namensfrage = false;
        if (string.IsNullOrWhiteSpace(name)) return;
        KatalogEditor(true, name!.Trim());
    }

    /// <summary>
    /// Nach dem Editor wird die Katalogliste IMMER neu gezogen — der Anwender kann
    /// dort etwas geändert und mit Abbrechen geschlossen haben (A-19 aus Welle 6).
    /// Der Vorläufer rief <c>SetDBList()</c> ebenfalls unbedingt.
    /// </summary>
    private void EditorFertig(bool _)
    {
        _editorGaben = null;
        KatalogNeuLaden();

        // Der Editor schreibt einen Teil der Felder, die der Aufklapper zeigt - steht er
        // offen, bekommt er den NEUEN Stand.
        if (_parameterOffen) FelderHolen();
    }

    private void LoeschfrageBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || _katalogZeile is null || KatalogLoeschen is null) return;

        if (!KatalogLoeschen(_katalogZeile.Bezeichner)) return;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        KatalogNeuLaden();
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Die Ueberlagerungen und die Rueckfrage werten Esc zuerst fuer sich aus.
        if (e.Key != "Escape" || _editorGaben is not null || _namensfrage || _loeschfrage)
            return Task.CompletedTask;
        return Geschlossen.InvokeAsync(false);
    }
}
