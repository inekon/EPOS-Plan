    /// <summary>Der Schlüssel der gewählten Quelle (Datenseite); <c>null</c> = alle Formate, die Endung entscheidet.</summary>
    private string? _quelle;

    /// <summary>Die gewählte Quelle (Prüfhilfe für Tests); nach dem Lesen einer <c>.sqproj</c> über „alle“ die Projektdatei.</summary>
    public string? Quelle => _quelle;

    private IReadOnlyList<GebaeudeImportQuellwahl> Quellenliste
        => Profil?.Quellen ?? (IReadOnlyList<GebaeudeImportQuellwahl>)Array.Empty<GebaeudeImportQuellwahl>();

    /// <summary>Stabile Ids je Schlüssel: die Stelle in der Liste der Datenseite, ab 1.</summary>
    private IReadOnlyList<(int Id, string Text)> Quelleneintraege
        => Quellenliste.Select((q, i) => (i + 1, q.Text)).ToList();

    private int? QuellenId(string? schluessel)
    {
        if (schluessel is null) return null;
        for (int i = 0; i < Quellenliste.Count; i++)
            if (string.Equals(Quellenliste[i].Schluessel, schluessel, StringComparison.Ordinal)) return i + 1;
        return null;
    }

    private void BeiQuelle(int? id)
        => _quelle = id is int i && i >= 1 && i <= Quellenliste.Count ? Quellenliste[i - 1].Schluessel : null;

    /// <summary>Der Filter des Dateiwählers: der der gewählten Quelle, sonst der des Profils (alle Formate).</summary>
    private string WirksamerFilter
        => Quellenliste.FirstOrDefault(q => string.Equals(q.Schluessel, _quelle, StringComparison.Ordinal))?.Dateifilter
           ?? Profil?.Dateifilter ?? "";

    /// <summary>
    /// <b>Der Weg „nur Projektdatei“</b>: die gelesene Datei ist eine <c>.sqproj</c> — erkannt am Weg des Kopfs, gleich ob
    /// über die Quellenwahl oder über „alle Formate“ gewählt.
    /// </summary>
    public bool NurProjektdatei => _lesestand?.Kopf?.Weg == GebaeudeImportWeg.NurProjektdatei;

    /// <summary>Der Weg der gewählten Quelle; ohne Wahl der einer Gebäudedatei.</summary>
    private GebaeudeImportWeg GewaehlterWeg
        => Quellenliste.FirstOrDefault(q => string.Equals(q.Schluessel, _quelle, StringComparison.Ordinal))?.Weg ?? GebaeudeImportWeg.Datei;

    /// <summary>Der Weg des gelesenen Laufs (<c>data-quelle</c> der Quellzeile): mit dazugeladener Projektdatei „MitProjektdatei“.</summary>
    public GebaeudeImportWeg GelesenerWeg
        => NurProjektdatei ? GebaeudeImportWeg.NurProjektdatei
         : _stand?.Projektdatei is { Gelesen: true } ? GebaeudeImportWeg.MitProjektdatei
         : GebaeudeImportWeg.Datei;

    /// <summary>Der Text der Quellzeile: das Format der Datei, nach dem Dazuladen „… + Projektdatei“.</summary>
    private string Quellentext(GebaeudeImportKopf kopf, GebaeudeImportStand stand)
        => GelesenerWeg == GebaeudeImportWeg.MitProjektdatei ? Format(Texte.QuelleMitProjektdatei, kopf.Format) : kopf.Format;

    /// <summary>Im Weg „nur Projektdatei“: Räume, die keine Zone aufnimmt, weil ihre Beheizung offen ist.</summary>
    private bool UnbeheizteOffen
        => NurProjektdatei && Plan is { } p && p.NichtZugeordnet.Any(r => !r.Beheizt || !r.BeheiztLautDatei);

    private IReadOnlyList<(int Id, string Text)> Klassenliste
        => Baualtersklassen.Select((text, index) => (index, text)).ToList();

    private IReadOnlyList<(int Id, string Text)> Gebaeudeliste
        => (_lesestand?.Gebaeude ?? Array.Empty<string>()).Select((text, index) => (index, text)).ToList();

    /// <summary>Der Grund der weichen Sperre von OK — vor dem Lesen und ohne Schreibdelegat.</summary>
    private string? OkSperrgrund
        => Beschaeftigt ? null
         : _stand is null ? Texte.OkOhneDatei
         : Uebernehmen is null ? Texte.OkOhneWeg
         : NichtZugeordnet > 0 ? Format(Texte.PlanOkGesperrt, NichtZugeordnet)
         : null;

    private Func<string, Task<string?>>? Waehler => DateiWaehlen is null ? null : WaehlenUndPruefen;

    private EventCallback AbbrechenCallback => EventCallback.Factory.Create(this, () => _abbruch?.Cancel());

    // =====================================================================
    // Aufbau
    // =====================================================================

    protected override void OnInitialized()
    {
        _klasse = GueltigeKlasse(BaualtersklasseVorgabe);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_baustoffzielNeu)
        {
            _baustoffzielNeu = false;
            // Rollen gewollt: der Sprung aus Steckbrief oder Aufbauliste führt zur Zeile des Materialnamens.
            try { await _baustoffmarke.FocusAsync(preventScroll: false); }
            catch (Exception) { /* die Zeile ist nicht (mehr) gezeichnet */ }
        }
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    private int? GueltigeKlasse(int? index)
        => index is int i && i >= 0 && i < Baualtersklassen.Count ? i : null;

    // =====================================================================
    // Quelle und Lesen
    // =====================================================================

    /// <summary>
    /// Der Wähler hinter dem Baustein <c>Dateiwahl</c>: Die Hülle wählt und prüft die Größe; eine
    /// Ablehnung steht VOR dem Lesen als Warnbanner der Stufe Fehler, und es wird nicht gelesen.
    /// Zurück an die Dateiwahl geht nur der Dateiname — der Pfad bleibt hier.
    /// </summary>
    private async Task<string?> WaehlenUndPruefen(string filter)
    {
        if (DateiWaehlen is null || Beschaeftigt) return null;
        GebaeudeDateiwahl? wahl = await DateiWaehlen(filter);
        if (wahl is null) return null;                    // abgebrochen: nichts geschieht
        if (wahl.Ablehnung is not null)
        {
            // Das Ereignis gehört dem Baustein Dateiwahl, nicht diesem Dialog — gezeichnet wird
            // das Banner deshalb ausdrücklich.
            Melden(wahl.Ablehnung, WarnStufe.Fehler);
            StateHasChanged();
            return null;
        }
        if (string.IsNullOrEmpty(wahl.Pfad)) return null;
        _pfad = wahl.Pfad;
        return string.IsNullOrEmpty(wahl.Dateiname) ? wahl.Pfad : wahl.Dateiname;
    }

    private Task BeiDatei(string anzeige)
    {
        _dateianzeige = anzeige ?? "";
        return string.IsNullOrEmpty(_pfad) ? Task.CompletedTask : Einlesen(_pfad);
    }

    /// <summary>Eine neue Datei ist ein neuer Kontext: Stand, Haken und Handänderungen fallen weg.</summary>
    private async Task Einlesen(string pfad)
    {
        if (Lesen is null || Beschaeftigt) return;

        _laeuft = true;
        _anteil = null;
        _fortschrittText = "";
        _meldung = "";
        _lesestand = null;
        _nord = null;
        _stand = null;
        _zeilen = new List<GebaeudeFeldzeileDaten>();
        _gebaeudeIndex = 0;
        _uebersteuert.Clear();
        _handwerte.Clear();
        _handhaken.Clear();
        _baustoffzuordnungen.Clear();
        _alsZoneWahl = null;
        _cadSollwert = false;
        ZonenZuruecksetzen();
        _name = "";
        _nameGeaendert = false;
        _abbruch = new CancellationTokenSource();

        try
        {
            var melder = new Progress<GebaeudeImportFortschritt>(f =>
            {
                _anteil = f.Anteil;
                _fortschrittText = f.Text ?? "";
                InvokeAsync(StateHasChanged);
            });

            GebaeudeLesestand stand = await Lesen(pfad, melder, _abbruch.Token);
            if (stand.Gelesen && stand.Gebaeude.Count > 0)
            {
                _lesestand = stand;
                NeuZuordnen();
                _nord = NordrichtungDaten?.Invoke();
            }
            else
            {
                string text = string.Join(Environment.NewLine, stand.Meldungen.Select(m => m.Text));
                Melden(text.Length > 0 ? text : Texte.NichtGelesen, WarnStufe.Fehler);
            }
        }
        catch (OperationCanceledException)
        {
            // Der Anwender hat abgebrochen — still, nichts gelesen, nichts geschrieben.
        }
        finally
        {
            _laeuft = false;
            _anteil = null;
            _fortschrittText = "";
            _abbruch?.Dispose();
            _abbruch = null;
        }
        await NachDemLesen();
    }

    /// <summary>
    /// Die Quelle nach dem Lesen (16.1): Eine <c>.sqproj</c> ist der Weg „nur Projektdatei“ — die Wahl folgt der Endung, und die
    /// Zonen der Datei gehen gleich als Schritt in den Plan. Beim Weg „Gebäudedatei + Projektdatei“ öffnet sich danach die Wahl
    /// der Projektdatei; ist sie für diese Datei nicht möglich, nennt eine Meldung den Grund des gesperrten Knopfs.
    /// </summary>
    private async Task NachDemLesen()
    {
        if (_lesestand is null || _stand is null) return;
        if (NurProjektdatei)
        {
            _quelle = Quellenliste.FirstOrDefault(q => q.Weg == GebaeudeImportWeg.NurProjektdatei)?.Schluessel;
            if (_stand.Projektdatei is { Gelesen: true } && Plan is not null && _planschritte.Count == 0) ZonenDerProjektdatei();
            return;
        }
        if (GewaehlterWeg == GebaeudeImportWeg.NurProjektdatei) _quelle = null;
        if (GewaehlterWeg != GebaeudeImportWeg.MitProjektdatei || ProjektdateiLesen is null) return;
        if (_stand.ProjektdateiMoeglich) await BeiProjektdatei();
        else Melden(Texte.SqKnopfGrund, WarnStufe.Hinweis);
    }

    /// <summary>
    /// G5-N (N2): <b>Eine neue Richtung der Planoberseite</b> — die Hülle liest die Datei damit neu (Ladezustand wie beim
    /// Lesen, Esc bricht ab), danach wird neu zugeordnet: Bauteilliste, Ansicht und Meldungen folgen. Gebäudewahl, Klasse,
    /// Raumhaken und Handänderungen bleiben — es ist dieselbe Datei.
    /// </summary>
    private async Task BeiNordrichtung(double planoberseite)
    {
        if (NordrichtungSetzen is null || _lesestand is null || Beschaeftigt) return;
        _laeuft = true;
        _anteil = null;
        _fortschrittText = Texte.NordrichtungLaeuft;
        _meldung = "";
        _abbruch = new CancellationTokenSource();
        try
        {
            GebaeudeLesestand stand = await NordrichtungSetzen(planoberseite, _abbruch.Token);
            if (stand.Gelesen && stand.Gebaeude.Count > 0)
            {
                _lesestand = stand;
                if (_gebaeudeIndex >= stand.Gebaeude.Count) _gebaeudeIndex = 0;
            }
            else
            {
                string text = string.Join(Environment.NewLine, stand.Meldungen.Select(m => m.Text));
                Melden(text.Length > 0 ? text : Texte.NichtGelesen, WarnStufe.Fehler);
            }
        }
        catch (OperationCanceledException)
        {
            // Abgebrochen: Es gilt, was die Hülle danach führt - unten neu gefragt.
        }
        finally
        {
            _laeuft = false;
            _anteil = null;
            _fortschrittText = "";
            _abbruch?.Dispose();
            _abbruch = null;
        }
        string meldung = _meldung;
        WarnStufe stufe = _meldungStufe;
        NeuZuordnen();
        if (meldung.Length > 0 && _meldung.Length == 0) Melden(meldung, stufe);
        _nord = NordrichtungDaten?.Invoke();
    }

    // =====================================================================
    // Zuordnen — Klasse, Gebäude, Raumhaken; Handänderungen bleiben
    // =====================================================================

    private void NeuZuordnen()
    {
        if (Zuordnen is null || _lesestand is null) return;
        _konflikt = null;
        _notiz = "";
        StandUebernehmen(Zuordnen(Anfrage()));
    }

    /// <summary>Die Anfrage des Arbeitsstands — samt den Zuordnungen von Hand in ihrer Reihenfolge.</summary>
    private GebaeudeZuordnungsanfrage Anfrage()
        => new(_gebaeudeIndex, _klasse, new Dictionary<string, bool>(_uebersteuert, StringComparer.Ordinal),
               new Dictionary<string, double?>(_handwerte, StringComparer.Ordinal),
               new Dictionary<string, int?>(_baustoffzuordnungen, StringComparer.Ordinal),
               _regel, null, CadSollwertWirksam,
               _planschritte.Count > 0 ? _planschritte.ToList() : null, _planschritte.Count > 0 ? _plangrundhaken : null,
               _typwahl.Count > 0 ? new Dictionary<string, string>(_typwahl, StringComparer.Ordinal) : null);

    private void StandUebernehmen(GebaeudeImportStand stand)
    {
        _stand = stand;
        _zeilen = stand.Zeilen.Select(z => MitHandaenderungen(z, stand.ManuellHerkunftText)).ToList();
        if (!_nameGeaendert) _name = stand.Vorschlagsname ?? "";
        FlaechenFiltern();
    }

    // =====================================================================
    // Mehrere Zonen — Regel, Zonen, Flächen (Stufe G6c)
    // =====================================================================

    /// <summary>Ein neuer Kontext (Datei, Gebäude): Regel, Aufklappen, Filter und Wahl der Flächen- und der Bauteilliste auf Anfang.</summary>
    private void ZonenZuruecksetzen()
    {
        _regel = null;
        _offeneZonen.Clear();
        PlanZuruecksetzen();
        _konflikt = null;
        _notiz = "";
        _regelFrage = null;
        _ziel = null;
        _geschoss = null;
        _raumwahl = null;
        _nurFehler = _nurOhneGegenstueck = _nurOhneUWert = _nurBauteilbefund = false;
        _flaechenfilter = new Katalogfilterstand();
        _flaecheGewaehlt = "";
        _flaechenzeilen = Array.Empty<Katalogfilterzeile>();
        _bauteilfilter = new Katalogfilterstand();
        _bauteilGewaehlt = "";
    }

    /// <summary>Der Zonenplan auf Anfang: keine Schritte, keine Wahl, keine offene Zeile, keine Frage.</summary>
    private void PlanZuruecksetzen()
    {
        _planschritte.Clear();
        _plangrundhaken = null;
        _zonenwahl.Clear();
        _raumwahlen.Clear();
        _neueZone = false;
        _plangeschoss = _restregel = null;
        _aufhebenFrage = false;
        _sqFrage = false;
        _sqZonierungFrage = false;
        _planhinweis = null;
    }

    private static IReadOnlyList<(int Id, string Text)> Regelliste(GebaeudeZonierungDaten zon)
        => zon.Regeln.Select((r, i) => (i, r.Text)).ToList();

    private static int? Regelstelle(GebaeudeZonierungDaten zon)
    {
        for (int i = 0; i < zon.Regeln.Count; i++)
            if (string.Equals(zon.Regeln[i].Schluessel, zon.Regel, StringComparison.Ordinal)) return i;
        return null;
    }

    /// <summary>Eine andere Regel: Der Vorschlag wird neu gebildet; Raumhaken, Handwerte und Baustoffe bleiben.</summary>
    private void BeiRegel(int? index)
    {
        if (_stand?.Zonierung is not GebaeudeZonierungDaten zon || index is not int i || i < 0 || i >= zon.Regeln.Count) return;
        RegelWaehlen(zon.Regeln[i].Schluessel);
    }

    /// <summary>Der Knopf über der Obergrenze: die vorgeschlagene gröbere Regel.</summary>
    private void BeiGroeber()
    {
        if (Beschaeftigt || _stand?.Zonierung?.Vorschlagsregel is not string regel) return;
        RegelWaehlen(regel);
    }

    /// <summary>
    /// Eine andere Regel — mit Zuordnungen von Hand erst nach Rückfrage: Sie gelten nur unter der gebildeten Regel
    /// (ihre Zielzonen tragen deren Schlüssel) und gehen mit dem Wechsel verloren.
    /// </summary>
    private void RegelWaehlen(string regel)
    {
        if (string.Equals(regel, _stand?.Zonierung?.Regel, StringComparison.Ordinal)) return;
        if (_planschritte.Count > 0)
        {
            _regelFrage = regel;
            return;
        }
        RegelSetzen(regel);
    }

    private void RegelSetzen(string regel)
    {
        _regel = regel;
        PlanZuruecksetzen();
        _ziel = null;
        _offeneZonen.Clear();
        _meldung = "";
        NeuZuordnen();
    }

    /// <summary>Die Antwort der Rückfrage: „Ja" wechselt und verwirft die Zuordnungen von Hand, „Nein" und Esc lassen alles, wie es ist.</summary>
    private void RegelBeantwortet(bool? antwort)
    {
        string? regel = _regelFrage;
        _regelFrage = null;
        if (antwort == true && regel is not null) RegelSetzen(regel);
        else _regelwahlFassung++;
    }

    // =====================================================================
    // Grundriss und Zuordnung von Hand (Stufe G6c, Welle D2)
    // =====================================================================

    /// <summary>
    /// Der Grundriss samt Zuordnung von Hand: die Zielzone im Kopf, die Ansicht, die Meldung einer abgelehnten
    /// Zuordnung mit dem Ausweg bei ungleicher Beheizung, die abgelehnten Zuordnungen des Stands und der Weg ohne
    /// Grundriss (Raum und „Umhängen"). Ohne Umhängbarkeit nur die Ansicht.
    /// </summary>
    private RenderFragment Grundriss(GebaeudeImportStand stand, GebaeudeAnsichtDaten ansicht) => __builder =>
    {
        bool zuordnen = ansicht.Umhaengbar;
        if (zuordnen)
        {
            <div class="epos-gebimport-zuordnungskopf">
                <Auswahlfeld Bezeichnung="@Texte.ZuordnenZu" Eintraege="@Zielliste(ansicht)" Auswahl="@Zielstelle(ansicht)"
                             AuswahlChanged="BeiZiel" Aktiv="@(!Beschaeftigt)" />
            </div>
        }
        <GebaeudeAnsicht Daten="@ansicht" GewaehlteZone="@Zielzone(ansicht)" Geschoss="@_geschoss" GeschossChanged="BeiGeschoss"
                         RaumUmgehaengt="BeiUmhaengen" ZoneGewaehlt="BeiZoneGewaehlt" Aktiv="@(!Beschaeftigt)" Texte="@Texte.Ansicht"
                         ZurBaustoffzuordnung="BeiBaustoffsprung" />
        if (_konflikt is Umhaengkonflikt k && stand.Zonierung?.Plan is null)
        {
            @Konfliktbanner(k)
        }
        if (_notiz.Length > 0)
        {
            <p class="epos-leisezeile epos-gebimport-umhaengnotiz" role="status">@_notiz</p>
        }
        if (stand.Zonierung is { Ablehnungen.Count: > 0 } zon)
        {
            <ul class="epos-gebimport-ablehnungen">
                @foreach (GebaeudeImportMeldung m in zon.Ablehnungen)
                {
                    <li data-kennung="@m.Kennung">@m.Text</li>
                }
            </ul>
        }
        if (zuordnen)
        {
            <div class="epos-gebimport-raumweg">
                <Auswahlfeld Bezeichnung="@Texte.Raumwahl" Eintraege="@Raumliste(ansicht)" Auswahl="@Raumstelle(ansicht)"
                             AuswahlChanged="BeiRaumwahl" Aktiv="@(!Beschaeftigt)" />
                <button type="button" class="epos-knopf epos-gebimport-umhaengen" disabled="@Beschaeftigt"
                        @onclick="BeiUmhaengenKnopf">@Texte.Umhaengen</button>
            </div>
            <Herleitungszeile Text="@Texte.UmhaengenHinweis" />
        }
    };

    /// <summary>Die abgelehnte Zuordnung mit der Meldung des Kerns — bei ungleicher Beheizung samt Raumhaken als Ausweg.</summary>
    private RenderFragment Konfliktbanner(Umhaengkonflikt k) => __builder =>
    {
        <div class="epos-gebimport-ausweg" data-raum="@k.Raum" data-kennung="@k.Kennung">
            <Warnbanner Stufe="WarnStufe.Warnung" Text="@k.Text" />
            @if (k.Beheizung)
            {
                <Schalter Bezeichnung="@Format(Texte.BeheiztTitel, k.Name)" Wert="@k.RaumBeheizt"
                          WertChanged="BeiAusweg" Aktiv="@(!Beschaeftigt)" />
                <Herleitungszeile Text="@Format(Texte.Ausweg, k.Name, k.Zielname)" />
            }
        </div>
    };

    /// <summary>Der Zonenplan des Stands; <c>null</c> = keiner (eine Regel oder abgelehnt).</summary>
    private GebaeudeZonenplanDaten? Plan => _stand?.Zonierung?.Plan;

    /// <summary>
    /// Die Zielzone eines Klicks im Plan (Planschlüssel): die gewählte, sonst die erste Zone; <see cref="EIGENE_ZONE"/> = als
    /// eigene Zone abtrennen; <c>null</c> ohne Zone.
    /// </summary>
    private string? PlanZiel()
    {
        if (Plan is not GebaeudeZonenplanDaten plan) return null;
        if (_ziel == EIGENE_ZONE) return EIGENE_ZONE;
        if (_ziel is not null && plan.Zonen.Any(z => z.Schluessel == _ziel)) return _ziel;
        return plan.Zonen.Count > 0 ? plan.Zonen[0].Schluessel : EIGENE_ZONE;
    }

    /// <summary>Die Zielzone für den Grundriss — der Schlüssel, unter dem er die Zielzone des Plans führt; <c>null</c> = keine.</summary>
    private string? Zielzone(GebaeudeAnsichtDaten ansicht)
    {
        string? ziel = PlanZiel();
        GebaeudePlanzoneDaten? zone = Plan?.Zonen.FirstOrDefault(z => z.Schluessel == ziel);
        return zone is { Ansichtsschluessel.Length: > 0 } ? zone.Ansichtsschluessel : null;
    }

    /// <summary>Die Einträge der Zielzone: die Zonen des Plans (Id = Stelle + 1), dann „als eigene Zone" (Id 0).</summary>
    private IReadOnlyList<(int Id, string Text)> Zielliste(GebaeudeAnsichtDaten ansicht)
    {
        IReadOnlyList<GebaeudePlanzoneDaten> zonen = Plan?.Zonen ?? Array.Empty<GebaeudePlanzoneDaten>();
        var liste = new List<(int Id, string Text)>(zonen.Count + 1);
        for (int i = 0; i < zonen.Count; i++) liste.Add((i + 1, zonen[i].Name));
        liste.Add((0, Texte.EigeneZone));
        return liste;
    }

    private int? Zielstelle(GebaeudeAnsichtDaten ansicht)
    {
        string? ziel = PlanZiel();
        if (ziel == EIGENE_ZONE) return 0;
        IReadOnlyList<GebaeudePlanzoneDaten> zonen = Plan?.Zonen ?? Array.Empty<GebaeudePlanzoneDaten>();
        for (int i = 0; i < zonen.Count; i++)
            if (zonen[i].Schluessel == ziel) return i + 1;
        return null;
    }

    private void BeiZiel(int? id)
    {
        if (Plan is not GebaeudeZonenplanDaten plan || id is not int i) return;
        if (i == 0) _ziel = EIGENE_ZONE;
        else if (i - 1 < plan.Zonen.Count) _ziel = plan.Zonen[i - 1].Schluessel;
        _konflikt = null;
        _notiz = "";
    }

    private void BeiGeschoss(string kennung) => _geschoss = kennung;

    /// <summary>Ein Klick auf einen Körper der Ansicht wählt die Zone des Plans, die er zeigt, als Ziel der Zuordnung.</summary>
    private void BeiZoneGewaehlt(string schluessel)
    {
        if (_stand?.Ansicht is not { Umhaengbar: true } || Plan?.Zonen.FirstOrDefault(z => z.Ansichtsschluessel == schluessel) is not { } zone) return;
        _ziel = zone.Schluessel;
        _konflikt = null;
        _notiz = "";
    }

    /// <summary>Der gewählte Raum des Wegs ohne Grundriss — im gezeigten Geschoss, sonst dessen erster.</summary>
    private GebaeudeAnsichtRaum? GewaehlterRaum(GebaeudeAnsichtDaten ansicht)
    {
        if (ansicht.GeschossOderVorgabe(_geschoss) is not GebaeudeAnsichtGeschoss g || g.Raeume.Count == 0) return null;
        foreach (GebaeudeAnsichtRaum r in g.Raeume)
            if (string.Equals(r.Kennung, _raumwahl, StringComparison.Ordinal)) return r;
        return g.Raeume[0];
    }

    /// <summary>Die Räume des gezeigten Geschosses (Id = Stelle im Geschoss) — mit Zone und, wo er fehlt, „ohne Umriss".</summary>
    private IReadOnlyList<(int Id, string Text)> Raumliste(GebaeudeAnsichtDaten ansicht)
    {
        if (ansicht.GeschossOderVorgabe(_geschoss) is not GebaeudeAnsichtGeschoss g) return Array.Empty<(int, string)>();
        var liste = new List<(int Id, string Text)>(g.Raeume.Count);
        for (int i = 0; i < g.Raeume.Count; i++)
        {
            GebaeudeAnsichtRaum r = g.Raeume[i];
            string zone = ansicht.Zone(r.Zone)?.Name ?? Texte.Ansicht.OhneZone;
            liste.Add((i, r.Name + " – " + zone + (r.Polygone.Count == 0 ? " " + Texte.OhneUmriss : "")));
        }
        return liste;
    }

    private int? Raumstelle(GebaeudeAnsichtDaten ansicht)
    {
        if (ansicht.GeschossOderVorgabe(_geschoss) is not GebaeudeAnsichtGeschoss g || GewaehlterRaum(ansicht) is not GebaeudeAnsichtRaum r)
            return null;
        for (int i = 0; i < g.Raeume.Count; i++)
            if (ReferenceEquals(g.Raeume[i], r)) return i;
        return null;
    }

    private void BeiRaumwahl(int? id)
    {
        if (_stand?.Ansicht?.GeschossOderVorgabe(_geschoss) is not GebaeudeAnsichtGeschoss g || id is not int i
            || i < 0 || i >= g.Raeume.Count) return;
        _raumwahl = g.Raeume[i].Kennung;
    }

    /// <summary>Der Klick im Grundriss: der Raum in die Zielzone des Plans.</summary>
    private void BeiUmhaengen(GebaeudeRaumumhaengung wunsch) => Umhaengen(wunsch.Raum);

    /// <summary>„Umhängen" — der Weg ohne Grundriss: der gewählte Raum in die Zielzone des Kopfs.</summary>
    private void BeiUmhaengenKnopf()
    {
        if (_stand?.Ansicht is not { Umhaengbar: true } ansicht || GewaehlterRaum(ansicht) is not GebaeudeAnsichtRaum raum) return;
        Umhaengen(raum.Kennung);
    }

    /// <summary>
    /// <b>Eine Zuordnung im Grundriss</b> ist ein Schritt am Zonenplan: der Raum in die Zielzone (<c>ZUORDNEN</c>) oder als eigene
    /// Zone (<c>EIGENE</c>). Lehnt der Kern ab, steht seine Meldung im Zonenbaum — bei ungleicher Beheizung samt dem Raumhaken
    /// als Ausweg. Eine Zuordnung ohne Wirkung („liegt schon dort") fragt den Kern nicht.
    /// </summary>
    private void Umhaengen(string kennung)
    {
        if (Beschaeftigt || _stand?.Ansicht is not { Umhaengbar: true } ansicht || Plan is not GebaeudeZonenplanDaten plan) return;
        if (ansicht.Raum(kennung) is not GebaeudeAnsichtRaum raum) return;
        _konflikt = null;
        _notiz = "";
        string? ziel = PlanZiel();
        if (ziel is null) return;
        if (ziel == EIGENE_ZONE)
        {
            Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.EIGENE, new[] { raum.Kennung }));
            return;
        }
        GebaeudePlanzoneDaten? zone = plan.Zonen.FirstOrDefault(z => z.Schluessel == ziel);
        if (zone is not null && zone.Raumliste.Any(r => r.Kennung == raum.Kennung))
        {
            _notiz = Format(Texte.SchonDort, raum.Name, zone.Name);
            return;
        }
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.ZUORDNEN, new[] { raum.Kennung }, ziel));
    }

    // =====================================================================
    // Der Zonenbaum — Schritte am Zonenplan (Mehrzonenkonzept 6.4)
    // =====================================================================

    /// <summary>
    /// <b>Ein Schritt am Zonenplan</b>: Die Anfrage bekommt ihn hinter die bisherigen, der Kern legt alle auf den Regelvorschlag
    /// und bildet Zonen, Bilanz, Vorschlag und Grundriss neu. Lehnt er ab, fällt der Schritt wieder heraus, der Stand ist der
    /// ohne ihn, und die Meldung des Kerns steht als Banner. Ein angenommener Schritt mit Hinweis (etwa Räume anderer
    /// Beheizung, die bleiben, wo sie sind) zeigt ihn. Vor dem ersten Schritt merkt sich der Dialog die Haken des Plans.
    /// </summary>
    private bool Schritt(GebaeudePlanschritt schritt)
    {
        if (Beschaeftigt || Zuordnen is null || _lesestand is null) return false;
        _meldung = "";
        _konflikt = null;
        _notiz = "";
        _planhinweis = null;
        GebaeudeZonenplanDaten? vorher = Plan;
        bool erster = _planschritte.Count == 0;
        if (erster) _plangrundhaken = new Dictionary<string, bool>(_uebersteuert, StringComparer.Ordinal);
        _planschritte.Add(schritt);
        GebaeudeImportStand neu = Zuordnen(Anfrage());
        GebaeudeZonenplanDaten? plan = neu.Zonierung?.Plan;
        if (plan is { LetzterAbgelehnt: true })
        {
            _planschritte.RemoveAt(_planschritte.Count - 1);
            if (erster) _plangrundhaken = null;
            StandUebernehmen(Zuordnen(Anfrage()));
            _planfassung++;
            if (plan.Schrittmeldung is GebaeudeImportMeldung grund) _konflikt = Konflikt(schritt, grund, vorher);
            return false;
        }
        StandUebernehmen(neu);
        _planhinweis = plan?.Schrittmeldung;
        if (plan is not null)
        {
            _zonenwahl.RemoveWhere(z => plan.Zonen.All(x => x.Schluessel != z));
            if (_ziel is not null && _ziel != EIGENE_ZONE && plan.Zonen.All(x => x.Schluessel != _ziel)) _ziel = null;
        }
        return true;
    }

    /// <summary>
    /// Die Ablehnung eines Schritts als Banner. Bei ungleicher Beheizung (Zuordnen) nennt sie den ersten Raum, der nicht zur
    /// Zielzone passt, und bietet seinen Haken „beheizt" als Ausweg an; stellt der Anwender ihn um, folgt der Schritt.
    /// </summary>
    private Umhaengkonflikt Konflikt(GebaeudePlanschritt schritt, GebaeudeImportMeldung grund, GebaeudeZonenplanDaten? plan)
    {
        string kennung = grund.Kennung ?? "";
        bool beheizung = kennung.EndsWith("_PLAN_BEHEIZUNG", StringComparison.Ordinal)
                         && schritt.Art == GebaeudePlanschrittArt.ZUORDNEN && plan is not null;
        if (beheizung)
        {
            var alle = plan!.Zonen.SelectMany(z => z.Raumliste).Concat(plan.NichtZugeordnet).ToList();
            List<GebaeudePlanraumDaten> wahl = (schritt.Raeume ?? Array.Empty<string>())
                .Select(k => alle.FirstOrDefault(r => r.Kennung == k)).OfType<GebaeudePlanraumDaten>().ToList();
            GebaeudePlanzoneDaten? ziel = plan.Zonen.FirstOrDefault(z => z.Schluessel == schritt.Zone);
            var bleibende = ziel?.Raumliste.Where(r => wahl.All(w => w.Kennung != r.Kennung)).ToList() ?? new List<GebaeudePlanraumDaten>();
            bool warm = bleibende.Count > 0 ? bleibende.Any(r => r.Beheizt) : wahl.Count > 0 && wahl[0].Beheizt;
            if (wahl.FirstOrDefault(r => r.Beheizt != warm) is GebaeudePlanraumDaten anders)
                return new Umhaengkonflikt(anders.Kennung, anders.Name, schritt.Zone, ziel?.Name ?? "", grund.Text, grund.Kennung,
                                           true, anders.Beheizt, warm, schritt);
        }
        return new Umhaengkonflikt("", "", schritt.Zone, "", grund.Text, grund.Kennung, false, false, false, schritt);
    }

    /// <summary>
    /// Der Ausweg bei ungleicher Beheizung: der Raumhaken „beheizt" — umgestellt vom Anwender, nie still. Passt die
    /// Beheizung danach zur Zielzone, folgt der Schritt, den er verlangt hatte.
    /// </summary>
    private void BeiAusweg(bool beheizt)
    {
        if (Beschaeftigt || _konflikt is not Umhaengkonflikt k) return;
        HakenAendern(k.Raum, beheizt);
        _meldung = "";
        NeuZuordnen();
        if (beheizt == k.ZielBeheizt && k.Schritt is not null) Schritt(k.Schritt);
    }

    /// <summary>
    /// Ein Raumhaken „beheizt": wie die Raumliste, und — sobald der Plan Schritte trägt — zugleich als Schritt am Plan, damit
    /// Zonen und Schlüssel stehen bleiben (der Raum bleibt in seiner Zone).
    /// </summary>
    private void HakenAendern(string raum, bool beheizt)
    {
        RaumhakenSetzen(raum, beheizt);
        if (_planschritte.Count > 0)
            _planschritte.Add(new GebaeudePlanschritt(GebaeudePlanschrittArt.HAKEN, new[] { raum }, Beheizt: beheizt));
    }

    private void BeiAufklappen(string schluessel)
    {
        if (!_offeneZonen.Remove(schluessel)) _offeneZonen.Add(schluessel);
    }

    /// <summary>Der Haken „beheizt" einer Zone: alle ihre Räume umgestellt, danach bildet sich die Zonierung neu.</summary>
    private void BeiZoneBeheizt(GebaeudePlanzoneDaten zone, bool beheizt)
    {
        foreach (GebaeudePlanraumDaten raum in zone.Raumliste) HakenAendern(raum.Kennung, beheizt);
        _meldung = "";
        NeuZuordnen();
    }

    private void BeiZonenwahl(GebaeudePlanzoneDaten zone, ChangeEventArgs e)
    {
        if (e.Value is true) _zonenwahl.Add(zone.Schluessel);
        else _zonenwahl.Remove(zone.Schluessel);
        if (_zonenwahl.Count == 1) _ziel = _zonenwahl.First();
    }

    private void BeiRaumwahlHaken(string kennung, ChangeEventArgs e)
    {
        if (e.Value is true) _raumwahlen.Add(kennung);
        else _raumwahlen.Remove(kennung);
    }

    /// <summary>Die gewählten Zonen in Planreihenfolge.</summary>
    private IReadOnlyList<string> GewaehlteZonen(GebaeudeZonenplanDaten plan)
        => plan.Zonen.Where(z => _zonenwahl.Contains(z.Schluessel)).Select(z => z.Schluessel).ToList();

    /// <summary>Die gewählten Räume aus Baum und rechter Liste, in Planreihenfolge.</summary>
    private IReadOnlyList<string> GewaehlteRaeume(GebaeudeZonenplanDaten plan)
        => plan.Zonen.SelectMany(z => z.Raumliste).Concat(plan.NichtZugeordnet)
               .Where(r => _raumwahlen.Contains(r.Kennung)).Select(r => r.Kennung).Distinct().ToList();

    /// <summary>Die Zielzone der Knöpfe: genau eine gewählte Zone; sonst keine.</summary>
    private string? Zielzone(GebaeudeZonenplanDaten plan)
    {
        IReadOnlyList<string> zonen = GewaehlteZonen(plan);
        return zonen.Count == 1 ? zonen[0] : null;
    }

    private static IReadOnlyList<(int Id, string Text)> Nutzungsliste(GebaeudeZonenplanDaten plan)
        => plan.Nutzungen.Select((n, i) => (i, n.Text)).ToList();

    /// <summary>Die Stelle der gewählten Nutzung in der Liste des Plans; <c>null</c> = keine oder nicht mehr darin.</summary>
    private int? NeuNutzungStelle(GebaeudeZonenplanDaten plan)
    {
        for (int i = 0; i < plan.Nutzungen.Count; i++)
            if (string.Equals(plan.Nutzungen[i].Schluessel, _neuNutzung, StringComparison.Ordinal)) return i;
        return null;
    }

    private void NeuNutzungWaehlen(GebaeudeZonenplanDaten plan, int? stelle)
        => _neuNutzung = stelle is int i && i >= 0 && i < plan.Nutzungen.Count ? plan.Nutzungen[i].Schluessel : null;

    /// <summary>„Zone hinzufügen": öffnet die Zeile mit Name (Vorgabe „Zone n") und Nutzung.</summary>
    private void BeiZoneHinzufuegen(GebaeudeZonenplanDaten plan)
    {
        _neueZone = true;
        _neuName = plan.NeuerName;
        _neuNutzung = null;
    }

    private void BeiAnlegen(GebaeudeZonenplanDaten plan)
    {
        string? nutzung = NeuNutzungStelle(plan) is int i ? plan.Nutzungen[i].Schluessel : null;
        if (Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.ANLEGEN, Name: _neuName, Nutzung: nutzung))) _neueZone = false;
    }

    /// <summary>„Zone(n) löschen": die gewählten Zonen; ihre Räume stehen danach rechts.</summary>
    private void BeiLoeschen(GebaeudeZonenplanDaten plan)
    {
        IReadOnlyList<string> zonen = GewaehlteZonen(plan);
        if (zonen.Count == 0) return;
        if (Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.LOESCHEN, Zonen: zonen))) _zonenwahl.Clear();
    }

    /// <summary>Die Antwort der Rückfrage „Zonierung aufheben": nur „Ja" hebt auf.</summary>
    private void AufhebenBeantwortet(bool? antwort)
    {
        _aufhebenFrage = false;
        if (antwort == true) Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.AUFHEBEN));
    }

    /// <summary>„Räume zur ausgewählten Zone hinzufügen": die gewählten Räume — alle oder keiner.</summary>
    private void BeiRaeumeZuordnen(GebaeudeZonenplanDaten plan)
    {
        if (Zielzone(plan) is not string ziel) return;
        IReadOnlyList<string> raeume = GewaehlteRaeume(plan);
        if (raeume.Count == 0) return;
        if (Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.ZUORDNEN, raeume, ziel))) _raumwahlen.Clear();
    }

    private static IReadOnlyList<(int Id, string Text)> Geschossliste(GebaeudeZonenplanDaten plan)
        => plan.Geschosse.Select((g, i) => (i, g.Text)).ToList();

    private int? Geschossstelle(GebaeudeZonenplanDaten plan)
        => _plangeschoss is int i && i >= 0 && i < plan.Geschosse.Count ? i : plan.Geschosse.Count > 0 ? 0 : null;

    /// <summary>„Geschoss zur Zone": die gleich beheizten Räume des Geschosses in die gewählte Zone.</summary>
    private void BeiGeschossZuordnen(GebaeudeZonenplanDaten plan)
    {
        if (Zielzone(plan) is not string ziel || Geschossstelle(plan) is not int i) return;
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.GESCHOSS, Zone: ziel, Geschoss: plan.Geschosse[i].Schluessel));
    }

    private int? Reststelle(GebaeudeZonierungDaten zon)
        => _restregel is int i && i >= 0 && i < zon.Regeln.Count ? i : Regelstelle(zon);

    /// <summary>„Rest nach Regel zuordnen": nur die nicht zugeordneten Räume, nach der gewählten Regel.</summary>
    private void BeiRest(GebaeudeZonierungDaten zon)
    {
        if (Reststelle(zon) is not int i) return;
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.REST, Regel: zon.Regeln[i].Schluessel));
    }

    /// <summary>Der Name einer Zone im Baum — leer oder doppelt lehnt der Kern ab.</summary>
    private void BeiUmbenennen(GebaeudePlanzoneDaten zone, ChangeEventArgs e)
    {
        string name = e.Value?.ToString() ?? "";
        if (name == zone.Name) return;
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.UMBENENNEN, Zone: zone.Schluessel, Name: name));
    }

    /// <summary>Die Nutzung einer Zone (Wohnen, Büro, Schule oder keine).</summary>
    private void BeiNutzung(GebaeudePlanzoneDaten zone, ChangeEventArgs e)
    {
        string? nutzung = e.Value?.ToString() is { Length: > 0 } n ? n : null;
        if (nutzung == zone.Nutzung) return;
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.NUTZUNG, Zone: zone.Schluessel, Nutzung: nutzung));
    }

    /// <summary>Setzt den Haken „beheizt" eines Raums wie die Raumliste: gleich der Datei = keine Übersteuerung.</summary>
    private void RaumhakenSetzen(string raum, bool beheizt)
    {
        GebaeudeRaumzeileDaten? zeile = _stand?.Raeume.FirstOrDefault(r => string.Equals(r.Kennung, raum, StringComparison.Ordinal));
        if (zeile is not null && beheizt == zeile.BeheiztLautDatei) _uebersteuert.Remove(raum);
        else _uebersteuert[raum] = beheizt;
    }

    private void BeiFilter(ref bool filter, bool wert)
    {
        filter = wert;
        FlaechenFiltern();
    }

    private void BeiFlaeche(string schluessel) => _flaecheGewaehlt = schluessel ?? "";

    private void BeiBauteil(string schluessel) => _bauteilGewaehlt = schluessel ?? "";

    /// <summary>Die Zeilen der Flächenliste nach den drei Filtern — neu nur nach Zuordnen oder Filterwechsel.</summary>
    private void FlaechenFiltern()
    {
        IReadOnlyList<GebaeudeFlaechenzeileDaten> alle = _stand?.Zonierung?.Flaechen ?? Array.Empty<GebaeudeFlaechenzeileDaten>();
        _flaechenzeilen = alle.Where(f => (!_nurFehler || f.Fehler) && (!_nurOhneGegenstueck || f.OhneGegenstueck)
                                          && (!_nurOhneUWert || f.OhneUWert) && (!_nurBauteilbefund || f.MitBauteilbefund))
                              .Select(f => f.Zeile).ToList();
    }

    /// <summary>Legt die Handänderungen des Anwenders auf eine frisch zugeordnete Zeile.</summary>
    private GebaeudeFeldzeileDaten MitHandaenderungen(GebaeudeFeldzeileDaten z, string manuellText)
    {
        if (z.Eingebbar && _handwerte.TryGetValue(z.Zielfeld, out double? wert))
            z = z with
            {
                Wert = wert,
                HerkunftSchluessel = GebaeudeHerkunftSchluessel.Manuell,
                HerkunftText = manuellText,
                Beleg = "",
                Markierung = GebaeudeZeilenmarkierung.Keine,
            };
        if (z.HakenSetzbar && _handhaken.TryGetValue(z.Zielfeld, out bool haken))
            z = z with { Haken = haken };
        return z;
    }

    private void BeiKlasse(int? index)
    {
        _klasse = GueltigeKlasse(index);
        _meldung = "";
        NeuZuordnen();
    }

    private void BeiGebaeude(int? index)
    {
        if (index is not int i || _lesestand is null || i < 0 || i >= _lesestand.Gebaeude.Count || i == _gebaeudeIndex) return;
        // Ein anderes Gebäude ist ein Kontextwechsel — ohne Übertrag.
        _gebaeudeIndex = i;
        _uebersteuert.Clear();
        _handwerte.Clear();
        _handhaken.Clear();
        _baustoffzuordnungen.Clear();
        _alsZoneWahl = null;
        _cadSollwert = false;
        ZonenZuruecksetzen();
        _nameGeaendert = false;
        _meldung = "";
        // Die Projektdatei gehört zum Gebäude — ein anderes nimmt sie nicht mit.
        if (_stand?.Projektdatei is not null) ProjektdateiEntfernen?.Invoke();
        NeuZuordnen();
    }

    // =====================================================================
    // Projektdatei dazuladen (Datenaustauschkonzept 16.4)
    // =====================================================================

    /// <summary>Die Meldungen der Projektdatei ohne Bilanz und Fassung — das Übersprungene mit Grund.</summary>
    private static IReadOnlyList<GebaeudeImportMeldung> Uebersprungen(GebaeudeProjektdateiDaten sq)
        => sq.Meldungen.Where(m => m.Kennung is not null && !m.Kennung.EndsWith("_BILANZ", StringComparison.Ordinal)
                                   && !m.Kennung.EndsWith("_FASSUNG", StringComparison.Ordinal)
                                   && !m.Kennung.EndsWith("_ZONIERUNG", StringComparison.Ordinal)
                                   && !m.Kennung.EndsWith("_ZONIERUNG_EINE", StringComparison.Ordinal)).ToList();

    /// <summary>Trägt der Plan die Zonen der Projektdatei?</summary>
    private bool PlanMitProjektdatei => _planschritte.Exists(s => s.Art == GebaeudePlanschrittArt.PROJEKTDATEI);

    /// <summary>
    /// Der Knopf „Projektdatei dazuladen“: Dateiwahl, Lesen über die Datenseite (mit Abbruch), dann die Übernahme der Zonen
    /// als Schritt am Plan. Eine frühere Übernahme fällt mit der neuen Datei weg; eine Ablehnung steht als Banner.
    /// </summary>
    private async Task BeiProjektdatei()
    {
        if (Beschaeftigt || ProjektdateiLesen is null || _stand is not { ProjektdateiMoeglich: true }) return;
        string? pfad = ProjektdateiWaehlen is null ? null : await ProjektdateiWaehlen();
        if (string.IsNullOrEmpty(pfad)) return;

        _laeuft = true;
        _meldung = "";
        _abbruch = new CancellationTokenSource();
        GebaeudeProjektdateiDaten? sq = null;
        try
        {
            sq = await ProjektdateiLesen(pfad, _gebaeudeIndex, _abbruch.Token);
        }
        catch (OperationCanceledException)
        {
            // Abgebrochen — still.
        }
        finally
        {
            _laeuft = false;
            _abbruch?.Dispose();
            _abbruch = null;
        }
        if (PlanMitProjektdatei)
        {
            PlanZuruecksetzen();
            _offeneZonen.Clear();
        }
        _sqZonierung = null;
        if (sq is { Gelesen: true }) ZonenDerProjektdatei();
        else NeuZuordnen();
    }

    /// <summary>Die Zonen der Projektdatei in den Plan — mit Schritten von Hand erst nach Rückfrage.</summary>
    private void ZonenDerProjektdatei()
    {
        NeuZuordnen();
        if (_stand?.Zonierung?.Plan is null || Beschaeftigt) return;
        if (_planschritte.Count > 0)
        {
            _sqFrage = true;
            return;
        }
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.PROJEKTDATEI, Zonierung: _sqZonierung));
    }

    /// <summary>Die Antwort der Rückfrage: „Ja“ verwirft die Schritte von Hand und übernimmt die Zonen der Projektdatei.</summary>
    private void SqBeantwortet(bool? antwort)
    {
        _sqFrage = false;
        if (antwort != true) return;
        PlanZuruecksetzen();
        _offeneZonen.Clear();
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.PROJEKTDATEI, Zonierung: _sqZonierung));
    }

    /// <summary>Die Schritte von Hand am Plan (alle außer der Übernahme der Projektdatei).</summary>
    private int Handschritte => _planschritte.Count(s => s.Art != GebaeudePlanschrittArt.PROJEKTDATEI);

    /// <summary>
    /// Das Wahlfeld der Zonierung (E87, F1): trägt der Plan die Zonen der Projektdatei, baut der Wechsel ihn mit der anderen
    /// Zonierung neu auf — mit Schritten von Hand erst nach Rückfrage; sonst gilt die Wahl für die nächste Übernahme.
    /// </summary>
    private void BeiZonierung(ChangeEventArgs e)
    {
        string? neu = e.Value as string;
        string aktuell = _sqZonierung ?? _stand?.Projektdatei?.Zonierung ?? GebaeudeZonierungSchluessel.DIN;
        if (Beschaeftigt || neu is not (GebaeudeZonierungSchluessel.DIN or GebaeudeZonierungSchluessel.SIMULATION) || neu == aktuell) return;
        _sqZonierungAlt = _sqZonierung;
        _sqZonierung = neu;
        if (!PlanMitProjektdatei) return;
        if (Handschritte > 0)
        {
            _sqZonierungFrage = true;
            return;
        }
        ZonierungNeuAufbauen();
    }

    /// <summary>Die Antwort der Rückfrage vor dem Wechsel: „Ja“ baut den Plan neu auf, sonst gilt die alte Wahl.</summary>
    private void SqZonierungBeantwortet(bool? antwort)
    {
        _sqZonierungFrage = false;
        if (antwort == true) ZonierungNeuAufbauen();
        else _sqZonierung = _sqZonierungAlt;
    }

    /// <summary>Verwirft die Schritte und übernimmt die Zonen der Projektdatei mit der gewählten Zonierung neu.</summary>
    private void ZonierungNeuAufbauen()
    {
        PlanZuruecksetzen();
        _offeneZonen.Clear();
        Schritt(new GebaeudePlanschritt(GebaeudePlanschrittArt.PROJEKTDATEI, Zonierung: _sqZonierung));
    }

    /// <summary>„Projektdatei entfernen“: Stand ohne Projektdatei; trug der Plan ihre Zonen, steht wieder der Regelvorschlag.</summary>
    private void BeiProjektdateiEntfernen()
    {
        if (Beschaeftigt) return;
        ProjektdateiEntfernen?.Invoke();
        _sqZonierung = null;
        if (PlanMitProjektdatei)
        {
            PlanZuruecksetzen();
            _offeneZonen.Clear();
        }
        _meldung = "";
        NeuZuordnen();
    }

    private void BeiBeheizt(GebaeudeRaumzeileDaten raum, bool beheizt)
    {
        HakenAendern(raum.Kennung, beheizt);
        _meldung = "";
        NeuZuordnen();
    }

    /// <summary>Der Schalter „Raumtemperatur der Datei als Heizsollwert übernehmen" — ordnet neu zu.</summary>
    private void BeiCadSollwert(bool wert)
    {
        if (Beschaeftigt || wert == _cadSollwert) return;
        _cadSollwert = wert;
        _meldung = "";
        NeuZuordnen();
    }

    /// <summary>Der Schalter „Als Zone mit Bauteilen übernehmen" — nur, solange der Vorschlag sich bilden lässt.</summary>
    private void BeiAlsZone(bool wert)
    {
        if (_stand?.Bauteile is not { Moeglich: true }) return;
        _alsZoneWahl = wert;
        _meldung = "";
    }

    /// <summary>
    /// Die Klappliste einer Baustoffzeile: Der gewählte Katalogbaustoff wird die eigene Zuordnung
    /// des Namens; danach ordnet der Dialog neu zu — aus Schichten ohne Stoffwerte können so
    /// Aufbauten werden.
    /// </summary>
    private void BeiBaustoff(GebaeudeMaterialzeileDaten zeile, ChangeEventArgs e)
    {
        if (Beschaeftigt || zeile.Schluessel.Length == 0) return;
        if (!int.TryParse(e.Value?.ToString(), NumberStyles.Integer, CultureInfo.InvariantCulture, out int id)) return;
        if (zeile.IdBaustoff == id && zeile.AbgleichSchluessel == GebaeudeAbgleichSchluessel.EigeneZuordnung) return;
        _baustoffzuordnungen[zeile.Schluessel] = id;
        _meldung = "";
        NeuZuordnen();
    }

    /// <summary>
    /// „Zuordnung entfernen": Eine im Dialog gesetzte Zuordnung fällt weg; eine, die das Projekt
    /// schon gemerkt hat, wird zum Entfernen vorgemerkt. Danach gilt wieder der Abgleich über Namen
    /// und Synonyme.
    /// </summary>
    private void BeiEntfernen(GebaeudeMaterialzeileDaten zeile)
    {
        if (Beschaeftigt || zeile.Schluessel.Length == 0) return;
        if (zeile.Gemerkt) _baustoffzuordnungen[zeile.Schluessel] = null;
        else _baustoffzuordnungen.Remove(zeile.Schluessel);
        _meldung = "";
        NeuZuordnen();
    }

    private void BeiName(string wert)
    {
        _name = wert ?? "";
        _nameGeaendert = true;
    }

    /// <summary>
    /// Ein geänderter Wert: Herkunft „manuell", Markierung weg; ein eingetragener Wert setzt den Haken.
    /// Danach ordnet der Dialog neu zu — die Datenseite zieht die Vorgaben nach, die vom geänderten
    /// Wert abhängen (etwa die inneren Gewinne von der Nutzfläche).
    /// </summary>
    private void BeiWert(string zielfeld, double? wert)
    {
        int i = _zeilen.FindIndex(z => z.Zielfeld == zielfeld);
        if (i < 0 || !_zeilen[i].Eingebbar) return;
        _handwerte[zielfeld] = wert;
        if (wert.HasValue && _zeilen[i].HakenSetzbar) _handhaken[zielfeld] = true;
        _zeilen[i] = MitHandaenderungen(_zeilen[i], _stand?.ManuellHerkunftText ?? "");
        _meldung = "";
        NeuZuordnen();
    }

    private void BeiHaken(string zielfeld, bool haken)
    {
        int i = _zeilen.FindIndex(z => z.Zielfeld == zielfeld);
        if (i < 0 || !_zeilen[i].HakenSetzbar) return;
        _handhaken[zielfeld] = haken;
        _zeilen[i] = _zeilen[i] with { Haken = haken };
        _meldung = "";
    }

    // =====================================================================
    // Schluss — OK prüft und übernimmt, Abbrechen verwirft
    // =====================================================================

    private GebaeudeImportErgebnis ErgebnisBauen()
        => new(_gebaeudeIndex, _klasse, _name.Trim(),
               new Dictionary<string, bool>(_uebersteuert, StringComparer.Ordinal),
               _zeilen.ToList(), AlsZoneWirksam,
               new Dictionary<string, int?>(_baustoffzuordnungen, StringComparer.Ordinal),
               Zonenregel, null, CadSollwertWirksam,
               _planschritte.Count > 0 ? _planschritte.ToList() : null, _planschritte.Count > 0 ? _plangrundhaken : null,
               _typwahl.Count > 0 ? new Dictionary<string, string>(_typwahl, StringComparer.Ordinal) : null);

    private async Task BeiLeiste(bool ok)
    {
        if (!ok)
        {
            await BeiAbbrechen();
            return;
        }
        if (Beschaeftigt) return;

        // Die weiche Sperre meldet den Versuch.
        if (_stand is null) { Melden(Texte.OkOhneDatei, WarnStufe.Hinweis); return; }
        if (Uebernehmen is null) { Melden(Texte.OkOhneWeg, WarnStufe.Hinweis); return; }
        if (NichtZugeordnet > 0) { Melden(Format(Texte.PlanOkGesperrt, NichtZugeordnet), WarnStufe.Hinweis); return; }

        GebaeudeImportErgebnis ergebnis = ErgebnisBauen();
        IReadOnlyList<GebaeudeImportMeldung> befund = Pruefen?.Invoke(ergebnis) ?? Array.Empty<GebaeudeImportMeldung>();
        List<GebaeudeImportMeldung> fehler = befund.Where(m => m.Stufe == WarnStufe.Fehler).ToList();
        if (fehler.Count > 0)
        {
            Melden(Texte.Gesperrt + Environment.NewLine + string.Join(Environment.NewLine, fehler.Select(m => m.Text)),
                   WarnStufe.Fehler);
            return;
        }

        _schreibt = true;
        _meldung = "";
        string? grund;
        try
        {
            grund = await Uebernehmen(ergebnis);
        }
        finally
        {
            _schreibt = false;
        }

        if (grund is not null)
        {
            Melden(grund, WarnStufe.Fehler);
            return;
        }
        await Geschlossen.InvokeAsync(ergebnis);
    }

    /// <summary>Abbrechen, ✕ und Esc: verwirft, ohne zu prüfen und ohne zu übernehmen; ein Lesegang wird abgebrochen.</summary>
    private async Task BeiAbbrechen()
    {
        if (_schreibt) return;
        _abbruch?.Cancel();
        await Geschlossen.InvokeAsync(null);
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_nutzungsblatt) return Task.CompletedTask;   // die Überlagerung der Nutzungsprofile schließt selbst
        if (_regelFrage is not null || _aufhebenFrage) return Task.CompletedTask;   // die Rückfrage antwortet „Nein"
        if (_laeuft) { _abbruch?.Cancel(); return Task.CompletedTask; }
        if (_schreibt) return Task.CompletedTask;
        return BeiAbbrechen();
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    public void Dispose()
    {
        try { _abbruch?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    // =====================================================================
    // Anzeige
    // =====================================================================

    private static string? Zeilenklasse(GebaeudeFeldzeileDaten z) => z.Markierung switch
    {
        GebaeudeZeilenmarkierung.Gelb => "epos-gebimport-zeile--gelb",
        GebaeudeZeilenmarkierung.Rot => "epos-gebimport-zeile--rot",
        _ => null,
    };

    /// <summary>Gelb, wo ein Name einen Baustoff braucht und keinen trifft; vorgemerkt, wo der Dialog etwas geändert hat.</summary>
    // =====================================================================
    //  Liste „Bauteilaufbauten" (Konzept Bauteilaufbau 5.4 b, BA-3)
    // =====================================================================

    /// <summary>Der Materialname, zu dem der letzte Sprung führte (Abschnitt „Baustoffe"); <c>null</c> = keiner.</summary>
    private string? _baustoffziel;
    private bool _baustoffzielNeu;
    private ElementReference _baustoffmarke;

    /// <summary>Zeigt die Liste nur die Stufen B und C?</summary>
    private bool _nurBC;

    /// <summary>Die Typwahl je Ersatzaufbau (E95-4): Schlüssel → Code; reist in Anfrage und Ergebnis, gespeichert wird nichts.</summary>
    private readonly Dictionary<string, string> _typwahl = new(StringComparer.Ordinal);

    /// <summary>Die Typwahl des Dialogs (Prüfhilfe für Tests).</summary>
    public IReadOnlyDictionary<string, string> Typwahl => _typwahl;

    /// <summary>Eine andere Typwahl: Der Vorschlag wird neu gebildet, der Ersatzaufbau auf den gewählten Typ abgeglichen.</summary>
    private void BeiTyp(GebaeudeAufbaulistenzeileDaten zeile, ChangeEventArgs e)
    {
        if (Beschaeftigt || zeile.Typschluessel is not { } schluessel || e.Value?.ToString() is not { Length: > 0 } code) return;
        if (string.Equals(code, zeile.Typcode, StringComparison.Ordinal)) return;
        _typwahl[schluessel] = code;
        _meldung = "";
        NeuZuordnen();
    }

    /// <summary>Die aufgeklappten Zeilen (Schlüssel).</summary>
    private readonly HashSet<string> _aufbauOffen = new(StringComparer.Ordinal);

    /// <summary>Das Ziel des letzten Sprungs in die Baustoffe (Prüfhilfe für Tests).</summary>
    public string? Baustoffziel => _baustoffziel;

    /// <summary>Der Sprung in den Abschnitt „Baustoffe" (aus Steckbrief oder Liste): markiert die Zeile und rollt zu ihr.</summary>
    private void BeiBaustoffsprung(string schluessel)
    {
        _baustoffziel = schluessel;
        _baustoffzielNeu = true;
    }

    private void BeiAufbauzeile(string schluessel)
    {
        if (!_aufbauOffen.Remove(schluessel)) _aufbauOffen.Add(schluessel);
    }

    /// <summary>
    /// Die Liste „Bauteilaufbauten": je Aufbau Stufe, Art, Zahl und Fläche der Bauteile, U der Datei, U aus den Schichten,
    /// C₁,korr je m², was fehlt; aufgeklappt die Schichten. Handlungen: Schichten zeigen, Baustoff zuordnen (Sprung). Eine
    /// schlichte Tabelle ohne Virtualisierung — die Zahl der Aufbauten ist klein (je Konstruktion einer).
    /// </summary>
    private RenderFragment Aufbauliste(GebaeudeImportStand stand) => __builder =>
    {
        IReadOnlyList<GebaeudeAufbaulistenzeileDaten> zeilen = stand.Aufbauten;
        <Gruppenkopf Titel="@Texte.GruppeAufbauten" />
        @if (zeilen.Count == 0)
        {
            <p class="epos-leisezeile epos-gebimport-aufbauten-leer">@Texte.AbLeer</p>
            return;
        }
        <label class="epos-gebimport-aufbaufilter">
            <input type="checkbox" checked="@_nurBC" @onchange="e => _nurBC = e.Value is true" />
            @Texte.AbNurBC
        </label>
        <div class="epos-raster-huelle">
            <table class="epos-raster epos-gebimport-aufbauten">
                <thead>
                    <tr>
                        <th>@Texte.AbSpalteStufe</th>
                        <th>@Texte.AbSpalteAufbau</th>
                        <th>@Texte.AbSpalteArt</th>
                        <th class="epos-gebimport-zahl">@Texte.AbSpalteBauteile</th>
                        <th class="epos-gebimport-zahl">@Texte.AbSpalteFlaeche</th>
                        <th class="epos-gebimport-zahl">@Texte.AbSpalteUDatei</th>
                        <th class="epos-gebimport-zahl">@Texte.AbSpalteUSchichten</th>
                        <th class="epos-gebimport-zahl">@Texte.AbSpalteC1</th>
                        <th>@Texte.AbSpalteFehlt</th>
                        <th>@Texte.AbSpalteHandlung</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (GebaeudeAufbaulistenzeileDaten eintrag in zeilen.Where(z => !_nurBC || GebaeudeAnsichtAufbaustufen.Unvollstaendig(z.Stufe)))
                    {
                        GebaeudeAufbaulistenzeileDaten z = eintrag;
                        bool offen = _aufbauOffen.Contains(z.Schluessel);
                        <tr @key="z.Schluessel" class="@(offen ? "epos-gebimport-aufbauzeile epos-gebimport-aufbauzeile--offen" : "epos-gebimport-aufbauzeile")"
                            data-schluessel="@z.Schluessel" data-stufe="@GebaeudeAnsichtAufbaustufen.Schluessel(z.Stufe)">
                            <td>
                                <span class="epos-gebansicht-farbfeld" style="@("background:" + GebaeudeAnsichtAufbaustufen.Farbe(z.Stufe))" aria-hidden="true"></span>
                                @Texte.Ansicht.Stufenname(z.Stufe)
                            </td>
                            <td>
                                @z.Aufbau
                                @if (z.Typaufbau.Length > 0)
                                {
                                    <span class="epos-leisezeile epos-gebimport-typaufbau">@z.Typaufbau</span>
                                }
                                @if (z.Aufbaurang.Length > 0)
                                {
                                    <span class="epos-leisezeile epos-gebimport-aufbaurang" data-herkunft="@z.AufbauHerkunftSchluessel">@z.Aufbaurang</span>
                                }
                            </td>
                            <td>@z.Art</td>
                            <td class="epos-gebimport-zahl">@z.Bauteile.ToString(CultureInfo.CurrentCulture)</td>
                            <td class="epos-gebimport-zahl">@z.Flaeche</td>
                            <td class="epos-gebimport-zahl">@z.UDatei</td>
                            <td class="epos-gebimport-zahl">@z.USchichten</td>
                            <td class="epos-gebimport-zahl">@z.C1korr</td>
                            <td class="epos-gebimport-aufbaufehlt">@z.Fehlt</td>
                            <td>
                                <div class="epos-gebimport-aufbauhandlungen">
                                    @if (z.Typschluessel is not null && z.Typen.Count > 1)
                                    {
                                        <select class="epos-eingabe epos-gebimport-typwahl" aria-label="@Texte.AbTyp" title="@Texte.AbTyp" disabled="@Beschaeftigt"
                                                value="@z.Typcode" @onchange="e => BeiTyp(z, e)">
                                            @foreach (GebaeudeZonenregelDaten t in z.Typen)
                                            {
                                                <option @key="t.Schluessel" value="@t.Schluessel" selected="@(t.Schluessel == z.Typcode)">@t.Text</option>
                                            }
                                        </select>
                                    }
                                    @if (z.Schichten.Count > 0)
                                    {
                                        <button type="button" class="epos-knopf epos-gebimport-aufbauschichten" aria-expanded="@(offen ? "true" : "false")"
                                                @onclick="() => BeiAufbauzeile(z.Schluessel)">@Texte.AbSchichten</button>
                                    }
                                    @if (z.Materialschluessel is { } material && stand.Baustoffe is { Zeilen.Count: > 0 })
                                    {
                                        <button type="button" class="epos-knopf epos-gebimport-aufbaubaustoff" data-material="@material"
                                                @onclick="() => BeiBaustoffsprung(material)">@Texte.AbZurBaustoff</button>
                                    }
                                </div>
                            </td>
                        </tr>
                        string schichtschluessel = z.Schluessel + "|s";
                        @if (offen)
                        {
                            <tr @key="schichtschluessel" class="epos-gebimport-aufbauschichtzeile">
                                <td colspan="10">
                                    <ul class="epos-gebimport-aufbauschichtliste">
                                        @foreach (BauteilsteckbriefSchicht sch in z.Schichten)
                                        {
                                            <li class="@(sch.Weggelassen ? "epos-steckbrief-schicht--weggelassen" : null)" data-herkunft="@sch.HerkunftSchluessel">
                                                @sch.Name · @sch.Dicke · λ @sch.Lambda · ρ @sch.Rohdichte · c @sch.Cp · @sch.Herkunft
                                                @if (sch.Weggelassen)
                                                {
                                                    <span class="epos-steckbrief-grund">(@sch.Grund)</span>
                                                }
                                            </li>
                                        }
                                    </ul>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <Herleitungszeile Text="@Texte.AbHinweis" />
    };

    private static string? Baustoffzeilenklasse(GebaeudeMaterialzeileDaten z)
    {
        string klasse = (z.OhneTreffer ? "epos-gebimport-zeile--gelb " : "") + (z.Vorgemerkt ? "epos-gebimport-baustoff--vorgemerkt" : "");
        klasse = klasse.Trim();
        return klasse.Length == 0 ? null : klasse;
    }

    private static string Herkunftsklasse(GebaeudeFeldzeileDaten z)
        => "epos-gebimport-herkunft epos-gebimport-herkunft--" + (z.HerkunftSchluessel ?? "").ToLowerInvariant();

    private static string Meldungsklasse(GebaeudeImportMeldung m) => m.Stufe switch
    {
        WarnStufe.Fehler => "epos-gebimport-meldung--fehler",
        WarnStufe.Warnung => "epos-gebimport-meldung--warnung",
        _ => "epos-gebimport-meldung--hinweis",
    };

    private static string Format(string vorlage, params object?[] werte)
    {
        try { return string.Format(CultureInfo.CurrentCulture, vorlage ?? "", werte); }
        catch (FormatException) { return vorlage ?? ""; }
    }
}
