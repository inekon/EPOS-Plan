    // Satz und ein Kontingent von null keine Laufzeit - sonst kaeme niemand mehr zum
    // Projektwert zurueck (E6-Muster).
    private void SatzEinspA(double? w) => Setze(() => Aktuelle!.SatzEinspCt = Positiv(w));
    private void SatzEigenA(double? w) => Setze(() => Aktuelle!.SatzEigenCt = Positiv(w));
    private void KontingentA(double? w) => Setze(() => Aktuelle!.VbhKontingent = Positiv(w));
    private void DeckelA(double? w) => Setze(() => Aktuelle!.VbhDeckel = Positiv(w));
    private void EnergiesteuerA(int? n) => Setze(() => Aktuelle!.EnergiesteuerWahl = BhkwWahlen.WertZu(_esA, n));
    private void AufteilungA(int? n) => Setze(() => Aktuelle!.AufteilungMethode = BhkwWahlen.WertZu(_aufA, n));

    // Beim Anteil ist 0 ein GUELTIGER Wert ("keine Hilfsenergie", BF4) - er wird
    // deshalb als 0 geschrieben und nicht auf null abgebildet.
    private void HilfsAnteilA(double? w) => Setze(() => Aktuelle!.HilfsenergieAnteil = w ?? 0);

