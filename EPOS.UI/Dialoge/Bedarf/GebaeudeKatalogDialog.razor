    // --- Stand -----------------------------------------------------------------

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private string _reiter = "";
    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Warnung;

    /// <summary>Der ARBEITSSTAND — eine tiefe Kopie des Satzes; geschrieben wird im OK-Weg.</summary>
    private GebaeudeKatalogDaten _stand = new();

    /// <summary>Der Rechenweg beim Laden — der Schalter kehrt dorthin zurück, NULL bleibt NULL.</summary>
    private string? _modellBeimLaden;

    /// <summary>Die Randbedingung beim Laden — Erdreich bleibt NULL, wenn es NULL war.</summary>
    private string? _randBeimLaden;

    /// <summary>Soll die Bauweise vor dem Schreiben aus Bauart und Nutzfläche entstehen?</summary>
    private bool _bauweiseNachfuehren;

    /// <summary>Die Felder, deren Text gerade keine gültige Zahl ist.</summary>
    private readonly HashSet<string> _fehlerfelder = new();

    private IReadOnlyList<string> _typen = Array.Empty<string>();
    private IReadOnlyList<string> _arten = Array.Empty<string>();
    private IReadOnlyList<string> _namen = Array.Empty<string>();
    private int? _namensindex;
    private IReadOnlyDictionary<string, object>? _brauchwasserGaben;
    private bool _geschrieben;

    /// <summary>Der Name, den das Überschreiben trifft — der Stand beim Öffnen bzw. Laden.</summary>
    private string _ursprungsname = "";

    // Die Ferien als Tag und Monat - die Zerlegung der Jahrestage fuer die Anzeige; sie
    // wandern im OK-Weg als Jahrestage in den Arbeitsstand.
    private readonly int?[] _beginnTag = new int?[4];
    private readonly int?[] _beginnMonat = new int?[4];
    private readonly int?[] _endeTag = new int?[4];
    private readonly int?[] _endeMonat = new int?[4];

    /// <summary>Der Arbeitsstand. Prüfhilfe für die Tests.</summary>
    public GebaeudeKatalogDaten Arbeitsstand => _stand;

    /// <summary>Die stehende Meldung. Prüfhilfe für die Tests.</summary>
    public string Meldung => _meldung;

    /// <summary>Der Name, den das Überschreiben trifft. Prüfhilfe für die Tests.</summary>
    public string Ursprungsname => _ursprungsname;

    /// <summary>Der gewählte Reiter. Prüfhilfe für die Tests.</summary>
    public string AktiverReiter => _reiter;

    /// <summary>Steht die Brauchwasserliste? Prüfhilfe für die Tests.</summary>
    public bool BrauchwasserOffen => _brauchwasserGaben is not null;

    /// <summary>Rechnet der Arbeitsstand auf dem VDI-Weg? (Anzeige = Rechnung, ADR-006)</summary>
    public bool IstVdi6007 => Gebaeuderechenweg.IstVdi6007(_stand.Modell);

    /// <summary>Die Herleitungszeile unter dem Schalter „Rechenweg". Prüfhilfe für die Tests.</summary>
    public string Rechenwegzeile
    {
        get
        {
            string zeile = IstVdi6007 ? Texte.ZeileRechenwegVdi6007 : Texte.ZeileRechenwegTagesbilanz;
            if (_stand.Modell is not null) return zeile;
            string vorgabe = Gebaeuderechenweg.IstVdi6007(null) ? Texte.RechenwegVdi6007 : Texte.RechenwegTagesbilanz;
            return zeile + " " + Texte.ZeileRechenwegVorgabe.Replace("{0}", vorgabe);
        }
    }

    /// <summary>
    /// Die Herleitungszeile der Gruppe „Kühlung" (Kühlkonzept 8.1) — sie nennt den Rückfall in
    /// BEIDEN Stellungen des Hakens: mit Haken die Prüfregel samt höchstem Heizsollwert, ohne
    /// Haken die Maximalraumtemperatur, an der die Überhitzung des frei laufenden Gebäudes
    /// gezählt wird (Entscheid E32). Prüfhilfe für die Tests.
    /// </summary>
    public string Kuehlungszeile
    {
        get
        {
            double maxTemperatur = _stand.MaxTemperatur ?? 0;
            if (maxTemperatur < 1) maxTemperatur = 24;   // dieselbe Ableitung wie im OK-Weg
            if (!_stand.KuehlungAktiv)
                return string.Format(Texte.ZeileKuehlungAus, Zahl(maxTemperatur, 1));
            return string.Format(Texte.ZeileKuehlungAn,
                                 Zahl(Gebaeudemodellvorgaben.KuehlsollwertAbstand, 0),
                                 Zahl(HoechsterHeizsollwert, 1),
                                 Zahl(maxTemperatur, 1));
        }
    }

    /// <summary>
    /// Der höchste Heizsollwert des Arbeitsstands [°C] — über dieselbe Regel des Kerns, die
    /// der Sollwertfahrplan des Stundenmodells kennt
    /// (<see cref="Gebaeudemodellvorgaben.HoechsterHeizsollwert"/>); leere Felder gelten wie
    /// im OK-Weg als 0.
    /// </summary>
    private double HoechsterHeizsollwert => Gebaeudemodellvorgaben.HoechsterHeizsollwert(
        _stand.SollTag ?? 0, _stand.NachtAbsenkung ?? 0, _stand.WochenendAbsenkung ?? 0,
        _stand.SollFerien ?? 0, FerienAktiv);

    /// <summary>Gilt der Ferienfahrplan? Feriensollwert gesetzt und mindestens ein Zeitraum eingetragen.</summary>
    private bool FerienAktiv
    {
        get
        {
            if (!((_stand.SollFerien ?? 0) > 0)) return false;
            int[] beginn = Ferienbeginne(), ende = Ferienenden();
            for (int n = 0; n < 4; n++)
                if (beginn[n] > 0 && beginn[n] < 366 && ende[n] > 0 && ende[n] < 366) return true;
            return false;
        }
    }

    /// <summary>
    /// Der Haken „Gebäude wird gekühlt". Ohne Haken stehen Kühlsollwert und Grenze nicht da —
    /// ihre Werte bleiben im Arbeitsstand (wieder eingeschaltet sind sie zurück), eine
    /// Fehleingabe in einem ausgeblendeten Feld hält den OK-Weg aber nicht mehr an.
    /// </summary>
    private void KuehlungGesetzt(bool wert)
    {
        _stand.KuehlungAktiv = wert;
        if (wert) return;
        _fehlerfelder.Remove(Feld(Texte.LabelKuehlSollwert));
        _fehlerfelder.Remove(Feld(Texte.LabelKuehlleistungMax));
    }

    private bool SpeichernUnterMoeglich => Modus == GebaeudeKatalogModus.Bearbeiten && Speichern is not null;

    protected override void OnInitialized()
    {
        _typen = Gebaeudetypen?.Invoke() ?? Array.Empty<string>();
        _arten = Gebaeudearten?.Invoke() ?? Array.Empty<string>();

        StandSetzen(Daten ?? new GebaeudeKatalogDaten());

        if (Modus == GebaeudeKatalogModus.Admin)
        {
            _namen = Katalognamen?.Invoke() ?? Array.Empty<string>();
            if (_namen.Count > 0)
            {
                _namensindex = 0;
                SatzLaden(_namen[0]);
            }
        }

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE_KATALOG,
                                          () => KiSicht(), KiHaken());
    }

    /// <summary>Übernimmt einen Satz als Arbeitsstand — beim Öffnen und beim Namenswechsel.</summary>
    private void StandSetzen(GebaeudeKatalogDaten satz)
    {
        _stand = satz.Kopie();
        _ursprungsname = _stand.Name ?? "";
        _modellBeimLaden = _stand.Modell;
        _randBeimLaden = _stand.GrundflaecheRandbedingung;
        _bauweiseNachfuehren = Modus == GebaeudeKatalogModus.Neu || _stand.Bauweise <= 0;
        _fehlerfelder.Clear();
        FerienZerlegen();
    }

    // =================================================================================
    // Der Hilfe-Assistent liest und setzt den Arbeitsstand (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GebaeudeKatalogKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten. Beide Reiterblätter greifen auf den ARBEITSSTAND zu — er
    /// wird beim Namenswechsel ausgetauscht, deshalb Delegaten und keine Instanz.
    /// </summary>
    private GebaeudeKatalogKiSicht KiSicht()
    {
        return _kiSicht ??= new GebaeudeKatalogKiSicht
        {
            SatzLesen = () => _stand,

            NameLesen = () => _stand.Name,
            NameSetzen = KiNameSetzen,

            BauartSetzen = BauartWaehlen,

            TypEintraege = () => KiMaskenanmeldung.Eintraege(
                Typeintraege, e => e.Text, e => e.Text),
            GebaeudeartEintraege = () => KiMaskenanmeldung.Eintraege(
                Arteintraege, e => e.Text, e => e.Text),
            BaualtersklasseEintraege = () => KiMaskenanmeldung.Eintraege(
                Klasseneintraege, e => e.Id, e => e.Text),
            BauartEintraege = () => KiMaskenanmeldung.Eintraege(
                Bauarteintraege, e => e.Id, e => e.Text),
            VerwendungEintraege = KiVerwendungseintraege,

            SollTagLesen = () => _stand.SollTag,
            SollTagSetzen = w => _stand.SollTag = w,
            NachtabsenkungLesen = () => _stand.NachtAbsenkung,
            NachtabsenkungSetzen = w => _stand.NachtAbsenkung = w,
            MaxTemperaturLesen = () => _stand.MaxTemperatur,
            MaxTemperaturSetzen = w => _stand.MaxTemperatur = w,
            WochenendabsenkungLesen = () => _stand.WochenendAbsenkung,
            WochenendabsenkungSetzen = w => _stand.WochenendAbsenkung = w,
            SollFerienLesen = () => _stand.SollFerien,
            SollFerienSetzen = w => _stand.SollFerien = w,

            WbvkFensterWandLesen = () => _stand.WbvkFensterWand,
            WbvkFensterWandSetzen = w => _stand.WbvkFensterWand = w,
            WbvkWandDachLesen = () => _stand.WbvkWandDach,
            WbvkWandDachSetzen = w => _stand.WbvkWandDach = w,
            WbvkAussenwandKellerLesen = () => _stand.WbvkAussenwandKeller,
            WbvkAussenwandKellerSetzen = w => _stand.WbvkAussenwandKeller = w,

