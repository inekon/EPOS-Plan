    /// <summary>
    /// Die Sicht des Assistenten auf die LEBENDEN Felder: die Anzeigeeinheit, den
    /// neuen Jahresverbrauch, den Infoblock des markierten Profils und beim Brauchwasser
    /// die Optionsgruppe „Rechenweg Brauchwasser".
    /// </summary>
    private BedarfsProfileKiSicht KiSicht()
    {
        return _kiSicht ??= new BedarfsProfileKiSicht
        {
            EinheitLesen = () => EinheitIndex,
            EinheitSetzen = EinheitWaehlen,
            EinheitEintraege = () => KiMaskenanmeldung.Eintraege(
                Einheitenwahl, e => e.Id, e => e.Text),

            NeuerWertLesen = () => _neuerWert,
            NeuerWertSetzen = w => _neuerWert = w,

            ProfilLesen = () => _infoName,
            TypLesen = () => _infoTyp,
            BeschreibungLesen = () => _infoBeschreibung,
            JahresverbrauchLesen = () => Jahresverbrauch,
            SummeLesen = () => Gesamtsumme,
            BedarfsartLesen = () => Art.ToString(),

            RechenwegLesen = () => MitRechenweg ? (int)_rechenweg : null,
            RechenwegSetzen = KiRechenweg,
            RechenwegEintraege = () => KiMaskenanmeldung.Eintraege(
                Rechenwege, e => e.Id, e => e.Text),

            // PW2/BW2: der Betriebskalender der markierten Zeile - derselbe Weg wie die Wahl.
            KalenderLesen = () => Betriebskalender is null ? null : _gewaehlt?.KalenderId ?? 0,
            KalenderSetzen = KalenderGewaehlt,
            // KWN-0: die Art der markierten Kaeltezeile - derselbe Weg wie die Wahl.
            KaelteArtLesen = () => KaelteArten is null ? null : KaelteArtIndex,
            KaelteArtSetzen = KaelteArtGewaehlt,
            KaelteArtEintraege = () => KiMaskenanmeldung.Eintraege(
                KaelteArtEintraege, e => e.Id, e => e.Text),
            KalenderEintraege = () => KiMaskenanmeldung.Eintraege(
                KalenderWahlEintraege, e => e.Id, e => e.Text),
            // K5b: die Feldgruppe „Deckung" der markierten Kaeltezeile - dieselben Felder wie die Ueberlagerung.
            DeckungLesen = () => DeckungSichtbar ? _gewaehlt!.Deckung : null,
            TraegerEintraege = () => KiMaskenanmeldung.Eintraege(Stromtraeger, t => t.Id, t => t.Text)
        };
    }

    /// <summary>
    /// Die Optionsgruppe „Rechenweg Brauchwasser" über den Assistenten (Welle #458, Stufe 3a)
    /// — derselbe Weg wie ein Klick (<see cref="RechenwegWaehlen"/>). Ohne Optionsgruppe
    /// (andere Ausprägung, kein gespeichertes Projekt) und für „Zapfprofil" ohne Zone
    /// nennt er den Grund, den die Maske selbst nennt.
    /// </summary>
    private string? KiRechenweg(int? id)
    {
        if (!MitRechenweg)
            return Art == BedarfsArt.Brauchwasser && ZapfprofilSperrgrund.Length > 0
                ? ZapfprofilSperrgrund
                : Resource.KI_DLG_BPF_RECHENWEG_NUR_BW;
        if (id == (int)ZapfprofilWeg.Generator && RechenwegGesperrt is not null)
            return ZapfprofilEinstiegTexte.HinweisOhneZonen;

        RechenwegWaehlen(id);
        return null;
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>„Speichern" heißt hier ÜBERNEHMEN</b> — der Weg des Knopfes, der den neuen
    /// Jahresverbrauch in die markierte Projektzeile schreibt und die Maske stehen
    /// lässt. Ohne markierte Zeile oder ohne Zahl lehnt er benannt ab, genau wie der
    /// Knopf. Einen Schreibschutz kennt diese Maske nicht.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Speichern = () => Task.FromResult(KiUebernehmen())
    };

    private KiKern.KiErgebnis KiUebernehmen()
    {
        BeiUebernehmen();
        return _meldungStufe == WarnStufe.Warnung
                   ? KiKern.KiErgebnis.Abgelehnt(_meldung)
                   : KiKern.KiErgebnis.Ok(_infoName, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>
    /// Die Einheit umschalten. Der eingegebene Wert WANDERT MIT — er stand in der
    /// alten Einheit, und eine stille Umdeutung um den Faktor 1000 wäre die
    /// gefährlichste Antwort. Die Wahl geht an die Hülle, damit sie gemerkt wird.
    /// </summary>
    private void EinheitWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n >= Energieeinheit.Alle.Count) return;

        Energieeinheit neu = Energieeinheit.Alle[n];
        if (ReferenceEquals(neu, _einheit)) return;

        if (_neuerWert.HasValue) _neuerWert = neu.AusMWh(_einheit.NachMWh(_neuerWert.Value));

        _einheit = neu;
        EinheitGewaehlt?.Invoke(neu);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _ersterAufbau)
        {
            _ersterAufbau = false;
            await _wurzel.FocusAsync(preventScroll: true);
            return;
        }

        if (_fokusZurueckNoetig && !ZapfprofilOffen)
        {
            // Ohne Rollen: Den Rollstand stellt der Blattwechsel wieder her; ein Fokus auf die
            // (hohe) Wurzel liesse den Browser ihn sonst neu bestimmen.
            _fokusZurueckNoetig = false;
            await _wurzel.FocusAsync(preventScroll: true);
        }
    }

    private void KatalogLaden()
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, TitelText, out _listeFehler);
        VerwendungStempeln();
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));

        if (_katalogzeile is null) return;

        // Die gewaehlte Zeile kann aus dem Katalog verschwunden sein (Loeschen).
        _katalogzeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogzeile is null) _katalogGewaehlt = "";
    }

    /// <summary>
    /// Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste aus der
    /// LEBENDEN Projektliste, nicht je Zeile und nicht aus der Datenbank: Der Dialog
    /// schreibt erst beim OK zurück.
    /// </summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Name));

    /// <summary>Der Katalogsatz zu einem Bezeichner; <c>null</c>, wenn es ihn nicht gibt.</summary>
    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    private double Summe()
    {
        double s = 0;
        foreach (BedarfsProfilZeile z in Zeilen) s += z.Summe;
        return s;
    }

