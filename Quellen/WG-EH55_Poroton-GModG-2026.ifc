#22142=IFCPROPERTYENUMERATEDVALUE('EmbeddedSystemPositionType','Kennung f\X\FCr die Position von fl\X\E4chenintegrierten Systemen innerhalb des Geb\X\E4udeelementes Anhand der Eigenschaft wird festgelegt, ob ein fl\X\E4chenintegriertes System innerhalb des Geb\X\E4udebauteils installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein fl\X\E4chenintegriertes System vorgesehen ist. Wenn die Position des fl\X\E4chenintegrierten Systems noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
#22143=IFCPROPERTYENUMERATEDVALUE('Generator','Kennung f\X\FCr den Ersteller/Bearbeiter des Geb\X\E4udeelementes. Der Generator dient nur zur Information. Die Kennung darf nicht f\X\FCr die Identifizierung von Modellobjekten verwendet werden.',(IFCLABEL('mgt2D3D')),$);
#22144=IFCPROPERTYSINGLEVALUE('GUID','Bezeichner, der w\X\E4hrend der Lebenszeit des Modellobjektes erhalten bleibt. Der Bezeichner ist nicht eindeutig.',IFCLABEL('8eedec8d-c1c4-4a0c-ad5a-464578fbe2f8'),$);
#22145=IFCPROPERTYSINGLEVALUE('ID','Kennung f\X\FCr das Modellobjekt. MUSS innerhalb des Projektes eindeutig sein.',IFCIDENTIFIER('-1'),$);
#22146=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('e88f9cee-307b-46b9-8c83-1dca7ca815e3'),$);
#22147=IFCPROPERTYENUMERATEDVALUE('LoadBearingType','Kennung f\X\FCr die Tragf\X\E4higkeit des Bauteils',(IFCLABEL('elbNone')),$);
#22148=IFCPROPERTYSINGLEVALUE('Name','Name des Bauteils',IFCLABEL('F 016-1'),$);
#22149=IFCPROPERTYSINGLEVALUE('Number','Kurzbeschreibung des Objektes. (50 Zeichen)',IFCLABEL(''),$);
#22150=IFCPROPERTYSINGLEVALUE('Orientation (\X\B0)','Orientierung betogen auf das Bauteil',IFCLABEL('270'),$);
#22151=IFCPROPERTYENUMERATEDVALUE('Orientation.Type','Orientierung Type (Enum)',(IFCLABEL('botW')),$);
#22152=IFCPROPERTYENUMERATEDVALUE('RadiatorPositionType','Kennung f\X\FCr die Position des Heizk\X\F6rpers zum Geb\X\E4udeelement Anhand der Eigenschaft wird festgelegt, ob ein Heizk\X\F6rper an dem Geb\X\E4udebauteil installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein Heizk\X\F6rper vorgesehen ist. Wenn die Position des Heizk\X\F6rpers noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
