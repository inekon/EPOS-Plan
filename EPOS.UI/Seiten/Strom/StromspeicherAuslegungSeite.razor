    {
        if (Dienste?.ProjektflotteDeaktivieren is null) return;
        try
        {
            string fehler = await Dienste.ProjektflotteDeaktivieren();
            if (fehler.Length > 0) { _fehler = fehler; return; }
            _projektAktiv = false;
            _meldungErfolg = true;
