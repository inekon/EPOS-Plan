    /// <summary>Ein Feld hat sich geaendert: fortschreiben und merken. Geschrieben
    /// wird erst beim Speichern (Bestandsverhalten <c>Feld_Wechsel</c>).</summary>
    private void Setze(Action aenderung)
    {
        aenderung();
        _geaendert = true;
        _meldung = "";
        _leiste?.Leeren();
    }

