    protected override void OnInitialized()
    {
        Auffrischen();

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.BERICHTE_UEBERSICHT,
                                          () => KiSicht(), KiHaken());
    }

    // =====================================================================
    // Der Hilfe-Assistent (Welle KI-F6)
    // =====================================================================

    private KiMaskenanmeldung? _kiMaske;
    private UebersichtSeiteKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die vier Einstellwerte der Seite und zwei
    /// Anzeigen. Jede Wahl geht denselben Weg wie ein Griff in die Klappliste —
    /// Rückruf an die Hülle, danach Auffrischen.
    /// </summary>
    private UebersichtSeiteKiSicht KiSicht()
    {
        return _kiSicht ??= new UebersichtSeiteKiSicht
        {
            // DIE DREI WAHLWEGE LAUFEN UEBER InvokeAsync: Sie enden in
            // Auffrischen(), und das ruft StateHasChanged; der Assistent setzt aber
            // NICHT aus dem Blazor-Verteiler, sondern aus dem Faden seiner
            // Aufgabensteuerung. Ohne den Wechsel wirft der Renderer "The current
            // thread is not associated with the Dispatcher" - dieselbe Hausregel wie
            // beim SeitenZustand.
            StammLesen = () => _stand.StammId,
            StammSetzen = id => _ = InvokeAsync(() => BeiStamm(id)),
            StammEintraege = () => KiMaskenanmeldung.Eintraege(
                _stand.Staemme, z => z.Id, z => z.Text),

            FilterLesen = () => _stand.NurStaemme,
            FilterSetzen = an => _ = InvokeAsync(() => BeiFilter(an)),

            VarianteLesen = () => Markierung,
            VarianteSetzen = id => _ = InvokeAsync(() => BeiVersion(id)),
            VarianteEintraege = () => KiMaskenanmeldung.Eintraege(
                Versionen, z => z.Id, z => z.Text),

            SimulationLesen = () => Simulationszeile,
            StatusLesen = () => _status,

            NurUnterschiedeLesen = () => NurUnterschiede,
            NurUnterschiedeSetzen = an => _ = InvokeAsync(() => { BeiNurUnterschiede(an); StateHasChanged(); }),
            KomponentenLesen = () => KomponentenText(),
            ErgebnisseLesen = () => _ergebnisse?.Text() ?? ""
        };
    }

    /// <summary>
    /// Die sichtbare Gegenüberstellung als Text für den Assistenten — Zeile für Zeile,
    /// was die Tabelle zeigt; leer, wenn die Seite die Unterschiede einer Variante zeigt.
    /// </summary>
    private string KomponentenText()
    {
        var zeilen = new List<string>();
        foreach (GewerkVergleichZeile g in SichtbareGewerke)
        {
            var teile = new List<string>();
            for (int i = 0; i < g.Zellen.Count; i++)
            {
                GewerkVergleichZelle z = g.Zellen[i];
                string name = i < _stand.Versionsspalten.Count ? _stand.Versionsspalten[i].Name : "";
                string inhalt = z.Eintraege.Count == 0
                    ? NichtVorhandenText
                    : string.Join(", ", z.Eintraege.Select(e => e.Anzahl + " × " + e.Bezeichner
                        + (string.IsNullOrEmpty(e.Kennwerte) ? "" : " (" + e.Kennwerte + ")")));
                teile.Add(name + " = " + inhalt + (z.WeichtAb ? " — " + WeichtAbText : ""));
            }
            zeilen.Add(g.Gewerk + ": " + string.Join("; ", teile));
        }
        return string.Join("\n", zeilen);
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> Anlegen, Löschen, Umbenennen und Simulieren sind
    /// datenbankwirksame bzw. rechnende Aktionen mit eigener Rückfrage; sie gehören
    /// in das Aktionsregister und nicht in einen Speicherknopf, den es hier nicht
    /// gibt.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        // Ohne preventScroll rollt der Browser die hohe Seite ins Bild und schiebt die
        // Reiterleiste von „Berichte & Kosten" aus dem Blick.
        await _wurzel.FocusAsync(preventScroll: true);
    }

    /// <summary>Liest Auswahl, Liste und Komponentenbereich neu ein.</summary>
    public void Auffrischen()
    {
        _stand = Laden?.Invoke() ?? new UebersichtStand();
        _status = _stand.Statuszeile ?? "";

        // Die Aktionsspalte gehoert zur UNTERSCHIEDSansicht - erkennbar
        // daran, dass wenigstens eine Zeile sie traegt.
        _mitAktionsspalte = false;
        foreach (VergleichZeile v in _stand.Vergleich)
            if (v.MitAktion) { _mitAktionsspalte = true; break; }

        StateHasChanged();
    }

    private static string Kurztext(VergleichZeile z, int spalte)
        => spalte < z.Kurztexte.Count ? z.Kurztexte[spalte] : "";

    // =====================================================================
    // Die Versionswahl (Anwenderwunsch 05.09.2026, W5-E-1)
    // =====================================================================

    /// <summary>Das Warnzeichen der auffälligen Stände — dasselbe wie im Bestand.</summary>
    private const string WarnZeichen = "⚠";

    /// <summary>
    /// Die Einträge der Versionswahl in der Reihenfolge der Gruppe: der Stamm
    /// zuerst, dann die Varianten. Der Text ist der PROJEKTNAME — derselbe, den
    /// das Auswahlfeld „Projekt:" im Kopfband der Startseite zeigt
    /// (<c>StartseiteCtrl.VariantenEintrag.Name</c>). Bis zum Anwenderbefund
    /// vom 12.09.2026 (<b>Auftrag #238</b>) stand hier „Bezeichner — Projektname"
    /// — die zwei Spalten, die die Tabelle bis W5‑E‑1 nebeneinander führte —,
    /// aber der Projektname einer Variante ist seit jeher selbst
    /// „&lt;Stamm&gt; - &lt;Bezeichner&gt;" (<c>VariantenCtrl.Zielname</c>), und
    /// der Stamm trug seinen Bezeichner zusätzlich als „(Stammprojekt) — " davor:
    /// Der Bezeichner stand doppelt im Eintrag, z. B. „ein Speicher — Stromspeicher
    /// Optimierung - ein Speicher". Seither bleibt nur der Projektname, der
    /// Bezeichner ist der Rückfall für den Fall, dass er einmal leer ist.
    ///
    /// <para>Die Ids sind die Projekt-Ids und damit über einen Neuaufbau stabil —
    /// die Bedingung, die die Hausregel dem Wirt eines <c>Auswahlfeld</c>
    /// auferlegt. Dubletten kann es nicht geben: <c>Tab_Projekt.ID</c> ist der
    /// Schlüssel.</para>
    /// </summary>
    ///
    /// <para><b>Anwenderauftrag 13.10.2026 — Detail-Unterschiede:</b> Der erste Eintrag
    /// ist die Vorgabe „— keine (Komponentenvergleich) —“. Sie trägt die Id der
    /// Stammzeile; wer sie wählt, markiert also wie bisher den Stamm, und alle Wege,
    /// die an der Markierung hängen (Rückruf <c>ZeileMarkiert</c>, Simulationsstand und
    /// „Simulation starten“, Sperren von Umbenennen und Löschen, KI-Sicht), bleiben
    /// unverändert. Danach folgen nur die Varianten; den Stamm gibt es nicht als
    /// eigenen Eintrag mit seinem Namen.</para>
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Versionen
    {
        get
        {
            var liste = new List<(int, string)>(_stand.Zeilen.Count + 1);
            int? vorgabe = VorgabeId;
            if (vorgabe is not null) liste.Add((vorgabe.Value, VorgabeText));
            foreach (VarianteZeile z in _stand.Zeilen)
                if (!z.IstStamm) liste.Add((z.IdProjekt, Eintragstext(z)));
            return liste;
        }
    }

    /// <summary>
    /// Die Id der Vorgabe „— keine —“: die der Stammzeile, sonst (Gruppe noch nicht
    /// geladen) das gewählte Stammprojekt; <c>null</c> = es gibt keine Gruppe.
    /// </summary>
    private int? VorgabeId
    {
        get
        {
            foreach (VarianteZeile z in _stand.Zeilen)
                if (z.IstStamm) return z.IdProjekt;
            return _stand.StammId is > 0 ? _stand.StammId : null;
        }
    }

    /// <summary>Hat die Gruppe mindestens eine Variante? Sonst ist die Wahl gesperrt.</summary>
    private bool HatVarianten
    {
        get
        {
            foreach (VarianteZeile z in _stand.Zeilen)
                if (!z.IstStamm) return true;
            return false;
        }
    }

    /// <summary>Ist eine Variante gewählt (Detail-Unterschiede statt Komponentenvergleich)?</summary>
    private bool VarianteGewaehlt => Markierte is { IstStamm: false };

    /// <summary>
    /// Der Projektname (Rückfall: der Bezeichner, wenn er fehlt) — siehe
    /// <see cref="Versionen"/>.
    /// </summary>
    private static string Eintragstext(VarianteZeile z)
    {
        string projekt = z.Projektname ?? "";
        if (projekt.Length > 0) return projekt;
        return z.Bezeichner ?? "";
    }

    /// <summary>Die gewählte Version für das <c>Auswahlfeld</c>; <c>null</c> = keine.</summary>
    private int? Markierung => _stand.MarkierteId > 0 ? _stand.MarkierteId : null;

    /// <summary>Die Zeile der gewählten Version; <c>null</c> = keine.</summary>
    private VarianteZeile? Markierte
    {
        get
        {
            foreach (VarianteZeile z in _stand.Zeilen)
                if (z.IdProjekt == _stand.MarkierteId) return z;
            return null;
        }
    }

    /// <summary>
    /// Der Simulationsstand der gewählten Version als Satz: „Simulation:
    /// 05.09.26 16:23" bzw. „noch nicht simuliert". Das Warnzeichen steht daneben
    /// als eigenes Element, damit es einen Kurztext tragen kann.
    /// </summary>
    private string Simulationszeile
    {
        get
        {
            VarianteZeile? z = Markierte;
            if (z is null || string.IsNullOrEmpty(z.SimZeitpunkt)) return SimNieText;
            return SpalteSimulation + ": " + z.SimZeitpunkt;
        }
    }

    /// <summary>Warum der Stand auffällig ist: kein Ergebnis oder ein veraltetes.</summary>
    private string Simulationsgrund
    {
        get
        {
            VarianteZeile? z = Markierte;
            return z is null || string.IsNullOrEmpty(z.SimZeitpunkt)
                ? SimGrundFehlt : SimGrundVeraltet;
        }
    }

    /// <summary>
    /// Der Speicherkontext der gewählten Version als Satz: „Stromspeicher: mit
    /// Speicherflotte …" (AUFTRAG US-2). Leer, wenn die Hülle nichts lesen konnte —
    /// dann steht dort nichts, statt etwas zu behaupten.
    /// </summary>
    private string Speicherzeile
    {
        get
        {
            VarianteZeile? z = Markierte;
            if (z is null || string.IsNullOrEmpty(z.Speicher)) return "";
            return SpalteSpeicher + ": " + z.Speicher;
        }
    }

    // =====================================================================
    // Auswahl
    // =====================================================================

    private void BeiStamm(int? id)
    {
        if (id is null) return;
        StammGewechselt?.Invoke(id.Value);
        Auffrischen();
    }

    private void BeiFilter(bool an)
    {
        FilterGewechselt?.Invoke(an);
        Auffrischen();
    }

    /// <summary>
    /// Die Wahl im Auswahlfeld treibt genau das, was bis W5‑E‑1 die Zeilenwahl der
    /// Tabelle trieb: dieselbe Meldung an die Hülle, danach dasselbe Auffrischen —
    /// Unterschiedstabelle, Knopfzustände und Statuszeile kommen aus dem neuen
    /// Stand.
    /// </summary>
    private void BeiVersion(int? id)
    {
        if (id is null) return;
        ZeileMarkiert?.Invoke(id.Value);
        Auffrischen();
    }

    // =====================================================================
    // Die Vergleichswahl (Anwenderwunsch 08.09.2026, W5-B-5)
    // =====================================================================

    /// <summary>Die Versionen der Gruppe als Eintraege der Vergleichswahl; der Stamm fest.</summary>
    private IReadOnlyList<Vergleichswahl.Eintrag> Vergleichseintraege
    {
        get
        {
            var l = new List<Vergleichswahl.Eintrag>();
            foreach (VarianteZeile z in _stand.Zeilen)
                l.Add(new Vergleichswahl.Eintrag(z.IdProjekt,
                    z.IstStamm ? z.Art : (string.IsNullOrEmpty(z.Bezeichner) ? z.Projektname : z.Bezeichner),
                    z.IstStamm));
            return l;
        }
    }

    /// <summary>Die Wahl geht an die Huelle; die Gegenueberstellung kommt aus dem neuen Stand.</summary>
    private void BeiVergleich(IReadOnlyList<int> ids)
    {
        VergleichGewaehlt?.Invoke(ids);
        Auffrischen();
    }

    // =====================================================================
    // Variante anlegen, umbenennen und löschen (Anwenderauftrag 13.10.2026)
    // =====================================================================

    /// <summary>Warum „Variante anlegen…" gesperrt ist; <c>null</c> = frei.</summary>
    private string? AnlegenSperrgrund
        => !_stand.AnlegenMoeglich ? SperrgrundKeinStamm : _laeuft ? SperrgrundLaeuft : null;

    /// <summary>Warum „Umbenennen…" und „Löschen…" gesperrt sind; <c>null</c> = frei.</summary>
    private string? VariantenSperrgrund
        => !HatVarianten ? SperrgrundKeineVariante : _laeuft ? SperrgrundLaeuft : null;

    /// <summary>Der Bezeichner einer Variante — der Rückfall ist ihr Projektname.</summary>
    private static string Variantenbezeichner(VarianteZeile z)
        => string.IsNullOrEmpty(z.Bezeichner) ? (z.Projektname ?? "") : z.Bezeichner;

    /// <summary>Die Zeile zu einer Projekt-Id; <c>null</c> = nicht in der Gruppe.</summary>
    private VarianteZeile? Zeile(int id)
    {
        foreach (VarianteZeile z in _stand.Zeilen)
            if (z.IdProjekt == id) return z;
        return null;
    }

    /// <summary>Der Name des Stammprojekts (aus der Stammzeile, sonst aus der Stammwahl).</summary>
    private string Stammname
    {
        get
        {
            foreach (VarianteZeile z in _stand.Zeilen)
                if (z.IstStamm) return z.Projektname ?? "";
            foreach ((int Id, string Text) s in _stand.Staemme)
                if (s.Id == _stand.StammId) return s.Text ?? "";
            return "";
        }
    }

    /// <summary>Die Quellen des Anlegedialogs: das Stammprojekt zuerst (die Vorgabe), dann die Varianten der Gruppe.</summary>
    private IReadOnlyList<(int Id, string Text)> Quellen
    {
        get
        {
            var liste = new List<(int, string)>(_stand.Zeilen.Count + 1);
            bool mitStamm = false;
            foreach (VarianteZeile z in _stand.Zeilen)
                if (z.IstStamm) { liste.Add((z.IdProjekt, string.Format(QuelleStammFormat, z.Projektname))); mitStamm = true; }
            if (!mitStamm && _stand.StammId is > 0)
                liste.Add((_stand.StammId.Value, string.Format(QuelleStammFormat, Stammname)));
            foreach (VarianteZeile z in _stand.Zeilen)
                if (!z.IstStamm) liste.Add((z.IdProjekt, string.Format(QuelleVarianteFormat, Variantenbezeichner(z))));
            return liste;
        }
    }

    /// <summary>Die Varianten der Gruppe für Umbenennen und Löschen — nur sie, mit ihrem Bezeichner.</summary>
    private IReadOnlyList<(int Id, string Text)> Variantenliste
    {
        get
        {
            var liste = new List<(int, string)>(_stand.Zeilen.Count);
            foreach (VarianteZeile z in _stand.Zeilen)
                if (!z.IstStamm) liste.Add((z.IdProjekt, Variantenbezeichner(z)));
            return liste;
        }
    }

    /// <summary>
    /// Die Vorgabe der Variantenwahl in Umbenennen und Löschen: die unter
    /// „Detail-Unterschiede für Variante" gewählte Variante, sonst die erste der Gruppe.
    /// </summary>
    private int? VorgabeVariante
    {
        get
        {
            if (Markierte is { IstStamm: false } m) return m.IdProjekt;
            IReadOnlyList<(int Id, string Text)> l = Variantenliste;
            return l.Count > 0 ? l[0].Id : null;
        }
    }

    private string AnlegenHinweis => string.Format(AnlegenHinweisFormat ?? "", Stammname);

    private string ZielnameNeu(string bezeichner) => Zielname?.Invoke(0, bezeichner) ?? "";

    private string ZielnameUmbenannt(int id, string bezeichner) => Zielname?.Invoke(id, bezeichner) ?? "";

    /// <summary>Ein Klick auf einen weich gesperrten Knopf meldet den Grund, statt zu öffnen.</summary>
    private bool Gesperrt(string? grund)
    {
        if (grund is null) return false;
        _status = grund;
        return true;
    }

    private void AnlegenOeffnen()
    {
        if (VarianteAnlegen is null || Gesperrt(AnlegenSperrgrund)) return;
        _dialogMeldung = "";
        _anlegenOffen = true;
    }

    /// <summary>
    /// Die Antwort des Anlegedialogs: <c>null</c> schließt; sonst legt die Hülle an —
    /// scheitert das, bleibt der Dialog mit der Meldung offen; gelingt es, lädt die
    /// Seite ihren Stand neu (Liste, Versionswahl, Vergleichswahl, Komponentenbereich)
    /// und meldet in der Statuszeile. Die Vorauswahl bleibt, wie sie war.
    /// </summary>
    private void AnlegenFertig(VarianteAnlegenWahl? wahl)
    {
        if (wahl is null || VarianteAnlegen is null) { _anlegenOffen = false; _dialogMeldung = ""; return; }

        VariantenAktionErgebnis e = VarianteAnlegen(wahl.Value.QuelleId, wahl.Value.Bezeichner);
        if (!e.Gelungen) { _dialogMeldung = e.Meldung; return; }

        _anlegenOffen = false;
        _dialogMeldung = "";
        Auffrischen();
        if (!string.IsNullOrEmpty(e.Meldung)) _status = e.Meldung;
    }

    private void UmbenennenOeffnen()
    {
        if (VarianteUmbenennen is null || Gesperrt(VariantenSperrgrund)) return;
        _dialogMeldung = "";
        _umbenennenOffen = true;
    }

    /// <summary>Die Antwort des Umbenenndialogs — derselbe Weg wie beim Anlegen.</summary>
    private void UmbenennenFertig(VarianteUmbenennenWahl? wahl)
    {
        if (wahl is null || VarianteUmbenennen is null) { _umbenennenOffen = false; _dialogMeldung = ""; return; }

        VariantenAktionErgebnis e = VarianteUmbenennen(wahl.Value.VarianteId, wahl.Value.Bezeichner);
        if (!e.Gelungen) { _dialogMeldung = e.Meldung; return; }

        _umbenennenOffen = false;
        _dialogMeldung = "";
        Auffrischen();
        if (!string.IsNullOrEmpty(e.Meldung)) _status = e.Meldung;
    }

    private void LoeschenOeffnen()
    {
        if (VarianteLoeschen is null || Gesperrt(VariantenSperrgrund)) return;
        _loeschenOffen = true;
    }

    /// <summary>
    /// Die Antwort des Löschdialogs: die gewählte Variante. Gelöscht wird noch nicht —
    /// erst stellt die Seite die unveränderte Rückfrage (und danach die zweite bei
    /// mehrdeutigem Namen).
    /// </summary>
    private void LoeschenFertig(int? id)
    {
        _loeschenOffen = false;
        if (id is null || id.Value <= 0 || LoeschFrage is null) return;

        string frage = LoeschFrage(id.Value);
        if (string.IsNullOrEmpty(frage)) return;
        _loeschId = id.Value;
        _loeschfrage = frage;
        _loeschfrageOffen = true;
    }

    /// <summary>
    /// Die Antwort auf die unveränderte Löschfrage — und die Stelle, an der der
    /// Löschweg nach einem MEHRDEUTIGEN Projektnamen fragt (Entscheid O-4 vom
    /// 04.09.2026, dieselbe Rückfrage wie im <c>ProjektWahlDialog</c>).
    ///
    /// <para>Regulär trägt ein Name genau ein Projekt: <c>Tab_Projekt</c> hat den
    /// eindeutigen Index <c>Projektname</c>. Ein Altbestand ohne ihn kann den Fall
    /// führen, und weil der letzte Schritt der Variantenlöschung über den NAMEN läuft,
    /// träfe er dann beide Projekte. Deshalb: nachfragen. „Nein" lässt die Seite
    /// stehen, wie bei der Löschfrage selbst.</para>
    /// </summary>
    private void LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrageOffen = false;
        if (antwort != true || VarianteLoeschen is null) return;

        if (NamensAnzahl is not null && !string.IsNullOrEmpty(MehrdeutigFormat))
        {
            _anzahlGleicher = NamensAnzahl(LoeschProjektname);
            if (_anzahlGleicher > 1)
            {
                _mehrdeutigOffen = true;
                return;
            }
        }

        Loeschen(false);
    }

    private void MehrdeutigBeantwortet(bool? antwort)
    {
        _mehrdeutigOffen = false;
        if (antwort != true) return;          // "Nein" laesst die Seite stehen
        Loeschen(true);
    }

    private void Loeschen(bool alleGleichenNamens)
    {
        if (VarianteLoeschen is null || _loeschId <= 0) return;

        string meldung = VarianteLoeschen(_loeschId, alleGleichenNamens);
        _loeschId = 0;
        Auffrischen();
        if (!string.IsNullOrEmpty(meldung)) _status = meldung;
    }

    /// <summary>Der Projektname der zu löschenden Variante (leer, wenn keine gewählt ist).</summary>
    private string LoeschProjektname => Zeile(_loeschId)?.Projektname ?? "";

    private string MehrdeutigFrage
        => string.Format(MehrdeutigFormat ?? "", LoeschProjektname, _anzahlGleicher);

    // =====================================================================
    // Simulation
    // =====================================================================

    private async Task Simulieren()
    {
        if (_laeuft || Simulation is null) return;

        _laeuft = true;
        _meldung = "";
        _hinweise = Array.Empty<string>();
        StateHasChanged();
        try
        {
            LaufErgebnis erg = await Simulation(Melden);

            if (erg.Abgebrochen) { _status = StatusAbgebrochen; return; }

            Auffrischen();

            // Der Vorlaeufer zeigte das Protokoll als MessageBox; hier steht
            // es als Meldung im Fenster.
            // Traegt der Lauf seinen Kopf gesondert, steht er im Banner und die
            // Hinweise im Klapper; sonst die Meldung wie bisher.
            if (!string.IsNullOrEmpty(erg.Meldungskopf))
            {
                _meldung = erg.Meldungskopf;
                _hinweise = erg.Laufhinweise ?? Array.Empty<string>();
            }
            else
            {
                _meldung = erg.Meldung ?? "";
                _hinweise = Array.Empty<string>();
            }
            if (!string.IsNullOrEmpty(erg.Statuszeile)) _status = erg.Statuszeile;
        }
        finally
        {
            _laeuft = false;
            StateHasChanged();
        }
    }

    private void Melden(Laufschritt s)
    {
        _ = InvokeAsync(() =>
        {
            _status = s.Gesamt > 0 ? $"({s.Aktuell}/{s.Gesamt}) {s.Text}" : s.Text;
            StateHasChanged();
        });
    }

    // =====================================================================
    // Übernahme
    // =====================================================================

    private void UebernahmeOeffnen(VergleichZeile z)
    {
        if (UebernahmeGaben is null) return;

        IReadOnlyDictionary<string, object>? gaben = UebernahmeGaben(z);
        if (gaben is null) return;

        _uebernahmezeile = z;
        _gaben = gaben;
    }

    private void UebernahmeFertig(BkUebernahmeErgebnis? ergebnis)
    {
        VergleichZeile? zeile = _uebernahmezeile;
        _uebernahmezeile = null;
        _gaben = null;

        if (ergebnis is null || zeile is null || Uebernehmen is null) return;

        string meldung = Uebernehmen(zeile, ergebnis.QuelleId);
        Auffrischen();
        if (!string.IsNullOrEmpty(meldung)) _status = meldung;
    }
}
