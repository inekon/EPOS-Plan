@* DIE EINE PROJEKT/DATENBANK-AUSWAHL DES HAUSES in der Variante V1 „Gerahmt und
   gestapelt" (Konzept_Projektdialoge_Katalogauswahl, Entscheide KA-E-1 bis KA-E-11,
   Zielbild 4.1 bis 4.8). Ein Baustein fuer alle Projektdialoge mit Katalogauswahl.

   AUFBAU (4.1). Oben der Bereich „Im Projekt", darunter die ziehbare Trennlinie,
   darunter „Katalog (Datenbank)", unten die Detailzeile „gewaehlter Satz". Jeder
   Bereich ist gerahmt und hat eine Kopfleiste mit Marke und seinen Knoepfen; die
   obere Rahmenkante und die Marke tragen die Kennfarbe (KA-E-10), die Knoepfe nicht -
   ihr Ort sagt, worauf sie wirken: „Aus dem Projekt entfernen" in der Kopfleiste des
   Projekts, „In das Projekt uebernehmen" in der des Katalogs.

   KEIN ROLLBEREICH IM ROLLBEREICH. Steht der Dialog im eigenen Fenster oder in einer
   Ueberlagerung, nimmt er deren Hoehe, und der Baustein teilt den Rest als Raster
   (epos-ui.css, Abschnitt „Katalogauswahl V1"): Es rollen genau die Projektliste, die
   Katalogliste und die aufgeklappte Detailzeile, keiner im anderen; Dokument und
   Dialogkoerper rollen nicht.

   TRENNLINIE (4.3). Ziehen (Skript epos-zweispalten.js), Pfeil hoch/runter um eine
   Zeile, Pos1/Ende an die Grenzen, Doppelklick stellt die Vorgabe her. Die Hoehe der
   Projektliste wird je Dialog ueber WindowsFormsApplication1.Dienste.Einstellungen gemerkt
   (Katalogauswahl.Trenner.<Dialogname>); ohne Ablage gilt die Vorgabe.

   DETAILZEILE (4.4). Zugeklappt beim Oeffnen; aufgeklappt rollt sie in sich und nimmt
   den Listen Hoehe ab. Ihr Inhalt (Abschnitt Satz) bleibt im Baum, auch zugeklappt -
   er traegt Zustand des Wirts (Felder, eingebettete Ansichten), und ein Ab- und
   Aufbau bei jedem Klappen verloere ihn. Nur waehrend die Satz-Ueberlagerung offen ist,
   steht er dort statt hier.

   ZUSAMMENFASSUNG (4.4, UeS2). Reicht der Wirt SatzZusammenfassung, zeigt die aufgeklappte
   Detailzeile nur diese Kurzangaben (ohne Vorrang, die Listen behalten ihre Aufteilung), der
   Kopf traegt „Bearbeiten" statt „Details" und „Vergroessern", und das Fragment Satz steht nur
   noch in der Satz-Ueberlagerung.

   SATZ-UEBERLAGERUNG (4.4, 4.6, UeS1). „Vergroessern" im Kopf der Detailzeile und die
   oeffentliche Methode SatzUeberlagerungOeffnen (Knoepfe „Bearbeiten…" des Wirts) zeigen den
   Satz als Ueberlagerung ueber dem ganzen Dialog: Kopf mit Marke, Name und Kenndaten, Koerper
   mit DEMSELBEN Fragment Satz (es steht dann nicht mehr in der Detailzeile - zu jedem
   Zeitpunkt an genau einer Stelle), Fussleiste OK / Abbrechen (nur lesen: Schliessen). Nur der
   Koerper rollt. OK ruft SatzUebernommen, Abbrechen, ✕ und Esc rufen SatzVerworfen; danach
   schliesst der Baustein.

   MEHRFACHWAHL (4.5). Reicht der Wirt je Bereich eine Bereichswahl und die
   Schluessel der gefilterten Liste, nennt die Kopfleiste „n gewaehlt, m verborgen",
   und Wahlkaestchen in der Liste (Zeile und Kopfhaekchen) rechnen ueber den Baustein.

   TASTATUR (4.7). Enter in der Katalogliste und Doppelklick auf eine Katalogzeile
   uebernehmen; Enter in der Projektliste klappt die Detailzeile auf; Entf in der
   Projektliste entfernt; Strg+A waehlt die gefilterte Liste; Esc klappt zuerst die
   Detailzeile zu, dann gilt das Esc des Dialogs. *@

@namespace EPOS.UI.Bausteine
@using Microsoft.AspNetCore.Components.Sections
@using Microsoft.JSInterop
@using WindowsFormsApplication1
@inject IJSRuntime Js
@implements IAsyncDisposable

<CascadingValue Value="this" IsFixed="true">
<div class="@Wurzelklasse" style="@Wurzelstil" @ref="_wurzel">

    @if (!NurRechts)
    {
        @* ------------------------------------------ oben: das Projekt ----- *@
        <section class="epos-zweispalten-bereich epos-zweispalten-bereich--projekt epos-zweispalten-spalte epos-zweispalten-spalte--oben"
                 role="group" aria-label="@LinksTitel" data-mehrfach="@(ProjektWahl is null ? null : "1")">
            <div class="epos-zweispalten-kopfleiste">
                <span class="epos-zweispalten-marke epos-zweispalten-marke--projekt">@ProjektMarke</span>
                <h2 class="epos-untergruppe epos-zweispalten-titel" title="@LinksTitel">@LinksTitel</h2>
                @if (Wahltext(ProjektWahl, ProjektSichtbar) is string pz)
                {
                    <span class="epos-zweispalten-wahlzahl" role="status">@pz</span>
                }
                @ProjektKopf
                <span class="epos-leiste-fueller"></span>
                @* Ein Wirt kann weitere Knoepfe anhaengen, die auf die Auswahl der
                   Projektliste wirken (Gebaeudedialog: „In DB uebernehmen"). *@
                @Leistenzusatz
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-zweispalten-knopf--richtung epos-zweispalten-knopf--entfernen"
                        title="@EntfernenHinweis" disabled="@EntfernenGesperrt"
                        @onclick="Entfernen">
                    <span class="epos-zweispalten-pfeil" aria-hidden="true">▼</span>
                    <span class="epos-zweispalten-knopftext">@EntfernenText</span>
                </button>
            </div>
            <div class="epos-zweispalten-inhalt">
                @Links
            </div>
        </section>

        @* ------------------------------------------ die Trennlinie -------- *@
        <div class="epos-zweispalten-trenner" role="separator" aria-orientation="horizontal"
             tabindex="0" aria-label="@Resource.AUSWAHL_TRENNER" title="@Resource.AUSWAHL_TRENNER_HINWEIS"
             aria-valuenow="@_hoehe" aria-valuemin="@MINDESTHOEHE"
             @onkeydown="BeiTrennerTaste" @ondblclick="BeiTrennerDoppelklick"></div>
    }

    @* ---------------------------------------------- der Katalog ----------- *@
    <section class="epos-zweispalten-bereich epos-zweispalten-bereich--katalog epos-zweispalten-spalte epos-zweispalten-spalte--unten"
             role="group" aria-label="@RechtsTitel" data-mehrfach="@(KatalogWahl is null ? null : "1")">
        <div class="epos-zweispalten-kopfleiste">
            <span class="epos-zweispalten-marke epos-zweispalten-marke--katalog">@KatalogMarke</span>
            <h2 class="epos-untergruppe epos-zweispalten-titel" title="@RechtsTitel">@RechtsTitel</h2>
            @if (Wahltext(KatalogWahl, KatalogSichtbar) is string kz)
            {
                <span class="epos-zweispalten-wahlzahl" role="status">@kz</span>
            }
            @* SUCHE, TREFFERZAHL, FILTER ZURUECKSETZEN (4.2, Ort K-Kopf links): Die
               Katalogliste im Abschnitt Rechts reicht ihre Suchzeile hierher - eine Zeile
               Hoehe weniger fuer jeden Wirt (Konzept 4.8). *@
            <SectionOutlet SectionId="Suchort" />
            @KatalogKopf
            <span class="epos-leiste-fueller"></span>
            @if (!NurRechts)
            {
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-zweispalten-knopf--richtung epos-zweispalten-knopf--uebernehmen"
                        title="@UebernehmenHinweis" disabled="@UebernehmenGesperrt"
                        @onclick="Uebernehmen">
                    <span class="epos-zweispalten-pfeil" aria-hidden="true">▲</span>
                    <span class="epos-zweispalten-knopftext">@UebernehmenText</span>
                </button>
            }
        </div>
        <div class="epos-zweispalten-inhalt">
            <CascadingValue Name="@KOPFLEISTENORT" Value="Suchort" IsFixed="true">
                @Rechts
            </CascadingValue>
        </div>
        @if (KatalogFuss is not null || KatalogFussRechts is not null)
        {
            @* DIE FUSSLEISTE DES KATALOGS (4.2, Ort K-Fuss): der gewaehlte Name, dann die
               Knoepfe, die auf die Auswahl des Katalogs wirken; rechts Neu…. Bei
               Mehrfachauswahl steht statt des Namens die Zahl („3 Saetze:"). *@
            <div class="epos-zweispalten-fussleiste" role="group" aria-label="@RechtsTitel">
                @if (Fussname is string fn)
                {
                    <span class="epos-zweispalten-fussname" title="@fn">@fn</span>
                }
                @KatalogFuss
                <span class="epos-leiste-fueller"></span>
                @KatalogFussRechts
            </div>
        }
    </section>

    @* ---------------------------------------------- der gewaehlte Satz --- *@
    @if (Satz is not null)
    {
        <section class="epos-zweispalten-bereich epos-zweispalten-bereich--satz"
                 role="group" aria-label="@Resource.AUSWAHL_MARKE_SATZ">
            <div class="epos-zweispalten-satzkopf">
                <button type="button" class="epos-zweispalten-satzzeile" aria-expanded="@(SatzflaecheOffen ? "true" : "false")"
                        title="@Resource.AUSWAHL_SATZ_HINWEIS" @onclick="SatzUmschalten" @ref="_satzzeile">
                    <span class="epos-zweispalten-satzpfeil" aria-hidden="true">@(SatzflaecheOffen ? "▾" : "▸")</span>
                    <span class="epos-zweispalten-marke epos-zweispalten-marke--satz">@SatzMarke</span>
                    <span class="epos-zweispalten-satzname">@(string.IsNullOrEmpty(SatzName) ? Resource.AUSWAHL_SATZ_LEER : SatzName)</span>
                    @if (!string.IsNullOrEmpty(SatzKenndaten))
                    {
                        <span class="epos-zweispalten-satzkenndaten">@SatzKenndaten</span>
                    }
                    <span class="epos-leiste-fueller"></span>
                    @if (SatzZusammenfassung is null)
                    {
                        <span class="epos-zweispalten-satzdetails">@Resource.AUSWAHL_SATZ_DETAILS</span>
                    }
                </button>
                @if (SatzKopfKnoepfe is not null && !_satzGross)
                {
                    @* KOPFKNOEPFE DES WIRTS (UeS2b): seine Infoknoepfe „Grundlagen" und „Berechnung" -
                       ohne Ueberlagerung erreichbar. Steht die Satz-Ueberlagerung offen, traegt sie
                       ihr Fragment samt Knoepfen; dann fehlen sie hier (eine Stelle je Ansicht). *@
                    <span class="epos-zweispalten-satzkopfknoepfe">@SatzKopfKnoepfe</span>
                }
                @if (SatzZusammenfassung is not null)
                {
                    @* BEARBEITEN (UeS2): ersetzt „Details" und „Vergroessern" - derselbe Weg in die
                       Satz-Ueberlagerung; beim gesperrten Katalogsatz nur lesend. *@
                    <button type="button" class="epos-knopf epos-zweispalten-knopf epos-zweispalten-bearbeiten"
                            title="@(SatzNurLesen ? Resource.AUSWAHL_SATZ_ANSEHEN_HINWEIS : Resource.AUSWAHL_SATZ_BEARBEITEN_HINWEIS)"
                            aria-label="@Resource.AUSWAHL_SATZ_BEARBEITEN"
                            disabled="@(SatzArt == Satzmarke.Keiner || _satzGross)" @onclick="SatzUeberlagerungOeffnen">
                        <svg class="epos-zeilenstift-bild" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
                            <path d="M11.3 1.6a1.5 1.5 0 0 1 2.1 0l1 1a1.5 1.5 0 0 1 0 2.1L5.6 13.5 1.8 14.2l.7-3.8z M10.2 2.7l3.1 3.1"
                                  fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
                        </svg>
                        <span class="epos-zweispalten-knopftext">@Resource.AUSWAHL_SATZ_BEARBEITEN</span>
                    </button>
                }
                else
                {
                    @* VERGROESSERN (UeS1): derselbe Satz als Ueberlagerung ueber dem ganzen Dialog. *@
                    <button type="button" class="epos-knopf epos-zweispalten-knopf epos-zweispalten-vergroessern"
                            title="@Resource.AUSWAHL_SATZ_VERGROESSERN_HINWEIS" aria-label="@Resource.AUSWAHL_SATZ_VERGROESSERN"
                            disabled="@(SatzArt == Satzmarke.Keiner || _satzGross)" @onclick="SatzUeberlagerungOeffnen">
                        <span class="epos-zweispalten-pfeil" aria-hidden="true">⤢</span>
                        <span class="epos-zweispalten-knopftext">@Resource.AUSWAHL_SATZ_VERGROESSERN</span>
                    </button>
                }
            </div>
            @if (SatzZusammenfassung is not null)
            {
                @* DIE ZUSAMMENFASSUNG (UeS2): nur Kurzangaben, hoechstens drei Zeilen, kein
                   Rollbereich und kein Vorrang - die Listen behalten ihre Aufteilung. Das
                   Fragment Satz steht dann ausschliesslich in der Satz-Ueberlagerung. *@
                <div class="epos-zweispalten-satz epos-zweispalten-satz--zusammenfassung" hidden="@(!SatzflaecheOffen)">
                    @if (SatzZusammenfassung.Count == 0)
                    {
                        <p class="epos-zweispalten-satzleer">@Resource.AUSWAHL_SATZ_LEER</p>
                    }
                    else
                    {
                        <dl class="epos-satzzusammenfassung" aria-label="@Resource.AUSWAHL_SATZ_ZUSAMMENFASSUNG">
                            @foreach (Satzangabe angabe in SatzZusammenfassung)
                            {
                                <div class="epos-satzzusammenfassung-angabe" title="@(angabe.Beschriftung + ": " + angabe.Wert)">
                                    <dt>@angabe.Beschriftung</dt>
                                    <dd>@angabe.Wert</dd>
                                </div>
                            }
                        </dl>
                    }
                </div>
            }
            else
            {
                <div class="epos-zweispalten-satz" hidden="@(!SatzflaecheOffen)">
                    @* Das Fragment steht zu jedem Zeitpunkt an GENAU einer Stelle: hier oder in
                       der Satz-Ueberlagerung. *@
                    @if (!_satzGross)
                    {
                        @Satz
                    }
                </div>
            }
        </section>
    }

</div>

@* ---------------------------------------------- die Satz-Ueberlagerung (UeS1) -----
   AUSSERHALB der Wurzel: Die Wurzel ist ein Groessencontainer (container: katalogauswahl /
   size), und Layout-Containment machte sie zum umschliessenden Block jedes position:fixed -
   die Ueberlagerung stuende dann im Baustein statt ueber dem ganzen Dialog. *@
@if (Satz is not null)
{
    <Ueberlagerung Offen="@_satzGross" Titel="@(string.IsNullOrEmpty(SatzName) ? Resource.AUSWAHL_SATZ_LEER : SatzName)"
                   Zusatzklasse="epos-ueberlagerung--satz" Geschlossen="SatzVerwerfenAsync"
                   SchliessenText="@(SatzNurLesen ? Resource.SATZBEARB_SCHLIESSEN : Resource.ALLG_BTN_ABBRECHEN)">
        <Kopfzusatz>
            <span class="epos-zweispalten-marke epos-zweispalten-marke--satz">@SatzMarke</span>
        </Kopfzusatz>
        <Kopfnachsatz>
            @if (!string.IsNullOrEmpty(SatzKenndaten))
            {
                <span class="epos-satzueberlagerung-kenndaten" title="@SatzKenndaten">@SatzKenndaten</span>
            }
        </Kopfnachsatz>
        <KindInhalt>
            <div class="epos-satzueberlagerung">
                <div class="epos-satzueberlagerung-koerper">
                    @if (_satzGross)
                    {
                        @Satz
                    }
                </div>
                <div class="epos-leiste epos-satzueberlagerung-fuss">
                    @if (SatzNurLesen)
                    {
                        <span class="epos-satzueberlagerung-hinweis" role="note">@Resource.SATZBEARB_NUR_LESEN @Resource.ADM_SCHLOSS_ERST_AUFHEBEN</span>
                    }
                    else if (!string.IsNullOrEmpty(SatzFehler))
                    {
                        <span class="epos-satzueberlagerung-hinweis epos-status--fehler" role="alert">@SatzFehler</span>
                    }
                    <span class="epos-leiste-fueller"></span>
                    @if (SatzNurLesen)
                    {
                        <button type="button" class="epos-knopf epos-knopf--primaer epos-satzueberlagerung-schliessen"
                                @onclick="SatzVerwerfenAsync">@Resource.SATZBEARB_SCHLIESSEN</button>
                    }
                    else
                    {
                        <button type="button" class="epos-knopf epos-satzueberlagerung-abbrechen"
                                @onclick="SatzVerwerfenAsync">@Resource.ALLG_BTN_ABBRECHEN</button>
                        <button type="button" class="epos-knopf epos-knopf--primaer epos-satzueberlagerung-ok"
                                disabled="@SatzUebernehmenGesperrt" @onclick="SatzUebernehmenAsync">@Resource.ALLG_BTN_OK</button>
                    }
                </div>
            </div>
        </KindInhalt>
    </Ueberlagerung>
}
</CascadingValue>

@code {
    // =====================================================================
    // Die Bereiche
    // =====================================================================

    /// <summary>Überschrift des Projektbereichs („ausgewählt im Projekt").</summary>
    [Parameter] public string LinksTitel { get; set; } = "";

    /// <summary>
    /// Inhalt des Projektbereichs: die Projektliste und, was unmittelbar zu ihr gehört.
    /// Der Name bleibt <c>Links</c> — die Rolle (Projektbereich) hat sich nicht geändert.
    /// </summary>
    [Parameter] public RenderFragment? Links { get; set; }

    /// <summary>Überschrift des Katalogbereichs („aus der Datenbank").</summary>
    [Parameter] public string RechtsTitel { get; set; } = "";

    /// <summary>
    /// Inhalt des Katalogbereichs: die Katalogliste samt Suchzeile und darunter die
    /// Fußleiste mit den Katalogknöpfen.
    /// </summary>
    [Parameter] public RenderFragment? Rechts { get; set; }

    /// <summary>Weitere Inhalte der Projekt-Kopfleiste links vom Füller (Summe, Modulzahl).</summary>
    [Parameter] public RenderFragment? ProjektKopf { get; set; }

    /// <summary>Weitere Inhalte der Katalog-Kopfleiste links vom Füller.</summary>
    [Parameter] public RenderFragment? KatalogKopf { get; set; }

    /// <summary>
    /// Knöpfe der Katalog-Fußleiste nach dem gewählten Namen (Vergleichen…, Schloss…,
    /// Löschen, Bearbeiten…) — sie wirken auf die Auswahl des Katalogs (4.2).
    /// </summary>
    [Parameter] public RenderFragment? KatalogFuss { get; set; }

    /// <summary>Knöpfe rechts in der Katalog-Fußleiste (Neu…, Import…, Speichern unter…).</summary>
    [Parameter] public RenderFragment? KatalogFussRechts { get; set; }

    /// <summary>
    /// Name des gewählten Katalogsatzes am Anfang der Fußleiste; bei mehr als einer gewählten
    /// Zeile nennt die Leiste stattdessen die Zahl.
    /// </summary>
    [Parameter] public string? KatalogFussName { get; set; }

    /// <summary>
    /// <b>Höhe einer Katalogzeile in px</b>, wenn der Wirt die Katalogliste mit eigenem
    /// Zeilenmaß führt (Kästchenmodus: <c>Katalogliste.ZEILENHOEHE_ZEILENWAHL</c>, 46 px). Gesetzt
    /// hält der Baustein Kopf und ZWEI Katalogzeilen auch in kleinen Fenstern (Konzept 4.8,
    /// Entscheid zu 1 280 × 720 und 1 024 × 700); 0 = die Regel von Stufe 1 (unter 600 px
    /// Bausteinhöhe Kopf und eine Zeile).
    /// </summary>
    [Parameter] public int KatalogZeile { get; set; }

    /// <summary>Name des kaskadierten Orts der Suchzeile (Katalogliste → Katalog-Kopfleiste).</summary>
    public const string KOPFLEISTENORT = "Katalogkopfleiste";

    /// <summary>Der Ort, an den die Katalogliste ihre Suchzeile reicht (je Baustein eindeutig).</summary>
    public object Suchort { get; } = new();

    private string? Fussname
    {
        get
        {
            if (KatalogWahl is { Anzahl: > 1 } w)
                return string.Format(Resource.Culture, Resource.AUSWAHL_FUSS_SAETZE, w.Anzahl);
            return string.IsNullOrEmpty(KatalogFussName) ? null : KatalogFussName + ":";
        }
    }

    /// <summary>
    /// Verwaltungsbetriebsart: nur der Katalog. Projektbereich und Trennlinie entfallen,
    /// der Katalog erbt die Höhe.
    /// </summary>
    [Parameter] public bool NurRechts { get; set; }

    /// <summary>Zusätzliche Klasse am Wirt, falls ein Dialog nachstellen muss.</summary>
    [Parameter] public string? Zusatzklasse { get; set; }

    /// <summary>
    /// <b>Name des Wirts</b> für die gemerkte Höhe der Trennlinie
    /// (<c>Katalogauswahl.Trenner.&lt;Dialogname&gt;</c>, Konzept 7 Nr. 4). Leer: nichts
    /// wird gemerkt, es gilt die Vorgabe.
    /// </summary>
    [Parameter, EditorRequired] public string Dialogname { get; set; } = "";

    // =====================================================================
    // Die zwei Richtungsknoepfe
    // =====================================================================

    /// <summary>Beschriftung des Übernahmeknopfes — <c>AUSWAHL_BTN_UEBERNEHMEN</c>.</summary>
    [Parameter] public string UebernehmenText { get; set; } = Resource.AUSWAHL_BTN_UEBERNEHMEN;

    /// <summary>Kurztext des Übernahmeknopfes — <c>AUSWAHL_BTN_UEBERNEHMEN_HINWEIS</c>.</summary>
    [Parameter] public string UebernehmenHinweis { get; set; } = Resource.AUSWAHL_BTN_UEBERNEHMEN_HINWEIS;

    /// <summary>Gesperrt, solange im Katalog keine Zeile markiert ist.</summary>
    [Parameter] public bool UebernehmenGesperrt { get; set; }

    /// <summary>Der Klick auf „in das Projekt übernehmen" — auch Enter und Doppelklick im Katalog.</summary>
    [Parameter] public EventCallback Uebernehmen { get; set; }

    /// <summary>Beschriftung des Entfernenknopfes — <c>AUSWAHL_BTN_ENTFERNEN</c>.</summary>
    [Parameter] public string EntfernenText { get; set; } = Resource.AUSWAHL_BTN_ENTFERNEN;

    /// <summary>Kurztext des Entfernenknopfes — <c>AUSWAHL_BTN_ENTFERNEN_HINWEIS</c>.</summary>
    [Parameter] public string EntfernenHinweis { get; set; } = Resource.AUSWAHL_BTN_ENTFERNEN_HINWEIS;

    /// <summary>Gesperrt, solange in der Projektliste keine Zeile markiert ist.</summary>
    [Parameter] public bool EntfernenGesperrt { get; set; }

    /// <summary>Der Klick auf „aus dem Projekt entfernen" — auch Entf in der Projektliste.</summary>
    [Parameter] public EventCallback Entfernen { get; set; }

    /// <summary>
    /// Weitere Knöpfe der Projekt-Kopfleiste vor „Entfernen" — etwa „In DB übernehmen" des
    /// Gebäudedialogs. Sie wirken auf die Auswahl der Projektliste.
    /// </summary>
    [Parameter] public RenderFragment? Leistenzusatz { get; set; }

    // =====================================================================
    // Die Detailzeile „gewaehlter Satz" (4.4)
    // =====================================================================

    /// <summary>Inhalt der aufgeklappten Detailzeile („Alle Daten", Kosten, Felder). Ohne ihn fehlt die Zeile.</summary>
    [Parameter] public RenderFragment? Satz { get; set; }

    /// <summary>Welcher Satz gezeigt wird — die Marke sagt „Projektsatz" oder „Katalogsatz".</summary>
    [Parameter] public Satzmarke SatzArt { get; set; }

    /// <summary>Name des gewählten Satzes in der zugeklappten Zeile.</summary>
    [Parameter] public string? SatzName { get; set; }

    /// <summary>Die wichtigsten Kenndaten des Satzes in einer Zeile.</summary>
    [Parameter] public string? SatzKenndaten { get; set; }

    /// <summary>
    /// <b>Die Kurzangaben des gewählten Satzes</b> (UeS2). Gesetzt zeigt die aufgeklappte
    /// Detailzeile NUR diese Angaben (kompaktes Raster, höchstens drei Zeilen, ohne Vorrang),
    /// der Kopf trägt „Bearbeiten" statt „Details" und „Vergrößern", und das Fragment
    /// <see cref="Satz"/> wird ausschließlich in der Satz-Überlagerung gezeichnet. Ohne sie
    /// (Ganglinien-Wirte) bleibt die Detailzeile wie in UeS1. Eine leere Liste zeigt
    /// „kein Satz gewählt".
    /// </summary>
    [Parameter] public IReadOnlyList<Satzangabe>? SatzZusammenfassung { get; set; }

    /// <summary>
    /// <b>Knöpfe des Wirts im Kopf der Detailzeile</b> (UeS2b), rechts vor „Bearbeiten" bzw.
    /// „Vergrößern": die Infoknöpfe „Grundlagen" und „Berechnung", die sonst nur im Fragment
    /// <see cref="Satz"/> stünden — mit Zusammenfassung also nur in der Überlagerung. Solange die
    /// Satz-Überlagerung offen ist, zeichnet der Baustein sie nicht (das Fragment trägt dann
    /// seine eigenen); so steht jeder Knopf je Ansicht an genau einer Stelle.
    /// </summary>
    [Parameter] public RenderFragment? SatzKopfKnoepfe { get; set; }

    /// <summary>Die Detailzeile wurde auf- oder zugeklappt.</summary>
    [Parameter] public EventCallback<bool> SatzGeklappt { get; set; }

    // =====================================================================
    // Die Satz-Ueberlagerung (UeS1, Anwenderentscheid 10.10.2026)
    // =====================================================================

    /// <summary>
    /// Der Satz ist nur lesbar (gesperrter Katalogsatz): Die Fußleiste der Überlagerung trägt
    /// nur „Schließen" und den Hinweis „Erst Schloss aufheben".
    /// </summary>
    [Parameter] public bool SatzNurLesen { get; set; }

    /// <summary>OK der Überlagerung ist gesperrt (ein Feld meldet eine Fehleingabe).</summary>
    [Parameter] public bool SatzUebernehmenGesperrt { get; set; }

    /// <summary>Grund einer gescheiterten Übernahme, links in der Fußleiste der Überlagerung.</summary>
    [Parameter] public string? SatzFehler { get; set; }

    /// <summary>
    /// Die Überlagerung ist soeben aufgegangen („Vergrößern" oder <see cref="SatzUeberlagerungOeffnen"/>):
    /// Der Wirt zeigt alle Felder (etwa „Alle Daten" aufgeklappt und frisch gelesen).
    /// </summary>
    [Parameter] public EventCallback SatzVergroessert { get; set; }

    /// <summary>
    /// OK: Der Wirt schreibt den Satz über seinen Speicherweg. Danach schließt der Baustein
    /// die Überlagerung — es sei denn, der Wirt ruft im Rückruf <see cref="SatzOffenHalten"/>
    /// (Speichern abgelehnt: der Stand bleibt zum Verbessern stehen).
    /// </summary>
    [Parameter] public EventCallback SatzUebernommen { get; set; }

    /// <summary>
    /// Abbrechen, ✕, Esc und im Nur-lesen-Fall „Schließen": Der Wirt verwirft die Änderungen
    /// (Satz neu laden). Danach schließt der Baustein die Überlagerung.
    /// </summary>
    [Parameter] public EventCallback SatzVerworfen { get; set; }

    /// <summary>Steht die Satz-Überlagerung offen?</summary>
    public bool SatzUeberlagerungOffen => _satzGross;

    private bool _satzGross;
    private bool _offenHalten;

    /// <summary>Die Satzfläche der Detailzeile ist sichtbar aufgeklappt (nicht bei offener Überlagerung).</summary>
    private bool SatzflaecheOffen => _satzOffen && !_satzGross;

    /// <summary>
    /// Öffnet den gewählten Satz als Überlagerung über dem ganzen Dialog — der Weg der Knöpfe
    /// „Bearbeiten…" des Wirts und des Knopfes „Vergrößern" der Detailzeile.
    /// </summary>
    public async Task SatzUeberlagerungOeffnen()
    {
        if (Satz is null || _satzGross) return;
        _satzGross = true;
        if (SatzVergroessert.HasDelegate) await SatzVergroessert.InvokeAsync();
        StateHasChanged();
    }

    /// <summary>Im Rückruf <see cref="SatzUebernommen"/>: die Überlagerung bleibt offen.</summary>
    public void SatzOffenHalten() => _offenHalten = true;

    private async Task SatzUebernehmenAsync()
    {
        if (SatzNurLesen || SatzUebernehmenGesperrt) return;
        _offenHalten = false;
        if (SatzUebernommen.HasDelegate) await SatzUebernommen.InvokeAsync();
        if (_offenHalten) { _offenHalten = false; return; }
        _satzGross = false;
    }

    private async Task SatzVerwerfenAsync()
    {
        if (!_satzGross) return;
        if (SatzVerworfen.HasDelegate) await SatzVerworfen.InvokeAsync();
        _satzGross = false;
    }

    // =====================================================================
    // Die Mehrfachwahl (4.5)
    // =====================================================================

    /// <summary>Die Wahl der Projektliste; ohne sie gibt es dort keine Mehrfachwahl.</summary>
    [Parameter] public Bereichswahl? ProjektWahl { get; set; }

    /// <summary>Schlüssel der sichtbaren (gefilterten) Projektzeilen in Anzeigereihenfolge.</summary>
    [Parameter] public IReadOnlyList<string>? ProjektSichtbar { get; set; }

    /// <summary>Die Wahl der Katalogliste; ohne sie gibt es dort keine Mehrfachwahl.</summary>
    [Parameter] public Bereichswahl? KatalogWahl { get; set; }

    /// <summary>Schlüssel der sichtbaren (gefilterten) Katalogzeilen in Anzeigereihenfolge.</summary>
    [Parameter] public IReadOnlyList<string>? KatalogSichtbar { get; set; }

    /// <summary>Eine Wahl hat sich geändert (Kästchen, Kopfhäkchen, Strg+A).</summary>
    [Parameter] public EventCallback<Auswahlbereich> WahlGeaendert { get; set; }

    // =====================================================================
    // Masse der Trennlinie (4.3)
    // =====================================================================

    /// <summary>Höhe des Listenkopfs der Projektliste in px (Spaltenkopf ohne Trichter, gemessen 29,9 px).</summary>
    public const int LISTENKOPF = 30;

    /// <summary>Höhe des Listenkopfs der Katalogliste in px (Spaltenkopf mit Sortierpfeil und Trichter, gemessen 53 px).</summary>
    public const int KATALOG_LISTENKOPF = 53;

    /// <summary>Höhe einer Listenzeile in px (<c>Raster.ZEILENHOEHE</c>) — ein Pfeilschritt der Trennlinie.</summary>
    public const int ZEILE = 53;

    /// <summary>Untergrenze der Projektliste: Kopfzeile und eine Zeile.</summary>
    public const int MINDESTHOEHE = LISTENKOPF + ZEILE + 2;

    /// <summary>Vorgabe der Projektliste: Kopfzeile und zwei Zeilen.</summary>
    public const int VORGABEHOEHE = LISTENKOPF + 2 * ZEILE + 2;

    /// <summary>Mindesthöhe der Katalogliste: Kopfzeile und zwei Zeilen.</summary>
    public const int KATALOG_MINDESTHOEHE = KATALOG_LISTENKOPF + 2 * ZEILE + 2;

    /// <summary>Obergrenze, solange nicht gemessen werden kann (ohne Skript); das Raster klemmt ohnehin.</summary>
    public const int OBERGRENZE_OHNE_MASS = 2000;

    /// <summary>Präfix des Einstellungsschlüssels; dahinter steht der <see cref="Dialogname"/>.</summary>
    public const string SCHLUESSEL_PRAEFIX = "Katalogauswahl.Trenner.";

    /// <summary>Der Ort des Skripts — statische Web-Assets der Bibliothek.</summary>
    public const string MODUL = "./_content/EPOS.UI/epos-zweispalten.js";

    /// <summary>Die Höhe der Projektliste in px, wie sie das Stilblatt bekommt.</summary>
    public int Trennerhoehe => _hoehe;

    /// <summary>Ist die Detailzeile aufgeklappt?</summary>
    public bool SatzOffen => _satzOffen;

    private int _hoehe = VORGABEHOEHE;
    private bool _satzOffen;
    private ElementReference _wurzel;
    private ElementReference _satzzeile;
    private IJSObjectReference? _modul;
    private DotNetObjectReference<Zweispaltenauswahl>? _selbst;
    private bool _angemeldet;

    private string Schluessel => SCHLUESSEL_PRAEFIX + Dialogname;

    private string Wurzelklasse
    {
        get
        {
            string k = "epos-zweispalten";
            if (NurRechts) k += " epos-zweispalten--nurkatalog";
            if (Satz is not null) k += " epos-zweispalten--mitsatz";
            if (SatzflaecheOffen) k += " epos-zweispalten--satz-offen";
            if (SatzZusammenfassung is not null) k += " epos-zweispalten--zusammenfassung";
            if (KatalogZeile > 0) k += " epos-zweispalten--zeilenmass";
            if (!string.IsNullOrEmpty(Zusatzklasse)) k += " " + Zusatzklasse;
            return k;
        }
    }

    private string Wurzelstil
        => KatalogZeile > 0
            ? FormattableString.Invariant(
                $"--epos-trenner-hoehe: {_hoehe}px; --epos-trenner-min: {MINDESTHOEHE}px; --epos-katalog-min: {KATALOG_LISTENKOPF + 2 * KatalogZeile + 2}px; --epos-katalog-zeile: {KatalogZeile}px")
            : FormattableString.Invariant(
                $"--epos-trenner-hoehe: {_hoehe}px; --epos-trenner-min: {MINDESTHOEHE}px; --epos-katalog-min: {KATALOG_MINDESTHOEHE}px");

    private string ProjektMarke => Resource.AUSWAHL_MARKE_PROJEKT;
    private string KatalogMarke => Resource.AUSWAHL_MARKE_KATALOG;
    private string SatzMarke => SatzArt switch
    {
        Satzmarke.Projektsatz => Resource.AUSWAHL_MARKE_PROJEKTSATZ,
        Satzmarke.Katalogsatz => Resource.AUSWAHL_MARKE_KATALOGSATZ,
        _ => Resource.AUSWAHL_MARKE_SATZ
    };

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        if (string.IsNullOrEmpty(Dialogname)) return;
        try
        {
            int gemerkt = WindowsFormsApplication1.Dienste.Einstellungen?.LiesZahl(Schluessel, 0) ?? 0;
            if (gemerkt > 0) _hoehe = Math.Clamp(gemerkt, MINDESTHOEHE, OBERGRENZE_OHNE_MASS);
        }
        catch (Exception)
        {
            // Ohne lesbare Ablage gilt die Vorgabe.
        }
    }

    /// <summary>Die Projektliste beim letzten Parametersatz — Vergleichsstand für <see cref="Bereichswahl.ListeFolgen"/>.</summary>
    private IReadOnlyList<string>? _projektVorher;

    /// <summary>
    /// <b>Die Mehrfachwahl folgt jeder programmatischen Einzelwahl</b> (DZ1‑N2): Nach Übernehmen,
    /// Umstellen, Entfernen oder Neu… ändert der Wirt die Projektliste und wählt die neue Zeile.
    /// Hier — an einer Stelle für alle Wirte — verlässt eine verschwundene Zeile die Wahl, und
    /// die Wahl springt auf die neu dazugekommene Zeile. Die Projektliste ist ungefiltert; die
    /// Katalogliste führt ihre Kästchen selbst und bleibt außen vor.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (ProjektWahl is null || ProjektSichtbar is null) return;
        var jetzt = ProjektSichtbar.ToList();
        bool gewechselt = ProjektWahl.ListeFolgen(_projektVorher, jetzt);
        _projektVorher = jetzt;
        if (gewechselt) Wahlgewechselt?.Invoke();
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_angemeldet) return;
        _angemeldet = true;
        try
        {
            _modul = await Js.InvokeAsync<IJSObjectReference>("import", MODUL);
            _selbst = DotNetObjectReference.Create(this);
            if (_modul is not null) await _modul.InvokeVoidAsync("anmelden", _wurzel, _selbst);
        }
        catch (Exception)
        {
            // Ohne das Modul (bunit, eine Huelle ohne Skripte) bleibt die Tastatur der
            // Trennlinie; das Raster klemmt die Hoehe im Stilblatt.
        }
    }

    // =====================================================================
    // Trennlinie
    // =====================================================================

    /// <summary>Die Masse aus dem Skript: Höhe der Projektliste, Unter- und Obergrenze.</summary>
    public sealed record Trennermasse(int Hoehe, int Min, int Max);

    private async Task<Trennermasse> MasseAsync()
    {
        try
        {
            if (_modul is not null)
            {
                var m = await _modul.InvokeAsync<Trennermasse?>("masse", _wurzel);
                if (m is not null && m.Max > 0) return m with { Min = Math.Max(m.Min, MINDESTHOEHE) };
            }
        }
        catch (Exception)
        {
            // ohne Messung: der eigene Stand
        }
        return new Trennermasse(_hoehe, MINDESTHOEHE, OBERGRENZE_OHNE_MASS);
    }

    private async Task BeiTrennerTaste(KeyboardEventArgs e)
    {
        if (e.Key is not ("ArrowUp" or "ArrowDown" or "Home" or "End")) return;
        var m = await MasseAsync();
        int neu = e.Key switch
        {
            "ArrowUp" => m.Hoehe - ZEILE,
            "ArrowDown" => m.Hoehe + ZEILE,
            "Home" => m.Min,
            _ => m.Max
        };
        Setzen(Math.Clamp(neu, m.Min, Math.Max(m.Min, m.Max)));
    }

    private void BeiTrennerDoppelklick(MouseEventArgs e)
    {
        _hoehe = VORGABEHOEHE;
        if (string.IsNullOrEmpty(Dialogname)) return;
        try { WindowsFormsApplication1.Dienste.Einstellungen?.Loesche(Schluessel); }
        catch (Exception) { /* ohne Ablage */ }
    }

    /// <summary>Das Skript meldet die Höhe nach dem Loslassen der Trennlinie.</summary>
    [JSInvokable]
    public Task TrennerGezogen(int hoehe)
    {
        Setzen(Math.Clamp(hoehe, MINDESTHOEHE, OBERGRENZE_OHNE_MASS));
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Setzen(int hoehe)
    {
        _hoehe = hoehe;
        if (string.IsNullOrEmpty(Dialogname)) return;
        try { WindowsFormsApplication1.Dienste.Einstellungen?.SchreibZahl(Schluessel, hoehe); }
        catch (Exception) { /* ohne Ablage bleibt die Hoehe fuer diese Sitzung */ }
    }

    // =====================================================================
    // Detailzeile
    // =====================================================================

    private async Task SatzUmschalten()
    {
        _satzOffen = !_satzOffen;
        if (SatzGeklappt.HasDelegate) await SatzGeklappt.InvokeAsync(_satzOffen);
    }

    /// <summary>Esc bei aufgeklappter Detailzeile: zuklappen, der Fokus geht auf die Zeile.</summary>
    [JSInvokable]
    public async Task SatzSchliessen()
    {
        if (!_satzOffen) return;
        await SatzUmschalten();
        StateHasChanged();
        try { await _satzzeile.FocusAsync(preventScroll: true); }
        catch (Exception) { /* ohne Wurzel im Browser */ }
    }

    // =====================================================================
    // Tastatur und Doppelklick in den Listen (4.7)
    // =====================================================================

    /// <summary>
    /// Eine Taste auf einer Listenzeile (aus dem Skript): <c>Enter</c> im Katalog übernimmt
    /// (auch Doppelklick), in der Projektliste klappt es die Detailzeile auf; <c>Entf</c>
    /// entfernt; <c>Alle</c> (Strg+A) wählt die gefilterte Liste.
    /// </summary>
    [JSInvokable]
    public async Task ListenTaste(string bereich, string taste)
    {
        bool katalog = bereich == nameof(Auswahlbereich.Katalog);
        switch (taste)
        {
            case "Enter" when katalog:
                if (!NurRechts && !UebernehmenGesperrt && Uebernehmen.HasDelegate) await Uebernehmen.InvokeAsync();
                break;
            case "Enter":
                if (Satz is not null && !_satzOffen) await SatzUmschalten();
                break;
            case "Entf" when !katalog:
                if (!EntfernenGesperrt && Entfernen.HasDelegate) await Entfernen.InvokeAsync();
                break;
            case "Alle":
                await AlleWaehlenAsync(katalog ? Auswahlbereich.Katalog : Auswahlbereich.Projekt, true);
                break;
        }
        StateHasChanged();
    }

    // =====================================================================
    // Mehrfachwahl
    // =====================================================================

    /// <summary>Die Wahl eines Bereichs (für die Wahlkästchen).</summary>
    public Bereichswahl? WahlVon(Auswahlbereich bereich)
        => bereich == Auswahlbereich.Projekt ? ProjektWahl : KatalogWahl;

    /// <summary>Die gefilterte Liste eines Bereichs.</summary>
    public IReadOnlyList<string> SichtbarVon(Auswahlbereich bereich)
        => (bereich == Auswahlbereich.Projekt ? ProjektSichtbar : KatalogSichtbar) ?? Array.Empty<string>();

    /// <summary>Klick auf ein Zeilenkästchen — das Kästchen schaltet, Umschalt wählt den Bereich.</summary>
    public async Task KaestchenAsync(Auswahlbereich bereich, string schluessel, bool umschalt)
    {
        var wahl = WahlVon(bereich);
        if (wahl is null) return;
        if (umschalt) wahl.Klick(schluessel, strg: false, umschalt: true, SichtbarVon(bereich));
        else wahl.Umschalten(schluessel);
        await GeaendertAsync(bereich);
    }

    /// <summary>Kopfhäkchen und Strg+A: alle Zeilen der gefilterten Liste wählen oder abwählen.</summary>
    public async Task AlleWaehlenAsync(Auswahlbereich bereich, bool waehlen)
    {
        var wahl = WahlVon(bereich);
        if (wahl is null) return;
        wahl.Alle(waehlen, SichtbarVon(bereich));
        await GeaendertAsync(bereich);
    }

    /// <summary>Eine Wahl hat sich geändert — die Wahlkästchen zeichnen sich neu.</summary>
    public event Action? Wahlgewechselt;

    private async Task GeaendertAsync(Auswahlbereich bereich)
    {
        if (WahlGeaendert.HasDelegate) await WahlGeaendert.InvokeAsync(bereich);
        Wahlgewechselt?.Invoke();
        StateHasChanged();
    }

    private static string? Wahltext(Bereichswahl? wahl, IReadOnlyList<string>? sichtbar)
    {
        if (wahl is null || wahl.Anzahl == 0) return null;
        int verborgen = wahl.Verborgen(sichtbar ?? Array.Empty<string>());
        return verborgen > 0
            ? string.Format(Resource.Culture, Resource.AUSWAHL_WAHL_ZAHL_VERBORGEN, wahl.Anzahl, verborgen)
            : string.Format(Resource.Culture, Resource.AUSWAHL_WAHL_ZAHL, wahl.Anzahl);
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        if (_modul is not null)
        {
            try
            {
                await _modul.InvokeVoidAsync("abmelden", _wurzel);
                await _modul.DisposeAsync();
            }
            catch (Exception) { /* Die WebView ist schon weg. */ }
        }
        _selbst?.Dispose();
    }
}
