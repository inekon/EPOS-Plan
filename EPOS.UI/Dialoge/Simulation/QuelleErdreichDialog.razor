    private static string Zonentext(int z)
        => z.ToString(System.Globalization.CultureInfo.CurrentCulture) + " — " +
           VDI4640Pruefung.VolllaststundenZone(z)
               .ToString("N0", System.Globalization.CultureInfo.CurrentCulture) + " h/a";

    private static string Schluessel(int? index)
    {
        if (index is null || index.Value < 0 || index.Value >= ErdreichTemperatur.Katalog.Length)
            return ErdreichTemperatur.BODENTYP_DEFAULT;
        return ErdreichTemperatur.Katalog[index.Value].Schluessel;
    }

    // --- Aufbau -----------------------------------------------------------------

    protected override void OnInitialized()
    {
        _lauf = Lauf ?? ErdreichAuswertung.ErdreichLaufErgebnis.Keines;

        // SetControls:736-780, woertlich - nur die beiden Zweige sind getrennt (A-4).
        _sonde = string.Equals(Daten.Quellsystem, ErdreichTemperatur.QUELLSYSTEM_SONDE,
                               StringComparison.OrdinalIgnoreCase);

        if (_sonde)
        {
            _laenge = Daten.Tiefe > 0 ? Daten.Tiefe : 90;
            _tiefe = ErdreichTemperatur.TIEFE_DEFAULT;
        }
        else
        {
            _tiefe = Daten.Tiefe > 0 ? Daten.Tiefe : ErdreichTemperatur.TIEFE_DEFAULT;
            _laenge = 90;
        }

        _flaeche = Daten.Flaeche;
        _anzahl = Daten.Anzahl > 0 ? Daten.Anzahl : 1;

        int bi = ErdreichTemperatur.KatalogIndex(Daten.Bodentyp);
        _bodenIndex = bi >= 0 ? bi : ErdreichTemperatur.KatalogIndex(ErdreichTemperatur.BODENTYP_DEFAULT);

        _zone = (Daten.Klimazone >= 0 && Daten.Klimazone <= VDI4640Pruefung.KLIMAZONEN)
            ? Daten.Klimazone : 0;

        _spreizung = Daten.Spreizung > 0 ? Daten.Spreizung : ErdreichAuswertung.SPREIZUNG_DEFAULT;

        // Ausgangsstand festhalten, BEVOR der Anwender etwas aendern kann (Befund 4
        // des Bestands). Er ist der Stand der Datenbank.
        _standGeladen = Eingabestand();
        _laufAusDialog = false;

        Aktualisieren();

        // Welle KI-F2: die Maske beim Hilfe-Assistenten anmelden. Angemeldet wird ein
        // SICHTMODELL ueber die LEBENDEN Felder - Daten ist ein unveraenderlicher
        // Record, und der OK-Weg erzeugt ueber "with" einen neuen.
        _kiSicht = KiSicht();
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.QUELLE_ERDREICH,
                                          () => _kiSicht, KiHaken());
    }

    // =================================================================================
