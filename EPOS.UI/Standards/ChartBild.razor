@* Diagramm als fertiges Bild.

   Gezeichnet wird im Rechenkern (Skia-Renderer, iF16); die Oberflaeche zeigt
   nur noch das PNG. Das haelt EPOS.UI frei von jeder Zeichenbibliothek und
   liefert unter Windows und auf iOS dasselbe Bild.

   Das PNG wird als data:-URL eingebettet statt ueber eine Adresse geladen: In
   der WebView gibt es keinen Webserver, der eine Datei ausliefern koennte.

   SEIT DER WINDOWS-ABNAHME 05.09.2026 (Befund A-1) STEHT DAS BILD IM BAUSTEIN
   DIAGRAMM. Das ist die Hausregel: JEDES Renderer-Bild ist zoombar, und zwar an
   EINER Stelle - hier. Wer irgendwo ein Bild zeigt, nimmt ChartBild und bekommt
   Rad, Kneifgeste, Ziehen, Doppelklick und die Tasten + - 0 mit. Ein zweiter
   <img>-Weg an ChartBild vorbei waere ein Diagramm ohne Zoom und damit ein
   Rueckfall in den Zustand, den der Anwender beanstandet hat.

   Das Bild fuellt die BREITE seines Rahmens (width: 100 %). Vorher stand dort
   max-width: Ein 1 240 Bildpunkte breites Diagramm in einer halben Rasterspalte
   wurde damit briefmarkengross, und die Legende war nicht mehr zu lesen
   (Befund W11b-B-2 derselben Abnahme).

   ... UND EINE OBERGRENZE JE GESTALT (Windows-Abnahme V2 07.09.2026, Befund
   W11b-B-4: „Simulation Uebersicht: Die Charts sind optisch zu gross"). Aus
   width: 100 % OHNE Grenze wurde ein 960 Bildpunkte breiter Kuchen auf einem
   1 920er Schirm auf 1 850 Bildpunkte gezogen - 1 156 hoch, mehr als der ganze
   sichtbare Bereich, und keine Aussage mehr als bei 560. Rund="true" markiert
   die runde Gestalt; das Mass dazu steht als EINE Regel im Stilblatt. *@

@namespace EPOS.UI.Standards

@if (Png is { Length: > 0 })
{
    <Diagramm Bezeichnung="@Alt" BereichGewaehlt="@BereichGewaehlt"
              Zurueckgesetzt="@Zurueckgesetzt" Zusatzklasse="@Gestaltklasse"
              OhneZoom="@Rund">
        <img class="epos-chartbild" src="data:image/png;base64,@Convert.ToBase64String(Png)"
             alt="@Alt" width="@Breite" height="@Hoehe" />
    </Diagramm>
}
else
{
    <div class="epos-chartbild-platzhalter">@PlatzhalterText</div>
}

@code {
    /// <summary>Das fertige Bild. <c>null</c> oder leer zeigt den Platzhalter.</summary>
    [Parameter] public byte[]? Png { get; set; }

    /// <summary>
    /// Ein RUNDES Bild — Kuchen oder Ring (Befund <b>W11b-B-4</b> der
    /// Windows-Abnahme V2 vom 07.09.2026: „Simulation Übersicht: Die Charts sind
    /// optisch zu groß").
    ///
    /// <para>Ein rundes Bild traegt seine Aussage im Kreis und in einer Legende
    /// daneben; es gewinnt ab einer gewissen Breite NICHTS mehr dazu, waehrend eine
    /// Jahresganglinie mit 8 760 Stunden jeden Bildpunkt braucht (das war Befund
    /// W11b-B-2 derselben Reihe, und der bleibt). Die Marke sagt nur die GESTALT;
    /// das Mass steht als Token <c>--epos-diagramm-rund</c> im Stilblatt.</para>
    ///
    /// <para><b>Seit Auftrag #222 nimmt dieselbe Marke dem Bild den ZOOM</b>
    /// (<c>Diagramm.OhneZoom</c>): Ein Ring hat nichts zu zoomen, und auf ×1,2
    /// schnitt der Rahmen den Kreis an. Das ist die eine Ausnahme zur Hausregel
    /// W8‑E‑2; der Rahmen selbst bleibt, jedes Bild geht weiter durch diese
    /// Komponente.</para>
    /// </summary>
    [Parameter] public bool Rund { get; set; }

    /// <summary>Anzeigebreite in px; <c>null</c> = die des Bildes.</summary>
    [Parameter] public int? Breite { get; set; }

    /// <summary>Anzeigehoehe in px; <c>null</c> = die des Bildes.</summary>
    [Parameter] public int? Hoehe { get; set; }

    /// <summary>
    /// Was das Diagramm zeigt - fuer Sprachausgabe und fuer den Fall, dass das
    /// Bild fehlt. Ein Diagramm ohne diesen Text ist fuer blinde Anwender
    /// nicht vorhanden.
    /// </summary>
    [Parameter] public string Alt { get; set; } = "";

    /// <summary>Text, solange es noch kein Bild gibt.</summary>
    [Parameter] public string PlatzhalterText { get; set; } = "Kein Diagramm vorhanden";

    /// <summary>
    /// Der DATENZOOM: Der Anwender hat einen Achsenbereich aufgezogen. Nur
    /// belegen, wo der Renderer einen Bereich zeichnen kann (die Jahresganglinien
    /// der Ergebnisseite) - ohne Delegat bleibt es beim Bildzoom, und der Knopf
    /// „Bereich" erscheint erst gar nicht.
    /// </summary>
    [Parameter] public EventCallback<Diagrammbereich> BereichGewaehlt { get; set; }

    /// <summary>
    /// Der Knopf „1:1" wurde gedrueckt — wer einen Achsenbereich fuehrt, verwirft
    /// ihn hier. Ohne Datenzoom bleibt der Rueckruf unbelegt.
    /// </summary>
    [Parameter] public EventCallback Zurueckgesetzt { get; set; }

    /// <summary>Die Gestaltklasse, die der Rahmen bekommt — heute nur die runde.</summary>
    private string Gestaltklasse => Rund ? "epos-diagramm--rund" : "";
}
