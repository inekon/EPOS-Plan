    /// <summary>Ein Schlüssel je Projektzeile (die Zeile selbst, nicht ihr Name: zwei Zuordnungen derselben Ganglinie sind zwei Zeilen).</summary>
    private readonly Dictionary<WaermebedarfExternZeile, string> _projektschluessel = new(ReferenceEqualityComparer.Instance);

    /// <summary>Die Mehrfachwahl der Projektliste (Prüfhilfe).</summary>
    public Bereichswahl ProjektWahl => _projektWahl;
    /// <summary>Die Mehrfachwahl des Katalogs (Prüfhilfe).</summary>
    public Bereichswahl KatalogWahl => _katalogWahl;
    /// <summary>Steht die Satz-Überlagerung offen? (Prüfhilfe)</summary>
    public bool SatzUeberlagerungOffen => _zweispalten?.SatzUeberlagerungOffen == true;

    private string Projektschluessel(WaermebedarfExternZeile z)
    {
        if (!_projektschluessel.TryGetValue(z, out string? s))
        {
            s = "p" + (_projektschluessel.Count + 1).ToString(System.Globalization.CultureInfo.InvariantCulture);
            _projektschluessel[z] = s;
        }
        return s;
    }

    private IReadOnlyList<string> ProjektSchluessel() => Zeilen.Select(Projektschluessel).ToList();

    private IReadOnlyList<string> KatalogSichtbar()
        => (_katalogliste?.Angezeigt ?? _katalog).Select(z => z.Schluessel).ToList();

    /// <summary>Die Ziele einer Projektaktion: die angekreuzten Zeilen, sonst die markierte.</summary>
    private List<WaermebedarfExternZeile> ProjektZiele()
    {
        if (_projektWahl.Anzahl > 0)
            return Zeilen.Where(z => _projektWahl.IstGewaehlt(Projektschluessel(z))).ToList();
        return _gewaehlt is null ? new() : new() { _gewaehlt };
    }

    /// <summary>Die Ziele einer Katalogaktion: die angekreuzten Sätze, sonst der gewählte.</summary>
    private List<Katalogfilterzeile> KatalogZiele()
    {
        if (_katalogWahl.Anzahl > 0)
            return _katalogWahl.Gewaehlte
                .Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s))
                .OfType<Katalogfilterzeile>().ToList();
        return _katalogZeile is null ? new() : new() { _katalogZeile };
    }

    /// <summary>
    /// Klick in eine Projektzeile (AW3b, wie Heizkessel): Die Zeile wird der gewählte Satz, die Detailzeile folgt;
    /// die Kästchen der Mehrfachwahl bleiben unberührt — wie in der Katalogliste.
    /// </summary>
    private Task ProjektZeileKlick(WaermebedarfExternZeile zeile)
        => _gewaehlt == zeile ? Task.CompletedTask : ProjektZeileWaehlen(zeile);

    /// <summary>↑ ↓ Pos1 Ende in der Projektliste: die Regel rechnet der Baustein.</summary>
    private Task BeiProjektTaste(KeyboardEventArgs e)
        => _zweispalten is null ? Task.CompletedTask : _zweispalten.ProjektTasteAsync(e.Key);

    /// <summary>Die Tastenführung hat eine andere Projektzeile gewählt.</summary>
    private Task BeiProjektTastenwahl(string schluessel)
    {
        WaermebedarfExternZeile? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == schluessel);
        return zeile is null ? Task.CompletedTask : ProjektZeileKlick(zeile);
    }

    /// <summary>
    /// Der Grund der weichen Sperre von Schloss… und Löschen (AW3b): Sie wirken nur auf Katalogsätze; steht ein
    /// Projektsatz, nennen sie „Katalogsatz wählen".
    /// </summary>
    /// <summary>„Vergrößern" der Knopfleiste am Satz: die Ganglinie als Satz-Überlagerung.</summary>
    private Task BeiVergroessern() => _zweispalten is null ? Task.CompletedTask : _zweispalten.SatzUeberlagerungOeffnen();

    private string? KatalogSperrgrund => SatzArt == Satzmarke.Projektsatz ? Resource.AUSWAHL_SPERRE_KATALOGSATZ : null;

    /// <summary>
    /// „Bearbeiten…" am Katalogsatz (AW3b): dasselbe wie der Stift der Katalogzeile — ungesperrt die Verwaltung
    /// ohne Vorwahl, gesperrt die Ganglinie zur Ansicht; ohne gewählten Satz die Verwaltung.
    /// </summary>
    private Task BeiKatalogBearbeiten()
    {
        if (_katalogZeile is not null) return BeiKatalogStift(_katalogZeile);
        BeiBearbeiten();
        return Task.CompletedTask;
    }

    private async Task BeiWahlGeaendert(Auswahlbereich bereich)
    {
        if (bereich != Auswahlbereich.Projekt || _projektWahl.Zuletzt is not string s) return;
        if (!_projektWahl.IstGewaehlt(s)) return;
        WaermebedarfExternZeile? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == s);
        if (zeile is not null && zeile != _gewaehlt) await ProjektZeileWaehlen(zeile);
    }

    private void BeiKatalogKaestchen(IReadOnlyList<string> gewaehlt)
    {
        _katalogKaestchen = gewaehlt;
        _katalogWahl.Setzen(gewaehlt);
    }

    private void KatalogKaestchenLeeren()
    {
        _katalogWahl.Leeren();
        _katalogKaestchen = new List<string>();
    }

    /// <summary>
    /// UeS2: der Stift einer Projektzeile — sie wird gewählt (ohne die Kästchen anzufassen) und ihre
    /// Ganglinie öffnet in der Satz-Überlagerung (nur Ansicht, Kurve in voller Größe). Eine
    /// Projektkopie mit eigenem Editor gibt es hier nicht: Die Zuordnung trägt nur den Kanal.
    /// </summary>
    private async Task BeiProjektStift(WaermebedarfExternZeile zeile)
    {
        if (_gewaehlt != zeile) await ProjektZeileWaehlen(zeile);
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// UeS2: der Stift einer Katalogzeile (die Katalogliste hat sie schon gewählt) — ein gesperrter
    /// Satz öffnet nur zur Ansicht in der Satz-Überlagerung, ein ungesperrter die Verwaltung
    /// (KA‑E‑13); ohne Verwaltung die Überlagerung.
    /// </summary>
    private async Task BeiKatalogStift(Katalogfilterzeile zeile)
    {
        if (_katalogGewaehlt != zeile.Bezeichner) await KatalogZeileWaehlen(zeile.Bezeichner);
        if (!zeile.Geschuetzt && VerwaltungGaben is not null)
        {
            BeiBearbeiten();
            return;
        }
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// Der Kanal der markierten Zeile. Ein leerer oder unbekannter Wert fällt auf den
    /// ERSTEN Eintrag zurück — Heizung, die Vorbelegung nach F18
    /// (<c>KanalAnzeigeAktualisieren</c>:141-170).
    /// </summary>
    private int? Kanalindex
    {
        get
        {
            if (_gewaehlt is null) return 0;
            for (int i = 0; i < Kanaele.Count; i++)
                if (string.Equals(Kanaele[i].Wert, _gewaehlt.Kanal,
                                  StringComparison.OrdinalIgnoreCase)) return i;
            return 0;
        }
    }

    private IReadOnlyList<(int Id, string Text)> Kanaleintraege
    {
        get
        {
            var l = new List<(int, string)>();
            for (int i = 0; i < Kanaele.Count; i++) l.Add((i, Kanaele[i].Text));
            return l;
        }
    }

    protected override void OnParametersSet()
    {
        // Der Kopf der WAHLSPALTE kommt weiter ueber den eigenen Text des Wirtes.
        Filtertexte.SpalteWahl = SpalteWahl;
    }

    protected override void OnInitialized()
    {
        // S2.5/S3.2: der Filterstand je Katalog, fuer die Sitzung, gemeinsam mit der
        // Verwaltung desselben Katalogs (Frage Q2).
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(
            Katalogprofil?.Schluessel ?? ("ZEITREIHE_" + Zeitreihenart.Waermebedarf));

        if (Zeilen.Count > 0) _gewaehlt = Zeilen[0];

        // Welle KI-F3: Angemeldet ist die GEWAEHLTE Zuordnung - sie wechselt mit jedem
        // Klick in der Projektliste, deshalb ein Delegat und keine Instanz. Die
        // Kanaleintraege kennt nur dieser Dialog.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.WAERMEBEDARF_EXTERN,
                                          () => _gewaehlt, KiHaken(),
                                          ("kanal", Kanalwahleintraege));
    }

    // =================================================================================
    // Der Hilfe-Assistent liest die gewählte Zuordnung (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;

    /// <summary>Die drei Bedarfskanäle für den Assistenten (KI-D-Q6).</summary>
    private IReadOnlyList<KiWahleintrag> Kanalwahleintraege()
        => KiMaskenanmeldung.Eintraege(Kanaele, k => k.Wert, k => k.Text);

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> Die Zuordnungsliste gehört dem Wirt und geht erst mit
    /// dem OK an ihn; der Kanal steht bis dahin in der Zeile, die der Anwender sieht.
    /// Einen Schreibschutz kennt diese Maske nicht — der des Katalogs hängt am
    /// Löschweg und nicht an der Zuordnung.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await KatalogLaden();
        if (_gewaehlt is not null) await GrafikLaden(WahlZu(_gewaehlt));
        await _wurzel.FocusAsync(preventScroll: true);
        StateHasChanged();
    }

    /// <summary>Lädt den Katalog neu — beim Aufbau und nach jedem Katalogeingriff.</summary>
    public async Task KatalogLaden()
    {
        if (Katalogzeilen is null) return;
        // KT-3: Wirft die Quelle, bleibt die Liste leer und der Banner nennt den Grund.
        (_katalog, _listeFehler) = await Katalogladung.LesenAsync(Katalogzeilen, TitelText);
        VerwendungStempeln();
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
        _katalogKaestchen = _katalogWahl.Gewaehlte.ToList();

        if (_katalogZeile is null) return;

        _katalogZeile = _katalog.FirstOrDefault(z => z.Bezeichner == _katalogGewaehlt);
        if (_katalogZeile is null)
        {
            _katalogGewaehlt = "";
            GrafikVerwerfen();      // die geloeschte Zeile nimmt ihre Grafik mit
        }
    }

    /// <summary>
    /// Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste aus der
    /// LEBENDEN Projektliste; der Dialog schreibt erst beim OK zurück.
    /// </summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    // =================================================================================
    // Markierung und Grafik (W9-E-3)
    // =================================================================================

    private Task ProjektZeileWaehlen(WaermebedarfExternZeile zeile)
    {
        _gewaehlt = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        return GrafikLaden(WahlZu(zeile));
    }

    private Task KatalogZeileWaehlen(string bezeichner)
    {
        Katalogfilterzeile? zeile = _katalog.FirstOrDefault(z => z.Bezeichner == bezeichner);
        if (zeile is null) return Task.CompletedTask;

        _katalogZeile = zeile;
        _katalogGewaehlt = zeile.Bezeichner;
        _gewaehlt = null;
        _meldung = "";
        return GrafikLaden(new GanglinienWahl(true, zeile.Id, zeile.Bezeichner));
    }

    /// <summary>
    /// Die Wahl zu einer PROJEKTZEILE.
    ///
    /// <para><b>Die Id gilt nur für eine GESPEICHERTE Zuordnung.</b>
    /// <c>Z_ProjektWaermebedarf.ID_Ganglinie</c> zeigt auf die Projektkopie
    /// (<c>Tab_Waermebedarf.ID</c>) — eine hier eben erst aufgenommene Zeile trägt
    /// dagegen die STAMM-Id (<c>WaermebedarfExternHuelle.Aufnehmen</c>), und die
    /// Projektkopie entsteht erst beim Speichern
    /// (<c>WizardCtrl.Add_WaermebedarfExtern</c> →
    /// <c>ApplyGanglinieToProjekt</c>). Würde man sie als Kopie-Id lesen, zeigte
    /// die Grafik die Werte einer FREMDEN Ganglinie. Deshalb: <c>IdZ = 0</c>
    /// heißt „noch nicht gespeichert" und gibt <c>0</c> weiter — der Kern fällt
    /// dann über den Bezeichner auf den Katalogsatz zurück, aus dem die Kopie
    /// entstehen wird.</para>
    /// </summary>
    private GanglinienWahl WahlZu(WaermebedarfExternZeile zeile)
        => new GanglinienWahl(false, zeile.IdZ > 0 ? zeile.IdGanglinie : 0, zeile.Bezeichner);

    /// <summary>
    /// Holt die Kennzahlen zur neuen Wahl. <b>Einmal je Markierung</b>, nicht je
    /// Zeichendurchgang: Dahinter liegen 8 760 Wertzeilen aus der Datenbank.
    /// </summary>
    private async Task GrafikLaden(GanglinienWahl wahl)
    {
        _wahl = wahl;
        _kennzahlen = null;
        _satzFehler = "";

        if (Kennzahlen is null) return;
        // KT-4: Wirft das Lesen der Ganglinie, nennt der Banner Satz und Grund; die Listen bleiben bedienbar.
        (_kennzahlen, _satzFehler) = await Katalogladung.SatzAsync(() => Kennzahlen(wahl), wahl.Bezeichner);
    }

    /// <summary>
    /// Die Grafik fällt weg, sobald ihre Zeile weg ist — beim Entfernen und immer
    /// dann, wenn der neu geladene Katalog die markierte Zeile nicht mehr führt.
    /// </summary>
    private void GrafikVerwerfen()
    {
        _wahl = null;
        _kennzahlen = null;
    }

    /// <summary>Was die Detailzeile zeigt (DZ1): die Zuordnung, den Katalogsatz oder keinen.</summary>
    private Satzmarke SatzArt => _gewaehlt is not null ? Satzmarke.Projektsatz
                               : _katalogZeile is not null ? Satzmarke.Katalogsatz : Satzmarke.Keiner;

    /// <summary>Name des gewählten Satzes in der zugeklappten Detailzeile.</summary>
    private string? SatzName => SatzArt == Satzmarke.Keiner ? null
                              : _gewaehlt?.Bezeichner ?? _katalogZeile?.Bezeichner;

    /// <summary>Was gerade markiert ist — die Namenszeile über der Grafik.</summary>
    private string GewaehlterName => _wahl?.Bezeichner ?? "";

    /// <summary>
    /// Die IDENTITÄT der gezeigten Ganglinie. Sie trennt die Projektzeile von dem
    /// gleichnamigen Katalogsatz: Beide dürfen denselben Bezeichner tragen, zeigen
    /// aber verschiedene Tabellen — ein gemeinsamer Schlüssel ließe den Bildvorrat
    /// des einen für den anderen gelten.
    /// </summary>
    private string Grafikschluessel
        => _wahl is null ? "" : (_wahl.AusKatalog ? "K|" : "P|") + _wahl.GanglinieId
                                + "|" + _wahl.Bezeichner;

    /// <summary>Der Bildauftrag der Grafik — die Wahl steckt schon darin.</summary>
    private Func<bool, Zeichenmodell?>? Grafikbild
        => (Bildauftrag is null || _wahl is null)
            ? null
            : sortiert => Bildauftrag(_wahl, sortiert);

    /// <summary>Der Bildauftrag in Behältergröße (DZ1‑N2) — die Wahl steckt schon darin.</summary>
    private Func<bool, int, int, Zeichenmodell?>? GrafikbildMass
        => (BildauftragMass is null || _wahl is null)
            ? null
            : (sortiert, breite, hoehe) => BildauftragMass(_wahl, sortiert, breite, hoehe);

    // =================================================================================
    // Kanal
    // =================================================================================

    private void KanalWaehlen(int? index)
    {
        if (_gewaehlt is null || index is null) return;
        if (index.Value < 0 || index.Value >= Kanaele.Count) return;

        _gewaehlt.Kanal = Kanaele[index.Value].Wert;
        Geaendert?.Invoke();
    }

    // =================================================================================
    // Uebernehmen und Entfernen
    // =================================================================================

    /// <summary>
    /// „◀" — je Zuordnung ein EIGENES Modell; die neue Zeile steht auf Heizung und wird
    /// markiert, damit die Kanalwahl sichtbar auf sie wirkt
    /// (<c>btn_Hinzu_Click</c>:206-238).
    /// </summary>
    private async Task BeiHinzu()
    {
        if (Aufnehmen is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;

        // Sammelübernahme (4.5): je angekreuzter Katalogzeile eine Zuordnung; gewählt ist danach die letzte neue.
        WaermebedarfExternZeile? letzte = null;
        foreach (Katalogfilterzeile k in ziele)
        {
            WaermebedarfExternZeile? neu = Aufnehmen(k.Bezeichner);
            if (neu is null) continue;
            Zeilen.Add(neu);
            letzte = neu;
        }
        if (letzte is null) return;

        _meldung = "";
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
        await ProjektZeileWaehlen(letzte);
        Geaendert?.Invoke();
    }

    /// <summary>
    /// „▶" — entfernt GENAU die markierte Zeile. Der Vorläufer suchte die ERSTE Zeile
    /// gleichen Namens; bei zwei Zuordnungen derselben Ganglinie traf er damit die
    /// falsche (A-9, dieselbe Fehlerklasse wie W7 A-21).
    /// </summary>
    private async Task BeiEntfernen()
    {
        List<WaermebedarfExternZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;

        // Entfernt GENAU die gewählten Zeilen (die angekreuzten, sonst die markierte).
        foreach (WaermebedarfExternZeile z in ziele) Zeilen.Remove(z);
        _projektWahl.Leeren();
        _gewaehlt = Zeilen.Count > 0 ? Zeilen[0] : null;
        _meldung = "";

        if (_gewaehlt is null) GrafikVerwerfen();
        else await GrafikLaden(WahlZu(_gewaehlt));

        Geaendert?.Invoke();
    }

    // =================================================================================
    // Importieren (W9-E-3) - DERSELBE Weg wie in der Verwaltung
    // =================================================================================

    private async Task BeiImportieren()
    {
        if (!ImportMoeglich || _laeuft || _import is null) return;

        _meldung = "";

        // W13-B-1: Der Waehler DARF warten und wird await-et - nie synchron im
        // Blazor-Ereignis ausgewertet.
        string? pfad = await DateiWaehlen!(Dateifilter);
        if (string.IsNullOrEmpty(pfad)) return;      // abgebrochen: nichts passiert

        GanglinienImportErgebnis? erg = await _import.Starten(pfad, GanglinienRaster.Unbekannt);
        if (erg is null) return;

        if (!string.IsNullOrEmpty(erg.Meldung))
            Melden(erg.Meldung, GanglinienImportLauf.StufeZu(erg));

        if (erg.Ausgang == ImportAusgang.Erfolg) await KatalogLaden();
    }

    // =================================================================================
    // Katalog: Bearbeiten, Loeschen, Speichern unter
    // =================================================================================

    private void BeiBearbeiten()
    {
        if (VerwaltungGaben is null) return;
        _verwaltungOffen = true;
    }

    /// <summary>
    /// Die Verwaltung ist zu. Der Katalog wird neu geladen — der Anwender kann
    /// dort eingelesen oder gelöscht und mit „Beenden" geschlossen haben.
    /// </summary>
    private async Task VerwaltungFertig(bool _)
    {
        _verwaltungOffen = false;
        await KatalogLaden();
    }

    /// <summary>
    /// „Löschen" — erst die zwei Sperren, dann die Rückfrage. Der
    /// Vorläufer löschte ohne Rückfrage (A-8) und kannte die ReadOnly-Sperre nur im
    /// Controller, wo sie eine <c>MessageBox</c> zeigte.
    /// </summary>
    private void BeiLoeschen()
    {
        if (!LoeschenErlaubt) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;

        // Die zwei Sperren: Eine zugeordnete Ganglinie und ein Auslieferungssatz bleiben stehen.
        // Delete prueft das Schloss selbst; hier steht es davor, damit die Rueckfrage nicht kommt.
        // EIN Satz meldet seine Sperre; bei mehreren nennt die eine Rueckfrage die uebersprungenen.
        if (ziele.Count == 1)
        {
            Katalogfilterzeile z = ziele[0];
            if (HatProjektzuordnung is not null && HatProjektzuordnung(z.Bezeichner))
            {
                Melden(MeldungZuordnung, WarnStufe.Warnung);
                return;
            }
            if (z.Geschuetzt)
            {
                Melden(TextSchreibgeschuetzt, WarnStufe.Warnung);
                return;
            }
            _loeschziele = ziele;
            _loeschGesperrt = new();
            _loeschZugeordnet = new();
        }
        else
        {
            _loeschGesperrt = ziele.Where(z => z.Geschuetzt).ToList();
            _loeschZugeordnet = ziele.Where(z => !z.Geschuetzt && HatProjektzuordnung is not null
                                                 && HatProjektzuordnung(z.Bezeichner)).ToList();
            _loeschziele = ziele.Except(_loeschGesperrt).Except(_loeschZugeordnet).ToList();
            if (_loeschziele.Count == 0)
            {
                Melden(_loeschZugeordnet.Count > 0 ? MeldungZuordnung : TextSchreibgeschuetzt, WarnStufe.Warnung);
                return;
            }
        }

        _meldung = "";
        _loeschfrage = true;
    }

    /// <summary>Die EINE Rückfrage: ein Satz mit Namen, mehrere mit Zahl und Namen, dazu die übersprungenen.</summary>
    private string LoeschfrageText
    {
        get
        {
            string text = _loeschziele.Count <= 1
                ? string.Format(MeldungLoeschfrage, _loeschziele.FirstOrDefault()?.Bezeichner ?? Katalogname ?? "")
                : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, _loeschziele.Count,
                                string.Join(", ", _loeschziele.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschGesperrt.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                            string.Join(", ", _loeschGesperrt.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschZugeordnet.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.GANGL_UEBERSPRUNGEN_ZUGEORDNET,
                                            string.Join(", ", _loeschZugeordnet.Select(z => "„" + z.Bezeichner + "“")));
            return text;
        }
    }

    private async Task LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || KatalogLoeschen is null || ziele.Count == 0) return;

        var geloescht = new List<string>();
        string fehler = "";
        foreach (Katalogfilterzeile z in ziele)
        {
            // KT-4: Wirft der Löschweg, nennt die Meldung den Grund (Katalogladung.Loeschen).
            bool weg = Katalogladung.Loeschen(() => KatalogLoeschen(z.Bezeichner), z.Bezeichner, out string grund);
            if (weg) geloescht.Add(z.Bezeichner);
            else if (fehler.Length == 0) fehler = grund.Length > 0 ? grund : TextSchreibgeschuetzt;
        }

        if (geloescht.Contains(_katalogGewaehlt)) { _katalogZeile = null; _katalogGewaehlt = ""; GrafikVerwerfen(); }
        if (geloescht.Count > 0) KatalogKaestchenLeeren();
        await KatalogLaden();
        if (fehler.Length > 0) Melden(fehler, WarnStufe.Warnung);
        else Melden(string.Format(VorlageGeloescht, string.Join(", ", geloescht)), WarnStufe.Erfolg);
    }

    private void BeiSpeichernUnter()
    {
        if (!KopierenErlaubt || _katalogZeile is null) return;
        _meldung = "";
        _kopieVorschlag = _katalogZeile.Bezeichner + KopieZusatz;
        _kopieOffen = true;
    }

    /// <summary>
    /// Die Dublettenprüfung VOR dem Einfügen — gegen den geladenen Katalog, also
    /// ohne zweite Abfrage und ohne Warten. Sie hält den Namensdialog offen und
    /// sagt, warum; der Kern prüft dieselbe Bedingung ein zweites Mal
    /// (<c>KopiereStamm</c> liefert dann <c>0</c>), damit kein UNIQUE-Fehler
    /// durchkommt.
    /// </summary>
    private string? KopieNamePruefen(string name)
        => _katalog.Any(z => string.Equals(z.Bezeichner, name, StringComparison.Ordinal))
            ? string.Format(TextNameVergeben, name)
            : null;

    private async Task KopieFertig(string? name)
    {
        _kopieOffen = false;
        if (string.IsNullOrWhiteSpace(name) || Kopieren is null || _katalogZeile is null) return;

        string quelle = _katalogZeile.Bezeichner;
        // KT-4: Wirft der Schreibweg, kommt die Ablehnung mit Grund zurück (Katalogladung.SchreibenAsync).
        string grund = "";
        bool ok = await Katalogladung.SchreibenAsync(() => Kopieren(quelle, name!), name, g => { grund = g; return false; });
        await KatalogLaden();
        Melden(ok ? string.Format(VorlageKopiert, quelle, name) : grund.Length > 0 ? grund : TextKopieFehler,
               ok ? WarnStufe.Erfolg : WarnStufe.Fehler);
    }

    // =================================================================================
    // Schluss
    // =================================================================================

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Abbrechen — von Esc (nach den Wächtern) und vom Schliesskreuz gleichermaßen gerufen.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        if (e.Key != "Escape") return Task.CompletedTask;

        // Jede Ebene prueft ihre eigenen Schalter, bevor sie Esc fuer sich
        // auswertet - so schliesst Esc immer nur die oberste (Muster W7.5).
        if (_loeschfrage || _verwaltungOffen || _kopieOffen || _zweispalten?.SatzUeberlagerungOffen == true
            || _import?.EtwasOffen == true) return Task.CompletedTask;

        return Wizard ? Task.CompletedTask : Abbrechen();
    }

    // =================================================================================
    // Schloss setzen / aufheben (AD-Q15) - derselbe Baustein wie in den Verwaltungen
    // =================================================================================

    /// <summary>
    /// „Schloss setzen…" / „Schloss aufheben…" an der Katalogliste
    /// (<c>Schlosswege.Aus(…SchlossSetzen)</c>). Ohne ihn steht der Knopf nicht da.
    /// Die Verwendung im Projekt sperrt nichts: Das Projekt führt eine eigene Kopie.
    /// </summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    private Katalogschloss? _katalogschloss;

    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe für Tests.)</summary>
    public bool Schlossfrage => _katalogschloss?.FrageOffen == true;

    /// <summary>Nach dem Schalten: Liste neu lesen, Status melden.</summary>
    private async Task BeiSchlossGeschaltet(string status)
    {
        await KatalogLaden();
        Melden(status ?? "", WarnStufe.Hinweis);
    }

    /// <summary>Warum nicht geschaltet wurde.</summary>
    private void BeiSchlossAbgelehnt(string grund) => Melden(grund ?? "", WarnStufe.Warnung);
}
