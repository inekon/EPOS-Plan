        TitelKostenprofil, KostenprofilGaben?.Invoke());

    private void SpotpreisOeffnen() => UnterOeffnen(Unterdialog.Spotpreis,
        TitelSpotpreis, SpotpreisGaben?.Invoke());

    private void SaisonOeffnen() => UnterOeffnen(Unterdialog.Saisonreihe,
        TitelSaison, SaisonGaben?.Invoke());

    private void KatalogZeileOeffnen(string kuerzel) => UnterOeffnen(Unterdialog.Emissionskatalog,
        TitelEmissionskatalog, EmissionskatalogGaben?.Invoke(kuerzel));

    private void KatalogVerwaltenOeffnen() => UnterOeffnen(Unterdialog.Emissionskatalog,
        TitelEmissionskatalog, EmissionskatalogGaben?.Invoke(""));

    private void UnterOeffnen(Unterdialog art, string titel,
                              IReadOnlyDictionary<string, object>? gaben)
    {
        if (gaben is null) return;
        _unterArt = art;
        _unterTitel = titel;
        _unterGaben = gaben;
    }

    private async Task UnterSchliessen()
    {
        _unterArt = Unterdialog.Keiner;
        _unterGaben = null;
        await UnterdialogGeschlossen.InvokeAsync();
        // Nach jedem Unterdialog wird neu gelesen (Risiko R3, Muster
        // RasterAufbauen der Kostenverwaltung).
        if (_traegerId.HasValue) Laden(_traegerId.Value);
    }

    private Task EmissionskatalogFertig(EmissionskatalogErgebnis ergebnis)
    {
        EmissionskatalogAuswerten?.Invoke(ergebnis);
        return UnterSchliessen();
    }

    // =====================================================================
    // Schlussleiste (Ä14)
    // =====================================================================

    private void BeiSpeichern()
    {
        if (Speichern is not null && !Speichern())
        {
            Melden(SpeichernGrund is null ? "" : SpeichernGrund(), WarnStufe.Warnung);
            return;
        }
        Melden("");
        _status = string.Format(VorlageGespeichert, DateTime.Now.ToString("HH:mm"));
    }

    private Task BeiOk()
    {
        if (Speichern is not null && !Speichern())
        {
            Melden(SpeichernGrund is null ? "" : SpeichernGrund(), WarnStufe.Warnung);
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(true);
    }

    private Task BeiAbbrechen() => Geschlossen.InvokeAsync(false);

    private void Melden(string text, WarnStufe stufe = WarnStufe.Hinweis)
    {
        _meldung = text;
        _meldungStufe = stufe;
    }

    private bool UeberlagerungOffen => _namensGaben is not null || _uebernahmeOffen
        || _unterGaben is not null || _frage.Length > 0;

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Enter ist NICHT belegt (A-7 aus B5b); Esc geht zuerst an eine offene
        // Überlagerung — sie fängt die Taste selbst ab.
        if (e.Key != "Escape" || UeberlagerungOffen) return Task.CompletedTask;
        return BeiAbbrechen();
    }
}
