        { "Wohnen", "Arbeitstage", "Schule", "Hotel/Heim", "Auslastungsgang" };

    private static readonly string[] TwwHerkunft =
        { "Verfahren", "Eigenkonstruktion", "frei", "Import", "fiktiv" };

    private static readonly string[] TwwStatus = { "Auslieferung", "eigen", "Import" };

    private IReadOnlyList<Katalogfilterzeile>? _twwZeilen;

    private IReadOnlyList<Katalogfilterzeile> TwwZeilen => _twwZeilen ??=
        Enumerable.Range(0, _anzahl).Select(i =>
        {
            string name = TwwNamen[i % TwwNamen.Length] + " " + (i + 1).ToString("D3", CultureInfo.InvariantCulture);
            string status = TwwStatus[i % 7 == 0 ? 0 : 1 + i % 2];
            return new Katalogfilterzeile(i + 1, name) { Schluessel = (i + 1).ToString(CultureInfo.InvariantCulture), Geschuetzt = i % 7 == 0 }
                .MitText(Katalogfilterprofil.SpBezeichner, name)
                .MitText(Katalogfilterprofil.SpBezugsart, TwwBezugsarten[i % TwwBezugsarten.Length])
                .MitText(Katalogfilterprofil.SpKalender, TwwKalender[i % TwwKalender.Length])
                .MitText(Katalogfilterprofil.SpHerkunft, TwwHerkunft[i % TwwHerkunft.Length])
                .MitText(Katalogfilterprofil.SpKatalogversion, "PROBE-" + (1 + i % 3))
                .MitText(Katalogfilterprofil.SpStatus, status);
        }).ToList();

    private Zeichenmodell? _twwTagesgang;
    private Zeichenmodell? _twwJahresgang;

    private TwwNutzungsartDetailDaten? TwwDetail(int id)
    {
        Katalogfilterzeile? z = TwwZeilen.FirstOrDefault(x => x.Id == id);
        if (z is null) return null;
        _twwTagesgang ??= ZapfprofilBilder.TagesgangModell("",
            Enumerable.Range(0, 24).Select(h => 0.2 + 1.8 * Math.Exp(-Math.Pow(h - 7, 2) / 4) + 1.2 * Math.Exp(-Math.Pow(h - 19, 2) / 6)).ToArray(),
            Enumerable.Range(0, 24).Select(h => 0.2 + 1.4 * Math.Exp(-Math.Pow(h - 9, 2) / 5)).ToArray(),
            Enumerable.Range(0, 24).Select(h => 0.2 + 1.2 * Math.Exp(-Math.Pow(h - 10, 2) / 6)).ToArray(),
            null!, null!);
        _twwJahresgang ??= ZapfprofilBilder.JahresgangModell(
            Enumerable.Range(0, 12).Select(m => 60.0 + 12.0 * Math.Cos(2 * Math.PI * m / 12.0)).ToArray(), null!, "kWh", null!);
        bool geschuetzt = z.Geschuetzt;
        return new TwwNutzungsartDetailDaten
        {
            Id = id,
            Name = z.Bezeichner,
            Katalogversion = "PROBE-1",
            Unterzeile = "PROBE-1 · " + (geschuetzt ? "Auslieferung" : "eigen") + " · Personen",
            Auslieferung = geschuetzt,
            AendernGrund = geschuetzt ? "Die Zeile gehört zur Auslieferung – Ändern legt eine neue Zeile an." : "",
            LoeschGrund = geschuetzt ? "Die Zeile gehört zur Auslieferung." : "",
            Kennzahlen = new[] { new Stammblattkennzahl("40", "Liter je P und Tag (mittel)"), new Stammblattkennzahl("2,3", "kWh je P und Tag") },
            Kennwerte = new[]
            {
                new Stammblattwert("Bezugsart", "Personen"),
                new Stammblattwert("Bedarf niedrig · mittel · hoch", "1,6 · 2,3 · 3,5", "kWh je Einheit und Tag"),
                new Stammblattwert("Bandbreite mittel", "1,8 … 2,9", "kWh je Einheit und Tag"),
                new Stammblattwert("Zapftemperatur · Kaltwasser", "45 · 10", "°C"),
                new Stammblattwert("Bilanzgrenze", "Zapfstelle"),
                new Stammblattwert("Kalender", "Wohnen"),
                new Stammblattwert("Ferienfaktor", "1")
            },
            Gaenge = new[]
            {
                new Stammblattwert("Monatsfaktoren", "1,1 1,1 1,05 1 0,95 0,9 0,85 0,85 0,95 1 1,05 1,1"),
                new Stammblattwert("Wochenfaktoren", "Werktag 1 · Samstag 1,1 · Sonn-/Feiertag 1,05")
            },
            Tagesgang = new[] { new Stammblattwert("Tagesgangsatz", "Probesatz · PROBE-1"), new Stammblattwert("Status", "vollständig") },
            Kategorien = new[]
            {
                new Stammblattwert("Kurz", "V 2 · σ 1 · 1 min · Anteil 0,6"),
                new Stammblattwert("Lang", "V 8 · σ 2 · 5 min · Anteil 0,4")
            },
            Herkunft = new[]
            {
                new Stammblattwert("Status", geschuetzt ? "Auslieferung" : "eigen"),
                new Stammblattwert("Quelle der Bedarfswerte", "Verfahren · Probequelle"),
                new Stammblattwert("Verwendet in", "keinem Projekt")
            },
            TagesgangModell = _twwTagesgang,
            JahresgangModell = _twwJahresgang
        };
    }

    private ZapfprofilDaten? _zapfDaten;

