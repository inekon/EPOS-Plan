    /// <remarks>
    /// <para><b>Warum überhaupt eine Sicht.</b> Dreizehn der fünfzehn Felder stehen an
    /// der gewählten <c>ErzeugerZeile</c> und werden unverändert durchgereicht. Die zwei
    /// AUSLEGUNGSTEMPERATUREN stehen dort NICHT: Sie gehören dem Projekt
    /// (<c>Tab_Einstellungen</c>), leben im Strangbaustein und werden über
    /// <c>AuslegungstemperaturenSetzen</c> zurückgeschrieben. Die Brücke kennt je Maske
    /// EIN Daten-Objekt — also trägt die Sicht beide Herkünfte.</para>
    /// <para><b>Der Schreibweg der Temperaturen ist der der Maske.</b> Gesetzt wird über
    /// <c>PvStraengeFelder</c>, damit die Strangampel nachprüft und das Eingabefeld die
    /// neue Zahl zeigt; steht der Strangabschnitt noch nicht (kein Zeichenlauf), geht
    /// die Setzung unmittelbar in die Projekteinstellungen.</para>
    /// </remarks>
    private PhotovoltaikKiSicht? KiSicht()
    {
        // Welle #458, Stufe 2: Die Sicht steht auch, solange nur eine KATALOGzeile
        // gewaehlt ist - dann traegt sie allein den Aufklapper „Alle Daten"; die Felder
        // der Anlage sind leer, genau wie auf der Maske.
        if (_projektZeile is null && _katalogZeile is null) return null;

        return _kiSicht ??= new PhotovoltaikKiSicht
        {
            Zeilenquelle = () => _projektZeile,
            ModellEintraege = Modelleintraege,
            AlleDaten = new AlleDatenTafel
            {
                Felder = () => _parameterOffen ? _felder : null,
                Sperrgrund = () => AlleDatenTafel.Grund(_parameterOffen ? _felder : null, KatalogfelderSpeichern is not null,
                                                        _katalogZeile?.Geschuetzt == true),
                Gesetzt = () => _felderGeaendert = true
            },
            KaltLesen = () => _straenge?.TKaltLebend ?? AuslegungKalt,
            HeissLesen = () => _straenge?.THeissLebend ?? AuslegungHeiss,
            KaltSetzen = wert =>
            {
                if (_straenge is not null) _ = _straenge.TKaltSetzen(wert);
                else AuslegungstemperaturenSetzen?.Invoke(wert, AuslegungHeiss);
            },
            HeissSetzen = wert =>
            {
                if (_straenge is not null) _ = _straenge.THeissSetzen(wert);
                else AuslegungstemperaturenSetzen?.Invoke(AuslegungKalt, wert);
            }
        };
    }

    /// <summary>
    /// Die zwei Einträge des Auswahlfelds „Rechenmodell" (KI‑D‑Q6, KI‑D‑Q7) — dieselben
    /// Schlüssel und dieselben Texte, die <c>PvModellFelder</c> zeichnet.
    /// </summary>
    private IReadOnlyList<KiWahleintrag> Modelleintraege()
        => new[]
        {
            new KiWahleintrag("0", _modellTexte.ModellEinfach),
            new KiWahleintrag("1", _modellTexte.ModellErweitert)
        };

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Auftrag #201, Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>„Speichern" heißt hier ÜBERNEHMEN.</b> Dieser Dialog schreibt nicht in
    /// einen Katalog, er schreibt die gewählte Projektzeile in das Modell zurück —
    /// derselbe Weg, den jedes geänderte Feld der Zeile von Hand geht
    /// (<c>Uebernehmen?.Invoke(_projektZeile)</c>). Ohne gewählte Zeile gibt es nichts zu
    /// übernehmen, und die Aktion lehnt benannt ab.</para>
    /// <para><b>Keine eigene Prüfung.</b> Die drei angemeldeten Felder sind Zahlenfelder,
    /// die sich selbst färben; eine Knopfprüfung wie in den Katalogeditoren hat dieser
    /// Dialog nicht.</para>
    /// <para><b>Seit Auftrag #211 kennt auch dieser Haken den SCHREIBSCHUTZ.</b>
    /// <c>ErzeugerZeile.NurLesen</c> trägt das <c>ReadOnly</c> des Geräts, auf das die
    /// gewählte Zeile verweist (Fachkonzept 4.5, Muster
    /// <c>WaermepumpeStammDaten.NurLesen</c>) — ohne gewählte Zeile ist nichts
    /// schreibgeschützt.</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _projektZeile?.NurLesen ?? false,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>
    /// „Speichern" des Assistenten: Trägt der Aufklapper „Alle Daten" Änderungen, geht
    /// er den Weg SEINES Knopfes (<see cref="FelderSpeichern"/>) — sonst wird die
    /// gewählte Projektzeile übernommen wie bisher (Welle #458, Stufe 2).
    /// </summary>
    private KiKern.KiErgebnis KiSpeichern()
    {
        if (!_felderGeaendert) return KiUebernehmen();

        FelderSpeichern();
        return _felderGeaendert
            ? KiKern.KiErgebnis.Abgelehnt(_meldung.Length > 0 ? _meldung
                  : Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText))
            : KiKern.KiErgebnis.Ok(_felderErfolg, anzahl: 1);
    }

    private KiKern.KiErgebnis KiUebernehmen()
    {
        if (_projektZeile is null || Uebernehmen is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", TitelText));

        Uebernehmen(_projektZeile);
        return KiKern.KiErgebnis.Ok(_projektZeile.Bezeichner, anzahl: 1);
    }

    /// <summary>
    /// Die Anmeldung bei der <c>KiMaskenbruecke</c> (Auftrag #200, Stufe S2). Sie hält
    /// die drei Getter auf die gewählte Projektzeile und fällt mit dem Dialog.
    /// </summary>
    /// <remarks>
    /// <b>Angemeldet heißt nicht übertragen.</b> Ob ein Feldwert hinausgeht, entscheiden
    /// der Schalter „Feldwerte mitsenden" im Chat und die Einwilligungsstufe
    /// „Dialogdaten" (KI‑D‑Q2).
    /// </remarks>
    private KiMaskenanmeldung? _kiMaske;

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private void GesamtNeu() { if (Gesamtleistung is not null) _gesamtleistung = Gesamtleistung(); }

    /// <summary>
    /// Die ABGELEITETE Modulzahl der gewählten Zeile: Σ (Reihe × parallel) über alle
    /// Stränge (Q9). Prüfhilfe für Tests.
    /// </summary>
    public int Modulzahl
    {
        get
        {
            if (_projektZeile is null) return 0;
            int summe = 0;
            foreach (StrangZeile s in _projektZeile.Straenge) summe += s.Modulzahl;
            return summe;
        }
    }

    private string ModulzahlText => Modulzahl.ToString(CultureInfo.CurrentCulture);

    /// <summary>
    /// Jede Änderung an der Strangtabelle: Sie schreibt die abgeleitete Modulzahl in
    /// den ANLAGENWERT zurück (Q9 — „der Anlagenwert wird mitgeschrieben, damit kWp,
    /// Stückpreis und Wirtschaftlichkeit unverändert weiterlesen"), übernimmt die
    /// Zeile und erfragt die Gesamtleistung neu.
    ///
    /// <para><b>Nur mit Strang.</b> Ohne Strangzeile bleibt „Anzahl Module" ein
    /// Eingabefeld, und die abgeleitete 0 dürfte den eingetippten Wert nicht
    /// überschreiben.</para>
    /// </summary>
    private void BeiStrangaenderung()
    {
        if (_projektZeile is null) return;

        if (_projektZeile.Straenge.Count > 0) _projektZeile.AnzahlModule = Modulzahl;

        Uebernehmen?.Invoke(_projektZeile);
        GesamtNeu();
    }

    private double KwpDer(ErzeugerZeile? zeile)
        => zeile is null || AnlagenKwp is null ? 0.0 : AnlagenKwp(zeile);

    /// <summary>
    /// Der Hersteller des Moduls dieser Projektzeile (<b>W6‑E‑6</b>); leer, solange
    /// keine Zeile markiert ist oder die Hülle den Delegaten nicht mitgibt. Was daraus
    /// wird, entscheidet der Abschnitt selbst — er hält die Herstellerliste.
    /// </summary>
    private string ModulherstellerDer(ErzeugerZeile? zeile)
        => zeile is null || Modulhersteller is null ? "" : (Modulhersteller(zeile) ?? "");

    // =================================================================================
    // Filter und Listen
    // =================================================================================

    /// <summary>
    /// Liest den Katalog neu — nach einem SCHREIBweg (Verwaltung, Löschen). Der
    /// FILTER ruft sie nicht: Er wirkt auf die Anzeige, nie auf die Auswahl.
    /// </summary>
    private void KatalogNeuLaden()
    {
        _katalog = Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();
        VerwendungStempeln();

        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
    }

    /// <summary>Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste.</summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    /// <summary>Der Katalogsatz zu einem Bezeichner; <c>null</c>, wenn es ihn nicht gibt.</summary>
    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    /// <summary>
    /// Beide Listen holen ihr Detail aus DEMSELBEN Katalogsatz - der Vorlaeufer las in
    /// beiden Faellen <c>Tab_PV_STAMM</c> ueber den Bezeichner. Nur das
    /// Anlagen-Panel unterscheidet sie.
    /// </summary>
    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _detail = (Detail is not null ? Detail(zeile.Bezeichner) : null) ?? Leer(zeile.Bezeichner);
    }

    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _projektZeile = null;
        _detail = (Detail is not null ? Detail(_katalogGewaehlt) : null) ?? Leer(_katalogGewaehlt);

        // DER AUFKLAPPER GEHOERT ZUM GEWAEHLTEN SATZ. Bleibt er ueber den Wechsel
        // offen - und das soll er, sonst muesste man ihn beim Vergleichen zweier
        // Module jedes Mal neu aufziehen (W6-E-1) -, dann zeigt er die Felder des
        // NEUEN Satzes und nicht die des alten.
        if (_parameterOffen) FelderHolen();
    }

    private static ErzeugerDetail Leer(string name)
        => new(name, "", Array.Empty<(string, string)>());

    // =================================================================================
    // Hinzufuegen und Entfernen
    // =================================================================================

    private void BeiHinzu()
    {
        if (_katalogZeile is null || Aufnehmen is null) return;

        AufnahmeErgebnis aufnahme = Aufnehmen(_katalogZeile.Id);
        if (!string.IsNullOrEmpty(aufnahme.Meldung)) Melden(aufnahme.Meldung, aufnahme.Fehler);
        if (aufnahme.Zeile is null) return;

        Zeilen.Add(aufnahme.Zeile);
        VerwendungStempeln();                 // Q12
        ProjektZeileWaehlen(aufnahme.Zeile);
        GesamtNeu();
    }

    /// <summary>A-5: Es geht die ZEILE hinaus, nicht ihr Listenindex.</summary>
    private void BeiEntfernen()
    {
        if (_projektZeile is null) return;

        ErzeugerZeile zeile = _projektZeile;
        Zeilen.Remove(zeile);
        Entfernen?.Invoke(zeile);
        VerwendungStempeln();                 // Q12

        _projektZeile = null;
        _detail = Leer("");
        GesamtNeu();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
    }

    // =================================================================================
    // Anlageneigenschaften
    // =================================================================================

    private void BeiNeigung(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Neigung = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    /// <summary>ET‑5: Trägerwechsel der markierten Anlage — an die Hülle, dann in die Zeile.</summary>
    private void BeiTraegerwechsel(int? neu)
    {
        if (_projektZeile is null || !neu.HasValue) return;
        if (neu.Value == _projektZeile.CarrierId) return;   // programmatische Vorwahl
        TraegerWechseln?.Invoke(_projektZeile, neu.Value);
        _projektZeile.CarrierId = neu.Value;
    }

    private void BeiAzimut(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Azimut = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    /// <summary>
    /// Die Anzahl Module ist im Modell ein <c>double</c> (<c>PV_Leistung</c>) - der Name
    /// des Feldes taeuscht, der Inhalt ist eine Stueckzahl. Sie geht in die
    /// Gesamtleistung ein, die deshalb sofort neu erfragt wird.
    /// </summary>
    private void BeiAnzahl(double? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.AnzahlModule = wert;
        Uebernehmen?.Invoke(_projektZeile);
        GesamtNeu();
    }

    // =================================================================================
    // Katalogpflege
    // =================================================================================
    /// <summary>Der Parametersatz der offenen Katalogverwaltung; <c>null</c> = zu.</summary>
    private IReadOnlyDictionary<string, object>? _verwaltungGaben;

    /// <summary>Steht die Katalogverwaltung? (Prüfhilfe für Tests.)</summary>
    public bool VerwaltungOffen => _verwaltungGaben is not null;

    /// <summary>
    /// Nach der Verwaltung die Katalogliste neu ziehen — genau das tat der Vorläufer
    /// nach der Rückkehr aus dem zweiten Fenster.
    /// </summary>
    private void VerwaltungFertig(ModulErgebnis? ergebnis)
    {
        _verwaltungGaben = null;
        KatalogNeuLaden();
    }


    private async Task BeiBearbeiten()
    {
        if (VerwaltungGaben is null) return;
        _verwaltungGaben = VerwaltungGaben();
        await Task.CompletedTask;
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || _katalogZeile is null || KatalogLoeschen is null) return;

        if (!KatalogLoeschen(_katalogZeile.Id)) { Melden(MeldungLoeschFehler, true); return; }

        _katalogZeile = null;
        _katalogGewaehlt = "";
        _detail = Leer("");
        KatalogNeuLaden();
    }

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Der Abbrechen-Weg: schliesst ohne zu speichern. Esc und das ✕ im Kopf rufen ihn.</summary>
    private Task Abbrechen() => BeiErgebnis(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _loeschfrage) return Task.CompletedTask;
        return Abbrechen();
    }
}
