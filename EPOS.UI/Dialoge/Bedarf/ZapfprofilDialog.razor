    /// gespeicherten Wert als Eintrag").
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Nutzungsarten
    {
        get
        {
            var liste = Katalogliste
                .Select(n => (n.Id, string.IsNullOrEmpty(n.Bezugsgroesse) ? n.Name : n.Name + " · " + n.Bezugsgroesse))
                .ToList();
            ZapfprofilZoneDaten? z = Gewaehlte;
            if (z is not null && z.IdNutzungsart > 0 && liste.All(e => e.Id != z.IdNutzungsart))
                liste.Add((z.IdNutzungsart, "#" + z.IdNutzungsart.ToString(CultureInfo.InvariantCulture)));
            return liste;
        }
    }

