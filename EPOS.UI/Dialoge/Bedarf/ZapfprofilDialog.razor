    /// <summary>Gibt es einen Punkt, der überholt werden kann: den übernommenen oder den des Stands beim Öffnen?</summary>
    private bool PunktVorhanden
        => !_eingabe.PunktUeberholt
           && (_eingabe.Auslegung is { } a ? a.PunktVolumenL.HasValue || a.PunktLeistungKw.HasValue : Daten.MitPunkt);

    /// <summary>
    /// Eine Zonenänderung, die die Auslegung ändert: Der Punkt ist überholt — der übernommene
    /// fällt aus dem Arbeitsstand, ein Punkt des Stands beim Öffnen wird beim Speichern
    /// verworfen. Der Name einer Zone ändert die Auslegung nicht.
    /// </summary>
    private void PunktUeberholen()
    {
        if (!PunktVorhanden) return;
        if (_eingabe.Auslegung is { } a)
        {
            a.PunktVolumenL = null;
            a.PunktLeistungKw = null;
        }
        _eingabe.PunktUeberholt = true;
    }

    private void AnsichtWaehlen(int? id) => _ansicht = id ?? 0;

    /// <summary>
    /// Eine Eingabe hat den Arbeitsstand geändert: die Vorschau ist überholt und wird entprellt
    /// neu gerechnet; ein Lauf der Jahresreihe gehört zum alten Stand — er bricht ab, sein
    /// Ergebnis fällt weg.
    /// </summary>
    private void Geaendert(bool ansichtZuruecksetzen = false)
    {
        _okMeldung = "";
        _okKennung = null;
        _hinweis = "";
        _editorStatus = "";
        _kalibrierstatus = "";
        _vorschauAktuell = false;
        _ladehilfeAktuell = false;
        JahresreiheVerwerfen();
        // Ein Vergleich gehört zu dem Stand, gegen den er gerechnet wurde: Er bleibt sichtbar,
        // trägt aber den Veraltet-Vermerk; ein laufender bricht ab. Eine laufende Kalibrierung
        // gehört demselben alten Stand — sie bricht ab, ohne Felder zu setzen.
        VergleichVeralten();
        KalibrierLaufVerwerfen();
        if (ansichtZuruecksetzen) _ansicht = 0;
        VorschauEntprellen();
    }

    // =================================================================================
    // Vorschau - entprellt (EPOS.UI/CLAUDE.md, "Zeichenlaeufe")
    // =================================================================================

    private void VorschauEntprellen()
    {
        EntprellungAbbrechen();
        if (Vorschau is null) return;
        if (EntprellungMs <= 0)
        {
            VorschauRechnen();
            return;
        }

        var quelle = new CancellationTokenSource();
        _entprellung = quelle;
        _ = EntprellungAbwarten(quelle);
    }

    private async Task EntprellungAbwarten(CancellationTokenSource quelle)
    {
        try
        {
            await Task.Delay(EntprellungMs, quelle.Token);
            if (quelle.IsCancellationRequested) return;
            await InvokeAsync(() =>
            {
                if (quelle.IsCancellationRequested) return;
                VorschauRechnen();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { /* eine neue Eingabe war schneller */ }
        catch (ObjectDisposedException) { /* der Dialog ist gegangen */ }
    }

    private void EntprellungAbbrechen()
    {
        CancellationTokenSource? offen = _entprellung;
        _entprellung = null;
        if (offen is null) return;
        try { offen.Cancel(); } catch (ObjectDisposedException) { }
        offen.Dispose();
    }

    private void VorschauRechnen()
    {
        if (Vorschau is null) return;
        _vorschau = Vorschau(_eingabe.Kopie());
        _vorschauAktuell = _vorschau is not null;
        if (_vorschau is not null && _ansicht >= _vorschau.Ansichten.Count) _ansicht = 0;
        LadehilfeRechnen();
    }

    // =================================================================================
    // Ergebnis
    // =================================================================================

    /// <summary>
    /// OK prüft über den Delegaten der Hülle — dieselbe Regel für jeden Weg, der übernimmt
    /// —, meldet eine Lücke als Banner und hält den Dialog offen; sonst geht der Arbeitsstand
    /// mit dem Weg „Generator" zurück (ZU4: das OK stellt die Optionsgruppe um).
    /// </summary>
    private async Task BeiErgebnis(bool ok)
    {
        if (!ok)
        {
            await Abbrechen();
            return;
        }

        // Die wirksame Bezugsmenge einer Wohnungstabelle rechnet der Kern (Vorschau): vor der Prüfung
        // frisch rechnen — die teure Stufe läuft sofort vor dem Übernehmen — und in die Bezugsgröße nehmen.
        if (!_vorschauAktuell && Vorschau is not null)
        {
            EntprellungAbbrechen();
            VorschauRechnen();
        }
        WirksameMengenUebernehmen();

        (string befund, string? kennung) = OkBefund();
        if (befund.Length > 0)
        {
            _okMeldung = befund;
            _okKennung = kennung;
            return;
        }

        // Die Jahresreihe zieht der Lauf der Simulation selbst; ein offener Lauf des Dialogs endet hier.
        EntprellungAbbrechen();
        JahresreiheVerwerfen();
        KalibrierLaufVerwerfen();
        ZapfprofilEingabeDaten ergebnis = _eingabe.Kopie();
        ergebnis.Weg = ZapfprofilWeg.Generator;
        await Geschlossen.InvokeAsync(new ZapfprofilErgebnisDaten(ergebnis));
    }

    /// <summary>
    /// Übernimmt die wirksame Bezugsmenge des Kerns für jede Zone, deren Wohnungstabelle bei ihrer
    /// Nutzungsart wirkt (4.1: die Menge kommt aus der Tabelle) — die Bezugsgröße der Zone und die
    /// gespeicherte Menge sagen dann dasselbe. Eine Übernahme ändert die Auslegung nicht: Der Kern
    /// rechnete schon mit dieser Menge.
    /// </summary>
    private void WirksameMengenUebernehmen()
    {
        for (int i = 0; i < _eingabe.Zonen.Count; i++)
        {
            ZapfprofilZoneDaten z = _eingabe.Zonen[i];
            if (WirksameMenge(z, Nutzungsart(z.IdNutzungsart)) is double wirksam && wirksam > 0) z.Bezugsmenge = wirksam;
        }
    }

    /// <summary>Abbrechen — von Esc, vom Schliesskreuz und vom Knopf gleichermaßen gerufen; verwirft ohne Prüfung.</summary>
    private Task Abbrechen()
    {
        EntprellungAbbrechen();
        JahresreiheVerwerfen();
        KalibrierLaufVerwerfen();
        return Geschlossen.InvokeAsync(null);
    }

    /// <summary>
    /// Esc schließt nur, wenn KEINE Überlagerung offen ist — sonst schließt sie sich selbst. Geprüft
    /// werden alle sechs Schalter (Auslegung, Tagesgang, Zapfkategorien, Typtage, Messdaten,
    /// Kalibriervorschlag) und die offene Rückfrage.
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
        => e.Key == "Escape" && _auslegungGaben is null && _tagesgangGaben is null && _kategorienGaben is null
           && _typtagGaben is null && _messreihenGaben is null && _vorschlag is null && !_frageOffen
            ? Abbrechen() : Task.CompletedTask;

    /// <summary>
    /// Der Befund des OK — eine Fehleingabe (Seed, Realisierungen) oder die Fehler der
    /// Pflichtprüfung der Hülle; leer = in Ordnung. Dieselbe Prüfung am Knopf und beim
    /// Assistenten (<see cref="KiHaken"/>).
    /// </summary>
    private (string Text, string? Kennung) OkBefund()
    {
        // Ein Feld mit ungültigem Text (Seed, Realisierungen) hielte sonst still den alten Wert.
        if (_fehlfelder.Count > 0)
            return (Format(Texte.MeldungFehleingabe, string.Join(", ", _fehlfelder)), "ZPG_MSG_FEHLEINGABE");

        IReadOnlyList<ZapfprofilMeldung> fehler = (Pruefen?.Invoke(_eingabe) ?? Array.Empty<ZapfprofilMeldung>())
            .Where(m => m.Art == ZapfprofilMeldungsart.Fehler).ToList();
        return fehler.Count > 0
            ? (string.Join(" ", fehler.Select(m => m.Text)), fehler[0].Kennung)
            : ("", null);
    }

    // =================================================================================
    // Der Hilfe-Assistent (Welle #458, Stufe 3a)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private ZapfprofilKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten auf den ARBEITSSTAND: Stufe, Zonenwahl, die Zonen als
    /// Spalten, die Ansicht der Vorschau und die Stochastik der Stufe Experte. Gesetzt wird
    /// auf den Wegen der Eingabefelder — die Vorschau rechnet entprellt neu wie nach einer
    /// Eingabe von Hand.
    /// </summary>
    private ZapfprofilKiSicht KiSicht() => _kiSicht ??= new ZapfprofilKiSicht
    {
        StufeLesen = () => (int)_stufe,
        StufeSetzen = KiStufe,
        StufeEintraege = () => KiMaskenanmeldung.Eintraege(Stufen, e => e.Id, e => e.Text),

        ZoneLesen = () => _wahl >= 0 && _wahl < _eingabe.Zonen.Count ? _wahl + 1 : null,
        ZoneSetzen = KiZoneWaehlen,
        ZoneEintraege = () => KiMaskenanmeldung.Eintraege(
            Enumerable.Range(0, _eingabe.Zonen.Count), i => i + 1, i => _eingabe.Zonen[i].Name),

        ZonenLesen = () => _eingabe.Zonen.Select(KiZeile).ToList(),
        NutzungsartEintraege = () => KiMaskenanmeldung.Eintraege(Katalogliste, n => n.Id, n => n.Name),
        NiveauEintraege = () => KiMaskenanmeldung.Eintraege(Niveaus, e => e.Id, e => e.Text),

        AnsichtLesen = () => Ansicht is null ? null
                           : _ansicht >= 0 && _ansicht < _vorschau!.Ansichten.Count ? _ansicht : 0,
        AnsichtSetzen = KiAnsicht,
        AnsichtEintraege = () => KiMaskenanmeldung.Eintraege(
            Ansicht is null ? Array.Empty<(int Id, string Text)>() : Ansichtswahl, e => e.Id, e => e.Text),

        RechenwegLesen = () => _eingabe.JahresreiheStochastisch ? RECHENWEG_STOCHASTISCH : RECHENWEG_DETERMINISTISCH,
        RechenwegSetzen = KiRechenweg,
        RechenwegEintraege = () => KiMaskenanmeldung.Eintraege(Rechenwege, e => e.Id, e => e.Text),

        // Stufe Experte (Z4b): die Wahl des Typtagwegs - eine Groesse des Projekts.
        TyptagewegLesen = () => _eingabe.TyptageAktiv,
        TyptagewegSetzen = KiTyptageweg,
        TyptagzoneLesen = () => _eingabe.TyptageKlimazone,
        TyptagzoneSetzen = KiTyptagzone,
        TyptagzoneEintraege = () => KiMaskenanmeldung.Eintraege(Typtagzonen, e => e.Id, e => e.Text),
        TyptagartLesen = () => TyptagartWahl,
        TyptagartSetzen = KiTyptagart,
        TyptagartEintraege = () => KiMaskenanmeldung.Eintraege(Typtagarten, e => e.Id, e => e.Text),

        MessreiheLesen = () => VergleichWahlId,
        MessreiheSetzen = KiMessreihe,
        MessreiheEintraege = () => KiMaskenanmeldung.Eintraege(Messreihenwahl, e => e.Id, e => e.Text),
        SeedLesen = () => _eingabe.Seed,
        SeedSetzen = KiSeed,
        RealisierungenLesen = () => _eingabe.Realisierungen,
        RealisierungenSetzen = KiRealisierungen,

        // Stufen Erweitert und Experte (Z4): die gewählte Zone und das Gebäude, benannt nach der Eigenschaft.
        AngabeLesen = KiAngabeLesen,
        AngabeSetzen = KiAngabeSetzen,
        AngabeWahl = KiAngabeWahl,
        WohnungenLesen = KiWohnungen,
        FerienLesen = KiFerien
    };

    /// <summary>Eine Zone als Zeile der Sicht — ihre Setzer nehmen den Weg der Eingabefelder.</summary>
    private ZapfprofilZoneKiZeile KiZeile(ZapfprofilZoneDaten z) => new(z)
    {
        ZonennameSetzen = w => KiInZone(z, () => ZonennameSetzen(z, w)),
        NutzungsartSetzen = id => KiNutzungsart(z, id),
        BezugsmengeSetzen = w => KiInZone(z, () => ZonenBezugsmengeSetzen(z, w)),
        NiveauSetzen = id => KiInZone(z, () => ZonenNiveauSetzen(z, id)),
        JahresbedarfLesen = () => Zonenwert(_eingabe.Zonen.IndexOf(z))
    };

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf: auffrischen und prüfen.
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg</b> — „OK" gibt den Arbeitsstand an die Bedarfsprofile zurück,
    /// und geschrieben wird mit deren OK; beides bleibt der Klick des Anwenders
    /// (<c>dialog_speichern</c> lehnt benannt ab). <b>Prüfen</b> ist der Befund des OK.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => OkBefund().Text
    };

    /// <summary>Die Stufe wie in der Optionsgruppe (alle drei wählbar).</summary>
    private string? KiStufe(int? id)
    {
        StufeWaehlen(id);
        return null;
    }

    /// <summary>Die Zone wählen wie ein Klick in die Liste — nach ihrer Nummer (ab 1).</summary>
    private string? KiZoneWaehlen(int? nummer)
    {
        if (nummer is not int n || n < 1 || n > _eingabe.Zonen.Count) return ZapfprofilKiRegeln.ZeileFehlt;
        ZoneWaehlen(n - 1);
        return null;
    }

    /// <summary>Ein Setzweg einer Zone — nur, solange die Zone in der Liste steht.</summary>
    private string? KiInZone(ZapfprofilZoneDaten z, Action weg)
    {
        if (!_eingabe.Zonen.Contains(z)) return ZapfprofilKiRegeln.ZeileFehlt;
        weg();
        return null;
    }

    /// <summary>Die Nutzungsart einer Zone; eine gesperrte nennt ihren Grund wie die Auswahlliste.</summary>
    private string? KiNutzungsart(ZapfprofilZoneDaten z, int? id)
    {
        if (id is int n && Nutzungsart(n) is { Waehlbar: false } art)
            return art.Sperrgrund.Length > 0 ? art.Sperrgrund : ZapfprofilKiRegeln.Gesperrt(art.Name);
        return KiInZone(z, () => ZonenNutzungsartSetzen(z, id));
    }

    /// <summary>„Anzeigen für" — nur mit gerechneter Vorschau; sonst ihr Grund.</summary>
    private string? KiAnsicht(int? id)
    {
        if (Ansicht is null) return VorschauGrund;
        AnsichtWaehlen(id);
        return null;
    }

    /// <summary>Der Rechenweg der Jahresreihe — er steht ab der Stufe Erweitert auf der Maske (N12 (s)).</summary>
    private string? KiRechenweg(int? id)
    {
        if (_stufe == ZapfprofilStufe.Einfach)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelRechenwegJahresreihe, Texte.StufeErweitert);
        RechenwegSetzen(id);
        return null;
    }

    /// <summary>
    /// Der Typtagweg — Stufe Experte; ohne eingespielte Typtage benannt abgelehnt (dieselbe Sperre
    /// wie am Schalter).
    /// </summary>
    private string? KiTyptageweg(bool wert)
    {
        if (_stufe != ZapfprofilStufe.Experte)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelTyptageAktiv, Texte.StufeExperte);
        if (wert && !TyptageDa) return Texte.HinweisTyptageOhne;
        TyptageAktivSetzen(wert);
        return null;
    }

    /// <summary>Die Klimazone der Typtage — Stufe Experte, nur eine Nummer des eingespielten Pakets.</summary>
    private string? KiTyptagzone(int? id)
    {
        if (_stufe != ZapfprofilStufe.Experte)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelTyptageZone, Texte.StufeExperte);
        if (id is int z && Typtagzonen.All(e => e.Id != z)) return ZapfprofilKiRegeln.ZeileFehlt;
        TyptagzoneSetzen(id);
        return null;
    }

    /// <summary>Die Gebäudeart der Typtage — Stufe Experte, nur eine des eingespielten Pakets.</summary>
    private string? KiTyptagart(int? id)
    {
        if (_stufe != ZapfprofilStufe.Experte)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelTyptageGebaeudeart, Texte.StufeExperte);
        if (id is int i && Typtagarten.All(e => e.Id != i)) return ZapfprofilKiRegeln.ZeileFehlt;
        TyptagartSetzen(id);
        return null;
    }

    /// <summary>
    /// Die Messreihe des Vergleichs — ab der Stufe Erweitert und nur eine der eingespielten;
    /// gesetzt wird allein die WAHL, gerechnet wird auf Klick.
    /// </summary>
    private string? KiMessreihe(int? id)
    {
        if (!AbErweitert) return ZapfprofilKiRegeln.NurMit(Texte.LabelMessreihe, Texte.StufeErweitert);
        if (id is int i && Messreihenwahl.All(e => e.Id != i)) return ZapfprofilKiRegeln.ZeileFehlt;
        VergleichReiheSetzen(id);
        return null;
    }

    /// <summary>Der Seed — Stufe Experte, ganze Zahl ab 0; leer = Vorgabe.</summary>
    private string? KiSeed(int? wert)
    {
        if (_stufe != ZapfprofilStufe.Experte)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelSeed, Texte.StufeExperte);
        string? grund = ZapfprofilKiRegeln.Bereich(Texte.LabelSeed, wert, 0, null);
        if (grund is not null) return grund;
        SeedSetzen(wert);
        return null;
    }

    /// <summary>Die Realisierungen — Stufe Experte beim Rechenweg „stochastisch", in den Grenzen des Feldes.</summary>
    private string? KiRealisierungen(int? wert)
    {
        if (_stufe != ZapfprofilStufe.Experte)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelRealisierungen, Texte.StufeExperte);
        if (!_eingabe.JahresreiheStochastisch)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelRealisierungen, Texte.OptionStochastisch);
        string? grund = ZapfprofilKiRegeln.Bereich(Texte.LabelRealisierungen, wert,
                                                   Daten.RealisierungenMindestens, Daten.RealisierungenHoechstens);
        if (grund is not null) return grund;
        RealisierungenSetzen(wert);
        return null;
    }

    // --- Die Angaben der Stufen Erweitert und Experte (Z4) --------------------------------

    /// <summary>
    /// Eine Angabe der höheren Stufen für den Assistenten: in welcher Stufe sie steht, ob sie der
    /// gewählten Zone gehört, ihre Beschriftung, wann sie sonst noch sichtbar ist (<c>null</c> =
    /// immer; sonst der Grund der Absage), Lesen, Setzen (Grund einer Ablehnung oder <c>null</c>)
    /// und — bei einer Wahl — ihre Einträge.
    /// </summary>
    private sealed record KiAngabe(ZapfprofilStufe Stufe, bool Zone, string Beschriftung, Func<string?>? Sichtbar,
                                   Func<ZapfprofilZoneDaten?, object?> Lesen, Func<ZapfprofilZoneDaten?, object?, string?> Setzen,
                                   Func<IReadOnlyList<(int Id, string Text)>>? Wahl = null);

    private Dictionary<string, KiAngabe>? _kiAngaben;

    private IReadOnlyDictionary<string, KiAngabe> KiAngaben => _kiAngaben ??= KiAngabenBauen();

    private object? KiAngabeLesen(string feld)
    {
        if (!KiAngaben.TryGetValue(feld, out KiAngabe? k)) return null;
        if (k.Zone && Gewaehlte is null) return null;
        return k.Lesen(Gewaehlte);
    }

    private string? KiAngabeSetzen(string feld, object? wert)
    {
        if (!KiAngaben.TryGetValue(feld, out KiAngabe? k)) return Resource.KI_SIM_KEIN_SCHREIBWEG;
        if (_stufe < k.Stufe)
            return ZapfprofilKiRegeln.NurMit(k.Beschriftung, k.Stufe == ZapfprofilStufe.Experte ? Texte.StufeExperte : Texte.StufeErweitert);
        if (k.Zone && Gewaehlte is null) return ZapfprofilKiRegeln.ZeileFehlt;
        if (k.Sichtbar?.Invoke() is { } verdeckt) return verdeckt;
        return k.Setzen(Gewaehlte, wert);
    }

    private IReadOnlyList<KiWahleintrag> KiAngabeWahl(string feld)
    {
        if (feld == nameof(ZapfprofilWohnungKiZeile.Ausstattung))
            return KiMaskenanmeldung.Eintraege(Daten.Ausstattungen, e => e.Id, e => e.Name);
        if (!KiAngaben.TryGetValue(feld, out KiAngabe? k) || k.Wahl is null) return Array.Empty<KiWahleintrag>();
        return KiMaskenanmeldung.Eintraege(k.Wahl(), e => e.Id, e => e.Text);
    }

    /// <summary>Die Wohnungstabelle der gewählten Zone als Zeilen — ihre Setzer nehmen den Weg der Felder der Tabelle.</summary>
    private IReadOnlyList<ZapfprofilWohnungKiZeile> KiWohnungen()
    {
        if (Gewaehlte is not { Angaben: { } a } z) return Array.Empty<ZapfprofilWohnungKiZeile>();
        return a.Wohnungen.Select((w, i) => new ZapfprofilWohnungKiZeile(w, i + 1)
        {
            AnzahlSetzen = v => KiWohnung(z, w, Texte.LabelAnzahl, v, 1, x => x.Anzahl = v),
            RaumzahlSetzen = v => KiWohnung(z, w, Texte.LabelRaumzahl, v, 0, x => x.Raumzahl = v),
            PersonenSetzen = v => KiWohnung(z, w, Texte.LabelPersonen, v, 0, x => x.Personen = v),
            AusstattungSetzen = v => KiWohnung(z, w, Texte.LabelAusstattung, null, null, x => x.IdAusstattung = v)
        }).ToList();
    }

    /// <summary>Ein Feld der Wohnungstabelle: nur in Erweitert, bei Wohnen und solange Zone und Zeile stehen.</summary>
    private string? KiWohnung(ZapfprofilZoneDaten z, ZapfprofilWohnungDaten w, string feld, double? wert, double? min,
                              Action<ZapfprofilWohnungDaten> weg)
    {
        if (_stufe == ZapfprofilStufe.Einfach) return ZapfprofilKiRegeln.NurMit(Texte.LabelWohnungstabelle, Texte.StufeErweitert);
        if (!_eingabe.Zonen.Contains(z) || z.Angaben is null || !z.Angaben.Wohnungen.Contains(w)) return ZapfprofilKiRegeln.ZeileFehlt;
        if (Nutzungsart(z.IdNutzungsart) is not { Wohnen: true })
            return ZapfprofilKiRegeln.NurMit(Texte.LabelWohnungstabelle, Format(Texte.KalenderNutzungsart, Texte.LabelNutzungsart));
        string? grund = ZapfprofilKiRegeln.Bereich(feld, wert, min, null);
        if (grund is not null) return grund;
        WohnungSetzen(z, w, weg);
        return null;
    }

    /// <summary>Eine Zahl in den Grenzen des Feldes setzen — dieselben Grenzen, die das Eingabefeld trägt.</summary>
    private static string? KiZahl(string feld, object? wert, double? min, double? max, Action<double?> weg)
    {
        double? v = wert as double?;
        string? grund = ZapfprofilKiRegeln.Bereich(feld, v, min, max);
        if (grund is not null) return grund;
        weg(v);
        return null;
    }

    /// <summary>Eine Wahl setzen — nur ein Eintrag der Liste; leer nur, wo das Feld leer sein darf.</summary>
    private static string? KiWahl(string feld, object? wert, IReadOnlyList<(int Id, string Text)> eintraege, bool leer,
                                  Action<int?> weg)
    {
        int? id = wert as int?;
        if (id is null ? !leer : eintraege.All(e => e.Id != id.Value)) return ZapfprofilKiRegeln.Gesperrt(feld);
        weg(id);
        return null;
    }

    /// <summary>Die vier Ferienzeiträume der gewählten Zone als Zeilen — ihre Setzer nehmen den Weg der vier Felder.</summary>
    private IReadOnlyList<ZapfprofilFerienKiZeile> KiFerien()
    {
        if (Gewaehlte is not { } z) return Array.Empty<ZapfprofilFerienKiZeile>();
        ZapfprofilZonenangabenDaten a = AngabenVon(z);
        return Enumerable.Range(0, ZapfprofilZonenangabenDaten.FERIENZEITRAEUME)
            .Select(k => new ZapfprofilFerienKiZeile(Ferienzeitraum(a, k), k + 1)
            {
                BeginnTagSetzen = v => KiFerienteil(z, k, Texte.LabelBeginnTag, v, 31, f => f.BeginnTag = v),
                BeginnMonatSetzen = v => KiFerienteil(z, k, Texte.LabelBeginnMonat, v, 12, f => f.BeginnMonat = v),
                EndeTagSetzen = v => KiFerienteil(z, k, Texte.LabelEndeTag, v, 31, f => f.EndeTag = v),
                EndeMonatSetzen = v => KiFerienteil(z, k, Texte.LabelEndeMonat, v, 12, f => f.EndeMonat = v)
            }).ToList();
    }

    /// <summary>Ein Feld eines Ferienzeitraums: nur in Erweitert, solange die Zone steht, in den Grenzen des Feldes.</summary>
    private string? KiFerienteil(ZapfprofilZoneDaten z, int k, string feld, int? wert, int hoechstens,
                                 Action<ZapfprofilFerienDaten> weg)
    {
        if (_stufe == ZapfprofilStufe.Einfach) return ZapfprofilKiRegeln.NurMit(feld, Texte.StufeErweitert);
        if (!_eingabe.Zonen.Contains(z)) return ZapfprofilKiRegeln.ZeileFehlt;
        string? grund = ZapfprofilKiRegeln.Bereich(FerienFeld(feld, k), wert, 1, hoechstens);
        if (grund is not null) return grund;
        FerienSetzen(z, k, weg);
        return null;
    }

    /// <summary>
    /// <b>Die Feldliste der höheren Stufen</b> — EINE Stelle für Stufe, Sichtbarkeit, Grenzen und den
    /// Weg des Eingabefeldes; die Namen sind die Eigenschaften von <see cref="ZapfprofilKiSicht"/>.
    /// </summary>
    private Dictionary<string, KiAngabe> KiAngabenBauen()
    {
        const ZapfprofilStufe E = ZapfprofilStufe.Erweitert;
        const ZapfprofilStufe X = ZapfprofilStufe.Experte;
        var d = new Dictionary<string, KiAngabe>(StringComparer.Ordinal);

        void Zone(string name, ZapfprofilStufe stufe, string label, Func<ZapfprofilZonenangabenDaten, object?> lesen,
                  Func<ZapfprofilZoneDaten, object?, string?> setzen, Func<IReadOnlyList<(int Id, string Text)>>? wahl = null,
                  Func<string?>? sichtbar = null)
            => d[name] = new KiAngabe(stufe, true, label, sichtbar, z => z is null ? null : lesen(AngabenVon(z)),
                                      (z, w) => setzen(z!, w), wahl);

        void Haus(string name, ZapfprofilStufe stufe, string label, Func<ZapfprofilGebaeudeDaten, object?> lesen,
                  Func<object?, string?> setzen, Func<IReadOnlyList<(int Id, string Text)>>? wahl = null, Func<string?>? sichtbar = null)
            => d[name] = new KiAngabe(stufe, false, label, sichtbar, _ => lesen(G), (_, w) => setzen(w), wahl);

        ZapfprofilNutzungsartDaten? Art() => Gewaehlte is { } z ? Nutzungsart(z.IdNutzungsart) : null;

        // ---- Belegung und Anlage (Erweitert)
        Zone(nameof(ZapfprofilKiSicht.PersonenJeWe), E, Texte.LabelPersonenJeWe, a => a.PersonenJeWe,
             (z, w) => KiZahl(Texte.LabelPersonenJeWe, w, 0, null, v => Angabe(z, x => x.PersonenJeWe = v)));
        Zone(nameof(ZapfprofilKiSicht.WohnflaecheJeWe), E, Texte.LabelWohnflaecheJeWe, a => a.WohnflaecheJeWeM2,
             (z, w) => KiZahl(Texte.LabelWohnflaecheJeWe, w, 0, null, v => Angabe(z, x => x.WohnflaecheJeWeM2 = v)));
        Zone(nameof(ZapfprofilKiSicht.Topologie), E, Texte.LabelTopologie, a => (int?)(int)a.Topologie,
             (z, w) => KiWahl(Texte.LabelTopologie, w, Topologien, false, id => TopologieSetzen(z, id)), () => Topologien);
        Zone(nameof(ZapfprofilKiSicht.ZirkulationVorhanden), E, Texte.LabelZirkulationVorhanden, a => (int?)(a.Zirkulation ? JA : NEIN),
             (z, w) => KiWahl(Texte.LabelZirkulationVorhanden, w, JaNein, false, id => Angabe(z, x => x.Zirkulation = id != NEIN)),
             () => JaNein);
        Zone(nameof(ZapfprofilKiSicht.Kalender), E, Texte.LabelKalender, a => (int?)(a.IdGebaeude ?? KALENDER_NUTZUNGSART),
             (z, w) => KiWahl(Texte.LabelKalender, w, Kalenderwahl(Art(), AngabenVon(z)), false, id => KalenderSetzen(z, id)),
             () => Gewaehlte is { } g ? Kalenderwahl(Art(), AngabenVon(g)) : KeineEintraege);
        Zone(nameof(ZapfprofilKiSicht.Jahresmesswert), E, Texte.LabelJahresmesswert, a => a.Jahresmesswert,
             (z, w) => KiZahl(Texte.LabelJahresmesswert, w, 0, null, v => MesswertSetzen(z, v)));
        Zone(nameof(ZapfprofilKiSicht.MesswertEinheit), E, Texte.LabelMesswertEinheit, a => (int?)a.JahresmesswertEinheit,
             (z, w) => KiWahl(Texte.LabelMesswertEinheit, w, Messwerteinheiten, false, id => MesswertEinheitSetzen(z, id)),
             () => Messwerteinheiten);
        Zone(nameof(ZapfprofilKiSicht.MesswertGrenze), E, Texte.LabelMesswertGrenze, a => (int?)a.JahresmesswertBilanzgrenze,
             (z, w) => KiWahl(Texte.LabelMesswertGrenze, w, Bilanzgrenzen, true, id => MesswertGrenzeSetzen(z, id)), () => Bilanzgrenzen,
             () => Gewaehlte is { } g && AngabenVon(g).JahresmesswertEinheit == ZapfprofilMesswerteinheit.KubikmeterJeJahr
                   ? ZapfprofilKiRegeln.NurMit(Texte.LabelMesswertGrenze, Texte.MesswertKwh) : null);
        Zone(nameof(ZapfprofilKiSicht.Speicherverlust), E, Texte.LabelSpeicherverlust, a => a.SpeicherverlustKwhJeJahr,
             (z, w) => KiZahl(Texte.LabelSpeicherverlust, w, 0, null, v => Angabe(z, x => x.SpeicherverlustKwhJeJahr = v)), null,
             () => Gewaehlte is { } g && AngabenVon(g) is var a
                   && a.JahresmesswertEinheit != ZapfprofilMesswerteinheit.KubikmeterJeJahr
                   && a.JahresmesswertBilanzgrenze == ZapfprofilBilanzgrenze.MitSpeicher
                   ? null : ZapfprofilKiRegeln.NurMit(Texte.LabelSpeicherverlust, Texte.GrenzeSpeicher));
        Zone(nameof(ZapfprofilKiSicht.MesswertQuelle), E, Texte.LabelMesswertQuelle, a => a.JahresmesswertQuelle,
             (z, w) => { Angabe(z, x => x.JahresmesswertQuelle = w as string ?? "", auslegung: false); return null; });
        Zone(nameof(ZapfprofilKiSicht.MesswertZeitraum), E, Texte.LabelMesswertZeitraum, a => a.JahresmesswertZeitraum,
             (z, w) => { Angabe(z, x => x.JahresmesswertZeitraum = w as string ?? "", auslegung: false); return null; });

        // ---- Tagesbedarf, Ladeleistung, Zirkulation (Erweitert)
        Zone(nameof(ZapfprofilKiSicht.TagesbedarfModus), E, Texte.LabelTagesbedarf, a => (int?)(a.TagesbedarfAuto ? AUTO : MANUELL),
             (z, w) => KiWahl(Texte.LabelTagesbedarf, w, AutoManuell, false, id => Angabe(z, x => x.TagesbedarfAuto = id != MANUELL)),
             () => AutoManuell);
        Zone(nameof(ZapfprofilKiSicht.TagesbedarfManuell), E, Texte.LabelTagesbedarfManuell, a => a.TagesbedarfManuellKwh,
             (z, w) => KiZahl(Texte.LabelTagesbedarfManuell, w, 0, null, v => Angabe(z, x => x.TagesbedarfManuellKwh = v)));
