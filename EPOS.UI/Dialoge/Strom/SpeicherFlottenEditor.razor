    private async Task RainflowPunktEntfernen(FlottenEinheit e, FlottenRainflowPunkt p) { e.RainflowKurve.Remove(p); await Melden(); }
    private async Task AchseZahlSetzen(FlottenAuslegungsAchse a, Action<double> setzen, double? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task AchseGanzSetzen(FlottenAuslegungsAchse a, Action<int> setzen, int? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task AchseBoolSetzen(FlottenAuslegungsAchse a, bool wert) { a.Aktiv = wert; await Melden(); }
    private async Task OptionSetzen(Action setzen) { setzen(); await Melden(); }
    private async Task OptionGanzSetzen(Action<int> setzen, int? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task WirtschaftSetzen(Action setzen) { setzen(); await Melden(); }
    private async Task WirtschaftZahlSetzen(Action<double> setzen, double? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task WirtschaftGanzSetzen(Action<int> setzen, int? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task AuslegungGanzSetzen(Action<int> setzen, int? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }

    private async Task BetriebsoptionenSetzen(FlottenSimulationOptionen wert) { _wert.Optionen = Kopie(wert ?? new()); await Melden(); }
    private async Task PrognoseArtSetzen(int? wert) { if (wert.HasValue) _wert.Optionen.PrognoseArt = (PrognoseArt)wert.Value; await Melden(); }
    private async Task EndbedingungSetzen(int? wert) { if (wert.HasValue) _wert.Optionen.Endbedingung = (FlottenEndbedingung)wert.Value; await Melden(); }
    private async Task AchsenmodusSetzen(FlottenAuslegungsAchse a, int? wert) { if (wert.HasValue) a.Modus = (FlottenAuslegungsmodus)wert.Value; await Melden(); }
    private async Task ProjektionsartSetzen(int? wert) { if (wert.HasValue) _wert.Wirtschaftlichkeit.ReferenzjahrExplizitWiederholen = wert.Value == 1; await Melden(); }
    private async Task EndenergieSetzen(int index, double? wert) { if (wert.HasValue) _wert.Optionen.EndenergieZielKWh[index] = wert.Value; await Melden(); }

    private FlottenAuslegungsAchse AchseZu(FlottenEinheit e) =>
        _wert.Auslegung.Achsen.First(x => x.Vorlage?.Id == e.Id);

    private FlottenEinheit NeueEinheit(int nummer) => new()
    {
        Id = NeueId(), Name = string.Format(CultureInfo.CurrentCulture, Texte.StandardEinheit, nummer),
        KapazitaetKWh = 100, LadeleistungKw = 50, EntladeleistungKw = 50,
        Ladewirkungsgrad = 0.95, Entladewirkungsgrad = 0.95,
        SocMin = 0.10, SocMax = 0.90, SocStart = 0.50
    };

    private static FlottenAuslegungsAchse NeueAchse(FlottenEinheit e) => new()
    {
        Aktiv = true, Modus = FlottenAuslegungsmodus.KapazitaetUndLeistung,
        AnzahlVon = 1, AnzahlBis = 1,
        KapazitaetVonKWh = e.KapazitaetKWh, KapazitaetBisKWh = e.KapazitaetKWh, KapazitaetSchrittKWh = 1,
        LeistungVonKw = e.LadeleistungKw, LeistungBisKw = e.LadeleistungKw, LeistungSchrittKw = 1,
        CRateVon = 0.5, CRateBis = 2.0, CRateSchritt = 0.5, Vorlage = Kopie(e)
    };

    private static string NeueId() => "sp-" + Guid.NewGuid().ToString("N");
    private string EinheitName(FlottenEinheit e) => string.IsNullOrWhiteSpace(e.Name) ? Texte.Unbenannt : e.Name;
    private static string InhaltId(FlottenEinheit e) => "flotte-einheit-" +
        string.Concat(e.Id.Select(c => char.IsLetterOrDigit(c) || c == '-' ? c : '-'));
