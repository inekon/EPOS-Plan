@* Der STROMGANG-Reiter der Ergebnisseite (NavigatorStrom, iU9-W11b.10).

   VORBILD. NavigatorStrom (417 Z.): der Verbrauchsstapel (Lastgangprofil,
   Waermepumpe, Heizstab, Kessel), darueber die Erzeugungslinien (BHKW, PV) und
   die Kontrolllinie „Gesamt" - im Viertelstundenraster.

   BEFUND W11-B41 BEHOBEN (A-Zeile): Der Vorlaeufer hatte KEINEN
   Sortiert-Umschalter, anders als NavigatorWaerme und die drei Erzeugerseiten
   der Detailansicht. Er ist ergaenzt; B2 kann es ohnehin.

   BEFUND W11-B40 (A-Zeile): PROFIL_LASTGANG und BHKW_STROM trugen BEIDE
   Color.Brown - im Stapel unten und als Linie darueber nicht zu unterscheiden.
   Die Farben setzt jetzt die Huelle beim Bildauftrag; das BHKW bekommt dort
   eine eigene.

   FEHLENDE REIHEN WERDEN AUSGEBLENDET UND ABGEWAEHLT (:266) - sonst naehme der
   CSV-Export eine unsichtbare Spalte mit.

   WAS ENTFAELLT: CheckboxenAnordnen, SerieSchalten, ApplyCheckboxStates, die
   sieben gleichfoermigen CheckedChanged-Handler und OptimizeYAxisScale (52 Z.
   Achsenskalierung - sie gehoert in den Renderer). *@

@namespace EPOS.UI.Seiten.Simulation

<div class="epos-simerg-block">

    <div class="epos-simerg-schalter">
        <Schalter Bezeichnung="@Resource.SIM_CHK_SORTIERT" Wert="@_sortiert"
                  WertChanged="@(w => { _sortiert = w; Merken(); })" />
    </div>

    <Mehrfachauswahl Bezeichnung="@Resource.SIMERG_LBL_SERIENAUSWAHL"
                     Eintraege="@Eintraege" Gewaehlt="@_gewaehlt"
                     GewaehltChanged="@(w => { _gewaehlt = w; Merken(); })" />

    @* DATENZOOM (Windows-Abnahme 05.09.2026, Befund A-1): Ein aufgezogenes Rechteck
       laesst den Kern das Bild mit diesem Achsenbereich neu zeichnen. Bei 35 040
       Viertelstunden auf 1 100 Bildpunkten ist er der einzige Weg zu einer einzelnen
       Stunde - dreissig Werte je Bildpunkt kann kein Bildzoom aufloesen. *@
    <ChartBild Png="@BildGang"
               Alt="@Resource.CHART_TITEL_STROMBEDARF_STROMVERBRAUCH_JAHRESGANGLINIE"
               BereichGewaehlt="@(b => _bereich = b)"
               Zurueckgesetzt="@(() => _bereich = null)" />

    @if (Csv.HasDelegate)
    {
        <button type="button" class="epos-simerg-knopf" @onclick="CsvGewuenscht">
            @Resource.SIM_BTN_CSV_EXPORT
        </button>
    }

</div>

@code {
    /// <summary>Die waehlbaren Reihen samt Praesenz.</summary>
    [Parameter] public StromgangDaten Daten { get; set; } = new StromgangDaten();

    /// <summary>Liefert das Bild zur aktuellen Schalterstellung.</summary>
    [Parameter] public Func<Bildauftrag, byte[]?>? Bild { get; set; }

    /// <summary>Der CSV-Export - nur die angehakten Reihen. Ohne Delegat kein Knopf.</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> Csv { get; set; }

    /// <summary>
    /// Das Sitzungsgedaechtnis dieses Reiters (#234) — ohne Angabe der prozessweite
    /// Stand aus <see cref="Ganglinienregister"/>. Die VORGABE bleibt hier „nur
    /// Gesamt" (der Anwenderwunsch betraf das Waermeblatt); gemerkt wird die Wahl
    /// aber auch hier, sonst faellt sie beim Blattwechsel zurueck.
    /// </summary>
    [Parameter] public Ganglinienstand? Gedaechtnis { get; set; }

    /// <summary>Die gewaehlten Serienschluessel (Pruefhilfe).</summary>
    public IReadOnlyList<string> GewaehlteReihen => Schluessel();

    /// <summary>Steht die Dauerlinie vorn? (Pruefhilfe)</summary>
    public bool Sortiert => _sortiert;

    /// <summary>Der aufgezogene Achsenbereich; <c>null</c> = das ganze Jahr (Pruefhilfe).</summary>
    public Diagrammbereich? Bereich => _bereich;

    private bool _sortiert;
    private IReadOnlyList<int> _gewaehlt = Array.Empty<int>();
    private bool _erstBelegt;
    private Diagrammbereich? _bereich;
    private Ganglinienstand _stand = new Ganglinienstand();

    protected override void OnInitialized()
        => _stand = Gedaechtnis ?? Ganglinienregister.Stand(Ganglinienregister.STROMGANG);

    private List<Ganglinienreihe> Vorhandene
    {
        get
        {
            var liste = new List<Ganglinienreihe>();
            foreach (Ganglinienreihe r in Daten.Reihen) if (r.Vorhanden) liste.Add(r);
            return liste;
        }
    }

    private IReadOnlyList<(int Id, string Text)> Eintraege
    {
        get
        {
            List<Ganglinienreihe> da = Vorhandene;
            var liste = new List<(int, string)>(da.Count);
            for (int i = 0; i < da.Count; i++) liste.Add((i, da[i].Text));
            return liste;
        }
    }

    /// <summary>
    /// Ausgangszustand „nur Gesamt an" — woertlich aus <c>SetControl</c> :224-228.
    /// Die erste Reihe der Liste ist die Kontrolllinie.
    ///
    /// <para><b>Seit #234 steht das SITZUNGSGEDAECHTNIS davor</b> (dieselbe Bauart wie
    /// im Waermegang): Wer seine Reihen gewaehlt hat, findet sie nach einem
    /// Blattwechsel wieder. Gemerkte Schluessel, die dieser Lauf nicht fuehrt, fallen
    /// still weg.</para>
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_erstBelegt || Vorhandene.Count == 0) return;
        _erstBelegt = true;

        if (_stand.Belegt)
        {
            _sortiert = _stand.Sortiert;
            _gewaehlt = Auswahl(Vorhandene, _stand.Reihen);
            return;
        }

        _gewaehlt = new[] { 0 };
        Merken();
    }

    /// <summary>Die Plaetze zu den gemerkten SCHLUESSELN; Unbekanntes faellt weg.</summary>
    private static IReadOnlyList<int> Auswahl(IReadOnlyList<Ganglinienreihe> reihen,
                                              IReadOnlyList<string> schluessel)
    {
        var liste = new List<int>();
        for (int i = 0; i < reihen.Count; i++)
            if (schluessel.Contains(reihen[i].Schluessel)) liste.Add(i);
        return liste;
    }

    /// <summary>
    /// Schreibt die Schalterstellung ins Sitzungsgedaechtnis — nach JEDER Aenderung.
    /// Der Datenzoom (<c>_bereich</c>) gehoert ausdruecklich NICHT dazu; eine
    /// Bedarfsart und eine Bedarfslinie kennt dieser Reiter nicht.
    /// </summary>
    private void Merken() => _stand.Merken(-1, _sortiert, false, Schluessel());

    private IReadOnlyList<string> Schluessel()
    {
        List<Ganglinienreihe> da = Vorhandene;
        var liste = new List<string>();
        foreach (int i in _gewaehlt) if (i >= 0 && i < da.Count) liste.Add(da[i].Schluessel);
        return liste;
    }

    private byte[]? BildGang =>
        Bild?.Invoke(new Bildauftrag(Bilder.Stromgang, _sortiert, -1, Schluessel(),
                                     0.0, _bereich));

    private Task CsvGewuenscht() => Csv.InvokeAsync(Schluessel());
}
