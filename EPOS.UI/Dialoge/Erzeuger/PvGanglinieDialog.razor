    private void GrafikAnstossen(GanglinienWahl wahl) => _ = GrafikLaden(wahl);

    private async Task GrafikLaden(GanglinienWahl wahl)
    {
        // KT-6: Die Kennzahlen des Satzes über die Fangstelle — wirft der Weg, bleibt die Grafik leer und der
        // Grund steht im Banner.
        Func<GanglinienWahl, Task<GanglinienKennzahlen?>>? kennzahlen = Kennzahlen;
        string grund = "";
        await _grafik.LadenAsync(wahl, kennzahlen is null ? null : async w =>
        {
            (GanglinienKennzahlen? k, string f) = await Katalogladung.SatzAsync(() => kennzahlen(w), w.Bezeichner);
            grund = f;
            return k;
        });
        if (ReferenceEquals(_grafik.Wahl, wahl)) _satzFehler = grund;
        await InvokeAsync(StateHasChanged);
    }

