    // =================================================================================
    // Der Hilfe-Assistent (Welle KI-F4)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private WirtschaftlichkeitSeiteKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die fünf Wahlfelder, die entscheiden, WAS gegen WAS
    /// unter welchem Szenario gerechnet wird, der Freitext der nicht monetären
    /// Wirkungen und die zwei Anzeigewahlen von Block 2 (Stand und Szenario der
    /// Zahlungsreihen).
    /// </summary>
    /// <remarks>
    /// Jede Setzung läuft durch denselben Rückruf wie ein Griff in die Klappliste:
    /// Die Seite holt sich dabei einen NEUEN Stand aus der Hülle und rechnet das
    /// Warnband nach. An diesen Wegen vorbei geschrieben stünden die Kennzahlen von
    /// vorhin neben der neuen Wahl.
    /// </remarks>
    private WirtschaftlichkeitSeiteKiSicht KiSicht()
    {
        return _kiSicht ??= new WirtschaftlichkeitSeiteKiSicht
        {
            SzenarioLesen = () => _stand.SzenarioId,
            SzenarioSetzen = BeiSzenario,
            SzenarioEintraege = () => KiMaskenanmeldung.Eintraege(
                _stand.Szenarien, z => z.Id, z => z.Text),

            SichtLesen = () => _stand.Sicht,
            SichtSetzen = BeiSicht,
            SichtEintraege = () => KiMaskenanmeldung.Eintraege(
                Sichten, z => z.Id, z => z.Text),

            ReferenzLesen = () => _stand.IdReferenz,
            ReferenzSetzen = BeiReferenz,
            StandEintraege = () => KiMaskenanmeldung.Eintraege(
                _stand.Staende, z => z.Id, z => z.Text),

            ALesen = () => _stand.SichtA,
            ASetzen = BeiA,
            AEintraege = () => KiMaskenanmeldung.Eintraege(
                EintraegeA, z => z.Id, z => z.Text),

            BLesen = () => _stand.SichtB,
            BSetzen = BeiB,
            BEintraege = () => KiMaskenanmeldung.Eintraege(
                EintraegeB, z => z.Id, z => z.Text),

            // ETAPPE E17 (V-G11): die Wirkungsliste - Zeilen des Arbeitsstands, geschrieben
            // erst mit „Speichern". Die Zahl legt Zeilen an oder nimmt sie vom Ende; beides
            // oeffnet den Block, damit der Anwender sieht, was der Assistent tut.
            WirkungenLesen = () => _wirkungen
                .Select((z, i) => new WirkungKiZeile(z, i + 1, () => _ = InvokeAsync(StateHasChanged)))
                .ToList(),
            WirkungsanzahlSetzen = KiWirkungsanzahl,

            // Block 2 „Zahlungsreihen": zwei Anzeigewahlen. Gelesen wird die GEZEIGTE
            // Tafel (mit ihrem Rückfall), gesetzt durch dieselben Rückrufe wie die
            // Klapplisten — kein neuer Stand, kein Nachrechnen.
            ZahlungsstandLesen = () => Zahlungsreihe?.IdStand,
            ZahlungsstandSetzen = BeiZahlungsstand,
            ZahlungsstandEintraege = () => KiMaskenanmeldung.Eintraege(
                _stand.Ansicht.Zahlungsstaende, z => z.Id, z => z.Text),

            ZahlungsszenarioLesen = () => Zahlungsreihe?.Szenario,
            ZahlungsszenarioSetzen = BeiZahlungsszenario,
            ZahlungsszenarioEintraege = () => KiMaskenanmeldung.Eintraege(
                _stand.Szenarien, z => z.Id, z => z.Text),

            // Welle #458, Stufe 2: der Abschnitt „Verlauf" - Zeitraum und Haken, ueber
            // die Wege des Abschnitts selbst.
            VerlaufZeitraumLesen = () => _verlauf?.KiZeitraum,
            VerlaufZeitraumSetzen = wert =>
            {
                if (_verlauf is null)
                    throw new InvalidOperationException(Resource.KI_DLG_WIRT_VERLAUF_GESPERRT);
                _verlauf.KiZeitraum = wert;
            },
            VerlaufschalterLesen = () => _verlauf?.KiSchalter
                                         ?? Array.Empty<EPOS.UI.Seiten.Simulation.Anzeigeschalter>()
        };
    }

    /// <summary>
    /// ETAPPE E17: die Zahl der Wirkungen setzen — leere Zeilen „sonstig" anhängen oder
    /// Zeilen vom Ende nehmen. Ohne Schreibweg oder während eines Laufs abgelehnt; der
    /// Block geht auf, damit die Änderung zu sehen ist.
    /// </summary>
    private void KiWirkungsanzahl(int anzahl)
    {
        if (WirkungSpeichern is null || _laeuft)
            throw new InvalidOperationException(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", BewertungTitel));
        if (!_bewertungOffen) BewertungUmschalten();
        while (_wirkungen.Count < anzahl)
            _wirkungen.Add(new ProjektWirkung { Kategorie = NichtMonetaereWirkungen.SONSTIG });
        while (_wirkungen.Count > anzahl)
            _wirkungen.RemoveAt(_wirkungen.Count - 1);
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Der Abschnitt „Verlauf" — der Wirt meldet seine Felder an (Welle #458, Stufe 2).</summary>
    private KapitalwertVerlaufAbschnitt? _verlauf;

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Der Speicherweg schreibt die nicht monetären Wirkungen</b> — derselbe Weg
    /// wie der Knopf daneben. Eine Seite hat kein OK; alles andere auf ihr ist
    /// entweder eine Wahl, die sofort nachrechnet, oder Anzeige.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => WirkungSpeichern is null,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (WirkungSpeichern is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", BewertungTitel));

        WirkungSchreiben();
        return string.IsNullOrEmpty(_fehler)
                   ? KiKern.KiErgebnis.Ok(BewertungTitel, anzahl: 1)
                   : KiKern.KiErgebnis.Abgelehnt(_fehler);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <summary>Liest Liste, Parameterzeile und Ergebnisse neu ein.</summary>
    public void Auffrischen()
    {
        _stand = Laden?.Invoke() ?? new WirtschaftlichkeitStand();

        _gewaehlt.Clear();
        foreach (int id in _stand.GewaehlteVarianten) _gewaehlt.Add(id);
        // KONZEPT § 2.9: Die REFERENZ ist immer dabei — ohne gewählte wie bisher der
        // Stamm. Sie ist die Unterlassensalternative und kann nicht aus dem Vergleich
        // fallen, gegen den sie gehalten wird.
        foreach (VarianteZeile z in _stand.Varianten)
            if (IstReferenz(z) && !_gewaehlt.Contains(z.IdProjekt)) _gewaehlt.Add(z.IdProjekt);

        _status = _stand.Statuszeile ?? "";

        // AUFTRAG #325: Der Freitext folgt dem frisch gelesenen Stand — er hängt am
        // Projekt und nicht an Szenario oder Vergleichswahl. Ein OFFENER Block mit
        // ungeschriebener Eingabe behält sie: Auffrischen läuft auch nach jedem
        // Unterdialog, und der Anwender soll seinen halben Satz nicht dabei verlieren.
        if (!_bewertungOffen) _wirkungen = Kopien(_stand.Wirkungen);

        // AUFTRAG #267: Warnband und Rechenweg folgen dem frisch gelesenen Stand.
        // Das Warnzeichen der Statuszeile ist die EINE Marke, mit der die Hülle
        // „passt nicht mehr zum Simulationsstand" kennzeichnet — dieselbe, die auch
        // die Warnzellen der Tabelle tragen.
        WarnbandAuffrischen();
        _nachrechnen = _status.Contains(ErgebnisMatrix.WARN_PRAEFIX.Trim());

        // Die Fahne kommt aus der Hülle (VarianteZeile.Veraltet) und gilt nur für die
        // GEWÄHLTEN Versionen: Eine abgewählte Variante steht in keiner Zahl dieser
        // Seite, ihr alter Lauf ist hier also kein Anlass.
        _simVeraltet = _stand.Varianten.Any(z => z.Veraltet && _gewaehlt.Contains(z.IdProjekt));

        _verlaufFassung++;              // E6: der Verlauf folgt dem frisch gelesenen Stand
        StateHasChanged();
    }

    /// <summary>
    /// ETAPPE E6: Der Abschnitt „Verlauf" hat gerechnet. Hat er dabei neu simuliert (der
    /// Sammler braucht frische Stundenreihen), passen die gespeicherten Ergebnisse nicht
    /// mehr zum Simulationsstand — die Seite liest neu und sagt es in der Statuszeile.
    /// </summary>
    private void VerlaufGerechnet(VerlaufAnsicht ansicht)
    {
        if (ansicht is null) return;
        if (ansicht.NeuSimuliert) Auffrischen();
        if (!string.IsNullOrEmpty(ansicht.Meldung)) _status = ansicht.Meldung;
    }

    /// <summary>Die Warnungen der Tabelle einsammeln (Auftrag #267).</summary>
    private void WarnbandAuffrischen()
    {
        _warnungen = _stand.Ansicht?.Matrix?.Warnungen() ?? Array.Empty<string>();
    }

    // =====================================================================
    // Auswahl
    // =====================================================================

    private bool Gewaehlt(int id) => _gewaehlt.Contains(id);

    /// <summary>
    /// KONZEPT § 2.9: Ist das die REFERENZ der Gruppe? Ohne gewählte Referenz ist es
    /// der Stamm — wortgleich zum Bestand.
    /// </summary>
    private bool IstReferenz(VarianteZeile z)
        => _stand.IdReferenz > 0 ? z.IdProjekt == _stand.IdReferenz : z.IstStamm;

    private void VarianteUmschalten(VarianteZeile z, bool an)
    {
        // Die REFERENZ kann nicht aus dem Vergleich fallen, gegen den sie gehalten
        // wird (§ 2.9) - bis zur wählbaren Referenz war das immer der Stamm.
        if (IstReferenz(z)) { _status = MeldungStammReferenz; return; }

        if (an) { if (!_gewaehlt.Contains(z.IdProjekt)) _gewaehlt.Add(z.IdProjekt); }
        else _gewaehlt.Remove(z.IdProjekt);

        // W5-B-5 (08.09.2026): Der Haken wirkt SOFORT auf die Tabelle und gilt
        // auch fuer Uebersicht und Kosten - bis hierher wirkte er erst beim
        // naechsten Rechenlauf, und die Spalten folgten den gespeicherten
        // Ergebnissen statt der Wahl.
        VergleichGewaehlt?.Invoke(new List<int>(_gewaehlt));
        if (Anzeigen is not null) _stand.Ansicht = Anzeigen(_stand.SzenarioId);
        WarnbandAuffrischen();          // #267: die Spalten wechseln, die Warnungen mit
        _verlaufFassung++;              // E6: der Verlauf zeichnet die angehakten Stände
    }

    private void BeiSzenario(int? id)
    {
        _stand.SzenarioId = id ?? 0;
        if (Anzeigen is not null) SzenarioTeileUebernehmen(Anzeigen(_stand.SzenarioId));
        WarnbandAuffrischen();          // #267: jedes Szenario hat seine eigenen Gründe
    }

    /// <summary>
    /// ETAPPE E5 (U4, Mockup „Wie sicher ist das?"): <b>Die Klappliste steuert nur die
    /// Tafeln darunter.</b> Aus der Ansicht des gewählten Szenarios werden deshalb allein
    /// die szenarioabhängigen Teile übernommen — die Vergleichstabelle (Gliederung und
    /// Hinweise, sie speist auch das Warnband) und die Szenariozeile. Karten,
    /// Kennzahltafel, Bandbreite, Sensitivität und Empfehlung stehen darüber und bleiben,
    /// wie sie sind; ein Wechsel der Vergleichswahl tauscht dagegen die ganze Ansicht.
    /// </summary>
    private void SzenarioTeileUebernehmen(ErgebnisAnsicht? neu)
    {
        if (neu is null) return;
        _stand.Ansicht.Matrix = neu.Matrix ?? new ErgebnisMatrix();
        _stand.Ansicht.Szenariozeile = neu.Szenariozeile ?? "";
        // ETAPPE E8a (U46): die Gliederung des Kapitalwerts steht unter der Klappliste.
        _stand.Ansicht.Bestandteile = neu.Bestandteile ?? new ErgebnisMatrix();
        _stand.Ansicht.BestandteileTitel = neu.BestandteileTitel ?? "";
        _stand.Ansicht.BestandteileUnterzeile = neu.BestandteileUnterzeile ?? "";
        _stand.Ansicht.Bruecke = neu.Bruecke;               // U41: dasselbe Szenario
    }

    // =====================================================================
    // ETAPPE E5 — Umschalter, Karten und Tafeln der Ergebnisansicht
    // =====================================================================

    /// <summary>Steht der Umschalter auf „ValERI-Bewertung"?</summary>
    private bool IstValeri => _stand.Darstellung == WirtschaftlichkeitStand.DARSTELLUNG_VALERI;

    /// <summary>Die Klassen eines Umschalterknopfs — der gewählte trägt die aktive Form.</summary>
    private string Umschalterklasse(int darstellung)
        => (darstellung == WirtschaftlichkeitStand.DARSTELLUNG_VALERI) == IstValeri
           ? "epos-wirt-umschalter-knopf epos-wirt-umschalter-knopf--aktiv"
           : "epos-wirt-umschalter-knopf";

    /// <summary>
    /// U2: die Darstellung wechseln. Die Wahl steht am Stand (die Seite zeichnet daraus)
    /// und geht an die Hülle, die sie für die Sitzung behält; ein unbekannter Wert gilt
    /// als „Kennzahlen".
    /// </summary>
    private void DarstellungWaehlen(int darstellung)
    {
        int neu = darstellung == WirtschaftlichkeitStand.DARSTELLUNG_VALERI
                ? WirtschaftlichkeitStand.DARSTELLUNG_VALERI
                : WirtschaftlichkeitStand.DARSTELLUNG_KENNZAHLEN;
        if (neu == _stand.Darstellung) return;
        _stand.Darstellung = neu;
        DarstellungGewaehlt?.Invoke(neu);
    }

    /// <summary>U5: die Klassen einer Empfehlungskarte — die Stufe färbt über die Tokens
    /// des Stilblatts (<c>--epos-wirt-empf-*</c>).</summary>
    private static string Kartenklasse(EmpfehlungKarte karte)
        => "epos-wirt-karte epos-wirt-karte--" + Stufenform(karte.Stufe);

    /// <summary>U5: die Klassen der Stufenmarke einer Karte.</summary>
    private static string Stufenklasse(EmpfehlungKarte karte)
        => "epos-wirt-stufe epos-wirt-stufe--" + Stufenform(karte.Stufe);

    private static string Stufenform(string? stufe) => stufe switch
    {
        EmpfehlungKarte.STUFE_JA => "ja",
        EmpfehlungKarte.STUFE_BEDINGT => "bedingt",
        EmpfehlungKarte.STUFE_NEIN => "nein",
        _ => "offen"
    };

    /// <summary>
    /// V‑A (Befund A2): die Zellwarnungen einer Tafel als Zeilen unter ihr — „⚠ ‹Spalte›
    /// — ‹Kennzahl›: ‹Warnung›", jede einmal. Die Zelle selbst trägt nur das Zeichen.
    /// </summary>
    private static IReadOnlyList<string> Zellwarnungstexte(ErgebnisMatrix tafel)
    {
        var liste = new List<string>();
        foreach (MatrixZeile z in tafel.Zeilen)
            for (int i = 0; i < z.Zellen.Count; i++)
            {
                string warnung = z.Zellwarnung(i);
                if (warnung.Length == 0) continue;
                string spalte = i + 1 < tafel.Spalten.Count ? tafel.Spalten[i + 1] : "";
                string text = "⚠ " + (spalte.Length > 0 ? spalte + " — " : "") + z.Titel + ": " + warnung;
                if (!liste.Contains(text)) liste.Add(text);
            }
        return liste;
    }

    /// <summary>
    /// U5: „Lohnt es sich?" — die Empfehlungskarten je Version (Stufe, Stufentext,
    /// Kapitalwertdifferenz), der Vorschlagssatz aus denselben Urteilen und die
    /// Einstufungsregel. Ohne Karten weder Karten noch Regel.
    /// </summary>
    private RenderFragment Empfehlungsteil => @<div class="epos-wirt-empfehlung">
        @if (_stand.Ansicht.Empfehlungen.Count > 0)
        {
            <div class="epos-wirt-karten">
                @foreach (EmpfehlungKarte karte in _stand.Ansicht.Empfehlungen)
                {
                    <div class="@Kartenklasse(karte)">
                        <span class="epos-wirt-karte-name">@karte.Name</span>
                        <span class="epos-wirt-karte-wert">@karte.Differenz</span>
                        <span class="epos-wirt-karte-unter">@Texte.KarteUnter</span>
                        <span class="@Stufenklasse(karte)">@karte.StufeText</span>
                    </div>
                }
            </div>
        }
        @if (!string.IsNullOrEmpty(_stand.Ansicht.Empfehlungszeile))
        {
            <div class="epos-wirt-vorschlag">
                <Herleitungszeile Text="@_stand.Ansicht.Empfehlungszeile" />
            </div>
        }
        @if (_stand.Ansicht.Empfehlungen.Count > 0)
        {
            <Herleitungszeile Text="@Texte.EmpfehlungRegel" />
        }
    </div>;

    /// <summary>
    /// U2 und V‑A: die Kennzahltafel im Szenario Erwartet — Label „nachrichtlich" am
    /// Titel, das Warnzeichen in der Zelle, „— ‹Grund›" statt einer Null (Q16, die Hülle
    /// liefert den Text), und die Warnungen als Zeilen darunter.
    /// </summary>
    private RenderFragment Kennzahlteil => @<div class="epos-wirt-kennzahlen">
        @if (_stand.Ansicht.Kennzahltafel.Zeilen.Count > 0)
        {
            ErgebnisMatrix tafel = _stand.Ansicht.Kennzahltafel;
            @Untertitel(Texte.KennzahltafelTitel, "tabelle.wirtschaft.kennzahlen", Vorlagenfeldstufe.Aehnlich,
                        Resource.VF_ORT_KENNZAHLTAFEL, "stand.wirtschaft.<zeile>")
            <div class="epos-raster-huelle">
                <table class="epos-raster epos-matrix epos-wirt-kennzahltafel">
                    <thead>
                        <tr>
                            @foreach (string kopf in tafel.Spalten)
                            {
                                <th scope="col">@kopf</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MatrixZeile z in tafel.Zeilen)
                        {
                            <tr>
                                <th scope="row" class="epos-matrix-titel">
                                    @z.Titel
                                    @if (!string.IsNullOrEmpty(z.Kennzeichen))
                                    {
                                        <span class="epos-wirt-kennzeichen">@z.Kennzeichen</span>
                                    }
                                </th>
                                @for (int i = 0; i < z.Zellen.Count; i++)
                                {
                                    string warnung = z.Zellwarnung(i);
                                    <td class="epos-matrix-zelle">
                                        @z.Zellen[i]
                                        @if (warnung.Length > 0)
                                        {
                                            <span class="epos-wirt-zellwarnung" title="@warnung"
                                                  aria-label="@warnung">⚠</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @foreach (string warnzeile in Zellwarnungstexte(tafel))
            {
                <Herleitungszeile Text="@warnzeile" />
            }
        }
    </div>;

    /// <summary>
    /// U4: die Bandbreite NEBENEINANDER — je Version Ungünstig · Erwartet · Günstig, die
    /// Spanne und die Einstufung, als erste Zeile die Referenz; darunter der Fußtext. Sie
    /// folgt der Vergleichswahl, nicht der Klappliste.
    /// </summary>
    private RenderFragment Bandbreitenteil => @<div class="epos-wirt-bandbreite-teil">
        @if (_stand.Ansicht.Bandbreite.Zeilen.Count > 0)
        {
            @Untertitel(Texte.BandbreiteTitel, "tabelle.wirtschaft.szenarien", Vorlagenfeldstufe.Entspricht, "",
                        "stand.bandbreite.unguenstig · .erwartet · .guenstig · .spanne · .amortisation · .einstufung")
            @Tafel(_stand.Ansicht.Bandbreite, "epos-raster epos-wirt-tafel epos-wirt-bandbreite", true, 4)
            @if (!string.IsNullOrEmpty(_stand.Ansicht.Bandbreitenfuss))
            {
                <Herleitungszeile Text="@_stand.Ansicht.Bandbreitenfuss" />
            }
        }
    </div>;

    /// <summary>
    /// ETAPPE E6 (Nachtrag E5b, Anwenderentscheid 22.09.2026 zu Frage (4), Mockup
    /// <c>valeri-f2</c>): das SPANNENBILD unter der Bandbreitentafel — dieselben Zahlen als
    /// Balken je Version, der Erwartungsfall als Punkt, die Referenz als Nulllinie. Es ist
    /// ein reines Pixelbild ohne Zoom; die Legende schaltet nichts. Ohne Bandbreite steht
    /// kein Bild.
    /// </summary>
    private RenderFragment Spannenteil => @<div class="epos-wirt-spanne-teil">
        @if (_stand.Ansicht.Spannenbild is not null)
        {
            <DiagrammSvg Modell="@_stand.Ansicht.Spannenbild" Kennung="kapitalwert-spanne"
                         Bezeichnung="@Texte.SpanneBild" OhneZoom="true" LegendeSchaltbar="false"
                         Vorlagenfeld="bild.wirtschaft.spanne" />
        }
    </div>;

    /// <summary>
    /// V‑A (V‑G6): die Sensitivitätstafel mit der Steigungsspalte (Szenario Erwartet) —
    /// bis E5 nur im Bericht.
    /// </summary>
    private RenderFragment Sensitivitaetsteil => @<div class="epos-wirt-sensitivitaet-teil">
        @if (_stand.Ansicht.Sensitivitaet.Zeilen.Count > 0)
        {
            @Untertitel(Texte.SensitivitaetTitel, "stand.tabelle.sensitivitaet", Vorlagenfeldstufe.Aehnlich,
                        Resource.VF_ORT_SENSITIVITAET)
            @Tafel(_stand.Ansicht.Sensitivitaet, "epos-raster epos-wirt-tafel epos-wirt-sensitivitaet", false, 0)
        }
    </div>;

    /// <summary>
    /// ETAPPE E8a (U46, Mockup „Woraus entsteht die Zahl?"): die <b>Gliederung des
    /// Kapitalwerts</b> — sechs Bestandteile und der Nettobarwert, je Stand der Barwert mit
    /// der Nominalsumme darunter, als letzte Spalte die Differenz Leitversion − Referenz. Die
    /// Zahlen stammen aus den Zahlungsbildern des Laufs dieser Sitzung; ohne sie steht eine
    /// benannte Zeile, und die Zeilentafel darunter bleibt, wie sie ist.
    /// </summary>
    private RenderFragment Bestandteilteil => @<div class="epos-wirt-bestandteile-teil">
        @if (_stand.Ansicht.Bestandteile.Zeilen.Count > 0)
        {
            ErgebnisMatrix m = _stand.Ansicht.Bestandteile;
            <p class="epos-untergruppe">@_stand.Ansicht.BestandteileTitel</p>
            @if (!string.IsNullOrEmpty(_stand.Ansicht.BestandteileUnterzeile))
            {
                <Herleitungszeile Text="@_stand.Ansicht.BestandteileUnterzeile" />
            }
            <div class="epos-raster-huelle">
                <table class="epos-raster epos-matrix epos-wirt-bestandteile">
                    <thead>
                        <tr>
                            @foreach (string kopf in m.Spalten)
                            {
                                <th scope="col">@kopf</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (MatrixZeile z in m.Zeilen)
                        {
                            <tr class="@Zeilenklasse(z, false)">
                                <th scope="row" class="epos-matrix-titel">
                                    @z.Titel
                                    @if (!string.IsNullOrEmpty(z.Kennzeichen))
                                    {
                                        <span class="epos-wirt-kennzeichen">@z.Kennzeichen</span>
                                    }
                                </th>
                                @for (int i = 0; i < z.Zellen.Count; i++)
                                {
                                    string unter = z.Unterwert(i);
                                    <td class="epos-matrix-zelle">
                                        @z.Zellen[i]
                                        @if (unter.Length > 0)
                                        {
                                            <span class="epos-wirt-nominal">@unter</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <Herleitungszeile Text="@Texte.GliederungNichtGerechnet" />
        }
        @* ETAPPE E8a (U41): das BRUECKENBILD unter der Gliederung - dieselben Schritte wie
           die Differenzspalte, die Ergebnissaeule ist die Kapitalwertdifferenz. Ein reines
           Pixelbild wie das Spannenbild: ohne Zoom, die Legende schaltet nichts. *@
        @if (_stand.Ansicht.Bruecke is not null)
        {
            <div class="epos-wirt-bruecke-teil">
                <DiagrammSvg Modell="@_stand.Ansicht.Bruecke" Kennung="kapitalwert-bruecke"
                             Bezeichnung="@Texte.BrueckeBild" OhneZoom="true" LegendeSchaltbar="false"
                             Vorlagenfeld="bild.wirtschaft.bruecke" />
            </div>
        }
        @if (!string.IsNullOrEmpty(_stand.Ansicht.Zahlungshinweis))
        {
            <Herleitungszeile Text="@_stand.Ansicht.Zahlungshinweis" />
        }
    </div>;

    /// <summary>
    /// ETAPPE E8a (U47, Mockup „Was ist angenommen?"): die Tafel <b>„Was daraus im Lauf
    /// wird"</b> — je Szenario die Wirkung auf die Leitversion, aus den Szenarioläufen der
    /// Bandbreite. Ohne Jahresreihen steht sie nicht da (die Gliederung sagt, warum).
    /// </summary>
    private RenderFragment Laufwirkungsteil => @<div class="epos-wirt-laufwirkung-teil">
        @if (_stand.Ansicht.Laufwirkung.Zeilen.Count > 0)
        {
            <p class="epos-untergruppe">@Texte.LaufwirkungTitel</p>
            @Tafel(_stand.Ansicht.Laufwirkung, "epos-raster epos-wirt-tafel epos-wirt-laufwirkung", false)
        }
    </div>;

    /// <summary>
    /// ETAPPE E8a (ValERI-Block 2 „Zahlungsreihen", DIN EN 17463 6.1 bis 6.4): je Stand und
    /// Szenario die Jahresreihen der sechs Bestandteile, Netto und Barwert, darunter die
    /// Summe nominal und die Barwerte — dieselben Zahlen wie die Gliederung unter „Woraus
    /// entsteht die Zahl?". Zwei Klapplisten wählen Stand und Szenario (Vorgabe: die
    /// Leitversion im Erwartungsfall); sie wählen nur, was die Hülle schon geliefert hat.
    /// Unter der Tafel steht das Zahlungsstrombild (U42) desselben Standes im selben
    /// Szenario. Ohne Jahresreihen (kein Lauf in dieser Sitzung) steht EINE benannte Zeile.
    /// </summary>
    private RenderFragment Zahlungsreihenteil => @<div class="epos-wirt-zahlungsreihen-teil">
        @if (Zahlungsreihe is ZahlungsreihenTafel tafel)
        {
            <div class="epos-seite-zeile epos-wirt-zahlungsreihen-wahl">
                <Auswahlfeld Bezeichnung="@Texte.ZrStand" Eintraege="@_stand.Ansicht.Zahlungsstaende"
                             Auswahl="@tafel.IdStand" AuswahlChanged="BeiZahlungsstand" />
                <Auswahlfeld Bezeichnung="@Texte.ZrSzenario" Eintraege="@_stand.Szenarien"
                             Auswahl="@tafel.Szenario" AuswahlChanged="BeiZahlungsszenario" />
                <Vorlagenfeldknopf Vorlagenfeld="stand.tabelle.mehrjahres" Stufe="Vorlagenfeldstufe.Aehnlich"
                                   StufenHinweis="@Resource.VF_ORT_ZAHLUNGSREIHEN" />
            </div>
            @Tafel(tafel.Tafel, "epos-raster epos-wirt-tafel epos-wirt-zahlungsreihen", false)
            @if (!string.IsNullOrEmpty(tafel.Unterzeile))
            {
                <Herleitungszeile Text="@tafel.Unterzeile" />
            }
            @* ETAPPE E8a (U42, E8a-Q1 Lesart a): das ZAHLUNGSSTROMBILD unter der Jahrestafel -
               derselbe Stand im selben Szenario, die Spalten der Mehrjahrestafel als gestapelte
               Jahresbalken, Ausgaben nach unten, Ersatzjahre markiert. Ein reines Pixelbild:
               ohne Zoom, die Legende schaltet nichts; die Kennung traegt Stand und Szenario. *@
            @if (tafel.Bild is not null)
            {
                <div class="epos-wirt-zahlungsstrom-teil">
                    <DiagrammSvg Modell="@tafel.Bild" Kennung="@($"zahlungsstrom-{tafel.IdStand}-{tafel.Szenario}")"
                                 Bezeichnung="@Texte.ZahlungsstromBild" OhneZoom="true" LegendeSchaltbar="false"
                                 Vorlagenfeld="stand.bild.zahlungsstrom" VorlagenfeldStufe="Vorlagenfeldstufe.Aehnlich"
                                 VorlagenfeldHinweis="@Resource.VF_ORT_ZAHLUNGSREIHEN" />
                </div>
            }
            @if (!string.IsNullOrEmpty(_stand.Ansicht.Zahlungshinweis))
            {
                <Herleitungszeile Text="@_stand.Ansicht.Zahlungshinweis" />
            }
        }
        else
        {
            <div class="epos-wirt-block-luecke">
                <Herleitungszeile Text="@(string.IsNullOrEmpty(_stand.Ansicht.Zahlungshinweis) ? Texte.Block2Hinweis : _stand.Ansicht.Zahlungshinweis)" />
            </div>
        }
    </div>;

    /// <summary>
    /// U44/U43/U48: der Fuß des Bewertungsblocks als EINE Reihe (E8a‑Q4) — links die
    /// leise Fußzeile (U48, nur in „Was ist angenommen?"), rechts „Anhang-E-Checkliste…"
    /// und „Bericht erzeugen". Kein Knopf ist Primärknopf — die Seite trägt genau einen,
    /// „Berechnen" in der Fußleiste (Q8).
    /// </summary>
    private RenderFragment Fussreihe(string fusszeile) => @<div class="epos-wirt-abschnitt-fuss">
        @if (!string.IsNullOrEmpty(fusszeile))
        {
            <p class="epos-status epos-wirt-szenariofuss">@fusszeile</p>
        }
        <AnhangEChecklisteKnopf Stand="@_stand" Gesperrt="@_laeuft" StellenLaden="@AnhangEStellenLaden" />
        @if (BerichtErzeugen is not null)
        {
            <button type="button" class="epos-knopf epos-wirt-berichtknopf" disabled="@_laeuft"
                    @onclick="BerichtFragen">@Texte.BerichtKnopf</button>
        }
    </div>;

    /// <summary>
    /// BV-E6 (Konzept Berichtsvorlagen 9.4): der Untertitel einer Tafel mit der EINEN Marke
    /// am Tabellenkopf — keine Zeilenmarken; <paramref name="zusatz"/> nennt Zeilen- und
    /// Spaltenschlüssel für die Aufklappung.
    /// </summary>
    private static RenderFragment Untertitel(string titel, string vorlagenfeld, Vorlagenfeldstufe stufe,
                                             string hinweis, string zusatz = "") => @<div class="epos-vorlagenfeld-zeile">
        <p class="epos-untergruppe">@titel</p>
        <Vorlagenfeldknopf Vorlagenfeld="@vorlagenfeld" Stufe="@stufe" StufenHinweis="@hinweis" Zusatz="@zusatz" />
    </div>;

    /// <summary>
    /// Eine Tafel aus einer Matrix: Spaltenköpfe (falls es welche gibt), je Zeile der
    /// Titel als Zeilenkopf und die Zellen — Zahlen rechts, die genannten Textspalten
    /// links. Die erste Zeile kann die Referenzzeile sein (Bandbreite).
    /// </summary>
    private RenderFragment Tafel(ErgebnisMatrix m, string klasse, bool ersteIstReferenz,
                                 params int[] textspalten) => @<div class="epos-raster-huelle">
        <table class="@klasse">
            @if (m.Spalten.Count > 0)
            {
                <thead>
                    <tr>
                        @foreach (string kopf in m.Spalten)
                        {
                            <th scope="col">@kopf</th>
                        }
                    </tr>
                </thead>
            }
            <tbody>
                @for (int r = 0; r < m.Zeilen.Count; r++)
                {
                    MatrixZeile z = m.Zeilen[r];
                    <tr class="@Zeilenklasse(z, ersteIstReferenz && r == 0)">
                        <th scope="row" class="epos-matrix-titel">@z.Titel</th>
                        @for (int i = 0; i < z.Zellen.Count; i++)
                        {
                            <td class="@(Array.IndexOf(textspalten, i) >= 0 ? "epos-wirt-textzelle" : "epos-matrix-zelle")">@z.Zellen[i]</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>;

    /// <summary>
    /// Die Vergleichstabelle (Gliederung und Hinweise) — dieselbe Bauform wie bis E5:
    /// eine Matrix mit Laufzeitspalten, keine <c>Raster</c>-Komponente.
    /// </summary>
    private RenderFragment Matrixtafel(ErgebnisMatrix m, string klasse) => @<div class="epos-raster-huelle">
        <table class="@klasse">
            <thead>
                <tr>
                    @foreach (string kopf in m.Spalten)
                    {
                        <th scope="col">@kopf</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (MatrixZeile z in m.Zeilen)
                {
                    <tr>
                        <th scope="row" class="epos-matrix-titel">@z.Titel</th>
                        @foreach (string zelle in z.Zellen)
                        {
                            <td class="epos-matrix-zelle">@zelle</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>;

    /// <summary>Die Klasse einer Tafelzeile: die Referenzzeile der Bandbreite hinterlegt, eine
    /// Summenzeile (ETAPPE E8a) abgesetzt; sonst keine.</summary>
    private static string? Zeilenklasse(MatrixZeile z, bool referenz)
        => referenz ? "epos-wirt-referenzzeile" : z.IstSumme ? "epos-wirt-summenzeile" : null;

    // =====================================================================
    // ETAPPE E8a — Block 2 „Zahlungsreihen": die Wahl von Stand und Szenario
    // =====================================================================

    /// <summary>Der in Block 2 gewählte Stand; <c>null</c> = die Leitversion.</summary>
    private int? _zahlungsstand;

    /// <summary>Das in Block 2 gewählte Szenario; <c>null</c> = Erwartet (Nummer 0).</summary>
    private int? _zahlungsszenario;

    /// <summary>
    /// Die gezeigte Tafel der Zahlungsreihen: der gewählte Stand (sonst die Leitversion,
    /// sonst der erste) im gewählten Szenario (sonst Erwartet, sonst das erste, das der
    /// Stand trägt). <c>null</c> = keine Jahresreihen. Eine Wahl, die die Ansicht nicht mehr
    /// trägt (Vergleichswahl gewechselt), fällt still auf die Vorgabe zurück — sie ist eine
    /// Blickrichtung, kein Zustand.
    /// </summary>
    private ZahlungsreihenTafel? Zahlungsreihe
    {
        get
        {
            IReadOnlyList<ZahlungsreihenTafel> tafeln = _stand.Ansicht.Zahlungsreihen;
            if (tafeln is null || tafeln.Count == 0) return null;

            int stand = tafeln[0].IdStand;
            if (_zahlungsstand is int s && tafeln.Any(t => t.IdStand == s)) stand = s;
            else if (tafeln.Any(t => t.IdStand == _stand.Ansicht.Leitversion)) stand = _stand.Ansicht.Leitversion;

            int szenario = _zahlungsszenario ?? 0;
            return tafeln.FirstOrDefault(t => t.IdStand == stand && t.Szenario == szenario)
                ?? tafeln.FirstOrDefault(t => t.IdStand == stand && t.Szenario == 0)
                ?? tafeln.First(t => t.IdStand == stand);
        }
    }

    /// <summary>Die gezeigte Tafel der Zahlungsreihen (Prüfhilfe).</summary>
    public ZahlungsreihenTafel? GezeigteZahlungsreihe => Zahlungsreihe;

    private void BeiZahlungsstand(int? id) => _zahlungsstand = id;

    private void BeiZahlungsszenario(int? id) => _zahlungsszenario = id;

    // =====================================================================
    // ETAPPE E5 (U44) — „Bericht erzeugen"
    // =====================================================================

    /// <summary>
    /// Die Rückfrage vor dem Lauf — derselbe Wortlaut wie auf der Berichtsseite: Jeder
    /// Berichtslauf simuliert alle gewählten Versionen neu.
    /// </summary>
    private void BerichtFragen()
    {
        if (_laeuft || BerichtErzeugen is null) return;
        _berichtsfrageText = string.Format(Texte.BerichtFrageStart, _gewaehlt.Count);
        _berichtsfrage = Berichtsfrage.Start;
    }

    private async Task BerichtBeantwortet(bool? antwort)
    {
        Berichtsfrage war = _berichtsfrage;
        _berichtsfrage = Berichtsfrage.Keine;
        if (antwort != true) return;

        if (war == Berichtsfrage.Start)
            await BerichtLaufen();
        else if (war == Berichtsfrage.Oeffnen && DateiOeffnen is not null && _berichtDatei.Length > 0)
            await DateiOeffnen(_berichtDatei);
    }

    /// <summary>
    /// Der Lauf über den bestehenden Berichtsweg: die gewählten Versionen ohne Stamm,
    /// Fortschritt in der Statuszeile, danach „öffnen?". Der Berichtslauf simuliert und
    /// rechnet neu und bucht den Gruppenlauf — die Seite liest danach neu.
    /// </summary>
    private async Task BerichtLaufen()
    {
        if (_laeuft || BerichtErzeugen is null) return;

        var varianten = new List<int>();
        foreach (VarianteZeile z in _stand.Varianten)
            if (!z.IstStamm && _gewaehlt.Contains(z.IdProjekt)) varianten.Add(z.IdProjekt);

        _laeuft = true;
        _aktuell = 0;
        _gesamt = 1;
        _fehler = "";
        StateHasChanged();

        try
        {
            LaufErgebnis erg = await BerichtErzeugen(varianten, Melden);

            if (erg.Abgebrochen) { _status = StatusAbgebrochen; return; }

            if (erg.Erfolg) Auffrischen();
            _fehler = erg.Fehler ?? "";
            if (!string.IsNullOrEmpty(erg.Statuszeile)) _status = erg.Statuszeile;

            if (erg.Erfolg && !string.IsNullOrEmpty(erg.Frage) && DateiOeffnen is not null &&
                !string.IsNullOrEmpty(erg.Datei))
            {
                _berichtDatei = erg.Datei;
                _berichtsfrageText = erg.Frage;
                _berichtsfrage = Berichtsfrage.Oeffnen;
            }
        }
        finally
        {
            _laeuft = false;
            StateHasChanged();
        }
    }

    // =====================================================================
    // Referenz und Vergleichssicht (§ 2.9 / § 2.15)
    // =====================================================================

    /// <summary>Die zwei Sichten als Optionsliste (VG‑Q2: „gegen die Referenz").</summary>
    private IReadOnlyList<(int Id, string Text)> Sichten
        => new[] { (0, SichtAlleText), (1, SichtPaarText) };

    /// <summary>
    /// Sicht 2 ist WEICH gesperrt, solange die Gruppe nur einen Stand führt: Der Grund
    /// steht am Bedienelement, statt dass die Option stumm nicht reagiert.
    /// </summary>
    private IReadOnlyDictionary<int, string>? SichtGesperrt
        => _stand.PaarMoeglich ? null
         : new Dictionary<int, string> { [1] = SichtGesperrtText };

    /// <summary>Steht die Paarwahl offen? Nur in Sicht 2 — sonst sind die Listen gesperrt.</summary>
    private bool PaarOffen => _stand.Sicht == 1 && _stand.PaarMoeglich;

    /// <summary>
    /// Die Klappliste A führt die angehakten Stände OHNE B — und B ohne A. So ist
    /// A ≠ B ohne Meldung gesichert.
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> EintraegeA => Staende(_stand.SichtB);

    /// <inheritdoc cref="EintraegeA"/>
    private IReadOnlyList<(int Id, string Text)> EintraegeB => Staende(_stand.SichtA);

    private IReadOnlyList<(int Id, string Text)> Staende(int ohne)
    {
        var l = new List<(int, string)>();
        foreach ((int id, string text) in _stand.Staende)
            if (id != ohne && _gewaehlt.Contains(id)) l.Add((id, text));
        return l;
    }

    /// <summary>Übernimmt einen neuen Stand aus einem Rückruf; <c>null</c> = nichts ändern.</summary>
    private void Uebernehmen(WirtschaftlichkeitStand? neu)
    {
        if (neu is null) return;
        _stand = neu;
        _gewaehlt.Clear();
        foreach (int id in _stand.GewaehlteVarianten) _gewaehlt.Add(id);
        _status = _stand.Statuszeile ?? "";
        WarnbandAuffrischen();
        _verlaufFassung++;              // E6: Referenz oder Sicht gewechselt - der Verlauf rechnet nach
        StateHasChanged();
    }

    private void BeiReferenz(int? id)
    {
        if (_laeuft || ReferenzGewaehlt is null || id is null) return;
        Uebernehmen(ReferenzGewaehlt(id.Value));
    }

    private void BeiSicht(int? id)
    {
        if (_laeuft || SichtGewaehlt is null || id is null) return;
        Uebernehmen(SichtGewaehlt(id.Value));
    }

    /// <summary>Der Versuch, die gesperrte Sicht 2 zu wählen — die Seite nennt den Grund.</summary>
    private void BeiSichtVerweigert(int id) => _status = SichtGesperrtText;

    private void BeiA(int? id)
    {
        if (_laeuft || PaarGewaehlt is null || id is null) return;
        Uebernehmen(PaarGewaehlt(id.Value, _stand.SichtB));
    }

    private void BeiB(int? id)
    {
        if (_laeuft || PaarGewaehlt is null || id is null) return;
        Uebernehmen(PaarGewaehlt(_stand.SichtA, id.Value));
    }

    private void BeiTausch()
    {
        if (_laeuft || PaarTauschen is null || !PaarOffen) return;
        Uebernehmen(PaarTauschen());
    }

    // =====================================================================
    // Bewertung nach DIN EN 17463 (AUFTRAG #325)
    // =====================================================================

    /// <summary>
    /// Auf- und zuklappen. Beim ÖFFNEN wird der geladene Stand geholt — wer den
    /// Block aufmacht, soll sehen, was gespeichert ist, und nicht einen Rest von
    /// vorhin. Beim Schließen bleibt nichts liegen: Was nicht geschrieben wurde,
    /// ist nicht geschrieben, und der nächste Auffrischlauf setzt den Stand zurück.
    /// </summary>
    private void BewertungUmschalten()
    {
        _bewertungOffen = !_bewertungOffen;
        if (_bewertungOffen) _wirkungen = Kopien(_stand.Wirkungen);
        _wirkungGespeichert = false;
    }

    /// <summary>Eine Eingabe in der Wirkungsliste: Speichern geht wieder, der Vermerk fällt weg.</summary>
    private void WirkungGeaendert()
    {
        _wirkungGespeichert = false;
        _wirkungVermerk?.Leeren();
    }

    /// <summary>
    /// Schreibt die Wirkungsliste fort (ETAPPE E17; bis dahin den Freitext). Danach
    /// frischt die Seite auf, damit der Ausweis im Kopf
    /// des Blocks dem folgt, was gerade geschrieben wurde — sichtbar wird er
    /// allerdings erst beim Zuklappen, denn offen trägt der Kopf nur seinen Titel.
    ///
    /// <para>Scheitert das Schreiben, SAGT die Seite es und behält die Eingabe —
    /// ein stiller Fehlschlag wäre die Behauptung, der Text stünde in der
    /// Datenbank.</para>
    /// </summary>
    private void WirkungSchreiben()
    {
        if (_laeuft || WirkungSpeichern is null) return;

        // ETAPPE E17: geschrieben wird die Liste in der Reihenfolge der Seite; leere
        // Zeilen lässt der Kern fallen, ein Prüfbefund kommt als Speicherfehlerzeile zurück.
        List<ProjektWirkung> liste = _wirkungen;
        if (!WirkungSpeichern(liste))
        {
            _fehler = BewertungFehlerText;
            // ETAPPE E13 (E7c3‑Q6 a): der Grund des Kerns, einmal, in der Statuszeile.
            string grund = Speicherfehlerzeile?.Invoke() ?? "";
            if (!string.IsNullOrEmpty(grund)) _status = grund;
            _wirkungVermerk?.Fehler(BewertungFehlerText);
            return;
        }

        _fehler = "";
        List<ProjektWirkung> gespeichert = liste.Where(z => !NichtMonetaereWirkungen.IstLeer(z))
                                                .Select(z => z.Kopie()).ToList();
        _stand.Wirkungen = gespeichert;
        Auffrischen();
        _wirkungen = Kopien(gespeichert);
        _status = BewertungGespeichertText;
        _wirkungGespeichert = true;
        _wirkungVermerk?.Gespeichert();
    }

    // =====================================================================
    // Unterdialoge
    // =====================================================================

    private void Oeffne(Unterdialog art)
    {
        if (_laeuft || Gaben is null) return;

        IReadOnlyDictionary<string, object>? gaben = Gaben(art);
        if (gaben is null)
        {
            // Die Huelle konnte den Satz nicht bauen (kein Stammprojekt, keine
            // Anlagen) - dann bleibt der Bereich zu. Denselben Ausgang hatte
            // der Vorlaeufer, wenn seine Huelle false lieferte.
            _status = Nachlauf?.Invoke(art, false) ?? "";
            return;
        }

        _gaben = gaben;
        _offen = art;
    }

    /// <summary>
    /// Der Titel der Tarif-Überlagerung — je nachdem, auf welchem Weg sie
    /// aufgegangen ist (E3/7).
    /// </summary>
    private string TarifTitel => _offen == Unterdialog.TarifPv ? TarifPvText : TarifBhkwText;

    /// <summary>
    /// E3/7: Der BHKW-Dialog meldet seinen Sprung im Ergebnis. Bis hierher
    /// verwarf dieser Wirt ihn, und der Knopf tat nichts (der alte Weg, ein
    /// zweites WinForms-Fenster, war mit dem Umzug der Hülle gefallen). Jetzt
    /// schließt der Dialog wie bisher — er hat im OK-Weg geschrieben — und die
    /// Tarifstruktur geht in der Sicht BHKW als Überlagerung auf. Den zweiten
    /// Sprung „Strombezug…" gibt es mit Q11 nicht mehr.
    /// </summary>
    private void BhkwFertig(BhkwWirtschaftlichkeitErgebnis? ergebnis)
    {
        Fertig(ergebnis is { Gespeichert: true });

        if (ergebnis is null || ergebnis.Sprung == BhkwSprung.Keiner) return;

        Oeffne(Unterdialog.TarifBhkw);
    }

    /// <summary>
    /// Dasselbe für den PV-Dialog: Sein Sprungknopf nimmt seit #405 den OK-Weg
    /// (prüfen, schreiben, springen); hier geht danach die Tarifstruktur in der
    /// Sicht Photovoltaik auf (E3/7).
    /// </summary>
    private void PvFertig(PvVerguetungErgebnis? ergebnis)
    {
        Fertig(ergebnis is not null);

        if (ergebnis is null || ergebnis.Sprung == PvSprung.Keiner) return;

        Oeffne(Unterdialog.TarifPv);
    }

    private void Fertig(bool gespeichert)
    {
        Unterdialog war = _offen;
        _offen = Unterdialog.Keins;
        _gaben = null;

        string meldung = Nachlauf?.Invoke(war, gespeichert) ?? "";

        // Der Vorlaeufer frischte nach jedem Unterdialog die Parameterzeile
        // auf (ZeigeParameterzeile). Auffrischen liest Liste, Parameterzeile und
        // Ergebnisse in einem.
        Auffrischen();
        if (!string.IsNullOrEmpty(meldung)) _status = meldung;

        // AUFTRAG #267: „… gespeichert — bitte neu berechnen." war bis hierher eine
        // Aufforderung OHNE Weg: Der Knopf „Berechnen" liegt unter der langen
        // Vergleichstabelle und war auf dem Bildschirm des Anwenders nicht zu sehen.
        // Jetzt stellt dasselbe Speichern das Warnband mit dem Rechenknopf nach oben.
        if (gespeichert) _nachrechnen = true;
    }

    // =====================================================================
    // Berechnen
    // =====================================================================

    private async Task BerechnenLaufen()
    {
        if (_laeuft || Berechnen is null) return;

        var varianten = new List<int>();
        foreach (VarianteZeile z in _stand.Varianten)
            if (!z.IstStamm && _gewaehlt.Contains(z.IdProjekt)) varianten.Add(z.IdProjekt);

        _laeuft = true;
        _aktuell = 0;
        _gesamt = 1;
        _fehler = "";
        StateHasChanged();

        try
        {
            LaufErgebnis erg = await Berechnen(varianten, Melden);

            if (erg.Abgebrochen) { _status = StatusAbgebrochen; return; }

            Auffrischen();                       // Liste, Parameterzeile, Ergebnisse
            _fehler = erg.Fehler ?? "";
            if (!string.IsNullOrEmpty(erg.Statuszeile)) _status = erg.Statuszeile;
        }
        finally
        {
            _laeuft = false;
            StateHasChanged();
        }
    }

    private void Melden(Laufschritt s)
    {
        _ = InvokeAsync(() =>
        {
            if (s.Gesamt > 0) { _gesamt = s.Gesamt; _aktuell = Math.Min(s.Aktuell, s.Gesamt); }
            _status = s.Gesamt > 0 ? $"({s.Aktuell}/{s.Gesamt}) {s.Text}" : s.Text;
            StateHasChanged();
        });
    }

    private void LaufAbbrechen() => Abbrechen?.Invoke();
}
