    /// <summary>
    /// Der Exportdialog ist zu: nach dem Schreiben steht seine Rückmeldung (mit Pfad) im Banner;
    /// <c>null</c> bei Abbrechen, ✕ und Esc — dann ist nichts geschrieben.
    /// </summary>
    private void ExportFertig(GebaeudeExportErgebnis? ergebnis)
    {
        _exportGaben = null;
        if (ergebnis is { Gespeichert: true }) Melden(ergebnis.Text, WarnStufe.Erfolg);
    }

    /// <summary>
    /// Das Ergebnis der Wohnflächenangabe geht in die MARKIERTE Zeile zurück
    /// (<c>btn_Aendern_Click</c>:445-469, dort über <c>ID_Z</c>).
    /// </summary>
    private void WohnflaecheFertig(GebaeudeWohnflaecheErgebnis? ergebnis)
    {
        _wohnflaecheGaben = null;
        if (ergebnis is null || _gewaehlt is null) return;

        _gewaehlt.Wohnflaeche = ergebnis.Wert;
        _gewaehlt.Einheit = ergebnis.Einheit;
        _gewaehlt.Jahresnutzungsgrad = ergebnis.Jahresnutzungsgrad;
        _gewaehlt.DezentralWarmwasser = ergebnis.DezentralWarmwasser;
        _geaenderteZeilen.Add(_gewaehlt);

        ProjektzeileWaehlen(_gewaehlt);
        Geaendert?.Invoke();
    }

    /// <summary>
    /// „Simulation…" — der Wärmebedarf GENAU DIESES Gebäudes (Anwenderwunsch
    /// <b>W9‑E‑2</b> vom 05.09.2026).
    ///
    /// <para>Die Rechnung macht der Kern; die Hülle reicht ihr Ergebnis als
    /// Parametersatz herein — aus dem Arbeitsstand, also auch für eine eben übernommene,
    /// noch nicht gespeicherte Zeile; geschrieben wird dabei nichts, Abbrechen verwirft das
    /// Ergebnis mit der Zeile. Kommt <c>null</c> zurück — etwa weil das Projekt keine
    /// Klimaregion führt —, MELDET der Dialog das, statt eine leere Überlagerung
    /// aufzumachen.</para>
    /// </summary>
    private void BeiSimulation()
    {
        if (_gewaehlt is null || BedarfGaben is null) return;

        _meldung = "";
        IReadOnlyDictionary<string, object>? gaben = BedarfGaben(_gewaehlt);
        // Anwenderentscheid 06.10.2026: Eine ungespeicherte Importzeile, deren Zone mit Bauteilen erst
        // der Speicherweg anlegt, wird außerhalb des Assistenten zuerst still gespeichert und dann
        // gerechnet; scheitert das Speichern, steht seine Meldung.
        if (gaben is null && ListeSpeichern is not null && !_gewaehlt.HatProjektkopie
            && _gewaehlt.Herkunftsschluessel is not null)
        {
            if (!StillSpeichern(amKatalog: false)) return;
            gaben = BedarfGaben(_gewaehlt);
        }
        if (gaben is null)
        {
            // Stufe G6a: der benannte Grund der Fassade statt der allgemeinen Meldung.
            string? grund = BedarfBefund?.Invoke();
            Melden(string.IsNullOrWhiteSpace(grund)
                       ? MeldungKeinBedarf
                       : string.Format(System.Globalization.CultureInfo.CurrentCulture, MeldungKeinBedarfGrund, grund),
                   WarnStufe.Warnung);
            return;
        }

        _bedarfGaben = gaben;
    }

    private void BedarfFertig() => _bedarfGaben = null;

    /// <summary>
    /// „Gebäude in DB löschen" — ohne markierten Katalogsatz die Bitte um eine Wahl; ist
    /// der Satz gesperrt (Auslieferungssatz), steht der benannte Grund als Warnung, und es
    /// wird nicht erst nachgefragt. Sonst die Rückfrage; sie nennt die Projekte, die eine
    /// Kopie führen und behalten.
    /// </summary>
    private void BeiKatalogLoeschen()
    {
        if (_katalogzeile is null) { Melden(MeldungKeineWahl, WarnStufe.Warnung, amKatalog: true); return; }

        string sperre = KatalogLoeschsperre?.Invoke(_katalogzeile.Bezeichner) ?? "";
        _loeschsperre = sperre;
        if (sperre.Length > 0) { Melden(sperre, WarnStufe.Warnung, amKatalog: true); return; }
        string assistentsperre = AssistentLoeschsperre();
        if (assistentsperre.Length > 0) { Melden(assistentsperre, WarnStufe.Hinweis, amKatalog: true); return; }

        _loeschhinweis = KatalogLoeschhinweis?.Invoke(_katalogzeile.Bezeichner) ?? "";
        _meldung = "";
        _loeschfrage = true;
    }

    /// <summary>
    /// Die Antwort auf die Rückfrage — nach dem Löschen „Gebäude gelöscht!"
    /// (<c>btn_GebLoeschen_DB_Click</c>:548-566); lehnt der Schreibweg ab, steht die
    /// Absage da, statt still nichts zu tun.
    /// </summary>
    private void LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || _katalogzeile is null || KatalogLoeschen is null) return;

        // Anwenderentscheid 06.10.2026: Stammt eine eben übernommene, noch ungespeicherte Zeile aus
        // diesem Satz, entsteht ihre Kopie zuerst (stilles Speichern); sonst fände das OK den Satz
        // nicht mehr. Scheitert das Speichern, wird nicht gelöscht.
        int satz = _katalogzeile.Id;
        if (ListeSpeichern is not null && Zeilen.Any(z => !z.HatProjektkopie && z.IdKatalog == satz)
            && !StillSpeichern(amKatalog: true))
            return;

        if (!KatalogLoeschen(_katalogzeile.Bezeichner))
        {
            string sperre = KatalogLoeschsperre?.Invoke(_katalogzeile.Bezeichner) ?? "";
            _loeschsperre = sperre;
            Melden(sperre.Length > 0 ? sperre : MeldungLoeschFehler, WarnStufe.Warnung, amKatalog: true);
            return;
        }

        // Die Kopien im Projekt bleiben; ihr Verweis ist in der Datenbank jetzt leer
        // (SET NULL). Die offene Liste zieht ihn nach, damit das Speichern die Kopie als
        // unverändert erkennt und kein späterer Satz derselben Id sie anbindet.
        int geloescht = _katalogzeile.Id;
        foreach (GebaeudeProjektZeile z in Zeilen)
            if (z.IdKatalog == geloescht) z.IdKatalog = null;

        _katalogzeile = null;
        _katalogGewaehlt = "";
        _loeschhinweis = "";
        KatalogLaden();
        Melden(MeldungGeloescht, WarnStufe.Hinweis, amKatalog: true);
    }

    // =================================================================================
    // "Datei erneut lesen" (HC-4) - Zustand allein im Dialog, nichts wird geschrieben
    // =================================================================================

    private readonly Dictionary<int, GebaeudeImportquelleAngabe?> _quellen = new();
    private readonly GebaeudeAnsichtTexte _ansichtTexte = new();
    private bool _neulesenOffen;
    private bool _neulesenLaeuft;
    private GebaeudeNeulesestand? _neulesenStand;
    private GebaeudeImportquelleAngabe? _neulesenQuelle;
    private string? _neulesenGeschoss;
    private bool _neulesenGrundrissLaeuft;
    private string? _neulesenGrundrissHinweis;

    // =================================================================================
    // G5-N (N5/N6): Ausrichtung
    // =================================================================================

    /// <summary>
    /// Die gespeicherte Ausrichtung einer Zeile (Richtung der Planoberseite, Herkunft, Zahl der Bauteile); ohne Projektkopie
    /// oder Importquelle gesperrt. Kein Delegat = kein Abschnitt; <c>null</c> als Antwort = kein Abschnitt für diese Zeile.
    /// </summary>
    [Parameter] public Func<GebaeudeProjektZeile, GebaeudeAusrichtungDaten?>? Ausrichtung { get; set; }

    /// <summary>„Ausrichtung ändern…“: dreht alle Bauteile der Zeile auf die neue Richtung der Planoberseite und speichert sofort.</summary>
    [Parameter] public Func<GebaeudeProjektZeile, double, GebaeudeAusrichtungErgebnis>? AusrichtungAendern { get; set; }

    /// <summary>GEB_AUSRICHTUNG_AENDERN</summary>
    [Parameter] public string BtnAusrichtungText { get; set; } = Resource.GEB_AUSRICHTUNG_AENDERN;

    /// <summary>GEB_AUSRICHTUNG_AENDERN_HINWEIS</summary>
    [Parameter] public string BtnAusrichtungHinweis { get; set; } = Resource.GEB_AUSRICHTUNG_AENDERN_HINWEIS;

    /// <summary>GEB_AUSRICHTUNG_FRAGE ({0} = Bauteile, {1} = Drehung in Grad)</summary>
    [Parameter] public string AusrichtungFrageText { get; set; } = Resource.GEB_AUSRICHTUNG_FRAGE;

    /// <summary>GEB_AUSRICHTUNG_UNVERAENDERT</summary>
    [Parameter] public string AusrichtungUnveraendertText { get; set; } = Resource.GEB_AUSRICHTUNG_UNVERAENDERT;

    private readonly Dictionary<int, GebaeudeAusrichtungDaten?> _ausrichtungen = new();
    private int? _ausrichtungFuer;
    private double? _ausrichtungWert;
    private string? _ausrichtungFrage;

    /// <summary>Die Rückfrage vor dem Drehen, wie sie gerade steht (Prüfhilfe für Tests); <c>null</c> = keine.</summary>
    public string? AusrichtungFrage => _ausrichtungFrage;

    /// <summary>Die Ausrichtung einer Zeile — je Zeile einmal gefragt, nach einer Änderung neu; der Eingabewert gilt je Zeile.</summary>
    private GebaeudeAusrichtungDaten? AusrichtungVon(GebaeudeProjektZeile z)
    {
        if (Ausrichtung is null) return null;
        if (_ausrichtungFuer != z.IdZ)
        {
            _ausrichtungFuer = z.IdZ;
            _ausrichtungWert = null;
            _ausrichtungFrage = null;
        }
        if (!_ausrichtungen.TryGetValue(z.IdZ, out GebaeudeAusrichtungDaten? a))
        {
            a = Ausrichtung(z);
            _ausrichtungen[z.IdZ] = a;
        }
        return a;
    }

    /// <summary>Ein bestätigter Wert der Eingabe — noch nichts gedreht; das tut erst „Ausrichtung ändern…“.</summary>
    private void BeiAusrichtungWert(double wert) => _ausrichtungWert = wert;

    /// <summary>Die Drehung von <paramref name="alt"/> nach <paramref name="neu"/> im Uhrzeigersinn, normiert auf [0, 360).</summary>
    private static double Drehung(double alt, double neu)
    {
        double d = Math.Round(((neu - alt) % 360.0 + 360.0) % 360.0, 1, MidpointRounding.AwayFromZero);
        return d >= 360.0 ? 0.0 : d;
    }

    /// <summary>„Ausrichtung ändern…“: unverändert = Hinweis; sonst die Rückfrage mit der Zahl der Bauteile und der Drehung.</summary>
    private void BeiAusrichtungAendern()
    {
        if (_gewaehlt is null || AusrichtungAendern is null || AusrichtungVon(_gewaehlt) is not { Aenderbar: true } a) return;
        double neu = _ausrichtungWert ?? a.PlanoberseiteGrad;
        double drehung = Drehung(a.PlanoberseiteGrad, neu);
        if (drehung == 0.0) { Melden(AusrichtungUnveraendertText, WarnStufe.Hinweis); return; }
        _ausrichtungFrage = string.Format(System.Globalization.CultureInfo.CurrentCulture, AusrichtungFrageText,
                                          a.Bauteile, Zahlen.Anzeigetext(drehung));
    }

    /// <summary>Ja dreht (ein Vorgang des Kerns) und meldet das Ergebnis; danach Ausrichtung und Zeile neu gelesen. Nein lässt alles.</summary>
    private void AusrichtungBeantwortet(bool? ja)
    {
        _ausrichtungFrage = null;
        if (ja != true || _gewaehlt is not GebaeudeProjektZeile z || AusrichtungAendern is null
            || AusrichtungVon(z) is not { Aenderbar: true } a) return;
        GebaeudeAusrichtungErgebnis e = AusrichtungAendern(z, _ausrichtungWert ?? a.PlanoberseiteGrad);
        Melden(e.Meldung, e.Ok ? WarnStufe.Hinweis : WarnStufe.Fehler);
        if (!e.Ok) return;
        _ausrichtungen.Remove(z.IdZ);
        _ausrichtungWert = null;
        _neulesenStand = null;   // eine offene Ansicht des Neulesens zeigte die alte Drehung
        ZeileAuffrischen?.Invoke(z);
        ProjektzeileWaehlen(z);
    }

    /// <summary>Ist die Überlagerung „Datei erneut lesen“ offen?</summary>
    public bool NeuLesenOffen => _neulesenOffen;

    /// <summary>Die Quelle einer Zeile — je Zuordnung einmal gefragt; eine Zeile ohne Projektkopie hat keine.</summary>
    private GebaeudeImportquelleAngabe? QuelleVon(GebaeudeProjektZeile? z)
    {
        if (z is null || Importquelle is null || !z.HatProjektkopie) return null;
        if (!_quellen.TryGetValue(z.IdZ, out GebaeudeImportquelleAngabe? q))
        {
            q = Importquelle(z);
            _quellen[z.IdZ] = q;
        }
        return q;
    }

    /// <summary>
    /// Dateiwahl und Lesen; ein Abbruch der Wahl lässt den vorigen Stand stehen (beim ersten Mal bleibt die
    /// Überlagerung zu). Kein <see cref="Geaendert"/> — das Neulesen ändert nichts am Gebäude.
    /// </summary>
    private async Task BeiNeuLesen()
    {
        GebaeudeProjektZeile? z = _gewaehlt;
        if (z is null || DateiNeuLesen is null || _neulesenLaeuft) return;
        _neulesenQuelle = QuelleVon(z);
        _neulesenLaeuft = true;
        GebaeudeNeulesestand? stand;
        try
        {
            stand = await DateiNeuLesen(z);
        }
        finally
        {
            _neulesenLaeuft = false;
        }
        if (stand is null) return;   // Dateiwahl abgebrochen - kein Fehler
        if (!ReferenceEquals(stand.Ansicht, _neulesenStand?.Ansicht)) _neulesenGeschoss = null;
        _neulesenStand = stand;
        _neulesenGrundrissHinweis = null;
        _neulesenOffen = true;
    }

    /// <summary>
    /// HC-5 (F7): „Grundriss übernehmen“ — die Hülle fragt zurück und schreibt; danach die Hinweiszeile statt des Knopfs.
    /// Ein Nein lässt den Knopf stehen. Kein <see cref="Geaendert"/>: Der Grundriss ändert nichts an den Daten des Dialogs.
    /// </summary>
    private async Task BeiGrundrissNachtragen()
    {
        if (_neulesenStand?.GrundrissNachtragen is not { } nachtragen || _neulesenGrundrissLaeuft) return;
        _neulesenGrundrissLaeuft = true;
        try
        {
            _neulesenGrundrissHinweis = await nachtragen();
        }
        finally
        {
            _neulesenGrundrissLaeuft = false;
        }
    }

    private void NeuLesenSchliessen()
    {
        _neulesenOffen = false;
        _neulesenStand = null;
        _neulesenGeschoss = null;
        _neulesenGrundrissHinweis = null;
    }

    /// <summary>
    /// Vor dem Öffnen oder Übernehmen einer ungespeicherten Zeile: still speichern; ohne Speicherweg
    /// (Assistent) die weiche Sperre <paramref name="sperre"/>. Fehlt die Kopie trotz Erfolg, steht
    /// <see cref="MeldungProjektkopieFehlt"/>. <c>true</c>, wenn die Zeile danach ihre Projektkopie trägt.
    /// </summary>
    private bool VorherSpeichern(string sperre)
    {
        if (ListeSpeichern is null) { Melden(sperre, WarnStufe.Hinweis); return false; }
        if (!StillSpeichern(amKatalog: false)) return false;
        if (_gewaehlt is { HatProjektkopie: true }) return true;
        Melden(MeldungProjektkopieFehlt, WarnStufe.Warnung);
        return false;
    }

    /// <summary>
    /// <b>Der eine stille Speicherweg</b> (<see cref="ListeSpeichern"/>): bei Erfolg gilt keine Zeile
    /// mehr als ungespeichert geändert, die Wahl bleibt und ihr Detailblock zieht nach; sonst steht
    /// die Meldung als Warnung — unter der Katalogleiste (<paramref name="amKatalog"/>) oder oben.
    /// </summary>
    private bool StillSpeichern(bool amKatalog)
    {
        if (ListeSpeichern is null) return false;
        string fehler = ListeSpeichern() ?? "";
        if (fehler.Length > 0) { Melden(fehler, WarnStufe.Warnung, amKatalog); return false; }
        _geaenderteZeilen.Clear();
        // Der Detailblock zeigt die Projektzeile nur, solange kein Katalogsatz markiert ist (das
        // Löschen wirkt auf den markierten Satz - er bleibt markiert).
        if (_gewaehlt is not null && _katalogzeile is null) ProjektzeileWaehlen(_gewaehlt);
        return true;
    }

    private void Melden(string text, WarnStufe stufe, bool amKatalog = false)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
        _meldungAmKatalog = amKatalog;
    }

    /// <summary>
    /// Der Sperrgrund am Knopf „Gebäude in DB löschen": zuerst der des Katalogs (Auslieferungssatz),
    /// sonst der des Assistenten (<see cref="AssistentLoeschsperre"/>); leer = löschbar.
    /// </summary>
    private string LoeschsperreAnzeige => _loeschsperre.Length > 0 ? _loeschsperre : AssistentLoeschsperre();

    /// <summary>
    /// Anwenderentscheid 06.10.2026: Im Assistenten (kein stiller Speicherweg, gespeichert wird erst
    /// an seinem Ende) ist ein Katalogsatz gesperrt, aus dem eine ungespeicherte Projektzeile stammt —
    /// sonst fände das spätere Speichern den Satz nicht mehr. Andere Sätze bleiben löschbar.
    /// </summary>
    private string AssistentLoeschsperre()
    {
        if (ListeSpeichern is not null || _katalogzeile is null) return "";
        int satz = _katalogzeile.Id;
        return Zeilen.Any(z => !z.HatProjektkopie && z.IdKatalog == satz) ? SperreLoeschenAssistent : "";
    }

    /// <summary>Liest den Löschsperrgrund des markierten Katalogsatzes neu.</summary>
    private void LoeschsperreLesen()
        => _loeschsperre = _katalogzeile is null
            ? "" : KatalogLoeschsperre?.Invoke(_katalogzeile.Bezeichner) ?? "";

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Abbrechen — von Esc (nach den Wächtern) und vom Schliesskreuz gleichermaßen gerufen.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        // Die Ueberlagerungen werten Esc zuerst fuer sich aus.
        if (e.Key != "Escape" || _katalogGaben is not null || _importGaben is not null ||
            _wohnflaecheGaben is not null || _bedarfGaben is not null || _gebaeudetypOffen ||
            _loeschfrage || _ausProjektFrage || _projektGaben is not null || _exportGaben is not null ||
            _baustoffzuordnungenGaben is not null || _inDbOffen || _neulesenOffen) return Task.CompletedTask;
        return Abbrechen();
    }

    // =================================================================================
    // Schloss setzen / aufheben (AD-Q15) - derselbe Baustein wie in den Verwaltungen
