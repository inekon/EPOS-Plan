    private string Bezugstext(ZapfprofilZoneDaten z)
    {
        if (z.Bezugsmenge is not double b) return "";
        string einheit = Nutzungsart(z.IdNutzungsart)?.Bezugsgroesse ?? "";
        string zahl = b.ToString("0.##", CultureInfo.CurrentCulture);
        return einheit.Length == 0 ? zahl : zahl + " " + einheit;
    }

