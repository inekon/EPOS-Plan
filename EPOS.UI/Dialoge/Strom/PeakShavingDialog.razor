    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;

        // Der Vorlaeufer lud am Ende des Konstruktors - der erste Lastgang steht gleich da.
        await LastgangLaden();
        await _wurzel.FocusAsync();
        StateHasChanged();
    }

