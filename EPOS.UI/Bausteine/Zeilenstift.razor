@* DER STIFT EINER LISTENZEILE (UeS2, Anwenderentscheid 10.10.2026: „Füge jeweils in die
   Auswahl (DB und Projekt) ein Bearbeiten Symbol ein."). Ein schmaler Knopf am Ende der
   Zeile mit einem gezeichneten Stift; sein Kurztext und sein aria-label sagen „Bearbeiten".
   Der Klick bleibt beim Knopf (stopPropagation): Er löst weder die Zeilenwahl noch die
   Mehrfachlogik der Zeile aus — der Wirt wählt die Zeile selbst und öffnet ihren Satz.
   Enter und Leertaste wirken als Klick; der Doppelklick der Katalogliste übernimmt nicht
   (Knöpfe sind Textziele im Skript epos-zweispalten.js). Berührungsziel wie die übrigen
   Zeilenknöpfe (--epos-touchziel, in der Kompaktstufe kleiner), die Zeilenhöhe bleibt.
   Ohne Schlüssel zeichnet er den Spaltenkopf: die Beschriftung nur für die Sprachausgabe. *@

@namespace EPOS.UI.Bausteine

@if (Kopf)
{
    <span class="epos-zeilenstift-kopf">@Beschriftung</span>
}
else
{
    <button type="button" class="epos-zeilenstift" title="@(string.IsNullOrEmpty(Hinweis) ? Beschriftung : Hinweis)"
            aria-label="@Beschriftung" @onclick="BeiKlick" @onclick:stopPropagation="true"
            @ondblclick:stopPropagation="true" @onkeydown:stopPropagation="true">
        <svg class="epos-zeilenstift-bild" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
            <path d="M11.3 1.6a1.5 1.5 0 0 1 2.1 0l1 1a1.5 1.5 0 0 1 0 2.1L5.6 13.5 1.8 14.2l.7-3.8z M10.2 2.7l3.1 3.1"
                  fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" />
        </svg>
    </button>
}

@code {
    /// <summary>Kopf der Spalte statt Knopf der Zeile: nur die Beschriftung, verborgen für das Auge.</summary>
    [Parameter] public bool Kopf { get; set; }

    /// <summary>Beschriftung für Sprachausgabe und Kurztext — <c>AUSWAHL_ZEILE_BEARBEITEN</c>.</summary>
    [Parameter] public string Beschriftung { get; set; } = Resource.AUSWAHL_ZEILE_BEARBEITEN;

    /// <summary>Längerer Kurztext (etwa „nur lesen: erst Schloss aufheben"); leer = die Beschriftung.</summary>
    [Parameter] public string? Hinweis { get; set; }

    /// <summary>Der Klick auf den Stift.</summary>
    [Parameter] public EventCallback Geklickt { get; set; }

    private Task BeiKlick() => Geklickt.InvokeAsync();
}
