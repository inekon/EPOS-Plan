    /// <summary>Die Kenndaten der Detailzeile: die ersten drei gefüllten Felder, beim Projektsatz die Modulanzahl, beim gesperrten Satz der Hinweis.</summary>
    private string? SatzKenndaten
    {
        get
        {
            if (SatzArt == Satzmarke.Keiner) return null;
            var teile = _detail.Felder.Where(f => !string.IsNullOrWhiteSpace(f.Wert)).Take(3)
                .Select(f => f.Feld.TrimEnd(':', ' ') + " " + f.Wert).ToList();
            if (_projektZeile is not null)
                teile.Add(LabelAnzahl.TrimEnd(':', ' ') + " " + (_projektZeile.AnzahlModule ?? 0).ToString("0", CultureInfo.CurrentCulture));
            if (KatalogsatzGesperrt) teile.Add(Resource.AUSWAHL_SATZ_NUR_LESEN);
            return string.Join(" · ", teile);
        }
    }

