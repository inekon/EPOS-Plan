        SummeNachziehen();

        // SetControls: die erste Zeile ist beim Oeffnen gewaehlt.
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);

        // Welle KI-F1: die GEWAEHLTE Zeile beim Hilfe-Assistenten anmelden. Sie
        // wechselt mit jedem Klick in der Projektliste - deshalb ein Delegat und keine
        // Instanz; die Bruecke liest bei jedem Mal neu.
        // KI-F1b: Die Brennstoffvariante ist ein WAHLFELD; ihre Einträge kennt nur
        // dieser Dialog (sie hängen am Träger der gewählten Zeile), deshalb geht der
        // Lieferant als Quelle mit — er wird bei jedem Zugriff gerufen.
        // Welle #458, Stufe 2: angemeldet ist seither die SICHTKLASSE - sie reicht die
        // gewaehlte Zeile durch und traegt den Aufklapper „Alle Daten" als Feldtafel.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.HEIZKESSEL_PROJEKT,
                                          () => KiSicht(), KiHaken(),
                                          ("energietraeger", Traegereintraege));
    }

    private ErzeugerProjektKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die gewählte Projektzeile und der Aufklapper „Alle
    /// Daten" des gewählten Katalogsatzes (Welle #458, Stufe 2).
    /// </summary>
    private ErzeugerProjektKiSicht KiSicht() => _kiSicht ??= new ErzeugerProjektKiSicht
    {
        Zeilenquelle = () => _projektZeile,
        // Die Zeilenzahl sagt dem Sperrgrund, ob die Einzelwahl greift (genau eine Zeile).
        Zeilenzahl = () => Zeilen.Count,
        // Meldung 10.10.2026: ohne gewählte Zeile wählt der Assistent die EINZIGE wie das
        // Öffnen; bei mehreren rät er nicht, und die Sicht lehnt benannt ab.
        Einzelwahl = () =>
        {
            if (_projektZeile is null && Zeilen.Count == 1) ProjektZeileWaehlen(Zeilen[0]);
            return _projektZeile;
        },
        // Nach dem Setzen derselbe Übernahmeweg wie BeiVorlauf/BeiRuecklauf (Arbeitskopie,
        // nicht die Datenbank) - sonst stünde der Wert nur in der Zeile.
        Uebernommen = z => Uebernehmen?.Invoke(z),
        AlleDaten = new AlleDatenTafel
        {
            Felder = () => _parameterOffen ? _felder : null,
            Sperrgrund = () => AlleDatenTafel.Grund(_parameterOffen ? _felder : null,
                                                    _projektZeile is not null ? ProjektsatzWege?.Speichern is not null
                                                                              : KatalogfelderSpeichern is not null,
                                                    _katalogZeile?.Geschuetzt == true),
            Gesetzt = () => _felderGeaendert = true
        }
    };

