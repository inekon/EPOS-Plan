    private IReadOnlyDictionary<string, object> KpKalenderGaben() => new Dictionary<string, object>
    {
        ["Laden"] = new Func<IReadOnlyList<BetriebskalenderDaten>>(() => _kpKalender.OrderBy(k => k.Bezeichner).Select(k => k.Kopie()).ToList()),
        ["Laender"] = (IReadOnlyList<Bundeslandeintrag>)new[] { new Bundeslandeintrag("BY", "Bayern"), new Bundeslandeintrag("HE", "Hessen"), new Bundeslandeintrag("NW", "Nordrhein-Westfalen") },
        ["Pruefen"] = new Func<BetriebskalenderDaten, string?>(d => string.IsNullOrWhiteSpace(d.Bezeichner) ? "Bitte eine Bezeichnung eingeben." : null),
        ["Speichern"] = new Func<BetriebskalenderDaten, string?>(d =>
        {
            if (d.Id <= 0) d.Id = _kpKalender.Count == 0 ? 1 : _kpKalender.Max(k => k.Id) + 1;
            _kpKalender.RemoveAll(k => k.Id == d.Id);
            _kpKalender.Add(d.Kopie());
            return null;
        }),
        ["Loeschen"] = new Func<int, string?>(id => { _kpKalender.RemoveAll(k => k.Id == id); return null; }),
        ["Verwendungen"] = new Func<int, int>(_ => 1),
        ["Herleitung"] = new Func<BetriebskalenderDaten, string>(d => "Im Gemeinjahr (1. Januar ein Donnerstag): Feiertage und Ferientage nach den Regeln des Kerns."),
        ["Gebaeude"] = new Func<IReadOnlyList<BetriebskalenderGebaeude>>(() => _kpGebaeude)
    };

    // ------------------------------------------------------ Katalogdialog
    private Katalogfilterprofil? _bedarfProfil;
    private Katalogfilterprofil BedarfProfil
        => _bedarfProfil ??= Katalogfilterprofil.FuerBedarf(BedarfsArt.Stromverbraucher, Uebersetzt);

    private IReadOnlyList<Katalogfilterzeile>? _bedarfZeilen;
    private IReadOnlyList<Katalogfilterzeile> BedarfZeilen => _bedarfZeilen ??= Zeilenbau.Voll(BedarfProfil, _anzahl);
    /// <summary>K-F5b: die Gaben der Gruppe „Rückkühlung“ — ein trockener und ein nasser Katalogsatz, Klima ohne Feuchte.</summary>
    private static RueckkuehlungGaben RkGaben() => new()
    {
        KlimaMitFeuchte = false,
        Katalog = new[]
        {
            new RueckkuehlwerkEintrag(7, "Rückkühler 1 · Trockenkühler", RkLesung("Rückkühler 1", 7, false, null)),
            new RueckkuehlwerkEintrag(8, "Kühlturm 1 · Kühlturm, offen", RkLesung("Kühlturm 1", 8, true, 2.5)),
        }
    };

    private static RueckkuehlwerkLesung RkLesung(string name, int stamm, bool nass, double? ventilator) => new()
    {
        Bezeichner = name, StammId = stamm, Verdunstungskuehlanlage = nass, VentilatorKw = ventilator,
        Zeilen = new List<(string, string)>
        {
            ("Bauart", nass ? "Kühlturm, offen" : "Vorgabe: Trockenkühler"), ("Nennleistung (abzuführende Wärme)", "150 kW"),
            ("Annäherung", "Vorgabe: 5 K · Vorgabe: fest"),
            ("Ventilator", ventilator is double v ? v + " kW · Drehzahl" : "Vorgabe: Hilfsstrom der Rückkühlung an der Kältemaschine"),
            ("Freikühlung", "Vorgabe: parallel"),
        }
    };

