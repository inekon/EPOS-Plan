@* Der ERGEBNIS-Reiter der Ergebnisseite (R11 + DashboardForm, iU9-W11b.11).

   VORBILD. tabPage_Ergebnis hatte NULL Designer-Kinder; sein Inhalt entstand im
   TabNavigationManager (242 Z.): ein SplitContainer 10/90, links VIER Knoepfe,
   rechts ein Inhaltspanel, in das je nach Knopf NavigatorUebersicht,
   DashboardForm, NavigatorWaerme oder NavigatorStrom eingesetzt wurde.

   AUS DEN VIER KNOEPFEN WIRD EIN INNERER <Reiter> - seit #222 mit DREI
   Blaettern. Die zwei Fremdinhalte (Waerme- und Stromganglinie) reicht der Wirt
   als RenderFragment herein - so bleibt diese Komponente das, was sie ist: die
   Navigation und die AUTARKIE-ANALYSE. Das vierte Blatt „Uebersicht" ist mit
   #222 gefallen: Es zeigte dieselben Zahlen wie der gleichnamige HAUPTreiter,
   der seit #216 das erste Blatt der Seite ist.

   VIER BEFUNDE ENTFALLEN MIT DEM TabNavigationManager:
     W11-B43  vier RowStyles bei RowCount = 3,
     W11-B44  bei JEDEM Knopfdruck ein neues DashboardForm, ohne Dispose des
              vorherigen - GDI-Handles und Chart-Objekte sammelten sich an,
     W11-B45  RecordSet mit string-konkateniertem SQL in der Navigationsklasse
              (seit W11a StromspeicherStammCtrl.KapazitaetJeProjekt),
     W11-B46  case 0 fuegte das Control zweimal ein, case 1 rief Show() auf
              einem TopLevel=false-Formular,
     W11-B47  RefreshActivePage() prueft auf INavigatableContent, das
              DashboardForm bediente sie nicht - nach einem neuen Lauf zeigte die
              Autarkiekachel weiter die Zahlen des vorigen. Ein Blatt, das erst
              beim Betreten entsteht, kann das nicht.

   BEFUND W11-B31 IST IN W11a BEHOBEN: Die zwei Emissionsfaktoren (0,42 und
   0,20) standen hartkodiert in der Oberflaeche; sie stehen jetzt in
   EmissionsVorgaben - Werte unveraendert (offener Punkt W11a-O-2).

   BEFUND W11-B32, WOERTLICH UEBERNOMMEN UND JETZT BENANNT: Die Kapazitaet der
   Autarkiekachel wird NIE zurueckgeschrieben - sie ist eine reine
   Was-waere-wenn-Groesse. Der Vorlaeufer sagte das nirgends; hier steht der
   Satz unter dem Feld. *@

@namespace EPOS.UI.Seiten.Simulation
@using WindowsFormsApplication1.Zeichnung

<div class="epos-simerg-block">

    <Reiter @ref="_reiter" @bind-Aktiv="_blatt" Bezeichnung="@ReiterBezeichnung">
        <KindInhalt>

            @* DAS BLATT „UEBERSICHT" IST MIT #222 GEFALLEN (Anwenderentscheid
               11.09.2026, Punkt a: „eine Uebersicht"). Es zeigte dieselben Zahlen
               wie der Hauptreiter „Uebersicht" - zwei Ringe, zwei Rest-Kacheln und
               das Eigenanteilsraster -, und der steht seit #216 ohnehin als ERSTES
               Blatt der Seite. Was bleibt, sind die DREI Blaetter, die dieser
               Reiter selbst traegt: die Autarkie-Analyse und die zwei
               Produktionsganglinien. Das erste Blatt ist seither die AUTARKIE. *@

            <Reiterblatt Schluessel="AUTARKIE" Titel="@Resource.SIM_NAV_AUTARKIE_ANALYSE">
                <KindInhalt>

                    <Kachelraster>
                        <KindInhalt>
                            @if (Autarkie.HatPv)
                            {
                                <div class="epos-simerg-block">
                                    <Kennzahlkachel Titel="@Resource.SIM_DASH_GRUPPE_PV"
                                                    Wert="@Prozent(Autarkie.AutarkiePvProzent)" />
                                    <meter min="0" max="100" value="@Geklemmt(Autarkie.AutarkiePvProzent)"
                                           aria-label="@Resource.SIM_DASH_GRUPPE_PV"></meter>
                                </div>
                            }

                            @* DIE SOLARTHERMIE-KACHEL liest dieselben Reihen wie das Waermebild:
                               Deckung = (Direktdeckung + solarer Speicheranteil) / ganzer
                               Waermebedarf des Projekts; der therm. Nutzungsgrad setzt dieselbe
                               solar gedeckte Waerme ins Verhaeltnis zum Kollektorertrag
                               (nutzbar + verworfener Ueberschuss). *@
                            @if (Autarkie.HatSolarthermie)
                            {
                                <div class="epos-simerg-block">
                                    <Kennzahlkachel Titel="@Resource.SIM_DASH_GRUPPE_ST"
                                                    Wert="@(Autarkie.DeckungStBekannt
                                                              ? Prozent(Autarkie.DeckungStProzent)
                                                              : Resource.SIM_ANZEIGE_NICHT_BENOETIGT)"
                                                    Quelle="@string.Format(Resource.SIM_ANZEIGE_THERM_NUTZUNGSGRAD,
                                                                           Zahl(Autarkie.NutzungsgradStProzent, "N2"))" />
                                    <meter min="0" max="100" value="@Geklemmt(Autarkie.DeckungStProzent)"
                                           aria-label="@Resource.SIM_DASH_GRUPPE_ST"></meter>
                                </div>
                            }

                            @* SPEICHERNUTZEN JE SEITE: die Stromzeile, wo das Strombild steht,
                               die Waermezeile (solarer Speicheranteil), wo das Waermebild
                               steht - mit PV und Solarthermie untereinander. *@
                            <Kennzahlkachel Titel="@Resource.SIM_ERGEBNIS"
                                            Wert="@string.Format(Resource.SIM_ANZEIGE_CO2_ERSPARNIS,
                                                                 Zahl(Autarkie.Co2ErsparnisKg, "N0"))"
                                            Quelle="@Speichernutzen()" />
                        </KindInhalt>
                    </Kachelraster>

                    @if (Autarkie.HatPv)
                    {
                        <div class="epos-simerg-felder">
                            <Zahlenfeld Bezeichnung="@Resource.SIM_DASH_SPEICHER_INFO"
                                        Wert="@Autarkie.SpeicherKwh" Einheit="kWh"
                                        WertChanged="KapazitaetGesetzt" />
                            <p class="epos-simerg-hinweis">@Resource.SIMERG_LBL_KAPAZITAET_HINWEIS</p>
                        </div>
                    }

                    @* DER MONATSSTAPEL ALS SVG (Etappe DG-E3, Gruppe (c)): Zwoelf
                       starre Faecher sind keine Zeitachse - es gibt dort nichts zu
                       zoomen, und der Baustein schaltet den Zoom von selbst ab,
                       sobald ein Modell keine Zeichenflaeche traegt. Was er dafuer
                       zeigt, ist der Wert der Schicht unter dem Zeiger
                       („Jan · Eigenverbrauch: 1.234 kWh", DG-E3-10); die Einheit
                       steht schon darin und wird hier nicht ein zweites Mal
                       behauptet. *@
                    @if (Autarkie.ZeigtStromMonate)
                    {
                        <DiagrammSvg Modell="@ModellMonate" Kennung="simerg-monate"
                                     Bezeichnung="@Resource.CHART_ACHSE_ENERGIEBEDARF_DECKUNG" />
                    }

                    @* DIE WAERME-AUTARKIE (26.09.2026): Mit Solarthermie derselbe
                       Monatsstapel fuer die Waerme - solar direkt, solar ueber den
                       Speicher, Deckungsluecke. Hat das Projekt auch PV, stehen beide
                       Bilder untereinander; nur mit Solarthermie steht allein dieses. *@
                    @if (Autarkie.ZeigtWaermeMonate)
                    {
                        <DiagrammSvg Modell="@ModellWaermeMonate" Kennung="simerg-waermemonate"
                                     Bezeichnung="@Resource.CHART_TITEL_WAERMEBEDARF_DECKUNG" />

                        @* Die solare Deckung je Monat in % - als Zeile unter dem Bild wie
                           die Nulldurchgaenge unter dem Kapitalwertverlauf. *@
                        @if (!string.IsNullOrEmpty(Autarkie.WaermeDeckungMonate))
                        {
                            <Herleitungszeile Text="@Autarkie.WaermeDeckungMonate" />
                        }
                    }

                </KindInhalt>
            </Reiterblatt>

            <Reiterblatt Schluessel="WAERMEGANG" Titel="@Resource.SIM_NAV_WAERMEPRODUKTION_CHART">
                <KindInhalt>@WaermegangInhalt</KindInhalt>
            </Reiterblatt>

            <Reiterblatt Schluessel="STROMGANG" Titel="@Resource.SIM_NAV_STROMPRODUKTION_CHART">
                <KindInhalt>@StromgangInhalt</KindInhalt>
            </Reiterblatt>

        </KindInhalt>
    </Reiter>

</div>

@code {
    /// <summary>Die Zahlen der Autarkie-Analyse.</summary>
    [Parameter] public AutarkieDaten Autarkie { get; set; } = new AutarkieDaten();

    /// <summary>
    /// Liefert das Zeichenmodell des Monatsstapels (B6) zur gewaehlten Kapazitaet;
    /// ohne ihn bleibt das Diagramm leer.
    /// </summary>
    [Parameter] public Func<Bildauftrag, Zeichenmodell?>? Modell { get; set; }

    /// <summary>
    /// Die Was-waere-wenn-Kapazitaet hat sich geaendert — die Huelle rechnet die
    /// Kacheln neu. Sie wird NICHT gespeichert (Befund W11-B32).
    /// </summary>
    [Parameter] public EventCallback<double> KapazitaetGeaendert { get; set; }

    /// <summary>Der Waermegang-Reiter.</summary>
    [Parameter] public RenderFragment? WaermegangInhalt { get; set; }

    /// <summary>Der Stromgang-Reiter.</summary>
    [Parameter] public RenderFragment? StromgangInhalt { get; set; }

    [Parameter] public string ReiterBezeichnung { get; set; } = "Ergebnis";

    /// <summary>Das sichtbare Blatt (Pruefhilfe).</summary>
    public string AktivesBlatt => _reiter?.AktiverSchluessel ?? _blatt;

    private Reiter? _reiter;
    private string _blatt = "";

    private Zeichenmodell? ModellMonate =>
        Modell?.Invoke(new Bildauftrag(Bilder.AutarkieMonate, false, -1, null, Autarkie.SpeicherKwh));

    private Zeichenmodell? ModellWaermeMonate =>
        Modell?.Invoke(new Bildauftrag(Bilder.WaermeAutarkieMonate));

    /// <summary>
    /// Die leise Zeile der Ergebniskachel: Speichernutzen Strom und/oder Wärme, je eine
    /// Zeile (die Kachel bricht an „\n" um).
    /// </summary>
    private string Speichernutzen()
    {
        var zeilen = new List<string>(2);
        if (Autarkie.ZeigtSpeichernutzenStrom)
            zeilen.Add(string.Format(Resource.SIM_ANZEIGE_SPEICHERNUTZEN,
                                     Zahl(Autarkie.SpeichernutzenKwh, "N0")));
        if (Autarkie.ZeigtSpeichernutzenWaerme)
            zeilen.Add(string.Format(Resource.SIM_ANZEIGE_SPEICHERNUTZEN_WAERME,
                                     Zahl(Autarkie.SpeichernutzenWaermeKwh, "N0")));
        return string.Join("\n", zeilen);
    }

    private Task KapazitaetGesetzt(double? wert)
    {
        Autarkie.SpeicherKwh = wert ?? 0.0;
        return KapazitaetGeaendert.InvokeAsync(Autarkie.SpeicherKwh);
    }

    /// <summary>
    /// Eine Quote der Autarkiekacheln. „N2" statt „F1" seit W11b‑B‑23
    /// (09.09.2026): Die Kacheln der Übersicht und JEDE Kennzahlenliste der
    /// Ergebnisreiter setzen ihre Zahlen mit N2 - zwei Nachkommastellen und
    /// Tausendertrennung. Die zwei Quoten dieses Blattes waren die letzten mit
    /// einer eigenen Schreibweise.
    /// </summary>
    private static string Prozent(double wert) => Zahl(wert, "N2") + " %";

    private static string Zahl(double wert, string format)
        => wert.ToString(format, System.Globalization.CultureInfo.CurrentCulture);

    /// <summary>
    /// Der Balken zeigt 0…100 — woertlich wie <c>pbPV.Value</c>/<c>pbST.Value</c>,
    /// die der Vorlaeufer auf denselben Bereich klemmte.
    /// </summary>
    private static string Geklemmt(double wert)
    {
        double w = wert;
        if (double.IsNaN(w) || w < 0) w = 0;
        if (w > 100) w = 100;
        return w.ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    }
}
