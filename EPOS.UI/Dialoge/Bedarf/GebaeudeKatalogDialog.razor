            MeldungNachtzeitGleich = MeldungNachtzeitGleich,
            MeldungNachtzeitBereich = MeldungNachtzeitBereich,
            FeldNachtBeginn = Feld(LabelNachtBeginn),
            FeldNachtEnde = Feld(LabelNachtEnde),
            MeldungFerienWinter = MeldungFerienWinter,
            MeldungFerienOstern = MeldungFerienOstern,
            MeldungFerienSommer = MeldungFerienSommer,
