@* Lastspitzenkappung (Peak-Shaving) — AP7 (iU9-W12.6); seit Stufe 5 der
   Neuordnung der Administrationsdialoge (V16, Bestand A11) im Geruest der
   Verwaltungen.

   Vorbild: Views/Stromspeicher/Form_PeakShaving.cs (761 Z.).

   WOZU. Eingang ist allein ein Lastgang - eine Ganglinie aus Projekt oder
   Stammkatalog ODER eine ad hoc eingelesene Datei. Ein geoeffnetes Projekt ist
   nicht noetig. Bezugsgroesse der Spitze ist das Jahresmaximum der
   Viertelstundenleistung; abgelegt wird nichts, Exportweg ist CSV.

   EIN RECHENWERKZEUG IM GERUEST (Konzept 3.6 Punkt 6). Statt Optionsgruppe,
   Klappliste und Dateiwahl steht links die LISTE DER LASTGAENGE
   (Katalogliste, Profil FuerLastgang: Lastgang, Quelle, Intervall,
   Jahresmaximum; die Zeile ist die Wahl). Eine eingelesene Datei erscheint als
   Zeile mit der Quelle "Datei" und wird nicht abgelegt. Rechts steht das
   STAMMBLATT des gewaehlten Lastgangs: die Parameter in den Gruppen Speicher,
   Schwelle und Kosten, dann "Berechnen" - zwischen Parametern und Ergebnis,
   der Lesefluss aus dem Entscheid DL-Q2 bleibt -, dann die Gruppe Ergebnis mit
   den drei Reitern. Kein Neu..., Duplizieren, Loeschen, kein Schloss, keine
   Kaestchen: Die Maske pflegt keinen Katalog. Die Auswahlleiste steht nur im
   schmalen Fenster - dort traegt sie "Stammblatt ›".

   DIE IMPORTKETTE LIEGT IM KERN (GanglinienImportAblauf.OhneAblage). "Lastgang
   aus Datei..." in der Fussleiste oeffnet die Dateiwahl als Ueberlagerung
   (V14); Optionen und Protokoll der Kette erscheinen darueber.

   DER RECHENLAUF LAEUFT NEBENHER (Befund W12-B22): Beide Laeufe gehen ueber
   einen Delegaten, den die Huelle auf Task.Run legt, und melden sich am
   Baustein Fortschritt.

   DIE PRUEFREGELN UND DIE UMRECHNUNG LIEGEN IM KERN (PeakShavingEingaben).

   DAS BILD IST EIN ZEICHENMODELL im Baustein DiagrammSvg (Etappe DG-E3).

   WOERTLICH TROTZ BEFUND: W12-B24 - der Schlussknopf meldet false.

   TASTATUR: Esc schliesst die oberste Ebene (Ueberlagerung, schmales Blatt,
   Dialog). Enter ist nicht belegt. *@

@namespace EPOS.UI.Dialoge.Strom
@using System.Globalization
@using SpeicherEngine
@using WindowsFormsApplication1
@using WindowsFormsApplication1.Zeichnung
@implements IDisposable

<div class="epos-dialog epos-katalog-dialog epos-peakshaving" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="BeiSchliessen" />
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    <Katalograhmen BlattOffen="@_blattOffen">
        <Liste>
            @* DIE LISTE DER LASTGAENGE (V16): Stamm, Projekt und eingelesene Dateien;
               die Zeile ist die Wahl, kein Kaestchen, kein Vergleich. *@
            <Katalogliste Profil="@Profil" Zeilen="@_zeilen"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_gewaehlt" GewaehltChanged="BeiZeile" ZeileIstWahl="true"
                          Vergleichbar="false" />
        </Liste>

        <Auswahl>
            @* NUR IM SCHMALEN FENSTER: Name und "Stammblatt ›" - breit steht keine
               Auswahlleiste, es gibt keine Handlung an Zeilen. *@
            <div class="epos-nur-schmal epos-peakshaving-auswahl">
                <Auswahlleiste Fokus="@Fokusname" HinweisText=""
                               Stammblatt="@BlattOeffnenWeg" />
            </div>
        </Auswahl>

        <Blatt>
            <Stammblatt Name="@Fokusname" Unterzeile="@Unterzeile"
                        Kennzahlen="@Kopfkennzahlen" ZurListe="@_blattSchliessen">
                <Gruppen>
                    @* ================================================ Speicher *@
                    <Stammblattgruppe Titel="@GruppeSpeicher">
                        <KindInhalt>
                            <Herleitungszeile Text="@_herkunft" />
                            <Formularraster>
                                <KindInhalt>
                                    <Zahlenfeld Bezeichnung="@LabelP" Einheit="kW" Feldname="@LabelP"
                                                Wert="@_pKw" WertChanged="w => _pKw = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelKapazitaet" Einheit="kWh" Feldname="@LabelKapazitaet"
                                                Wert="@_kapazitaet" WertChanged="w => _kapazitaet = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelEta" Feldname="@LabelEta"
                                                Wert="@_eta" WertChanged="w => _eta = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelSoCMin" Einheit="%" Feldname="@LabelSoCMin"
                                                Wert="@_socMin" WertChanged="w => _socMin = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelSoCMax" Einheit="%" Feldname="@LabelSoCMax"
                                                Wert="@_socMax" WertChanged="w => _socMax = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelStartSoC" Einheit="%" Feldname="@LabelStartSoC"
                                                Wert="@_startSoC" WertChanged="w => _startSoC = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                </KindInhalt>
                            </Formularraster>
                        </KindInhalt>
                    </Stammblattgruppe>

                    @* ================================================= Schwelle *@
                    <Stammblattgruppe Titel="@GruppeSchwelle">
                        <KindInhalt>
                            <Schalter Bezeichnung="@LabelAdaptiv" Wert="@_adaptiv" WertChanged="AdaptivGeaendert"
                                      Aktiv="@(!_laeuft)" />
                            <Formularraster>
                                <KindInhalt>
                                    @* Woertlich: die Zielschwelle ist gesperrt, solange
                                       nachgezogen wird - sie bleibt SICHTBAR und lesbar. *@
                                    <Zahlenfeld Bezeichnung="@LabelZiel" Einheit="kW" Feldname="@LabelZiel"
                                                Wert="@_ziel" WertChanged="w => _ziel = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_adaptiv && !_laeuft)" />
                                    <button type="button" class="epos-knopf epos-peakshaving-minimal" disabled="@_laeuft"
                                            @onclick="BeiMinimal">@MinimalText</button>
                                    <Zahlenfeld Bezeichnung="@LabelLp" Feldname="@LabelLp"
                                                Wert="@_lp" WertChanged="w => _lp = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelBezugspreis" Feldname="@LabelBezugspreis"
                                                Wert="@_bezugspreis" WertChanged="w => _bezugspreis = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                </KindInhalt>
                            </Formularraster>
                            <Schalter Bezeichnung="@LabelKompatibel" Wert="@_kompatibel"
                                      WertChanged="w => _kompatibel = w" Aktiv="@(!_laeuft)" />
                        </KindInhalt>
                    </Stammblattgruppe>

                    @* =================================================== Kosten *@
                    <Stammblattgruppe Titel="@GruppeKosten">
                        <KindInhalt>
                            <Formularraster>
                                <KindInhalt>
                                    <Zahlenfeld Bezeichnung="@LabelCCap" Feldname="@LabelCCap"
                                                Wert="@_cCap" WertChanged="w => _cCap = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelCPow" Feldname="@LabelCPow"
                                                Wert="@_cPow" WertChanged="w => _cPow = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelIFix" Feldname="@LabelIFix"
                                                Wert="@_iFix" WertChanged="w => _iFix = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelZins" Einheit="%" Feldname="@LabelZins"
                                                Wert="@_zins" WertChanged="w => _zins = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                    <Zahlenfeld Bezeichnung="@LabelNutzungsdauer" Einheit="a" Feldname="@LabelNutzungsdauer"
                                                Wert="@_nutzungsdauer" WertChanged="w => _nutzungsdauer = w"
                                                FehlerZustand="BeiFehlerZustand" Aktiv="@(!_laeuft)" />
                                </KindInhalt>
                            </Formularraster>
                        </KindInhalt>
                    </Stammblattgruppe>

                    @* DL-Q2 (a): "Berechnen" steht im Blatt ZWISCHEN den Parametern und dem
                       Ergebnis - der Lesefluss Parameter -> Rechnen -> Ergebnis. Die
                       Primaerfarbe traegt er nicht: Sie gehoert dem Schlussknopf. Eine
                       Knopfzeile im Blatt, die weder primaer ist noch schliesst, ist keine
                       zweite Fussleiste (Konzept 3.2). *@
                    <div class="epos-leiste epos-peakshaving-rechnen">
                        <button type="button" class="epos-knopf" disabled="@_laeuft"
                                @onclick="BeiRechnen">@RechnenText</button>
                    </div>

                    @if (_laeuft)
                    {
                        <Fortschritt Anteil="null" Text="@_fortschritt" />
                    }

                    @* ================================================= Ergebnis *@
                    <Stammblattgruppe Titel="@GruppeErgebnis">
                        <KindInhalt>
                            <Reiter @bind-Aktiv="_reiter" Bezeichnung="@GruppeErgebnis">
                                <KindInhalt>
                                    <Reiterblatt Schluessel="KENNZAHLEN" Titel="@ReiterKennzahlen">
                                        <KindInhalt>
                                            <div class="epos-raster-huelle">
                                                <table class="epos-raster">
                                                    <thead>
                                                        <tr>
                                                            <th>@SpalteGroesse</th>
                                                            <th>@SpalteWert</th>
                                                            <th>@SpalteEinheit</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (PeakShavingKennzahlenBlock.Zeile z in _kennzahlen)
                                                        {
                                                            <tr class="@(z.IstTrenner ? "epos-zeile--trenner" : null)">
                                                                <td>@z.Bezeichnung</td>
                                                                <td class="@(z.Negativ ? "epos-wert--negativ" : null)">@z.Wert</td>
                                                                <td>@z.Einheit</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </KindInhalt>
                                    </Reiterblatt>

                                    <Reiterblatt Schluessel="CHART" Titel="@ReiterChart">
                                        <KindInhalt>
                                            <Schalter Bezeichnung="@LabelSoC" Wert="@_socZeigen" WertChanged="SoCGeaendert"
                                                      Aktiv="@(!_laeuft)" />
                                            @* DER LASTGANG ALS ZEICHENMODELL (Etappe DG-E3): Zoom auf
                                               der Zeitachse, der Ladezustand auf der zweiten Achse. *@
                                            <DiagrammSvg Modell="@_modell" Kennung="peakshaving-lastgang"
                                                         Bezeichnung="@ReiterChart" PlatzhalterText="@LeerText"
                                                         Einheit="kW" EinheitRechts="kWh" />
                                        </KindInhalt>
                                    </Reiterblatt>

                                    <Reiterblatt Schluessel="MONATE" Titel="@ReiterMonate">
                                        <KindInhalt>
                                            <div class="epos-raster-huelle">
                                                <table class="epos-raster">
                                                    <thead>
                                                        <tr>
                                                            <th>@SpalteMonat</th>
                                                            <th>@SpalteAlt</th>
                                                            <th>@SpalteNeu</th>
                                                            <th>@SpalteKappung</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (PeakShavingKennzahlenBlock.Monatszeile m in _monate)
                                                        {
                                                            <tr>
                                                                <td>@m.Monat</td>
                                                                <td>@m.Alt</td>
                                                                <td>@m.Neu</td>
                                                                <td>@m.Kappung</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </KindInhalt>
                                    </Reiterblatt>
                                </KindInhalt>
                            </Reiter>
                            <p class="epos-stammblatt-erklaerung">@HinweisText</p>
                        </KindInhalt>
                    </Stammblattgruppe>
                </Gruppen>
            </Stammblatt>
        </Blatt>
    </Katalograhmen>

    @* DIE FUSSLEISTE (V14, V15): "Lastgang aus Datei..." an der Stelle von Import...,
       CSV-Export und "In Variante uebernehmen" (beide wirken auf das Ergebnis),
       Statuszeile, zuletzt der eine Schlussknopf "Beenden". *@
    <div class="epos-leiste">
        @if (Einlesen is not null && DateiWaehlen is not null)
        {
            <button type="button" class="epos-knopf epos-importknopf" disabled="@_laeuft"
                    @onclick="DateiOeffnen">@DateiLastgangText</button>
        }
        @if (CsvSpeichern is not null)
        {
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="BeiCsv">@CsvText</button>
        }
        @* DER AUSGANG DER MASKE (LS-E-1 (a)): Berechnungsart, Ziel und Adaptiv-Flag in
           die AKTIVE Speichervariante; fuehrt die eine andere Art, wird vorher gefragt. *@
        @if (VarianteUebernehmen is not null)
        {
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="BeiVarianteUebernehmen">@VarianteText</button>
        }
        <span class="epos-leiste-fueller epos-status" role="status">@_status</span>
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="BeiSchliessen">@BeendenText</button>
    </div>

    <Rueckfrage Offen="@_varianteFrageOffen" TitelText="@VarianteText" Frage="@_varianteFrage"
                Beantwortet="VarianteBeantwortet" />

    @* --- "Lastgang aus Datei..." als Ueberlagerung (V14): die Dateiwahl startet die
           Kette OHNE Ablage; waehrend sie laeuft, schliessen weder Kreuz noch Esc. *@
    <Ueberlagerung Offen="@_dateiOffen" Titel="@TitelDatei" Geschlossen="DateiSchliessen">
        <KindInhalt>
            @if (_dateiOffen)
            {
                <div class="epos-einlesen">
                    <Herleitungszeile Text="@HinweisDatei" />
                    @if (DateiWaehlen is not null)
                    {
                        <Formularraster Einspaltig="true">
                            <KindInhalt>
                                <Dateiwahl Bezeichnung="" KnopfText="@DateiText" Filter="@Dateifilter"
                                           Pfad="@_pfad" Waehlen="@DateiWaehlen" PfadChanged="BeiDatei"
                                           Aktiv="@(!_laeuft)" />
                            </KindInhalt>
                        </Formularraster>
                    }
                    @if (_laeuft)
                    {
                        <Fortschritt Anteil="null" Text="@_fortschritt" />
                    }
                    <div class="epos-leiste">
                        <span class="epos-leiste-fueller"></span>
                        <button type="button" class="epos-knopf" disabled="@_laeuft"
                                @onclick="DateiSchliessen">@AbbrechenText</button>
                    </div>
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* ------------------- Die zwei Ueberlagerungen der Importkette ---------- *@
    <Ueberlagerung Offen="@_optionenOffen" Titel="" Schliessbar="false">
        <KindInhalt>
            @if (_optionenOffen)
            {
                <GanglinieImportOptionenDialog Pfad="@_optionenPfad" Erkennung="@_optionenErkennung"
                                               Vorschau="@Vorschau" Geschlossen="OptionenFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@_protokollOffen" Titel="" Schliessbar="false">
        <KindInhalt>
            @if (_protokollOffen)
            {
                <GanglinieProtokollDialog Meldungen="@_protokollMeldungen"
                                          ImportMoeglich="@_protokollMoeglich"
                                          BestaetigungNoetig="@_protokollBestaetigen"
                                          Geschlossen="ProtokollFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    /// <summary>Steuerwert der Quelle (Sicht des Assistenten): vorhandene Ganglinie.</summary>
    public const int QuelleGanglinie = 0;

    /// <summary>Steuerwert der Quelle (Sicht des Assistenten): eingelesene Datei.</summary>
    public const int QuelleDatei = 1;

    /// <summary>Der Schlüsselanfang einer eingelesenen Datei in der Liste.</summary>
    private const string DATEI = "D";

    /// <summary>Der Schlüsselanfang einer Ganglinie der Datenbank („G" + Platz).</summary>
    private const string GANGLINIE = "G";

    // =====================================================================
    // Eingaben und Delegaten - die Datenseite liegt in der Huelle
    // =====================================================================

    /// <summary>
    /// Die wählbaren Ganglinien, fertig beschriftet (<c>Id</c> = Platz in der Liste der
    /// Hülle). Sie tragen die Sicht des Assistenten und — ohne
    /// <see cref="Lastgangzeilen"/> — die Liste.
    /// </summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Ganglinien { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>
    /// <b>Die Zeilen der Liste der Lastgänge</b> (<c>PeakShavingCtrl.Katalogfilterzeilen</c>,
    /// V16): Lastgang, Quelle, Intervall, Jahresmaximum; der Schlüssel ist <c>"G" + Platz</c>.
    /// </summary>
    [Parameter] public IReadOnlyList<Katalogfilterzeile>? Lastgangzeilen { get; set; }

    /// <summary>Die Spalten — <c>Katalogfilterprofil.FuerLastgang</c>; ohne sie das Profil mit den Ressourcentexten.</summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste — sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Ein eigener Filterstand statt des Registers.</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>Vorbelegung aus Gerät und aktiver Variante; <c>null</c> = die Vorgaben der Modelle.</summary>
    [Parameter] public PeakShavingVorbelegung? Vorgaben { get; set; }

    /// <summary>Liest die Werte einer Ganglinie über ihren Platz (<c>PeakShavingCtrl.LeseWerte</c>).</summary>
    [Parameter] public Func<int, Task<double[]>>? Werte { get; set; }

    /// <summary>Der Dateiwähler der Plattform; ohne ihn kein „Lastgang aus Datei…".</summary>
    [Parameter] public Func<string, Task<string?>>? DateiWaehlen { get; set; }

    /// <summary>Fährt die Importkette OHNE Ablage (<c>GanglinienImportAblauf.OhneAblage</c>).</summary>
    [Parameter] public Func<string, GanglinienImportRueckrufe,
                            Task<GanglinienImportErgebnis>>? Einlesen { get; set; }

    /// <summary>Neuzerlegung mit den gewählten Optionen (für den Optionendialog).</summary>
    [Parameter] public Func<string, GanglinienImportOptionen, Task<GanglinienVorschau>>? Vorschau { get; set; }

    /// <summary>Der Rechenlauf; die Hülle legt ihn auf <c>Task.Run</c>.</summary>
    [Parameter] public Func<double[], PeakShavingEingaben, Task<PeakShavingErgebnis>>? Rechnen { get; set; }

    /// <summary>Die Suche nach der kleinsten haltbaren Schwelle; ebenfalls nebenher.</summary>
    [Parameter] public Func<double[], PeakShavingEingaben, Task<double>>? MinimaleSchwelle { get; set; }

    /// <summary>Das Zeichenmodell des Vorher/Nachher-Bildes (<c>PeakShavingBild.Modell</c>).</summary>
    [Parameter] public Func<PeakShavingErgebnis, bool, Zeichenmodell?>? Modell { get; set; }

    /// <summary>Schreibt die fünf Spalten als CSV; ohne Delegat kein Knopf.</summary>
    [Parameter] public Func<PeakShavingErgebnis, Task<bool>>? CsvSpeichern { get; set; }

    /// <summary>
    /// Schreibt Zielschwelle und Adaptiv-Flag in die AKTIVE Speichervariante (LS-E-1 (a));
    /// ohne Delegat — etwa ohne Projekt — gibt es den Knopf nicht.
    /// </summary>
    [Parameter] public Func<double, bool, Task<bool>>? VarianteUebernehmen { get; set; }

    /// <summary>Die Berechnungsart der aktiven Variante; <c>null</c> = keine aktive Variante.</summary>
    [Parameter] public Func<Task<string?>>? VariantenBerechnungsart { get; set; }

    /// <summary>Der Dialog ist zu Ende — immer <c>false</c> (Befund W12-B24, wörtlich).</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // =====================================================================
    // Texte
    // =====================================================================

    [Parameter] public string TitelText { get; set; } = Resource.PEAK_TITEL;
    [Parameter] public string HinweisText { get; set; } = Resource.PEAK_HINWEIS;
    [Parameter] public string DateiText { get; set; } = Resource.PEAK_BTN_DATEI;
    [Parameter] public string Dateifilter { get; set; } = Resource.IMPORT_DATEIFILTER;
    [Parameter] public string DateiLastgangText { get; set; } = Resource.PEAK_BTN_DATEI_LASTGANG;
    [Parameter] public string TitelDatei { get; set; } = Resource.PEAK_TITEL_DATEI;
    [Parameter] public string HinweisDatei { get; set; } = Resource.PEAK_HINWEIS_DATEI;
    [Parameter] public string AbbrechenText { get; set; } = Resource.ALLG_BTN_ABBRECHEN;

    [Parameter] public string GruppeSpeicher { get; set; } = Resource.PEAK_SB_SPEICHER;
    [Parameter] public string GruppeSchwelle { get; set; } = Resource.PEAK_SB_SCHWELLE;
    [Parameter] public string GruppeKosten { get; set; } = Resource.ADM_SB_KOSTEN;
    [Parameter] public string GruppeErgebnis { get; set; } = Resource.PEAK_SB_ERGEBNIS;

    [Parameter] public string LabelP { get; set; } = Resource.PEAK_LBL_P;
    [Parameter] public string LabelKapazitaet { get; set; } = Resource.PEAK_LBL_KAPAZITAET;
    [Parameter] public string LabelEta { get; set; } = Resource.PEAK_LBL_ETA;
    [Parameter] public string LabelSoCMin { get; set; } = Resource.PEAK_LBL_SOCMIN;
    [Parameter] public string LabelSoCMax { get; set; } = Resource.PEAK_LBL_SOCMAX;
    [Parameter] public string LabelStartSoC { get; set; } = Resource.PEAK_LBL_STARTSOC;
    [Parameter] public string LabelZiel { get; set; } = Resource.PEAK_LBL_ZIEL;
    [Parameter] public string LabelLp { get; set; } = Resource.PEAK_LBL_LP;
    [Parameter] public string LabelBezugspreis { get; set; } = Resource.PEAK_LBL_BEZUGSPREIS;
    [Parameter] public string LabelCCap { get; set; } = Resource.PEAK_LBL_CCAP;
    [Parameter] public string LabelCPow { get; set; } = Resource.PEAK_LBL_CPOW;
    [Parameter] public string LabelIFix { get; set; } = Resource.PEAK_LBL_IFIX;
