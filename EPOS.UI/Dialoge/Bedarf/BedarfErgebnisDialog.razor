@* Simulation Ergebnisse - Strom- und Waermebedarf (iU9-W8.2).

   VORBILD. DREI Masken mit demselben Aufbau: Views/Stromverbraucher/
   Form_ErgStromverbraucher (169 Z.), Views/Prozesswaerme/Form_ErgProzesswaerme
   (215 Z.) und Views/Brauchwasser/Form_ErgBrauchwasserwaerme (425 Z.). Alle
   drei heissen "Simulation Ergebnisse", alle drei haben dieselben drei Reiter -
   Kennzahlen, Monatswerte, Grafik - und alle drei sind reine ANZEIGEN. Sie
   unterscheiden sich in dem, WAS sie zeigen: vier Kennzahlen und eine
   Monatsreihe beim Strom, sieben Kennzahlen und zwei bzw. drei Reihen bei der
   Waerme.

   REINE ANZEIGE, also ein eingefrorenes Datenobjekt. Die Vorlaeufer bekamen das
   LEBENDE Simulationsobjekt und lasen bei jedem Optionswechsel neu daraus. Hier
   baut die Huelle BedarfErgebnisDaten und rendert die Bilder vorab; die
   Komponente kennt SimulationStrombedarf und SimulationWaermebedarf nicht.

   ZWEI UNABHAENGIGE OPTIONSGRUPPEN, wie im Vorlaeufer: eine fuer die Tabelle
   (radioBtn_Prozesse/Gebaeude/Brauchwasser) und eine fuer das Bild
   (radioBtn_Grafik*). Sie sind bewusst NICHT gekoppelt - wer die Zahlen der
   Prozesse liest und daneben das Gebaeudebild sehen will, kann das.

   DER STARTREITER WAEHLT BEIM BRAUCHWASSER ZUGLEICH DIE SICHT. SetPage:421 der
   Brauchwassermaske setzt nicht nur den Reiter, sondern auch beide
   Optionsgruppen: 0 -> Prozesse, 1 -> Gebaeude, 2 -> Brauchwasser. Genau
   deshalb landet der Weg "Berechnen" dort auf der Brauchwassersicht.

   EINE EINHEIT FUER ALLE DREI REITER (Anwenderentscheid W8-O-5 vom 04.09.2026):
   MWh als Vorgabe, kWh waehlbar. Das Wahlfeld steht ueber der Reiterleiste, weil
   Kennzahlen, Monatstabelle und Saeulenbild gemeinsam folgen. Umgerechnet wird
   nur, was die Huelle als ZAHL samt Quelleneinheit mitgibt - die beiden
   Leistungen in kW und die Ganglinie bleiben unberuehrt. Das Saeulenbild
   kommt in zwei Fassungen herein; auch ein Zeichenmodell traegt seine Achsen- und
   Zeigetexte fertig formatiert, laesst sich also nicht umrechnen, und die
   Komponente ruft keinen Renderer.

   DER GRAFIKREITER WIE DIE JAHRESGANGLINIEN DER SIMULATION (Anwenderwunsch WG,
   10.10.2026): oben EINE waagerechte Zeile mit zwei Knopfgruppen - Bedarfsart
   (Mehrfachwahl, nur bei mehr als einer Sicht) und Zeitraster Jahr | Monat |
   Woche | Tag -, darunter das Bild. "Jahr" ist die Ganglinie ueber alle
   Stuetzstellen mit Zoomleiste, eine Linie je Bedarfsart; Monat, Woche und Tag
   sind die Summen als gestapelte Saeulen (12, 52, 365; der 365. Tag gehoert zur
   52. Woche) in der gewaehlten Einheit. Jedes Bild traegt "CSV...": die Ganglinie
   ueber den Ganglinienexport der Kaskade, die Saeulen ueber den eigenen Export
   mit den Summenspalten der Huelle. Bilder und Summen kommen auf Zuruf aus der
   Huelle (Bedarfsgrafikquelle); die Komponente haelt sie nur zwischen.

   DREI KATEGORIEN STATT EINER LISTE (Anwenderwunsch W8-E-2, Windows-Abnahme
   05.09.2026). Der Bestand reihte alle Kennzahlen untereinander - eine LEISTUNG
   in kW zwischen Energiemengen in MWh, und die Summe mittendrin. Der Anwender
   hat beides beanstandet. Das Blatt hat jetzt einen Block je Kategorie mit
   Zwischenueberschrift und die Summe ABGESETZT im tfoot. Wer keine Kategorien
   mitgibt, bekommt weiter die schlichte Liste - Vorgabe ist Kennzahlart.Energie.

   TASTATUR: Esc und Enter schliessen - der Dialog hat nur den einen Knopf. *@

@namespace EPOS.UI.Dialoge.Bedarf
@using WindowsFormsApplication1
@using WindowsFormsApplication1.Zeichnung
@inherits Farbwahlwirt
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: eingebettet in einer betitelten Ueberlagerung traegt
       DIE den Titel; der Wirt setzt dort TitelAnzeigen="false" - dann bleiben Titel
       und Kreuz hier aus. TitelText bleibt dabei gesetzt: Er speist den berechneten
       Titel samt Zusatz und beschriftet auch das Reiterblatt - Bauart b der
       Hausregel. *@
    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Schliessen" />
        }
    </div>

    @* Die Einheit gilt fuer ALLE drei Reiter - Kennzahlen, Monatstabelle und
       Saeulenbild - und steht deshalb ueber der Reiterleiste. Sie erscheint nur,
       wenn die Huelle Zahlen samt Quelleneinheit mitgegeben hat. *@
    @if (EinheitWaehlbar)
    {
        <Auswahlfeld Bezeichnung="@LabelEinheit" Eintraege="@Einheitenwahl"
                     Auswahl="@EinheitIndex" AuswahlChanged="EinheitWaehlen" />
    }

    <Reiter @bind-Aktiv="_reiter" Bezeichnung="@TitelText">
        <KindInhalt>

            @* --- Reiter 1: die Kennzahlen ------------------------------------ *@
            <Reiterblatt Schluessel="KENNZAHLEN" Titel="@ReiterKennzahlen">
                <KindInhalt>
                    <div class="epos-raster-huelle">
                        <table class="epos-raster epos-kennzahlen">

                            @* Die LEISTUNG steht fuer sich (W8-E-2): eine Groesse in kW
                               gehoert nicht zwischen Energiemengen in MWh, und schon gar
                               nicht in deren Summe. Der Block entfaellt, wenn es keine
                               Leistungszeile gibt. *@
                            @if (Leistungen.Count > 0)
                            {
                                <tbody class="epos-kennzahlen-block">
                                    <tr class="epos-kennzahlen-kopf">
                                        <th colspan="3" scope="colgroup">@GruppeLeistung</th>
                                    </tr>
                                    @foreach (ErgebnisKennzahl kennzahl in Leistungen)
                                    {
                                        ErgebnisKennzahl k = kennzahl;
                                        <tr>
                                            <td>@k.Bezeichnung</td>
                                            <td class="epos-zahl">@Kennzahlwert(k)</td>
                                            <td class="epos-einheit">@Kennzahleinheit(k)</td>
                                        </tr>
                                    }
                                </tbody>
                            }

                            <tbody class="epos-kennzahlen-block">
                                @if (Leistungen.Count > 0)
                                {
                                    <tr class="epos-kennzahlen-kopf">
                                        <th colspan="3" scope="colgroup">@GruppeEnergie</th>
                                    </tr>
                                }
                                @foreach (ErgebnisKennzahl kennzahl in Posten)
                                {
                                    ErgebnisKennzahl k = kennzahl;
                                    <tr>
                                        <td>@k.Bezeichnung</td>
                                        <td class="epos-zahl">@Kennzahlwert(k)</td>
                                        <td class="epos-einheit">@Kennzahleinheit(k)</td>
                                    </tr>
                                }
                            </tbody>

                            @* Die SUMME steht UNTEN und abgesetzt (W8-E-2) - im tfoot,
                               damit sie auch fuer die Sprachausgabe der Fuss der Tabelle
                               ist und nicht die letzte Zeile unter vielen. *@
                            @if (Summen.Count > 0)
                            {
                                <tfoot class="epos-kennzahlen-summe">
                                    @foreach (ErgebnisKennzahl kennzahl in Summen)
                                    {
                                        ErgebnisKennzahl k = kennzahl;
                                        <tr>
                                            <th scope="row">@k.Bezeichnung</th>
                                            <td class="epos-zahl">@Kennzahlwert(k)</td>
                                            <td class="epos-einheit">@Kennzahleinheit(k)</td>
                                        </tr>
                                    }
                                </tfoot>
                            }

                        </table>
                    </div>
                </KindInhalt>
            </Reiterblatt>

            @* --- Reiter 2: die Monatswerte ----------------------------------- *@
            <Reiterblatt Schluessel="MONATE" Titel="@ReiterMonate">
                <KindInhalt>
                    @if (Daten.Sichten.Count > 1)
                    {
                        <Optionsgruppe Eintraege="@Sichtwahl" Auswahl="@_sichtTabelle"
                                       AuswahlChanged="TabellensichtWaehlen" />
                    }

                    <Gruppenkopf Titel="@GruppeMonate">
                        <KindInhalt>
                            <div class="epos-raster-huelle">
                                <table class="epos-raster">
                                    <tbody>
                                        @for (int m = 0; m < 12; m++)
                                        {
                                            int monat = m;
                                            <tr>
                                                <td>@Monatsname(monat)</td>
                                                <td class="epos-zahl">@Monatswert(monat)</td>
                                                <td>@MonatEinheit</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </KindInhalt>
                    </Gruppenkopf>
                </KindInhalt>
            </Reiterblatt>

            @* --- Reiter 3: das Bild ------------------------------------------ *@
            <Reiterblatt Schluessel="GRAFIK" Titel="@ReiterGrafik">
                <KindInhalt>
                    <div class="epos-bedarfgrafik">
                        @* EINE Zeile, zwei Knopfgruppen (Schaltknoepfe mit aria-pressed wie
                           die Kalenderbedienung); auf schmalem Schirm bricht die zweite Gruppe
                           darunter. *@
                        <div class="epos-bedarfgrafik-leiste">
                            @if (Daten.Sichten.Count > 1)
                            {
                                <div class="epos-bedarfgrafik-gruppe epos-bedarfgrafik-reihen" role="group"
                                     aria-label="@GruppeReihenText">
                                    @for (int i = 0; i < Daten.Sichten.Count; i++)
                                    {
                                        int nr = i;
                                        bool an = _reihen.Contains(nr);
                                        <button type="button" data-sicht="@nr"
                                                class="epos-knopf epos-bedarfgrafik-knopf @(an ? "epos-knopf--gewaehlt" : "")"
                                                aria-pressed="@(an ? "true" : "false")"
                                                @onclick="() => ReiheUmschalten(nr)">@Daten.Sichten[nr].Bezeichnung</button>
                                    }
                                </div>
                            }
                            @if (Daten.Grafik is not null)
                            {
                                <div class="epos-bedarfgrafik-gruppe epos-bedarfgrafik-raster" role="group"
                                     aria-label="@GruppeRasterText">
                                    @foreach ((Bedarfsraster raster, string text) in Rasterwahl)
                                    {
                                        Bedarfsraster rr = raster;
                                        bool an = _raster == rr;
                                        <button type="button" data-raster="@rr"
                                                class="epos-knopf epos-bedarfgrafik-knopf @(an ? "epos-knopf--gewaehlt" : "")"
                                                aria-pressed="@(an ? "true" : "false")"
                                                @onclick="() => RasterWaehlen(rr)">@text</button>
                                    }
                                </div>
                            }
                            @* Die Saeulen haben keine Zeitachse und damit keine Zoomleiste, in der
                               "CSV..." stuende; ihr Knopf steht deshalb am Ende dieser Zeile, in
                               derselben Knopfart wie an der Ganglinie. *@
                            @if (SummenCsvDa)
                            {
                                <button type="button" class="epos-diagramm-knopf epos-diagramm-csv epos-bedarfgrafik-csv"
                                        title="@CsvSummenHilfe" aria-label="@CsvSummenHilfe"
                                        @onclick="SummenSpeichern">@Resource.DIAGRAMM_BTN_CSV</button>
                            }
                        </div>

                        @if (Daten.Grafik is not null)
                        {
                            @* Die Ganglinie traegt eine Zeitachse: Zoom und "CSV..." ueber den
                               Ganglinienexport der Kaskade. Die Kennung wechselt mit dem
                               Raster - ein Bild je Blatt. *@
                            <CascadingValue Value="@Exportnaht">
                                <DiagrammSvg Modell="@Grafikmodell" Kennung="@Grafikkennung"
                                             Bezeichnung="@Grafiktitel" Einheit="@Grafikeinheit"
                                             PlatzhalterText="@PlatzhalterBild"
                                             Palette="@Farbpalette.Aktuell"
                                             FarbwahlErlaubt="@(FarbeSetzen is not null)"
                                             FarbeGewaehlt="FarbeUebernehmen"
                                             FarbeZurueckgesetzt="FarbeVerwerfen" />
                            </CascadingValue>
                        }
                        else
                        {
                            @* Ohne Stundenreihen bleiben die Monatssaeulen der ersten gewaehlten
                               Sicht - fertige Bilder der Huelle, eines je Einheit. *@
                            <DiagrammSvg Modell="@Monatsmodell" Kennung="bedarf-monate"
                                         Bezeichnung="@Bildtext"
                                         PlatzhalterText="@PlatzhalterBild" />
                        }
                    </div>
                </KindInhalt>
            </Reiterblatt>

        </KindInhalt>
    </Reiter>

    <SpeichernLeiste OkText="@OkText" MitAbbrechen="false" Ergebnis="BeiErgebnis" />
</div>

@code {
    /// <summary>Der eingefrorene Auszug des Rechenobjekts; die Hülle baut ihn.</summary>
    [Parameter] public BedarfErgebnisDaten Daten { get; set; } = new();

    /// <summary>
    /// Die ANZEIGEEINHEIT beim Öffnen — MWh (Vorgabe) oder kWh (Anwenderentscheid
    /// W8‑O‑5 vom 04.09.2026). Die Hülle holt sie aus <c>BedarfEinheitWahl</c>, damit
    /// dieser Dialog dieselbe zeigt wie der Bedarfsprofildialog, aus dem er kommt.
    /// </summary>
    [Parameter] public Energieeinheit Einheit { get; set; } = Energieeinheit.MWh;

    /// <summary>Meldet der Hülle die neu gewählte Einheit, damit sie gemerkt wird.</summary>
    [Parameter] public Action<Energieeinheit>? EinheitGewaehlt { get; set; }

    /// <summary>Der Dialog wurde geschlossen — immer mit <c>true</c>, er hat nur OK.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Simulation Ergebnisse";

    /// <summary>
    /// Zeigt der Dialog seinen eigenen Kopf — Titel UND Schließkreuz? Hausregel
    /// „Das Kreuz steht beim Titel": Trägt die umschließende <c>Ueberlagerung</c> den
    /// Titel, trägt sie auch das Kreuz; dann steht hier <c>false</c>. <see cref="TitelText"/>
    /// bleibt dabei gesetzt, denn es hat im Rumpf noch eine zweite Aufgabe.
    /// </summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

    [Parameter] public string ReiterKennzahlen { get; set; } = "Wärmebedarf Ergebnisse";
    [Parameter] public string ReiterMonate { get; set; } = "Übersicht monatlich";
    [Parameter] public string ReiterGrafik { get; set; } = "Grafik";
    [Parameter] public string GruppeMonate { get; set; } = "monatlicher Verlauf:";
    /// <summary>
    /// Die Einheit der Monatstabelle, wenn die Sicht KEINE Zahlen mitbringt. Sonst
    /// steht dort die gewählte Einheit.
    /// </summary>
    [Parameter] public string EinheitMonat { get; set; } = "MWh";

    /// <summary>Beschriftung des Wahlfeldes über der Reiterleiste.</summary>
    [Parameter] public string LabelEinheit { get; set; } = "Einheit:";

    [Parameter] public string PlatzhalterBild { get; set; } = "Kein Diagramm vorhanden";
    [Parameter] public string OkText { get; set; } = "OK";

    /// <summary>Überschrift des Leistungsblocks (W8‑E‑2) — Ressource BERG_GRP_LEISTUNG.</summary>
    [Parameter] public string GruppeLeistung { get; set; } = "Leistung";

    /// <summary>Überschrift des Energieblocks (W8‑E‑2) — Ressource BERG_GRP_ENERGIE.</summary>
    [Parameter] public string GruppeEnergie { get; set; } = "Energie";

    /// <summary>Knopf „Jahr“ des Zeitrasters — Ressource BERG_STUFE_JAHR.</summary>
    [Parameter] public string RasterJahrText { get; set; } = "Jahr";

    /// <summary>Knopf „Monat“ des Zeitrasters — Ressource BED_GRAFIK_RASTER_MONAT.</summary>
    [Parameter] public string RasterMonatText { get; set; } = "Monat";

    /// <summary>Knopf „Woche“ des Zeitrasters — Ressource BERG_STUFE_WOCHE.</summary>
    [Parameter] public string RasterWocheText { get; set; } = "Woche";

    /// <summary>Knopf „Tag“ des Zeitrasters — Ressource BERG_STUFE_TAG.</summary>
    [Parameter] public string RasterTagText { get; set; } = "Tag";

    /// <summary>Name der Knopfgruppe der Bedarfsarten — Ressource BED_GRAFIK_GRP_REIHEN.</summary>
    [Parameter] public string GruppeReihenText { get; set; } = "Bedarfsart";

    /// <summary>Name der Knopfgruppe des Zeitrasters — Ressource BED_GRAFIK_GRP_RASTER.</summary>
    [Parameter] public string GruppeRasterText { get; set; } = "Zeitraster";

    /// <summary>
    /// Der CSV-Weg der Plattform: Bildtitel und Spalten; ohne Delegat kein Knopf „CSV…“.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<ZeitreihenSpalte>, Task>? CsvSpeichern { get; set; }

    /// <summary>Kurztext am „CSV…“ der Säulen — Ressource BED_GRAFIK_TIP_CSV.</summary>
    [Parameter] public string CsvSummenHilfe { get; set; } = "Summen als CSV speichern";

    /// <summary>Die zwölf Monatsbeschriftungen der Tabelle.</summary>
    [Parameter]
    public IReadOnlyList<string> Monatsnamen { get; set; } = new[]
    {
        "Januar:", "Februar:", "März:", "April:", "Mai:", "Juni:",
        "Juli:", "August:", "September:", "Oktober:", "November:", "Dezember:"
    };

    /// <summary>Was statt eines fehlenden Wertes steht.</summary>
    [Parameter] public string LeerText { get; set; } = "—";

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_ErgProzesswaerme.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private string _reiter = "";
    private int _sichtTabelle;

    /// <summary>Die gewählten Bedarfsarten des Grafikreiters (Indizes der Sichten), nie leer.</summary>
    private readonly SortedSet<int> _reihen = new();

    /// <summary>Das gewählte Zeitraster — „Jahr“ beim Öffnen, wie die Jahresganglinien der Simulation.</summary>
    private Bedarfsraster _raster = Bedarfsraster.Jahr;

    /// <summary>Die gewählte Anzeigeeinheit; beim Aufbau <see cref="Einheit"/>.</summary>
    private Energieeinheit _einheit = Energieeinheit.MWh;

    /// <summary>Der Fenstertitel samt Zusatz („ - ‹Name›" des Brauchwasserwegs).</summary>
    public string Titel => string.IsNullOrEmpty(Daten.TitelZusatz)
        ? TitelText : TitelText + " - " + Daten.TitelZusatz;

    /// <summary>Der sichtbare Reiter — Prüfhilfe für die Tests.</summary>
    public string Reiterblattschluessel => _reiter;

    /// <summary>Die gewählte Tabellensicht — Prüfhilfe für die Tests.</summary>
    public int Tabellensicht => _sichtTabelle;

    /// <summary>Die erste gewählte Bedarfsart des Grafikreiters — Prüfhilfe für Tests und Assistent.</summary>
    public int Grafiksicht => _reihen.Count > 0 ? _reihen.Min : 0;

    /// <summary>Alle gewählten Bedarfsarten des Grafikreiters, aufsteigend — Prüfhilfe für die Tests.</summary>
    public IReadOnlyList<int> Grafikreihen => _reihen.ToList();

    /// <summary>Das gewählte Zeitraster — Prüfhilfe für die Tests.</summary>
    public Bedarfsraster Raster => _raster;

    /// <summary>Die gewählte Anzeigeeinheit — Prüfhilfe für die Tests.</summary>
    public Energieeinheit Anzeigeeinheit => _einheit;

    // --- Die drei Kennzahlblöcke (Anwenderwunsch W8‑E‑2) ------------------------
    //
    // Der Bestand reihte alles untereinander. Der Anwender will die LEISTUNG als
    // eigene Kategorie und die SUMME abgesetzt am Ende. Sortiert wird hier nicht:
    // Die Reihenfolge innerhalb eines Blocks bleibt die der Hülle.

    /// <summary>Die Leistungszeilen (kW) — eigener Block, außerhalb der Summe.</summary>
    public IReadOnlyList<ErgebnisKennzahl> Leistungen => Block(Kennzahlart.Leistung);

    /// <summary>Die Posten der Energiebilanz.</summary>
    public IReadOnlyList<ErgebnisKennzahl> Posten => Block(Kennzahlart.Energie);

    /// <summary>Die Summenzeile(n) am Fuß des Blattes.</summary>
    public IReadOnlyList<ErgebnisKennzahl> Summen => Block(Kennzahlart.Summe);

    private List<ErgebnisKennzahl> Block(Kennzahlart art)
    {
        var liste = new List<ErgebnisKennzahl>();
        foreach (ErgebnisKennzahl k in Daten.Kennzahlen) if (k.Art == art) liste.Add(k);
        return liste;
    }

    /// <summary>
    /// Gibt es überhaupt etwas umzurechnen? Nur wenn die Hülle Zahlen samt
    /// Quelleneinheit mitgegeben hat, erscheint das Wahlfeld — ein Datensatz aus
    /// fertigen Texten bleibt so, wie er ist.
    /// </summary>
    private bool EinheitWaehlbar
        => Daten.Kennzahlen.Any(k => k.Energie is not null && k.QuelleEinheit is not null)
           || Daten.Sichten.Any(s => s.Zahlen is not null && s.QuelleEinheit is not null);

    /// <summary>Die beiden Einheiten als Auswahlliste — MWh zuerst.</summary>
    private IReadOnlyList<(int Id, string Text)> Einheitenwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                liste.Add((i, Energieeinheit.Alle[i].Text));
            return liste;
        }
    }

    private int EinheitIndex
    {
        get
        {
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                if (ReferenceEquals(Energieeinheit.Alle[i], _einheit)) return i;
            return 0;
        }
    }

    private void EinheitWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n >= Energieeinheit.Alle.Count) return;

        Energieeinheit neu = Energieeinheit.Alle[n];
        if (ReferenceEquals(neu, _einheit)) return;

        _einheit = neu;
        EinheitGewaehlt?.Invoke(neu);
    }

    /// <summary>Die Einheit der Monatstabelle und des Säulenbildes.</summary>
    private string MonatEinheit
    {
        get
        {
            Monatssicht? sicht = AktuelleTabellensicht;
            return (sicht?.Zahlen is not null && sicht.QuelleEinheit is not null)
                ? _einheit.Text : EinheitMonat;
        }
    }

    private Monatssicht? AktuelleTabellensicht
        => (_sichtTabelle >= 0 && _sichtTabelle < Daten.Sichten.Count)
            ? Daten.Sichten[_sichtTabelle] : null;

    private static readonly string[] REITER = { "KENNZAHLEN", "MONATE", "GRAFIK" };

    /// <summary>Die Optionsknöpfe beider Gruppen — dieselbe Beschriftungsfolge.</summary>
    private IReadOnlyList<(int Id, string Text)> Sichtwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < Daten.Sichten.Count; i++) liste.Add((i, Daten.Sichten[i].Bezeichnung));
            return liste;
        }
    }

    private IEnumerable<(Bedarfsraster, string)> Rasterwahl => new[]
    {
        (Bedarfsraster.Jahr, RasterJahrText),
        (Bedarfsraster.Monat, RasterMonatText),
        (Bedarfsraster.Woche, RasterWocheText),
        (Bedarfsraster.Tag, RasterTagText)
    };

    /// <summary>
    /// Die Bilder des Grafikreiters, je Wahl, Raster und Einheit EINMAL von der Hülle geholt —
    /// <c>DiagrammSvg</c> baut seinen Knotenbaum nur neu, wenn die Modellreferenz wechselt, und
    /// behält so Zoom und Zeigerstelle über jeden Zeichenlauf des Dialogs.
    /// </summary>
    private readonly Dictionary<string, Zeichenmodell?> _bilder = new(StringComparer.Ordinal);

    /// <summary>Die Quelle, zu der der Bildvorrat gehört.</summary>
    private Bedarfsgrafikquelle? _bildquelle;

    /// <summary>Die Einheit der Summen; die Ganglinie ist eine Leistung und folgt ihr nicht.</summary>
    private Energieeinheit Grafikeinheitwahl => _raster == Bedarfsraster.Jahr ? Energieeinheit.Vorgabe : _einheit;

    private string Bildschluessel
        => string.Join(",", _reihen) + "|" + (int)_raster + "|" + Grafikeinheitwahl.Text;

    private Zeichenmodell? Grafikmodell
    {
        get
        {
            Bedarfsgrafikquelle? quelle = Daten.Grafik;
            if (quelle?.Modell is null) return null;
            if (!ReferenceEquals(quelle, _bildquelle))
            {
                _bildquelle = quelle;
                _bilder.Clear();
            }
            string schluessel = Bildschluessel;
            if (_bilder.TryGetValue(schluessel, out Zeichenmodell? vorhanden)) return vorhanden;
            Zeichenmodell? neu = quelle.Modell(_reihen.ToList(), _raster, Grafikeinheitwahl);
            _bilder[schluessel] = neu;
            return neu;
        }
    }

    /// <summary>Die Kennung des Bildes: eine je Raster (sie bildet die clipPath-Namen).</summary>
    private string Grafikkennung => "bedarf-grafik-" + _raster.ToString().ToLowerInvariant();

    /// <summary>Die Einheit am Zeiger: kW an der Ganglinie, die gewählte Energieeinheit an den Säulen.</summary>
    private string Grafikeinheit => _raster == Bedarfsraster.Jahr ? "kW" : _einheit.Text;

    /// <summary>Titel des gezeigten Bildes — Dateistamm des CSV-Exports.</summary>
    private string Grafiktitel => Daten.Grafik?.Titel?.Invoke(_reihen.ToList(), _raster) ?? Bildtext;

    private Ganglinienexport? _exportnaht;

    /// <summary>
    /// Der Ganglinienexport der Kaskade — wie auf der Ergebnisseite: die Reihen, die das Bild zeigt,
    /// über den Kern (<c>ZeitreihenCsv.AusModell</c>). Ohne Delegat kein Knopf.
    /// </summary>
    private Ganglinienexport? Exportnaht => CsvSpeichern is null ? null
        : _exportnaht ??= new Ganglinienexport((m, t) => CsvSpeichern(t, ZeitreihenCsv.AusModell(m)));

    /// <summary>
    /// Steht der eigene „CSV…“ der Säulen? Nur bei Monat, Woche und Tag — an der Ganglinie trägt
    /// ihn die Zoomleiste über den Ganglinienexport —, und nur mit Naht und Spalten.
    /// </summary>
    private bool SummenCsvDa => _raster != Bedarfsraster.Jahr && CsvSpeichern is not null
                                && Daten.Grafik?.Spalten is not null;

    /// <summary>Die Summenspalten der Hülle (12, 52 oder 365 Zeilen) an die Naht der Plattform.</summary>
    private Task SummenSpeichern()
    {
        if (CsvSpeichern is null || Daten.Grafik?.Spalten is null) return Task.CompletedTask;
        IReadOnlyList<ZeitreihenSpalte> spalten = Daten.Grafik.Spalten(_reihen.ToList(), _raster, _einheit);
        return CsvSpeichern(Grafiktitel, spalten);
    }

    /// <summary>Eine Bedarfsart an- oder abwählen; die letzte gewählte bleibt stehen.</summary>
    private void ReiheUmschalten(int nr)
    {
        if (nr < 0 || nr >= Daten.Sichten.Count) return;
        if (_reihen.Contains(nr))
        {
            if (_reihen.Count > 1) _reihen.Remove(nr);
        }
        else _reihen.Add(nr);
    }

    private void RasterWaehlen(Bedarfsraster raster) => _raster = raster;

    /// <summary>
    /// Die MONATSSÄULEN der gewählten Sicht als Zeichenmodell (Etappe DG-E3,
    /// Gruppe (c)).
    ///
    /// <para>Es gibt sie in zwei Fassungen, eine je Einheit: Auch ein Zeichenmodell
    /// trägt die fertigen Achsen- und Zeigetexte, lässt sich also nicht umrechnen, und
    /// die Komponente ruft keinen Renderer. <b>Beide liegen fertig im Datensatz</b> —
    /// diese Eigenschaft WÄHLT nur aus, sie baut nicht: Ein Modell, das je Zeichenlauf
    /// neu entstünde, verwürfe im Baustein mit dem Knotenbaum auch die Zeigerstelle.
    /// Der Sicht- oder Einheitenwechsel IST der Modellwechsel, und er soll den Baum
    /// neu bauen.</para>
    ///
    /// <para>Es steht nur, wenn die Hülle keine <see cref="BedarfErgebnisDaten.Grafik"/>
    /// mitgibt; sonst kommen alle Bilder des Reiters aus ihr.</para>
    /// </summary>
    private Zeichenmodell? Monatsmodell
    {
        get
        {
            int nr = Grafiksicht;
            if (nr < 0 || nr >= Daten.Sichten.Count) return null;

            Monatssicht sicht = Daten.Sichten[nr];
            return (ReferenceEquals(_einheit, Energieeinheit.KWh) && sicht.ModellKWh is not null)
                ? sicht.ModellKWh : sicht.Modell;
        }
    }

    private string Bildtext
        => (Grafiksicht >= 0 && Grafiksicht < Daten.Sichten.Count)
            ? Daten.Sichten[Grafiksicht].Bezeichnung : "";

    protected override void OnInitialized()
    {
        _einheit = Einheit ?? Energieeinheit.Vorgabe;

        int start = Daten.StartReiter;
        if (start < 0 || start >= REITER.Length) start = 0;
        _reiter = REITER[start];

        // SetPage:421 der Brauchwassermaske setzt mit dem Reiter zugleich beide
        // Optionsgruppen; die beiden anderen Masken beginnen immer bei der ersten Sicht
        // (Init:27: radioBtn_Prozesse.Checked = true).
        int grafik = 0;
        if (Daten.MitBrauchwasser && start < Daten.Sichten.Count)
        {
            _sichtTabelle = start;
            grafik = start;
        }
        // Liegt zur Startsicht keine Stundenreihe vor, beginnt die Grafik bei der ersten mit Reihe.
        IReadOnlyList<int>? mit = Daten.Grafik?.MitReihe;
        if (mit is { Count: > 0 } && !mit.Contains(grafik)) grafik = mit[0];
        _reihen.Add(grafik);

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.BEDARF_ERGEBNIS,
                                          () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent stellt die Anzeige (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private BedarfErgebnisKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten auf die vier Schalter der Maske. Setzen nimmt
    /// denselben Weg wie die Hand; die Grafiksicht wählt genau eine Bedarfsart, der
    /// „Jahresverlauf“ ist das Zeitraster Jahr.
    /// </summary>
    private BedarfErgebnisKiSicht KiSicht()
    {
        return _kiSicht ??= new BedarfErgebnisKiSicht
        {
            EinheitLesen = () => EinheitIndex,
            EinheitSetzen = EinheitWaehlen,
            EinheitEintraege = () => KiMaskenanmeldung.Eintraege(
                Einheitenwahl, e => e.Id, e => e.Text),

            TabellensichtLesen = () => _sichtTabelle,
            TabellensichtSetzen = TabellensichtWaehlen,
            GrafiksichtLesen = () => Grafiksicht,
            GrafiksichtSetzen = GrafiksichtWaehlen,
            SichtEintraege = () => KiMaskenanmeldung.Eintraege(
                Sichtwahl, e => e.Id, e => e.Text),

            // „Jahresverlauf“ des Assistenten ist das Zeitraster Jahr; aus heißt Monat.
            JahresverlaufLesen = () => Daten.Grafik is not null && _raster == Bedarfsraster.Jahr,
            JahresverlaufSetzen = an => _raster = an ? Bedarfsraster.Jahr : Bedarfsraster.Monat
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Nur Auffrischen.</b> Diese Maske zeigt ein gerechnetes Ergebnis; nichts
    /// schreibt zurück, und einen Schreibschutz gibt es nicht.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    private void TabellensichtWaehlen(int? id) => _sichtTabelle = id ?? 0;

    /// <summary>Der Weg des Assistenten: genau diese eine Bedarfsart zeigen.</summary>
    private void GrafiksichtWaehlen(int? id)
    {
        int nr = id ?? 0;
        if (nr < 0 || nr >= Daten.Sichten.Count) return;
        _reihen.Clear();
        _reihen.Add(nr);
    }

    private string Anzeige(string? wert) => string.IsNullOrEmpty(wert) ? LeerText : wert;

    private string Monatsname(int m)
        => (Monatsnamen is not null && Monatsnamen.Count > m) ? Monatsnamen[m] : "";

    private string Monatswert(int m)
    {
        Monatssicht? sicht = AktuelleTabellensicht;
        if (sicht is null) return LeerText;

        if (sicht.Zahlen is not null && sicht.QuelleEinheit is not null && sicht.Zahlen.Count > m)
            return _einheit.Formatiere(_einheit.Aus(sicht.QuelleEinheit, sicht.Zahlen[m]));

        IReadOnlyList<string>? werte = sicht.Werte;
        return (werte is not null && werte.Count > m) ? Anzeige(werte[m]) : LeerText;
    }

    /// <summary>
    /// Der Wert einer Kennzahl. Eine Energiemenge folgt der Einheitenwahl, alles
    /// andere — die beiden Leistungen in kW — bleibt der fertige Text der Hülle.
    /// </summary>
    private string Kennzahlwert(ErgebnisKennzahl k)
        => (k.Energie is not null && k.QuelleEinheit is not null)
            ? _einheit.Formatiere(_einheit.Aus(k.QuelleEinheit, k.Energie.Value))
            : Anzeige(k.Wert);

    private string Kennzahleinheit(ErgebnisKennzahl k)
        => (k.Energie is not null && k.QuelleEinheit is not null) ? _einheit.Text : k.Einheit;

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Schließen — von Esc, Enter und dem Schliesskreuz gleichermaßen gerufen. Der
    /// Dialog zeigt nur an und trägt einen einzigen Knopf, deshalb immer <c>true</c>:
    /// Das Kreuz kopiert Esc, es erfindet keine neue Semantik.
    /// </summary>
    private Task Schliessen() => Geschlossen.InvokeAsync(true);

    /// <summary>
    /// Esc UND Enter schließen. Der Dialog zeigt nur an und trägt einen einzigen Knopf —
    /// hier kann Enter nichts versehentlich schreiben (Regel aus <c>EPOS.UI/CLAUDE.md</c>).
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
        => (e.Key == "Escape" || e.Key == "Enter") ? Schliessen() : Task.CompletedTask;
}
