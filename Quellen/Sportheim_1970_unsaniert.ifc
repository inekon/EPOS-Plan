#46618=IFCPROPERTYENUMERATEDVALUE('EcoIndexType','Kennung f\X\FCr den \X\D6ko-Index des Bauteils',(IFCLABEL('ecoNone')),$);
#46619=IFCPROPERTYENUMERATEDVALUE('ElementType','Kennung Elementtyp',(IFCLABEL('bctWindow')),$);
#46620=IFCPROPERTYENUMERATEDVALUE('EmbeddedSystemPositionType','Kennung f\X\FCr die Position von fl\X\E4chenintegrierten Systemen innerhalb des Geb\X\E4udeelementes Anhand der Eigenschaft wird festgelegt, ob ein fl\X\E4chenintegriertes System innerhalb des Geb\X\E4udebauteils installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein fl\X\E4chenintegriertes System vorgesehen ist. Wenn die Position des fl\X\E4chenintegrierten Systems noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
#46621=IFCPROPERTYENUMERATEDVALUE('Generator','Kennung f\X\FCr den Ersteller/Bearbeiter des Geb\X\E4udeelementes. Der Generator dient nur zur Information. Die Kennung darf nicht f\X\FCr die Identifizierung von Modellobjekten verwendet werden.',(IFCLABEL('mgt2D3D')),$);
#46622=IFCPROPERTYSINGLEVALUE('GUID','Bezeichner, der w\X\E4hrend der Lebenszeit des Modellobjektes erhalten bleibt. Der Bezeichner ist nicht eindeutig.',IFCLABEL('bdd34cf5-8b07-470e-9a0b-bdc6e2c87722'),$);
#46623=IFCPROPERTYSINGLEVALUE('ID','Kennung f\X\FCr das Modellobjekt. MUSS innerhalb des Projektes eindeutig sein.',IFCIDENTIFIER('-1'),$);
#46624=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('8156da84-ee7c-4eb4-9547-9e027f17c43a'),$);
#46625=IFCPROPERTYENUMERATEDVALUE('LoadBearingType','Kennung f\X\FCr die Tragf\X\E4higkeit des Bauteils',(IFCLABEL('elbNone')),$);
#46626=IFCPROPERTYSINGLEVALUE('Name','Name des Bauteils',IFCLABEL('F 038-1'),$);
#46627=IFCPROPERTYSINGLEVALUE('Number','Kurzbeschreibung des Objektes. (50 Zeichen)',IFCLABEL(''),$);
#46628=IFCPROPERTYSINGLEVALUE('Orientation (\X\B0)','Orientierung betogen auf das Bauteil',IFCLABEL('180'),$);
#46629=IFCPROPERTYENUMERATEDVALUE('Orientation.Type','Orientierung Type (Enum)',(IFCLABEL('botS')),$);
#46630=IFCPROPERTYENUMERATEDVALUE('RadiatorPositionType','Kennung f\X\FCr die Position des Heizk\X\F6rpers zum Geb\X\E4udeelement Anhand der Eigenschaft wird festgelegt, ob ein Heizk\X\F6rper an dem Geb\X\E4udebauteil installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein Heizk\X\F6rper vorgesehen ist. Wenn die Position des Heizk\X\F6rpers noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprOutsideBottomMiddle')),$);
