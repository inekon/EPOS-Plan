    /// <summary>Die Warnliste der aktuellen Vorschau; leer ohne.</summary>
    /// <summary>
    /// Die Warnliste der Bilanz — dazu die Hinweise des Vergleichs und der Kalibrierung (Stufe Z5).
    /// Sie stehen in DERSELBEN Liste: Ein Anwender sucht seine Hinweise an einer Stelle, nicht an
    /// drei. Die Reihenfolge ist stabil (Bilanz, Vergleich, Kalibrierung, Kalibriervorschlag).
    /// </summary>
    private IReadOnlyList<ZapfprofilWarnDaten> Warnliste
    {
        get
        {
            var liste = new List<ZapfprofilWarnDaten>();
            // ZB2: Die Hinweise einer unvollstaendigen Zone stehen nicht in der Bilanz — ihr Block nennt den naechsten Schritt.
            if (_vorschau is { Zustand: ZapfprofilVorschauZustand.Gerechnet } v)
            {
                IReadOnlyDictionary<int, ZapfprofilMeldung> unvollstaendig = Unvollstaendige;
                // ZB8: In der Stufe Einfach nur, was dort zu beheben ist (Regel der Hülle, ZapfprofilWarnDaten.AbExperte).
                liste.AddRange(v.Warnliste.Where(w => !(w.Position is int p && unvollstaendig.ContainsKey(p))
                                                      && (AbExperte || !w.AbExperte)));
            }
            if (_vergleich is not null) liste.AddRange(_vergleich.Hinweise);
            if (_kalibrierung is not null) liste.AddRange(_kalibrierung.Hinweise);
            liste.AddRange(_vorschlagHinweise);
            return liste;
        }
    }

