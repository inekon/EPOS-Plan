    private void PeakVorschlagUebernehmen()
    {
        if (_peakVorschlag is null) return;
        Flotte.Optionen.WirtschaftlicherPeakZielwertKw = _peakVorschlag.PeakZielKw;
        Geaendert();
    }

    private void PeakZielVerweigert()
    {
        _meldungErfolg = false;
        _meldung = PeakGesperrtText;
    }

    private async Task PeakZielBestimmen()
    {
        if (_laeuft || Dienste?.PeakZielBestimmen is null) return;

        // Die Ausnahme des Kerns wird NICHT gezeigt, sondern vorher geprueft: Ein
        // planendes Ziel braeuchte je Lauf den Fahrplaner (Auftrag #192, Punkt 5).
        if (FlottenPlanerLage.IstPlanend(Flotte.Optionen.Betriebsziel)) { PeakZielVerweigert(); return; }

        _laeuft = true; _fehler = ""; _meldung = ""; _anteil = null; _fortschritt = PeakTitelText;
        try
        {
            FlottenPeakZielErgebnis ergebnis = await Dienste.PeakZielBestimmen(_eingaben.Kopie(), Melden);
            _peakErgebnis = ergebnis;
        }
        catch (Exception ex) { _fehler = ex.Message; }
        finally { _laeuft = false; }
    }

    private string PeakFrageText => _peakErgebnis is null ? "" : string.Format(Kultur, PeakFrageFormat,
        _peakErgebnis.PeakZielKw.ToString("0.#", Kultur),
        _peakErgebnis.VerbleibendeSpitzeKw.ToString("0.#", Kultur),
        _peakErgebnis.Laeufe.ToString(Kultur));

    private void PeakBeantwortet(bool? antwort)
    {
        FlottenPeakZielErgebnis? ergebnis = _peakErgebnis;
        _peakErgebnis = null;
        if (antwort != true || ergebnis is null) return;

        Flotte.Optionen.WirtschaftlicherPeakZielwertKw = ergebnis.PeakZielKw;
        _schritt = AuslegungSchritt.Betrieb;
        Geaendert();

        // Die Herleitung steht NACH Geaendert(), weil das die Meldezeile raeumt: Der
        // Anwender soll lesen, wie der uebernommene Wert zustande kam.
        _meldungErfolg = true;
        _meldung = ergebnis.Herleitung;
    }

