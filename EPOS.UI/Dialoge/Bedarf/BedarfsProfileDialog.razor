    /// <summary>
    /// Eine PROJEKTZEILE zeigt den Jahresverbrauch DIESER Zuordnung
    /// (<c>listView_*_SelectedIndexChanged</c>).
    /// </summary>
    private void ProjektzeileWaehlen(BedarfsProfilZeile z)
    {
        _gewaehlt = z;
        _katalogzeile = null;
        _katalogGewaehlt = "";
        _jahresverbrauchMWh = z.Summe;
        InfoSetzen(z.Name);

        // PW1 Stufe 1: Die Projektzeile zeigt IHR Paar (die Projektkopie), nicht das des Katalogs.
        _neuVorlauf = z.Vorlauf;
        _neuRuecklauf = z.Ruecklauf;
        _infoTemperatur = TemperaturText(z.Vorlauf, z.Ruecklauf);
    }

    /// <summary>
    /// Eine KATALOGZEILE zeigt die Summe der zwölf Monatswerte
    /// (<c>listBox_*_DB_SelectedIndexChanged</c>).
    /// </summary>
    private void KatalogzeileWaehlen(string bezeichner)
    {
        Katalogfilterzeile? k = Katalogsatz(bezeichner);
        if (k is null) return;

        _katalogzeile = k;
        _katalogGewaehlt = k.Bezeichner;
        _gewaehlt = null;
        _jahresverbrauchMWh = Jahressumme?.Invoke(k.Bezeichner) ?? 0;
        InfoSetzen(k.Bezeichner);
    }

    private void InfoSetzen(string name)
    {
        // KT-4: Warf das Lesen, bleibt das Stammblatt wie es war; der Banner nennt den Grund.
        BedarfsProfilInfo? info = Katalogladung.Satz(() => Info?.Invoke(name), name, out _satzFehler);
        if (info is null) return;

        _infoName = info.Name;
        _infoBeschreibung = info.Beschreibung;
        _infoTyp = info.Typ;
        _infoTemperatur = TemperaturText(info.Vorlauf, info.Ruecklauf);
    }

    /// <summary>Die Wahl der Kalender: 0 = ohne, dann die Gaben der Hülle.</summary>
    private IReadOnlyList<(int Id, string Text)> KalenderWahlEintraege
    {
        get
        {
            var l = new List<(int, string)> { (0, TextOhneKalender) };
            if (Betriebskalender is not null) l.AddRange(Betriebskalender);
            return l;
        }
    }

    /// <summary>
    /// Der Betriebskalender der gewählten Projektzeile (PW2/BW2) — in den Arbeitsstand; geschrieben
    /// wird mit OK. Ohne gewählte Zeile meldet die Maske, statt still nichts zu tun.
    /// </summary>
    /// <summary>Die Art der markierten Zeile als Index in <see cref="KaelteArten"/>; leer oder unbekannt = der erste (Raum).</summary>
    private int? KaelteArtIndex
    {
        get
        {
            if (KaelteArten is null || _gewaehlt is null) return 0;
            for (int i = 0; i < KaelteArten.Count; i++)
                if (string.Equals(KaelteArten[i].Wert, _gewaehlt.KaelteArt, StringComparison.OrdinalIgnoreCase)) return i;
            return 0;
        }
    }

    private IReadOnlyList<(int Id, string Text)> KaelteArtEintraege
        => KaelteArten is null ? Array.Empty<(int, string)>() : KaelteArten.Select((a, i) => (i, a.Text)).ToList();

    /// <summary>KWN-0: setzt die Art der markierten Zeile — in den Arbeitsstand, geschrieben mit OK.</summary>
    private void KaelteArtGewaehlt(int? index)
    {
        if (_gewaehlt is null)
        {
            Melden(MeldungKeineAuswahl, WarnStufe.Warnung);
            return;
        }
        if (KaelteArten is null || index is null || index.Value < 0 || index.Value >= KaelteArten.Count) return;
        string neu = KaelteArten[index.Value].Wert;
        if (string.Equals(_gewaehlt.KaelteArt, neu, StringComparison.Ordinal)) return;
        _gewaehlt.KaelteArt = neu;
        Geaendert?.Invoke();
    }

    private void KalenderGewaehlt(int? id)
    {
        if (_gewaehlt is null)
        {
            Melden(MeldungKeineAuswahl, WarnStufe.Warnung);
            return;
        }
        int? neu = id is > 0 ? id : null;
        if (_gewaehlt.KalenderId == neu) return;
        _gewaehlt.KalenderId = neu;
        Geaendert?.Invoke();
    }

    /// <summary>
    /// „Temperaturen übernehmen" (PW1 Stufe 1): Projektzeile gewählt und ein zulässiges Paar —
    /// dann geht es in den Arbeitsstand der Zeile; geschrieben wird mit OK.
    /// </summary>
    private void BeiTemperaturUebernehmen()
    {
        if (_gewaehlt is null)
        {
            Melden(MeldungKeineAuswahl, WarnStufe.Warnung);
            return;
        }
        string? grund = TemperaturPruefen?.Invoke(_neuVorlauf, _neuRuecklauf);
        if (!string.IsNullOrEmpty(grund))
        {
            Melden(grund, WarnStufe.Warnung);
            return;
        }

        _gewaehlt.Vorlauf = _neuVorlauf;
        _gewaehlt.Ruecklauf = _neuRuecklauf;
        _gewaehlt.TemperaturGeaendert = true;
        _infoTemperatur = TemperaturText(_neuVorlauf, _neuRuecklauf);
        Geaendert?.Invoke();
        Melden(MeldungTemperaturUebernommen, WarnStufe.Hinweis);
    }

