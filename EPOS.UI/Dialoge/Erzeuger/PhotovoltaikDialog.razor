    private PvStraengeFelder? _straenge;
    private PhotovoltaikKiSicht? _kiSicht;
    private readonly PvModellTexte _modellTexte = new();

    private PhotovoltaikKiSicht? KiSicht()
    {
        // Welle #458, Stufe 2: Die Sicht steht auch, solange nur eine KATALOGzeile gewaehlt ist - dann traegt sie
        // allein den Aufklapper „Alle Daten"; die Felder der Anlage sind leer, genau wie auf der Maske.
        if (_projektZeile is null && _katalogZeile is null) return null;

        return _kiSicht ??= new PhotovoltaikKiSicht
        {
            Zeilenquelle = () => _projektZeile,
            // Die Zeilenzahl sagt dem Sperrgrund, ob die Einzelwahl greift (genau eine Zeile).
            Zeilenzahl = () => Zeilen.Count,
            // Meldung 10.10.2026: ohne gewählte Zeile die EINZIGE wählen wie das Öffnen;
            // nach dem Setzen derselbe Übernahmeweg wie BeiNeigung/BeiAnzahl.
            Einzelwahl = () =>
            {
                if (_projektZeile is null && Zeilen.Count == 1) ProjektZeileWaehlen(Zeilen[0]);
                return _projektZeile;
            },
            Uebernommen = z => { Uebernehmen?.Invoke(z); SummeNachziehen(); },
            ModellEintraege = Modelleintraege,
            AlleDaten = new AlleDatenTafel
            {
                Felder = () => _parameterOffen ? _felder : null,
                Sperrgrund = () => AlleDatenTafel.Grund(_parameterOffen ? _felder : null,
                                                        _projektZeile is not null ? ProjektsatzWege?.Speichern is not null
                                                                                  : KatalogfelderSpeichern is not null,
                                                        _katalogZeile?.Geschuetzt == true),
                Gesetzt = () => _felderGeaendert = true
            },
            KaltLesen = () => _straenge?.TKaltLebend ?? _tKalt,
            HeissLesen = () => _straenge?.THeissLebend ?? _tHeiss,
            KaltSetzen = wert =>
            {
                if (_straenge is not null) _ = _straenge.TKaltSetzen(wert);
                else TemperaturenWeg?.Invoke(wert, _tHeiss);
            },
            HeissSetzen = wert =>
            {
                if (_straenge is not null) _ = _straenge.THeissSetzen(wert);
                else TemperaturenWeg?.Invoke(_tKalt, wert);
            }
        };
    }

