@* DAS ERGEBNIS DER SPEICHERFLOTTE (Auftrag #184, Konzept „Stromspeicher-Dialoge"
   2.2/2.3, Anwenderentscheide SD-Q6 und SD-Q7 vom 11.09.2026).

   DIE REIHENFOLGE IST DIE DER HAUSREGEL (Doku_Simulationsergebnis_Darstellung.md,
   1): Hinweise, Kennzahlkacheln, Tabellen ueber die volle Breite, dann die
   Diagramme mit derselben Steuerzeile darueber, zuletzt die Exportknoepfe.

   VIER KACHELN STATT EINER ZAHLENWAND. Kapitalwert, Bezugsspitze vorher ->
   nachher, Ersparnis und Vollzyklen beantworten die vier Fragen, mit denen der
   Anwender auf dieses Blatt kommt. Alles Weitere steht darunter in Tabellen.

   DIE DELTA-SPALTE IST EINE FACHAUSSAGE. Δ = Mit − Ohne; ob ein negatives Δ gut
   ist, entscheidet die Kennzahl (Kosten, Bezug, Spitze: weniger ist besser).
   Beides rechnet der Kern (SpeicherFlottenAnzeigeCtrl.Vergleichszeilen) - auf
   iOS gilt dieselbe Regel. NULLZEILEN (Einspeisung an einem Standort ohne
   Erzeugung) stehen hinter einem Aufklapper: Drei Nullen sind keine Aussage.

   DER BETRIEBSEDITOR STEHT HIER NICHT MEHR (Konzept 2.2). Er stand doppelt -
   einmal bei den Eingaben und einmal im Ergebnis; das Ergebnis NENNT die
   berechnete Betriebsfuehrung und verweist mit einem Knopf dorthin, wo sie
   geaendert wird (Ereignis BetriebsfuehrungAendern nach aussen).

   DIE DIAGRAMME FOLGEN SEIT #184 DER HAUSREGEL 5. Ueber jedem Bild dieselbe
   Steuerung: "sortiert" (Dauerlinie), je Reihe ein Schalter mit DERSELBEN
   Ressource wie die Legende, das Bild mit Datenzoom (BereichGewaehlt) - und dazu
   die Zeitraumwahl Jahr/Woche/Tag mit Navigator (SD-Q7; bis hierher stand der
   Ausschnitt fest auf sieben Tagen ab dem 1. Januar).

   DER LADEZUSTAND KOMMT AUF DIE ZWEITE ACHSE (Hausregel 5.3). Welche Einheit
   dort steht, sagt das Auswahlfeld; ihr Reihenschalter sagt, OB sie gezeichnet
   wird. Das zweite Bild mit den Energiegrenzen bleibt waehlbar - dort steht das
   SoC-Band, das im Netzbild keine Skala hat.

   KEIN BILDVORRAT UND KEIN STAPEL (W11b-B-25). Gezeichnet wird nur, wenn sich
   der Bildauftrag WIRKLICH aendert; der Schluessel ist derselbe wie auf der
   Ergebnisseite (SimulationErgebnisDaten.Bildauftrag.Schluessel). Wer schnell
   durch die Wochen blaettert, verwirft damit den vorigen Auftrag, statt eine
   Warteschlange aufzubauen. *@

@namespace EPOS.UI.Dialoge.Strom
@using System.Globalization
@using EPOS.UI.Seiten.Simulation
@using WindowsFormsApplication1
@using SpeicherEngine

@if (Ergebnis is not null)
{
<div class="epos-flotte-ergebnis">

    @if (Veraltet)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@Resource.FLOTTE_MSG_VERALTET" />
    }

    @* Die Hinweise des Laufs als Warnbanner-Liste (Hausregel 6); das Diagnosebanner
       der arbeitslosen Flotte kommt mit Paket P3 dazu. *@
    @foreach (string hinweis in Ergebnis.Hinweise)
    {
        <Warnbanner Stufe="WarnStufe.Hinweis" Text="@hinweis" />
    }

    @if (Ergebnis.Studie is { } s)
    {
        @* ---------------------------------------------------------------- *@
        @* Betriebsfuehrung als TEXT, nicht als Editor (Konzept 2.2)          *@
        @* ---------------------------------------------------------------- *@
        <p class="epos-simerg-status">
            <strong>@Betriebszeile</strong>
            @if (BetriebsfuehrungAendern.HasDelegate)
            {
                <button type="button" class="epos-simerg-knopf" @onclick="BetriebsfuehrungAendern">
                    @Resource.FLOTTE_ERG_BTN_BETRIEB_AENDERN
                </button>
            }
        </p>

        @* ---------------------------------------------------------------- *@
        @* Die vier Kennzahlkacheln (Hausregel 6)                            *@
        @* ---------------------------------------------------------------- *@
        <Kachelraster>
            <KindInhalt>
                <Kennzahlkachel Titel="@Resource.FLOTTE_KACHEL_KAPITALWERT"
                                Wert="@KachelKapitalwert" Quelle="@KachelKapitalwertQuelle" />
                <Kennzahlkachel Titel="@Resource.FLOTTE_KACHEL_SPITZE"
                                Wert="@KachelSpitze" Quelle="@KachelSpitzeQuelle" />
                <Kennzahlkachel Titel="@Resource.FLOTTE_KACHEL_RECHNUNG"
                                Wert="@KachelRechnung" Quelle="@KachelRechnungQuelle" />
                <Kennzahlkachel Titel="@Resource.FLOTTE_KACHEL_ZYKLEN"
                                Wert="@KachelZyklen" Quelle="@KachelZyklenQuelle" />
            </KindInhalt>
        </Kachelraster>

        @if (PeakZielVerfehlt)
        {
            <Warnbanner Stufe="WarnStufe.Warnung" Text="@Resource.FLOTTE_MSG_PEAK_NICHT_ERREICHT" />
        }
        @if (!s.Variante.Zulaessig)
        {
            <Warnbanner Stufe="WarnStufe.Warnung"
                        Text="@(s.Variante.Unzulaessigkeitsgrund ?? Resource.FLOTTE_MSG_UNZULAESSIG)" />
        }
        @if (Ergebnis.ReaktiveReferenz is { } pv)
        {
            <p class="epos-flotte-hinweis">@ReaktiveReferenz(pv)</p>
        }

        @* ---------------------------------------------------------------- *@
        @* Vergleichstabelle mit Δ-Spalte und eingeklappten Nullzeilen        *@
        @* ---------------------------------------------------------------- *@
        <Gruppenkopf Titel="@Resource.FLOTTE_VGL_TITEL" />
        <table class="epos-raster epos-flotte-vergleich">
            <thead>
                <tr>
                    <th scope="col">@Resource.FLOTTE_VGL_SP_KENNZAHL</th>
                    <th scope="col">@Resource.FLOTTE_VGL_SP_EINHEIT</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_VGL_SP_OHNE</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_VGL_SP_MIT</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_VGL_SP_DELTA</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FlottenVergleichszeile zeile in Vergleichszeilen.Where(x => !x.IstNullzeile))
                {
                    @Vergleichszeile(zeile)
                }
            </tbody>
        </table>

        @if (Nullzeilen.Count > 0)
        {
            <details class="epos-flotte-nullzeilen">
                <summary>@NullzeilenTitel</summary>
                <table class="epos-raster epos-flotte-vergleich">
                    <tbody>
                        @foreach (FlottenVergleichszeile zeile in Nullzeilen)
                        {
                            @Vergleichszeile(zeile)
                        }
                    </tbody>
                </table>
            </details>
        }

        @* ---------------------------------------------------------------- *@
        @* Jahresprojektion als BILD, die Tabelle darunter aufklappbar        *@
        @* ---------------------------------------------------------------- *@
        @if (s.Wirtschaftlichkeit is { } w)
        {
            <Gruppenkopf Titel="@Resource.FLOTTE_PROJ_TITEL" />
            <p class="epos-flotte-hinweis">
                @string.Format(Kultur, Resource.FLOTTE_PROJ_INVEST, N(w.InvestitionEuro), N(w.KapitalwertEuro))
            </p>
            <p class="epos-flotte-hinweis">
                @(w.IstWiederholteReferenzjahrProjektion
                    ? Resource.FLOTTE_PROJ_WIEDERHOLUNG : Resource.FLOTTE_PROJ_JAHRESKONTEN)
            </p>

            <section class="epos-simerg-block epos-simerg-diagrammzeile">
                <div class="epos-simerg-schalter">
                    @foreach ((string Schluessel, string Text) reihe in SpeicherFlottenAnzeigeCtrl.Projektionsreihen())
                    {
                        string schluessel = reihe.Schluessel;
                        <Schalter Bezeichnung="@reihe.Text" Wert="@ProjektionsreiheAn(schluessel)"
                                  WertChanged="@(an => ProjektionsreiheGesetzt(schluessel, an))" />
                    }
                </div>
                <ChartBild Png="@_projektion" Alt="@Resource.FLOTTE_ALT_PROJEKTION" />
            </section>

            <details class="epos-flotte-jahreskonten">
                <summary>@Resource.FLOTTE_PROJ_TABELLE</summary>
                <table class="epos-raster">
                    <thead>
                        <tr>
                            <th scope="col">@Resource.FLOTTE_PROJ_SP_JAHR</th>
                            <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_PROJ_SP_BETRIEB</th>
                            <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_PROJ_SP_DURCHSATZ</th>
                            <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_PROJ_SP_ERSATZ</th>
                            <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_PROJ_SP_AUSGLEICH</th>
                            <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_PROJ_SP_CASHFLOW</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (FlottenJahreskonto j in w.Jahreskonten)
                        {
                            <tr>
                                <td>@j.Jahr</td>
                                <td class="epos-simerg-zahl">@N(j.OpexEuro)</td>
                                <td class="epos-simerg-zahl">@N(j.DurchsatzkostenEuro)</td>
                                <td class="epos-simerg-zahl">@N(j.ErsatzkostenEuro)</td>
                                <td class="epos-simerg-zahl">@N(j.EndenergieAusgleichEuro)</td>
                                <td class="epos-simerg-zahl">@N(j.NettoCashflowEuro)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </details>

            <div class="epos-simerg-schalter">
                <button type="button" class="epos-simerg-knopf" disabled="@(!Csv.HasDelegate)"
                        @onclick="@(() => Csv.InvokeAsync(SpeicherFlottenAnzeigeCtrl.JahreskontenCsv(Ergebnis)))">
                    @Resource.FLOTTE_BTN_CSV_JAHRESKONTEN
                </button>
            </div>
        }
        else
        {
            <p class="epos-flotte-hinweis">@Resource.FLOTTE_PROJ_OHNE</p>
        }

        @* ---------------------------------------------------------------- *@
        @* Die Kennzahlen JE EINHEIT bleiben                                  *@
        @* ---------------------------------------------------------------- *@
        <Gruppenkopf Titel="@Resource.FLOTTE_KENN_TITEL" />
        <table class="epos-raster">
            <thead>
                <tr>
                    <th scope="col">@Resource.FLOTTE_KENN_SP_SPEICHER</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KENN_SP_LADUNG</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KENN_SP_ENTLADUNG</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KENN_SP_ANFANG_ENDE</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KENN_SP_VOLLZYKLEN</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KENN_SP_RAINFLOW</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FlottenSpeicherKennzahlen k in s.Variante.SpeicherKennzahlen)
                {
                    <tr>
                        <td>@Einheitenname(k.SpeicherId)</td>
                        <td class="epos-simerg-zahl">@N(k.LadeenergieAcKWh)</td>
                        <td class="epos-simerg-zahl">@N(k.EntladeenergieAcKWh)</td>
                        <td class="epos-simerg-zahl">@N(k.AnfangsenergieKWh) / @N(k.EndenergieKWh)</td>
                        <td class="epos-simerg-zahl">@N(k.AequivalenteVollzyklen)</td>
                        <td class="epos-simerg-zahl">@Rainflow(k)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* -------------------------------------------------------------------- *@
    @* Die Kandidaten der Rastersuche (P4 baut die Tabelle um)                *@
    @* -------------------------------------------------------------------- *@
    @if (Ergebnis.Auslegung is { } a)
    {
        <Gruppenkopf Titel="@AuslegungEmpfehlung" />
        <p class="epos-flotte-hinweis">@a.Aussage</p>
        <table class="epos-raster">
            <thead>
                <tr>
                    <th scope="col">@Resource.FLOTTE_KAND_SP_VARIANTE</th>
                    <th scope="col">@Resource.FLOTTE_KAND_SP_BETRIEBSZIEL</th>
                    <th scope="col">@Resource.FLOTTE_KAND_SP_ZULAESSIG</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KAND_SP_KAPAZITAET</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KAND_SP_LEISTUNG</th>
                    <th scope="col" class="epos-simerg-zahl">@Resource.FLOTTE_KAND_SP_KAPITALWERT</th>
                    <th scope="col">@Resource.FLOTTE_KAND_SP_HINWEIS</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FlottenKandidatZusammenfassung k in a.Kandidaten
                    .OrderByDescending(x => x.Zulaessig).ThenByDescending(x => x.KapitalwertEuro).Take(50))
                {
                    <tr>
                        <td>@k.KandidatId</td>
                        <td>@Zieltext(k.Betriebsziel)</td>
                        <td>@(k.Zulaessig ? Resource.FLOTTE_KAND_JA : Resource.FLOTTE_KAND_NEIN)</td>
                        <td class="epos-simerg-zahl">@N(k.KapazitaetKWh)</td>
                        <td class="epos-simerg-zahl">@N(k.LadeleistungKw) / @N(k.EntladeleistungKw)</td>
                        <td class="epos-simerg-zahl">@N(k.KapitalwertEuro)</td>
                        <td>@k.Grund</td>
                    </tr>
                }
            </tbody>
        </table>
        <p class="epos-flotte-hinweis">
            @string.Format(Kultur, Resource.FLOTTE_KAND_ANZAHL, a.Kandidaten.Count)
        </p>
        <div class="epos-simerg-schalter">
            <button type="button" class="epos-simerg-knopf" disabled="@(!Csv.HasDelegate)"
                    @onclick="@(() => Csv.InvokeAsync(SpeicherFlottenAnzeigeCtrl.VergleichCsv(Ergebnis)))">
                @Resource.FLOTTE_BTN_CSV_VERGLEICH
            </button>
        </div>
    }

    @* -------------------------------------------------------------------- *@
    @* Die Diagramme mit der Steuerzeile der Hausregel 5                      *@
    @* -------------------------------------------------------------------- *@
    @if (Ergebnis.Studie is not null)
    {
        <Gruppenkopf Titel="@Resource.FLOTTE_DIA_TITEL" />
        <section class="epos-simerg-block epos-simerg-diagrammzeile">

            <div class="epos-simerg-schalter">
                <Schalter Bezeichnung="@Resource.SIM_CHK_SORTIERT" Wert="@_sortiert"
                          WertChanged="SortiertGesetzt" />
                <Schalter Bezeichnung="@Resource.FLOTTE_CHK_ZWEITES_BILD" Wert="@_zweitesBild"
                          WertChanged="ZweitesBildGesetzt" />
            </div>

            <div class="epos-simerg-schalter">
                @foreach ((string Schluessel, string Text) reihe in Betriebsreihen)
                {
                    string schluessel = reihe.Schluessel;
                    <Schalter Bezeichnung="@reihe.Text" Wert="@ReiheAn(schluessel)"
                              WertChanged="@(an => ReiheGesetzt(schluessel, an))" />
                }
            </div>

            @* DIE ZEITRAUMWAHL (SD-Q7, Muster W8-E-2): Jahr, Woche, Tag - und im
               Woche-/Tagfall ein Navigator, der im Ring laeuft. *@
            <div class="epos-flotte-zeitraum">
                <Optionsgruppe Bezeichnung="@Resource.FLOTTE_LBL_ZEITRAUM" Eintraege="@Stufenwahl"
                               Auswahl="@_stufe" AuswahlChanged="StufeGesetzt" />
                @if (_stufe != STUFE_JAHR)
                {
                    <button type="button" class="epos-gang-knopf" title="@Resource.FLOTTE_NAV_ZURUECK_TITEL"
                            @onclick="Zurueck">◀</button>
                    <span class="epos-gang-marke" aria-live="polite">@Marke</span>
                    <button type="button" class="epos-gang-knopf" title="@Resource.FLOTTE_NAV_VOR_TITEL"
                            @onclick="Vor">▶</button>
                }
                <Auswahlfeld Bezeichnung="@Resource.FLOTTE_LBL_SOC_EINHEIT" Eintraege="Speicherwahl"
                             Auswahl="@_speicher" AuswahlChanged="SpeicherGesetzt" />
            </div>

            <p class="epos-flotte-hinweis">@_zeitraum</p>

            <ChartBild Png="@_netz" Alt="@Resource.FLOTTE_ALT_NETZ"
                       BereichGewaehlt="NetzBereich" Zurueckgesetzt="NetzBereichZurueck" />

            @if (_zweitesBild && _soc is { Length: > 0 })
            {
                <ChartBild Png="@_soc" Alt="@Resource.FLOTTE_ALT_SOC"
                           BereichGewaehlt="SocBereich" Zurueckgesetzt="SocBereichZurueck" />
            }

            <div class="epos-simerg-schalter">
                <button type="button" class="epos-simerg-knopf" disabled="@(!Csv.HasDelegate)"
                        @onclick="@(() => Csv.InvokeAsync(SpeicherFlottenAnzeigeCtrl.ZeitreihenCsv(Ergebnis)))">
                    @Resource.FLOTTE_BTN_CSV_ZEITREIHEN
                </button>
            </div>
        </section>
    }
</div>
}

@code {
    /// <summary>Der fertig gerechnete Lauf; <c>null</c> = es steht nichts da.</summary>
    [Parameter] public SpeicherFlottenErgebnis? Ergebnis { get; set; }

    /// <summary>Die Eingaben wurden nach dem Lauf geändert.</summary>
    [Parameter] public bool Veraltet { get; set; }

    /// <summary>Der CSV-Export; ohne Delegat bleiben die Knöpfe gesperrt.</summary>
    [Parameter] public EventCallback<string> Csv { get; set; }

    /// <summary>
    /// „Betriebsführung ändern": Das Ergebnis führt den Editor NICHT mehr (Konzept 2.2),
    /// es meldet den Wunsch nach außen. Der Dialog wechselt darauf auf seinen Reiter, die
    /// freie Ansicht (Paket P3) auf Schritt 3. Ohne Delegat kein Knopf.
    /// </summary>
    [Parameter] public EventCallback BetriebsfuehrungAendern { get; set; }

    // --- Pruefhilfen der Tests ------------------------------------------------

    /// <summary>Steht die Dauerlinie vorn? (Prüfhilfe)</summary>
    public bool Sortiert => _sortiert;

    /// <summary>Die gewählten Reihenschlüssel des Netzbildes (Prüfhilfe).</summary>
    public IReadOnlyList<string> GewaehlteReihen => Reihen();

    /// <summary>Erster gezeigter Tag des Ausschnitts (Prüfhilfe).</summary>
    public int StartTag => Starttag();

    /// <summary>Länge des Ausschnitts in Tagen — 365 / 7 / 1 (Prüfhilfe).</summary>
    public int Tage => Tagezahl();

    /// <summary>Der Schlüssel des zuletzt gezeichneten Auftrags (Prüfhilfe).</summary>
    public string Bildschluessel => _schluessel;

    // --- Zustand --------------------------------------------------------------

    private const int STUFE_JAHR = 0, STUFE_WOCHE = 1, STUFE_TAG = 2;

    private SpeicherFlottenErgebnis? _gezeichnet;
    private byte[]? _netz, _soc, _projektion;
    private string _zeitraum = "";
    private string _schluessel = "";
    private string _projektionSchluessel = "";
    private bool _sortiert, _zweitesBild;
    private int _speicher;

    // Vorgabe ist die WOCHE 1 (Auftrag #184): Ein Jahr im Viertelstundenraster legt
    // vierzig Werte auf einen Bildpunkt und zeigt keinen einzigen Ladezyklus.
    private int _stufe = STUFE_WOCHE;

    /// <summary>Die Stelle JE STUFE — wer von Woche 30 auf den Tag wechselt und zurück,
    /// findet seine Woche wieder (Muster W8‑E‑2).</summary>
    private readonly int[] _nummer = new int[3];

    // Gemerkt wird die ABWAHL: So bleibt die Vorbelegung eine Aussage über die
    // Reihenliste und nicht eine zweite Liste, die man mitpflegen muss (Hausregel § 5).
    private readonly HashSet<string> _abgewaehlt = new(StringComparer.Ordinal);
    private readonly HashSet<string> _projektionAbgewaehlt = new(StringComparer.Ordinal)
    {
        // Betrieb, Durchsatz und Ersatz sind WAEHLBAR und stehen anfangs nicht im Bild:
        // Die Projektion beantwortet zuerst „traegt es sich?" - das sagen Saeule und
        // kumulierte Linie. Die drei Kostenlinien sind die Nachfrage danach.
        SpeicherFlottenAnzeigeCtrl.REIHE_BETRIEB,
        SpeicherFlottenAnzeigeCtrl.REIHE_DURCHSATZ,
        SpeicherFlottenAnzeigeCtrl.REIHE_ERSATZ
    };

    private Diagrammbereich? _netzbereich, _socbereich;

    // KEIN static readonly: Die Kultur wechselt zur Laufzeit (Sprachumschaltung im
    // Rahmen, gepinnte Kultur in den Prüfständen); ein eingefrorener Wert zeigte nach
    // dem Wechsel weiter deutsche Trennzeichen.
    private static CultureInfo Kultur => CultureInfo.CurrentCulture;

    // --- Lebenszyklus ---------------------------------------------------------

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_gezeichnet, Ergebnis))
        {
            // Ein NEUER Lauf setzt die Schalterstellungen zurück: Der Ausschnitt eines
            // früheren Ergebnisses hat mit diesem nichts zu tun (Muster W11b‑B‑25).
            _gezeichnet = Ergebnis;
            _stufe = STUFE_WOCHE;
            Array.Clear(_nummer);
            _speicher = 0;
            _netzbereich = null;
            _socbereich = null;
            _schluessel = "";
            _projektionSchluessel = "";
        }
        Zeichnen();
    }

    /// <summary>
    /// Zeichnet, wenn sich der Auftrag WIRKLICH geändert hat. Der Schlüssel ist der der
    /// Ergebnisseite (<see cref="Bildauftrag.Schluessel"/>); ein unveränderter Auftrag
    /// zeichnet nicht noch einmal, und ein schneller Wechsel verwirft den vorigen
    /// Auftrag, statt einen Stapel zu bilden (W11b‑B‑25).
    /// </summary>
    private void Zeichnen()
    {
        if (Ergebnis is null) return;

        string schluessel = Auftragsschluessel();
        if (!string.Equals(schluessel, _schluessel, StringComparison.Ordinal))
        {
            _schluessel = schluessel;
            (_netz, _soc, _zeitraum) = SpeicherFlottenAnzeigeCtrl.Bilder(
                Ergebnis, Starttag(), Tagezahl(), _speicher, Reihen(), _sortiert,
                Ausschnitt(_netzbereich), Ausschnitt(_socbereich));
        }

        string projektion = new Bildauftrag("FLOTTE_PROJEKTION", false, -1, Projektionsreihen()).Schluessel;
        if (!string.Equals(projektion, _projektionSchluessel, StringComparison.Ordinal))
        {
            _projektionSchluessel = projektion;
            _projektion = SpeicherFlottenAnzeigeCtrl.Jahresprojektionsbild(Ergebnis, Projektionsreihen());
        }
    }

    /// <summary>Der Schlüssel beider Zeitbilder — jedes Bild führt seinen eigenen Ausschnitt.</summary>
    private string Auftragsschluessel()
        => new Bildauftrag("FLOTTE_NETZ", _sortiert, Starttag(), Reihen(), Tagezahl(), _netzbereich).Schluessel +
           "#" + new Bildauftrag("FLOTTE_SOC", _sortiert, _speicher, null, 0.0, _socbereich).Schluessel;

    private static ChartRenderer.Bildausschnitt? Ausschnitt(Diagrammbereich? b)
        => b is null ? null : new ChartRenderer.Bildausschnitt(b.XVon, b.XBis, b.YVon, b.YBis);

    // --- Reihenwahl -----------------------------------------------------------

    private IReadOnlyList<(string Schluessel, string Text)> Betriebsreihen
        => SpeicherFlottenAnzeigeCtrl.Betriebsreihen(Ergebnis);

    private bool ReiheAn(string schluessel) => !_abgewaehlt.Contains(schluessel);

    private void ReiheGesetzt(string schluessel, bool an)
    {
        if (an) _abgewaehlt.Remove(schluessel); else _abgewaehlt.Add(schluessel);
        Zeichnen();
    }

    /// <summary>
    /// Die gewählten Reihenschlüssel in der Reihenfolge des Bildes. Eine LEERE Liste ist
    /// etwas anderes als <c>null</c>: Sie heißt „keine Reihe" (Hausregel § 5).
    /// </summary>
    private IReadOnlyList<string> Reihen()
        => Betriebsreihen.Where(r => ReiheAn(r.Schluessel)).Select(r => r.Schluessel).ToArray();

    private bool ProjektionsreiheAn(string schluessel) => !_projektionAbgewaehlt.Contains(schluessel);

    private void ProjektionsreiheGesetzt(string schluessel, bool an)
    {
        if (an) _projektionAbgewaehlt.Remove(schluessel); else _projektionAbgewaehlt.Add(schluessel);
        Zeichnen();
    }

    private IReadOnlyList<string> Projektionsreihen()
        => SpeicherFlottenAnzeigeCtrl.Projektionsreihen()
            .Where(r => ProjektionsreiheAn(r.Schluessel)).Select(r => r.Schluessel).ToArray();

    private void SortiertGesetzt(bool wert)
    {
        _sortiert = wert;
        Zeichnen();
    }

    private void ZweitesBildGesetzt(bool wert)
    {
        _zweitesBild = wert;
        Zeichnen();
    }

    // --- Zeitraum und Navigator ----------------------------------------------

    private IReadOnlyList<(int Id, string Text)> Stufenwahl => new[]
    {
        (STUFE_JAHR, Resource.BERG_STUFE_JAHR),
        (STUFE_WOCHE, Resource.BERG_STUFE_WOCHE),
        (STUFE_TAG, Resource.BERG_STUFE_TAG)
    };

    private int Tagezahl() => _stufe switch { STUFE_WOCHE => 7, STUFE_TAG => 1, _ => 366 };

    private int Starttag() => _stufe switch
    {
        STUFE_WOCHE => _nummer[STUFE_WOCHE] * 7,
        STUFE_TAG => _nummer[STUFE_TAG],
        _ => 0
    };

    private int Anzahl
    {
        get
        {
            (int wochen, int tage) = SpeicherFlottenAnzeigeCtrl.Abschnitte(Ergebnis);
            return _stufe == STUFE_WOCHE ? wochen : _stufe == STUFE_TAG ? tage : 1;
        }
    }

    private string Marke => string.Format(Kultur, Resource.BERG_GANG_MARKE,
        _nummer[_stufe] + 1, Anzahl, _stufe == STUFE_WOCHE ? Resource.BERG_STUFE_WOCHE : Resource.BERG_STUFE_TAG);

    private void StufeGesetzt(int? wert)
    {
        int neu = wert ?? STUFE_JAHR;
        if (neu < STUFE_JAHR || neu > STUFE_TAG) return;
        _stufe = neu;
        if (_nummer[_stufe] >= Anzahl) _nummer[_stufe] = Anzahl - 1;
        if (_nummer[_stufe] < 0) _nummer[_stufe] = 0;
        // Ein anderer Ausschnitt entwertet den aufgezogenen Bereich - er war in Anteilen
        // des ALTEN Bildes gemessen (W11b‑B‑25).
        _netzbereich = null;
        _socbereich = null;
        Zeichnen();
    }

    /// <summary>Ein Schritt zurück — vor dem ersten steht der letzte (Ringschluss, W8‑E‑2).</summary>
    private void Zurueck()
    {
        _nummer[_stufe] = _nummer[_stufe] > 0 ? _nummer[_stufe] - 1 : Anzahl - 1;
        _netzbereich = null;
        _socbereich = null;
        Zeichnen();
    }

    /// <summary>Ein Schritt vor — hinter dem letzten steht der erste.</summary>
    private void Vor()
    {
        _nummer[_stufe] = _nummer[_stufe] + 1 < Anzahl ? _nummer[_stufe] + 1 : 0;
        _netzbereich = null;
        _socbereich = null;
        Zeichnen();
    }

    private IReadOnlyList<(int Id, string Text)> Speicherwahl
        => Ergebnis?.Konfiguration?.Einheiten.Select((s, i) => (i, Einheitenname(s))).ToArray()
           ?? Array.Empty<(int, string)>();

    private void SpeicherGesetzt(int? wert)
    {
        _speicher = wert ?? 0;
        _socbereich = null;
        Zeichnen();
    }

    private void NetzBereich(Diagrammbereich bereich) { _netzbereich = bereich; Zeichnen(); }
    private void NetzBereichZurueck() { _netzbereich = null; Zeichnen(); }
    private void SocBereich(Diagrammbereich bereich) { _socbereich = bereich; Zeichnen(); }
    private void SocBereichZurueck() { _socbereich = null; Zeichnen(); }

    // --- Die vier Kacheln -----------------------------------------------------

    private FlottenWirtschaftlichkeitErgebnis? Wirtschaft => Ergebnis?.Studie?.Wirtschaftlichkeit;

    private string KachelKapitalwert => Wirtschaft is { } w ? N(w.KapitalwertEuro) + " €" : "";

    private string KachelKapitalwertQuelle
    {
        get
        {
            if (Wirtschaft is not { } w || Ergebnis?.Konfiguration?.Wirtschaftlichkeit is not { } e) return "";
            return string.Format(Kultur, Resource.FLOTTE_KACHEL_KAPITALWERT_QUELLE,
                w.Jahreskonten.Count > 0 ? w.Jahreskonten.Count : e.ProjektjahreBeiWiederholung,
                (e.Kalkulationszins * 100.0).ToString("0.##", Kultur), N(w.InvestitionEuro));
        }
    }

    private string KachelSpitze
    {
        get
        {
            if (Ergebnis?.Studie is not { } s) return "";
            return string.Format(Kultur, Resource.FLOTTE_KACHEL_SPITZE_WERT,
                N(s.ReferenzOhneSpeicher.MaximalerNetzbezugKw), N(s.Variante.MaximalerNetzbezugKw));
        }
    }

    private string KachelSpitzeQuelle
        => PeakZiel is not double p
            ? Resource.FLOTTE_KACHEL_SPITZE_OHNE_ZIEL
            : string.Format(Kultur, Resource.FLOTTE_KACHEL_SPITZE_QUELLE, N(p),
                PeakZielVerfehlt ? Resource.FLOTTE_STATUS_NICHT_ERREICHT : Resource.FLOTTE_STATUS_ERREICHT);

    private string KachelRechnung
        => Ergebnis?.Studie is { } s ? N(s.Variantenrechnung.GesamtEuro) + " €" : "";

    private string KachelRechnungQuelle
        => Ergebnis?.Studie is not { } s
            ? ""
            : string.Format(Kultur, Resource.FLOTTE_KACHEL_RECHNUNG_QUELLE,
                N(s.Referenzrechnung.GesamtEuro - s.Variantenrechnung.GesamtEuro));

    private string KachelZyklen
    {
        get
        {
            var kennzahlen = Ergebnis?.Studie?.Variante.SpeicherKennzahlen;
            if (kennzahlen is not { Count: > 0 }) return "";
            return string.Join(" · ", kennzahlen.Select(k => k.AequivalenteVollzyklen.ToString("F1", Kultur)));
        }
    }

    private string KachelZyklenQuelle
    {
        get
        {
            var kennzahlen = Ergebnis?.Studie?.Variante.SpeicherKennzahlen;
            if (kennzahlen is not { Count: > 0 }) return "";
            return string.Format(Kultur, Resource.FLOTTE_KACHEL_ZYKLEN_QUELLE,
                N(kennzahlen.Sum(k => k.LadeenergieAcKWh)), N(kennzahlen.Sum(k => k.EntladeenergieAcKWh)));
        }
    }

    // --- Vergleichstabelle ----------------------------------------------------

    private IReadOnlyList<FlottenVergleichszeile> Vergleichszeilen
        => SpeicherFlottenAnzeigeCtrl.Vergleichszeilen(Ergebnis);

    private IReadOnlyList<FlottenVergleichszeile> Nullzeilen
        => Vergleichszeilen.Where(x => x.IstNullzeile).ToArray();

    private string NullzeilenTitel
        => string.Format(Kultur, Resource.FLOTTE_VGL_NULLZEILEN, Nullzeilen.Count);

    private RenderFragment Vergleichszeile(FlottenVergleichszeile zeile) =>@<tr>
        <th scope="row">@zeile.Bezeichnung</th>
        <td>@zeile.Einheit</td>
        <td class="epos-simerg-zahl">@N(zeile.Ohne)</td>
        <td class="epos-simerg-zahl">@N(zeile.Mit)</td>
        <td class="@Deltaklasse(zeile)">@N(zeile.Delta)</td>
    </tr>;

    private static string Deltaklasse(FlottenVergleichszeile zeile) => zeile.IstBesser switch
    {
        true => "epos-simerg-zahl epos-flotte-delta--besser",
        false => "epos-simerg-zahl epos-flotte-delta--schlechter",
        _ => "epos-simerg-zahl"
    };

    // --- Texte ----------------------------------------------------------------

    private double? PeakZiel
    {
        get
        {
            var o = Ergebnis?.Konfiguration?.Optionen;
            return o is not null && o.Betriebsziel is FlottenBetriebsziel.PeakShaving or FlottenBetriebsziel.MultiUse
                ? o.WirtschaftlicherPeakZielwertKw : null;
        }
    }

    private bool PeakZielVerfehlt
        => PeakZiel is double p && Ergebnis?.Studie is { } s && s.Variante.MaximalerNetzbezugKw > p + 0.00001;

    private string Betriebszeile
        => Ergebnis?.Konfiguration?.Optionen is not { } o
            ? ""
            : string.Format(Kultur, Resource.FLOTTE_ERG_BETRIEBSFUEHRUNG,
                Zieltext(o.Betriebsziel), Verteilungstext(o.Verteilung));

    private string ReaktiveReferenz(FlottenStudienErgebnis pv)
        => string.Format(Kultur, Resource.FLOTTE_ERG_REAKTIVE_REFERENZ,
            N(pv.Variantenrechnung.GesamtEuro), N(pv.Variante.MaximalerNetzbezugKw),
            pv.Wirtschaftlichkeit is null ? "—" : N(pv.Wirtschaftlichkeit.KapitalwertEuro));

    private string AuslegungEmpfehlung => Ergebnis?.Auslegung is not { } a
        ? Resource.FLOTTE_EMPF_KEINE
        : a.NullvarianteGewonnen
            ? Resource.FLOTTE_EMPF_NULLVARIANTE
            : a.BesterKandidat?.Zulaessig == true
                ? Resource.FLOTTE_EMPF_BESTE
                : Resource.FLOTTE_EMPF_KEINE_ZULAESSIGE;

    private string Einheitenname(string id)
        => Ergebnis?.Konfiguration?.Einheiten.FirstOrDefault(x => x.Id == id) is { } e
            ? Einheitenname(e) : id;

    private static string Einheitenname(FlottenEinheit e)
        => string.IsNullOrWhiteSpace(e.Name) ? e.Id : e.Name;

    private string Rainflow(FlottenSpeicherKennzahlen k)
        => Ergebnis?.Konfiguration?.Einheiten.FirstOrDefault(x => x.Id == k.SpeicherId)?.RainflowKurve?.Count > 0
            ? N(k.RainflowSchaden) : "—";

    private static string N(double w) => w.ToString("N2", Kultur);

    /// <summary>Der Name eines Betriebsziels — DIESELBE Ressource wie im Betriebseditor.</summary>
    private static string Zieltext(FlottenBetriebsziel ziel) => ziel switch
    {
        FlottenBetriebsziel.PvGreedy => Resource.FLOTTE_ZIEL_PVGREEDY,
        FlottenBetriebsziel.PeakShaving => Resource.FLOTTE_ZIEL_PEAKSHAVING,
        FlottenBetriebsziel.PvPlanung => Resource.FLOTTE_ZIEL_PVPLANUNG,
        FlottenBetriebsziel.Arbitrage => Resource.FLOTTE_ZIEL_ARBITRAGE,
        FlottenBetriebsziel.MultiUse => Resource.FLOTTE_ZIEL_MULTIUSE,
        _ => ziel.ToString()
    };

    private static string Verteilungstext(FlottenVerteilung verteilung) => verteilung switch
    {
        FlottenVerteilung.KapazitaetsProportional => Resource.FLOTTE_VERT_KAPAZITAET,
        FlottenVerteilung.Kaskade => Resource.FLOTTE_VERT_KASKADE,
        FlottenVerteilung.Grenzkosten => Resource.FLOTTE_VERT_GRENZKOSTEN,
        _ => verteilung.ToString()
    };
}
