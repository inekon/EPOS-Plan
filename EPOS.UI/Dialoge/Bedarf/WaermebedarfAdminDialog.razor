@* Verwaltung der externen Waermebedarfsganglinien (iU9-W13.2).

   Vorbild: Views/Wärmebedarf/Form_AdminWaermeeinlesen.cs (167 Z.) und
   .designer.cs (148 Z.).

   WOZU. Die Liste aller Katalogeintraege in Tab_Waermebedarf_STAMM, das
   Loeschen mit Projektzuordnungssperre, das Anzeigen des Dateiinhalts mit der
   Systemanwendung und das EINLESEN einer Textdatei mit 8 760 Stundenwerten -
   ein Wert je Zeile.

   IHR ZWILLING IST NICHT DIE VDI-EINLESEMASKE, sondern
   Form_Stromganglinie_Admin aus Welle 12: Liste, Loeschen mit Sperre,
   Dateiwahl, Import in eine STAMM-Tabelle mit Datenblock. Diese Komponente
   folgt deshalb StromganglinieAdminDialog Zug um Zug.

   SEIT W9-E-3 IST ES AUCH DIESELBE KETTE. Bis dahin hing hier
   GanglinienTextDatei ein, wo beim Strom GanglinienImportAblauf steht - zwei
   Importe fuer dieselbe Sache, und der engere konnte weder CSV mit
   Trennzeichen noch Excel noch Viertelstundenwerte noch kWh je Intervall.
   Der Anwenderwunsch W9-E-3 ("Gestalte den Dialog bei Waermebedarf -> Daten
   importieren analog zum Import des Strombedarf") hat den Unterschied zu
   einer AUSPRAEGUNG gemacht: GanglinienZiel.Waermebedarf im Kern, und die
   Oberflaechenseite ist der Baustein GanglinienImportLauf - derselbe, den die
   zwei Stromdialoge und der Dialog "Waermebedarf Extern" einhaengen.

   BEFUND W13-B2, BEHOBEN: Die einzige Dublettenpruefung des Vorlaeufers war
   listBox_Extern.FindString(...) - eine Suche in der ANZEIGE, still, ohne
   Meldung, ohne Datenbankfrage. Seit W13.0g fuehrt der Katalog WAERMEBEDARF
   ImportSpalten (leeres Array = Namenspruefung ohne Inhaltsvergleich), und der
   Konfliktdialog erscheint als Ueberlagerung wie ueberall sonst.

   BEFUND W13-B8, BEHOBEN: Die Sperre lief als inline-SQL mit
   Zeichenkettenverkettung ueber den Anwendertext; sie steht seit W9.0d als
   WaermebedarfStammCtrl.HatProjektzuordnung im Kern - die Maske rief sie nur nicht.

   BEFUND W13-B9, BEHOBEN: Der Fehlschlag der verlustfreien Originalablage lief
   in ein catch { }. Wer glaubt, sein Original sei gesichert, und es ist nicht
   so, merkt es sonst erst, wenn er es braucht.

   VIER TOTE FELDER FALLEN WEG: m_ID_Projekt, m_szProjekt, result und DateiListe
   waren allesamt tot (result las niemand, DateiListe wurde befuellt und nie
   gelesen und nie geleert - Befund W13-B5). Ebenso btn_Abbrechen_Click ohne
   Knopf (B6), der leere listBox_Extern_SelectedIndexChanged und der 38-zeilige
   NOTEBOOK-FIX-Block, der im Code nachtrug, was in den Designer gehoerte.

   TASTATUR: Esc schliesst die oberste Ebene. Enter ist nicht belegt.

   STUFE 4 DER NEUORDNUNG (Konzept Administrationsdialoge, V3 V6 V8 V9 V12 V13
   V14; Mockup-Reiter "Waermebedarf Lastgang"): dasselbe Geruest wie die
   Geraetekataloge.
     * LISTE links ueber die ganze Hoehe, mit Kaestchen (V6).
     * AUSWAHLLEISTE (V8): Vergleichen und Loeschen - auch mehrere Zeilen
       (AD-Q9). Loeschen ist WEICH gesperrt, wenn jede Zielzeile ein
       Auslieferungssatz ist oder ein Projekt sie fuehrt; der Kurztext nennt
       die Projekte (Konzept 3.4). Kein Neu, kein Duplizieren: Ein Lastgang
       entsteht nur durch Einlesen.
     * STAMMBLATT (V9): Kopf mit Jahresarbeit, Spitze und Volllaststunden; die
       Gruppe GANGLINIE (Jahresverlauf aus dem Kern, "gross..." breit) und die
       Gruppe HERKUNFT als Text (V13).
     * EINLESEN ALS UEBERLAGERUNG (V14): "Import..." oeffnet "Datei einlesen"
       mit Formathinweis, Ordner, Dateiwahl, Fortschritt und Anzeigen; die
       Kette (GanglinienImportLauf) legt ihre drei Entscheidungen darueber.
       Nach dem Erfolg ist sie zu, der neue Lastgang gewaehlt, die
       Statuszeile nennt ihn.
     * Fussleiste: Statuszeile - Import... - Beenden. *@

@namespace EPOS.UI.Dialoge.Bedarf
@using SpeicherEngine
@using WindowsFormsApplication1

<div class="epos-dialog epos-katalog-dialog epos-waermebedarf-admin" tabindex="-1"
     @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="BeiSchliessen" />
    </div>

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    @* --- STUFE 4 (V3 V6 V8 V9): Liste links, rechts Auswahlleiste und
           Stammblatt. Bis hierher stand die Liste ueber einem Einleseblock wie im
           Vorbild Form_AdminWaermeeinlesen (676 x 433); das Einlesen ist jetzt
           eine Ueberlagerung (V14), und die Liste hat die ganze Hoehe. *@
    <Katalograhmen BlattOffen="@_auswahl.BlattOffen">
        <Liste>
            @* DIE EINE KATALOGLISTE (Anwenderentscheid W14a-E-10, Stufe S3.2):
               Suche ueber alle Spalten, Trefferzahl, Filter im Spaltenkopf; die
               Kennzahlen JAHRESARBEIT und SPITZE kommen aus EINER Gruppenabfrage.
               Seit Stufe 4 mit Kaestchen (V6). *@
            <Katalogliste Profil="@Katalogprofil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_gewaehlt" GewaehltChanged="BeiZeile" ZeileIstWahl="true"
                          Kaestchen="true" Gewaehlte="@_auswahl.Gewaehlte"
                          GewaehlteChanged="BeiKaestchen"
                          Zeigeanlass="@_auswahl.Uebernahmen" />
        </Liste>

        <Auswahl>
            <Auswahlleiste Fokus="@_gewaehlt" Anzahl="@_auswahl.Anzahl"
                           Handlungen="@Handlungen()"
                           Aufheben="BeiAufheben" Gesperrt="Warnen"
                           Stammblatt="@BlattOeffnenWeg" />
        </Auswahl>

        <Blatt>
            <Stammblatt Name="@_gewaehlt" Unterzeile="@Unterzeile"
                        Auslieferung="@_auslieferung" SchlossText="@Filtertexte.Schloss"
                        Entsperrt="@_schloss.Entsperrt(_fokuszeile)"
                        Kennzahlen="@Kennzahlen" Texte="@_blatttexte"
                        ZurListe="@_blattSchliessen"
                        Vergleichskoepfe="@(_auswahl.Vergleich ? _vergleichskoepfe : null)"
                        Vergleichszeilen="@(_auswahl.Vergleich ? _vergleichszeilen : null)"
                        VergleichZurueck="BeiVergleichZurueck">
                <Gruppen>
                    <Ganglinienblattgruppe @ref="_ganglinie" Modell="@_ansicht?.Modell"
                                           Name="@_gewaehlt" Schluessel="@Schluessel"
                                           Kennung="wbad-ganglinie"
                                           PlatzhalterText="@Platzhalter" />
                    <Stammblattgruppe Titel="@GruppeHerkunftText" Lesemodus="true"
                                      Werte="@Herkunftswerte" />
                </Gruppen>
            </Stammblatt>
        </Blatt>
    </Katalograhmen>

    @* DIE FUSSLEISTE (V14, V15): Statuszeile - Import... - Beenden. Loeschen steht
       in der Auswahlleiste, "Anzeigen" und "Einlesen" in der Ueberlagerung. *@
    <div class="epos-leiste">
        <span class="epos-leiste-fueller epos-status" role="status">@_status</span>
        @if (Einlesen is not null)
        {
            <button type="button" class="epos-knopf epos-importknopf"
                    @onclick="ImportOeffnen">@ImportOeffnenText</button>
        }
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="BeiSchliessen">@BeendenText</button>
    </div>

    @* --- Rueckfrage vor dem Loeschen (A-Zeile) --------------------------- *@
    <Rueckfrage Offen="@_loeschfrageOffen" Frage="@_loeschfrage" TitelText="@TitelText"
                JaText="@JaText" NeinText="@NeinText" Beantwortet="LoeschfrageBeantwortet" />

    @* --- Rueckfrage vor dem Umschalten des Schlosses (AD-Q15, Vorgabe Nein) *@
    <Rueckfrage Offen="@_schloss.FrageOffen" TitelText="@_schloss.Titel" Frage="@_schloss.Frage"
                VorgabeNein="true" JaText="@JaText" NeinText="@NeinText" Beantwortet="BeiSchlossAntwort" />

    @* --- DAS EINLESEN ALS UEBERLAGERUNG (V14). Das Kreuz steht beim Titel;
           waehrend der Kette schliessen weder Kreuz noch Esc noch Abbrechen. *@
    <Ueberlagerung Offen="@_importOffen" Titel="@GruppeEinlesenText" Geschlossen="ImportSchliessen">
        <KindInhalt>
            @if (_importOffen)
            {
                <div class="epos-einlesen">
                    @if (_importMeldung.Length > 0)
                    {
                        <Warnbanner Stufe="@_importMeldungStufe" Text="@_importMeldung" />
                    }

                    @* W9-E-3: Der volle Wortlaut des Formats haengt am Infoknopf, die
                       Zeile darunter nennt die Kurzform. *@
                    <div class="epos-formathinweis">
                        <Herleitungszeile Text="@HinweisStundenwerte" />
                        <InfoKnopf Schluessel="@HilfeSchluesselImport"
                                   StandardKurztext="@FormatHinweisLangText" />
                    </div>

                    <Formularraster Einspaltig="true">
                        <KindInhalt>
                            <Textfeld Bezeichnung="@LabelOrdner" Wert="@Ordner" NurLesen="true" />

                            <Dateiwahl Bezeichnung="" KnopfText="@DateiText" Filter="@Dateifilter"
                                       Pfad="@_pfad" Waehlen="@DateiWaehlen" PfadChanged="BeiDatei"
                                       Aktiv="@(!_laeuft)" />
                        </KindInhalt>
                    </Formularraster>

                    @* Die Kette meldet keinen Anteil; der Balken laeuft unbestimmt. *@
                    <Fortschritt Sichtbar="@_laeuft" Anteil="null" Text="" />

                    @* Die Leiste der Ueberlagerung: "Inhalt anzeigen..." wirkt auf die
                       gewaehlte Datei und steht links vom Fueller; Abbrechen schliesst,
                       ohne zu lesen, "Einlesen" liest und schreibt sofort. *@
                    <div class="epos-leiste">
                        <button type="button" class="epos-knopf" disabled="@(!AnzeigenErlaubt)"
                                @onclick="BeiAnzeigen">@AnzeigenText</button>
                        <span class="epos-leiste-fueller"></span>
                        <button type="button" class="epos-knopf" disabled="@_laeuft"
                                @onclick="ImportSchliessen">@AbbrechenText</button>
                        <button type="button" class="epos-knopf epos-knopf--primaer" disabled="@(!EinlesenErlaubt)"
                                @onclick="BeiEinlesen">@EinlesenText</button>
                    </div>
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Die Importkette: EIN Baustein fuer vier Masken (W9-E-3). Ihre drei
           Ueberlagerungen stehen im Quelltext NACH der Ueberlagerung "Datei
           einlesen" und damit ueber ihr. *@
    <GanglinienImportLauf @ref="_import" Einlesen="@Einlesen" Vorschau="@Vorschau"
                          LaeuftChanged="@(b => _laeuft = b)" />
</div>

@code {

    // =====================================================================
    // Delegaten — die Datenseite liegt in der Huelle
    // =====================================================================

    /// <summary>
    /// Der Katalog samt Parameterspalten
    /// (<c>ZeitreihenKatalogCtrl.Katalogfilterzeilen</c>, Stufe S3.2).
    /// </summary>
    [Parameter] public Func<Task<IReadOnlyList<Katalogfilterzeile>>>? Katalogzeilen { get; set; }

    /// <summary>
    /// Die Spalten des Katalogs —
    /// <c>Katalogfilterprofil.FuerZeitreihe(Zeitreihenart.Waermebedarf, …)</c>.
    /// </summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste — sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Ein eigener Filterstand statt des Registers (Muster der neun Katalogdialoge).</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>
    /// <b>Die Ansicht einer Ganglinie im Stammblatt</b> (Stufe 4, V9): Jahresverlauf und
    /// Kennzahlen aus dem Kern (<c>ZeitreihenAdminWege.Ansicht</c>). Ohne ihn steht der
    /// Platzhalter.
    /// </summary>
    [Parameter] public Func<string, Task<Ganglinienansicht>>? Ansicht { get; set; }

    /// <summary>
    /// <b>Welche Projekte welchen Lastgang führen</b> (Stufe 4, V8) — je Bezeichner die
    /// Projektnamen, EINE Abfrage je Liste (<c>ZeitreihenKatalogCtrl.Projektverwendung</c>).
    /// Daran hängt die weiche Löschsperre samt Projektnamen.
    /// </summary>
    [Parameter] public Func<Task<IReadOnlyDictionary<string, IReadOnlyList<string>>>>? Verwendung { get; set; }

    /// <summary>
    /// Gibt es zu dieser Ganglinie eine Projektzuordnung?
    /// (<c>WaermebedarfStammCtrl.HatProjektzuordnung</c>, Befund W13-B8.) Die letzte
    /// Prüfung vor dem Löschen — die Verwendung steht schon im Kurztext.
    /// </summary>
    [Parameter] public Func<string, Task<bool>>? HatProjektzuordnung { get; set; }

    /// <summary>Loescht einen Katalogeintrag; <c>false</c> = er blieb stehen.</summary>
    [Parameter] public Func<string, Task<bool>>? Loeschen { get; set; }

    /// <summary>
    /// <b>„Schloss setzen…" / „Schloss aufheben…"</b> (Entscheid AD-Q15): das
    /// Auslieferungskennzeichen der gewählten Zeitreihen umschalten — nur der Kopfsatz, die
    /// Werte bleiben (<c>ZeitreihenKatalogCtrl.SchlossSetzen</c> über <c>Schlosswege.Aus</c>).
    /// Hier gibt es Löschen frei. Ohne ihn steht die Handlung nicht da.
    /// </summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    /// <summary>Der Dateiwaehler der Plattform; ohne ihn bleibt der Knopf weg.</summary>
    [Parameter] public Func<string, Task<string?>>? DateiWaehlen { get; set; }

    /// <summary>
    /// Legt die gewaehlte Datei verlustfrei im Anwenderordner ab und liefert den
    /// dortigen Pfad. Ein Fehlschlag kommt als Meldung zurueck statt in ein
    /// <c>catch { }</c> (Befund W13-B9).
    /// </summary>
    [Parameter] public Func<string, Task<AblageErgebnis>>? Ablegen { get; set; }

    /// <summary>Oeffnet eine Datei mit der Systemanwendung (<c>Dienste.Datei.MitSystemOeffnen</c>).</summary>
    [Parameter] public Func<string, Task<bool>>? MitSystemOeffnen { get; set; }

    /// <summary>
    /// Faehrt die Importkette MIT Ablage
    /// (<c>GanglinienImportAblauf.MitAblage(GanglinienZiel.Waermebedarf, …)</c>);
    /// die drei Entscheidungen stellt <see cref="GanglinienImportLauf"/>. <b>Ohne ihn
    /// steht „Import…" nicht da.</b>
    /// </summary>
    [Parameter]
    public Func<string, GanglinienRaster, GanglinienImportRueckrufe,
                Task<GanglinienImportErgebnis>>? Einlesen { get; set; }

    /// <summary>Zerlegt eine Datei mit gesetzten Optionen neu (fuer den Optionendialog).</summary>
    [Parameter] public Func<string, GanglinienImportOptionen, Task<GanglinienVorschau?>>? Vorschau { get; set; }

    /// <summary>Der Ablageordner als Anzeigetext (<c>%APPDATA%…\Waermebedarf</c>).</summary>
    [Parameter] public string Ordner { get; set; } = "";

    /// <summary>Der Dialog ist zu Ende.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    /// <summary>Meldet dem Wirt, dass sich der Katalog geaendert hat (Ueberlagerungsbetrieb).</summary>
    [Parameter] public Action? Geaendert { get; set; }

    // =====================================================================
    // Texte
    // =====================================================================

    [Parameter] public string TitelText { get; set; } = Resource.WBAD_TITEL;

    /// <summary>
    /// Die frühere Überschrift der Liste — seit Stufe 4 ohne Wirkung (die Liste nennt
    /// sich über ihre Spaltenköpfe); der Parameter bleibt, damit kein Parametersatz bricht.
    /// </summary>
    [Parameter] public string LabelKatalog { get; set; } = Resource.WBAD_LBL_KATALOG;
    [Parameter] public string SpalteWahlText { get; set; } = Resource.KFAK_SP_WAHL;

    /// <summary>Der Titel der Überlagerung „Datei einlesen".</summary>
    [Parameter] public string GruppeEinlesenText { get; set; } = Resource.WBAD_GRP_EINLESEN;
    [Parameter] public string HinweisStundenwerte { get; set; } = Resource.WBAD_LBL_STUNDENWERTE;
    [Parameter] public string LabelOrdner { get; set; } = Resource.WBAD_LBL_ORDNER;
    [Parameter] public string DateiText { get; set; } = Resource.WBAD_BTN_DATEI;
    [Parameter] public string AnzeigenText { get; set; } = Resource.WBAD_BTN_ANZEIGEN;
    [Parameter] public string EinlesenText { get; set; } = Resource.WBAD_BTN_EINLESEN;
    [Parameter] public string LoeschenText { get; set; } = Resource.WBAD_BTN_LOESCHEN;
    [Parameter] public string BeendenText { get; set; } = Resource.WBAD_BTN_BEENDEN;
    [Parameter] public string Dateifilter { get; set; } = Resource.WBAD_DATEIFILTER;
    [Parameter] public string VorlageLoeschfrage { get; set; } = Resource.WBAD_FRAGE_LOESCHEN;
    [Parameter] public string VorlageGeloescht { get; set; } = Resource.WBAD_MSG_GELOESCHT;
    [Parameter] public string TextZuordnung { get; set; } = Resource.WBAD_MSG_PROJEKTZUORDNUNG;
    /// <summary>
    /// Sperrgrund „Auslieferungssatz". Bis W9‑E‑3 stand hier
    /// <c>IMPORT_MSG_SCHREIBGESCHUETZT</c> — und dieser Text nennt die
    /// STROMganglinie; in der Wärmebedarfsverwaltung war das schlicht falsch.
    /// </summary>
    [Parameter] public string TextSchreibgeschuetzt { get; set; } = Resource.WBAD_MSG_SCHREIBGESCHUETZT;

    /// <summary>Der AUSFUEHRLICHE Formathinweis; er haengt am Infoknopf (W9-E-3).</summary>
    [Parameter] public string FormatHinweisLangText { get; set; } = Resource.WBX_HINWEIS_FORMAT;

    /// <summary>Schluessel des Hilfeknopfes am Formathinweis (W9-E-3).</summary>
    [Parameter] public string HilfeSchluesselImport { get; set; } = "Form_Waermebedarf.btn_Help_Import";
    [Parameter] public string JaText { get; set; } = Resource.ALLG_BTN_JA;
    [Parameter] public string NeinText { get; set; } = Resource.ALLG_BTN_NEIN;
    [Parameter] public string AbbrechenText { get; set; } = Resource.ALLG_BTN_ABBRECHEN;
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_AdminWaermeeinlesen.btn_Help";

    // ---- Stammblatt und Einlesen (Stufe 4) ------------------------------
    [Parameter] public string ImportOeffnenText { get; set; } = Resource.ADM_BTN_IMPORT;
    [Parameter] public string GruppeHerkunftText { get; set; } = Resource.ADM_SB_HERKUNFT;

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private bool _laeuft;
    private GanglinienImportLauf? _import;
    private Ganglinienblattgruppe? _ganglinie;

    private IReadOnlyList<Katalogfilterzeile> _katalog = Array.Empty<Katalogfilterzeile>();
    private Katalogfilterstand _filterstand = new();
    private string _gewaehlt = "";

    /// <summary>
    /// Der Pfad der abgelegten Datei — ein PARAMETER der Kette, kein Feld. Im
    /// Vorlaeufer war <c>filebasename</c> ein Feld: Brach der Anwender die
    /// Dateiwahl ab, lief „Einlesen" mit der Datei des VORIGEN Laufs weiter
    /// (Befund W13-B10).
    /// </summary>
    private string _pfad = "";

    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Hinweis;

    private bool _loeschfrageOffen;
    private string _loeschfrage = "";

    // ---- Stufe 4 ---------------------------------------------------------
    private readonly Zeilenauswahl _auswahl = new();
    private Katalogfilterzeile? _fokuszeile;
    private bool _auslieferung;
    private Ganglinienansicht? _ansicht;
    private HashSet<string> _geschuetzt = new(StringComparer.Ordinal);
    private IReadOnlyDictionary<string, IReadOnlyList<string>>? _verwendung;
    private IReadOnlyList<string>? _vergleichskoepfe;
    private IReadOnlyList<Vergleichszeile>? _vergleichszeilen;
    private List<string> _loeschziele = new();
    private int _loeschBleiben;
    private string _status = "";
    private bool _importOffen;
    private string _importMeldung = "";
    private WarnStufe _importMeldungStufe = WarnStufe.Hinweis;

    private EventCallback _vergleichen;
    private EventCallback _loeschenWeg;
    private EventCallback _schlossHandlung;

    /// <summary>„Schloss setzen…" / „Schloss aufheben…" (AD-Q15) — Rückfrage und die in dieser Sitzung entsperrten Sätze.</summary>
    private readonly Schlossumschaltung _schloss = new();
    private EventCallback _blattOeffnen;
    private EventCallback _blattSchliessen;

    /// <summary>Ein Lastgang kennt kein Duplizieren — der Hinweis im Kopf sagt es ohne.</summary>
    private readonly Stammblatttexte _blatttexte = new() { NurLesen = Resource.ADM_SB_NUR_LESEN_OHNE_KOPIE };

    /// <summary>Die Zeilen des Katalogs (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<Katalogfilterzeile> Katalog => _katalog;

    /// <summary>Der Filterstand der Liste (Prüfhilfe für Tests).</summary>
    public Katalogfilterstand Filterstand => _filterstand;

    /// <summary>Der gewaehlte Katalogeintrag (Pruefhilfe fuer Tests).</summary>
    public string Gewaehlt => _gewaehlt;

    /// <summary>Der Text des Warnbanners des Dialogs (Pruefhilfe fuer Tests).</summary>
    public string Meldung => _meldung;

    /// <summary>Der Text des Warnbanners IN der Überlagerung „Datei einlesen" (Prüfhilfe).</summary>
    public string Importmeldung => _importMeldung;

    /// <summary>Die Statuszeile der Fußleiste (Prüfhilfe für Tests).</summary>
    public string Status => _status;

    /// <summary>Steht die Überlagerung „Datei einlesen"? (Prüfhilfe für Tests.)</summary>
    public bool ImportOffen => _importOffen;

    /// <summary>Der Pfad der gewaehlten Datei (Pruefhilfe fuer Tests).</summary>
    public string Pfad => _pfad;

    /// <summary>Die über das Kästchen gewählten Zeilen (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<string> Kaestchen => _auswahl.Gewaehlte;

    /// <summary>Zeigt das Stammblatt den Vergleich? (Prüfhilfe für Tests.)</summary>
    public bool Vergleicht => _auswahl.Vergleich && _vergleichszeilen is not null;

    /// <summary>Die Zeilen des Vergleichs (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<Vergleichszeile> Vergleichszeilen => _vergleichszeilen ?? Array.Empty<Vergleichszeile>();

    private bool AnzeigenErlaubt => _pfad.Length > 0 && !_laeuft && MitSystemOeffnen is not null;
    private bool EinlesenErlaubt => _pfad.Length > 0 && !_laeuft && Einlesen is not null;

    // =====================================================================
    // Stammblatt (Stufe 4)
    // =====================================================================

    private string Schluessel => _fokuszeile?.Id.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0";

    private string Unterzeile => _fokuszeile is null ? "" : Ganglinienblatt.Herkunft(_auslieferung);

    private IReadOnlyList<Stammblattkennzahl> Kennzahlen => Ganglinienblatt.Kennzahlen(_fokuszeile, _ansicht);

    private string Platzhalter => _ansicht is not null && _ansicht.Meldung.Length > 0
        ? _ansicht.Meldung : Resource.ADM_SB_KEINE_GANGLINIE;

    /// <summary>Die Gruppe Herkunft als Text (V13): Satz, Verwendung, Ablageordner.</summary>
    private IReadOnlyList<Stammblattwert> Herkunftswerte
    {
        get
        {
            if (_fokuszeile is null) return Stammblattwert.Keine;
            IReadOnlyList<string> projekte = Ganglinienblatt.Projekte(_verwendung, _gewaehlt);
            var liste = new List<Stammblattwert>
            {
                new(Resource.ADM_SB_SATZ, Ganglinienblatt.Herkunft(_auslieferung)),
                new(Resource.ADM_SB_VERWENDET, projekte.Count == 0 ? "" : string.Join(", ", projekte))
            };
            if (Ordner.Length > 0) liste.Add(new(Resource.ADM_SB_ABLAGE, Ordner));
            return liste;
        }
    }

    private EventCallback BlattOeffnenWeg => _auswahl.BlattOffen ? default : _blattOeffnen;

    /// <summary>Vergleichen ab zwei Kästchen; Löschen — weich gesperrt mit Grund (V8, V13).</summary>
    private IReadOnlyList<Auswahlhandlung> Handlungen()
    {
        var liste = new List<Auswahlhandlung>(2)
        {
            new(Filtertexte.Vergleichen, _vergleichen)
            {
                Mindestens = 2,
                ZahlGrund = Resource.ADM_AW_VERGLEICHEN_GRUND,
                Gedrueckt = _auswahl.Vergleich
            }
        };
        // AD-Q15: die Beschriftung folgt der Auswahl; hart gesperrt, solange eingelesen wird.
        if (_schloss.Handlung(Schloss, _schlossHandlung, SchlossZiele, _laeuft) is { } schloss)
            liste.Add(schloss);
        if (Loeschen is not null)
            liste.Add(new(LoeschenText, _loeschenWeg)
            {
                Sperrgrund = Ganglinienblatt.LoeschSperrgrund(_auswahl.Ziele(_gewaehlt), _geschuetzt, _verwendung),
                Aus = _laeuft
            });
        return liste;
    }

    private void Warnen(string text) => Melden(text, WarnStufe.Warnung);

    // =====================================================================
    // „Schloss setzen…" / „Schloss aufheben…" (Entscheid AD-Q15)
    // =====================================================================

    /// <summary>Die Zeilen, auf die die Auswahlleiste gerade wirkt.</summary>
    private IReadOnlyList<Katalogfilterzeile> SchlossZiele
        => Schlossumschaltung.Zeilen(_auswahl.Ziele(_gewaehlt), _katalog);

    /// <summary>Der Klick: Rückfrage in beiden Richtungen, Vorgabe „Nein".</summary>
    private void BeiSchloss()
    {
        if (_laeuft) return;
        string? grund = _schloss.Fragen(Schloss, SchlossZiele, false);
        if (grund is not null) { Warnen(grund); return; }
        _meldung = "";
    }

    /// <summary>
    /// Nach dem „Ja": schalten, den Katalog neu lesen — Schloss und Löschsperre folgen aus
    /// der Zeile —, Erfolg in die Statuszeile.
    /// </summary>
    private async Task BeiSchlossAntwort(bool? antwort)
    {
        Schlossausgang a = _schloss.Beantwortet(antwort, Schloss);
        if (!a.Geschrieben)
        {
            if (a.Fehler.Length > 0) Warnen(a.Fehler);
            return;
        }
        await KatalogLaden();
        _meldung = "";
        _status = a.Status;
    }

    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe für Tests.)</summary>
    public bool Schlossfrage => _schloss.FrageOffen;

    private void BeiKaestchen(IReadOnlyList<string> gewaehlte)
    {
        _auswahl.Setzen(gewaehlte);
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiAufheben()
    {
        _auswahl.Aufheben();
        _vergleichszeilen = null;
    }

    private void BeiVergleichen()
    {
        if (_auswahl.VergleichUmschalten()) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiVergleichZurueck()
    {
        _auswahl.VergleichBeenden();
        _vergleichszeilen = null;
    }

    /// <summary>Der Vergleich (V12): Spalten der Liste, Herkunft und Verwendung.</summary>
    private void VergleichBauen()
    {
        IReadOnlyList<string> namen = _auswahl.Gewaehlte;
        _vergleichskoepfe = namen;
        var zeilen = namen.Select(n => _katalog.FirstOrDefault(x => x.Schluessel == n))
                          .Where(x => x is not null).Select(x => x!).ToList();
        _vergleichszeilen = Ganglinienblatt.Vergleich(Katalogprofil, zeilen, _verwendung);
    }

    // =====================================================================
    // Aufbau
    // =====================================================================

    protected override void OnParametersSet()
    {
        // Der Kopf der WAHLSPALTE kommt weiter ueber den eigenen Text des Wirtes.
        Filtertexte.SpalteWahl = SpalteWahlText;
    }

    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _loeschenWeg = EventCallback.Factory.Create(this, BeiLoeschen);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        // S2.5/S3.2: der Filterstand je Katalog, fuer die Sitzung, gemeinsam mit dem
        // Projektdialog desselben Katalogs (Frage Q2).
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(
            Katalogprofil?.Schluessel ?? ("ZEITREIHE_" + Zeitreihenart.Waermebedarf));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await KatalogLaden();
        await _wurzel.FocusAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Laedt den Katalog neu (<c>SetControls</c> des Vorlaeufers) samt der Verwendung
    /// in Projekten. <b>Das Stammblatt ist nie leer, solange die Liste Treffer hat</b>
    /// (Konzept 3.3): Steht die bisherige Wahl nicht mehr da, wird die erste gewählt.
    /// </summary>
    public async Task KatalogLaden()
    {
        if (Katalogzeilen is null) return;
        _katalog = await Katalogzeilen() ?? Array.Empty<Katalogfilterzeile>();
        _verwendung = Verwendung is null ? null : await Verwendung();

        _geschuetzt = new HashSet<string>(_katalog.Where(z => z.Geschuetzt).Select(z => z.Bezeichner),
                                          StringComparer.Ordinal);

        _auswahl.Abgleichen(_katalog.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        if (_katalog.Count == 0)
        {
            _gewaehlt = "";
            _fokuszeile = null;
            _auslieferung = false;
            _ansicht = null;
            return;
        }
        string ziel = _katalog.Any(z => z.Bezeichner == _gewaehlt) ? _gewaehlt : _katalog[0].Bezeichner;
        await Waehlen(ziel);
    }

    private Task BeiZeile(string bezeichner)
    {
        _meldung = "";
        return Waehlen(bezeichner ?? "");
    }

    /// <summary>Eine Zeile wählen: Fokuszeile, dann Bild und Kennzahlen aus dem Kern.</summary>
    private async Task Waehlen(string bezeichner)
    {
        bool anders = bezeichner != _gewaehlt || _ansicht is null;
        _gewaehlt = bezeichner ?? "";
        _fokuszeile = _katalog.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
        _auslieferung = _fokuszeile?.Geschuetzt == true;
        if (!anders) return;

        _ansicht = null;
        if (_gewaehlt.Length == 0 || Ansicht is null) return;
        _ansicht = await Ansicht(_gewaehlt);
    }

    // =====================================================================
    // Loeschen (btn_Loeschen_Click) - seit Stufe 4 aus der Auswahlleiste,
    // auch fuer mehrere Zeilen (AD-Q9)
    // =====================================================================

    /// <summary>
    /// <b>„Löschen" aus der Auswahlleiste</b>: wirkt auf die gewählten Zeilen, sonst auf
    /// die Fokuszeile. Stehen bleiben die Auslieferungssätze (V13) und die Lastgänge, die
    /// ein Projekt führt (Prüfregel 1 des Vorläufers, wörtlich) — die Rückfrage nennt sie.
    /// </summary>
    private async Task BeiLoeschen()
    {
        if (_laeuft || Loeschen is null) return;

        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count == 0) return;

        var ausgeliefert = new List<string>();
        var verwendet = new List<string>();
        var loeschbar = new List<string>();
        foreach (string z in ziele)
        {
            if (_geschuetzt.Contains(z)) { ausgeliefert.Add(z); continue; }
            if (Ganglinienblatt.Projekte(_verwendung, z).Count > 0
                || (HatProjektzuordnung is not null && await HatProjektzuordnung(z)))
            {
                verwendet.Add(z);
                continue;
            }
            loeschbar.Add(z);
        }

        if (loeschbar.Count == 0)
        {
            // Alles bleibt stehen - der Grund wie am Knopf. Kennt die Karte die
            // Zuordnung nicht (sie kam erst die Datenbank nach), die Meldung des
            // Vorlaeufers.
            string grund = Ganglinienblatt.LoeschSperrgrund(ziele, _geschuetzt, _verwendung);
            if (grund.Length == 0 || (verwendet.Count > 0
                                      && verwendet.All(z => Ganglinienblatt.Projekte(_verwendung, z).Count == 0)))
                grund = verwendet.Count > 0 ? TextZuordnung : TextSchreibgeschuetzt;
            Warnen(grund);
            return;
        }

        _loeschziele = loeschbar;
        _loeschBleiben = ausgeliefert.Count + verwendet.Count;
        _loeschfrage = Ganglinienblatt.Rueckfrage(loeschbar, ausgeliefert, verwendet, VorlageLoeschfrage);
        _loeschfrageOffen = true;
    }

    /// <summary>Nach dem „Ja": je Zeile ein Schritt; die Statuszeile nennt, was gelang.</summary>
    private async Task LoeschfrageBeantwortet(bool? antwort)
    {
        _loeschfrageOffen = false;
        if (antwort != true || Loeschen is null) return;

        int geloescht = 0;
        bool fehler = false;
        foreach (string name in _loeschziele)
        {
            if (await Loeschen(name)) geloescht++;
            else fehler = true;
        }

        int ziele = _loeschziele.Count + _loeschBleiben;
        string einzeln = _loeschziele.Count == 1 ? _loeschziele[0] : "";
        _loeschziele = new List<string>();

        await KatalogLaden();
        if (geloescht > 0) Geaendert?.Invoke();
        if (fehler) Warnen(TextSchreibgeschuetzt);
        if (geloescht > 0)
            _status = Ganglinienblatt.Geloescht(ziele, geloescht, einzeln, VorlageGeloescht);
    }

    // =====================================================================
    // Die Ueberlagerung "Datei einlesen" (V14)
    // =====================================================================

    private void ImportOeffnen()
    {
        if (Einlesen is null) return;
        _meldung = "";
        _importMeldung = "";
        _importOffen = true;
    }

    /// <summary>Kreuz, Esc und „Abbrechen" — nicht, solange die Kette läuft.</summary>
    private void ImportSchliessen()
    {
        if (_laeuft) return;
        _importOffen = false;
        _importMeldung = "";
    }

    private async Task BeiDatei(string pfad)
    {
        _importMeldung = "";
        if (string.IsNullOrEmpty(pfad)) { _pfad = ""; return; }

        if (Ablegen is null) { _pfad = pfad; return; }

        // Die verlustfreie Originalablage im Anwenderordner. Ein Fehlschlag ist
        // eine Warnung - der Import laeuft dann mit der Originaldatei weiter.
        AblageErgebnis erg = await Ablegen(pfad);
        _pfad = erg.Pfad.Length > 0 ? erg.Pfad : pfad;
        if (erg.Meldung.Length > 0)
        {
            _importMeldung = erg.Meldung;
            _importMeldungStufe = WarnStufe.Warnung;
        }
    }

    private async Task BeiAnzeigen()
    {
        if (!AnzeigenErlaubt) return;
        await MitSystemOeffnen!(_pfad);
    }

    /// <summary>
    /// „Einlesen" (btn_Einlesen_Click). <b>Gelingt es</b>, schließt die Überlagerung,
    /// der neue Lastgang steht gewählt, die Statuszeile nennt ihn (V14). <b>Scheitert
    /// es</b>, bleibt sie offen und meldet den Grund in ihrem eigenen Warnband.
    /// </summary>
    private async Task BeiEinlesen()
    {
        if (!EinlesenErlaubt || _import is null) return;

        _importMeldung = "";
        _status = "";

        // Die Maske gibt KEINE Rastervorgabe: Die Kette erkennt das Raster
        // selbst, und der Optionendialog laesst es uebersteuern.
        GanglinienImportErgebnis? erg = await _import.Starten(_pfad, GanglinienRaster.Unbekannt);
        if (erg is null) return;

        if (erg.Ausgang == ImportAusgang.Erfolg)
        {
            _pfad = "";
            _importOffen = false;
            // Die neue Zeitreihe ist die Wahl - derselbe Weg wie jede Uebernahme
            // (Zeilenauswahl.Uebernommen): Die Liste rollt sie ins Bild (Zeigeanlass).
            _gewaehlt = erg.Bezeichner ?? "";
            _auswahl.Uebernommen(new[] { _gewaehlt });
            _vergleichszeilen = null;
            _ansicht = null;
            await KatalogLaden();
            Geaendert?.Invoke();
            _status = erg.Meldung.Length > 0
                ? erg.Meldung
                : string.Format(System.Globalization.CultureInfo.CurrentCulture, Resource.ADM_MSG_EINGELESEN, erg.Bezeichner);
            return;
        }

        if (erg.Meldung.Length > 0)
        {
            _importMeldung = erg.Meldung;
            _importMeldungStufe = GanglinienImportLauf.StufeZu(erg);
        }
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    /// <summary>
    /// „Beenden" liefert <c>true</c> — auch über das Kreuz und Esc (nach den Wächtern):
    /// EIN Schlussweg (Konzept Administrationsdialoge, V15). Einlesen und Löschen
    /// schreiben sofort, es gibt nichts zu verwerfen.
    /// </summary>
    private Task BeiSchliessen() => _laeuft ? Task.CompletedTask : Geschlossen.InvokeAsync(true);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_loeschfrageOffen || _schloss.FrageOffen || _importOffen || _import?.EtwasOffen == true
            || _ganglinie?.Offen == true) return Task.CompletedTask;

        // Im schmalen Fenster schliesst Esc zuerst das Blatt (Konzept 3.3).
        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }
        return BeiSchliessen();
    }
}
