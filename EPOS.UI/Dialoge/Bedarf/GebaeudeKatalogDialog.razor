    private static string Volumentext(double? v) => v is double x ? Zahl(x, 0) + " m³" : "—";

    /// <summary>Σ Volumen der Zonen; <c>null</c>, wenn eines fehlt.</summary>
    private static double? Volumensumme(IReadOnlyList<Zonenkennwerte> kennliste)
    {
        double summe = 0.0;
        foreach (Zonenkennwerte k in kennliste)
        {
            if (k.Volumen is not double v) return null;
            summe += v;
        }
        return summe;
    }

