    private static string Projektschluessel(GanglinienProjektZeile z)
        => z.Schluessel.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private IReadOnlyList<string> ProjektSchluessel() => Zeilen.Select(Projektschluessel).ToList();

    private IReadOnlyList<string> KatalogSichtbar()
        => (_katalogliste?.Angezeigt ?? _katalog).Select(z => z.Schluessel).ToList();

    /// <summary>Die Ziele einer Projektaktion: die angekreuzten Zeilen, sonst die markierte.</summary>
    private List<GanglinienProjektZeile> ProjektZiele()
    {
        if (_projektWahl.Anzahl > 0)
            return Zeilen.Where(z => _projektWahl.IstGewaehlt(Projektschluessel(z))).ToList();
        return _projektZeile is null ? new() : new() { _projektZeile };
    }

    /// <summary>Die Ziele einer Katalogaktion: die angekreuzten Sätze, sonst der gewählte.</summary>
    private List<Katalogfilterzeile> KatalogZiele()
    {
        if (_katalogWahl.Anzahl > 0)
            return _katalogWahl.Gewaehlte
                .Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s))
                .OfType<Katalogfilterzeile>().ToList();
        return _katalogZeile is null ? new() : new() { _katalogZeile };
    }

    private Task ProjektZeileKlick(GanglinienProjektZeile zeile)
    {
        _projektWahl.Klick(Projektschluessel(zeile), strg: false, umschalt: false, ProjektSchluessel());
        return ProjektZeileWaehlen(zeile);
    }

    private async Task BeiWahlGeaendert(Auswahlbereich bereich)
    {
        if (bereich != Auswahlbereich.Projekt || _projektWahl.Zuletzt is not string s) return;
        if (!_projektWahl.IstGewaehlt(s)) return;
        GanglinienProjektZeile? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == s);
        if (zeile is not null && zeile != _projektZeile) await ProjektZeileWaehlen(zeile);
    }

    private void BeiKatalogKaestchen(IReadOnlyList<string> gewaehlt)
    {
        _katalogKaestchen = gewaehlt;
        _katalogWahl.Setzen(gewaehlt);
    }

    private void KatalogKaestchenLeeren()
    {
        _katalogWahl.Leeren();
        _katalogKaestchen = new List<string>();
    }

    /// <summary>UeS2: der Stift einer Projektzeile — sie wird gewählt und ihre Ganglinie öffnet in der Satz-Überlagerung (nur Ansicht).</summary>
    private async Task BeiProjektStift(GanglinienProjektZeile zeile)
    {
        if (_projektZeile != zeile) await ProjektZeileWaehlen(zeile);
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// UeS2: der Stift einer Katalogzeile — ein gesperrter Satz öffnet zur Ansicht in der
    /// Satz-Überlagerung, ein ungesperrter die Verwaltung (KA‑E‑13); ohne Verwaltung die Überlagerung.
    /// </summary>
    private async Task BeiKatalogStift(Katalogfilterzeile zeile)
    {
        if (_katalogGewaehlt != zeile.Bezeichner) await KatalogZeileWaehlen(zeile.Bezeichner);
        if (!zeile.Geschuetzt && Verwaltung is not null)
        {
            BeiBearbeiten();
            return;
        }
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>Nach dem Schalten des Schlosses: Liste neu lesen, Status melden.</summary>
    private async Task BeiSchlossGeschaltet(string status)
    {
        await KatalogLaden();
        Melden(status ?? "", WarnStufe.Hinweis);
    }

    /// <summary>Warum nicht geschaltet wurde.</summary>
    private void BeiSchlossAbgelehnt(string grund) => Melden(grund ?? "", WarnStufe.Warnung);

    protected override void OnParametersSet()
    {
        // Der Kopf der WAHLSPALTE kommt weiter ueber den eigenen Text des Wirtes.
        Filtertexte.SpalteWahl = SpalteWahl;
    }

    protected override void OnInitialized()
    {
        // S2.5/S3.2: der Filterstand je Katalog, fuer die Sitzung, gemeinsam mit der
        // Verwaltung desselben Katalogs (Frage Q2).
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(
            Katalogprofil?.Schluessel ?? ("ZEITREIHE_" + Zeitreihenart.Stromganglinie));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await KatalogLaden();
        await _wurzel.FocusAsync(preventScroll: true);
        StateHasChanged();
    }

    /// <summary>Lädt den Katalog neu — beim Aufbau und nach jedem Katalogeingriff.</summary>
    public async Task KatalogLaden()
    {
        if (Katalogzeilen is null) return;
        // KT-3: Wirft die Quelle, bleibt die Liste leer und der Banner nennt den Grund.
        (_katalog, _listeFehler) = await Katalogladung.LesenAsync(Katalogzeilen, TitelText);
        VerwendungStempeln();
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
        _katalogKaestchen = _katalogWahl.Gewaehlte.ToList();

        if (_katalogZeile is null) return;

        _katalogZeile = _katalog.FirstOrDefault(z => z.Bezeichner == _katalogGewaehlt);
        if (_katalogZeile is null)
        {
            _katalogGewaehlt = "";
            GrafikVerwerfen();       // W12-E-2: die geloeschte Zeile nimmt ihre Grafik mit
        }
    }

    /// <summary>
    /// Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste aus der
    /// LEBENDEN Projektliste; der Dialog schreibt erst beim OK zurück.
    /// </summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    private Task ProjektZeileWaehlen(GanglinienProjektZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        return GrafikLaden(new GanglinienWahl(false, zeile.GanglinieId, zeile.Bezeichner));
    }

    private Task KatalogZeileWaehlen(string bezeichner)
    {
        Katalogfilterzeile? zeile = _katalog.FirstOrDefault(z => z.Bezeichner == bezeichner);
        if (zeile is null) return Task.CompletedTask;

        _katalogZeile = zeile;
        _katalogGewaehlt = zeile.Bezeichner;
        _projektZeile = null;
        _meldung = "";
        return GrafikLaden(new GanglinienWahl(true, 0, zeile.Bezeichner));
    }

    // =====================================================================
    // Die Grafik (W12-E-2)
    // =====================================================================

    /// <summary>
    /// Holt die Kennzahlen zur neuen Wahl. <b>Einmal je Markierung</b>, nicht je
    /// Zeichendurchgang: Dahinter liegen 8 760 Wertzeilen aus der Datenbank.
    /// </summary>
    private async Task GrafikLaden(GanglinienWahl wahl)
    {
        _wahl = wahl;
        _kennzahlen = null;
        _satzFehler = "";

        if (Kennzahlen is null) return;
        // KT-4: Wirft das Lesen der Ganglinie, nennt der Banner Satz und Grund; die Listen bleiben bedienbar.
        (_kennzahlen, _satzFehler) = await Katalogladung.SatzAsync(() => Kennzahlen(wahl), wahl.Bezeichner);
    }

    /// <summary>
    /// Was gerade markiert ist — die Namenszeile über der Grafik. Leer, solange
    /// nichts gewählt ist.
    /// </summary>
    private string GewaehlterName => _wahl?.Bezeichner ?? "";

    /// <summary>
    /// Die IDENTITÄT der gezeigten Ganglinie. Sie trennt die Projektzeile von dem
    /// gleichnamigen Katalogsatz: Beide dürfen denselben Bezeichner tragen, zeigen
    /// aber verschiedene Tabellen — ein gemeinsamer Schlüssel ließe den Bildvorrat
    /// des einen für den anderen gelten.
    /// </summary>
    private string Grafikschluessel
        => _wahl is null ? "" : (_wahl.AusKatalog ? "K|" : "P|") + _wahl.GanglinieId
                                + "|" + _wahl.Bezeichner;

    /// <summary>Was die Detailzeile zeigt (DZ1): die Zuordnung, den Katalogsatz oder keinen.</summary>
    private Satzmarke SatzArt => _projektZeile is not null ? Satzmarke.Projektsatz
                               : _katalogZeile is not null ? Satzmarke.Katalogsatz : Satzmarke.Keiner;

    /// <summary>Name des gewählten Satzes in der zugeklappten Detailzeile.</summary>
    private string? SatzName => SatzArt == Satzmarke.Keiner ? null
                              : _projektZeile?.Bezeichner ?? _katalogZeile?.Bezeichner;

    /// <summary>Der Bildauftrag der Grafik — die Wahl steckt schon darin.</summary>
    private Func<bool, Zeichenmodell?>? Grafikbild
        => (Bildauftrag is null || _wahl is null)
            ? null
            : sortiert => Bildauftrag(_wahl, sortiert);

    /// <summary>Der Bildauftrag in Behältergröße (DZ1‑N2) — die Wahl steckt schon darin.</summary>
    private Func<bool, int, int, Zeichenmodell?>? GrafikbildMass
        => (BildauftragMass is null || _wahl is null)
            ? null
            : (sortiert, breite, hoehe) => BildauftragMass(_wahl, sortiert, breite, hoehe);

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text;
        _meldungStufe = stufe;
    }

    // =====================================================================
    // Hinzufuegen und Entfernen
    // =====================================================================

    /// <summary>
    /// „◀" — der gewählte Katalogeintrag wird dem Projekt zugeordnet.
    ///
    /// <para><b>Ohne Dublettenprüfung</b> (Befund W12-B5, wörtlich): Derselbe
    /// Eintrag lässt sich beliebig oft zuordnen.</para>
    ///
    /// <para>Die Id des Katalogeintrags steht hier nicht; sie holt die Hülle beim
    /// Zurückschreiben über den Bezeichner
    /// (<c>StromganglinieStammCtrl.FindeStamm</c>, W12.0g). Der Vorläufer schlug
    /// dieselbe Zeile schon beim Hinzufügen nach — mit einem konkatenierten
    /// <c>SELECT</c> (Befund W12-B4).</para>
    /// </summary>
    private async Task BeiHinzu()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;

        // Sammelübernahme (4.5): je angekreuzter Katalogzeile eine Zuordnung; gewählt ist danach die letzte neue.
        GanglinienProjektZeile? neu = null;
        foreach (Katalogfilterzeile k in ziele)
        {
            neu = new GanglinienProjektZeile(_naechsterSchluessel++, 0, k.Bezeichner);
            Zeilen.Add(neu);
        }

        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
        await ProjektZeileWaehlen(neu!);
        Geaendert?.Invoke();
    }

    /// <summary>
    /// „▶" — die GEWÄHLTE Zuordnung fällt weg. <b>A-Zeile:</b> über die Zeile, nicht
    /// über den Namen; zwei gleich benannte Zuordnungen trafen im Vorläufer immer
    /// die erste.
    /// </summary>
    private void BeiEntfernen()
    {
        List<GanglinienProjektZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;
        // Entfernt GENAU die gewählten Zeilen (die angekreuzten, sonst die markierte).
        foreach (GanglinienProjektZeile z in ziele) Zeilen.Remove(z);
        _projektWahl.Leeren();
        _projektZeile = null;
        GrafikVerwerfen();
        Geaendert?.Invoke();
    }

    /// <summary>
    /// Die Grafik fällt weg, sobald ihre Zeile weg ist — beim Entfernen und immer
    /// dann, wenn der neu geladene Katalog die markierte Zeile nicht mehr führt.
    /// Eine Grafik ohne Zeile zeigte Zahlen zu etwas, das nicht mehr dasteht.
    /// </summary>
    private void GrafikVerwerfen()
    {
        _wahl = null;
        _kennzahlen = null;
    }

    // =====================================================================
    // Importieren (W12-E-1) - DERSELBE Weg wie in der Verwaltung
    // =====================================================================

    private async Task BeiImportieren()
    {
        if (!ImportMoeglich || _laeuft || _import is null) return;

        _meldung = "";

        // W13-B-1: Der Waehler DARF warten und wird await-et - nie synchron im
        // Blazor-Ereignis ausgewertet.
        string? pfad = await DateiWaehlen!(Dateifilter);
        if (string.IsNullOrEmpty(pfad)) return;      // abgebrochen: nichts passiert

        GanglinienImportErgebnis? erg = await _import.Starten(pfad, GanglinienRaster.Unbekannt);
        if (erg is null) return;

        if (!string.IsNullOrEmpty(erg.Meldung))
            Melden(erg.Meldung, GanglinienImportLauf.StufeZu(erg));

        if (erg.Ausgang == ImportAusgang.Erfolg) await KatalogLaden();
    }

    // =====================================================================
    // Loeschen (W12-E-1) - zwei Sperren, dann die Rueckfrage
    // =====================================================================

    private async Task BeiLoeschen()
    {
        if (!LoeschenErlaubt || Loeschen is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;

        // Die zwei Sperren (Muster W14b): Eine zugeordnete Ganglinie und ein Auslieferungssatz
        // bleiben stehen; Delete prueft das Schloss selbst, hier steht es davor, damit die
        // Rueckfrage nicht kommt. EIN Satz meldet seine Sperre; bei mehreren nennt die EINE
        // Rueckfrage die uebersprungenen.
        var zugeordnet = new List<Katalogfilterzeile>();
        foreach (Katalogfilterzeile z in ziele.Where(z => !z.Geschuetzt))
            if (HatProjektzuordnung is not null && await HatProjektzuordnung(z.Bezeichner)) zugeordnet.Add(z);

        if (ziele.Count == 1)
        {
            if (zugeordnet.Count > 0) { Melden(TextZuordnung, WarnStufe.Warnung); return; }
            if (ziele[0].Geschuetzt) { Melden(TextSchreibgeschuetzt, WarnStufe.Warnung); return; }
        }
        _loeschGesperrt = ziele.Where(z => z.Geschuetzt).ToList();
        _loeschZugeordnet = zugeordnet;
        _loeschziele = ziele.Except(_loeschGesperrt).Except(_loeschZugeordnet).ToList();
        if (_loeschziele.Count == 0)
        {
            Melden(_loeschZugeordnet.Count > 0 ? TextZuordnung : TextSchreibgeschuetzt, WarnStufe.Warnung);
            return;
        }

        _loeschfrageOffen = true;
    }

    /// <summary>Die EINE Rückfrage: ein Satz mit Namen, mehrere mit Zahl und Namen, dazu die übersprungenen.</summary>
    private string LoeschfrageText
    {
        get
        {
            string text = _loeschziele.Count <= 1
                ? string.Format(VorlageLoeschfrage, _loeschziele.FirstOrDefault()?.Bezeichner ?? "")
                : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, _loeschziele.Count,
                                string.Join(", ", _loeschziele.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschGesperrt.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                            string.Join(", ", _loeschGesperrt.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschZugeordnet.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.GANGL_UEBERSPRUNGEN_ZUGEORDNET,
                                            string.Join(", ", _loeschZugeordnet.Select(z => "„" + z.Bezeichner + "“")));
            return text;
        }
    }

    private async Task LoeschfrageBeantwortet(bool? antwort)
    {
        _loeschfrageOffen = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || Loeschen is null || ziele.Count == 0) return;

        var geloescht = new List<string>();
        string fehler = "";
        foreach (Katalogfilterzeile z in ziele)
        {
            // KT-4: Wirft der Löschweg, nennt die Meldung den Grund (Katalogladung.LoeschenAsync).
            string grund = "";
            bool weg = await Katalogladung.LoeschenAsync(() => Loeschen(z.Bezeichner), z.Bezeichner,
                                                         g => { grund = g; return false; });
            if (weg) geloescht.Add(z.Bezeichner);
            else if (fehler.Length == 0) fehler = grund.Length > 0 ? grund : TextSchreibgeschuetzt;
        }

        if (geloescht.Contains(_katalogGewaehlt)) { _katalogZeile = null; _katalogGewaehlt = ""; GrafikVerwerfen(); }
        if (geloescht.Count > 0) KatalogKaestchenLeeren();
        await KatalogLaden();
        if (fehler.Length > 0) Melden(fehler, WarnStufe.Warnung);
        else Melden(string.Format(VorlageGeloescht, string.Join(", ", geloescht)), WarnStufe.Erfolg);
    }

    // =====================================================================
    // Speichern unter (W12-E-1) - Kopie unter neuem Namen
    // =====================================================================

    private void BeiSpeichernUnter()
    {
        if (!KopierenErlaubt || _katalogZeile is null) return;
        _meldung = "";
        _kopieVorschlag = _katalogZeile.Bezeichner + KopieZusatz;
        _kopieOffen = true;
    }

    /// <summary>
    /// Die Dublettenprüfung VOR dem Einfügen — gegen den geladenen Katalog, also
    /// ohne zweite Abfrage und ohne Warten. Sie hält den Namensdialog offen und
    /// sagt, warum; der Kern prüft dieselbe Bedingung ein zweites Mal
    /// (<c>KopiereStamm</c> liefert dann <c>0</c>), damit kein UNIQUE-Fehler
    /// durchkommt.
    /// </summary>
    private string? KopieNamePruefen(string name)
        => _katalog.Any(z => string.Equals(z.Bezeichner, name, StringComparison.Ordinal))
            ? string.Format(TextNameVergeben, name)
            : null;

    private async Task KopieFertig(string? name)
    {
        _kopieOffen = false;
        if (string.IsNullOrWhiteSpace(name) || Kopieren is null || _katalogZeile is null) return;

        string quelle = _katalogZeile.Bezeichner;
        // KT-4: Wirft der Schreibweg, kommt die Ablehnung mit Grund zurück (Katalogladung.SchreibenAsync).
        string grund = "";
        bool ok = await Katalogladung.SchreibenAsync(() => Kopieren(quelle, name!), name, g => { grund = g; return false; });
        await KatalogLaden();
        Melden(ok ? string.Format(VorlageKopiert, quelle, name) : grund.Length > 0 ? grund : TextKopieFehler,
               ok ? WarnStufe.Erfolg : WarnStufe.Fehler);
    }

    // =====================================================================
    // Bearbeiten - die Verwaltung als Ueberlagerung
    // =====================================================================

    private void BeiBearbeiten()
    {
        _projektZeile = null;      // wie listBox_Auswahl.SelectedItems.Clear() (:112)
        if (_katalogZeile is null) GrafikVerwerfen();
        _verwaltungOffen = true;
    }

    /// <summary>
    /// Nach der Verwaltung wird der Katalog IMMER neu gezogen. Der Vorläufer tat es
    /// nur bei OK (:117) — die Verwaltung kann aber gelöscht oder eingelesen haben,
    /// und ihr einziger Fußknopf trägt ohnehin OK.
    /// </summary>
    private async Task VerwaltungFertig(bool ok)
    {
        _verwaltungOffen = false;
        await KatalogLaden();
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_katalogschloss?.FrageOffen == true) return Task.CompletedTask;

        // Jede Ebene prueft ihre eigenen Schalter, bevor sie Esc fuer sich
        // auswertet - so schliesst Esc immer nur die oberste (Muster W7.5).
        if (_verwaltungOffen || _loeschfrageOffen || _kopieOffen || _zweispalten?.SatzUeberlagerungOffen == true
            || _import?.EtwasOffen == true) return Task.CompletedTask;

        return Wizard ? Task.CompletedTask : Geschlossen.InvokeAsync(false);
    }
}
