    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _loeschenWeg = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.KLIMADATEN, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await RegionenLaden();
        await _wurzel.FocusAsync();
        StateHasChanged();
    }

