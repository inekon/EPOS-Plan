@* Die Ueberlagerung "Platzhalterkatalog" der Berichtsvorlagen (BV-E1, Konzept 9.1 D, 9.3
   und 9.7) - das Rueckgrat der Platzhaltererkennung: vollstaendig, auch fuer Schluessel ohne
   Gegenstueck in der App.

   WAS SIE ZEIGT. Ein Suchfeld und die Tabelle Schluessel · Art · Kontext · Beschreibung.
   Die Suche filtert ueber Schluessel UND Beschreibung (Wort fuer Wort, Gross- und
   Kleinschreibung gleich; "{{projekt.kunde}}" aus einer Vorlage findet seinen Eintrag). Ein
   Klick oder Tipp auf eine Zeile zeigt darunter den Platzhalter in der Schreibweise der
   Vorlage, {{schluessel}}, in einem nur lesbaren Textfeld - MARKIERT, damit er sich kopieren
   laesst. Die Zwischenablage nimmt die Marke (Vorlagenfeldknopf, IZwischenablage); hier
   bleibt es beim markierten Feld (Konzept 9.6).

   IN DER APP ZEIGEN (BV-E6, Konzept 9.3, 9.4). Unter der Schreibweise des gewaehlten Eintrags:
   Vorlagenfeldorte.Finde nennt die Orte, Vorlagenfeldzeige.Waehle den ersten lesend
   erreichbaren (nie den Projektassistenten). Der Knopf schaltet "Marken" ein, laesst die
   Marke aufleuchten, springt ueber Dienste.Navigation zur Ansicht und schliesst den Katalog.
   Ohne Ort ist er weich gesperrt (aria-disabled, Grund im title und in der Zeile darunter).

   DER BAUKASTEN (BV-E5, Konzept 6.3 Nr. 3, 9.7). "Baukasten speichern..." links in der
   Fussleiste, nur wenn der Wirt den Weg gibt (BaukastenSpeichern): Die Huelle fragt den Ort
   ueber den Speichern-Dialog der Plattform, der Kern erzeugt das Dokument aus dem Katalog; die
   Meldung steht im Fueller der Leiste. Solange er laeuft, ist der Knopf gesperrt.

   DIE ZEILE IST DIE WAHL: Klick auf die Zeile oder der Schluessel als Knopf (Tastatur,
   aria-pressed). Die Zeile traegt keinen Aktionsknopf, der erst beim Ueberfahren erschiene.

   KEIN ARBEITSSTAND. Der Katalog nimmt nichts auf - EIN primaerer Knopf "Schliessen"
   (Konzept 9.7); Esc und Kreuz wirken ebenso.

   DIE SUCHE GEHOERT DEM WIRT. Die Berichtsseite fuehrt sie (Suche/SucheChanged) und meldet
   sie beim Assistenten an - der Wirt meldet an, nicht das Blatt darin
   (KiMaskenabdeckungWacheTests, Tabelle WIRTE). Allein gezeigt fuehrt der Dialog sie selbst.

   MARKIEREN OHNE EIGENES SKRIPT. Das Textfeld des Hauses gibt sein Eingabeelement nicht
   heraus; der Dialog sucht es ueber document.querySelector unter der Kennung seiner Huelle
   (je Dialog eindeutig) und ruft dessen select() - zwei Aufrufe der JS-Bruecke, kein Skript
   in wwwroot. Die Bruecke loest einen Pfad nur ueber OBJEKTE auf (.NET 10,
   findObjectMember); ein Weg ueber einen Konstruktor wie Element.prototype scheiterte dort.
   Scheitert das Markieren (Pruefstand, Verbindung weg), bleibt das Feld lesbar und nur
   unmarkiert. *@

@namespace EPOS.UI.Dialoge.Berichte
@using System.Globalization
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject IServiceProvider Dienstverzeichnis

<div class="epos-dialog epos-vorlage-katalog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@Texte.Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" StandardKurztext="@Texte.Titel" Dialogname="@Texte.Titel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Schliessen" />
        }
    </div>

    <p class="epos-leisezeile epos-vorlage-kataloghinweis">@Texte.Hinweis</p>

    <div class="epos-vorlage-katalogsuche">
        <Textfeld Bezeichnung="@Texte.LabelSuche" Wert="@_suche" WertChanged="BeiSuche"
                  Platzhalter="@Texte.SuchePlatzhalter" />
    </div>

    @if (Alle.Count == 0)
    {
        <p class="epos-leisezeile epos-vorlage-katalogleer">@Texte.Leer</p>
    }
    else
    {
        <p class="epos-leisezeile epos-vorlage-katalogzahl" role="status">@Zahlzeile</p>

        @if (Treffer.Count == 0)
        {
            <p class="epos-leisezeile epos-vorlage-katalogleer">@Texte.KeinTreffer</p>
        }
        else
        {
            <div class="epos-raster-huelle epos-vorlage-kataloghuelle">
                <table class="epos-raster epos-vorlage-katalogtabelle" aria-label="@Texte.Liste">
                    <thead>
                        <tr>
                            <th scope="col">@Texte.SpalteSchluessel</th>
                            <th scope="col">@Texte.SpalteArt</th>
                            <th scope="col">@Texte.SpalteKontext</th>
                            <th scope="col">@Texte.SpalteBeschreibung</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Katalogzeile z in Treffer)
                        {
                            bool gewaehlt = IstGewaehlt(z);
                            <tr class="@(gewaehlt ? "epos-vorlage-katalogzeile epos-vorlage-katalogzeile--gewaehlt" : "epos-vorlage-katalogzeile")"
                                @onclick="() => Waehlen(z)">
                                <td class="epos-vorlage-katalogschluessel">
                                    <button type="button" class="epos-vorlage-katalogwahl"
                                            aria-pressed="@(gewaehlt ? "true" : "false")"
                                            aria-label="@Format(Texte.ZeileWaehlen, z.Schluessel)"
                                            @onclick="() => Waehlen(z)" @onclick:stopPropagation="true">@z.Schluessel</button>
                                </td>
                                <td>@z.Art</td>
                                <td>@z.Kontext</td>
                                <td class="epos-vorlage-katalogbeschreibung">@z.Beschreibung</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }

    @if (_gewaehlt is not null)
    {
        @* Die Schreibweise der Vorlage, nur lesbar und markiert (siehe Kopf). *@
        <div class="epos-vorlage-schreibweise" id="@_schreibweiseId">
            <Textfeld Bezeichnung="@Texte.LabelSchreibweise" NurLesen="true"
                      Wert="@Platzhalterkatalogsuche.Schreibweise(_gewaehlt.Schluessel)" />
        </div>
        <Herleitungszeile Text="@Texte.HinweisSchreibweise" />
        @if (!string.IsNullOrWhiteSpace(_gewaehlt.Beispiel))
        {
            <Herleitungszeile Text="@Format(Texte.Beispiel, _gewaehlt.Beispiel)" />
        }

        @* "In der App zeigen" (BV-E6, Konzept 9.4): nur zu einem lesend erreichbaren Ort, nie in
           den Projektassistenten; ohne Ort WEICH gesperrt - der Grund steht am Knopf (title) und
           darunter, ein Klick meldet ihn. *@
        var ziel = Zielort(_gewaehlt);
        Vorlagenfeldort? ort = ziel.Ort;
        Zeigegrund grund = ziel.Grund;
        <div class="epos-vorlage-katalogzeigen">
            <button type="button" class="epos-knopf epos-vorlage-katalogzeigen-knopf"
                    aria-disabled="@(ort is null ? "true" : null)"
                    title="@(ort is null ? Grundtext(grund) : Format(Texte.ZeigenOrt, ort.Element))"
                    @onclick="() => InDerAppZeigen(_gewaehlt)">@Texte.InDerAppZeigen</button>
            <Herleitungszeile Text="@(ort is null ? Grundtext(grund) : Format(Texte.ZeigenOrt, ort.Element))" />
        </div>
    }

    @* --- Die EINE Fussleiste: Baukasten speichern · Fueller · Schliessen (primaer) ---- *@
    <div class="epos-leiste">
        @if (BaukastenSpeichern is not null)
        {
            <button type="button" class="epos-knopf epos-vorlage-baukasten" disabled="@_baukastenLaeuft"
                    @onclick="BaukastenAusloesen">@Texte.BaukastenSpeichern</button>
        }
        <span class="epos-leiste-fueller epos-status" role="status">@_baukastenMeldung</span>
        <button type="button" class="epos-knopf epos-knopf--primaer epos-vorlage-schliessen"
                @onclick="Schliessen">@Texte.Schliessen</button>
    </div>
</div>

@code {
    // =====================================================================
    // Gaben — die Datenseite liegt in der Hülle
    // =====================================================================

    /// <summary>Die Einträge des Katalogs in Anzeigereihenfolge; leer = leerer Katalog.</summary>
    [Parameter] public IReadOnlyList<Katalogzeile> Eintraege { get; set; } = Array.Empty<Katalogzeile>();

    /// <summary>
    /// Die Suche — ANFANGSSTAND, und ein neuer Wert des Wirts ersetzt sie (der Assistent setzt
    /// sie über die Berichtsseite). Bindbar über <c>@@bind-Suche</c>.
    /// </summary>
    [Parameter] public string Suche { get; set; } = "";

    /// <summary>Meldet jede neue Suche an den Wirt.</summary>
    [Parameter] public EventCallback<string> SucheChanged { get; set; }

    /// <summary>Die Beschriftungen.</summary>
    [Parameter] public PlatzhalterkatalogTexte Texte { get; set; } = new();

    /// <summary>
    /// Hilfeschlüssel (Muster <c>&lt;Maske&gt;.btn_Help_&lt;Teil&gt;</c>): die Berichtsseite
    /// <c>UcBericht</c>, Teil Platzhalterkatalog.
    /// </summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "UcBericht.btn_Help_Platzhalterkatalog";

    /// <summary>Eigener Titel samt Kreuz; eingebettet setzt der Wirt <c>false</c>.</summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

    /// <summary>Der Dialog ist zu Ende — „Schließen", Kreuz oder Esc; es gibt kein Ergebnis.</summary>
    [Parameter] public EventCallback Geschlossen { get; set; }

    /// <summary>
    /// „Baukasten speichern…" — der Weg der Hülle; liefert die Meldung für die Fußleiste, <c>""</c> =
    /// abgebrochen. <c>null</c> = kein Knopf.
    /// </summary>
    [Parameter] public Func<Task<string>>? BaukastenSpeichern { get; set; }

    /// <summary>
    /// Die Orte eines Schlüssels in der App (BV-E6, „In der App zeigen"); <c>null</c> =
    /// <see cref="Vorlagenfeldorte.Finde"/>. Ein Prüfstand reicht eigene Orte herein.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<Vorlagenfeldort>>? OrteFinden { get; set; }

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    /// <summary>Die Kennung der Hülle um das Feld „Schreibweise" — je Dialog eindeutig.</summary>
    private readonly string _schreibweiseId = "epos-vorlage-schreibweise-" + Guid.NewGuid().ToString("N");
    private bool _markieren;

    private string _suche = "";
    private bool _baukastenLaeuft;
    private string _baukastenMeldung = "";

    /// <summary>Die Meldung des letzten „Baukasten speichern…" (Prüfhilfe für Tests).</summary>
    public string Baukastenmeldung => _baukastenMeldung;
    private string? _sucheGesehen;
    private Katalogzeile? _gewaehlt;

    private IReadOnlyList<Katalogzeile> _treffer = Array.Empty<Katalogzeile>();
    private IReadOnlyList<Katalogzeile>? _trefferAus;
    private int _trefferZahl = -1;
    private string? _trefferSuche;

    /// <summary>Die aktuelle Suche (Prüfhilfe für Tests).</summary>
    public string Suchtext => _suche;

    /// <summary>Der gewählte Schlüssel; <c>null</c> = keiner (Prüfhilfe für Tests).</summary>
    public string? GewaehlterSchluessel => _gewaehlt?.Schluessel;

    private IReadOnlyList<Katalogzeile> Alle => Eintraege ?? Array.Empty<Katalogzeile>();

    /// <summary>
    /// Die Treffer der Suche — neu gefiltert nur, wenn Liste (Referenz UND Zahl) oder Suche
    /// wechseln (kein Zeichenlauf rechnet, was sich nicht geändert hat).
    /// </summary>
    private IReadOnlyList<Katalogzeile> Treffer
    {
        get
        {
            if (ReferenceEquals(_trefferAus, Alle) && _trefferZahl == Alle.Count
                && string.Equals(_trefferSuche, _suche, StringComparison.Ordinal))
                return _treffer;

            _treffer = Platzhalterkatalogsuche.Filtern(Alle, _suche);
            _trefferAus = Alle;
            _trefferZahl = Alle.Count;
            _trefferSuche = _suche;
            return _treffer;
        }
    }

    /// <summary>„n Platzhalter" bzw. „n von m Platzhaltern", solange gesucht wird.</summary>
    private string Zahlzeile
        => string.IsNullOrWhiteSpace(_suche)
            ? Format(Texte.Anzahl, Alle.Count)
            : Format(Texte.AnzahlGefiltert, Treffer.Count, Alle.Count);

    private bool IstGewaehlt(Katalogzeile z)
        => _gewaehlt is not null && string.Equals(_gewaehlt.Schluessel, z.Schluessel, StringComparison.Ordinal);

    // =====================================================================
    // Aufbau
    // =====================================================================

    protected override void OnParametersSet()
    {
        // Die Suche des Wirts: ein NEUER Wert ersetzt die eigene, derselbe laesst sie stehen.
        if (!string.Equals(_sucheGesehen, Suche, StringComparison.Ordinal))
        {
            _sucheGesehen = Suche;
            _suche = Suche ?? "";
        }

        // Neue Eintraege: Die Wahl haengt am Schluessel und faellt nur, wenn er fehlt.
        if (_gewaehlt is not null)
            _gewaehlt = Alle.FirstOrDefault(z => z is not null
                        && string.Equals(z.Schluessel, _gewaehlt.Schluessel, StringComparison.Ordinal));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _ersterAufbau)
        {
            _ersterAufbau = false;
            await _wurzel.FocusAsync();
        }

        if (_markieren && _gewaehlt is not null)
        {
            _markieren = false;
            await Markieren();
        }
    }

    // =====================================================================
    // Suche und Wahl
    // =====================================================================

    private async Task BeiSuche(string text)
    {
        _suche = text ?? "";
        await SucheChanged.InvokeAsync(_suche);
    }

    private void Waehlen(Katalogzeile z)
    {
        _gewaehlt = z;
        _markieren = true;
    }

    /// <summary>
    /// Markiert die Schreibweise im nur lesbaren Feld: das Eingabeelement unter der Kennung der
    /// Hülle über <c>document.querySelector</c>, dann dessen <c>select()</c>. Ein Fehlschlag ist
    /// kein Fehler des Dialogs — das Feld bleibt lesbar und lässt sich von Hand markieren.
    /// </summary>
    private async Task Markieren()
    {
        try
        {
            IJSObjectReference? feld = await Js.InvokeAsync<IJSObjectReference?>(
                "document.querySelector", "#" + _schreibweiseId + " input");
            if (feld is null) return;
            try { await feld.InvokeVoidAsync("select"); }
            finally { await feld.DisposeAsync(); }
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (InvalidOperationException) { }
    }

    // =====================================================================
    // Schließen und Tastatur
    // =====================================================================

    private Task Schliessen() => Geschlossen.InvokeAsync();

    /// <summary>„Baukasten speichern…": den Weg der Hülle rufen, die Meldung zeigen; ein Abbruch lässt die Zeile leer.</summary>
    private async Task BaukastenAusloesen()
    {
        if (BaukastenSpeichern is null || _baukastenLaeuft) return;
        _baukastenLaeuft = true;
        try { _baukastenMeldung = await BaukastenSpeichern() ?? ""; }
        catch (Exception ex) { _baukastenMeldung = ex.Message; }
        finally { _baukastenLaeuft = false; }
    }

    // =====================================================================
    // In der App zeigen (BV-E6, Konzept 9.4)
    // =====================================================================

    /// <summary>Der erreichbare Ort des Eintrags oder der Grund, warum es keinen gibt.</summary>
    private (Vorlagenfeldort? Ort, Zeigegrund Grund) Zielort(Katalogzeile z)
    {
        IReadOnlyList<Vorlagenfeldort>? orte;
        try { orte = (OrteFinden ?? Vorlagenfeldorte.Finde)(z.Schluessel); }
        catch (Exception) { orte = null; }
        return Vorlagenfeldzeige.Waehle(orte);
    }

    private string Grundtext(Zeigegrund grund) => grund switch
    {
        Zeigegrund.NichtLesend => Texte.ZeigenNichtLesend,
        Zeigegrund.Assistent => Texte.ZeigenAssistent,
        _ => Texte.ZeigenKeinOrt,
    };

    /// <summary>
    /// Springt zum Ort — „Marken" an, die Marke leuchtet — und schließt den Katalog. Ohne Ort
    /// (weich gesperrt) oder wenn die Oberfläche die Ansicht nicht kennt, steht der Grund in der
    /// Fußleiste und der Katalog bleibt offen.
    /// </summary>
    private async Task InDerAppZeigen(Katalogzeile z)
    {
        (Vorlagenfeldort? ort, Zeigegrund grund) = Zielort(z);
        if (ort is null)
        {
            _baukastenMeldung = Grundtext(grund);
            return;
        }

        Vorlagenfeldansicht ansicht = Vorlagenfeldansicht.Aus(Dienstverzeichnis);
        if (!Vorlagenfeldzeige.Zeigen(ansicht, ort, z.Schluessel))
        {
            _baukastenMeldung = Texte.ZeigenFehler;
            return;
        }
        await Geschlossen.InvokeAsync();
    }

    /// <summary>Esc schließt; Enter bleibt unbelegt.</summary>
    private Task BeiTaste(KeyboardEventArgs e) => e.Key == "Escape" ? Schliessen() : Task.CompletedTask;

    private static string Format(string muster, params object[] werte)
    {
        try { return string.Format(CultureInfo.CurrentCulture, muster ?? "", werte); }
        catch (FormatException) { return (muster ?? "") + " " + string.Join(" ", werte); }
    }
}
