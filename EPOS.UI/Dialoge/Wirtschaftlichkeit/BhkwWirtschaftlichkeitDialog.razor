@* Dialog "BHKW-Wirtschaftlichkeit" - die Razor-Fassung (Etappe B5b).

   HERKUNFT. Die WinForms-Fassung Views/Wirtschaftlichkeit/
   Form_BhkwWirtschaftlichkeit.cs (Etappe B5, 03.09.2026) ist mit dieser
   Komponente GELOESCHT - Regel M1 des Umsetzungskonzepts iOS: keine zweite
   Fassung derselben Maske. Uebernommen sind Feldbestand, Reihenfolge,
   Nullsemantik, Zustandslogik, Warn- und Kohaerenzzeilen wortgleich; die
   Beschriftungen kommen aus denselben Schluesseln BHW_*
   (BhkwWirtschaftlichkeitTexte).

   ER RECHNET NICHTS (BW8). Saetze und Herleitung kommen aus dem Bestands-
   rechner KwkgSatzRechner, die Vorschauzahlen und die Steuerherkunft aus dem
   ZULETZT GEBUCHTEN Lauf, die Mengenkette aus KwkgModulNachweis (B3b), die
   Kohaerenzzeilen aus KohaerenzPruefung. Eine Zweitrechnung waere genau die
   zweite Wahrheit, die BW8 verhindern soll.

   ER KENNT KEINE DATENBANK (Hausregel EPOS.UI). Alles kommt als [Parameter]
   herein: die Anlagenzeilen, der Parametersatz, die Ergebnisse des Laufs und
   - als Delegat, wie es KwkgSatzRechner selbst haelt (Leitentscheidung L9) -
   der Zugang zum Gesetzeskatalog. Geschrieben wird ueber den Rueckruf
   Speichern; die Huelle ruft damit KwkgAnlagenCtrl.Speichere(g, true) (K7,
   elf Spalten) und WirtschaftlichkeitCtrl.SpeichereParameter.

   NULLSEMANTIK durchgehend: An der Anlage heisst leer bzw. 0 "kein eigener
   Wert - es gilt die Projektvorgabe" (E6-/B3a-Muster); nur beim
   Hilfsenergieanteil heisst 0 "keine Hilfsenergie" (BF4).

   TASTATUR. Eine BlazorWebView sieht AcceptButton und CancelButton des
   Formulars nicht; Esc wird deshalb hier beantwortet. Enter bleibt bewusst
   unbelegt - anders als beim Anlegedialog waere ein versehentliches Enter in
   einer Maske mit dreissig Feldern kein Bestaetigen, sondern ein Zufall. *@

@namespace EPOS.UI.Dialoge.Wirtschaftlichkeit

@using WindowsFormsApplication1
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@Kopftitel</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
    </div>

    @* ------------------------------------------------ Gruppe 1: Anlagen *@
    <Gruppenkopf Titel="@_t.G1" Symbol="⚙">
        <KindInhalt>
            <Raster TZeile="KwkgAnlagenAngabe" Zeilen="@Anlagen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpWahl">
                        <button type="button"
                                class="@Wahlklasse(context)"
                                aria-pressed="@(Gewaehlt(context) ? "true" : "false")"
                                @onclick="() => Waehle(context)">@(Gewaehlt(context) ? "●" : "○")</button>
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpProjekt">
                        @context.Projektname
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpAnlage">
                        @context.Bezeichner
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpPel">
                        @context.PelKW.ToString("N0", BhwTexte.Kultur)
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpBrennstoff">
                        @context.Brennstoffname
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpStichtag">
                        @BhwTexte.Kurzdatum(Tag(context.Stichtag))
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpIbn">
                        @BhwTexte.Kurzdatum(Tag(context.Inbetriebnahme))
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpAnlagenart">
                        @BhkwWahlen.TextZu(_artA, context.Anlagenart)
                    </TemplateColumn>
                </KindInhalt>
            </Raster>

            @foreach (string zeile in Anlagenwarnungen())
            {
                <Warnbanner Stufe="WarnStufe.Warnung" Text="@zeile" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------- Gruppe 1b: Angaben der gewaehlten Anlage *@
    <Gruppenkopf Titel="@_t.G1b">
        <KindInhalt>
            @if (Aktuelle is null)
            {
                <Herleitungszeile Text="@_t.AOhneWahl" />
            }
            else
            {
                <Datumsfeld Bezeichnung="@_t.AStichtag"
                            Wert="@Tag(Aktuelle.Stichtag)" WertChanged="StichtagA" />

                <Datumsfeld Bezeichnung="@_t.AIbn"
                            Wert="@Tag(Aktuelle.Inbetriebnahme)" WertChanged="IbnA" />

                <Auswahlfeld Bezeichnung="@_t.AAnlagenart"
                             Eintraege="@BhkwWahlen.Eintraege(_artA)"
                             Auswahl="@BhkwWahlen.NummerZu(_artA, Aktuelle.Anlagenart)"
                             AuswahlChanged="ArtA" />

                <Auswahlfeld Bezeichnung="@_t.AEigenfall"
                             Eintraege="@BhkwWahlen.Eintraege(_fallA)"
                             Auswahl="@BhkwWahlen.NummerZu(_fallA, Aktuelle.Eigenfall)"
                             AuswahlChanged="FallA" />

                <Zahlenfeld Bezeichnung="@_t.ASatzEinsp" Einheit="ct/kWh"
                            Min="0" Max="30" Nachkommastellen="2"
                            Wert="@Aktuelle.SatzEinspCt" WertChanged="SatzEinspA" />

                <Zahlenfeld Bezeichnung="@_t.ASatzEigen" Einheit="ct/kWh"
                            Min="0" Max="30" Nachkommastellen="2"
                            Wert="@Aktuelle.SatzEigenCt" WertChanged="SatzEigenA" />

                <Zahlenfeld Bezeichnung="@_t.AKontingent" Einheit="h"
                            Min="0" Max="200000" Nachkommastellen="0"
                            Wert="@Aktuelle.VbhKontingent" WertChanged="KontingentA" />

                <Zahlenfeld Bezeichnung="@_t.ADeckel" Einheit="h/a"
                            Min="0" Max="8760" Nachkommastellen="0"
                            Wert="@Aktuelle.VbhDeckel" WertChanged="DeckelA" />

                <Auswahlfeld Bezeichnung="@_t.AEnergiesteuer"
                             Eintraege="@BhkwWahlen.Eintraege(_esA)"
                             Auswahl="@BhkwWahlen.NummerZu(_esA, Aktuelle.EnergiesteuerWahl)"
                             AuswahlChanged="EnergiesteuerA" />

                <Auswahlfeld Bezeichnung="@_t.AAufteilung"
                             Eintraege="@BhkwWahlen.Eintraege(_aufA)"
                             Auswahl="@BhkwWahlen.NummerZu(_aufA, Aktuelle.AufteilungMethode)"
                             AuswahlChanged="AufteilungA" />

                @* K2/K6: Die Bemessungsbasis steht ausdruecklich in der Beschriftung -
                   gerechnet wird am ENDENERGIEbedarf (Brennstoff) der Anlage, nicht an
                   den Kosten; die Saetze der beiden Wege sind nicht austauschbar.
                   Das Feld ist nur fuer BHKW-Anlagen gedacht (AnteilPflegbar). *@
                @if (AnteilSichtbar)
                {
                    <Zahlenfeld Bezeichnung="@_t.AHilfsanteil" Einheit="%"
                                Min="0" Max="100" Nachkommastellen="1"
                                Wert="@Aktuelle.HilfsenergieAnteil" WertChanged="HilfsAnteilA" />
                    <Herleitungszeile Text="@_t.AHilfsBasis" />
                }
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------- Gruppe 2: KWK-Zuschlag *@
    <Gruppenkopf Titel="@_t.G2">
        <KindInhalt>
            <Zahlenfeld Bezeichnung="@_t.PBonusEigen" Einheit="ct/kWh"
                        Min="0" Max="30" Nachkommastellen="2"
                        Wert="@Parameter.KwkgBonus" WertChanged="BonusEigenP" />

            <Zahlenfeld Bezeichnung="@_t.PBonusEinsp" Einheit="ct/kWh"
                        Min="0" Max="30" Nachkommastellen="2"
                        Wert="@Parameter.KwkgBonusEinspeisung" WertChanged="BonusEinspP" />

            <Zahlenfeld Bezeichnung="@_t.PDeckel" Einheit="h/a"
                        Min="0" Max="8760" Nachkommastellen="0"
                        Wert="@Parameter.KwkgVbhJahresdeckel" WertChanged="DeckelP" />

            <Zahlenfeld Bezeichnung="@_t.PKontingent" Einheit="h"
                        Min="0" Max="200000" Nachkommastellen="0"
                        Wert="@Parameter.KwkgVbhKontingent" WertChanged="KontingentP" />

            <Zahlenfeld Bezeichnung="@_t.PAbschlag" Einheit="%"
                        Min="0" Max="50" Nachkommastellen="1"
                        Wert="@Parameter.KwkgAbschlagNegativ" WertChanged="AbschlagP" />

            <Auswahlfeld Bezeichnung="@_t.PTatbestand"
                         Eintraege="@BhkwWahlen.Eintraege(_fallP)"
                         Auswahl="@BhkwWahlen.NummerZu(_fallP, Parameter.KwkgTatbestand)"
                         AuswahlChanged="TatbestandP" />

            <Auswahlfeld Bezeichnung="@_t.PAnlagenart"
                         Eintraege="@BhkwWahlen.Eintraege(_artP)"
                         Auswahl="@BhkwWahlen.NummerZu(_artP, Parameter.KwkgAnlagenart)"
                         AuswahlChanged="AnlagenartP" />

            <Zahlenfeld Bezeichnung="@_t.PKostenanteil" Einheit="%"
                        Min="0" Max="100" Nachkommastellen="1"
                        Wert="@Parameter.KwkgKostenanteil" WertChanged="KostenanteilP" />

            <Schalter Bezeichnung="@_t.PPauschal"
                      Wert="@Parameter.KwkgPauschalmodus" WertChanged="PauschalP" />

            <Datumsfeld Bezeichnung="@_t.PStichtag"
                        Wert="@Tag(Parameter.KwkgStichtag)" WertChanged="StichtagP" />

            <Datumsfeld Bezeichnung="@_t.PIbn"
                        Wert="@Tag(Parameter.KwkgInbetriebnahme)" WertChanged="IbnP" />

            @* Herleitungszeilen je Anlage - Bestand KwkgSatzRechner.Vorschlag. *@
            @foreach (string zeile in Herleitung())
            {
                <Herleitungszeile Text="@zeile" />
            }

            <button type="button" class="epos-knopf epos-vorschlag" @onclick="VorschlagUebernehmen"
                    disabled="@(Aktuelle is null)">@_t.BtnVorschlag</button>
        </KindInhalt>
    </Gruppenkopf>

    @* -------------------------------------------- Gruppe 3: Energiesteuer *@
    <Gruppenkopf Titel="@_t.G3">
        <KindInhalt>
            <Auswahlfeld Bezeichnung="@_t.EWahl"
                         Eintraege="@BhkwWahlen.Eintraege(_esP)"
                         Auswahl="@BhkwWahlen.NummerZu(_esP, Parameter.EnergiesteuerWahl)"
                         AuswahlChanged="EnergiesteuerP" />

            <Auswahlfeld Bezeichnung="@_t.EAufteilung"
                         Eintraege="@BhkwWahlen.Eintraege(_aufP)"
                         Auswahl="@BhkwWahlen.NummerZu(_aufP, Parameter.AufteilungMethode)"
                         AuswahlChanged="AufteilungP" />

            @* K5: Der Jahresnutzungsgrad bleibt eine PROJEKTgroesse (B3a-Stand) - ein
               anlagenscharfer Wert waere eine eigene Datenfrage. *@
            <Zahlenfeld Bezeichnung="@_t.ENutzungsgrad" Einheit="%"
                        Min="0" Max="100" Nachkommastellen="1"
                        Wert="@Parameter.Jahresnutzungsgrad" WertChanged="NutzungsgradP" />

            <Herleitungszeile Text="@Steuerherkunft()" />
        </KindInhalt>
    </Gruppenkopf>

    @* --------------------------------------------- Gruppe 4: Stromsteuer *@
    <Gruppenkopf Titel="@_t.G4">
        <KindInhalt>
            @* BW4: Die Unternehmensart ist das fuehrende Feld der Stromsteuerseite. *@
            <Auswahlfeld Bezeichnung="@_t.SUnternehmensart"
                         Eintraege="@BhkwWahlen.Eintraege(_uaP)"
                         Auswahl="@BhkwWahlen.NummerZu(_uaP, Parameter.Unternehmensart)"
                         AuswahlChanged="UnternehmensartP" />

            <Schalter Bezeichnung="@_t.SRaeumlich"
                      Wert="@Parameter.RaeumlicherZusammenhang" WertChanged="RaeumlichP" />

            <Schalter Bezeichnung="@_t.SHocheffizienz"
                      Wert="@Parameter.HocheffizienzNachweis" WertChanged="HocheffizienzP" />

            @* K3 = a (Anwenderentscheid 03.09.2026): Das Modusfeld des § 9 Abs. 1 Nr. 3
               (BW3) wird GEZEIGT, aber deaktiviert - die Persistenzspalte
               Stromst_Befreiung_Modus kommt erst mit M-3 (Etappe B6). B5/B5b legt dafuer
               ausdruecklich KEINEN Schemaschritt an, und der Wert wird nirgends
               gespeichert; die Vorgabe "Ausweis" (BF1) ist der heutige Rechenstand. *@
            <Auswahlfeld Bezeichnung="@_t.SModus"
                         Eintraege="@BhkwWahlen.Eintraege(_modus)" Auswahl="0" Aktiv="false" />
            <Herleitungszeile Text="@_t.SModusB6" />

            <button type="button" class="epos-knopf epos-sprung"
                    @onclick="SprungStrombezug">@_t.BtnStrombezug</button>

            @* Kein Funktionsverlust durch K8 = c: Der Knopf der Wirtschaftlichkeitsseite,
               der bis B5 die BHKW-Sicht der Tarifstruktur oeffnete, fuehrt jetzt hierher -
               die Sicht selbst bleibt ueber diesen Sprung erreichbar. *@
            <button type="button" class="epos-knopf epos-sprung"
                    @onclick="SprungBhkwTarif">@_t.BtnBhkwTarif</button>

            <Herleitungszeile Text="@_t.SSprungHinweis" />
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------- Kohaerenzpruefung (A-2) *@
    <Gruppenkopf Titel="@_t.GKohaerenz">
        <KindInhalt>
            @if (SteuerlicheHinweise().Count == 0)
            {
                <Kohaerenzzeile Zustand="KohaerenzZustand.Ok" Text="@_t.KLeer" />
            }
            else
            {
                @foreach (KohaerenzHinweis h in SteuerlicheHinweise())
                {
                    <Warnbanner Stufe="@Stufe(h.Schwere)" Text="@h.Text" />
                }
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ---------------------------------------------- Gruppe 5: Hilfsstrom *@
    <Gruppenkopf Titel="@_t.G5">
        <KindInhalt>
            @* K1: Es gibt bewusst KEIN Feld "Deckung je Modul" - die Spalte ist mit
               § 4.5 des Konzepts gestrichen (BW6). *@
            <Herleitungszeile Text="@_t.HBasis" />

            @foreach (string zeile in Mengenkette())
            {
                <Herleitungszeile Text="@zeile" />
            }

            @foreach (KohaerenzHinweis h in Doppelpflegehinweise())
            {
                <Warnbanner Stufe="@Stufe(h.Schwere)" Text="@h.Text" />
            }

            @* K6: Der Anteil gilt formal fuer jede Anlagenart, gelesen wird er in B3 aber
               nur fuer BHKW und Kessel. Gepflegt wird er hier allein am BHKW; fuer Kessel
               steht hier der Verweis, die Waermepumpe kommt spaeter. *@
            @if (Kesselhinweis)
            {
                <Herleitungszeile Text="@_t.HKessel" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------------ Gruppe 6: Vorschau *@
    <Gruppenkopf Titel="@_t.G6" Symbol="Σ">
        <KindInhalt>
            @foreach ((string Titel, string Wert) z in Vorschau())
            {
                <Herleitungszeile Text="@z.Titel" Formel="@z.Wert" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_meldung" />
    }

    <SpeichernLeiste @ref="_leiste" MitSpeichern="true" MitAbbrechen="false"
                     SatzMarkiert="true" Geaendert="_geaendert" OkText="@_t.Schliessen"
                     Gespeichertwerden="Speichern_Klick" Ergebnis="BeiErgebnis" />
</div>

@code {
    // =====================================================================
    // Was hereinkommt
    // =====================================================================

    /// <summary>Anzeigename des Stammprojekts - er steht hinter dem Titel.</summary>
    [Parameter] public string StammName { get; set; } = "";

    /// <summary>
    /// Die BHKW-Anlagen der Vergleichsgruppe (<c>KwkgAnlagenCtrl.LadeGruppe</c>),
    /// fertig geladen. Der Dialog schreibt seine Eingaben in DIESE Objekte zurueck -
    /// genau wie die WinForms-Fassung; die Huelle speichert danach dieselben Zeilen.
    /// </summary>
    [Parameter] public IList<KwkgAnlagenAngabe> Anlagen { get; set; } = new List<KwkgAnlagenAngabe>();

    /// <summary>Der Parametersatz des Stammprojekts
    /// (<c>WirtschaftlichkeitCtrl.LadeParameter</c>). Auch er wird an Ort und Stelle
    /// fortgeschrieben.</summary>
    [Parameter] public WirtschaftlichkeitParameter Parameter { get; set; } = new WirtschaftlichkeitParameter();

    /// <summary>Id des Stammprojekts - Bezugspunkt von Vorschau und Steuerherkunft.</summary>
    [Parameter] public int IdStamm { get; set; }

    /// <summary>true, wenn die Vergleichsgruppe einen Heizkessel fuehrt
    /// (<c>ErzeugerFlags.Heizkessel</c>) - dann erscheint der K6-Hinweis.</summary>
    [Parameter] public bool HatHeizkessel { get; set; }

    /// <summary>
    /// Lesefassade auf <c>Tab_Gesetzesparameter</c>
    /// (<c>GesetzKatalog.WertMitHerkunft</c>) - dieselbe Uebergabe als Delegat, die
    /// <c>KwkgSatzRechner</c> selbst verlangt (Leitentscheidung L9). <c>null</c> =
    /// kein Katalog; dann gelten die Rueckfallwerte, und die Herleitung sagt es.
    /// </summary>
    [Parameter] public Func<string, int, GesetzParameter>? Katalog { get; set; }

    /// <summary>Die laufunabhaengige Doppelpflege-Pruefung
    /// (<c>KohaerenzPruefung.Pruefe(idStamm, null)</c>) - der Zweig, der keinen
    /// Steuerlauf braucht. Sie ruft die Huelle, weil die Pruefung <c>internal</c> zum
    /// Kern ist.</summary>
    [Parameter] public IReadOnlyList<KohaerenzHinweis> Doppelpflege { get; set; }
        = Array.Empty<KohaerenzHinweis>();

    /// <summary>
    /// Die Ergebnisse des zuletzt GERECHNETEN Laufs, vom Wirt durchgereicht.
    ///
    /// <para>Zwei ihrer Bestandteile sind nicht persistiert und deshalb aus der
    /// Datenbank nicht zu holen: die Kohaerenzhinweise (B2-O4) und die
    /// KWKG-Modulnachweise mit der Mengenkette (E7/B3b). Leere Liste = noch nicht
    /// gerechnet; dann fallen Vorschau und Steuerherkunft auf den gebuchten Stand
    /// zurueck (<see cref="ErgebnisseLaden"/>).</para>
    /// </summary>
    [Parameter] public IReadOnlyList<WirtschaftlichkeitErgebnis> ErgebnisseAusLauf { get; set; }
        = Array.Empty<WirtschaftlichkeitErgebnis>();

    /// <summary>Der gebuchte Stand aus der Datenbank
    /// (<c>WirtschaftlichkeitCtrl.LadeErgebnisse</c>) - nur gerufen, wenn kein Lauf
    /// durchgereicht wurde.</summary>
    [Parameter]
    public Func<IReadOnlyList<int>, IReadOnlyList<WirtschaftlichkeitErgebnis>>? ErgebnisseLaden { get; set; }

    /// <summary>
    /// Schreibt den Bildschirmzustand fort und liefert die Zahl der GESCHEITERTEN
    /// Saetze (0 = alles gespeichert).
    ///
    /// <para><b>Warum kein <c>EventCallback</c>.</b> Die Speichernleiste braucht eine
    /// Antwort - „gespeichert um 12:03" oder „nicht gespeichert". Ein
    /// <c>EventCallback</c> liefert keine; der Rueckruf zum Schliessen
    /// (<see cref="Geschlossen"/>) bleibt deshalb einer, dieser hier ist ein
    /// <see cref="Func{TResult}"/>.</para>
    /// </summary>
    [Parameter] public Func<int>? Speichern { get; set; }

    /// <summary>Der Dialog ist zu Ende. Geschlossen wird das Fenster von der Huelle,
    /// nicht von der Komponente.</summary>
    [Parameter] public EventCallback<BhkwWirtschaftlichkeitErgebnis> Geschlossen { get; set; }

    /// <summary>Schluessel des Hilfeknopfes - die Zeile in <c>help_mapping.txt</c>.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_BhkwWirtschaftlichkeit.btn_Help";

    /// <summary>Rueckfallgrenze der Ausschreibungswarnung [kW], wenn der Katalog
    /// schweigt (<c>WirtschaftlichkeitCtrl.KWKG_MAX_LEISTUNG_KW</c> = 500).</summary>
    [Parameter] public double GrenzeAusschreibungRueckfall { get; set; } = 500;

    /// <summary>Rueckfallgrenze der Stromsteuerwarnung [kW]
    /// (<c>STROMST_GRENZE_BEFREIUNG_9_1_3_KW</c> = 2000).</summary>
    [Parameter] public double GrenzeStromsteuerRueckfall { get; set; } = 2000;

    // =====================================================================
    // Zustand
    // =====================================================================

    private readonly BhkwWirtschaftlichkeitTexte _t = new BhkwWirtschaftlichkeitTexte();

    private ElementReference _wurzel;
    private SpeichernLeiste? _leiste;
    private bool _ersterAufbau = true;

    private int _aktuell = -1;
    private bool _geaendert;
    private bool _gespeichert;
    private string _meldung = "";

    private IReadOnlyList<Steuerwahl> _artA = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _fallA = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _esA = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _aufA = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _artP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _fallP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _esP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _aufP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _uaP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _modus = Array.Empty<Steuerwahl>();

    private List<WirtschaftlichkeitErgebnis>? _ergebnisCache;

    /// <summary>Die Beschriftungen des Dialogs (Pruefhilfe fuer den Feldkarten-Abgleich).</summary>
    public BhkwWirtschaftlichkeitTexte Texte => _t;

    /// <summary>true, wenn mindestens einmal gespeichert wurde (Pruefhilfe fuer Tests).</summary>
    public bool Gespeichert => _gespeichert;

    /// <summary>true, wenn seit dem letzten Speichern etwas geaendert wurde.</summary>
    public bool Geaendert => _geaendert;

    /// <summary>Die gewaehlte Anlagenzeile; <c>null</c> = keine.</summary>
    public KwkgAnlagenAngabe? Aktuelle =>
        _aktuell >= 0 && _aktuell < Anlagen.Count ? Anlagen[_aktuell] : null;

    /// <summary>
    /// K6 - der Hilfsenergieanteil ist nur bei BHKW-Anlagen pflegbar.
    ///
    /// <para>Die Spalte <c>Hilfsenergie_Anteil</c> gilt formal fuer jede Komponente
    /// (Konzept § 5.2), gelesen wird sie in B3 aber nur fuer BHKW und Heizkessel.
    /// Der Kessel bekommt in Gruppe 5 einen Hinweis statt eines Feldes - sein
    /// Hilfsstrom ist reiner Ausweis ohne Strommengenwirkung (B3b) -, die
    /// Waermepumpe bleibt einer spaeteren Etappe vorbehalten.</para>
    /// </summary>
    public static bool AnteilPflegbar(int idType) => idType == WizardItemClass.BHKW_TYP;

    /// <summary>Zeigt den Hinweis fuer Kessel bzw. blendet ihn aus; die Waermepumpe
    /// bekommt weder Feld noch Hinweis.</summary>
    public static bool AnteilHinweis(int idType) => idType == WizardItemClass.KESSEL_TYP;

    /// <summary>Der Dialog fuehrt ausschliesslich BHKW-Anlagenzeilen (<c>LadeGruppe</c>
    /// filtert auf <c>ID_Type = BHKW_TYP</c>) - das Feld ist deshalb sichtbar, sobald
    /// eine Zeile gewaehlt ist.</summary>
    public bool AnteilSichtbar => Aktuelle is not null && AnteilPflegbar(WizardItemClass.BHKW_TYP);

    /// <summary>Der Kessel-Hinweis der Gruppe 5.</summary>
    public bool Kesselhinweis => HatHeizkessel && AnteilHinweis(WizardItemClass.KESSEL_TYP);

