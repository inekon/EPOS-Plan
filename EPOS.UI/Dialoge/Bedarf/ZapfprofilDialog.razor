    // Der Hilfe-Assistent (Welle #458, Stufe 3a)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private ZapfprofilKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten auf den ARBEITSSTAND: Stufe, Zonenwahl, die Zonen als
    /// Spalten, die Ansicht der Vorschau und die Stochastik der Stufe Experte. Gesetzt wird
    /// auf den Wegen der Eingabefelder — die Vorschau rechnet entprellt neu wie nach einer
    /// Eingabe von Hand.
    /// </summary>
    private ZapfprofilKiSicht KiSicht() => _kiSicht ??= new ZapfprofilKiSicht
    {
        StufeLesen = () => (int)_stufe,
        StufeSetzen = KiStufe,
        StufeEintraege = () => KiMaskenanmeldung.Eintraege(Stufen, e => e.Id, e => e.Text),

        ZoneLesen = () => _wahl >= 0 && _wahl < _eingabe.Zonen.Count ? _wahl + 1 : null,
        ZoneSetzen = KiZoneWaehlen,
        ZoneEintraege = () => KiMaskenanmeldung.Eintraege(
            Enumerable.Range(0, _eingabe.Zonen.Count), i => i + 1, i => _eingabe.Zonen[i].Name),

        ZonenLesen = () => _eingabe.Zonen.Select(KiZeile).ToList(),
        NutzungsartEintraege = () => KiMaskenanmeldung.Eintraege(Daten.Katalog, n => n.Id, n => n.Name),
        NiveauEintraege = () => KiMaskenanmeldung.Eintraege(Niveaus, e => e.Id, e => e.Text),

        AnsichtLesen = () => Ansicht is null ? null
                           : _ansicht >= 0 && _ansicht < _vorschau!.Ansichten.Count ? _ansicht : 0,
        AnsichtSetzen = KiAnsicht,
        AnsichtEintraege = () => KiMaskenanmeldung.Eintraege(
            Ansicht is null ? Array.Empty<(int Id, string Text)>() : Ansichtswahl, e => e.Id, e => e.Text),

        RechenwegLesen = () => _eingabe.JahresreiheStochastisch ? RECHENWEG_STOCHASTISCH : RECHENWEG_DETERMINISTISCH,
        RechenwegSetzen = KiRechenweg,
        RechenwegEintraege = () => KiMaskenanmeldung.Eintraege(Rechenwege, e => e.Id, e => e.Text),

        SeedLesen = () => _eingabe.Seed,
        SeedSetzen = KiSeed,
        RealisierungenLesen = () => _eingabe.Realisierungen,
        RealisierungenSetzen = KiRealisierungen
    };

    /// <summary>Eine Zone als Zeile der Sicht — ihre Setzer nehmen den Weg der Eingabefelder.</summary>
    private ZapfprofilZoneKiZeile KiZeile(ZapfprofilZoneDaten z) => new(z)
    {
        ZonennameSetzen = w => KiInZone(z, () => ZonennameSetzen(z, w)),
        NutzungsartSetzen = id => KiNutzungsart(z, id),
        BezugsmengeSetzen = w => KiInZone(z, () => ZonenBezugsmengeSetzen(z, w)),
        NiveauSetzen = id => KiInZone(z, () => ZonenNiveauSetzen(z, id)),
        JahresbedarfLesen = () => Zonenwert(_eingabe.Zonen.IndexOf(z))
    };

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf: auffrischen und prüfen.
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg</b> — „OK" gibt den Arbeitsstand an die Bedarfsprofile zurück,
    /// und geschrieben wird mit deren OK; beides bleibt der Klick des Anwenders
    /// (<c>dialog_speichern</c> lehnt benannt ab). <b>Prüfen</b> ist der Befund des OK.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => OkBefund().Text
    };

    /// <summary>Die Stufe wie in der Optionsgruppe; „Erweitert" ist gesperrt und nennt den Grund.</summary>
    private string? KiStufe(int? id)
    {
        if (id == (int)ZapfprofilStufe.Erweitert) return Texte.GrundNochNicht;
        StufeWaehlen(id);
        return null;
    }

    /// <summary>Die Zone wählen wie ein Klick in die Liste — nach ihrer Nummer (ab 1).</summary>
    private string? KiZoneWaehlen(int? nummer)
    {
        if (nummer is not int n || n < 1 || n > _eingabe.Zonen.Count) return ZapfprofilKiRegeln.ZeileFehlt;
        ZoneWaehlen(n - 1);
        return null;
    }

    /// <summary>Ein Setzweg einer Zone — nur, solange die Zone in der Liste steht.</summary>
    private string? KiInZone(ZapfprofilZoneDaten z, Action weg)
    {
        if (!_eingabe.Zonen.Contains(z)) return ZapfprofilKiRegeln.ZeileFehlt;
        weg();
        return null;
    }

    /// <summary>Die Nutzungsart einer Zone; eine gesperrte nennt ihren Grund wie die Auswahlliste.</summary>
    private string? KiNutzungsart(ZapfprofilZoneDaten z, int? id)
    {
        if (id is int n && Nutzungsart(n) is { Waehlbar: false } art)
            return art.Sperrgrund.Length > 0 ? art.Sperrgrund : ZapfprofilKiRegeln.Gesperrt(art.Name);
        return KiInZone(z, () => ZonenNutzungsartSetzen(z, id));
    }

    /// <summary>„Anzeigen für" — nur mit gerechneter Vorschau; sonst ihr Grund.</summary>
    private string? KiAnsicht(int? id)
    {
        if (Ansicht is null) return VorschauGrund;
        AnsichtWaehlen(id);
        return null;
    }

    /// <summary>Der Rechenweg der Jahresreihe — er steht ab der Stufe Experte auf der Maske.</summary>
    private string? KiRechenweg(int? id)
    {
        if (_stufe == ZapfprofilStufe.Einfach)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelRechenwegJahresreihe, Texte.StufeExperte);
        RechenwegSetzen(id);
        return null;
    }

    /// <summary>Der Seed — Stufe Experte, ganze Zahl ab 0; leer = Vorgabe.</summary>
    private string? KiSeed(int? wert)
    {
        if (_stufe != ZapfprofilStufe.Experte)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelSeed, Texte.StufeExperte);
        string? grund = ZapfprofilKiRegeln.Bereich(Texte.LabelSeed, wert, 0, null);
        if (grund is not null) return grund;
        SeedSetzen(wert);
        return null;
    }

    /// <summary>Die Realisierungen — Stufe Experte beim Rechenweg „stochastisch", in den Grenzen des Feldes.</summary>
    private string? KiRealisierungen(int? wert)
    {
        if (_stufe != ZapfprofilStufe.Experte)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelRealisierungen, Texte.StufeExperte);
        if (!_eingabe.JahresreiheStochastisch)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelRealisierungen, Texte.OptionStochastisch);
        string? grund = ZapfprofilKiRegeln.Bereich(Texte.LabelRealisierungen, wert,
                                                   Daten.RealisierungenMindestens, Daten.RealisierungenHoechstens);
        if (grund is not null) return grund;
        RealisierungenSetzen(wert);
        return null;
    }

    // =================================================================================
    // Auslegung (Stufe Z2)
    // =================================================================================

    /// <summary>Der Titel der Überlagerung — aus dem Textbündel der Auslegung, sonst der Knopftext.</summary>
    private string AuslegungTitel
        => _auslegungGaben is not null && _auslegungGaben.TryGetValue("Texte", out object? t) && t is ZapfprofilAuslegungTexte texte
            ? texte.Titel : Texte.KnopfAuslegung.TrimEnd('…');

    /// <summary>Der übernommene Punkt als Kurztext: „V l · Φ kW", nur Leistung, oder „Eingaben ohne Punkt".</summary>
    private string Auslegungspunkt
    {
        get
        {
            ZapfprofilAuslegungEingabeDaten? a = _eingabe.Auslegung;
            if (a?.PunktVolumenL is double v)
                return Zahl(v, "N0") + " l" + (a.PunktLeistungKw is double p ? " · " + Zahl(p, "N1") + " kW" : "");
            if (a?.PunktLeistungKw is double l) return Zahl(l, "N1") + " kW";
            return Texte.AuslegungOhnePunkt;
        }
    }

    /// <summary>Öffnet die Überlagerung zum aktuellen Arbeitsstand (Zonen und bisherige Auslegung).</summary>
    private void AuslegungOeffnen()
    {
        if (AuslegungGaben is null) return;
        _hinweis = "";
        _auslegungStochastisch = false;
        _auslegungGaben = AuslegungGaben(_eingabe.Kopie(), false);
    }

    // =================================================================================
    // Stochastisch rechnen (5.1): nebenläufig, mit Status und Abbruch
    // =================================================================================

    /// <summary>Steht „Stochastisch rechnen" offen? Es braucht die Auslegung oder die Jahresreihe.</summary>
    private bool StochastikMoeglich => AuslegungGaben is not null || Jahresreihe is not null;

    /// <summary>
    /// „Stochastisch rechnen" (5.1, Mockup): Bei Rechenweg „stochastisch" zieht der Dialog
    /// nebenläufig die Jahresreihe (Konsistenzprobe im Reiter Kennzahlen); dazu öffnet er die
    /// Überlagerung „Auslegung" mit eingeschaltetem Schalter — sie zieht das Ensemble des
    /// Bedarfstags für Perzentil und Gleichzeitigkeit, ebenfalls nebenläufig. Welche Reihe in die
    /// Bilanz geht, wählt allein der Rechenweg der Jahresreihe.
    /// </summary>
    private void StochastikRechnen()
    {
        if (!StochastikMoeglich) return;
        _hinweis = "";
        bool jahresreihe = _eingabe.JahresreiheStochastisch && Jahresreihe is not null;
        if (jahresreihe) JahresreiheStarten();
        if (AuslegungGaben is not null)
        {
            _auslegungStochastisch = true;
            _auslegungGaben = AuslegungGaben(_eingabe.Kopie(), true);
        }
        else if (!jahresreihe)
            _hinweis = Texte.HinweisJahresreiheDeterministisch;
    }

    /// <summary>Startet den Lauf der Jahresreihe zum Arbeitsstand; ein laufender endet vorher.</summary>
    private void JahresreiheStarten()
    {
        JahresreiheVerwerfen();
        var quelle = new CancellationTokenSource();
        _jahresreihe = quelle;
        _ = JahresreiheLaufen(quelle, _eingabe.Kopie());
    }

    /// <summary>
    /// Der Lauf: Der Delegat der Hülle rechnet auf einem Arbeitsfaden; das Ergebnis kommt über
    /// <c>InvokeAsync</c> in den Verteiler. Ein überholter Lauf (neue Eingabe, neuer Lauf, OK,
    /// Abbrechen) hinterlässt nichts; ein abgebrochener nennt den Abbruch als leise Zeile. Jede
    /// Ausnahme bleibt hier — ein loser Task erreichte die Fehlerschranke nicht.
    /// </summary>
    private async Task JahresreiheLaufen(CancellationTokenSource quelle, ZapfprofilEingabeDaten kopie)
    {
        ZapfprofilVorschauDaten? ergebnis = null;
        bool abgebrochen = false;
        try
        {
            ergebnis = await Jahresreihe!(kopie, quelle.Token);
        }
        catch (OperationCanceledException) { abgebrochen = true; }
        catch (Exception ex)
        {
            ergebnis = new ZapfprofilVorschauDaten
            {
                Zustand = ZapfprofilVorschauZustand.Abgebrochen,
                Grund = ex.Message,
                Status = Format(Texte.StatusOhneVorschau, ex.Message)
            };
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!ReferenceEquals(_jahresreihe, quelle)) return;
                _jahresreihe = null;
                if (abgebrochen) _hinweis = Texte.HinweisJahresreiheAbgebrochen;
                else _stochastik = ergebnis;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* der Dialog ist gegangen */ }
        finally { quelle.Dispose(); }
    }

    /// <summary>„Abbrechen" am Fortschritt: Der Lauf endet an der nächsten Einheit; der Arbeitsstand bleibt.</summary>
    private void JahresreiheAbbrechen()
    {
        try { _jahresreihe?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Verwirft Lauf und Ergebnis der Jahresreihe — sie gehören zum alten Arbeitsstand.</summary>
    private void JahresreiheVerwerfen()
    {
        CancellationTokenSource? offen = _jahresreihe;
        _jahresreihe = null;
        _stochastik = null;
        if (offen is null) return;
        try { offen.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>OK der Überlagerung: Eingaben samt Punkt in den Arbeitsstand (der Punkt gilt wieder); Abbrechen verwirft.</summary>
    private void AuslegungGeschlossen(ZapfprofilAuslegungEingabeDaten? auslegung)
    {
        _auslegungGaben = null;
        if (auslegung is null) return;
        _eingabe.Auslegung = auslegung.Kopie();
        _eingabe.Auslegung.Stochastisch = false;             // eine Laufangabe — jedes Öffnen setzt sie neu
        _eingabe.PunktUeberholt = false;
        _okMeldung = "";
        _okKennung = null;
    }
}
