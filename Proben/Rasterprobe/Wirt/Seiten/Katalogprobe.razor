    private IReadOnlyList<Katalogfilterzeile> TypZeilen
        => _typZeilen ??= Zeilenbau.Voll(Katalogfilterprofil.FuerGebaeudetyp(Uebersetzt), _anzahl)
                                   .Select(z => z.MitZahl(Katalogfilterprofil.SpKurven, z.Id % 3 == 0 ? 5 : 8, 0))
                                   .ToList();

    private GebaeudetypDaten? TypLesen(string name)
    {
        Katalogfilterzeile? z = TypZeilen.FirstOrDefault(x => x.Bezeichner == name);
        if (z is null) return null;
        int kurven = (int)(z.Zahl(Katalogfilterprofil.SpKurven) ?? 8);
        var v = new double[kurven, 24];
        for (int k = 0; k < kurven; k++)
            for (int s = 0; s < 24; s++) v[k, s] = 2.0 + Math.Sin(Math.PI * s / 24.0) * (3 + k);
        string[] lang = { "Winter-Wochentag", "Winter-Wochenende", "Übergang1-Wochentag", "Übergang1-Wochenende",
                          "Sommer-Wochentag", "Sommer-Wochenende", "Übergang2-Wochentag", "Übergang2-Wochenende" };
        string[] kurz = { "Winter-heiter", "Winter-trübe", "Übergang-heiter", "Übergang-trübe", "Sommertag" };
        return new GebaeudetypDaten
        {
            Id = z.Id,
            Name = z.Bezeichner,
            Beschreibung = z.Text(Katalogfilterprofil.SpBeschreibung),
            Aenderbar = !z.Geschuetzt,
            Verteilung = v,
            Kurvennamen = (kurven <= 5 ? kurz : lang).Take(kurven).ToList()
        };
    }

