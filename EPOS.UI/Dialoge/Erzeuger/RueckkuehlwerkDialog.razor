@* Die Verwaltung "Rueckkuehlwerke" (K-F5a; Entwurf Split/VRF/Rueckkuehlwerk 5.2 und 8) - der Katalog
   Tab_Rueckkuehlwerk_STAMM.

   GERUEST DER VERWALTUNGEN (Vorbild BaustoffKatalogDialog): Katalograhmen, Katalogliste mit ZeileIstWahl,
   Auswahlleiste, Stammblatt, Fussleiste Speichern - Verwerfen - Status - Neu... - Beenden. Unter Windows ein eigenes
   Fenster, auf iOS eine freie Ansicht der AppWurzel; die Datenseite liegt in der Huelle (EPOS.UI.Daten,
   RueckkuehlwerkHuelle) ueber RueckkuehlwerkStammCtrl.

   DIE LISTE: Name, Bauart, Nennleistung, Annaeherung, Ventilator, Freikuehlung - Profil und Zeilen aus dem Kern
   (Katalogfilterprofil.FuerRueckkuehlwerk, RueckkuehlwerkStammCtrl.Katalogfilterzeilen); das Schloss steht hinter dem
   Namen.

   DAS STAMMBLATT: fuenf Gruppen - Bauart und Nennpunkt, Annaeherung, Ventilator, Befeuchtung und Wasser (nur bei nassen
   Bauarten) und Freikuehlung -, dazu die Herkunft mit der Verwendung. Die Auswahlen gehen ueber den LISTENPLATZ, der
   Steuerwert ist nie der Anzeigetext. Ein leeres Feld zeigt die Vorgabe des Rechenwegs als Platzhalter
   ("Vorgabe: ..."), die die Huelle aus dem Kern liefert. Ein Auslieferungssatz steht als Text. Geschrieben wird allein
   mit "Speichern" - die Pruefregeln des Kerns (RueckkuehlwerkStammCtrl.Pruefen) genau dort.

   TASTATUR: Esc schliesst stufenweise (Ueberlagerung, Rueckfrage, schmales Blatt, Dialog). Enter ist nicht belegt. *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-katalog-dialog epos-rueckkuehlwerk-admin" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@Texte.Titel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="Schliessen" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_meldung" />
    }
    @* Wirft das Lesen der Katalogliste, nennt dieser Banner den Grund (Katalogladung). *@
    @if (!string.IsNullOrEmpty(_listeFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_listeFehler" />
    }
    @* Wirft das Lesen des gewaehlten Satzes, nennt dieser Banner den Grund (Katalogladung.Satz). *@
    @if (!string.IsNullOrEmpty(_satzFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_satzFehler" />
    }
    @if (_katalog.Count == 0)
    {
        <p class="epos-leisezeile epos-rueckkuehlwerk-leer">@Texte.LeerKatalog</p>
    }

    <Katalograhmen BlattOffen="@_auswahl.BlattOffen">
        <Liste>
            <Katalogliste Profil="@Profil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_gewaehlt" GewaehltChanged="BeiZeile" ZeileIstWahl="true"
                          Kaestchen="true" Gewaehlte="@_auswahl.Gewaehlte"
                          GewaehlteChanged="BeiKaestchen" />
        </Liste>

        <Auswahl>
            <Auswahlleiste Fokus="@Fokusname" Anzahl="@_auswahl.Anzahl"
                           Handlungen="@Handlungen()"
                           Aufheben="BeiAufheben" Gesperrt="Warnen"
                           Stammblatt="@BlattOeffnenWeg" />
        </Auswahl>

        <Blatt>
            <Stammblatt Name="@_daten.Bezeichner" Unterzeile="@Unterzeile"
                        Auslieferung="@_auslieferung" SchlossText="@Filtertexte.Schloss"
                        Entsperrt="@(!_auslieferung && _schloss.Entsperrt(ZeileZu(_gewaehlt)))"
                        Kennzahlen="@Kennzahlen" Hinweis="@Aenderungshinweis"
                        ZurListe="@_blattSchliessen"
                        Vergleichskoepfe="@(_auswahl.Vergleich ? _vergleichskoepfe : null)"
                        Vergleichszeilen="@(_auswahl.Vergleich ? _vergleichszeilen : null)"
                        VergleichZurueck="BeiVergleichZurueck">
                <Gruppen>
                    @* BAUART UND NENNPUNKT: Name, Beschreibung, Bauart, Nennleistung; bei nassen Bauarten der Hinweis
                       auf die 42. BImSchV. Ein Auslieferungssatz als TEXT. *@
                    <Stammblattgruppe Titel="@Texte.GruppeNennpunkt" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Nennpunktwerte(_daten) : null)">
                        <KindInhalt>
                            @Nennpunktfelder(_arbeit)
                            @Bimschvhinweis(_arbeit)
                        </KindInhalt>
                        <Nachsatz>
                            @Bimschvhinweis(_daten)
                        </Nachsatz>
                    </Stammblattgruppe>

                    <Stammblattgruppe Titel="@Texte.GruppeAnnaeherung" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Annaeherungswerte(_daten) : null)">
                        <KindInhalt>
                            @Annaeherungsfelder(_arbeit)
                        </KindInhalt>
                    </Stammblattgruppe>

                    <Stammblattgruppe Titel="@Texte.GruppeVentilator" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Ventilatorwerte(_daten) : null)">
                        <KindInhalt>
                            @Ventilatorfelder(_arbeit)
                        </KindInhalt>
                    </Stammblattgruppe>

                    @* BEFEUCHTUNG UND WASSER: nur bei nassen Bauarten (adiabat, hybrid, Kuehlturm); die Befeuchtung nur bei
                       den befeuchtenden (adiabat, hybrid). *@
                    @if (IstNass(_auslieferung ? _daten : _arbeit))
                    {
                        <Stammblattgruppe Titel="@Texte.GruppeWasser" Lesemodus="@_auslieferung"
                                          Werte="@(_auslieferung ? Wasserwerte(_daten) : null)">
                            <KindInhalt>
                                @Wasserfelder(_arbeit)
                            </KindInhalt>
                        </Stammblattgruppe>
                    }

                    <Stammblattgruppe Titel="@Texte.GruppeFreikuehlung" Lesemodus="@_auslieferung"
                                      Werte="@(_auslieferung ? Freikuehlungswerte(_daten) : null)">
                        <KindInhalt>
                            @Freikuehlungsfelder(_arbeit)
                        </KindInhalt>
                    </Stammblattgruppe>

                    @* HERKUNFT: immer Text - Verwendung in Projekten, Geraetepreis (gepflegt in der Kostenverwaltung). *@
                    <Stammblattgruppe Titel="@Texte.GruppeHerkunft" Lesemodus="true" Werte="@Herkunftwerte" />
                </Gruppen>
            </Stammblatt>
        </Blatt>
    </Katalograhmen>

    @* DIE FUSSLEISTE DER VERWALTUNG: Speichern - Verwerfen - Fueller (Statuszeile) - Neu... - Beenden. *@
    <div class="epos-leiste">
        @if (Speichern is not null)
        {
            @if (_auslieferung)
            {
                <button type="button" class="epos-knopf" aria-disabled="true"
                        title="@Texte.SpeichernGesperrt" @onclick="BeiSpeichern">@Texte.KnopfSpeichern</button>
            }
            else
            {
                <button type="button" class="epos-knopf" disabled="@(!_geaendert)"
                        @onclick="BeiSpeichern">@Texte.KnopfSpeichern</button>
            }
            <button type="button" class="epos-knopf" disabled="@(!_geaendert)"
                    @onclick="BeiVerwerfen">@Texte.KnopfVerwerfen</button>
        }
        <span class="epos-leiste-fueller epos-status@(_statusFehler ? " epos-status--fehler" : "")" role="status">@_status</span>
        @if (Speichern is not null)
        {
            <button type="button" class="epos-knopf" @onclick="BeiNeu">@Texte.KnopfNeu</button>
        }
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="Schliessen">@Texte.KnopfBeenden</button>
    </div>

    @* --- "Neu...": Bauart und Nennpunkt, OK prueft und legt an; die uebrigen Gruppen im Stammblatt danach ------- *@
    <Ueberlagerung Offen="@_neuOffen" Titel="@Texte.TitelNeu" Geschlossen="NeuSchliessen">
        <KindInhalt>
            @if (_neuOffen)
            {
                <div class="epos-rueckkuehlwerk-neu">
                    @if (_neuMeldung.Length > 0)
                    {
                        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_neuMeldung" />
                    }
                    @Nennpunktfelder(_neu)
                    <SpeichernLeiste OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen" Ergebnis="NeuErgebnis" />
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Namensabfrage von "Duplizieren...": Vorbelegung "... (Kopie)" ------------------------------------------ *@
    <Ueberlagerung Offen="@_duplizierfrage" Titel="@Texte.KnopfDuplizieren"
                   Geschlossen="() => _duplizierfrage = false">
        <KindInhalt>
            @if (_duplizierfrage)
            {
                <NamensDialog TitelText="" FrageText="@Texte.LabelBezeichner"
                              Vorbelegung="@_kopievorschlag"
                              MeldungLeer="@Texte.NameLeer" Pruefung="NameBelegt"
                              OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen"
                              Geschlossen="BeiDuplizierName" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Rueckfrage Offen="@_loeschfrage" TitelText="@Texte.KnopfLoeschen"
                Frage="@_loeschfrageText"
                JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiLoeschfrage" />

    @* --- Rueckfrage vor dem Umschalten des Schlosses (Vorgabe Nein) *@
    <Rueckfrage Offen="@_schloss.FrageOffen" TitelText="@_schloss.Titel" Frage="@_schloss.Frage"
                VorgabeNein="true" JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiSchlossAntwort" />
</div>

@code {
    /// <summary>
    /// Der Seitenschlüssel dieser Verwaltung (<c>Seitenschluessel.Rueckkuehlwerk</c>) — benannt, damit ein Knopf
    /// „Rückkühlwerke…" (etwa in der Rückkühlgruppe der Kältemaschine) dieselbe Ansicht öffnet.
    /// </summary>
    public const string SEITE = EPOS.UI.Seiten.Seitenschluessel.Rueckkuehlwerk;

    // =====================================================================
    // Gaben — die Datenseite liegt in der Hülle (RueckkuehlwerkHuelle)
    // =====================================================================

    /// <summary>Die Zeilen der Liste (<c>RueckkuehlwerkStammCtrl.Katalogfilterzeilen</c>); ohne sie ist die Liste leer.</summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    /// <summary>Die Spalten — <c>Katalogfilterprofil.FuerRueckkuehlwerk</c>; ohne sie das Profil mit den Ressourcentexten.</summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste — sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Ein eigener Filterstand statt des Registers (Muster der Verwaltungen).</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>Die Bauarten in Schemafolge (Persistenzwert, Text, nass, befeuchtend).</summary>
    [Parameter] public IReadOnlyList<RueckkuehlwerkBauart>? Bauarten { get; set; }

    /// <summary>Die Wege der Annäherung (<c>FEST</c>, <c>LASTABHAENGIG</c>).</summary>
    [Parameter] public IReadOnlyList<RueckkuehlwerkWahl>? Wege { get; set; }

    /// <summary>Die Ventilatorregelungen (<c>EIN_AUS</c>, <c>STUFEN</c>, <c>DREHZAHL</c>).</summary>
    [Parameter] public IReadOnlyList<RueckkuehlwerkWahl>? Regelungen { get; set; }

    /// <summary>Die Schaltungen der freien Kühlung (<c>PARALLEL</c>, <c>REIHE</c>).</summary>
    [Parameter] public IReadOnlyList<RueckkuehlwerkWahl>? Schaltungen { get; set; }

    /// <summary>Lädt einen Satz über seine Id; <c>null</c> = es gibt ihn nicht (mehr).</summary>
    [Parameter] public Func<int, RueckkuehlwerkDaten?>? Lies { get; set; }

    /// <summary>Die Prüfung des Kerns (<c>RueckkuehlwerkStammCtrl.Pruefen</c>) — <c>null</c> oder leer = gültig.</summary>
    [Parameter] public Func<RueckkuehlwerkDaten, string?>? Pruefen { get; set; }

    /// <summary>Schreibt einen Satz — Id 0 legt an, sonst wird geändert. Ohne ihn weder „Speichern" noch „Neu…".</summary>
    [Parameter] public Func<RueckkuehlwerkDaten, RueckkuehlwerkSpeicherErgebnis>? Speichern { get; set; }

    /// <summary>Löscht einen Satz (nur ohne Verwendung); ohne ihn keine Handlung.</summary>
    [Parameter] public Func<int, RueckkuehlwerkSpeicherErgebnis>? Loeschen { get; set; }

    /// <summary>„Duplizieren…"; ohne ihn keine Handlung.</summary>
    [Parameter] public Func<int, string, RueckkuehlwerkSpeicherErgebnis>? Duplizieren { get; set; }

    /// <summary>„Schloss setzen…" / „Schloss aufheben…" (<c>RueckkuehlwerkStammCtrl.SchlossSetzen</c>).</summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    /// <summary>Id des Satzes → Zahl seiner Projektkopien (<c>RueckkuehlwerkStammCtrl.KatalogVerwendung</c>).</summary>
    [Parameter] public Func<IReadOnlyDictionary<int, int>>? Verwendung { get; set; }

    /// <summary>Die Vorgaben der leeren Felder für die Bauart des Arbeitsstands (Rechenweg des Kerns).</summary>
    [Parameter] public Func<RueckkuehlwerkDaten, RueckkuehlwerkVorgaben>? Vorgaben { get; set; }

    /// <summary>Der Dialog wurde geschlossen („Beenden", Esc, Kreuz) — immer <c>true</c>.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    /// <summary>Die Anzeigetexte (ein Bündel).</summary>
    [Parameter] public RueckkuehlwerkTexte Texte { get; set; } = new();

    /// <summary>Der Titel im Dialogkopf; leer = eingebettet, die Überlagerung des Wirts trägt Titel und Kreuz.</summary>
    [Parameter] public string TitelText { get; set; } = Resource.RKW_TITEL;

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Rueckkuehlwerk.btn_Help";

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private Katalogfilterprofil? _profil;
    private IReadOnlyList<Katalogfilterzeile> _katalog = Array.Empty<Katalogfilterzeile>();
    private Katalogfilterstand _filterstand = new();
    private string _gewaehlt = "";
    private bool _auslieferung;
    private IReadOnlyDictionary<int, int> _verwendung = new Dictionary<int, int>();

    /// <summary>Der GESPEICHERTE Stand des gewählten Satzes.</summary>
    private RueckkuehlwerkDaten _daten = new();

    /// <summary>Der ARBEITSSTAND des Stammblatts — die Felder schreiben hierhin, „Speichern" schreibt ihn.</summary>
    private RueckkuehlwerkDaten _arbeit = new();
    private bool _geaendert;

    private bool _neuOffen;
    private RueckkuehlwerkDaten _neu = new();
    private string _neuMeldung = "";

    private bool _duplizierfrage;
    private string _kopievorschlag = "";
    private string _duplizierQuelle = "";

    private bool _loeschfrage;
    private string _loeschfrageText = "";
    private List<string> _loeschziele = new();
    private int _loeschBleiben;

    private readonly Zeilenauswahl _auswahl = new();
    private IReadOnlyList<string>? _vergleichskoepfe;
    private IReadOnlyList<Vergleichszeile>? _vergleichszeilen;

    private string _meldung = "";
    private string _listeFehler = "";
    private string _satzFehler = "";

    /// <summary>Die Statuszeile der Fußleiste; jede Zuweisung nimmt die rote Färbung zurück.</summary>
    private string _status
    {
        get => _statusText;
        set { _statusText = value; _statusFehler = false; }
    }
    private string _statusText = "";
    private bool _statusFehler;

    private EventCallback _vergleichen;
    private EventCallback _duplizieren;
    private EventCallback _schlossHandlung;
    private EventCallback _loeschen;
    private readonly Schlossumschaltung _schloss = new();
    private EventCallback _blattOeffnen;
    private EventCallback _blattSchliessen;

    // ---- Prüfhilfen für die Tests ---------------------------------------
    /// <summary>Die Namen der Liste in Listenreihenfolge (Prüfhilfe).</summary>
    public IReadOnlyList<string> Namensliste => _katalog.Select(z => z.Bezeichner).ToList();
    /// <summary>Der Schlüssel (die Id) der gewählten Zeile (Prüfhilfe).</summary>
    public string Gewaehlt => _gewaehlt;
    /// <summary>Der Arbeitsstand des Stammblatts (Prüfhilfe).</summary>
    public RueckkuehlwerkDaten Arbeitsstand => _arbeit;
    /// <summary>Die stehende Meldung (Prüfhilfe).</summary>
    public string Meldung => _meldung;
    /// <summary>Die Statuszeile der Fußleiste (Prüfhilfe).</summary>
    public string Status => _status;
    /// <summary>Trägt das Stammblatt geänderte Werte? (Prüfhilfe)</summary>
    public bool Geaendert => _geaendert;
    /// <summary>Ist der gewählte Satz ein Auslieferungssatz? (Prüfhilfe)</summary>
    public bool Auslieferung => _auslieferung;
    /// <summary>Steht die Überlagerung „Neu…"? (Prüfhilfe)</summary>
    public bool NeuOffen => _neuOffen;
    /// <summary>Steht die Löschrückfrage? (Prüfhilfe)</summary>
    public bool Loeschfrage => _loeschfrage;

    private Katalogfilterprofil Profil
        => _profil ??= Katalogprofil
                       ?? Katalogfilterprofil.FuerRueckkuehlwerk(s => Resource.ResourceManager.GetString(s) ?? s);

    // =====================================================================
    // Aufbau
    // =====================================================================

    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _duplizieren = EventCallback.Factory.Create(this, BeiDuplizieren);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _loeschen = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Profil.Schluessel);
        // Wirft die Liste beim Aufbau, bricht der Dialog nicht ab - der Banner nennt die Meldung.
        try
        {
            ListeLaden();
        }
        catch (Exception ex)
        {
            _meldung = string.Format(CultureInfo.CurrentCulture, Resource.WURZEL_LISTE_FEHLER, Texte.Titel, ex.Message);
        }

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.RUECKKUEHLWERK, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    // =====================================================================
    // Der Hilfe-Assistent
    // =====================================================================

    private KiMaskenanmeldung? _kiMaske;
    private RueckkuehlwerkKiSicht? _kiSicht;

    /// <summary>Die Sicht des Assistenten: Die Satzwahl nimmt den Weg eines Klicks, die Felder den Arbeitsstand.</summary>
    private RueckkuehlwerkKiSicht KiSicht()
    {
        return _kiSicht ??= new RueckkuehlwerkKiSicht
        {
            SatzLesen = () => _gewaehlt,
            SatzSetzen = BeiZeile,
            SatzEintraege = () => KiMaskenanmeldung.Eintraege(_katalog, z => z.Schluessel, z => z.Bezeichner),
            ArbeitLesen = () => _daten.Id > 0 ? _arbeit : null,
            Geaendert = Nachziehen,
            BauartEintraege = () => BauartListe.Select(b => new KiKern.KiWahleintrag(b.Code, b.Text)).ToList(),
            WegEintraege = () => KiEintraege(Wege),
            RegelungEintraege = () => KiEintraege(Regelungen),
            SchaltungEintraege = () => KiEintraege(Schaltungen),
            LadestandLesen = () => KatalogKiSperre.Ladestand(_listeFehler, _satzFehler)
        };
    }

    private static IReadOnlyList<KiKern.KiWahleintrag> KiEintraege(IReadOnlyList<RueckkuehlwerkWahl>? liste)
        => (liste ?? Array.Empty<RueckkuehlwerkWahl>()).Select(w => new KiKern.KiWahleintrag(w.Code, w.Text)).ToList();

    /// <summary>Was der Assistent über die Feldwerte hinaus darf: „Speichern" ist der Weg des Knopfes.</summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _auslieferung,
        Schreibschutzgrund = () => Texte.SpeichernGesperrt,
        Sperrgrund = f => KatalogKiSperre.Feldsperre(f, _listeFehler, _satzFehler, "rueckkuehlwerk"),
        Pruefen = () => Pruefbefund(_arbeit) ?? "",
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (KatalogKiSperre.Aktionssperre(_listeFehler, _satzFehler) is { } sperre)
            return KiKern.KiErgebnis.Abgelehnt(sperre);
        if (Speichern is null || _daten.Id <= 0)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", Texte.Titel));
        if (_auslieferung) return KiKern.KiErgebnis.Abgelehnt(Texte.SpeichernGesperrt);
        if (!_geaendert) return KiKern.KiErgebnis.Ok(_daten.Bezeichner, anzahl: 0);

        BeiSpeichern();
        return _meldung.Length > 0
                   ? KiKern.KiErgebnis.Abgelehnt(_meldung)
                   : KiKern.KiErgebnis.Ok(_daten.Bezeichner, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    // =====================================================================
    // Liste und Wahl
    // =====================================================================

    /// <summary>Lädt Liste und Verwendung; die bisherige Wahl bleibt, sonst die erste Zeile.</summary>
    private void ListeLaden(string? wunsch = null)
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, TitelText, out _listeFehler);
        IReadOnlyList<IReadOnlyDictionary<int, int>> verwendung = Katalogladung.Lesen<IReadOnlyDictionary<int, int>>(
            Verwendung is null ? null : () => new IReadOnlyDictionary<int, int>[] { Verwendung() }, TitelText, out string verwendungFehler);
        _verwendung = verwendung.Count > 0 && verwendung[0] is not null ? verwendung[0] : new Dictionary<int, int>();
        if (_listeFehler.Length == 0) _listeFehler = verwendungFehler;

        _auswahl.Abgleichen(_katalog.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        string ziel = wunsch ?? _gewaehlt;
        if (_katalog.Count == 0) { SatzWaehlen(""); return; }
        SatzWaehlen(_katalog.Any(z => z.Schluessel == ziel) ? ziel : _katalog[0].Schluessel);
    }

    /// <summary>Die Liste meldet eine Zeile. Geänderte Werte halten die Wahl.</summary>
    private void BeiZeile(string schluessel)
    {
        if (_geaendert && schluessel != _gewaehlt)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return;
        }
        SatzWaehlen(schluessel);
    }

    private void SatzWaehlen(string schluessel)
    {
        _meldung = "";
        _gewaehlt = schluessel ?? "";
        Katalogfilterzeile? zeile = ZeileZu(_gewaehlt);
        _satzFehler = "";
        RueckkuehlwerkDaten? gelesen = zeile is not null && Lies is not null
            ? Katalogladung.Satz(() => Lies(zeile.Id), zeile.Bezeichner, out _satzFehler)
            : null;
        _daten = gelesen ?? (zeile is null ? new RueckkuehlwerkDaten() : new RueckkuehlwerkDaten { Id = zeile.Id, Bezeichner = zeile.Bezeichner });
        _auslieferung = zeile?.Geschuetzt == true || _daten.Auslieferung;
        Zuruecksetzen();
    }

    /// <summary>Der Arbeitsstand wird wieder der gespeicherte (Wahl, Verwerfen, nach dem Speichern).</summary>
    private void Zuruecksetzen()
    {
        _arbeit = _daten.Kopie();
        _geaendert = false;
    }

    private Katalogfilterzeile? ZeileZu(string schluessel) => _katalog.FirstOrDefault(z => z.Schluessel == schluessel);

    private string Fokusname => ZeileZu(_gewaehlt)?.Bezeichner ?? "";

    // =====================================================================
    // Wertemengen: Listenplatz ↔ Persistenzwert
    // =====================================================================

    private IReadOnlyList<RueckkuehlwerkBauart> BauartListe => Bauarten ?? Array.Empty<RueckkuehlwerkBauart>();

    private RueckkuehlwerkBauart? BauartZu(string code)
        => BauartListe.FirstOrDefault(b => b.Code == (string.IsNullOrEmpty(code) ? VorgabeBauart : code));

    /// <summary>Der Persistenzwert der Vorgabe-Bauart (trocken) — die erste Bauart des Schemas.</summary>
    private string VorgabeBauart => BauartListe.Count > 0 ? BauartListe[0].Code : "";

    private bool IstNass(RueckkuehlwerkDaten d) => BauartZu(d.Bauart)?.Nass == true;

    private bool IstBefeuchtend(RueckkuehlwerkDaten d) => BauartZu(d.Bauart)?.Befeuchtend == true;

    private static IReadOnlyList<(int Id, string Text)> Eintraege(IEnumerable<string> texte)
        => texte.Select((t, i) => (i + 1, t)).ToList();

    private static int? Platz(IReadOnlyList<string> codes, string code)
    {
        int i = codes.ToList().IndexOf(code ?? "");
        return i < 0 ? null : i + 1;
    }

    private static string CodeAus(IReadOnlyList<string> codes, int? id)
        => id is int n && n >= 1 && n <= codes.Count ? codes[n - 1] : "";

    private static IReadOnlyList<string> Codes(IReadOnlyList<RueckkuehlwerkWahl>? liste)
        => (liste ?? Array.Empty<RueckkuehlwerkWahl>()).Select(w => w.Code).ToList();

    private static IReadOnlyList<(int Id, string Text)> Eintraege(IReadOnlyList<RueckkuehlwerkWahl>? liste)
        => Eintraege((liste ?? Array.Empty<RueckkuehlwerkWahl>()).Select(w => w.Text));

    /// <summary>Der Anzeigetext eines Steuerwerts; leer = der erste Eintrag (die Vorgabe), unbekannt bleibt er stehen.</summary>
    private static string TextZu(IReadOnlyList<RueckkuehlwerkWahl>? liste, string code)
    {
        IReadOnlyList<RueckkuehlwerkWahl> l = liste ?? Array.Empty<RueckkuehlwerkWahl>();
        if (string.IsNullOrEmpty(code)) return l.Count > 0 ? l[0].Text : "";
        return l.FirstOrDefault(w => w.Code == code)?.Text ?? code;
    }

    private string BauartText(string code) => BauartZu(code)?.Text ?? code;

    private string VorgabeText(string text) => string.Format(CultureInfo.CurrentCulture, Texte.Vorgabe, text);

    private string VorgabeZahl(double wert, string format, string einheit)
        => VorgabeText((wert.ToString(format, CultureInfo.CurrentCulture) + " " + einheit).Trim());

    private RueckkuehlwerkVorgaben? VorgabenZu(RueckkuehlwerkDaten d) => Vorgaben?.Invoke(d);

