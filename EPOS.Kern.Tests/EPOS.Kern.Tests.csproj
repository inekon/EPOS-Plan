<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testprojekt des Rechenkerns (Umsetzungskonzept iOS, iU4-6).

    net10.0 wie EPOS.Kern selbst - KEIN net*-windows. Damit laufen diese Tests
    ueberall, wo auch der Kern laeuft, und sind Teil von WP-Plan.Kern.slnf, das
    die CI ohne Windows abarbeitet.

    Geprueft wird ausschliesslich, was OHNE Datenbank und ohne Oberflaeche
    entscheidbar ist. Nichts hier ruft DbParam.NachOleDb oder oeffnet eine
    Verbindung; das bleibt den Referenzlaeufen vorbehalten.

    Etliche Kerntypen sind internal (z. B. Init); EPOS.Kern gibt sie ueber
    InternalsVisibleTo fuer dieses Projekt frei.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>EPOS.Kern.Tests</RootNamespace>
    <AssemblyName>EPOS.Kern.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EPOS.Kern\EPOS.Kern.csproj" />

    <!-- DIE DATENSEITE DER OBERFLAECHE (Auftrag #208). Sie ist plattformfrei wie
         der Kern und wird hier geprueft: SimulationAnsichtQuelle baut aus
         projektId + BedarfsZustand denselben Parametersatz, den Windows und iOS
         der Ansicht SIMULATION hereinreichen. Die Faelle brauchen dafuer die
         Testdatenbank - und die Vorrichtung dafuer steht nur hier. -->
    <ProjectReference Include="..\EPOS.UI.Daten\EPOS.UI.Daten.csproj" />

    <!-- BV-E9: das Werkzeug der Berichtsvorlagen. Die Aktualitaetswache
         (AuslieferungsvorlagenAktualitaetWacheTests) zieht seinen Sammelbefehl
         (Sammellauf.Schritte) und vergleicht jede mitgelieferte Vorlage mit einer
         frisch erzeugten. Das Werkzeug bleibt ausserhalb von WP-Plan.sln; gebaut
         wird es ueber diesen Verweis mit. -->
    <ProjectReference Include="..\Werkzeuge\Berichtsvorlage\Berichtsvorlage.csproj" />
  </ItemGroup>

  <!-- Die Plausibilitaetspruefung des Referenzlaufs ("pruefen") - VERLINKT, wie
       EPOS.Referenzlauf sie verlinkt: eine Fassung, hier nur geprueft
       (ReferenzlaufPlausibilitaetTests, Lueckenreihen der Anlagenkopplung). -->
  <ItemGroup>
    <Compile Include="..\Referenzlauf\Plausibilitaet.cs" Link="Referenzlauf\Plausibilitaet.cs" />
  </ItemGroup>

  <!-- Der Ergebnisexport des Referenzlaufs ("lauf") samt Protokoll - VERLINKT, wie
       EPOS.Referenzlauf ihn verlinkt: Die Wache des Referenzprojekts 1051
       (KonditionierungReferenzprojektWacheTests) schreibt mit genau diesem Weg den Ordner
       eines Laufs zweimal und haelt ihn gegen die Basis. -->
  <ItemGroup>
    <Compile Include="..\Referenzlauf\Ergebnisexport.cs" Link="Referenzlauf\Ergebnisexport.cs" />
    <Compile Include="..\Referenzlauf\Protokoll.cs" Link="Referenzlauf\Protokoll.cs" />
  </ItemGroup>

  <!-- Die Bauplaene der Referenzprojekte 1052 "Referenzprojekt Zonen" (Stufe G6d) und 1051
       "Referenzprojekt Konditionierung" (KP3, RP1; Bauwahlprobe) - VERLINKT: das Saatskript
       zieht ihn ueber #:include, die ZonenReferenzprojektWacheTests halten jede gesaete Zelle gegen ihn und
       gehen dieselben Programmwege auf einer Arbeitskopie nach. Eine Fassung. -->
  <ItemGroup>
    <Compile Include="..\Referenzlaeufe\Skripte\referenzprojekt_1052_bauplan.cs" Link="Referenzlaeufe\referenzprojekt_1052_bauplan.cs" />
    <Compile Include="..\Referenzlaeufe\Skripte\referenzprojekt_1051_bauplan.cs" Link="Referenzlaeufe\referenzprojekt_1051_bauplan.cs" />
  </ItemGroup>

  <!-- xUnit-Einstellungen (Auftrag #531): Sammlungen seriell, hoechstens zwei Threads -
       dieselben Werte wie die Schalter in Gate und Workflows. Die Datei gilt auch fuer
       Laeufe ohne Schalter (IDE, Ad-hoc-Aufruf); Schalter auf der Kommandozeile gehen vor. -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ================================================================== -->
  <!-- DIAGRAMME (iU7-8)                                                   -->
  <!--                                                                    -->
  <!-- ChartRendererTests zeichnet wirklich - und dafuer reicht das        -->
  <!-- verwaltete SkiaSharp nicht, es braucht die NATIVE Bibliothek der    -->
  <!-- Bauumgebung. Sie kaeme ueber EPOS.Kern transitiv mit; hier steht    -->
  <!-- sie noch einmal, weil DIESES Projekt das ausfuehrende ist: Wer      -->
  <!-- laufen laesst, benennt seine Laufzeit selbst. Bedingt ueber         -->
  <!-- IsOSPlatform, damit jede Umgebung genau ihre eigene zieht -         -->
  <!-- Linux und macOS in kern.yml, Windows in windows.yml (dort laeuft    -->
  <!-- "dotnet test WP-Plan.Kern.slnf" mit).                               -->
  <!-- ================================================================== -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies"
                      Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS"
                      Condition="$([MSBuild]::IsOSPlatform('OSX'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32"
                      Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
