    protected override void OnInitialized()
    {
        _liste = Liste;
        _traegerId = TraegerVorwahl ?? ErsterTraeger();
        if (_traegerId.HasValue) Laden(_traegerId.Value);

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.ENERGIETRAEGER,
                                          () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent (Welle KI-F4)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private EnergietraegerKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: Listenkopf, Trägerkarte und der Preisblock, der
    /// zur Familie des Trägers gehört.
    /// </summary>
    /// <remarks>
    /// <b>Zwei Orte, ein Feldsatz.</b> Filter, Trägerwahl und die zwei Stammfelder
    /// liegen in privaten Feldern dieser Komponente, die Preisangaben in
    /// <c>_ansicht.Stand</c>. Die Sicht löst beides an einer Stelle auf; nach jedem
    /// Setzen in die Karte läuft <see cref="Nachziehen"/> — derselbe Weg, den ein
    /// Tastendruck des Anwenders nimmt.
    /// </remarks>
    private EnergietraegerKiSicht KiSicht()
    {
        return _kiSicht ??= new EnergietraegerKiSicht
        {
            SucheLesen = () => _suche,
            SucheSetzen = w => _suche = w,

            TraegerLesen = () => _traegerId,
            TraegerSetzen = id => { if (id.HasValue) BeiTraeger(id.Value); },
            TraegerEintraege = () => KiMaskenanmeldung.Eintraege(
                Traegerzeilen(), z => z.Traeger, z => z.Text),

            StammNameLesen = () => _stammName,
            StammNameSetzen = w => _stammName = w,
            StammGruppeLesen = () => _stammGruppe,
            StammGruppeSetzen = id => _stammGruppe = id,
            GruppenEintraege = () => KiMaskenanmeldung.Eintraege(
                Gruppen, z => z.Id, z => z.Text),

            StandLesen = () => _ansicht.Stand,
            Nachziehen = Nachziehen,
            // Die Preisbasis geht den Weg der Klappliste, nicht den eines Feldes -
            // sonst verschoebe sich der gespeicherte Preis um den Heizwert.
            PreisbasisSetzen = id => _ = PreisbasisWechseln(id),
            // Der Leistungspreismodus ebenso - die Optionsgruppe schreibt ihn sofort in
            // den Katalog; ein Setzen nur in der Karte ginge verloren (Welle #458).
            LeistungsModusSetzen = monat => _ = LeistungsModusWechseln(monat)
        };
    }

    /// <summary>
    /// Die Trägerzeilen OHNE die Gruppenköpfe — nur sie sind wählbar.
    /// </summary>
    private IReadOnlyList<EnergietraegerListe> Traegerzeilen()
    {
        var treffer = new List<EnergietraegerListe>();
        foreach (EnergietraegerListe e in _liste)
        {
            if (e.Traeger.HasValue) treffer.Add(e);
        }
        return treffer;
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Der Speicherweg ist derselbe wie der Knopf „Speichern".</b> Er schreibt
    /// den Stammkopf und die Karte und zieht Liste und Ansicht nach — genau das, was
    /// <c>BeiSpeichern</c> tut. Einen Schreibschutz meldet die Maske nicht: Welcher
    /// Satz schreibbar ist, entscheidet die Hülle über ihre Delegaten, und ohne
    /// <c>Speichern</c>-Delegat lehnt der Weg von selbst ab.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (Speichern is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", Kopftitel));

        BeiSpeichern();
        return _meldungStufe == WarnStufe.Warnung
                   ? KiKern.KiErgebnis.Abgelehnt(_meldung)
                   : KiKern.KiErgebnis.Ok(_stammName, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>
    /// ET‑5: Die Liste FRISCH aus der Hülle holen — nach jedem Schritt, der sie verändert
    /// (Entfernen, Löschen, Übernahme, Neu, Variante, Stamm-Speichern, Speichern).
    ///
    /// <para>Steht der gewählte Träger danach nicht mehr in der Liste, hat die Markierung
    /// keinen Gegenstand mehr: Sie fällt weg und die Karte wird leer. Ohne Delegat bleibt
    /// die Liste stehen — ein Prüfstand ohne Hülle ändert sich dadurch nicht.</para>
    /// </summary>
    private void ListeNachziehen()
    {
        if (ListeNeuLaden is null) return;
        _liste = ListeNeuLaden() ?? Array.Empty<EnergietraegerListe>();

        if (!_traegerId.HasValue || Steht(_traegerId.Value)) return;
        _traegerId = null;
        _ansicht = new EnergietraegerAnsicht();
    }

    /// <summary>Steht der Träger in der Liste?</summary>
    private bool Steht(int id)
    {
        foreach (EnergietraegerListe e in _liste)
        {
            if (e.Traeger == id) return true;
        }
        return false;
    }

    /// <summary>Die Karte neu holen und den Stammkopf mitziehen (Ä9).</summary>
    private void Laden(int id)
    {
        Beruehrt();
        if (TraegerLaden is null) return;
        _ansicht = TraegerLaden(id);
        _stammName = _ansicht.StammName;
        _stammGruppe = _ansicht.StammGruppe;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private int? ErsterTraeger()
    {
        foreach (EnergietraegerListe e in _liste)
        {
            if (e.Traeger.HasValue) return e.Traeger.Value;
        }
        return null;
    }

    // =====================================================================
    // Suche und Filter (Anwenderwunsch 04.09.2026)
    // =====================================================================

    /// <summary>
    /// Der Filter wirkt NUR auf die Anzeige: <c>_traegerId</c> bleibt stehen,
    /// damit die Karte rechts weiter ihrem Träger gehört und er beim Leeren der
    /// Suche wieder markiert in der Liste steht.
    /// </summary>
    private void SucheSetzen(string wert) => _suche = wert ?? "";

    /// <summary>
    /// Die Liste, wie sie unter dem Filter aussieht — Bezeichnung UND Gruppe
    /// werden geprüft (wie im Importdialog Bezeichner und Firma), und ein
    /// Gruppenkopf bleibt nur über seinen Treffern.
    /// </summary>
    private IReadOnlyList<EnergietraegerListe> GefilterteListe
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_suche)) return _liste;

            var treffer = new List<EnergietraegerListe>();
            EnergietraegerListe? kopf = null;
            string gruppe = "";
            foreach (EnergietraegerListe e in _liste)
            {
                if (e.Traeger is null) { kopf = e; gruppe = e.Text; continue; }
                if (!VdiAuswahlFilter.Passt(_suche, e.Text, gruppe)) continue;
                if (kopf is not null) { treffer.Add(kopf); kopf = null; }
                treffer.Add(e);
            }
            return treffer;
        }
    }

    /// <summary>
    /// Die Beschriftung einer Trägerzeile samt ihrer Warnzeichen: nicht zugeordnet
    /// (ET‑3) und — seit Auftrag 268 — nicht passend zur Komponente. Beides kann
    /// zugleich gelten.
    /// </summary>
    private string Beschriftung(EnergietraegerListe e)
    {
        string text = e.Text;
        if (!e.Zugeordnet) text += " ⚠ " + NichtZugeordnetText;
        if (!e.Passend) text += " ⚠ " + PasstNichtText;
        return text;
    }

    /// <summary>Die Zusatzklasse einer Trägerzeile — beide Markierungen sehen gleich aus.</summary>
    private string Zeilenklasse(EnergietraegerListe e)
    {
        return e.Zugeordnet && e.Passend
            ? "epos-traeger-eintrag"
            : "epos-traeger-eintrag epos-traeger-eintrag--offen";
    }

    /// <summary>Die Träger der gefilterten Liste in Anzeigereihenfolge.</summary>
    private List<int> Treffer()
    {
        var ids = new List<int>();
        foreach (EnergietraegerListe e in GefilterteListe)
        {
            if (e.Traeger.HasValue) ids.Add(e.Traeger.Value);
        }
        return ids;
    }

    /// <summary>
    /// ↑ ↓ Pos1 Ende wandern über die TREFFER und wählen dabei — die
    /// <c>ListBox</c> des Vorläufers tat dasselbe, und Gruppenköpfe übersprang
    /// sie schon dort.
    /// </summary>
    private void BeiListenTaste(KeyboardEventArgs e)
    {
        List<int> ids = Treffer();
        if (ids.Count == 0) return;

        int i = _traegerId.HasValue ? ids.IndexOf(_traegerId.Value) : -1;
        int ziel;
        switch (e.Key)
        {
            case "ArrowDown": ziel = i < 0 ? 0 : Math.Min(i + 1, ids.Count - 1); break;
            case "ArrowUp":   ziel = i < 0 ? 0 : Math.Max(i - 1, 0);             break;
            case "Home":      ziel = 0;                                          break;
            case "End":       ziel = ids.Count - 1;                              break;
            default: return;
        }

        if (ids[ziel] != _traegerId) BeiTraeger(ids[ziel]);
    }

    /// <summary>
    /// Ä14: Der Wechsel speichert NICHT still — ungespeicherte Kartenänderungen
    /// verfallen (wie in der Kostenverwaltung, Ä12).
    /// </summary>
    private void BeiTraeger(int id)
    {
        _traegerId = id;
        Melden("");
        Laden(id);
    }

    /// <summary>Nach jeder Feldänderung: die Hülle rechnet, die Ansicht folgt.</summary>
    private void Nachziehen()
    {
        Beruehrt();
        if (Nachrechnen is not null) _ansicht = Nachrechnen();
    }

    /// <summary>
    /// Eine Eingabe, ein Nachladen oder ein Trägerwechsel: Der Vermerk „gespeichert"
    /// stimmt nicht mehr — er fällt an allen drei Stellen weg, und Speichern ist
    /// wieder anklickbar.
    /// </summary>
    private void Beruehrt()
    {
        _frischGespeichert = false;
        _status = "";
        if (_vermerk.Length > 0) LeisteMelden("", false);
        _vermerk = "";
        _vermerkFehler = false;
    }

    /// <summary>
    /// Setzt die Statusspanne der Leiste — über den Verteiler, denn der Assistent
    /// setzt Felder und speichert von außerhalb des Oberflächenfadens (KiSicht).
    /// Auf dem Verteiler läuft der Schritt sofort.
    /// </summary>
    private void LeisteMelden(string text, bool fehler)
    {
        SpeichernLeiste? leiste = _leiste;
        if (leiste is null) return;
        _ = InvokeAsync(() => leiste.Zeigen(text, fehler));
    }

    /// <summary>
    /// Ein Schreibversuch ist gescheitert: Der Grund steht im Banner oben UND an
    /// beiden Knöpfen — das Banner ist bei einer langen Karte aus dem Bild gerollt.
    /// </summary>
    private void SpeichernGescheitert()
    {
        _frischGespeichert = false;
        _status = "";
        string grund = _meldungStufe == WarnStufe.Warnung ? _meldung : "";
        _vermerk = string.IsNullOrEmpty(grund) ? Resource.ADM_STATUS_FEHLER : grund;
        _vermerkFehler = true;
        LeisteMelden(_vermerk, true);
    }

    private async Task PreisbasisWechseln(int id)
    {
