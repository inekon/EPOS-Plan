    /// <summary>
    /// Die Sicht des Assistenten auf die LEBENDEN Felder der Überlagerung „Klimadaten
    /// einlesen". Setzen nimmt denselben Weg wie die Tastatur; die beiden Dateipfade
    /// bleiben dem Dateidialog der Plattform vorbehalten und sind deshalb nur lesbar.
    /// </summary>
    private KlimadatenKiSicht KiSicht()
    {
        return _kiSicht ??= new KlimadatenKiSicht
        {
