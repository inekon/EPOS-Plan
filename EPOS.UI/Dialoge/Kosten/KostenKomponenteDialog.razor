        {
            bool wechsel = _invest != schluss.Invest;
            _invest = schluss.Invest;
            Melden(MeldungUebernommen, WarnStufe.Hinweis);
            if (wechsel) { KontextLaden(null); return; }
        }
        // Wie btnUebernahme_Click: übernommene Positionen sofort zeigen — und die
        // ungespeicherten Eingaben der bestehenden Zeilen behalten.
        KontextLaden(_stand.VarianteId, eingabenUebernehmen: true);
