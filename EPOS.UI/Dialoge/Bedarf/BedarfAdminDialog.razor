    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _duplizieren = EventCallback.Factory.Create(this, BeiDuplizieren);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _loeschen = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        // S2.5/S3.1: der Filterstand je Katalog, fuer die Sitzung, gemeinsam mit dem
        // Projektdialog desselben Bedarfs (Frage Q2).
        _filterstand = Filterstandvorgabe
            ?? Katalogfilterregister.Stand(Katalogprofil?.Schluessel ?? ("BEDARF_" + Art));

        _typliste = Typen?.Invoke() ?? Array.Empty<string>();

        KatalogLaden();

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaske, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

