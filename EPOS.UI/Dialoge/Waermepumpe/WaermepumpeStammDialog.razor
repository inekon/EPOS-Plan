    /// <summary>
    /// „Verwerfen": Der gewählte Satz kommt neu aus dem Katalog; ein neuer, noch nicht
    /// gespeicherter Satz fällt weg, und die erste Zeile steht wieder.
    /// </summary>
    private void BeiVerwerfen()
    {
        if (!_geaendert) return;
        _geaendert = false;
        _meldung = "";
        Katalogfilterzeile? zeile = _neu ? null : _liste.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
        if (zeile is null && _liste.Count > 0) zeile = _liste[0];
        if (zeile is not null) ZeileWaehlen(zeile);
        else BeiNeu();
    }

    private void BeiKaestchen(IReadOnlyList<string> gewaehlte)
    {
        _auswahl.Setzen(gewaehlte);
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiAufheben()
    {
        _auswahl.Aufheben();
        _vergleichszeilen = null;
    }

    private void BeiVergleichen()
    {
        if (_auswahl.VergleichUmschalten()) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiVergleichZurueck()
    {
        _auswahl.VergleichBeenden();
        _vergleichszeilen = null;
    }

    /// <summary>
    /// <b>Der Vergleich über die Felder des Stammsatzes</b> (V12) — dieselben, die die
    /// Kenndaten zeigen, dazu die Herkunft. Gerechnet beim Anstellen und wenn sich die
    /// Kästchen ändern: hinter <c>Satz</c> steht ein Datenbankzugriff je Gerät.
    /// </summary>
    private void VergleichBauen()
    {
        IReadOnlyList<string> namen = _auswahl.Gewaehlte;
        _vergleichskoepfe = namen;

        var saetze = new List<IReadOnlyList<Vergleichsfeld>>(namen.Count);
        foreach (string name in namen)
        {
            Katalogfilterzeile? zeile = _liste.FirstOrDefault(z => z.Bezeichner == name);
            WaermepumpeStammDaten? d = zeile is null ? null : Satz?.Invoke(zeile.Id);
            saetze.Add(Vergleichsfelder(d, zeile?.Geschuetzt == true));
        }
        _vergleichszeilen = Vergleichsbau.AusFeldern(saetze);
    }

    private IReadOnlyList<Vergleichsfeld> Vergleichsfelder(WaermepumpeStammDaten? d, bool geschuetzt)
    {
        d ??= new WaermepumpeStammDaten();
        string kw = " [" + EinheitKw + "]";
        return new[]
        {
            new Vergleichsfeld("FIRMA", LabelHersteller, d.Firma),
            new Vergleichsfeld("BESCHREIBUNG", LabelBeschreibung, d.Beschreibung),
            new Vergleichsfeld("TYP", LabelTyp, d.Typ),
            new Vergleichsfeld("REGELUNG", LabelRegelung, d.Regelung),
            new Vergleichsfeld("AUFSTELLUNG", LabelAufstellung, d.Aufstellung),
            new Vergleichsfeld("BAUJAHR", LabelBaujahr, d.Baujahr?.ToString(CultureInfo.CurrentCulture) ?? ""),
            new Vergleichsfeld("NENNLEISTUNG", LabelNennleistung + kw,
                               d.Nennleistung?.ToString(CultureInfo.CurrentCulture) ?? ""),
            new Vergleichsfeld("HEIZSTAB", LabelHeizstab + kw,
                               d.Heizstab?.ToString(CultureInfo.CurrentCulture) ?? ""),
            new Vergleichsfeld("KUEHLLEISTUNG", LabelKuehlleistung + kw,
                               d.Kuehlleistung.ToString(CultureInfo.CurrentCulture)),
            new Vergleichsfeld("MODULKOSTEN", LabelModulkosten + " [" + EinheitEuro + "]",
                               d.Modulkosten.ToString(CultureInfo.CurrentCulture)),
            new Vergleichsfeld(HERKUNFT, Resource.ADM_VG_HERKUNFT,
                               geschuetzt ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ)
        };
    }

    /// <summary>
    /// Die Beschriftungen des Feldrasters (<c>WaermepumpeStammFelder</c>). Der Baustein
    /// füllt sein Bündel selbst aus <c>MyResource</c>; DIESER Dialog bezieht seine Texte
    /// aber seit jeher als Einzelgaben aus der Hülle — deshalb legt er sie in
    /// <see cref="OnParametersSet"/> hier ab. So bleibt die Hülle unverändert, und ein
    /// Prüfstand kann weiterhin eine einzelne Beschriftung setzen.
    /// </summary>
    private WaermepumpeStammFelderTexte _felderTexte = new();

    /// <summary>
    /// <b>Die eigene Gruppe „Kosten"</b> (Konzept Administrationsdialoge, Stufe 4): Die
    /// Modulkosten standen bis hierher zwischen den Kenndaten; jetzt stehen sie wie bei
    /// den Gerätekatalogen in der festen Gruppe Kosten des Stammblatts — als LESEWERT mit
    /// Herleitung, denn gepflegt werden sie in der Kostenverwaltung (W14a-O-1).
    /// </summary>
    private RenderFragment KostenInhalt => @<div class="epos-wp-kosten">
        <Stammblattwerte Werte="@WaermepumpeStammFelder.Kostenwerte(Daten, _felderTexte)" />
        <Herleitungszeile Text="@_felderTexte.HerleitungModulkosten" />
        @if (Daten.Modulkosten <= 0)
        {
            <Herleitungszeile Text="@_felderTexte.HinweisModulkostenLeer" />
        }
    </div>;

    protected override void OnParametersSet()
    {
        // Der Kopf der WAHLSPALTE kommt weiter über den eigenen Text der Hülle
        // (KFAK_SP_WAHL) — dasselbe Wort in allen neun Katalogdialogen.
        Filtertexte.SpalteWahl = SpalteWahl;

        // Das Schloss nennt den Ausweg, wo es ihn gibt (V10, AD-Q11).
        Filtertexte.Schloss = Duplizieren is not null
            ? Resource.ADM_SCHLOSS_DUPLIZIEREN
            : Resource.ADM_SCHLOSS;

        _felderTexte.LabelName = LabelName;
        _felderTexte.LabelHersteller = LabelHersteller;
        _felderTexte.LabelBeschreibung = LabelBeschreibung;
        _felderTexte.LabelTyp = LabelTyp;
        _felderTexte.LabelRegelung = LabelRegelung;
        _felderTexte.LabelAufstellung = LabelAufstellung;
        _felderTexte.LabelBaujahr = LabelBaujahr;
        _felderTexte.LabelNennleistung = LabelNennleistung;
        _felderTexte.LabelHeizstab = LabelHeizstab;
        _felderTexte.LabelKuehlleistung = LabelKuehlleistung;
        _felderTexte.LabelModulkosten = LabelModulkosten;
        _felderTexte.HerleitungModulkosten = HerleitungModulkosten;
        _felderTexte.HinweisModulkostenLeer = HinweisModulkostenLeer;
        _felderTexte.EinheitKw = EinheitKw;
        _felderTexte.EinheitEuro = EinheitEuro;
    }

    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _duplizieren = EventCallback.Factory.Create(this, BeiDuplizieren);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _loeschen = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        // S2.5: der Filterstand je Katalog, fuer die Sitzung, gemeinsam mit dem
        // Projektdialog (Frage Q2). Ein Pruefstand gibt seinen eigenen herein.
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Anlagenart.Waermepumpe);

        ListeNeuLaden();
        // Der Vorlaeufer waehlte in FillWPList:131 immer die ERSTE Zeile aus.
        if (_liste.Count > 0) ZeileWaehlen(_liste[0]);

        // KI-F1b: Die vier Klapplisten der Stammfelder sind WAHLFELDER; ihre Einträge
        // sind genau die Listen, die der Baustein zeichnet.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.WAERMEPUMPE, () => Daten, KiHaken(),
                                          ("typ", () => KiMaskenanmeldung.Eintraege(Typen, s => s, s => s)),
                                          ("leistungsstufen", () => KiMaskenanmeldung.Eintraege(
                                                                        Leistungsstufen, s => s, s => s)),
                                          ("aufstellung", () => KiMaskenanmeldung.Eintraege(
                                                                        Aufstellungen, s => s, s => s)),
                                          ("baujahr", Baujahreintraege));
    }

    /// <summary>Die Baujahre als Wahleinträge — Schlüssel und Text sind die Jahreszahl (KI-F1b).</summary>
    private IReadOnlyList<KiWahleintrag> Baujahreintraege()
        => KiMaskenanmeldung.Eintraege(Baujahre, j => j);

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Auftrag #201, Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Diese Maske ist die einzige der fünf, die den SCHREIBSCHUTZ kennt.</b>
    /// <c>WaermepumpeStammDaten.NurLesen</c> trägt das <c>ReadOnly</c> des
    /// Auslieferungskatalogs (Fachkonzept 4.5); solange es steht, lehnt schon
    /// <c>feld_setzen</c> ab — und nicht erst der Speicherknopf. Beim ANLEGEN gilt es
    /// nicht, genau wie in <see cref="BeiSpeichern"/> (der Vorläufer prüft
    /// <c>!neu &amp;&amp; ReadOnly</c>).
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => !_neu && Daten.NurLesen,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (Speichern is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", TitelText));

        if (!_neu && Daten.NurLesen)
            return KiKern.KiErgebnis.Abgelehnt(MeldungReadOnlySpeichern);

        BeiSpeichern();
        return _meldungStufe == WarnStufe.Warnung
            ? KiKern.KiErgebnis.Fehlgeschlagen(_meldung)
            : KiKern.KiErgebnis.Ok(_meldung, anzahl: 1);
    }

    /// <summary>
    /// Die Anmeldung bei der <c>KiMaskenbruecke</c> (Auftrag #200, Stufe S2): der Getter
    /// auf <see cref="Daten"/>, der mit dem Dialog fällt.
    /// </summary>
    /// <remarks>
    /// <b>Angemeldet heißt nicht übertragen.</b> Ob ein Feldwert hinausgeht, entscheiden
    /// der Schalter „Feldwerte mitsenden" im Chat und die Einwilligungsstufe
    /// „Dialogdaten" (KI‑D‑Q2).
    /// </remarks>
    private KiMaskenanmeldung? _kiMaske;

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private void ListeNeuLaden()
    {
        _liste = Liste?.Invoke() ?? Array.Empty<Katalogfilterzeile>();

        // Kaestchen verschwundener Zeilen fallen (V6); ein laufender Vergleich liest neu.
        _auswahl.Abgleichen(_liste.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;
    }

    /// <summary>
    /// Die Katalogliste meldet den Bezeichner; hier wird die Zeile dazu gesucht.
    /// <b>Geänderte Felder halten die Wahl fest</b> (Stufe 3): Der
    /// Wechsel verwürfe sie still; das Warnband sagt „Speichern oder Verwerfen".
    /// </summary>
    private void BeiZeile(string bezeichner)
    {
        if (bezeichner == _gewaehlt && !_neu) return;
        if (_geaendert) { Warnen(MeldungUngespeichert); return; }

        Katalogfilterzeile? zeile = _liste.FirstOrDefault(z => z.Bezeichner == bezeichner);
        if (zeile is not null) ZeileWaehlen(zeile);
    }

    private void ZeileWaehlen(Katalogfilterzeile zeile)
    {
        _gewaehlteId = zeile.Id;
        _gewaehlt = zeile.Bezeichner;
        _fokuszeile = zeile;
        _neu = false;
        _geaendert = false;
        _meldung = "";
        _status = "";

        // Die Projektsperre der Fokuszeile - der Grund am weich gesperrten "Loeschen".
        _gesperrtDurch = zeile.Geschuetzt ? null : GesperrtDurch?.Invoke(zeile.Bezeichner);

        WaermepumpeStammDaten? satz = Satz?.Invoke(zeile.Id);
        if (satz is not null) Daten = satz;

        // W14a-E-8: Die Uebersicht folgt der Auswahl - sie liest ueber den
        // BEZEICHNER, weil der Verwendungskatalog fuer alle sieben Anlagenarten
        // denselben Schluessel benutzt.
        _uebersicht = Uebersicht?.Invoke(zeile.Bezeichner) ?? Array.Empty<Parameterwert>();

        // Der Umschalter erscheint nur mit Kuehl-Kenndaten, und die Anzeige faellt
        // dabei auf Waerme zurueck - listBox_WP_SelectedIndexChanged:338 rief dafuer
        // radioButton_Waerme.PerformClick().
        _hatKuehlung = HatKuehlung?.Invoke(zeile.Id) ?? false;
        _kuehlung = false;
        BilderNeuZeichnen();
    }

    private void BetriebsartWaehlen(int? auswahl)
    {
        _kuehlung = auswahl == 1;
        BilderNeuZeichnen();
    }

    private void BilderNeuZeichnen()
    {
        _bilder = (Bilder is not null && _gewaehlteId > 0)
            ? Bilder(_gewaehlteId, _kuehlung)
            : KennlinienBilder.Leer;
    }

    // =================================================================================
    // Speichern, Neu, Loeschen
    // =================================================================================

    private void BeiSpeichern()
    {
        if (Speichern is null) return;

        // ReadOnly-Sperre nur beim AENDERN - der Vorlaeufer prueft !neu && ReadOnly.
        // Seit AD-Q11 ist der Knopf dafuer weich gesperrt; der Klick nennt den Weg
        // ueber "Duplizieren...".
        if (NurLesbar)
        {
            SpeichernAbgelehnt(MeldungSpeichernGesperrt);
            return;
        }

        KatalogSpeicherErgebnis ergebnis = Speichern(Daten, _neu);
        if (!ergebnis.Ok)
        {
            SpeichernAbgelehnt(ergebnis.Meldung);
            return;
        }

        // Wie btn_Speichern_Click:417: Liste neu ziehen und den gespeicherten Satz
        // wieder auswaehlen. Gelungenes steht in der Statuszeile (V11).
        _neu = false;
        ListeNeuLaden();
        Katalogfilterzeile? zeile = _liste.FirstOrDefault(z => z.Bezeichner == ergebnis.Name);
        if (zeile is not null) ZeileWaehlen(zeile);
        _meldung = "";
        _meldungStufe = WarnStufe.Hinweis;
        _status = ergebnis.Meldung;
    }

    // =================================================================================
    // „Duplizieren…" (Entscheid AD-Q11)
    // =================================================================================

    /// <summary>
    /// „Duplizieren…": Namensabfrage, vorbelegt mit „Name (Kopie)" (der erste freie),
    /// dann der eigene Satz — mit allen Stammwerten und den Kennlinien des gewählten.
    /// </summary>
    private void BeiDuplizieren()
    {
        if (!DuplizierenErlaubt) return;
        if (_geaendert) { Warnen(MeldungUngespeichert); return; }

        // Kopiert wird die EINE Zielzeile: die gewaehlte, sonst die Fokuszeile (V8).
        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count != 1) return;
        _duplizierQuelle = ziele[0];
        _meldung = "";
        _kopievorschlag = Katalogkopie.Namensvorschlag(_duplizierQuelle, NameVergeben);
        _duplizierfrage = true;
    }

    private bool NameVergeben(string name) => _liste.Any(z => z.Bezeichner == name);

    private string? NameBelegt(string name) => NameVergeben(name) ? MeldungNameBelegt : null;

    private void BeiDuplizierName(string? name)
    {
        _duplizierfrage = false;
        if (name is null || Duplizieren is null) return;

        Katalogfilterzeile? quelle = _liste.FirstOrDefault(z => z.Bezeichner == _duplizierQuelle);
        if (quelle is null) return;

        string alt = _duplizierQuelle;
        KatalogSpeicherErgebnis ergebnis = Duplizieren(quelle.Id, name);
        if (!ergebnis.Ok)
        {
            _meldung = ergebnis.Meldung;
            _meldungStufe = WarnStufe.Warnung;
            return;
        }

        // Die Kopie ist gewaehlt, die Kaestchen fallen: Die naechste Handlung gilt ihr.
        _auswahl.Aufheben();
        ListeNeuLaden();
        Katalogfilterzeile? zeile = _liste.FirstOrDefault(z => z.Bezeichner == ergebnis.Name);
        if (zeile is not null) ZeileWaehlen(zeile);
        _status = string.Format(MeldungDupliziert, alt, ergebnis.Name);
    }

    // =====================================================================
    // „Schloss setzen…" / „Schloss aufheben…" (Entscheid AD-Q15)
    // =====================================================================

    /// <summary>Die Zeilen, auf die die Auswahlleiste gerade wirkt.</summary>
    private IReadOnlyList<Katalogfilterzeile> SchlossZiele
        => Schlossumschaltung.Zeilen(_auswahl.Ziele(_gewaehlt), _liste);

    /// <summary>
    /// Der Klick: Rückfrage in beiden Richtungen, Vorgabe „Nein". Geänderte Felder oder ein
    /// ungespeichertes neues Gerät halten sie auf.
    /// </summary>
    private void BeiSchloss()
    {
        string? grund = _schloss.Fragen(Schloss, SchlossZiele, _geaendert || _neu);
        if (grund is not null) { Warnen(grund); return; }
        _meldung = "";
    }

    /// <summary>
    /// Nach dem „Ja": schalten, die Liste neu lesen und die Fokuszeile neu wählen —
    /// <c>Daten.NurLesen</c>, Lesemodus des Stammblatts und Speichern folgen aus ihr —,
    /// Erfolg in die Statuszeile.
    /// </summary>
    private void BeiSchlossAntwort(bool? antwort)
    {
        Schlossausgang a = _schloss.Beantwortet(antwort, Schloss);
        if (!a.Geschrieben)
        {
            if (a.Fehler.Length > 0) Warnen(a.Fehler);
            return;
        }
        ListeNeuLaden();
        Katalogfilterzeile? zeile = _liste.FirstOrDefault(z => z.Id == _gewaehlteId);
        if (zeile is not null) ZeileWaehlen(zeile);
        _meldung = "";
        _status = a.Status;
    }

    /// <summary>„Neu": leere Vorgaben, keine Zeile markiert (<c>btn_Neu_Click</c>:458).</summary>
    private void BeiNeu()
    {
        if (_geaendert) { Warnen(MeldungUngespeichert); return; }

        _neu = true;
        _geaendert = false;
        _fokuszeile = null;
        _gesperrtDurch = null;
        _gewaehlteId = 0;
        _gewaehlt = "";
        _meldung = "";
        _status = "";
        _hatKuehlung = false;
        _kuehlung = false;
        _bilder = KennlinienBilder.Leer;
        Daten = new WaermepumpeStammDaten();
    }

    /// <summary>
    /// <b>„Löschen" aus der Auswahlleiste</b> (V8, AD-Q9): wirkt auf die gewählten
    /// Zeilen, sonst auf die Fokuszeile. Auslieferungssätze bleiben stehen (V13) — sind
    /// es alle, ist der Knopf weich gesperrt. Die Rückfrage nennt, was gelöscht wird und
    /// was stehen bleibt.
    /// </summary>
    private void BeiLoeschen()
    {
        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count == 0) return;

        var loeschbar = ziele.Where(z => !Geschuetzt(z)).ToList();
        var bleiben = ziele.Where(Geschuetzt).ToList();
        if (loeschbar.Count == 0) { Warnen(Resource.ADM_AW_LOESCHEN_GESPERRT); return; }

        _loeschziele = loeschbar;
        _loeschBleiben = bleiben.Count;

        string frage = loeschbar.Count == 1
            ? FrageLoeschen
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_FRAGE_MEHR,
                            loeschbar.Count, string.Join(", ", loeschbar));
        if (bleiben.Count > 0)
            frage += " " + string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_BLEIBEN,
                                         string.Join(", ", bleiben));
        _loeschtext = frage;
        _loeschfrage = true;
    }

    /// <summary>
    /// Nach dem „Ja": je Zeile ein Schritt. Die Projektsperre kommt VOR dem Löschen
    /// (<c>btn_Loeschen_Click:441</c>) — eine zugeordnete Wärmepumpe bleibt stehen und
    /// nennt ihr Projekt im Warnband; die Statuszeile nennt beide Zahlen.
    /// </summary>
    private void LoeschfrageBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || Loeschen is null) return;

        int geloescht = 0;
        var gruende = new List<string>();
        bool fokusWeg = false;
        foreach (string name in _loeschziele)
        {
            string? projekt = GesperrtDurch?.Invoke(name);
            if (projekt is not null)
            {
                string grund = string.Format(MeldungProjektFormat, projekt);
                if (!gruende.Contains(grund)) gruende.Add(grund);
                continue;
            }
            if (!Loeschen(name)) continue;
            geloescht++;
            if (name == _gewaehlt) fokusWeg = true;
        }

        int ziele = _loeschziele.Count + _loeschBleiben;
        int blieben = ziele - geloescht;
        _loeschziele = new List<string>();

        if (gruende.Count > 0) Warnen(string.Join(" ", gruende));
        else _meldung = "";

        if (geloescht == 0) return;

        ListeNeuLaden();
        Katalogfilterzeile? fokus = fokusWeg ? null : _liste.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
        if (fokus is null && _liste.Count > 0) fokus = _liste[0];
        string meldung = _meldung;
        if (fokus is not null) ZeileWaehlen(fokus);
        else BeiNeu();
        _meldung = meldung;

        _status = ziele <= 1 ? ""
                : blieben > 0 ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT_BLEIBEN, geloescht, blieben)
                : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT, geloescht);
    }

    // =================================================================================
    // Die beiden Ueberlagerungen
    // =================================================================================

    private void BeiKenndaten()
    {
        if (Kennlinien is null || _gewaehlteId <= 0) return;

        // Der Hinweis kommt wie im Vorlaeufer VOR dem Oeffnen (btn_Kenndaten_Click:477).
        if (Daten.NurLesen)
        {
            _meldung = MeldungReadOnlyKenndaten;
            _meldungStufe = WarnStufe.Hinweis;
        }
        _kennlinien = Kennlinien(_gewaehlteId).Select(z => z.Kopie()).ToList();
    }

    private void KenndatenFertig(IReadOnlyList<KennlinienZeile>? stand)
    {
        _kennlinien = null;
        if (stand is null || Daten.NurLesen) return;   // Abbruch oder ReadOnly: nichts schreiben

        KennlinienAbgleichen?.Invoke(_gewaehlteId, stand);
        BilderNeuZeichnen();                            // Chart aktualisieren (Z. 549)
    }

    /// <summary>
    /// <b>„Beenden"</b> — der eine Schlussweg (V15): der Knopf, das Schliesskreuz und
    /// Esc. Die Maske hat keinen Arbeitsstand, der zu verwerfen wäre — Speichern,
    /// Duplizieren, Löschen und der Kennlinieneditor schreiben sofort.
    /// </summary>
    /// <summary>
    /// „Beenden" — Kreuz und Esc nehmen denselben Weg. <b>Geänderte Felder halten ihn
    /// auf</b> (Stufe 3): „Speichern oder Verwerfen" im Warnband, der Dialog bleibt offen.
    /// </summary>
    private Task Beenden()
    {
        if (_geaendert)
        {
            Warnen(MeldungUngespeichert);
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(true);
    }

    // =====================================================================
    // "Import..." (Konzept Administrationsdialoge 7.1 d, Zweitweg zu V14)
    // =====================================================================

    /// <summary>
    /// Der Parametersatz des <c>KatalogImportDialog</c> (VDI 3805 Blatt 22,
    /// <c>KatalogImportHuelle.Gaben</c>). <c>null</c> = kein „Import…" — so in der
    /// Überlagerung des Anlagendialogs.
    /// </summary>
    [Parameter] public Func<IReadOnlyDictionary<string, object>>? ImportGaben { get; set; }

    /// <summary>„Import…" — <c>ADM_BTN_IMPORT</c>.</summary>
    [Parameter] public string BtnImportText { get; set; } = Resource.ADM_BTN_IMPORT;

    private IReadOnlyDictionary<string, object>? _importGaben;
    private HashSet<string> _vorImport = new(StringComparer.Ordinal);

    /// <summary>Steht der Import als Überlagerung? (Prüfhilfe für Tests.)</summary>
    public bool ImportOffen => _importGaben is not null;

    /// <summary>„Import…" öffnet den Herstellerimport; geänderte Felder halten an (Konzept 3.3).</summary>
    private void ImportOeffnen()
    {
        if (_geaendert) { Warnen(MeldungUngespeichert); return; }
        _vorImport = new HashSet<string>(_liste.Select(z => z.Bezeichner), StringComparer.Ordinal);
        _importGaben = ImportGaben?.Invoke();
    }

    /// <summary>
    /// Der Import ist zu. Hat er geschrieben, liest die Liste neu, und die neuen
    /// Wärmepumpen sind die Auswahl (V14, 7.1 d): ab zweien über ihre Kästchen („n gewählt"),
    /// die erste steht als Fokuszeile im Stammblatt; die Statuszeile nennt ihre Zahl.
    /// </summary>
    private void ImportFertig(bool geschrieben)
    {
        _importGaben = null;
        if (!geschrieben) return;

        ListeNeuLaden();
        List<Katalogfilterzeile> neu = _liste.Where(z => !_vorImport.Contains(z.Bezeichner)).ToList();
        if (neu.Count == 0) return;

        _auswahl.Uebernommen(neu.Select(z => z.Schluessel));
        _vergleichszeilen = null;
        ZeileWaehlen(neu[0]);
        _status = neu.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_EINGELESEN, neu[0].Bezeichner)
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_IMPORTIERT, neu.Count);
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Die Ueberlagerungen und die Rueckfrage werten Esc zuerst fuer sich aus.
        if (e.Key != "Escape" || _kennlinien is not null || _loeschfrage || _duplizierfrage
            || _schloss.FrageOffen || ImportOffen)
            return Task.CompletedTask;

        // Im schmalen Fenster schliesst Esc zuerst das Blatt (Konzept 3.3).
        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }
        return Beenden();
    }
}
