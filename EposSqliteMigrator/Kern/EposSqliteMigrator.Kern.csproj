<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64;AnyCPU</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>EposSqliteMigrator.Kern</AssemblyName>
    <RootNamespace>EposSqliteMigrator.Kern</RootNamespace>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.11" />
  </ItemGroup>

  <!-- Die vier S2-Erzeugnisse aus sql\schema wandern als eingebettete Ressourcen per Link
       in die Assembly, damit die EXE ohne Beilagen verteilbar bleibt. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\sql\schema\001_grundschema.sql"
                      Link="Schema\001_grundschema.sql"
                      LogicalName="EposSqliteMigrator.Kern.Schema.001_grundschema.sql" />
    <EmbeddedResource Include="..\..\sql\schema\002_views.sql"
                      Link="Schema\002_views.sql"
                      LogicalName="EposSqliteMigrator.Kern.Schema.002_views.sql" />
    <EmbeddedResource Include="..\..\sql\schema\003_indizes_fk.sql"
                      Link="Schema\003_indizes_fk.sql"
                      LogicalName="EposSqliteMigrator.Kern.Schema.003_indizes_fk.sql" />
    <EmbeddedResource Include="..\..\sql\schema\inventar.json"
                      Link="Schema\inventar.json"
                      LogicalName="EposSqliteMigrator.Kern.Schema.inventar.json" />
  </ItemGroup>

</Project>
