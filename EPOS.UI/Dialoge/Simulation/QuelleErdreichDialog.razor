    /// <summary>
    /// Der Bodentyp über seinen Katalogschlüssel: Er geht den Weg der Klappliste
    /// (<see cref="BodentypWaehlen"/>), damit Kennwertzeile, Vorschau und Prüfung
    /// nachziehen. Ein Schlüssel, den der Katalog nicht führt, wird abgewiesen.
    /// </summary>
    private void KiBodentypSetzen(string? schluessel)
    {
        int stelle = ErdreichTemperatur.KatalogIndex(schluessel ?? "");
        if (stelle < 0) return;
        BodentypWaehlen(stelle);
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
