@* Dialog "BHKW-Wirtschaftlichkeit" - die Razor-Fassung (Etappe B5b).

   HERKUNFT. Die WinForms-Fassung Views/Wirtschaftlichkeit/
   Form_BhkwWirtschaftlichkeit.cs (Etappe B5, 03.09.2026) ist mit dieser
   Komponente GELOESCHT - Regel M1 des Umsetzungskonzepts iOS: keine zweite
   Fassung derselben Maske. Uebernommen sind Feldbestand, Reihenfolge,
   Nullsemantik, Zustandslogik, Warn- und Kohaerenzzeilen wortgleich; die
   Beschriftungen kommen aus denselben Schluesseln BHW_*
   (BhkwWirtschaftlichkeitTexte).

   ER RECHNET NICHTS (BW8). Saetze und Herleitung kommen aus dem Bestands-
   rechner KwkgSatzRechner, die Vorschauzahlen und die Steuerherkunft aus dem
   ZULETZT GEBUCHTEN Lauf, die Mengenkette aus KwkgModulNachweis (B3b), die
   Kohaerenzzeilen aus KohaerenzPruefung. Eine Zweitrechnung waere genau die
   zweite Wahrheit, die BW8 verhindern soll.

   ER KENNT KEINE DATENBANK (Hausregel EPOS.UI). Alles kommt als [Parameter]
   herein: die Anlagenzeilen, der Parametersatz, die Ergebnisse des Laufs und
   - als Delegat, wie es KwkgSatzRechner selbst haelt (Leitentscheidung L9) -
   der Zugang zum Gesetzeskatalog. Geschrieben wird ueber die beiden Rueckrufe
   SpeichereAnlage und SpeichereVorgaben; die Huelle ruft damit
   KwkgAnlagenCtrl.Speichere(g, true) (K7, elf Spalten) bzw.
   WirtschaftlichkeitCtrl.SpeichereParameter.

   ER FUEHRT EINEN ARBEITSSTAND, UND GESCHRIEBEN WIRD IM OK-WEG. Jede Eingabe
   landet in BhkwAnlagenstand bzw. BhkwVorgabenstand - nicht in den Objekten,
   die der Wirt hereingereicht hat. Erst OK legt den Stand auf diese Objekte
   und schreibt sie, in der Reihenfolge Anlagenzeilen (Listenreihenfolge) und
   danach Projektvorgaben. Scheitert ein Schritt, bleibt der Dialog offen und
   nennt die Zahl der gescheiterten Saetze; was geschrieben ist, gilt und wird
   bei einem zweiten OK nicht wiederholt. Abbrechen, das Kreuz der
   Ueberlagerung und Esc verlassen den Dialog OHNE einen einzigen
   Schreibzugriff - und ohne dass ein hereingereichtes Objekt sich veraendert
   haette. Die beiden Sprungknoepfe nehmen denselben Weg wie OK: Sie schreiben
   und schliessen, sonst waeren die Eingaben mit dem Sprung verloren - aber sie
   schreiben NUR, wenn sich der Arbeitsstand seit dem Laden wertlich geaendert
   hat. Wer nur nachschlagen will, soll keinen Schreibzugriff ausloesen; ein
   Schreiben ohne Aenderung ueberschriebe in einer Mehrbenutzerlage fremde
   Aenderungen mit dem eigenen geladenen Stand. Scheitert das Schreiben, findet
   der Sprung nicht statt und die Maske bleibt offen.

   NULLSEMANTIK durchgehend: An der Anlage heisst leer bzw. 0 "kein eigener
   Wert - es gilt die Projektvorgabe" (E6-/B3a-Muster); nur beim
   Hilfsenergieanteil heisst 0 "keine Hilfsenergie" (BF4).

   TASTATUR. Eine BlazorWebView sieht AcceptButton und CancelButton des
   Formulars nicht; Esc wird deshalb hier beantwortet. Enter bleibt bewusst
   unbelegt - anders als beim Anlegedialog waere ein versehentliches Enter in
   einer Maske mit dreissig Feldern kein Bestaetigen, sondern ein Zufall. *@

@namespace EPOS.UI.Dialoge.Wirtschaftlichkeit

@using WindowsFormsApplication1
@using Microsoft.AspNetCore.Components.QuickGrid

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: Zeigt der Wirt schon einen Titel - die Ueberlagerung
       der Wirtschaftlichkeitsseite tut es -, bleibt der eigene Kopf weg; der
       Hilfeknopf bleibt immer. Der Titel ist hier ein gerechneter Kopftitel
       (Textbuendel plus Stammname), kein leerbares TitelText. Das Kreuz steht
       beim Titel und geht denselben Weg wie Esc: Verwerfen, ohne zu schreiben. *@
    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@Kopftitel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Verwerfen" />
        }
    </div>

    @* ------------------------------------------------ Gruppe 1: Anlagen *@
    <Gruppenkopf Titel="@_t.G1" Symbol="⚙">
        <KindInhalt>
            <Raster TZeile="KwkgAnlagenAngabe" Zeilen="@Anlagen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpWahl">
                        <button type="button"
                                class="@Wahlklasse(context)"
                                aria-pressed="@(Gewaehlt(context) ? "true" : "false")"
                                @onclick="() => Waehle(context)">@(Gewaehlt(context) ? "●" : "○")</button>
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpProjekt">
                        @context.Projektname
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpAnlage">
                        @context.Bezeichner
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpPel">
                        @context.PelKW.ToString("N0", BhwTexte.Kultur)
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpBrennstoff">
                        @context.Brennstoffname
                    </TemplateColumn>
                    @* Die drei Spalten zeigen den ARBEITSSTAND, nicht die geladene
                       Zeile - sonst widerspraeche die Tabelle den Feldern darunter. *@
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpStichtag">
                        @BhwTexte.Kurzdatum(Tag(Stand(context).Stichtag))
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpIbn">
                        @BhwTexte.Kurzdatum(Tag(Stand(context).Inbetriebnahme))
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpAnlagenart">
                        @BhkwWahlen.TextZu(_artA, Stand(context).Anlagenart)
                    </TemplateColumn>
                </KindInhalt>
            </Raster>

            @foreach (string zeile in Anlagenwarnungen())
            {
                <Warnbanner Stufe="WarnStufe.Warnung" Text="@zeile" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------- Gruppe 1b: Angaben der gewaehlten Anlage *@
    <Gruppenkopf Titel="@_t.G1b">
        <KindInhalt>
            @if (AktuellerStand is null)
            {
                <Herleitungszeile Text="@_t.AOhneWahl" />
            }
            else
            {
                @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben
                   dem Feld, Zahlenfelder kurz mit der Einheit dahinter. Die
                   Herleitungszeile bleibt ausserhalb - sie ist ein Satz, kein Feld. *@
                <Formularraster>
                    <KindInhalt>
                    <Datumsfeld Bezeichnung="@_t.AStichtag"
                                Wert="@Tag(AktuellerStand.Stichtag)" WertChanged="StichtagA" />

                    <Datumsfeld Bezeichnung="@_t.AIbn"
                                Wert="@Tag(AktuellerStand.Inbetriebnahme)" WertChanged="IbnA" />

                    <Auswahlfeld Bezeichnung="@_t.AAnlagenart"
                                 Eintraege="@BhkwWahlen.Eintraege(_artA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_artA, AktuellerStand.Anlagenart)"
                                 AuswahlChanged="ArtA" />

                    <Auswahlfeld Bezeichnung="@_t.AEigenfall"
                                 Eintraege="@BhkwWahlen.Eintraege(_fallA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_fallA, AktuellerStand.Eigenfall)"
                                 AuswahlChanged="FallA" />

                    @* ETAPPE BK1 (Anwenderwunsch 17.09.2026, Entscheid BK-E-1 a):
                       DER KNOPF STEHT AM FELD, und die Grundlage daneben. Ein
                       Sammelknopf am Ende der Gruppe schrieb mehrere Felder auf
                       einmal; wer ihn drueckte, sah erst danach, was er getroffen
                       hatte. Die Vorschlagszeile spannt im Formularraster ueber die
                       volle Breite und steht damit unter IHREM Feld.

                       VIER NACHKOMMASTELLEN, wie WPAR_EINSP_KWK sie fuehrt: Der
                       Vorschlagsknopf schreibt den gerechneten Satz UNGERUNDET in
                       den Arbeitsstand (300 kW: 5,5667 ct/kWh). Zeigte das Feld nur
                       zwei Stellen, sah der Anwender 5,57 - und die naechste
                       Beruehrung des Feldes meldete genau diese 5,57 zurueck:
                       0,0033 ct/kWh weniger, still. Der Kern kennt keinen
                       Rueckfall, das Feld IST der Satz
                       (WirtschaftlichkeitCtrl.SatzEigenDerAnlage). *@
                    <Zahlenfeld Bezeichnung="@_t.ASatzEinsp" Einheit="ct/kWh"
                                Min="0" Max="30" Nachkommastellen="4"
                                Wert="@AktuellerStand.SatzEinspCt" WertChanged="SatzEinspA" />
                    <Vorschlagszeile Text="@GrundlageEinsp()" Knopftext="@_t.BtnVorschlagFeld"
                                     Erlaubt="@VorschlagEinspErlaubt"
                                     Sperrgrund="@_t.SperrOhnePel"
                                     Uebernommen="VorschlagEinspUebernehmen" />

                    <Zahlenfeld Bezeichnung="@_t.ASatzEigen" Einheit="ct/kWh"
                                Min="0" Max="30" Nachkommastellen="4"
                                Wert="@AktuellerStand.SatzEigenCt" WertChanged="SatzEigenA" />
                    <Vorschlagszeile Text="@GrundlageEigen()" Knopftext="@_t.BtnVorschlagFeld"
                                     Erlaubt="@VorschlagEigenErlaubt"
                                     Sperrgrund="@SperrgrundEigen"
                                     Uebernommen="VorschlagEigenUebernehmen" />

                    <Zahlenfeld Bezeichnung="@_t.AKontingent" Einheit="h"
                                Min="0" Max="200000" Nachkommastellen="0"
                                Wert="@AktuellerStand.VbhKontingent" WertChanged="KontingentA" />
                    <Vorschlagszeile Text="@GrundlageKontingent()" Knopftext="@_t.BtnVorschlagFeld"
                                     Erlaubt="@VorschlagKontingentErlaubt"
                                     Sperrgrund="@_t.SperrOhneAnlagenart"
                                     Uebernommen="VorschlagKontingentUebernehmen" />

                    <Zahlenfeld Bezeichnung="@_t.ADeckel" Einheit="h/a"
                                Min="0" Max="8760" Nachkommastellen="0"
                                Wert="@AktuellerStand.VbhDeckel" WertChanged="DeckelA" />

                    @* BK1: Der Kostenanteil gehoert zur Anlage, weil § 8 Abs. 2/3 die
                       Kontingentstufe aus IHREM Anteil waehlt (Schemaschritt 89). *@
                    <Zahlenfeld Bezeichnung="@_t.AKostenanteil" Einheit="%"
                                Min="0" Max="100" Nachkommastellen="1"
                                Wert="@AktuellerStand.Kostenanteil" WertChanged="KostenanteilA" />

                    <Auswahlfeld Bezeichnung="@_t.AEnergiesteuer"
                                 Eintraege="@BhkwWahlen.Eintraege(_esA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_esA, AktuellerStand.EnergiesteuerWahl)"
                                 AuswahlChanged="EnergiesteuerA" />

                    <Auswahlfeld Bezeichnung="@_t.AAufteilung"
                                 Eintraege="@BhkwWahlen.Eintraege(_aufA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_aufA, AktuellerStand.AufteilungMethode)"
                                 AuswahlChanged="AufteilungA" />

                    @* K2/K6: Die Bemessungsbasis steht ausdruecklich in der Beschriftung -
                       gerechnet wird am ENDENERGIEbedarf (Brennstoff) der Anlage, nicht an
                       den Kosten; die Saetze der beiden Wege sind nicht austauschbar.
                       Das Feld ist nur fuer BHKW-Anlagen gedacht (AnteilPflegbar). *@

                    @if (AnteilSichtbar)
                    {
                        <Zahlenfeld Bezeichnung="@_t.AHilfsanteil" Einheit="%"
                                    Min="0" Max="100" Nachkommastellen="1"
                                    Wert="@AktuellerStand.HilfsenergieAnteil" WertChanged="HilfsAnteilA" />
                    }
                    </KindInhalt>
                </Formularraster>

                @if (AnteilSichtbar)
                {
                    <Herleitungszeile Text="@_t.AHilfsBasis" />
                }
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------- Gruppe 2: KWK-Zuschlag *@
    <Gruppenkopf Titel="@_t.G2">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                @* AUFTRAG #325 (Anwenderwunsch 17.09.2026): "heraus nehmen aus
                   Parameter Dialog: … Strom — Einspeisung und Bezug und in
                   BHKW-Dialog Kosten". Der Satz, mit dem der EINGESPEISTE KWK-Strom
                   verguetet wird, steht jetzt hier - bei den Geldgroessen des BHKW
                   und nicht mehr in einem Sammelabschnitt der
                   Wirtschaftlichkeits-Parameter. Er steht VOR den Zuschlaegen, weil
                   er die Verguetung ist und der Zuschlag obendrauf kommt.

                   DIESELBE WAHRHEIT, andere Eingabestelle: Es ist unveraendert
                   WirtschaftlichkeitParameter.EinspeiseverguetungKWK in EUR/kWh, und
                   geschrieben wird er wie die uebrigen Projektvorgaben dieser Gruppe
                   ueber den Arbeitsstand erst im OK-Weg.

                   0 HEISST "NICHT GEPFLEGT" - die Regel zieht mit. Eine gepflegte 0
                   waere die Aussage "bringt nichts ein" und von einem nie
                   angefassten Feld an dieser Zahl nicht zu unterscheiden. *@
                <Zahlenfeld Bezeichnung="@_t.PEinspKwk" Einheit="€/kWh"
                            Min="0" Max="2" Nachkommastellen="4"
                            Wert="@(_vorgaben.EinspeiseverguetungKwk ?? 0)"
                            WertChanged="EinspeisungKwkP" />

                @* ETAPPE BK1 (Entscheid BK-E-1 a) und BK1b (Entscheid BK1-4 a): HIER
                   STEHT NUR NOCH, WAS WIRKLICH PROJEKTWEIT IST. Satz, Kontingent,
                   Jahresdeckel, Anlagenart, Tatbestand und Kostenanteil sind seit
                   Schemaschritt 89 Angaben DER ANLAGE - § 7 bemisst den Satz an ihrer
                   Leistung, § 8 das Kontingent an ihrer Anlagenart UND ihrem
                   Kostenanteil. Sie hier ein zweites Mal zu fuehren, war die doppelte
                   Wahrheit samt Rueckfallkette, die BK1 aufloest. *@
                <Zahlenfeld Bezeichnung="@_t.PAbschlag" Einheit="%"
                            Min="0" Max="50" Nachkommastellen="1"
                            Wert="@_vorgaben.KwkgAbschlagNegativ" WertChanged="AbschlagP" />

                <Schalter Bezeichnung="@_t.PPauschal"
                          Wert="@_vorgaben.KwkgPauschalmodus" WertChanged="PauschalP" />

                <Datumsfeld Bezeichnung="@_t.PStichtag"
                            Wert="@Tag(_vorgaben.KwkgStichtag)" WertChanged="StichtagP" />

                @* BK1: Dasselbe Feld, neu beschriftet. Es ist keine "Vorgabe je
                   Anlage" mehr, sondern der FOERDERBEGINN - das Startjahr ALLER
                   jahresscharfen Reihen (KWKG, CO2, Steuern), auch ohne BHKW. *@
                <Datumsfeld Bezeichnung="@_t.PIbn"
                            Wert="@Tag(_vorgaben.KwkgInbetriebnahme)" WertChanged="IbnP" />
                </KindInhalt>
            </Formularraster>

            @* AUFTRAG #325 / SP-E-5 (a): Was der Einspeisesatz sonst noch bewegt.
               Wer ihn aendert, aendert die Speicherrechnung mit - und das muss
               dort stehen, wo er ihn aendert. *@
            <Herleitungszeile Text="@_t.PEinspKwkHinweis" />

            @* BK1: Wo die uebrigen KWK-Angaben hin sind - sonst sucht ein Anwender,
               der den Dialog kennt, die Saetze. *@
            <Herleitungszeile Text="@_t.PNurProjektweit" />
        </KindInhalt>
    </Gruppenkopf>

    @* -------------------------------------------- Gruppe 3: Energiesteuer *@
    <Gruppenkopf Titel="@_t.G3">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                <Auswahlfeld Bezeichnung="@_t.EWahl"
                             Eintraege="@BhkwWahlen.Eintraege(_esP)"
                             Auswahl="@BhkwWahlen.NummerZu(_esP, _vorgaben.EnergiesteuerWahl)"
                             AuswahlChanged="EnergiesteuerP" />

                <Auswahlfeld Bezeichnung="@_t.EAufteilung"
                             Eintraege="@BhkwWahlen.Eintraege(_aufP)"
                             Auswahl="@BhkwWahlen.NummerZu(_aufP, _vorgaben.AufteilungMethode)"
                             AuswahlChanged="AufteilungP" />

                @* K5: Der Jahresnutzungsgrad bleibt eine PROJEKTgroesse (B3a-Stand) - ein
                   anlagenscharfer Wert waere eine eigene Datenfrage. *@
                <Zahlenfeld Bezeichnung="@_t.ENutzungsgrad" Einheit="%"
                            Min="0" Max="100" Nachkommastellen="1"
                            Wert="@_vorgaben.Jahresnutzungsgrad" WertChanged="NutzungsgradP" />
                </KindInhalt>
            </Formularraster>

            <Herleitungszeile Text="@Steuerherkunft()" />
        </KindInhalt>
    </Gruppenkopf>

    @* --------------------------------------------- Gruppe 4: Stromsteuer *@
    <Gruppenkopf Titel="@_t.G4">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                @* BW4: Die Unternehmensart ist das fuehrende Feld der Stromsteuerseite. *@
                <Auswahlfeld Bezeichnung="@_t.SUnternehmensart"
                             Eintraege="@BhkwWahlen.Eintraege(_uaP)"
                             Auswahl="@BhkwWahlen.NummerZu(_uaP, _vorgaben.Unternehmensart)"
                             AuswahlChanged="UnternehmensartP" />

                <Schalter Bezeichnung="@_t.SRaeumlich"
                          Wert="@_vorgaben.RaeumlicherZusammenhang" WertChanged="RaeumlichP" />

                <Schalter Bezeichnung="@_t.SHocheffizienz"
                          Wert="@_vorgaben.HocheffizienzNachweis" WertChanged="HocheffizienzP" />

                @* Das Modusfeld des § 9 Abs. 1 Nr. 3 (BW3) schreibt seit dem
                   Schemaschritt 88 nach Tab_ProjektWirtschaftlichkeit.Stromst_Befreiung_Modus.
                   Vorgabe ist AUSWEIS - NummerZu faellt auf den ersten Eintrag zurueck,
                   solange nichts gepflegt ist. *@
                <Auswahlfeld Bezeichnung="@_t.SModus"
                             Eintraege="@BhkwWahlen.Eintraege(_modus)"
                             Auswahl="@BhkwWahlen.NummerZu(_modus, _vorgaben.StromsteuerBefreiungModus)"
                             AuswahlChanged="BefreiungsmodusP" />
                </KindInhalt>
            </Formularraster>

            <Herleitungszeile Text="@_t.SModusHerleitung" />

            <button type="button" class="epos-knopf epos-sprung"
                    @onclick="SprungStrombezug">@_t.BtnStrombezug</button>

            @* Kein Funktionsverlust durch K8 = c: Der Knopf der Wirtschaftlichkeitsseite,
               der bis B5 die BHKW-Sicht der Tarifstruktur oeffnete, fuehrt jetzt hierher -
               die Sicht selbst bleibt ueber diesen Sprung erreichbar. *@
            <button type="button" class="epos-knopf epos-sprung"
                    @onclick="SprungBhkwTarif">@_t.BtnBhkwTarif</button>

            @* Der Satz kuendigt das Schreiben an - er steht deshalb nur, wenn ein
               Sprung jetzt wirklich schreiben wuerde (Anwenderentscheid 15.09.2026). *@
            @if (SprungSchreibtMit)
            {
                <Herleitungszeile Text="@_t.SSprungHinweis" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------- Kohaerenzpruefung (A-2) *@
    <Gruppenkopf Titel="@_t.GKohaerenz">
        <KindInhalt>
            @if (SteuerlicheHinweise().Count == 0)
            {
                <Kohaerenzzeile Zustand="KohaerenzZustand.Ok" Text="@_t.KLeer" />
            }
            else
            {
                @foreach (KohaerenzHinweis h in SteuerlicheHinweise())
                {
                    <Warnbanner Stufe="@Stufe(h.Schwere)" Text="@h.Text" />
                }
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ---------------------------------------------- Gruppe 5: Hilfsstrom *@
    <Gruppenkopf Titel="@_t.G5">
        <KindInhalt>
            @* K1: Es gibt bewusst KEIN Feld "Deckung je Modul" - die Spalte ist mit
               § 4.5 des Konzepts gestrichen (BW6). *@
            <Herleitungszeile Text="@_t.HBasis" />

            @foreach (string zeile in Mengenkette())
            {
                <Herleitungszeile Text="@zeile" />
            }

            @foreach (KohaerenzHinweis h in Doppelpflegehinweise())
            {
                <Warnbanner Stufe="@Stufe(h.Schwere)" Text="@h.Text" />
            }

            @* K6: Der Anteil gilt formal fuer jede Anlagenart, gelesen wird er in B3 aber
               nur fuer BHKW und Kessel. Gepflegt wird er hier allein am BHKW; fuer Kessel
               steht hier der Verweis, die Waermepumpe kommt spaeter. *@
            @if (Kesselhinweis)
            {
                <Herleitungszeile Text="@_t.HKessel" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------------ Gruppe 6: Vorschau *@
    <Gruppenkopf Titel="@_t.G6" Symbol="Σ">
        <KindInhalt>
            @foreach ((string Titel, string Wert) z in Vorschau())
            {
                <Herleitungszeile Text="@z.Titel" Formel="@z.Wert" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_meldung" />
    }

    @* Zwei Ausgaenge, wie in jeder Maske des Hauses: OK schreibt den ganzen
       Arbeitsstand und schliesst, Abbrechen verlaesst ihn ohne einen einzigen
       Schreibzugriff. Einen nicht schliessenden Speichern-Knopf gibt es nicht
       mehr - er war der Grund, warum diese Maske kein Abbrechen tragen konnte. *@
    <SpeichernLeiste @ref="_leiste" MitSpeichern="false" MitAbbrechen="true"
                     OkText="@_t.Speichern" AbbrechenText="@_t.Abbrechen"
                     Ergebnis="BeiErgebnis" />
</div>

@code {
    // =====================================================================
    // Was hereinkommt
    // =====================================================================

    /// <summary>Anzeigename des Stammprojekts - er steht hinter dem Titel.</summary>
    [Parameter] public string StammName { get; set; } = "";

    /// <summary>
    /// Die BHKW-Anlagen der Vergleichsgruppe (<c>KwkgAnlagenCtrl.LadeGruppe</c>),
    /// fertig geladen.
    ///
    /// <para><b>Der Dialog laesst sie bis zum OK in Ruhe.</b> Jede Eingabe steht im
    /// Arbeitsstand (<see cref="BhkwAnlagenstand"/>); erst der OK-Weg legt ihn auf
    /// diese Zeilen und schreibt sie. Nach Abbrechen sind sie unveraendert.</para>
    /// </summary>
    [Parameter] public IList<KwkgAnlagenAngabe> Anlagen { get; set; } = new List<KwkgAnlagenAngabe>();

    /// <summary>Der Parametersatz des Stammprojekts
    /// (<c>WirtschaftlichkeitCtrl.LadeParameter</c>). Auch er bleibt bis zum OK
