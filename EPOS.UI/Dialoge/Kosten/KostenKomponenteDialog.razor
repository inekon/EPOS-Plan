    private void VarianteFragen(bool kopie)
    {
        if (VariantenGaben is null) return;
        if (kopie && !_stand.VarianteId.HasValue) return;
        _variantenKopie = kopie;
        _variantenGaben = VariantenGaben(kopie);
    }

    private void VarianteFertigMachen(string? name)
    {
        bool kopie = _variantenKopie;
        _variantenGaben = null;
        if (name is null || VarianteNeu is null) return;

        int neueId = VarianteNeu(kopie, name);
        if (neueId == 0)
        {
            Melden(MeldungNameBelegt, WarnStufe.Warnung);
            return;
        }
        Melden("");
        KontextLaden(neueId);
        // „Speichern unter…" hat eine Kopie geschrieben: derselbe Vermerk wie „Speichern".
        if (kopie) GespeichertMelden();
    }

    /// <summary>Wie <c>btnVarianteLoeschen_Click</c> samt Ä8-Restschutz.</summary>
    private void VarianteLoeschenFragen()
    {
        if (!_stand.VarianteId.HasValue) return;

        if (VarianteIstStandard is not null && VarianteIstStandard())
        {
            Melden(MeldungStandardLoeschen, WarnStufe.Hinweis);
            return;
        }

        string name = "";
        foreach ((int id, string text) in _stand.Varianten)
        {
            if (id == _stand.VarianteId.Value) { name = text; break; }
        }

        _frage = string.Format(VorlageVarianteLoeschen, name);
        _frageJa = () =>
        {
            if (VarianteLoeschen is not null && VarianteLoeschen()) KontextLaden(null);
            return Task.CompletedTask;
        };
    }

