    private void ZweitenReiterFuellen()
    {
        _sollTag = Daten.SollTag;
        _nachtAbsenkung = Daten.NachtAbsenkung;
        _maxTemperatur = Daten.MaxTemperatur;
        _weAbsenkung = Daten.WochenendAbsenkung;
        _sollFerien = Daten.SollFerien;
        _wbvkFenster = Daten.WbvkFensterWand;
        _wbvkKeller = Daten.WbvkAussenwandKeller;
        _wbvkDach = Daten.WbvkWandDach;
        _anschlussFenster = Daten.AnschlussFensterWand;
        _anschlussDach = Daten.AnschlussWandDach;
        _anschlussKeller = Daten.AnschlussAussenwandKeller;
        _luftwechsel = Daten.Luftwechselrate;

        for (int n = 0; n < 4; n++)
        {
            (int? tag, int? monat) = Ferienzeit.TagUndMonat(Daten.Ferienbeginn[n]);
            _beginnTag[n] = tag;
            _beginnMonat[n] = monat;

            (tag, monat) = Ferienzeit.TagUndMonat(Daten.Ferienende[n]);
            _endeTag[n] = tag;
            _endeMonat[n] = monat;
        }
    }

    /// <summary>
    /// Der frühere <c>btn_Speichern_Click</c>:122-205 — vier Ableitungen und die vier
    /// Ferienregeln. Leere Felder gelten wie im Vorläufer als 0.
    /// </summary>
    private void BeiUebernehmen()
    {
        int[] beginn = new int[4];
        int[] ende = new int[4];
        for (int n = 0; n < 4; n++)
        {
            beginn[n] = Ferienzeit.Jahrestag(_beginnMonat[n], _beginnTag[n]);
            ende[n] = Ferienzeit.Jahrestag(_endeMonat[n], _endeTag[n]);
        }

        string regel = Ferienzeit.Pruefen(beginn, ende);
        if (regel is not null) { Melden(FerienMeldung(regel), WarnStufe.Warnung); return; }

        Daten.SollTag = _sollTag ?? 0;
        Daten.NachtAbsenkung = _nachtAbsenkung ?? 0;

        // "Maximaleraumtemperatur < 1 -> 24" (btn_Speichern_Click:151).
        double max = _maxTemperatur ?? 0;
        Daten.MaxTemperatur = max < 1 ? 24 : max;

        Daten.WochenendAbsenkung = _weAbsenkung ?? 0;
        Daten.Wochenende = (Daten.WochenendAbsenkung ?? 0) > 0 ? 1 : 0;
        Daten.SollFerien = _sollFerien ?? 0;
        Daten.Ferien = (Daten.SollFerien ?? 0) > 0 ? 1 : 0;

        Daten.WbvkFensterWand = _wbvkFenster ?? 0;
        Daten.WbvkAussenwandKeller = _wbvkKeller ?? 0;
        Daten.WbvkWandDach = _wbvkDach ?? 0;
        Daten.AnschlussFensterWand = _anschlussFenster ?? 0;
        Daten.AnschlussWandDach = _anschlussDach ?? 0;
        Daten.AnschlussAussenwandKeller = _anschlussKeller ?? 0;

        // "Ferienbeginn_1 == 0 -> 366" (btn_Speichern_Click:198).
        beginn[0] = Ferienzeit.WinterbeginnGehoben(beginn[0]);
        Daten.Ferienbeginn = beginn;
        Daten.Ferienende = ende;

        Daten.Luftwechselrate = _luftwechsel ?? 0;
        Daten.WwBedarf = 0;

        Melden(MeldungUebernommen, WarnStufe.Hinweis);
    }

    private string FerienMeldung(string schluessel) => schluessel switch
    {
        Ferienzeit.MELDUNG_WINTER => MeldungFerienWinter,
        Ferienzeit.MELDUNG_OSTERN => MeldungFerienOstern,
        Ferienzeit.MELDUNG_SOMMER => MeldungFerienSommer,
        _ => MeldungFerienHerbst
    };

