@* Der Inhalt des Haupt-Reiters "Berichte & Kosten" (iU9-W5.6).

   Vorbild: Views/BerichteKosten/UcBerichteKosten.cs (810 Z., K4).

   DIE VIER BEREICHE ALS ZWEITE REITEREBENE (Konzept Navigation Berichte &
   Kosten, Variante A, Anwenderentscheide BN-Q1 bis BN-Q3): Uebersicht, Kosten,
   Wirtschaftlichkeit und Bericht stehen im Hausbaustein Reiter - dieselbe
   Reiterzeile wie auf der Simulationsseite und in den Dialogen, keine eigene
   Navigation, keine eigene Farbe, die volle Breite fuer die Tabellen. Jeder
   Reiter traegt unter dem Titel eine Statuszeile (der Kurzstand der Huelle:
   Zahl der Versionen, Warnungen der Kosten, bester Kapitalwert, zuletzt
   erstellter Bericht); unter 900 px steht deren Kurzform. Rechts in derselben
   Zeile stehen Stammname, Platzhalter-Umschalter, Hilfe und - als eigene
   Ansicht - der Rueckweg; eine eigene Kopfzeile gibt es nicht.

   EINE WebView, VIER SEITEN (Risiko R5). Der Vorlaeufer haengte vier
   UserControls nacheinander in ein Panel; hier ist es der Reiter ueber vier
   Schluessel. Die Seitenschluessel sind dieselben geblieben - die Sprungziele
   des Menues, der Seitenwunsch der Huelle und "Zum Bericht ›" setzen den
   aktiven Reiter. Die Knopfkennungen tragen den Vorsatz "bk", weil die
   Startseite selbst einen Reiter traegt.

   DIE SCHWEREN SEITEN ENTSTEHEN ERST BEIM ERSTEN AUFRUF: Ein nicht gewaehltes
   Reiterblatt zeichnet nichts, und nur die gewaehlte Seite bekommt Gaben. Die
   Statuszeilen der schweren Seiten rechnen nichts - sie nennen, was die Huelle
   ohne Rechnung weiss.

   OHNE STAMMPROJEKT gibt es keine Vergleichsgruppe: Wirtschaftlichkeit und
   Bericht bekommen dann keinen Parametersatz, und statt der Seite steht der
   Hinweis - wortgleich zum Vorlaeufer (BK_MSG_KEIN_STAMM).

   DER PROJEKTWECHSEL laeuft ueber den SeitenZustand der Huelle: Wer im
   Kopfband der Startmaske auf eine andere Version umschaltet, loest
   Geaendert aus; die Seite holt ihre Gaben neu, OHNE dass die WebView neu
   gebaut wuerde. Ein geaenderter KURZSTAND (KurzstandGeaendert) zeichnet nur
   die Reiterzeile neu und laesst die offene Seite stehen.

   H11 ENTFAELLT. Der Vorlaeufer musste den Infoknopf jeder eingebetteten
   Seite von der Kopfzeile abruecken. In der Blazor-Fassung traegt die
   Reiterzeile den Knopf des Behaelters und jede Seite ihren eigenen im FLUSS
   ihres Inhalts; sie koennen sich nicht ueberdecken.

   "ZUM BERICHT ›" ist ein BEREICHSWECHSEL dieses Rahmens: Die Wirtschaftlichkeitsseite
   meldet eine BerichtVorbelegung (Baustein Wirtschaftlichkeit, Vergleichsgruppe,
   Szenario), der Rahmen haelt sie, stellt den Reiter "Bericht" vorn und reicht sie der
   Berichtsseite beim Aufbau EINMAL mit. Erzeugt wird allein dort, mit "Erstellen".

   BEREICHSZEILE. Die Wurzel traegt den Modifikator epos-reiter--bereich: Die
   Reiterzeile steht als zweite Ebene unter den Hauptreitern deutlicher als die
   leise Hausleiste (eigene Flaeche, groessere Titel). Nur diese Seite setzt ihn. *@

@namespace EPOS.UI.Seiten.Berichte
@implements IDisposable

<div class="epos-berichtekosten epos-reiter--bereich">
    <Reiter Kennung="@KENNUNG" @bind-Aktiv="_seite" @bind-Aktiv:after="SeiteGewechselt"
            Bezeichnung="@NavigationBezeichnung" Leistenende="@Leistenende">
        <KindInhalt>
            @foreach ((string schluessel, string titel) in Eintraege)
            {
                string s = schluessel;
                Reiterstatus? stand = StatusVon(s);
                <Reiterblatt @key="s" Schluessel="@s" Titel="@titel"
                             Status="@(stand?.Text ?? "")" StatusKurz="@(stand?.Kurz ?? "")"
                             Statusstufe="@(stand?.Stufe ?? Statusstufe.Normal)">
                    <KindInhalt>@Inhalt</KindInhalt>
                </Reiterblatt>
            }
        </KindInhalt>
    </Reiter>
</div>

@code {
    // =====================================================================
    // Die vier Seitenschluessel — Schicht 2 der Drei-Schichten-Regel:
    // sprachneutral, ASCII. Wortgleich aus UcBerichteKosten uebernommen,
    // damit die Sprungziele des Menues (Hauptfensterrahmen) unveraendert bleiben.
    // =====================================================================

    /// <summary>Die Seite „Übersicht".</summary>
    public const string SEITE_UEBERSICHT = "UEBERSICHT";

    /// <summary>Die Seite „Kosten".</summary>
    public const string SEITE_KOSTEN = "KOSTEN";

    /// <summary>Die Seite „Wirtschaftlichkeit".</summary>
    public const string SEITE_WIRTSCHAFT = "WIRTSCHAFT";

    /// <summary>Die Seite „Bericht".</summary>
    public const string SEITE_BERICHT = "BERICHT";

    // =====================================================================
    // Datenseite
    // =====================================================================

    /// <summary>
    /// Der Parametersatz einer Seite. <c>null</c> heißt „geht gerade nicht" —
    /// ohne Stammprojekt gibt es keine Vergleichsgruppe, und statt der Seite
    /// steht <see cref="KeinStammText"/>.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyDictionary<string, object>?>? SeitenGaben { get; set; }

    /// <summary>
    /// Der Name des Stammprojekts für das Ende der Reiterzeile; leer = keins (dann steht dort
    /// kein Stammname). Gefragt bei jedem Zeichnen — der Stamm steht erst fest, wenn die
    /// Übersicht ihre Gruppe geladen hat.
    /// </summary>
    [Parameter] public Func<string>? Stamm { get; set; }

    /// <summary>Die Beschriftung vor dem Stammnamen (BK_LBL_STAMM_KURZ).</summary>
    [Parameter] public string StammBeschriftung { get; set; } = "Stamm:";

    /// <summary>
    /// Der KURZSTAND je Seitenschlüssel für die Statuszeile des Reiters (Konzept Navigation
    /// Berichte &amp; Kosten, A2); <c>null</c> = keine Zeile. Gefragt bei jedem Zeichnen: Die
    /// Hülle antwortet aus dem, was sie ohne Rechnung weiß — die schweren Seiten rechnen dafür
    /// nicht.
    /// </summary>
    [Parameter] public Func<string, Reiterstatus?>? Status { get; set; }

    /// <summary>
    /// Der geteilte Zustand der Hülle: Projektwechsel und Auffrischen. Die
    /// Seite hängt sich an sein Änderungsereignis, statt die WebView neu
    /// bauen zu lassen.
    /// </summary>
    [Parameter] public EPOS.UI.Dienste.SeitenZustand? Zustand { get; set; }

    /// <summary>Die Seite, die beim Aufbau vorn steht.</summary>
    [Parameter] public string Startseite { get; set; } = SEITE_UEBERSICHT;

    /// <summary>
    /// Ein Seitenwunsch der Hülle, abgefragt bei jeder Änderung des Zustands.
    /// Leer = keiner. So kommt der Menüweg „Projekte › Varianten und Bericht…"
    /// an sein Ziel, ohne dass die Hülle die Komponente kennen müsste
    /// (Vorbild <c>UcBerichteKosten.ZeigeSeite</c>).
    /// </summary>
    [Parameter] public Func<string>? Seitenwunsch { get; set; }

    /// <summary>Hilfeschlüssel des Rahmens — der der alten Maske (Rückfall, wenn keine Seite passt).</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "UcBerichteKosten.btn_Help";

    /// <summary>
    /// Die Seite möchte verlassen werden — der Rückweg zur
    /// <c>AppWurzel.Startansicht</c> (Anwenderentscheid W16c-E-3, 04.09.2026).
    ///
    /// <para>OHNE Rückruf gibt es keinen Rückwegknopf: So steht die Seite als
    /// sechstes REITERBLATT der Startseite unverändert da (dort trägt der
    /// Reiterkopf die Navigation), und als eigene ANSICHT der Wurzel bekommt
    /// sie ihn. Dieselbe Weiche wie bei <c>SimulationKonfigSeite</c>.</para>
    /// </summary>
    [Parameter] public EventCallback Geschlossen { get; set; }

    // ---- Texte ----------------------------------------------------------

    [Parameter] public string NavUebersicht { get; set; } = "Übersicht";
    [Parameter] public string NavKosten { get; set; } = "Kosten";
    [Parameter] public string NavWirtschaft { get; set; } = "Wirtschaftlichkeit";
    [Parameter] public string NavBericht { get; set; } = "Bericht";
    [Parameter] public string NavigationBezeichnung { get; set; } = "Berichte und Kosten";

    /// <summary>
    /// Vorsatz der Kennungen von Reiterknopf und Blatt — die Startseite trägt selbst einen
    /// Reiter, und dieselben Schlüssel dürfen nicht zweimal als HTML-Kennung stehen.
    /// </summary>
    public const string KENNUNG = "bk";

    /// <summary>Beschriftung des Rückwegknopfes (BK_BTN_ZURUECK).</summary>
    [Parameter] public string ZurueckText { get; set; } = "◀ Zurück";

    /// <summary>Hinweis ohne Stammprojekt (BK_MSG_KEIN_STAMM).</summary>
    [Parameter] public string KeinStammText { get; set; }
        = "Bitte zuerst ein Stammprojekt wählen.";

    // =====================================================================
    // Zustand
    // =====================================================================

    private string _seite = SEITE_UEBERSICHT;
    private IReadOnlyDictionary<string, object>? _gaben;

    /// <summary>
    /// Der Zählerstand des letzten Neuaufbaus. Er dient als <c>@@key</c> der
    /// Seitenkomponente: Ein Projektwechsel soll die Seite NEU aufbauen (ihr
    /// <c>OnInitialized</c> lädt), nicht nur ihre Parameter tauschen.
    /// </summary>
    private int _stand;

    /// <summary>Die sichtbare Seite (Prüfhilfe und Wirt).</summary>
    public string AktiveSeite => _seite;

    private IReadOnlyList<(string Schluessel, string Text)> Eintraege => new[]
    {
        (SEITE_UEBERSICHT, NavUebersicht),
        (SEITE_KOSTEN, NavKosten),
        (SEITE_WIRTSCHAFT, NavWirtschaft),
        (SEITE_BERICHT, NavBericht)
    };

    /// <summary>Der Kurzstand eines Reiters; ein Fehler der Hülle kostet nur die Zeile.</summary>
    private Reiterstatus? StatusVon(string schluessel)
    {
        if (Status is null) return null;
        try { return Status(schluessel); }
        catch (Exception) { return null; }
    }

    /// <summary>Der Stammname des Leistenendes (leer = keiner).</summary>
    private string Stammname
    {
        get
        {
            if (Stamm is null) return "";
            try { return Stamm() ?? ""; }
            catch (Exception) { return ""; }
        }
    }

    /// <summary>
    /// Das Ende der Reiterzeile (BN-Q3): Stammname, Platzhalter-Umschalter, Hilfe und — als
    /// eigene Ansicht — der Rückweg. Eine eigene Kopfzeile gibt es nicht.
    /// </summary>
    private RenderFragment Leistenende => __builder =>
    {
        string stamm = Stammname;
        @if (stamm.Length > 0)
        {
            <span class="epos-berichtekosten-stamm" title="@(StammBeschriftung + " " + stamm)">
                <span class="epos-berichtekosten-stamm-beschriftung">@StammBeschriftung</span>
                <span class="epos-berichtekosten-stamm-name">@stamm</span>
            </span>
        }
        @* DER UMSCHALTER DER PLATZHALTERANZEIGE (BV-E6, Konzept 9.4): einer je
           Bildschirm; er gilt fuer alle vier Seiten und bindet an denselben Zustand
           wie jeder andere Umschalter (Vorlagenfeldansicht). *@
        <Vorlagenfeldumschalter Ort="BERICHTE_KOSTEN" />
        @* EINE PILLE JE BILDSCHIRM (Auftrag #221, KI-D-E-1): Als freie ANSICHT
           unter dem Kopfband des Hauptfensters laesst die Seite ihre Pille weg und
           meldet stattdessen ihren Kontext nach oben. Als REITERBLATT der
           Startseite (dort haengt kein Geschlossen-Rueckruf) behaelt sie die
           eigene - mit dem Schluessel der GEZEIGTEN Seite. *@
        @if (!PilleImKopfband)
        {
            <InfoKnopf Schluessel="@HilfeJeSeite" Dialogname="@Kontext.Dialogname" />
        }
        @* DER RUECKWEG (Anwenderentscheid W16c-E-3): nur als eigene ANSICHT der
           AppWurzel (Menuepunkt "Varianten und Bericht…"); ein Reiterblatt der
           Startseite verlaesst man ueber deren Reiterzeile. Er steht rechts aussen
           wie das "← zurueck" der Simulationsansicht. *@
        @if (Geschlossen.HasDelegate)
        {
            <button type="button" class="epos-knopf epos-berichtekosten-zurueck"
                    @onclick="() => Geschlossen.InvokeAsync()">@ZurueckText</button>
        }
    };

    /// <summary>
    /// Der Inhalt des GEWÄHLTEN Reiterblatts — jedes der vier Blätter trägt dasselbe Fragment,
    /// gezeichnet wird es nur im sichtbaren. Darüber die leise Zeile der Stellung „Schlüssel"
    /// (Zahl der Platzhalter, „Katalog…").
    /// </summary>
    private RenderFragment Inhalt => __builder =>
    {
        <Vorlagenfeldzeile />
        @if (_gaben is null)
        {
            <Warnbanner Stufe="WarnStufe.Warnung" Text="@KeinStammText" />
        }
        else if (_seite == SEITE_UEBERSICHT)
        {
            <UebersichtSeite @key="_stand" @attributes="_gaben" />
        }
        else if (_seite == SEITE_KOSTEN)
        {
            <KostenSeite @key="_stand" @attributes="_gaben" />
        }
        else if (_seite == SEITE_WIRTSCHAFT)
        {
            <WirtschaftlichkeitSeite @key="_stand" @attributes="_gaben" />
        }
        else if (_seite == SEITE_BERICHT)
        {
            <BerichtSeite @key="_stand" @attributes="_gaben" />
        }
    };

    /// <summary>Der Hilfeschlüssel der gezeigten Seite — die Schlüssel der alten Masken.</summary>
    private string HilfeJeSeite => _seite switch
    {
        SEITE_UEBERSICHT => "UcBkUebersicht.btn_Help",
        SEITE_KOSTEN => "UcBkKosten.btn_Help",
        SEITE_WIRTSCHAFT => "UcWirtschaftlichkeit.btn_Help",
        SEITE_BERICHT => "UcBericht.btn_Help",
        _ => HilfeSchluessel
    };

    // =====================================================================
    //  Die EINE Pille und der gemeldete Kontext (Auftrag #221, KI-D-E-1)
    // =====================================================================

    /// <summary>
    /// Führt ein Kopfband über dieser Ansicht schon eine Hilfe-Pille? Unter Windows
    /// setzt <c>Hauptfenster</c> den Wert; auf iOS fehlt er.
    /// </summary>
    [CascadingParameter(Name = "HilfePilleImKopfband")]
    public bool HilfePilleImKopfband { get; set; }

    /// <summary>Der Weg nach oben; <c>null</c> = niemand hört zu.</summary>
    [CascadingParameter] public Hilfekontextmelder? Hilfemelder { get; set; }

    /// <summary>
    /// Lässt DIESE Einbaustelle ihre Pille weg? Nur als freie ANSICHT — als
    /// Reiterblatt der Startseite trägt sie sie weiter.
    /// </summary>
    /// <remarks>
    /// <b>Woran die zwei Rollen zu unterscheiden sind:</b> an dem Rückweg. Eine
    /// Ansicht braucht einen, ein Reiterblatt nicht — dieselbe Unterscheidung, mit der
    /// die Seite seit W16c‑E‑3 ihren „← zurück"-Knopf zeigt oder weglässt.
    /// </remarks>
    private bool PilleImKopfband => HilfePilleImKopfband && Geschlossen.HasDelegate;

    /// <summary>Wo der Anwender steht: Hilfeschlüssel und Name der gezeigten Seite.</summary>
    public Hilfekontext Kontext
        => new Hilfekontext(HilfeJeSeite, NavigationBezeichnung, Seitenname);

    /// <summary>Der Name der gezeigten Seite, wie ihn die Navigation zeigt.</summary>
    private string Seitenname => _seite switch
    {
        SEITE_UEBERSICHT => NavUebersicht,
        SEITE_KOSTEN     => NavKosten,
        SEITE_WIRTSCHAFT => NavWirtschaft,
        SEITE_BERICHT    => NavBericht,
        _                => ""
    };

    /// <summary>Der zuletzt nach oben gemeldete Kontext — gemeldet wird nur ein Wechsel.</summary>
    private Hilfekontext? _gemeldet;

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        // Nur die ANSICHT meldet; das Reiterblatt der Startseite steht unter der
        // Startseite und hat keinen Schluessel, den das Kopfband tragen sollte.
        Hilfekontextmelder? melder = Hilfemelder;
        if (melder is null || !Geschlossen.HasDelegate) return;

        Hilfekontext jetzt = Kontext;
        if (_gemeldet is not null && _gemeldet.Equals(jetzt)) return;

        _gemeldet = jetzt;
        melder.Melden(jetzt);
    }

    protected override void OnInitialized()
    {
        _seite = Bekannt(Startseite) ? Startseite : SEITE_UEBERSICHT;
        if (Zustand is not null)
        {
            Zustand.Geaendert += BeiZustand;
            Zustand.KurzstandGeaendert += BeiKurzstand;
        }
        GabenHolen();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (Zustand is not null)
        {
            Zustand.Geaendert -= BeiZustand;
            Zustand.KurzstandGeaendert -= BeiKurzstand;
        }

        // Die Ansicht geht - die Pille im Kopfband faellt auf den Schluessel des
        // Fensters zurueck (Auftrag #221).
        if (Geschlossen.HasDelegate) Hilfemelder?.Melden(null);
    }

    private void BeiZustand()
    {
        // Der Zustand kommt vom Oberflaechenfaden der Huelle; gezeichnet wird
        // ausschliesslich auf dem Renderfaden (Muster AppWurzel.OeffneMaske).
        _ = InvokeAsync(() =>
        {
            string wunsch = Seitenwunsch?.Invoke() ?? "";
            if (Bekannt(wunsch)) _seite = wunsch;

            GabenHolen();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Ein Kurzstand hat sich geändert (eine Seite hat geladen, ein Bericht ist erstellt):
    /// Die Reiterzeile zeichnet neu, die offene Seite bleibt, wie sie ist — keine neuen Gaben.
    /// </summary>
    private void BeiKurzstand() => _ = InvokeAsync(StateHasChanged);

    /// <summary>Der Reiter hat gewechselt (Klick, Pfeiltasten): die Gaben der neuen Seite.</summary>
    private void SeiteGewechselt() => GabenHolen();

    private static bool Bekannt(string s)
        => s == SEITE_UEBERSICHT || s == SEITE_KOSTEN
        || s == SEITE_WIRTSCHAFT || s == SEITE_BERICHT;

    /// <summary>Stellt die Seite mit diesem Schlüssel ein (auch von außen).</summary>
    public void Zeige(string schluessel)
    {
        if (!Bekannt(schluessel)) return;
        _seite = schluessel;
        GabenHolen();
        StateHasChanged();
    }

    private void GabenHolen()
    {
        _gaben = Ergaenzt(SeitenGaben?.Invoke(_seite));
        _stand++;
    }

    // =====================================================================
    //  „Zum Bericht ›" — der Übergabeweg Wirtschaftlichkeit → Bericht
    // =====================================================================

    /// <summary>
    /// Die Vorbelegung, die die Wirtschaftlichkeitsseite der Berichtsseite übergibt — sie
    /// wartet hier, bis die Berichtsseite entsteht, und wird dabei EINMAL verbraucht.
    /// </summary>
    private BerichtVorbelegung? _vorbelegung;

    /// <summary>Die wartende Vorbelegung (Prüfhilfe).</summary>
    public BerichtVorbelegung? WartendeVorbelegung => _vorbelegung;

    /// <summary>
    /// Die Wege dieses Rahmens zu den Gaben der Hülle: Die Wirtschaftlichkeitsseite bekommt
    /// „Zum Bericht ›" (<c>ZumBericht</c>), die Berichtsseite die wartende Vorbelegung. Beides
    /// ist Bedienung zwischen zwei Bereichen derselben Ansicht — die Hülle kennt es nicht.
    /// Ohne Gaben (kein Stammprojekt) gibt es keine Seite und nichts zu ergänzen.
    /// </summary>
    private IReadOnlyDictionary<string, object>? Ergaenzt(IReadOnlyDictionary<string, object>? gaben)
    {
        if (gaben is null) return null;

        if (_seite == SEITE_WIRTSCHAFT)
        {
            var mit = new Dictionary<string, object>(gaben)
            {
                ["ZumBericht"] = EventCallback.Factory.Create<BerichtVorbelegung>(this, ZumBericht)
            };
            return mit;
        }

        if (_seite == SEITE_BERICHT && _vorbelegung is not null)
        {
            var mit = new Dictionary<string, object>(gaben) { ["Vorbelegung"] = _vorbelegung };
            _vorbelegung = null;
            return mit;
        }

        return gaben;
    }

    /// <summary>
    /// „Zum Bericht ›" der Wirtschaftlichkeitsseite: Bereichswechsel auf „Bericht" mit der
    /// Vorbelegung — kein Fenster, kein Lauf.
    /// </summary>
    private void ZumBericht(BerichtVorbelegung vorbelegung)
    {
        if (vorbelegung is null) return;
        _vorbelegung = vorbelegung;
        Zeige(SEITE_BERICHT);
    }
}
