    private ZapfprofilKategorienEditorDaten? _kategorienDaten;

    private static ZapfprofilKategorieDaten ProbeKategorie(int i) => new()
    {
        Name = "Kategorie " + (i + 1) + " (erfunden)", VolumenstromLJeMin = 2 + i % 8, DauerMin = 1 + i % 10,
        Anteil = 0.1, StreuungLJeMin = 0.5 + i % 3, KappungLJeMin = i % 3 == 0 ? 12 + i : null, Herkunft = "fiktiv · Probequelle"
    };

    /// <summary>Der Kategorien-Editor mit <c>zeilen</c> Kategorien; <c>art=lesen</c> = gesperrte Nutzungsart.</summary>
    private ZapfprofilKategorienEditorDaten KategorienDaten => _kategorienDaten ??= new ZapfprofilKategorienEditorDaten
    {
        Nutzungsart = "Wohnen A (erfunden) · PROBE-1",
        KatalogversionVorschlag = _art == "lesen" ? "PROBE-1-E1" : "",
        Stand = new ZapfprofilKategorienDaten
        {
            IdNutzungsart = 7,
            Frei = _art != "lesen",
            Sperrgrund = _art == "lesen" ? "Die Nutzungsart gehört zur Auslieferung – bearbeitbar erst als Kopie." : "",
            SummeAnteil = 0.1 * _anzahl,
            Kategorien = Enumerable.Range(0, _anzahl).Select(ProbeKategorie).ToList(),
            Vorgabe = Enumerable.Range(0, 3).Select(ProbeKategorie).ToList()
        }
    };

    private static ZapfprofilKategorienPruefungDaten KategorienPruefen(IReadOnlyList<ZapfprofilKategorieDaten> k)
        => new() { SummeAnteil = k.Sum(x => x.Anteil ?? 0) };
