@* Solarthermieganglinien eines Projekts - und der Katalog dieser Ganglinien.

   EIN DIALOG. Links die Ganglinien des Projekts, rechts der Katalog, dazwischen
   die Uebernahmeleiste (Baustein Zweispaltenauswahl), darunter Name und
   Beschreibung als Anzeige. Die Katalogpflege steht an der Katalogseite selbst
   (Baustein GanglinieKatalogseite): Liste mit Beschreibung, Jahresarbeit und
   Spitze, Vergleichen, Schloss setzen/aufheben, Loeschen und Import... - es gibt
   keinen Unterdialog "Bearbeiten..." mehr.

   KATALOGBETRIEB (Katalogbetrieb="true"): Der Administrationsmenuepunkt
   "Profile & Lastgaenge -> Solarthermie-Ganglinie" oeffnet DENSELBEN Dialog ohne
   Projekt - die Projektspalte und die Uebernahmeleiste entfallen, der Dialog
   schliesst mit "Beenden" (Import, Loeschen und Schloss schreiben sofort; es gibt
   nichts zu verwerfen).

   DIESELBE DATENFORM WIE DIE ERZEUGER. ErzeugerZeile traegt Schluessel und
   GeraetId getrennt - hier die Zuordnungs-Id (Z_ProjektSolarganglinie.ID) und
   die Ganglinien-Id (Tab_Solarganglinie.ID). Dieselbe Ganglinie darf mehrfach
   zugeordnet sein, und "Aus dem Projekt entfernen" trifft die ZEILE.

   TASTATUR: Esc schliesst, aber erst, wenn Rueckfrage und Import zu sind. Enter
   ist nicht belegt. *@

@namespace EPOS.UI.Dialoge.Solarthermie
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Erzeuger
@using WindowsFormsApplication1
@using WindowsFormsApplication1.Zeichnung
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="BeiKreuz" />
    </div>

    @{
        // Die Daten des gewaehlten Satzes - im Projektbetrieb die Detailzeile der
        // Zweispaltenauswahl, im Katalogbetrieb unter der Katalogseite.
        RenderFragment knoepfe = @<text>
            <InfoKnopf Schluessel="Form_Solarganglinie.Grundlagen"
                       StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
            <InfoKnopf Schluessel="Form_Solarganglinie.Berechnung"
                       StandardKurztext="Berechnungsweg Solarthermie" MitAssistent="false" />
        </text>;

        RenderFragment satzinhalt = @<div class="epos-zweispalten-satzblock">

        @* DIE GANGLINIE DES GEWAEHLTEN SATZES (DZ1, Konzept 4.9): derselbe Baustein und
           dieselben Kennzahlen wie im Waermebedarf extern; ohne Kennzahlen-Delegat keine Grafik.
           Mit Grafik steht der Kopf verdichtet (DZ1-N1): Name und Beschreibung in EINER Zeile,
           die Infoknoepfe rechts in der Kennzahlenzeile - die Kurve bekommt den Rest. *@
        @if (_grafik.Kennzahlen is not null)
        {
            <GanglinienGrafik Schluessel="@_grafik.Schluessel" Bezeichner="@_grafik.Bezeichner"
                              Kennzahlen="@_grafik.Kennzahlen" Bildauftrag="@_grafik.Bild(Bildauftrag)" BildauftragMass="@_grafik.BildMitMass(BildauftragMass)"
                              Einheit="@Einheit" EinheitGewaehlt="@EinheitGewaehlt"
                              LabelJahresarbeit="@LabelJahresarbeit" LabelSpitze="@LabelSpitze"
                              LabelVollbenutzung="@LabelVollbenutzung"
                              LabelSortiert="@LabelSortiert" LabelEinheit="@LabelEinheit"
                              EinheitStunden="@EinheitStunden"
                              Bildtext="@Bildtext" PlatzhalterBild="@PlatzhalterBild"
                              FarbeSetzen="@FarbeSetzen" FarbeZuruecksetzen="@FarbeZuruecksetzen"
                              Knoepfe="@knoepfe">
                <Kopfzeile>
                    <Textfeld Bezeichnung="@LabelName" Wert="@_name" NurLesen="true" />
                    <Textfeld Bezeichnung="@LabelBeschreibung" Wert="@_beschreibung" NurLesen="true"
                              Titel="@_beschreibung" />
                </Kopfzeile>
            </GanglinienGrafik>
        }
        else
        {
            @* Der Weg in die Wikirubriken "Grundlagen" und "Berechnung": wie der Solarertrag
               entsteht. Der Fensterknopf oben rechts bleibt, was er ist. *@
            <div class="epos-berechnungshilfe">@knoepfe</div>

            <Textfeld Bezeichnung="@LabelName" Wert="@_name" NurLesen="true" />
            <Textfeld Bezeichnung="@LabelBeschreibung" Wert="@_beschreibung" NurLesen="true"
                      Mehrzeilig="true" Zeilen="3" />
        }
        </div>;
    }

    @if (Katalogbetrieb)
    {
        <GanglinieKatalogseite @ref="_seite" Wege="@Katalogwege" Profil="@Katalogprofil"
                               Filterstand="@_filterstand" Filtertexte="@Filtertexte"
                               Texte="@Katalogtexte" Gewaehlt="@_katalogGewaehlt"
                               ZeileGewaehlt="BeiKatalogzeile" />
        @satzinhalt
    }
    else
    {
        <Zweispaltenauswahl Dialogname="Solarganglinie" LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                            UebernehmenText="@LabelHinzu"
                            UebernehmenGesperrt="@(_katalogZeile is null)" Uebernehmen="BeiHinzu"
                            EntfernenText="@LabelEntfernen"
                            EntfernenGesperrt="@(_projektZeile is null)" Entfernen="BeiEntfernen"
                            SatzArt="@SatzArt" SatzName="@SatzName">

            <Links>
                <div class="epos-raster-huelle">
                    <table class="epos-raster">
                        <thead>
                            <tr>
                                <th>@SpalteWahl</th>
                                <th>@SpalteName</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (ErzeugerZeile zeile in Zeilen)
                            {
                                ErzeugerZeile z = zeile;
                                <tr class="@(z == _projektZeile ? "epos-zeile--markiert" : null)">
                                    <td>
                                        <Zeilenwahl Gewaehlt="@(z == _projektZeile)" Kurztext="@SpalteWahl"
                                                    Gewaehltwerden="() => ProjektZeileWaehlen(z)" />
                                    </td>
                                    <td>@z.Bezeichner</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </Links>

            <Rechts>
                @* DIE EINE KATALOGLISTE samt Katalogpflege: Suchzeile, Filter im
                   Spaltenkopf, Beschreibung, Jahresarbeit und Spitze; das PROFIL
                   traegt die Spalte "im Projekt verwendet". *@
                <GanglinieKatalogseite @ref="_seite" Wege="@Katalogwege" Profil="@Katalogprofil"
                                       Filterstand="@_filterstand" Filtertexte="@Filtertexte"
                                       Texte="@Katalogtexte" Gewaehlt="@_katalogGewaehlt"
                                       ZeileGewaehlt="BeiKatalogzeile"
                                       ImProjekt="@ProjektBezeichner" />
            </Rechts>

            <Satz>@satzinhalt</Satz>

        </Zweispaltenauswahl>
    }

    @if (Katalogbetrieb)
    {
        <div class="epos-leiste">
            <span class="epos-leiste-fueller"></span>
            <button type="button" class="epos-knopf epos-knopf--primaer"
                    @onclick="() => Geschlossen.InvokeAsync(true)">@BeendenText</button>
        </div>
    }
    else
    {
        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }
</div>

@code {
    /// <summary>
    /// Die Ganglinien des Projekts. <c>Schluessel</c> ist die Zuordnungs-Id
    /// (<c>Z_ProjektSolarganglinie.ID</c>), <c>GeraetId</c> die Ganglinien-Id
    /// (<c>Tab_Solarganglinie.ID</c>). Die Liste gehört der Hülle und wird an Ort und
    /// Stelle bearbeitet.
    /// </summary>
    [Parameter] public List<ErzeugerZeile> Zeilen { get; set; } = new();

    /// <summary>
    /// <b>Ohne Projekt</b> — der Weg des Administrationsmenüs: nur die Katalogseite, kein
    /// Übernehmen, Schluss über „Beenden".
    /// </summary>
    [Parameter] public bool Katalogbetrieb { get; set; }

    /// <summary>
    /// Die Wege der Katalogseite: Katalog samt Kennzahlen, Verwendung, Löschen, Schloss,
    /// Import (Hülle <c>SolarganglinieKatalogGaben</c>).
    /// </summary>
    [Parameter] public GanglinienKatalogwege Katalogwege { get; set; } = new();

    /// <summary>Die Beschriftungen der Katalogseite.</summary>
    [Parameter] public GanglinienKatalogtexte Katalogtexte { get; set; } = new();

    /// <summary>
    /// Die Spalten des Katalogs —
    /// <c>Katalogfilterprofil.FuerZeitreihe(Zeitreihenart.Solarganglinie, …)</c>, im
    /// Projektbetrieb mit der Spalte „im Projekt verwendet".
    /// </summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste — sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Ein eigener Filterstand statt des Registers (Muster der Katalogdialoge).</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>Nimmt die Ganglinie in das Projekt auf („◀").</summary>
    [Parameter] public Func<int, ErzeugerZeile?>? Aufnehmen { get; set; }

    /// <summary>Entfernt die Zeile aus der geteilten Liste („▶").</summary>
    [Parameter] public Action<ErzeugerZeile>? Entfernen { get; set; }

    /// <summary><c>true</c> = OK bzw. Beenden, <c>false</c> = Abbrechen.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Solarthermieganglinien";
    [Parameter] public string LabelProjektliste { get; set; } = "Ausgewählt im Projekt";
    [Parameter] public string LabelKatalogliste { get; set; } = "Solarthermieganglinie aus DB";
    [Parameter] public string SpalteWahl { get; set; } = "Wahl";
    [Parameter] public string SpalteName { get; set; } = "Name";
    [Parameter] public string LabelHinzu { get; set; } = "In das Projekt übernehmen";
    [Parameter] public string LabelEntfernen { get; set; } = "Aus dem Projekt entfernen";
    [Parameter] public string LabelName { get; set; } = "Name:";
    [Parameter] public string LabelBeschreibung { get; set; } = "Beschreibung:";
    [Parameter] public string OkText { get; set; } = "OK";
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Der Schlussknopf im Katalogbetrieb — <c>ADM_BTN_BEENDEN</c>.</summary>
    [Parameter] public string BeendenText { get; set; } = Resource.ADM_BTN_BEENDEN;

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_Solarganglinie.btn_Help";

    // --- Die Ganglinie in der Detailzeile (DZ1) --------------------------------

    /// <summary>
    /// Die drei Kennzahlen der gewählten Ganglinie — <c>GanglinienAuswertungCtrl</c> mit
    /// <c>GanglinienQuelle.Solarganglinie</c> in der Hülle; <c>null</c> = keine Grafik.
    /// </summary>
    [Parameter] public Func<GanglinienWahl, Task<GanglinienKennzahlen?>>? Kennzahlen { get; set; }

    /// <summary>Das Zeichenmodell der gewählten Ganglinie (Wahl, sortiert); gerechnet im Kern.</summary>
    [Parameter] public Func<GanglinienWahl, bool, Zeichenmodell?>? Bildauftrag { get; set; }

    /// <summary>
    /// Das Zeichenmodell in Behältergröße (DZ1‑N2): Wahl, Schalterstellung, Breite und Höhe der
    /// Zeichenfläche in px. Es geht dem <see cref="Bildauftrag"/> vor — die Kurve nimmt die volle
    /// Breite der Satzfläche.
    /// </summary>
    [Parameter] public Func<GanglinienWahl, bool, int, int, Zeichenmodell?>? BildauftragMass { get; set; }

    [Parameter] public Func<Farbrolle, Farbe, Task>? FarbeSetzen { get; set; }
    [Parameter] public Func<Farbrolle, Task>? FarbeZuruecksetzen { get; set; }
    [Parameter] public Energieeinheit Einheit { get; set; } = Energieeinheit.MWh;
    [Parameter] public Action<Energieeinheit>? EinheitGewaehlt { get; set; }

    [Parameter] public string LabelJahresarbeit { get; set; } = Resource.STROMGL_LBL_JAHRESARBEIT;
    [Parameter] public string LabelSpitze { get; set; } = Resource.STROMGL_LBL_SPITZE;
    [Parameter] public string LabelVollbenutzung { get; set; } = Resource.GEBB_LBL_VOLLBENUTZUNG;
    [Parameter] public string LabelSortiert { get; set; } = Resource.SIM_CHK_SORTIERT;
    [Parameter] public string LabelEinheit { get; set; } = Resource.ALLG_LBL_EINHEIT;
    [Parameter] public string EinheitStunden { get; set; } = Resource.GEBB_EINHEIT_STUNDEN;
    [Parameter] public string Bildtext { get; set; } = Resource.CHART_TITEL_SOLARERTRAG_JAHRESGANGLINIE;
    [Parameter] public string PlatzhalterBild { get; set; } = Resource.GANGLINIE_KEIN_DIAGRAMM;

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private GanglinieKatalogseite? _seite;

    private ErzeugerZeile? _projektZeile;
    private Katalogfilterzeile? _katalogZeile;
    private Katalogfilterstand _filterstand = new();

    /// <summary>Der Bezeichner der gewählten Katalogzeile — die Markierung hängt am NAMEN.</summary>
    private string _katalogGewaehlt = "";
    private string _name = "";
    private string _beschreibung = "";

    /// <summary>Die Ganglinie der Detailzeile (DZ1).</summary>
    private readonly GanglinienGrafikstand _grafik = new();

    /// <summary>
    /// Die Zeilen, die beim Öffnen schon gespeichert waren: Nur sie tragen die Id ihrer
    /// Projektkopie. Eine eben aufgenommene Zeile trägt die Katalog-Id — die Grafik fragt
    /// dann über den Namen den Katalogsatz, aus dem die Kopie entstehen wird.
    /// </summary>
    private readonly HashSet<ErzeugerZeile> _gespeichert = new();

    /// <summary>Die Kennzahlen der Grafik; <c>null</c> = keine Grafik. Prüfhilfe.</summary>
    public GanglinienKennzahlen? Grafikkennzahlen => _grafik.Kennzahlen;

    /// <summary>Die Wahl, zu der die Grafik gehört. Prüfhilfe für die Tests.</summary>
    public GanglinienWahl? Grafikwahl => _grafik.Wahl;

    /// <summary>Was die Detailzeile zeigt: die Projektzeile, den Katalogsatz oder keinen.</summary>
    private Satzmarke SatzArt => _projektZeile is not null ? Satzmarke.Projektsatz
                               : _katalogZeile is not null ? Satzmarke.Katalogsatz : Satzmarke.Keiner;

    /// <summary>Name des gewählten Satzes in der zugeklappten Detailzeile.</summary>
    private string? SatzName => SatzArt == Satzmarke.Keiner ? null : _name;

    private void GrafikAnstossen(GanglinienWahl wahl) => _ = GrafikLaden(wahl);

    private async Task GrafikLaden(GanglinienWahl wahl)
    {
        await _grafik.LadenAsync(wahl, Kennzahlen);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>Die gewählte Projektzeile — Prüfhilfe für die Tests.</summary>
    public ErzeugerZeile? Projektzeile => _projektZeile;

    /// <summary>Die gewählte Katalogzeile — Prüfhilfe für die Tests.</summary>
    public Katalogfilterzeile? Katalogzeile => _katalogZeile;

    /// <summary>Die Zeilen des Katalogs — Prüfhilfe für die Tests.</summary>
    public IReadOnlyList<Katalogfilterzeile> Katalog => _seite?.Katalog ?? Array.Empty<Katalogfilterzeile>();

    /// <summary>Der Filterstand der Katalogliste — Prüfhilfe für die Tests.</summary>
    public Katalogfilterstand Filterstand => _filterstand;

    /// <summary>Die Katalogseite — Prüfhilfe für die Tests.</summary>
    public GanglinieKatalogseite? Katalogseite => _seite;

    private IEnumerable<string> ProjektBezeichner() => Zeilen.Select(z => z.Bezeichner);

    protected override void OnParametersSet()
    {
        // Der Kopf der WAHLSPALTE kommt weiter ueber den eigenen Text des Wirtes.
        Filtertexte.SpalteWahl = SpalteWahl;
    }

    protected override void OnInitialized()
    {
        // Der Filterstand je Katalog, fuer die Sitzung (Frage Q2).
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(
            Katalogprofil?.Schluessel ?? ("ZEITREIHE_" + Zeitreihenart.Solarganglinie));
        foreach (ErzeugerZeile z in Zeilen) _gespeichert.Add(z);

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.SOLARGANGLINIE,
                                          () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent liest die markierte Ganglinie (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private SolarganglinieKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die Katalogwahl und der Detailblock, der ihr folgt.
    /// </summary>
    private SolarganglinieKiSicht KiSicht()
    {
        return _kiSicht ??= new SolarganglinieKiSicht
        {
            KatalogLesen = () => _katalogGewaehlt,
            KatalogSetzen = KatalogZeileWaehlen,
            KatalogEintraege = () => KiMaskenanmeldung.Eintraege(
                Katalog, z => z.Bezeichner, z => z.Bezeichner),

            ProjektganglinieLesen = () => _projektZeile?.Bezeichner ?? "",
            BeschreibungLesen = () => _beschreibung
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> Die Zuordnungsliste gehört dem Wirt und geht erst mit
    /// dem OK an ihn; Import, Löschen und Schloss bleiben Handlungen des Anwenders.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    /// <summary>
    /// Die Wahl zeigt Name UND Beschreibung — auch für eine Projektzeile (aus dem Katalog).
    /// </summary>
    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _name = zeile.Bezeichner;
        _beschreibung = BeschreibungZu(zeile.Bezeichner);
        GrafikAnstossen(new GanglinienWahl(false, _gespeichert.Contains(zeile) ? zeile.GeraetId : 0, zeile.Bezeichner));
    }

    /// <summary>Die Wahl über den Bezeichner — der Weg des Assistenten.</summary>
    private void KatalogZeileWaehlen(string bezeichner)
    {
        Katalogfilterzeile? zeile = Katalog.FirstOrDefault(z => z.Bezeichner == bezeichner);
        if (zeile is null) return;
        Katalogzeile_(zeile);
    }

    /// <summary>Die Katalogseite meldet eine Wahl (<c>null</c>: die Wahl ist weg, etwa gelöscht).</summary>
    private void BeiKatalogzeile(Katalogfilterzeile? zeile)
    {
        if (zeile is null)
        {
            if (_katalogZeile is null) return;
            _katalogZeile = null;
            _katalogGewaehlt = "";
            _name = "";
            _beschreibung = "";
            _grafik.Verwerfen();
            return;
        }
        Katalogzeile_(zeile);
    }

    private void Katalogzeile_(Katalogfilterzeile zeile)
    {
        _katalogZeile = zeile;
        _katalogGewaehlt = zeile.Bezeichner;
        _projektZeile = null;
        _name = zeile.Bezeichner;
        _beschreibung = zeile.Text(Katalogfilterprofil.SpBeschreibung);
        GrafikAnstossen(new GanglinienWahl(true, zeile.Id, zeile.Bezeichner));
    }

    private string BeschreibungZu(string bezeichner)
    {
        foreach (Katalogfilterzeile k in Katalog)
            if (string.Equals(k.Bezeichner, bezeichner, StringComparison.Ordinal))
                return k.Text(Katalogfilterprofil.SpBeschreibung);
        return "";
    }

    private void BeiHinzu()
    {
        if (_katalogZeile is null || Aufnehmen is null) return;

        ErzeugerZeile? neu = Aufnehmen(_katalogZeile.Id);
        if (neu is null) return;

        Zeilen.Add(neu);
        ProjektZeileWaehlen(neu);
    }

    /// <summary>
    /// „▶": Die GEWÄHLTE Zeile geht — bei zwei Zuordnungen derselben Ganglinie genau
    /// die markierte.
    /// </summary>
    private void BeiEntfernen()
    {
        if (_projektZeile is null) return;

        ErzeugerZeile zeile = _projektZeile;
        Zeilen.Remove(zeile);
        Entfernen?.Invoke(zeile);

        _projektZeile = null;
        _name = "";
        _beschreibung = "";
        _grafik.Verwerfen();
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>✕ wirkt wie Esc: Abbrechen im Projektbetrieb, Beenden im Katalogbetrieb.</summary>
    private Task BeiKreuz() => Geschlossen.InvokeAsync(Katalogbetrieb);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _seite?.HaeltEsc == true) return Task.CompletedTask;
        return BeiKreuz();
    }
}
