    private void PositionAnlegen() => PositionAnlegenMit(_neuerName);

    /// <summary>„+ Position hinzufügen" legt mit der Vorgabe an (<c>btnPositionNeu_Click</c>).</summary>
    private void PositionAnlegenMitVorgabe() => PositionAnlegenMit(PositionNeuVorgabe);

    private void PositionAnlegenMit(string name)
    {
        if (PositionNeu is null) return;
        string sauber = (name ?? "").Trim();
        if (sauber.Length == 0) return;
        if (PositionNeu(sauber) == 0) return;
        Melden("");
        // Die neue Position muss aus der Hülle kommen (Einheit, Betragstext, Kette,
        // Kurztexte) — deshalb neu laden, aber MIT den Eingaben der übrigen Zeilen.
        KontextLaden(_stand.VarianteId, eingabenUebernehmen: true);
    }

    /// <summary>
    /// U8 (Stufe S2, Anwenderentscheid ND‑Q4 (b)): „Nutzungsdauern vorbelegen…".
    ///
    /// <para>Zwei Schritte in einem Klick, und beide sagen, was sie tun: Erst
    /// werden die LEEREN Felder gefüllt und die Zahl in der Statuszeile genannt;
    /// tragen danach noch Positionen einen Wert, der von der Vorgabe abweicht,
    /// folgt die Rückfrage mit ihrer Anzahl. Ohne Bestätigung bleibt jeder
    /// gepflegte Wert stehen — nichts ändert eine gerechnete Wirtschaftlichkeit
    /// still.</para>
    /// </summary>
    private void VorbelegenAngefordert()
    {
        if (NutzungsdauerVorbelegen is null) return;

        // ETAPPE E10 (Stufe S3): Auf der Betriebsseite belegt derselbe Weg die SÄTZE vor —
        // mit eigenen Texten; Ablauf und Rückfrage bleiben dieselben.
        bool saetze = _stand.SaetzeVorbelegbar;
        string status = saetze ? SaetzeVorbelegenStatus : VorbelegenStatus;
        string keine = saetze ? SaetzeVorbelegenKeine : VorbelegenKeine;
        string frage = saetze ? SaetzeVorbelegenFrage : VorbelegenFrage;

        NutzungsdauerVorbelegung ergebnis = NutzungsdauerVorbelegen(false);
        SummenNachziehen();

        if (ergebnis.Gefuellt == 0 && ergebnis.Belegt == 0)
        {
            Melden(keine, WarnStufe.Hinweis);
            return;
        }

        Melden("");
        if (ergebnis.Gefuellt > 0)
            StatusSetzen(string.Format(status, ergebnis.Gefuellt));

        if (ergebnis.Belegt == 0) return;

        _frage = string.Format(frage, ergebnis.Belegt);
        _frageJa = () =>
        {
            if (NutzungsdauerVorbelegen is not null)
            {
                NutzungsdauerVorbelegung zweiter = NutzungsdauerVorbelegen(true);
                SummenNachziehen();
                StatusSetzen(string.Format(status,
                                           ergebnis.Gefuellt + zweiter.Gefuellt));
            }
            return Task.CompletedTask;
        };
    }

    /// <summary>
    /// Wie <c>Zeile_LoeschenAngefordert</c>: Pflichtpositionen werden nicht
    /// gelöscht, sondern erklärt; alles Übrige erst nach der Rückfrage.
    /// </summary>
    private void LoeschenFragen(KostenPositionZeile zeile)
    {
        if (IstPflicht is not null && IstPflicht(zeile))
        {
            Melden(string.Format(VorlagePflichtLoeschen, zeile.Bezeichnung), WarnStufe.Hinweis);
            return;
        }

        _frage = string.Format(VorlagePositionLoeschen, zeile.Bezeichnung);
        _frageJa = () =>
        {
            if (PositionLoeschen is not null && PositionLoeschen(zeile))
                KontextLaden(_stand.VarianteId, eingabenUebernehmen: true);
            return Task.CompletedTask;
        };
    }

    private async Task FrageBeantwortet(bool? antwort)
    {
        Func<Task>? ja = _frageJa;
        _frage = "";
        _frageJa = null;
        if (antwort == true && ja is not null) await ja();
    }

