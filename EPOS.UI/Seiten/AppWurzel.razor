    /// <summary>
    /// Das LAGEBILD DER LIZENZ, wenn es die Huelle stellt (Windows:
    /// <c>HauptfensterHuelle</c>). Ohne diesen Parameter fragt die Wurzel
    /// <c>IProjektQuelle.Lizenzlage()</c> — der iOS-Weg. <c>null</c> auf beiden
    /// Wegen heisst: kein Banner.
    ///
    /// <para><b>Fertig gerechnet, nicht selbst geholt</b> (Regel S-2 aus W15c):
    /// Die Komponente kennt weder <c>LizenzManager</c> noch Token noch Zeitanker;
    /// sie bekommt einen Satz, eine Dringlichkeit und sonst nichts.</para>
    /// </summary>
    [Parameter] public WindowsFormsApplication1.LizenzLage? Lizenzlage { get; set; }

    /// <summary>
    /// Wie lange ein WARNSTUFEN-Hinweis stehen bleibt (30/14/7 Tage vor Ablauf).
    /// Das Lesemodus-Banner ist davon unberuehrt — es bleibt stehen.
    /// </summary>
    /// <remarks>
    /// Der Vorgabewert ist grosszuegiger als der Selbstverfall des Vorlaeufers
    /// <c>Form_Hinweis</c> (3 s): Hier steht ein DATUM im Text, und ein Datum
    /// will gelesen werden.
    /// </remarks>
    [Parameter] public TimeSpan HinweisDauer { get; set; } = TimeSpan.FromSeconds(20);

    /// <summary>Die Bannerstufe zur Dringlichkeit aus dem Kern.</summary>
    private WarnStufe Bannerstufe => _lizenz?.Dringlichkeit switch
    {
        WindowsFormsApplication1.LizenzDringlichkeit.Warnung => WarnStufe.Warnung,
        _ => WarnStufe.Hinweis
    };

    /// <summary>
    /// Die Lebensdauer des Banners: <c>null</c> (bleibt stehen) im Lesemodus,
    /// sonst <see cref="HinweisDauer"/>.
    /// </summary>
    private TimeSpan? Bannerfrist => _lizenz is not null && _lizenz.Lesemodus
                                         ? null
                                         : HinweisDauer;

    /// <summary>
    /// Die zuletzt gezeichnete Wurzel meldet sich als Navigationsziel an. Der
    /// iOS-Adapter <c>IosNavigation</c> reicht die Maskenschluessel des Kerns
    /// hierher weiter; ohne angemeldete Wurzel laeuft er leer - derselbe Zustand
    /// wie <c>KeineNavigation</c>.
    /// </summary>
    protected override void OnInitialized()
    {
        Navigationsziel.Aktuell = this;
        KiAusfuehrungEinlegen();
        _melder = new Hilfekontextmelder(HilfekontextGemeldet);
        WindowsFormsApplication1.KiChatKontext.AufrufGeaendert += BeiAufrufwechsel;
        if (Zustand is not null) Zustand.Geaendert += BeiZustand;
        LizenzlageUebernehmen();
        // Die Startansicht wird ueber DENSELBEN Weg gesetzt wie jeder spaetere
        // Wechsel - sonst gaebe es zwei Stellen, an denen eine Ansicht entsteht.
        if (!Zeige(Startansicht)) _ansicht = Seitenschluessel.Projektliste;
        Laden();
    }

    /// <summary>
    /// Legt die AUSFÜHRUNGSSCHICHT des Assistenten ein, wenn noch die stille steht
    /// (Auftrag #201, Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>Warum hier.</b> Das Aktionsregister liegt seit #201 im Kern, aber
    /// eingelegt wird es von der Hülle: Unter Windows tut das <c>Program.Main</c>
    /// (samt den zwei Windows-Haken Modalität und Feldhilfe), auf iOS gibt es keine
    /// Stelle, die vor der Wurzel liefe. Ohne diesen Aufruf bliebe dort
    /// <c>KeineAusfuehrung</c> stehen — leeres Register, jede Aktion abgelehnt; genau
    /// der Zustand, den S3 beendet.</para>
    /// <para><b>Nur, wenn noch nichts steht.</b> Unter Windows ist die Schicht längst
    /// eingelegt, wenn die Wurzel zeichnet; sie hier zu ersetzen nähme ihr die zwei
    /// Haken und das Sitzungsgedächtnis des laufenden Programms.</para>
    /// </remarks>
    private static void KiAusfuehrungEinlegen()
    {
        if (WindowsFormsApplication1.KiAusfuehrungsweg.Aktuell
                is not WindowsFormsApplication1.KeineAusfuehrung) return;

        WindowsFormsApplication1.KiAusfuehrungsweg.Aktuell =
            new WindowsFormsApplication1.KiAusfuehrung();
    }

    /// <summary>
    /// Holt das Lagebild der Lizenz — der Parameter der Huelle hat Vorrang, sonst
    /// fragt die Wurzel die Projektquelle (der iOS-Weg).
    /// </summary>
    /// <remarks>
    /// EINMAL beim Aufbau, nicht bei jedem Zeichnen: Der Weg dahinter liest unter
    /// Windows die DPAPI-Ablage und auf iOS den Schluesselbund, beides synchron.
    /// Ein Lizenzstand aendert sich in Tagen, nicht in Bildwechseln.
    /// </remarks>
    private void LizenzlageUebernehmen()
    {
        _lizenz = Lizenzlage ?? Quelle.Lizenzlage();

        // WarnungZeigen ist die Antwort des Kerns auf „heute schon gewarnt?"
        // (Anwenderentscheid iF30-O-2 vom 06.09.2026, „einmal taeglich reicht").
        // Die Wurzel FRAGT nur - welcher Tag und welche Stufe gemerkt sind, steht
        // in LizenzLage.MitTagesmerker und an keiner zweiten Stelle. Der
        // Lesemodus traegt dort immer true und bleibt bei jedem Start sichtbar.
        _lizenzbanner = _lizenz is null || !_lizenz.WarnungZeigen ? "" : _lizenz.Text;
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (Zustand is not null) Zustand.Geaendert -= BeiZustand;

        // Ein statisches Ereignis haelt seinen Hoerer am Leben (Auftrag #221) - wer
        // sich anhaengt, haengt sich beim Verwerfen wieder ab.
        WindowsFormsApplication1.KiChatKontext.AufrufGeaendert -= BeiAufrufwechsel;

        if (ReferenceEquals(Navigationsziel.Aktuell, this)) Navigationsziel.Aktuell = null;
    }

    /// <summary>
    /// Die Huelle hat das Projekt gewechselt oder um Auffrischen gebeten.
    /// Geschrieben wird aus dem Oberflaechenfaden von WinForms, gezeichnet
    /// ausschliesslich auf dem Renderfaden — dasselbe Muster wie
    /// <see cref="OeffneMaske"/>.
    /// </summary>
    private void BeiZustand()
    {
        _ = InvokeAsync(() =>
        {
            Laden();
            StateHasChanged();
        });
    }

    // =====================================================================
    //  Der Aufrufkontext des Hilfe-Assistenten (Auftrag #199, Stufe S1)
    // =====================================================================

    // =====================================================================
    //  DER RUECKWEGSTAPEL (Auftrag #207, Konzept „Simulationsablauf" 2.1)
    // =====================================================================

    /// <summary>
    /// Die Ansichten, aus denen heraus eine Ansicht MIT RUECKKEHR geöffnet wurde —
    /// je Eintrag der Seitenschlüssel und die Marke, mit der er wiederkommt.
    /// </summary>
    /// <remarks>
    /// <para><b>Er löst drei Felder ab.</b> Bis #207 führte die Wurzel
    /// <c>_auslegungRueckweg</c> (#192) und <c>_kiRueckweg</c> (#199) nebeneinander,
    /// und der Assistent kehrte stur zur Startansicht zurück; jede neue freie Ansicht
    /// hätte ein viertes Feld gebracht. Der Anwenderentscheid <b>SIM‑Q4</b> macht
    /// daraus EINEN Mechanismus.</para>
    ///
    /// <para><b>Was er wiederherstellt und was nicht.</b> Er stellt die ANSICHT samt
    /// ihrer MARKE wieder her — Schritt und Reiterblatt, mehr nicht (Regel aus #199).
    /// Den übrigen inneren Zustand einer Komponente stellt er nicht wieder her: Sie
    /// wird beim Wechsel verworfen, und mit ihr eine Überlagerung und eine halb
    /// ausgefüllte Eingabe. Der DATENSTAND kommt aus der Hülle bzw. dem
    /// Kern-Controller, die den Ansichtswechsel überleben. Deshalb greift die
    /// Rückfrage aus 62b‑E‑1: Wer den Projektassistenten, die Stromspeicher-Auslegung
    /// oder die Simulation mit ungespeicherten Eingaben verlässt, wird gefragt.</para>
    ///
    /// <para><b>Flach und kurz.</b> Höchstens <see cref="RUECKWEG_TIEFE"/> Einträge
    /// (Startseite → Simulation → Auslegung → KI-Assistent), und ein Wechsel auf die
    /// Startansicht leert ihn. <b>Ein Router ist das nicht und soll es nicht
    /// werden.</b></para>
    /// </remarks>
    private readonly List<(string Schluessel, string Marke)> _rueckweg = new();

    /// <summary>Mehr als drei Ebenen kennt der Ablauf nicht.</summary>
    private const int RUECKWEG_TIEFE = 3;

    /// <summary>
    /// Die Ansichten, die einen RUECKWEG haben — nur wer hierher wechselt, legt die
    /// stehende Ansicht ab. „Berichte &amp; Kosten", die Projektliste und die zwei
    /// Katalogdialoge kehren zur Startansicht zurück und stapeln nicht.
    /// </summary>
    private static bool MitRueckkehr(string ziel)
        => ziel == Seitenschluessel.Simulation
        || ziel == Seitenschluessel.SimulationKonfiguration
        || ziel == Seitenschluessel.SimulationErgebnis
        || ziel == Seitenschluessel.StromspeicherAuslegung
        || ziel == Seitenschluessel.KiAssistent;

    /// <summary>Die Marke der STEHENDEN Ansicht; leer = sie führt keine.</summary>
    /// <remarks>
    /// Seit Auftrag <b>#220</b> führt auch die STARTSEITE eine — ihr Reiter
    /// „Simulation" zeigt dieselbe Ergebniskomponente wie Schritt ③, und wer aus ihm
    /// heraus die Stromspeicher-Auslegung öffnet, will in den REITER zurück und nicht
    /// in die Ansicht. Die Marke trägt dafür die Wirtkennung <c>wirt=START</c>.
    /// </remarks>
    private string StehendeMarke()
    {
        if (_ansicht == Seitenschluessel.Simulation && _simulationSeite is not null)
            return _simulationSeite.AktuelleMarke;

        if (_ansicht == Seitenschluessel.Startseite && _startseiteSeite is not null)
            return _startseiteSeite.AktuelleMarke;

        return "";
    }

    /// <summary>
    /// Der Parametersatz der Simulation — der EINE Weg für ZWEI Wirte (Auftrag #220):
    /// die freie Ansicht <c>SIMULATION</c> und den Reiter „Simulation" der Startseite.
    /// Der Delegat der Hülle hat Vorrang (unter Windows hält <c>SimulationHuelle</c>
    /// den gerechneten Lauf, die Bilder und die Gültigkeitsmarke); ohne ihn fragt die
    /// Wurzel die Projektquelle — der iOS-Weg.
    /// </summary>
    private IReadOnlyDictionary<string, object>? SimulationGabenHolen()
        => SimulationGaben?.Invoke() ?? Quelle.SimulationGaben(_projekt?.Id ?? 0);

    /// <summary>Legt die stehende Ansicht samt Marke ab (höchstens drei Einträge).</summary>
    private void RueckwegMerken()
    {
        if (string.IsNullOrEmpty(_ansicht)) return;

        _rueckweg.Add((_ansicht, StehendeMarke()));
        while (_rueckweg.Count > RUECKWEG_TIEFE) _rueckweg.RemoveAt(0);
    }

    /// <summary>
    /// Der Rückweg: den obersten Eintrag holen und zeigen. <c>false</c> = der Stapel
    /// ist leer oder keine seiner Ansichten lässt sich noch aufbauen; dann gilt wie
    /// bisher die <see cref="Startansicht"/>.
    /// </summary>
    private bool Zurueck()
    {
        while (_rueckweg.Count > 0)
        {
            (string ziel, string marke) = _rueckweg[^1];
            _rueckweg.RemoveAt(_rueckweg.Count - 1);

            if (string.IsNullOrEmpty(ziel) || ziel == _ansicht) continue;
            if (Zeige(ziel, marke: marke, merken: false)) return true;
        }

        return false;
    }

    /// <summary>
    /// Legt den gemeldeten Aufrufkontext über den Parametersatz des Chats: Bereich,
    /// Dialogname, Meldungskennung und die vorbelegte Frage (Auftrag #199).
    /// </summary>
    /// <remarks>
    /// <b>Der Kontext gewinnt gegen die Quelle.</b> <c>IProjektQuelle.KiAssistentGaben</c>
    /// liefert Delegaten, Texte und Zähler; wer aus einem Dialog fragt, hat den
    /// genaueren Bereich. Bringt die Quelle einen dieser vier Schlüssel gar nicht mit,
    /// entsteht er hier — die Komponente führt für alle vier einen
    /// <c>[Parameter]</c>.
    /// </remarks>
    private static IReadOnlyDictionary<string, object> MitAufruf(
        IReadOnlyDictionary<string, object> gaben)
    {
        WindowsFormsApplication1.KiAufrufkontext? aufruf =
            WindowsFormsApplication1.KiChatKontext.Aufruf;
        if (aufruf is null) return gaben;

        var kopie = new Dictionary<string, object>(StringComparer.Ordinal);
        foreach (KeyValuePair<string, object> paar in gaben) kopie[paar.Key] = paar.Value;

        string bereich = WindowsFormsApplication1.KiChatKontext.Freigegeben(aufruf.Bereich);
        if (!string.Equals(bereich, WindowsFormsApplication1.KiChatKontext.BEREICH_UNBEKANNT,
                           StringComparison.Ordinal))
            kopie["Kontext"] = bereich;

        kopie["Dialogname"] = aufruf.Dialogname ?? "";
        kopie["Kennung"] = aufruf.Kennung ?? "";
        kopie["Vorbelegung"] = aufruf.Frage ?? "";
        // Auftrag #227: die STARTZEILE des Chats haengt am Hilfeschluessel, nicht am
        // Bereich - der Menueweg "Hilfe > Assistent" bringt auch einen Bereich mit.
        kopie["Hilfeschluessel"] = aufruf.Hilfeschluessel ?? "";
        return kopie;
    }

    /// <summary>
    /// Legt die drei Einstiege von „Feldwerte mitsenden" bei, wenn die Quelle sie nicht
    /// mitbringt (Auftrag #200, Stufe S2).
    /// </summary>
    /// <remarks>
    /// <para>
    /// <b>Dieselbe Kernfunktion wie unter Windows.</b> Die Werte holt
    /// <c>KiMaskenbruecke.Dialogdaten</c>, die Einwilligung
    /// <c>KiEinwilligung.SicherstellenDialogdatenAsync</c> — dieselben zwei Stellen, aus
    /// denen die Windows-Hülle ihre Delegaten legt und aus denen dort die Werkzeugaktion
    /// <c>dialog_lesen</c> liest. Die Wurzel schreibt hier keine zweite Wahrheit auf,
    /// sie verdrahtet nur.
    /// </para>
    /// <para>
    /// <b>Eine mitgebrachte Angabe gewinnt.</b> Unter Windows baut
    /// <c>KiChatHuelle.Gaben</c> denselben Satz; wer ihn schon mitbringt, bekommt ihn
    /// nicht überschrieben.
    /// </para>
    /// </remarks>
    private static IReadOnlyDictionary<string, object> MitFeldwerten(
        IReadOnlyDictionary<string, object> gaben)
    {
        if (gaben.ContainsKey("Feldwerte")) return gaben;

        var kopie = new Dictionary<string, object>(StringComparer.Ordinal);
        foreach (KeyValuePair<string, object> paar in gaben) kopie[paar.Key] = paar.Value;

        kopie["Feldwerte"] =
            (Func<WindowsFormsApplication1.KiDialogdaten?>)
                (() => WindowsFormsApplication1.KiMaskenbruecke.Dialogdaten());
        kopie["FeldwerteEinwilligen"] =
            (Func<Task<bool>>)WindowsFormsApplication1.KiEinwilligung.SicherstellenDialogdatenAsync;
        kopie["FeldwerteGesperrt"] =
            !WindowsFormsApplication1.KiEinwilligung.DialogdatenMoeglich;

        return kopie;
    }

    /// <summary>
    /// Der Rückweg aus dem Hilfe-Assistenten: dorthin, woher man kam (Muster #62b).
    /// Lässt sich diese Ansicht nicht mehr aufbauen, gilt der gewöhnliche Rückweg.
    /// </summary>
    private void ZurueckVomAssistenten()
    {
        // Der Aufruf gilt fuer den offenen Chat; danach beantwortet wieder die
        // Huelle bzw. die Seite, in welchem Bereich der Anwender arbeitet.
        WindowsFormsApplication1.KiChatKontext.AufrufMelden(null);

        _kiAssistent = null;

        // Seit #207 holt der STAPEL den Aufrufer (SIM-Q4) - bis dahin stand er in
        // einem eigenen Feld _kiRueckweg.
        if (Zurueck()) return;

        ZurueckZurListe();
    }

    /// <summary>
    /// Legt <see cref="Zustand"/> einem Parametersatz bei, der KEINEN fuehrt.
    /// Ein mitgelieferter Zustand hat Vorrang: Unter Windows meldet
    /// <c>StartseiteHuelle</c> den Projektwechsel ueber IHREN, und zwei
    /// Zustaende fuer dieselbe Ansicht waeren zwei Wahrheiten.
    /// </summary>
    private IReadOnlyDictionary<string, object>? MitZustand(
        IReadOnlyDictionary<string, object>? gaben)
    {
        if (gaben is null || Zustand is null) return gaben;
        if (gaben.ContainsKey(SeitenZustand.PARAMETER)) return gaben;

        var kopie = new Dictionary<string, object>(StringComparer.Ordinal);
        foreach (KeyValuePair<string, object> paar in gaben) kopie[paar.Key] = paar.Value;
        kopie[SeitenZustand.PARAMETER] = Zustand;
        return kopie;
    }

