    private IReadOnlyList<(int Id, string Text)> Bedarfstagwahl
    {
        get
        {
            var liste = new List<(int Id, string Text)>
            {
                (WAHL_VORGABE, Texte.OptionVorgaberegel),
                (WAHL_STUNDENPROFIL, Texte.OptionStundenprofil)
            };
            if (A100Gesperrt) liste.Add((WAHL_A100, Texte.OptionA100));
            liste.Add((WAHL_DIN4708, Texte.OptionDin4708));
            if (_eingabe.Entwurf is { } entwurf)
                liste.Add((WAHL_ENTWURF, Format(Texte.OptionEntwurf, entwurf.Bezeichner)));
            if (EcodesignGesperrt) liste.Add((WAHL_ECODESIGN, Texte.OptionEcodesign));
            foreach (ZapfprofilBedarfstagDaten t in Daten.Bedarfstage)
                liste.Add((t.Id, Format(Texte.OptionKatalogtag, t.Bezeichner, t.Herkunft)));
            // Ein gespeicherter Tag, den der Katalog nicht (mehr) führt, bleibt als Eintrag stehen.
            if (_eingabe.IdBedarfstag is int id && id > 0 && liste.All(e => e.Id != id))
                liste.Add((id, "#" + id.ToString(CultureInfo.InvariantCulture)));
            return liste;
        }
    }

    /// <summary>Die Quelle A100-Referenzprofil steht gesperrt, solange der Katalog keine Zeile dieser Art führt.</summary>
    private bool A100Gesperrt => Daten.Bedarfstage.All(t => t.Quelle != ZapfprofilBedarfstagquelle.A100Referenz);

    /// <summary>Die Quelle Ecodesign-Zapfprofil steht gesperrt, solange der Katalog keine Zeile dieser Art führt.</summary>
    private bool EcodesignGesperrt => Daten.Bedarfstage.All(t => t.Quelle != ZapfprofilBedarfstagquelle.Ecodesign);

    private IReadOnlyCollection<int> GesperrteTage => Sperrgruende.Keys.ToList();

    /// <summary>Je gesperrtem Eintrag sein Grund: Normtage des Katalogs, A100-Referenzprofil, Ecodesign.</summary>
    private IReadOnlyDictionary<int, string> Sperrgruende
    {
        get
        {
            var d = new Dictionary<int, string>();
            foreach (ZapfprofilBedarfstagDaten t in Daten.Bedarfstage.Where(t => !t.Waehlbar)) d[t.Id] = t.Sperrgrund;
            if (A100Gesperrt) d[WAHL_A100] = Texte.GrundA100;
            if (EcodesignGesperrt) d[WAHL_ECODESIGN] = Texte.GrundEcodesign;
            return d;
        }
    }

    private int BedarfstagAuswahl
    {
        get
        {
            switch (_eingabe.Quelle)
            {
                case ZapfprofilBedarfstagquelle.Vorgaberegel: return WAHL_VORGABE;
                case ZapfprofilBedarfstagquelle.Stundenprofil: return WAHL_STUNDENPROFIL;
                case ZapfprofilBedarfstagquelle.Din4708Profil when _eingabe.IdBedarfstag is null: return WAHL_DIN4708;
                case ZapfprofilBedarfstagquelle.Konstruktor when _eingabe.Entwurf is not null: return WAHL_ENTWURF;
                default: return _eingabe.IdBedarfstag ?? WAHL_VORGABE;
            }
        }
    }

