@* Verwaltung Stromspeicher - der PROJEKTDIALOG (iU9-W6.6).

   VORBILD. Views/Stromspeicher/Form_Stromspeicher (354 Z., lokalisiert de/en,
   16 Kartenzeilen, KEINE einzige MessageBox). Die schmalste der fuenf
   Erzeugermasken: keine Traegervariante, keine Projektkopie, kein Filter, kein
   Katalogeditor. Der feste Detailblock ist weiter reine Anzeige - seit dem
   Anwenderentscheid vom 15.09.2026 steht darunter aber der Aufklapper "Alle
   Daten anzeigen", der ALLE Katalogspalten zeigt und bearbeiten laesst; er
   speist sich aus derselben Feldliste wie der Modulkatalog hinter
   "Bearbeiten...". Erst damit sind die sechs AP3-Geraetewerte aus diesem Dialog
   heraus ueberhaupt zu sehen.

   DIE KNOEPFE ZUM GEWAEHLTEN SATZ STEHEN IM MODULBEREICH ("alle sechs Erzeuger
   im gleichen Schema"), seit dem 16.09.2026 in EINER Zeile ganz OBEN: links die
   Kostenleiste, rechts "Bearbeiten...", darunter erst die Felder und der
   Aufklapper. Unter der Katalogliste steht kein Knopf mehr.

   JE KLICK EINE EIGENE ZEILE. btn_Hinzu_Click legt seit AP2b bewusst eine
   NEUE Modellinstanz an: Bis dahin landete immer dasselbe Feldobjekt in der
   Liste, mehrfaches Hinzufuegen legte n Verweise auf einen Datensatz ab, und
   jede spaetere Aenderung schlug auf alle Eintraege durch. Zweimal derselbe
   Speicher sind also zwei Zeilen.

   DAS DETAIL KOMMT IMMER AUS DEM KATALOG. Beide Listen lesen denselben
   Stammsatz ueber den Bezeichner (listBox_SP_SelectedIndexChanged und
   dataGridView1_Click sind zeichengleich); es gibt keine Projektkopie, die
   abweichen koennte.

   ZWEI BESCHRIFTUNGEN KOMMEN AUS DEM RESSOURCENKATALOG, nicht aus dem
   Designer: "Energie (Kapazitaet) [kWh]" und "Modulkosten [EUR/kWh]". Der
   Designer trug dort "Energie [kW]" und "Modulkosten" - beides fachlich falsch
   (Abnahmebefund 1 zum ersten App-Start, EinheitenBeschriftungKorrigieren).
   Die Huelle setzt SP_LABEL_ENERGIE und SP_LABEL_MODULKOSTEN ein.

   TASTATUR wie in den uebrigen Erzeugerdialogen: Esc schliesst, Enter ist
   nicht belegt.

   ENTSCHEID #76 (05.09.2026). Die zwei Listen und die Pfeilspalte stehen im
   Baustein Zweispaltenauswahl - EIN Aufbau fuer alle Projekt/Datenbank-Dialoge
   des Hauses. Nebeneinander wie im BHKW-PLAN, auf schmalem Schirm untereinander;
   die Knoepfe tragen seither Klartext, das Zeichen setzt der Baustein je nach
   Anordnung (◀▶ nebeneinander, ▲▼ untereinander). *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Kosten
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* DER KOPF TRAEGT NUR DEN KOPF. Die Ueberlagerung der Katalogverwaltung stand bis
       zum 15.09.2026 INNERHALB dieses div - ein Markup-Ausrutscher, der den Dialog
       schloss und wieder oeffnete und die Ueberlagerung in die Kopfzeile legte. Sie
       steht jetzt am Dialogende, wie in jedem anderen Erzeugerdialog. *@
    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="Abbrechen" />
    </div>

    <p class="epos-kontextzeile">@KopfbandText</p>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    <Zweispaltenauswahl LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                        UebernehmenText="@LabelHinzu"
                        UebernehmenGesperrt="@(_katalogZeile is null)" Uebernehmen="BeiHinzu"
                        EntfernenText="@LabelEntfernen"
                        EntfernenGesperrt="@(_projektZeile is null)" Entfernen="BeiEntfernen">

        <Links>
            <Raster TZeile="ErzeugerZeile" Zeilen="@Zeilen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="ErzeugerZeile" Title="@SpalteWahl">
                        <Zeilenwahl Gewaehlt="@(_projektZeile == context)" Kurztext="@SpalteWahl"
                                    Gewaehltwerden="() => ProjektZeileWaehlen(context)" />
                    </TemplateColumn>
                    <PropertyColumn TGridItem="ErzeugerZeile" TProp="string"
                                    Property="@(z => z.Bezeichner)" Title="@LabelProjektliste" />
                </KindInhalt>
            </Raster>
        </Links>

        <Rechts>
            @* DIE EINE KATALOGLISTE (W14a-E-10, Stufe S2.1). Der Speicherkatalog
               hatte als einziger gar keinen Filter - bei fuenf Saetzen fiel das
               nicht auf, bei den 6 654 der CEC-Liste (W13-E-2) schon. Statt der
               Sammelspalte "Eigenschaften" mit ihren Zeilen in EINER Zelle stehen
               jetzt ACHT Spalten, jede sortierbar; der Hersteller kommt seit
               Schritt 68 aus der Spalte Firma (Q7). *@
            <Katalogliste Profil="@Katalogprofil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_katalogGewaehlt" GewaehltChanged="KatalogZeileWaehlen"
                          Vergleichsparameter="@Vergleichsparameter" />

            @* KEIN KNOPF MEHR UNTER DER LISTE (Anwenderentscheid 15.09.2026, „alle
               sechs Erzeuger im gleichen Schema"). „Bearbeiten…" ist in den
               Modulbereich gewandert - dorthin, wo der gewaehlte Satz steht und wo auch
               der Aufklapper und die Kostenknoepfe sitzen. Einen Loeschknopf hat dieser
               Dialog nie gehabt; geloescht wird in der Katalogverwaltung. *@
        </Rechts>

    </Zweispaltenauswahl>

    <Gruppenkopf Titel="@GruppeModul">
        <KindInhalt>
            @* DIE KNOPFZEILE STEHT OBEN (Anwenderentscheid 16.09.2026: "Der
               Bearbeiten-Button soll weiter oben, z. B. unter der blauen Zeile Modul
               stehen, so dass er besser sichtbar ist"). EINE Zeile unmittelbar unter
               dem Gruppenkopf: links die Kostenknoepfe, rechts "Bearbeiten…",
               dazwischen der Fueller. Dieselbe Bauart in allen sechs
               Erzeugerdialogen; die Knoepfe selbst sind unveraendert - im Assistenten
               gibt es keinen Kostenkontext, dort bleibt die Leiste weg. *@
            <div class="epos-leiste">
                @if (!Wizard)
                {
                    <KostenKnoepfeLeiste KostenOeffnen="@KostenLeiste" EnergiekostenOeffnen="@EnergieLeiste"
                                         InvestText="@KostenInvestText" BetriebText="@KostenBetriebText"
                                         EnergieText="@KostenEnergieText" />
                }
                <span class="epos-leiste-fueller"></span>
                @* „Bearbeiten…" oeffnet WEITERHIN den ganzen Modulkatalog als
                   Ueberlagerung: Er ist die Katalogverwaltung mit „Neu…" und „Loeschen"
                   und damit mehr als der Aufklapper, der nur den gewaehlten Satz
                   pflegt. *@
                @if (VerwaltungGaben is not null)
                {
                    <button type="button" class="epos-knopf" @onclick="BeiBearbeiten">@BtnBearbeitenText</button>
                }
            </div>

            @* H13 (06.09.2026): Der Weg in die Wikirubrik "Berechnung". Er sitzt HIER,
               weil dieser Abschnitt die Geraetewerte zeigt, die die Speicherengine als
               Parametersatz liest - Kapazitaet, Leistung, Ladezustand, Wirkungsgrad,
               Degradation, Zyklen. Der Fensterknopf oben rechts bleibt, was er ist. *@
            <div class="epos-berechnungshilfe">
                <InfoKnopf Schluessel="Form_Stromspeicher.Berechnung"
                           StandardKurztext="Berechnungsweg Stromspeicher" />
            </div>
            @* Formularraster (iU8-E-2, Paket P1): Der Detailblock stand zuvor als
               eine Spalte voller Felder ueber die ganze Breite. *@
            <Formularraster>
                <KindInhalt>
            <Textfeld Bezeichnung="@LabelName" Wert="@_detail.Bezeichner" NurLesen="true" />
            @foreach (var feld in _detail.Felder)
            {
                @* Eine Zahl bekommt die kurze Feldbreite (iU8-E-2, Paket P1). *@
                <Textfeld Bezeichnung="@feld.Feld" Wert="@feld.Wert" NurLesen="true"
                          Kurz="@ErzeugerDetail.IstZahl(feld.Wert)" />
            }
            @* ET-5 (Anwenderentscheid 08.09.2026): der Energietraeger der markierten
               PROJEKTzeile in der Gliederung des Katalogs (Gruppe > Art); Vorgabe der
               Stromtraeger des Projekts. Beim Katalogsatz gibt es nichts zu waehlen. *@
            @if (_projektZeile is not null && Traegerkatalog.Count > 0)
            {
                <EnergietraegerWahl Eintraege="@Traegerkatalog"
                                    LabelGruppe="@LabelTraegerGruppe" LabelArt="@LabelTraegerArt"
                                    Auswahl="@(_projektZeile.CarrierId > 0 ? _projektZeile.CarrierId : null)"
                                    AuswahlChanged="BeiTraegerwechsel" />
            }
                </KindInhalt>
            </Formularraster>

            @* ALLE DATEN DES GEWAEHLTEN KATALOGSATZES, aufklappbar und BEARBEITBAR
               (Anwenderentscheid 15.09.2026: "Es soll in diesem Bereich optional alle
               technischen Daten angezeigt und bearbeitet werden koennen").

               DER DETAILBLOCK DARUEBER ZEIGT SECHS von vierzehn Katalogspalten - die
               sechs des Vorlaeufers. Die uebrigen acht, darunter die AP3-Geraetewerte
               (Wirkungsgrad, Zyklen, Verschleiss- und Leistungskosten, Investition fix,
               Standby), waren aus diesem Dialog bisher gar nicht zu sehen; jetzt stehen
               sie hier, in derselben Bauart wie bei Heizkessel und BHKW und aus
               derselben Quelle wie der Katalogeditor hinter "Bearbeiten…".

               AUFGEKLAPPT IST DIE VORGABE (Anwenderentscheid 16.09.2026: "Unter
               Bearbeiten sollen alle Parameter angezeigt werden und bearbeitbar sein").
               Wer einen Speicher waehlt, sieht seine Daten sofort; zuklappen kann er sie
               weiterhin mit demselben Knopf. Ohne gewaehlten Katalogsatz gibt es den
               Block gar nicht, und dann wird auch nichts abgefragt. Der Zustand gehoert
               der Dialogsitzung. *@
            @if (Katalogfelder is not null && _katalogZeile is not null)
            {
                <div class="epos-modulparameter">
                    <button type="button" class="epos-modulparameter-knopf"
                            aria-expanded="@(_parameterOffen ? "true" : "false")"
                            @onclick="ParameterUmschalten">
                        <span class="epos-modulparameter-pfeil" aria-hidden="true">@(_parameterOffen ? "▾" : "▸")</span>
                        <span>@LabelAlleParameter</span>
                    </button>

                    @if (_parameterOffen && _felder is not null)
                    {
                        <Katalogfelder Felder="@_felder" NurLesen="@(KatalogfelderSpeichern is null)"
                                       Geaendert="FeldGeaendert"
                                       FehlerZustand="BeiFeldFehler" />

                        @if (KatalogfelderSpeichern is not null)
                        {
                            @* Die Rueckmeldung steht AM Knopf (Speichervermerk): „Gespeichert um …"
                               bzw. der Grund der Ablehnung rot; ohne Aenderung weich gesperrt. *@
                            <div class="epos-leiste">
                                <Speichervermerk @ref="_felderVermerk" Text="@BtnFelderSpeichernText"
                                                 Geaendert="@_felderGeaendert" Gesperrt="@_feldFehler"
                                                 Satz="@_katalogZeile?.Bezeichner" Speichern="FelderSpeichern" />
                            </div>
                        }
                    }
                </div>
            }

            @* HIER STANDEN DIE KOSTENKNOEPFE UND „Bearbeiten…" (15.09.2026). Sie sind am
               16.09.2026 an den KOPF des Modulbereichs gewandert - unter die blaue Zeile
               "Modul", wo der Anwender sie sieht, ohne an den Parametern
               vorbeizurollen. *@
        </KindInhalt>
    </Gruppenkopf>

    @if (!Wizard)
    {
        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }

    @* --- Ueberlagerung: die Katalogverwaltung (iU9-W14a.4) ------------------- *@
    @* Der Knopf "Bearbeiten" oeffnete bis hierher Form_AdminStromspeicher ueber die
       Sprungbruecke; das Ziel ist jetzt selbst Blazor. *@
    <Ueberlagerung Offen="@(_verwaltungGaben is not null)" Schliessbar="false"
                   Titel="" Geschlossen="() => VerwaltungFertig(null)">
        <KindInhalt>
            @if (_verwaltungGaben is not null)
            {
                <ModulKatalogDialog @attributes="_verwaltungGaben" Geschlossen="VerwaltungFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    /// <summary>Die Zeilen der linken Liste — sie gehört der Hülle und wird in place bearbeitet.</summary>
    [Parameter] public List<ErzeugerZeile> Zeilen { get; set; } = new();

    /// <summary>
    /// <b>Die Spalten der Katalogliste</b> — <c>Katalogfilterprofil.MitVerwendung(
    /// Anlagenart.Stromspeicher, uebersetzer)</c>.
    /// </summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }
    /// <summary>
    /// <b>Die Zeilen des VERGLEICHS</b> (Frage <b>Q3</b>, Stufe S3.3) — derselbe Weg,
    /// aus dem die Parameterübersicht (W14a‑E‑8) ihre Zeilen holt. Ohne ihn
    /// vergleicht die <c>Katalogliste</c> ihre eigenen Spalten.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Vergleichsparameter { get; set; }


    /// <summary>
    /// Die Zeilen des Katalogs, UNGEFILTERT —
    /// <c>StromspeicherStammCtrl.Katalogfilterzeilen()</c>.
    /// </summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste; sie füllen sich selbst aus <c>MyResource</c>.</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>
    /// <b>Ein eigener Filterstand statt des Registers</b> — dasselbe Muster wie
    /// <c>ProfilVorgabe</c>. Ohne ihn holt der Dialog seinen Stand aus dem
    /// <c>Katalogfilterregister</c> (S2.5: je Katalog EINER, für die Sitzung,
    /// gemeinsam mit den anderen Dialogen desselben Katalogs). Ein Prüfstand gibt
    /// hier seinen eigenen herein und bleibt damit von den anderen Fällen getrennt;
    /// dass das Register wirklich teilt, prüft <c>KatalogfilterstandTests</c>.
    /// </summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }


    /// <summary>Der Detailblock zu einem Speicher — für beide Listen dieselbe Quelle.</summary>
    [Parameter] public Func<string, ErzeugerDetail?>? Detail { get; set; }

    /// <summary>Nimmt den Speicher auf — je Klick eine EIGENE Zeile.</summary>
    [Parameter] public Func<int, AufnahmeErgebnis>? Aufnehmen { get; set; }

    /// <summary>Entfernt die Zeile aus der geteilten Liste.</summary>
    [Parameter] public Action<ErzeugerZeile>? Entfernen { get; set; }

    /// <summary>ET‑5 (08.09.2026): der Trägerkatalog in der Gliederung Gruppe › Art; leer = kein Feld.</summary>
    [Parameter] public IReadOnlyList<EnergietraegerWahl.Eintrag> Traegerkatalog { get; set; }
        = Array.Empty<EnergietraegerWahl.Eintrag>();

    /// <summary>Die markierte Anlage bekommt einen anderen Energieträger (Zeile, Träger-Id).</summary>
    [Parameter] public Action<ErzeugerZeile, int>? TraegerWechseln { get; set; }

    [Parameter] public string LabelTraegerGruppe { get; set; } = "Energieträger:";
    [Parameter] public string LabelTraegerArt { get; set; } = "Art:";

    /// <summary>
    /// Der Parametersatz der MODULVERWALTUNG. Sie erscheint seit iU9-W14a als
    /// <c>Ueberlagerung</c> im selben Fenster statt als zweites Fenster über die
    /// Sprungbrücke (Risiko R2) — ihr Ziel ist jetzt selbst Blazor. Ohne Delegat
    /// kein Knopf.
    /// </summary>
    [Parameter] public Func<IReadOnlyDictionary<string, object>>? VerwaltungGaben { get; set; }

    /// <summary>Assistentenbetrieb: keine OK/Abbrechen-Leiste.</summary>
    [Parameter] public bool Wizard { get; set; }

    /// <summary><c>true</c> = OK, <c>false</c> = Abbrechen.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    /// <summary>
    /// ALLE Felder eines Katalogsatzes — derselbe Weg, aus dem der Modulkatalog hinter
    /// „Bearbeiten…" seine Eingabefelder speist (<c>ModulKatalogWege.Detail</c>,
    /// abgebildet in der Hülle). Ohne ihn gibt es den Aufklapper nicht.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<BrowserFeldwert>?>? Katalogfelder { get; set; }

    /// <summary>
    /// Schreibt die geänderten Felder zurück; <c>null</c> = der Katalog hat keinen
    /// Speicherweg, dann ist der Aufklapper reine Anzeige.
    /// </summary>
    /// <remarks>
    /// Der Modulkatalog speichert den VOLLSATZ; was der Aufklapper nicht setzen darf
    /// (der Bezeichner als Schlüssel des <c>UPDATE</c>), behält dabei seinen gelesenen
    /// Wert. Die Abbildung besorgt die Hülle — die Komponente reicht nur die Liste
    /// hinaus.
    /// </remarks>
    [Parameter] public Func<string, IReadOnlyList<BrowserFeldwert>, KatalogSpeicherErgebnis>? KatalogfelderSpeichern { get; set; }

    // --- Kostenleiste ----------------------------------------------------------
    // Sie steht seit dem 15.09.2026 IM Modulbereich, oberhalb von „Bearbeiten…" -
    // dieselbe Anordnung wie beim Heizkessel. Die Leiste selbst kennt nur „Schalter
    // betrieb ja/nein"; WELCHE Zeile gemeint ist, weiss allein dieser Dialog.

    /// <summary>
    /// Öffnet die Kostenverwaltung zur GEWÄHLTEN Projektzeile; der zweite Parameter ist
    /// der Schalter <c>betrieb</c> (<c>false</c> = Investitions-, <c>true</c> =
    /// Betriebskosten). Die Zeile ist <c>null</c>, solange keine gewählt ist. Ohne
    /// Delegat fehlen beide Knöpfe.
    /// </summary>
    [Parameter] public Func<ErzeugerZeile?, bool, Task>? KostenOeffnen { get; set; }

    /// <summary>
    /// Öffnet die Energieträgerverwaltung zur GEWÄHLTEN Projektzeile (Träger und Gerät
    /// gehen mit); <c>null</c> = keine Wahl. Ohne Delegat fehlt der Knopf.
    /// </summary>
    [Parameter] public Func<ErzeugerZeile?, Task>? EnergiekostenOeffnen { get; set; }

    [Parameter] public string KostenInvestText { get; set; } = "Investitionskosten…";
    [Parameter] public string KostenBetriebText { get; set; } = "Betriebskosten…";
    [Parameter] public string KostenEnergieText { get; set; } = "Energiekosten…";

    /// <summary>Der Parametersatz der offenen Katalogverwaltung; <c>null</c> = zu.</summary>
    private IReadOnlyDictionary<string, object>? _verwaltungGaben;

    /// <summary>Steht die Katalogverwaltung? (Prüfhilfe für Tests.)</summary>
    public bool VerwaltungOffen => _verwaltungGaben is not null;

    /// <summary>
    /// Nach der Verwaltung die Katalogliste neu ziehen — genau das tat der Vorläufer
    /// nach der Rückkehr aus dem zweiten Fenster.
    /// </summary>
    private void VerwaltungFertig(ModulErgebnis? ergebnis)
    {
        _verwaltungGaben = null;
        KatalogNeuLaden();
    }


    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Verwaltung Stromspeicher";
    [Parameter] public string KopfbandText { get; set; } = "Geben Sie Daten der Stromspeicher ein";
    [Parameter] public string LabelProjektliste { get; set; } = "ausgewählte Stromspeicher:";
    [Parameter] public string LabelKatalogliste { get; set; } = "Stromspeicher aus Datenbank:";
    [Parameter] public string SpalteWahl { get; set; } = "Wahl";
    [Parameter] public string LabelHinzu { get; set; } = "In das Projekt übernehmen";
    [Parameter] public string LabelEntfernen { get; set; } = "Aus dem Projekt entfernen";
    [Parameter] public string BtnBearbeitenText { get; set; } = "Bearbeiten...";
    [Parameter] public string GruppeModul { get; set; } = "Modul";

    /// <summary>Beschriftung des Aufklappers über den übrigen Katalogwerten.</summary>
    [Parameter] public string LabelAlleParameter { get; set; } = "Alle Daten anzeigen";

    /// <summary>Beschriftung des Speicherknopfs im Aufklapper.</summary>
    [Parameter] public string BtnFelderSpeichernText { get; set; } = "Speichern";

    [Parameter] public string LabelName { get; set; } = "Name:";
    [Parameter] public string OkText { get; set; } = "OK";
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_Stromspeicher.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private ErzeugerZeile? _projektZeile;
    private Katalogfilterzeile? _katalogZeile;
    private IReadOnlyList<Katalogfilterzeile> _katalog = Array.Empty<Katalogfilterzeile>();

    /// <summary>Der gewählte Bezeichner der KATALOGliste — die Markierung hängt am NAMEN.</summary>
    private string _katalogGewaehlt = "";

    /// <summary>Der Filterstand je Katalog über die Sitzung (S2.5, Frage Q2).</summary>
    private Katalogfilterstand _filterstand = new();
    private ErzeugerDetail _detail = new("", "", Array.Empty<(string, string)>());

    /// <summary>
    /// Steht der Aufklapper „Alle Daten" offen? Der Zustand gehört der Dialogsitzung und
    /// überlebt den Satzwechsel, wird aber nirgends abgelegt. <b>Vorgabe OFFEN</b>
    /// (Anwenderentscheid 16.09.2026).
    /// </summary>
    /// <remarks>
    /// Weil er offen beginnt, holt schon die ERSTE Wahl eines Katalogsatzes die Felder:
    /// <c>KatalogZeileWaehlen</c> ruft <c>FelderHolen</c>, sobald er offen steht. Ohne
    /// gewählten Satz gibt es den Block nicht — dann wird auch nichts abgefragt.
    /// </remarks>
    private bool _parameterOffen = true;

    /// <summary>Die Felder des gewählten Satzes; <c>null</c> = noch nicht geholt.</summary>
    private IReadOnlyList<BrowserFeldwert>? _felder;

    /// <summary>Hat der Anwender im Aufklapper etwas geändert?</summary>
    private bool _felderGeaendert;

    /// <summary>Knopf „Speichern" des Aufklappers samt Rückmeldung daneben.</summary>
    private Speichervermerk? _felderVermerk;

    /// <summary>Meldung des Katalogs zum letzten gelungenen Speichern — für den Assistenten, nicht als Band.</summary>
    private string _felderErfolg = "";

    /// <summary>Steht in einem Zahlenfeld des Aufklappers etwas Ungültiges?</summary>
    private bool _feldFehler;

    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Hinweis;

    /// <summary>Steht der Parameterblock offen? (Pruefhilfe fuer Tests.)</summary>
    public bool ParameterOffen => _parameterOffen;

    /// <summary>Die aktuelle Meldung (Pruefhilfe fuer Tests).</summary>
    public string Meldung => _meldung;

    /// <summary>Die gewaehlte Projektzeile (Pruefhilfe fuer Tests).</summary>
    public ErzeugerZeile? Projektzeile => _projektZeile;

    /// <summary>Die gewaehlte Katalogzeile (Pruefhilfe fuer Tests).</summary>
    public Katalogfilterzeile? Katalogzeile => _katalogZeile;

    /// <summary>Die Zeilen des Katalogs (Pruefhilfe fuer Tests).</summary>
    public IReadOnlyList<Katalogfilterzeile> Katalog => _katalog;

    /// <summary>Der Filterzustand des Katalogs (Pruefhilfe fuer Tests).</summary>
    public Katalogfilterstand Filterstand => _filterstand;

    protected override void OnParametersSet()
    {
        Filtertexte.SpalteWahl = SpalteWahl;
    }

    protected override void OnInitialized()
    {
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Katalogprofil?.Art ?? Anlagenart.Stromspeicher);

        KatalogNeuLaden();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);

        // Welle KI-F1: die GEWAEHLTE Zeile beim Hilfe-Assistenten anmelden - als
        // Delegat und nicht als Instanz, denn sie wechselt mit jedem Klick in der
        // Projektliste.
        // KI-F1b: Der Energieträger ist ein WAHLFELD; seine Einträge stehen im
        // Trägerkatalog, den die Hülle hereinreicht.
        // Welle #458, Stufe 2: angemeldet ist seither die SICHTKLASSE - sie reicht die
        // gewaehlte Zeile durch und traegt den Aufklapper „Alle Daten" als Feldtafel.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.STROMSPEICHER_PROJEKT,
                                          () => KiSicht(), KiHaken(),
                                          ("energietraeger", Traegereintraege));
    }

    private ErzeugerProjektKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die gewählte Projektzeile und der Aufklapper „Alle
    /// Daten" des gewählten Katalogsatzes (Welle #458, Stufe 2).
    /// </summary>
    private ErzeugerProjektKiSicht KiSicht() => _kiSicht ??= new ErzeugerProjektKiSicht
    {
        Zeilenquelle = () => _projektZeile,
        AlleDaten = new AlleDatenTafel
        {
            Felder = () => _parameterOffen ? _felder : null,
            Sperrgrund = () => AlleDatenTafel.Grund(_parameterOffen ? _felder : null, KatalogfelderSpeichern is not null,
                                                    _katalogZeile?.Geschuetzt == true),
            Gesetzt = () => _felderGeaendert = true
        }
    };

    /// <summary>Die Energieträger des Katalogs für den Assistenten (KI-F1b).</summary>
    private IReadOnlyList<KiWahleintrag> Traegereintraege()
        => KiMaskenanmeldung.Eintraege(Traegerkatalog, e => e.Id, e => e.Name);

    // =================================================================================
    // Der Hilfe-Assistent liest die Zeile (Welle KI-F1)
    // =================================================================================

    /// <summary>
    /// Die Anmeldung bei der <c>KiMaskenbruecke</c>. Sie hält den Getter auf die
    /// gewählte Projektzeile und fällt mit dem Dialog.
    /// </summary>
    /// <remarks>
    /// <b>Angemeldet heißt nicht übertragen.</b> Ob ein Feldwert hinausgeht,
    /// entscheiden der Schalter „Feldwerte mitsenden" im Chat und die
    /// Einwilligungsstufe „Dialogdaten" (KI‑D‑Q2).
    /// </remarks>
    private KiMaskenanmeldung? _kiMaske;

    /// <summary>
    /// Was der Assistent über den Feldwert hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>Speichern ist der Knopf des Aufklappers „Alle Daten"</b> (Welle #458,
    /// Stufe 2). Die Maske selbst wählt das Gerät; die Betriebsführung der Speicher
    /// steht in der Ansicht „Stromspeicher-Auslegung". Trägt der Aufklapper keine
    /// Änderung, lehnt <c>dialog_speichern</c> benannt ab.</para>
    /// <para><b>Der SCHREIBSCHUTZ hängt am Gerät</b>, auf das die gewählte Zeile
    /// verweist (<c>ErzeugerZeile.NurLesen</c>); den Auslieferungssatz im Aufklapper
    /// meldet die Feldtafel selbst.</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _projektZeile?.NurLesen ?? false,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>„Speichern" des Assistenten — der Weg des Knopfes im Aufklapper.</summary>
    private KiKern.KiErgebnis KiSpeichern()
    {
        if (!_felderGeaendert)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_DLG_ALLE_DATEN_UNGEAENDERT.Replace("{0}", TitelText));

        FelderSpeichern();
        return _felderGeaendert
            ? KiKern.KiErgebnis.Abgelehnt(_meldung.Length > 0 ? _meldung
                  : Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText))
            : KiKern.KiErgebnis.Ok(_felderErfolg, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <summary>
    /// Liest den Katalog neu — nach einem SCHREIBweg (Verwaltung). Der FILTER ruft
    /// sie nicht: Er wirkt auf die Anzeige, nie auf die Auswahl.
    /// </summary>
    private void KatalogNeuLaden()
    {
        _katalog = Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();
        VerwendungStempeln();

        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
    }

    /// <summary>Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste.</summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    /// <summary>Der Katalogsatz zu einem Bezeichner; <c>null</c>, wenn es ihn nicht gibt.</summary>
    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    /// <summary>ET‑5: Trägerwechsel der markierten Anlage — an die Hülle, dann in die Zeile.</summary>
    private void BeiTraegerwechsel(int? neu)
    {
        if (_projektZeile is null || !neu.HasValue) return;
        if (neu.Value == _projektZeile.CarrierId) return;
        TraegerWechseln?.Invoke(_projektZeile, neu.Value);
        _projektZeile.CarrierId = neu.Value;
    }

    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _detail = (Detail is not null ? Detail(zeile.Bezeichner) : null) ?? Leer(zeile.Bezeichner);
    }

    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _projektZeile = null;
        _detail = (Detail is not null ? Detail(_katalogGewaehlt) : null) ?? Leer(_katalogGewaehlt);

        // DER AUFKLAPPER GEHOERT ZUM GEWAEHLTEN SATZ. Bleibt er ueber den Wechsel
        // offen - und das soll er, sonst muesste man ihn beim Vergleichen zweier
        // Speicher jedes Mal neu aufziehen -, dann zeigt er die Felder des NEUEN
        // Satzes und nicht die des alten.
        if (_parameterOffen) FelderHolen();
    }

    private static ErzeugerDetail Leer(string name)
        => new(name, "", Array.Empty<(string, string)>());

    /// <summary>„◀": je Klick eine eigene Zeile (AP2b).</summary>
    private void BeiHinzu()
    {
        if (_katalogZeile is null || Aufnehmen is null) return;

        AufnahmeErgebnis aufnahme = Aufnehmen(_katalogZeile.Id);
        if (aufnahme.Zeile is null) return;

        Zeilen.Add(aufnahme.Zeile);
        VerwendungStempeln();                 // Q12
        ProjektZeileWaehlen(aufnahme.Zeile);
    }

    /// <summary>
    /// „▶": Die GEWAEHLTE Zeile geht. Der Vorlaeufer nahm die erste Zeile gleichen
    /// Namens - bei zwei gleichen Speichern also nicht zwingend die markierte
    /// (Abweichung A-17). Bleibt nichts uebrig, wandert die Auswahl in die rechte
    /// Liste, wie es <c>btn_Entfernen_Click</c> ueber einen nachgebauten Mausklick tat.
    /// </summary>
    private void BeiEntfernen()
    {
        if (_projektZeile is null) return;

        ErzeugerZeile zeile = _projektZeile;
        Zeilen.Remove(zeile);
        Entfernen?.Invoke(zeile);
        VerwendungStempeln();                 // Q12

        _projektZeile = null;
        _detail = Leer("");

        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
        else if (_katalog.Count > 0) KatalogZeileWaehlen(_katalog[0].Bezeichner);
    }

    private async Task BeiBearbeiten()
    {
        if (VerwaltungGaben is null) return;
        _verwaltungGaben = VerwaltungGaben();
        await Task.CompletedTask;
    }

    // =================================================================================
    // Der Aufklapper „Alle Daten anzeigen" (Anwenderentscheid 15.09.2026)
    // =================================================================================

    /// <summary>
    /// Auf- und zuklappen - und beim AUFklappen die Felder holen.
    /// </summary>
    /// <remarks>
    /// <b>Der Knopf bleibt, die Vorgabe ist offen.</b> Wer zuklappt und wieder
    /// aufklappt, sieht den Stand von JETZT und nicht den von der Auswahl.
    /// </remarks>
    private void ParameterUmschalten()
    {
        _parameterOffen = !_parameterOffen;
        if (_parameterOffen) FelderHolen();
    }

    /// <summary>Holt die Felder des gewählten Katalogsatzes neu.</summary>
    private void FelderHolen()
    {
        _felder = Katalogfelder is null || _katalogZeile is null
            ? null
            : Katalogfelder(_katalogZeile.Bezeichner);
        _felderGeaendert = false;
        _feldFehler = false;
    }

    /// <summary>Ein Zahlenfeld des Aufklappers meldet einen ungültigen Zustand.</summary>
    private void BeiFeldFehler((string Feldname, bool Fehler) meldung)
        => _feldFehler = meldung.Fehler;

    /// <summary>Eine Eingabe im Aufklapper: Speichern geht wieder, der Vermerk fällt weg.</summary>
    private void FeldGeaendert()
    {
        _felderGeaendert = true;
        _felderVermerk?.Leeren();
    }

    /// <summary>
    /// Schreibt die geänderten Felder zurück und lädt Liste und Detailblock neu.
    /// </summary>
    /// <remarks>
    /// <b>Der Befund des Katalogs zählt, nicht die Absicht.</b> Lehnt der Speicherweg ab
    /// (Schreibschutz der Auslieferung, Prüfmeldung), bleibt der geänderte Stand im
    /// Aufklapper stehen - der Anwender soll ihn verbessern können, statt ihn zu
    /// verlieren.
    /// </remarks>
    private void FelderSpeichern()
    {
        if (KatalogfelderSpeichern is null || _felder is null || _katalogZeile is null) return;

        KatalogSpeicherErgebnis ergebnis = KatalogfelderSpeichern(_katalogZeile.Bezeichner, _felder);
        if (!ergebnis.Ok)
        {
            // Das Band oben bleibt fuer den Fehler - dazu der Grund rot am Knopf.
            Melden(ergebnis.Meldung, true);
            _felderVermerk?.Fehler(ergebnis.Meldung);
            return;
        }

        // Der Erfolg steht nur noch am Knopf; ein Band einer frueheren Ablehnung faellt weg.
        _felderGeaendert = false;
        _meldung = "";
        _felderErfolg = ergebnis.Meldung;
        _felderVermerk?.Gespeichert();
        KatalogNeuLaden();

        // Der Detailblock oben liest dieselben Spalten - er muss den neuen Stand zeigen.
        if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
    }

    // --- Die Bruecke zur Kostenleiste ------------------------------------------
    // Ohne Delegat KEIN Rueckruf - sonst zeichnete die Leiste einen Knopf, der
    // nichts tut (ihre eigene Regel).

    private Func<bool, Task>? KostenLeiste
        => KostenOeffnen is null ? null : (Func<bool, Task>)BeiKosten;

    private Func<Task>? EnergieLeiste
        => EnergiekostenOeffnen is null ? null : (Func<Task>)BeiEnergiekosten;

    /// <summary>Reicht die gewählte Projektzeile an die Kostenverwaltung durch.</summary>
    private Task BeiKosten(bool betrieb)
        => KostenOeffnen?.Invoke(_projektZeile, betrieb) ?? Task.CompletedTask;

    /// <summary>Reicht die gewählte Projektzeile an die Energieträgerverwaltung durch.</summary>
    private Task BeiEnergiekosten()
        => EnergiekostenOeffnen?.Invoke(_projektZeile) ?? Task.CompletedTask;

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Der Abbrechen-Weg: schliesst ohne zu speichern. Esc und das ✕ im Kopf rufen ihn.</summary>
    private Task Abbrechen() => BeiErgebnis(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        return Abbrechen();
    }
}
