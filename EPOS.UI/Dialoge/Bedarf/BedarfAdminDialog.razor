    /// <summary>
    /// Der Katalogschlüssel DIESER Ausprägung. Die drei Verwaltungen sind drei Masken
    /// mit eigenem Namen und eigenem Navigationsziel; gezeichnet wird dieselbe
    /// Komponente.
    /// </summary>
    public string KiMaske => Art switch
    {
        BedarfsArt.Stromverbraucher => KiMaskennamen.STROMVERBRAUCHER_ADMIN,
        BedarfsArt.Brauchwasser     => KiMaskennamen.BRAUCHWASSER_ADMIN,
        _                           => KiMaskennamen.PROZESSWAERME_ADMIN
    };

    /// <summary>
    /// Die Sicht des Assistenten: die Listenwahl und die Kenndaten des Stammblatts —
    /// Typ, Beschreibung und die zwölf Monatswerte schreiben in den ARBEITSSTAND, genau
    /// wie die Felder der Maske (Welle #456).
    /// </summary>
    private BedarfAdminKiSicht KiSicht()
    {
        return _kiSicht ??= new BedarfAdminKiSicht
        {
            SatzLesen = () => _gewaehlt,
            SatzSetzen = KiSatzWaehlen,
            SatzEintraege = () => KiMaskenanmeldung.Eintraege(
                _katalog, z => z.Bezeichner, z => z.Bezeichner),

            BeschreibungLesen = () => _arbeitBeschreibung,
            BeschreibungSetzen = BeiBeschreibung,
            TypLesen = () => _arbeitTyp,
            TypSetzen = KiTypSetzen,
            TypEintraege = () => KiMaskenanmeldung.Eintraege(_typliste, t => t, t => t),
            MonatLesen = m => _arbeitMonate[m],
            MonatSetzen = BeiMonat,
            JahressummeLesen = () => _jahressumme,
            BedarfsartLesen = () => Art.ToString()
        };
    }

    /// <summary>
    /// <b>Der Assistent wählt eine Zeile</b> — derselbe Weg wie ein Klick
    /// (<see cref="BeiZeile"/>). Geänderte Felder halten den Wechsel an (Konzept 3.3);
    /// der Assistent bekommt denselben Satz, den das Warnband zeigt.
    /// </summary>
    private string? KiSatzWaehlen(string bezeichner)
    {
        string neu = bezeichner ?? "";
        if (neu == _gewaehlt) return null;

        if (_geaendert)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return Resource.ADM_MSG_UNGESPEICHERT;
        }

        BeiZeile(neu);
        return null;
    }

    /// <summary>Der Typ über den Assistenten — der Name aus der Typliste, wie die Klappliste ihn setzt.</summary>
    private void KiTypSetzen(string typ)
    {
        if (_auslieferung) return;
        _arbeitTyp = typ ?? "";
        Nachziehen();
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Welle #456).
    /// </summary>
    /// <remarks>
    /// <para><b>Schreibschutz</b> ist der Auslieferungssatz (AD-Q11): Solange er steht,
    /// lehnt schon <c>feld_setzen</c> ab, und die Absage nennt den Weg über
    /// „Duplizieren…". Die Wahl des Satzes bleibt frei.</para>
    /// <para><b>Prüfen und Speichern</b> sind DIESELBEN Wege wie am Knopf
    /// (<see cref="Pruefbefund"/>, <see cref="BeiSpeichern"/>). Anlegen, Duplizieren,
    /// Löschen und der Stammkopf bleiben dem Assistenten verschlossen (KI-D-Q11).</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _auslieferung,
        Schreibschutzgrund = () => MeldungSpeichernGesperrt,
        Pruefen = () => Pruefbefund() ?? "",
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>
    /// <b>„Speichern" über den Assistenten</b> — derselbe Weg wie der Knopf; ein
    /// Auslieferungssatz, ein fehlender Satz und ein unveränderter Stand werden benannt
    /// abgelehnt.
    /// </summary>
    private KiErgebnis KiSpeichern()
    {
        if (Speichern is null)
            return KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText));
        if (_gewaehlt.Length == 0)
            return KiErgebnis.Abgelehnt(Resource.KI_DLG_ADMIN_OHNE_SATZ.Replace("{0}", TitelText));
        if (_auslieferung) return KiErgebnis.Abgelehnt(MeldungSpeichernGesperrt);
        if (!_geaendert)
            return KiErgebnis.Abgelehnt(Resource.KI_DLG_ADMIN_OHNE_AENDERUNG.Replace("{0}", TitelText));

        string? befund = Pruefbefund();
        if (befund is not null)
        {
            Warnen(befund);
            return KiErgebnis.Abgelehnt(befund);
        }

        BeiSpeichern();
        return _geaendert
            ? KiErgebnis.Fehlgeschlagen(_meldung)
            : KiErgebnis.Ok(_status, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>
    /// Lädt die Liste neu — <c>SetControls</c> des Vorläufers. Er wählte danach die
    /// ERSTE Zeile (<c>SelectedIndex = 0</c>); das tut diese Fassung auch, solange die
    /// bisherige Wahl nicht mehr in der Liste steht.
    /// </summary>
    public void KatalogLaden()
    {
        if (Katalogzeilen is null) return;

        _katalog = Katalogzeilen() ?? Array.Empty<Katalogfilterzeile>();

        _geschuetzt = new HashSet<string>(_katalog.Where(z => z.Geschuetzt).Select(z => z.Bezeichner),
                                          StringComparer.Ordinal);

        // Kaestchen verschwundener Zeilen fallen (V6); ein laufender Vergleich liest neu.
        _auswahl.Abgleichen(_katalog.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        if (_katalog.Count == 0) { Leeren(); return; }
        if (_katalog.All(z => z.Bezeichner != _gewaehlt)) Waehlen(_katalog[0].Bezeichner);
        else Waehlen(_gewaehlt);
    }

    /// <summary>
    /// Die Liste meldet eine Zeile. <b>Trägt das Stammblatt geänderte Felder, bleibt die
    /// Wahl stehen</b> (Konzept 3.3) — das Warnband sagt „Speichern oder Verwerfen".
    /// </summary>
    private void BeiZeile(string bezeichner)
    {
        if (_geaendert && bezeichner != _gewaehlt)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return;
        }
        Waehlen(bezeichner);
    }

    /// <summary>
    /// Eine Zeile wählen — <c>listBox_*_SelectedIndexChanged</c> des Vorläufers:
    /// Jahressumme rechnen und den Kopf zeigen.
    /// </summary>
    private void Waehlen(string bezeichner)
    {
        _gewaehlt = bezeichner ?? "";
        _meldung = "";
        _fokuszeile = _katalog.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
        _auslieferung = _fokuszeile?.Geschuetzt == true;

        _jahressumme = Jahressumme is not null ? Jahressumme(_gewaehlt) ?? "" : "";

        // Woertlich: Der Vorlaeufer prueft rows > 0 und laesst die drei Felder sonst
        // UNVERAENDERT stehen.
        (string Beschreibung, string Typ)? kopf = Kopf?.Invoke(_gewaehlt);
        if (kopf is not null)
        {
            _beschreibung = kopf.Value.Beschreibung;
            _typ = kopf.Value.Typ;
        }

        // Stufe 4: der Arbeitsstand beginnt beim gespeicherten Stand.
        double[]? monate = Monatswerte?.Invoke(_gewaehlt);
        _monate = new double?[12];
        if (monate is not null)
            for (int m = 0; m < 12 && m < monate.Length; m++) _monate[m] = monate[m];
        Zuruecksetzen();
    }

    /// <summary>Der Arbeitsstand wird wieder der gespeicherte Stand (Zeilenwahl, Verwerfen).</summary>
    private void Zuruecksetzen()
    {
        _arbeitTyp = _typ;
        _arbeitBeschreibung = _beschreibung;
        _arbeitMonate = (double?[])_monate.Clone();
        _fehlerhaft.Clear();
        _geaendert = false;
    }

    private void Leeren()
    {
        _fokuszeile = null;
        _auslieferung = false;
        _gewaehlt = "";
        _beschreibung = "";
        _typ = "";
        _jahressumme = "";
    }

    // =====================================================================
    // "Profil ändern..." / "Neues Profil..." / "Profiltyp ändern..."
    // =====================================================================

    private void BeiNeu()
    {
        if (TypStammGaben is null) return;
        if (_geaendert) { Warnen(Resource.ADM_MSG_UNGESPEICHERT); return; }
        _meldung = "";
        _namensfrage = true;
    }

    /// <summary>
    /// Die Reihenfolge des Vorläufers, wörtlich: Namensabfrage → <c>Exists</c> →
    /// <c>TypStammHuelle.Neu</c>.
    /// </summary>
    private void NamensfrageFertig(string? name)
    {
        _namensfrage = false;
        if (string.IsNullOrEmpty(name) || TypStammGaben is null) return;

        if (Exists is not null && Exists(name))
        {
            Melden(MeldungNameBelegt, WarnStufe.Warnung);
            return;
        }

        _typStammGaben = TypStammGaben(name, "", "", true);
    }

    /// <summary>Der Stammkopf ist zu; der Vorläufer lud danach IMMER die Liste neu.</summary>
    private void TypStammFertig()
    {
        _typStammGaben = null;
        KatalogLaden();
    }

    private void BeiTypAendern()
    {
        if (TypProfilGaben is null) return;
        _meldung = "";
        _typProfilOffen = true;
    }

    // =====================================================================
    // "Profil löschen"
    // =====================================================================

    /// <summary>
    /// <b>„Löschen" aus der Auswahlleiste</b> (V8, AD-Q9): wirkt auf die gewählten
    /// Zeilen, sonst auf die Fokuszeile; Auslieferungssätze bleiben stehen (V13).
    /// </summary>
    private void BeiLoeschen()
    {
        if (Loeschen is null) return;

        // A-1: Das Brauchwasser prüfte NICHT und fragte bei leerer Liste
        // "Soll  wirklich gelöscht werden ?" (Befund W14-B51).
        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count == 0)
        {
            Melden(MeldungKeineWahl, WarnStufe.Hinweis);
            return;
        }

        var loeschbar = ziele.Where(z => !_geschuetzt.Contains(z)).ToList();
        var bleiben = ziele.Where(z => _geschuetzt.Contains(z)).ToList();
        if (loeschbar.Count == 0) { Warnen(Resource.ADM_AW_LOESCHEN_GESPERRT); return; }

        _loeschziele = loeschbar;
        _loeschBleiben = bleiben.Count;

        // A-2: EIN Satz mit Platzhalter statt dreier Schreibweisen (Befund W14-B64).
        string frage = loeschbar.Count == 1
            ? string.Format(VorlageLoeschfrage, loeschbar[0])
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_FRAGE_MEHR,
                            loeschbar.Count, string.Join(", ", loeschbar));
        if (bleiben.Count > 0)
            frage += " " + string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_BLEIBEN,
                                         string.Join(", ", bleiben));
        _loeschfrageText = frage;
        _loeschfrage = true;
    }

    /// <summary>
    /// Nach dem „Ja": je Zeile ein Schritt. A-3: Ein Fehlschlag ist eine Meldung IM
    /// Dialog — der Vorläufer ließ den Stammcontroller die ReadOnly-Sperre als modalen
    /// Kasten melden (Befund W14-B59). Gelungenes nennt die Statuszeile (V11).
    /// </summary>
    private void LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || Loeschen is null) return;

        int geloescht = 0;
        string? fehler = null;
        foreach (string name in _loeschziele)
        {
            BedarfLoeschAusgang ausgang = Loeschen(name);
            if (ausgang == BedarfLoeschAusgang.Geloescht) { geloescht++; continue; }
            fehler ??= ausgang == BedarfLoeschAusgang.Schreibgeschuetzt
                ? MeldungSchreibgeschuetzt : MeldungLoeschfehler;
        }

        int ziele = _loeschziele.Count + _loeschBleiben;
        int blieben = ziele - geloescht;
        string einzeln = _loeschziele.Count == 1 ? _loeschziele[0] : "";
        _loeschziele = new List<string>();

        if (geloescht > 0) KatalogLaden();
        if (fehler is not null) Warnen(fehler);

        if (geloescht == 0) return;
        _status = ziele == 1
            ? string.Format(MeldungGeloescht, einzeln)
            : blieben > 0
                ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT_BLEIBEN, geloescht, blieben)
                : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT, geloescht);
    }

    // =====================================================================
    // „Duplizieren…" (Stufe 3; Entscheid AD-Q11)
    // =====================================================================

    /// <summary>
    /// „Duplizieren…": Namensabfrage, vorbelegt mit „Name (Kopie)", dann der eigene Satz
    /// mit Typ, Beschreibung und Monatswerten des gewählten.
    /// </summary>
    private void BeiDuplizieren()
    {
        if (Duplizieren is null) return;
        if (_geaendert) { Warnen(Resource.ADM_MSG_UNGESPEICHERT); return; }
        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count != 1) return;

        _duplizierQuelle = ziele[0];
        _meldung = "";
        _kopievorschlag = Katalogkopie.Namensvorschlag(_duplizierQuelle, NameVergeben);
        _duplizierfrage = true;
    }

    private bool NameVergeben(string name)
        => _katalog.Any(z => z.Bezeichner == name) || Exists?.Invoke(name) == true;

    private string? NameBelegt(string name) => NameVergeben(name) ? MeldungNameBelegt : null;

    private void BeiDuplizierName(string? name)
    {
        _duplizierfrage = false;
        if (name is null || Duplizieren is null) return;

        Katalogfilterzeile? zeile = _katalog.FirstOrDefault(z => z.Bezeichner == _duplizierQuelle);
        if (zeile is null) return;

        KatalogSpeicherErgebnis ergebnis = Duplizieren(zeile.Id, name);
        if (!ergebnis.Ok)
        {
            Warnen(ergebnis.Meldung);
            return;
        }

        // Die Kopie ist gewaehlt, die Kaestchen fallen: Die naechste Handlung gilt ihr.
        _auswahl.Aufheben();
        _vergleichszeilen = null;
        _gewaehlt = ergebnis.Name;
        KatalogLaden();
        _status = string.Format(MeldungDupliziert, _duplizierQuelle, ergebnis.Name);
    }

    // =====================================================================
    // „Schloss setzen…" / „Schloss aufheben…" (Entscheid AD-Q15)
    // =====================================================================

    /// <summary>Die Zeilen, auf die die Auswahlleiste gerade wirkt.</summary>
    private IReadOnlyList<Katalogfilterzeile> SchlossZiele
        => Schlossumschaltung.Zeilen(_auswahl.Ziele(_gewaehlt), _katalog);

    /// <summary>
    /// Der Klick: Rückfrage in beiden Richtungen, Vorgabe „Nein". Beim Aufheben sagt sie,
    /// dass das Wochenprofil beim gesperrten Typ gesperrt bleibt. Geänderte Felder halten
    /// sie auf.
    /// </summary>
    private void BeiSchloss()
    {
        string? grund = _schloss.Fragen(Schloss, SchlossZiele, _geaendert, TypBleibtGesperrt);
        if (grund is not null) { Warnen(grund); return; }
        _meldung = "";
    }

    /// <summary>
    /// <b>Das Typ-Schloss bleibt getrennt</b> (AD-Q15): Die gesperrten Typen der Profile,
    /// deren Schloss aufgehoben wird, als Satz der Rückfrage — leer, wenn keiner gesperrt ist.
    /// </summary>
    private string TypBleibtGesperrt(IReadOnlyList<Katalogfilterzeile> ziele)
    {
        if (TypGesperrt is null) return "";
        List<string> typen = ziele.Select(z => z.Text(Katalogfilterprofil.SpTyp))
                                  .Where(t => !string.IsNullOrEmpty(t))
                                  .Distinct(StringComparer.Ordinal)
                                  .Where(t => TypGesperrt(t))
                                  .ToList();
        if (typen.Count == 0) return "";
        return typen.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_SCHLOSS_TYP_BLEIBT, typen[0])
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_SCHLOSS_TYP_BLEIBT_MEHR, string.Join(", ", typen));
    }

    /// <summary>
    /// Nach dem „Ja": schalten, die Liste neu lesen — Schloss, Lesemodus und Speichern
    /// folgen aus der Fokuszeile —, Erfolg in die Statuszeile.
    /// </summary>
    private void BeiSchlossAntwort(bool? antwort)
    {
        Schlossausgang a = _schloss.Beantwortet(antwort, Schloss);
        if (!a.Geschrieben)
        {
            if (a.Fehler.Length > 0) Warnen(a.Fehler);
            return;
        }
        KatalogLaden();
        _meldung = "";
        _status = a.Status;
    }

    // =====================================================================
    // "Grafik"
    // =====================================================================

    private void BeiGrafik()
    {
        if (!ZeileGewaehlt || Vorschau is null) return;
        _meldung = "";
        _ergebnisGaben = Vorschau(_gewaehlt);
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    /// <summary>
    /// „Beenden" — der eine Schlussweg. Es gibt nichts zu verwerfen: Stammkopf,
    /// Wochenprofil und Löschen schreiben sofort in den Katalog. Esc und das
    /// Schliesskreuz rufen denselben Weg (DL-2 Nr. 3).
    /// </summary>
    private Task Beenden()
    {
        // Stufe 4: Geaenderte Felder halten Beenden an (Konzept 3.3) - Esc und das
        // Kreuz nehmen denselben Weg.
        if (_geaendert)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(true);
    }

    // =====================================================================
    // Stufe 4 (A5): die Kenndaten direkt im Stammblatt
    // =====================================================================

    /// <summary>
    /// Die Klapplisteneinträge des Typs. Ein BESTANDSWERT, den der Katalog nicht (mehr)
    /// führt, wird vorangestellt (A-16 aus Welle 7, wie im Stammkopf).
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Typeintraege
    {
        get
        {
            var l = new List<(int, string)>();
            if (_arbeitTyp.Length > 0 && !_typliste.Contains(_arbeitTyp)) l.Add((-1, _arbeitTyp));
            for (int i = 0; i < _typliste.Count; i++) l.Add((i, _typliste[i]));
            return l;
        }
    }

    private int? Typindex
    {
        get
        {
            if (_arbeitTyp.Length == 0) return null;
            for (int i = 0; i < _typliste.Count; i++)
                if (string.Equals(_typliste[i], _arbeitTyp, StringComparison.Ordinal)) return i;
            return -1;
        }
    }

    private void BeiTyp(int? index)
    {
        if (_auslieferung) return;
        if (index is null) _arbeitTyp = "";
        else if (index.Value >= 0 && index.Value < _typliste.Count) _arbeitTyp = _typliste[index.Value];
        Nachziehen();
    }

    private void BeiBeschreibung(string wert)
    {
        if (_auslieferung) return;
        _arbeitBeschreibung = wert ?? "";
        Nachziehen();
    }

    private void BeiMonat(int monat, double? wert)
    {
        if (_auslieferung) return;
        _arbeitMonate[monat] = wert;
        Nachziehen();
    }

    private void BeiFehlerZustand((string Feld, bool Fehlerhaft) meldung)
    {
        if (meldung.Fehlerhaft) { _fehlerhaft.Add(meldung.Feld); _geaendert = true; }
        else _fehlerhaft.Remove(meldung.Feld);
    }

    /// <summary>Nach einer Eingabe: geändert, solange der Arbeitsstand vom gespeicherten abweicht.</summary>
    private void Nachziehen()
    {
        _geaendert = GeaenderteFelder > 0 || _fehlerhaft.Count > 0;
        _meldung = "";
        _status = "";
    }

    /// <summary>Wie viele Felder vom gespeicherten Stand abweichen.</summary>
    private int GeaenderteFelder
    {
        get
        {
            int n = 0;
            if (!string.Equals(_arbeitTyp, _typ, StringComparison.Ordinal)) n++;
            if (!string.Equals(_arbeitBeschreibung, _beschreibung, StringComparison.Ordinal)) n++;
            for (int m = 0; m < 12; m++)
                if (_arbeitMonate[m] != _monate[m]) n++;
            return n;
        }
    }

    /// <summary>Der Hinweis im Fuß des Stammblatts: „2 Felder geändert".</summary>
    private string Aenderungshinweis
    {
        get
        {
            if (!_geaendert) return "";
            int n = GeaenderteFelder;
            return n == 1 ? Resource.ADM_SB_GEAENDERT_EINS
                 : n > 1 ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_SB_GEAENDERT, n)
                 : Resource.ADM_SB_GEAENDERT_OFFEN;
        }
    }

    private string Monatsname(int m)
        => Monatsnamen is not null && Monatsnamen.Count > m ? Monatsnamen[m] : (m + 1).ToString(CultureInfo.CurrentCulture);

    private string Feldname(int m)
        => Feldnamen is not null && Feldnamen.Count > m ? Feldnamen[m] : Monatsname(m);

    /// <summary>Die Kenndaten eines Auslieferungssatzes als TEXT (V13).</summary>
    private IReadOnlyList<Stammblattwert> Kenndatenwerte => new[]
    {
        new Stammblattwert(LabelName, _gewaehlt),
        new Stammblattwert(LabelTyp, _typ),
        new Stammblattwert(LabelBeschreibung, _beschreibung),
        new Stammblattwert(LabelJahressumme, _jahressumme, EinheitText)
    };

    /// <summary>Die Monatswerte eines Auslieferungssatzes als TEXT (V13).</summary>
    private IReadOnlyList<Stammblattwert> Monatswertwerte
        => Enumerable.Range(0, 12)
                     .Select(m => new Stammblattwert(Monatsname(m),
                         _monate[m] is double w ? w.ToString("0.####", CultureInfo.CurrentCulture) : "",
                         EinheitMonat))
                     .ToList();

    /// <summary>
    /// <b>„Speichern"</b> — die Prüfregeln des Stammkopfes, wörtlich: Ein Feld mit
    /// Fehleingabe hält an, der Typ ist Pflicht, jeder der zwölf Monatswerte ist Pflicht
    /// (die Meldung nennt das erste Feld). Geschrieben wird über den Weg der Hülle;
    /// danach lädt die Liste neu (die Jahressumme rechnet der Kern) und die Statuszeile
    /// meldet es.
    /// </summary>
    private void BeiSpeichern()
    {
        if (_auslieferung) { SpeichernAbgelehnt(MeldungSpeichernGesperrt); return; }
        if (!_geaendert || Speichern is null || _gewaehlt.Length == 0) return;

        string? befund = Pruefbefund();
        if (befund is not null) { SpeichernAbgelehnt(befund); return; }

        var werte = new double[12];
        for (int m = 0; m < 12; m++) werte[m] = _arbeitMonate[m] ?? _monate[m] ?? 0.0;

        KatalogSpeicherErgebnis erg = Speichern(_gewaehlt, _arbeitTyp, _arbeitBeschreibung, werte);
        if (!erg.Ok)
        {
            SpeichernAbgelehnt(erg.Meldung);
            return;
        }

        _geaendert = false;
        KatalogLaden();
        _status = string.Format(CultureInfo.CurrentCulture, Resource.ADM_STATUS_GESPEICHERT,
                                DateTime.Now.ToString("HH:mm", CultureInfo.CurrentCulture));
    }

    /// <summary>
    /// <b>Die Prüfregeln des Stammkopfes</b> — EINMAL, für den Knopf und den Assistenten:
    /// Ein Feld mit Fehleingabe hält an, der Typ ist Pflicht, jeder der zwölf Monatswerte
    /// ist Pflicht (die Meldung nennt das erste Feld). <c>null</c> = alles steht.
    /// </summary>
    private string? Pruefbefund()
    {
        if (_fehlerhaft.Count > 0)
            return string.Format(CultureInfo.CurrentCulture, MeldungZahlFehlt, _fehlerhaft.First());
        if (_arbeitTyp.Trim().Length == 0) return MeldungTypFehlt;
        if (Monatswerte is not null)
            for (int m = 0; m < 12; m++)
                if (_arbeitMonate[m] is null)
                    return string.Format(CultureInfo.CurrentCulture, MeldungZahlFehlt, Feldname(m));
        return null;
    }

    /// <summary>„Verwerfen" — der Arbeitsstand wird wieder der gespeicherte.</summary>
    private void BeiVerwerfen()
    {
        Zuruecksetzen();
        _meldung = "";
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_loeschfrage || _namensfrage || _typProfilOffen || _duplizierfrage || _schloss.FrageOffen
            || _typStammGaben is not null || _ergebnisGaben is not null) return Task.CompletedTask;

        // Im schmalen Fenster schliesst Esc zuerst das Blatt (Konzept 3.3).
        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }
        return Beenden();
    }
}
