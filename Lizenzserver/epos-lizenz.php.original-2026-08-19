define( 'EPOS_LIZENZ_VERSION', '1.3.0' );
define( 'EPOS_LIZENZ_DIR', plugin_dir_path( __FILE__ ) );
define( 'EPOS_LIZENZ_URL', plugin_dir_url( __FILE__ ) );

require_once EPOS_LIZENZ_DIR . 'includes/class-epos-schluessel.php';
require_once EPOS_LIZENZ_DIR . 'includes/class-epos-token.php';
