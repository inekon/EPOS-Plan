@* Die GRAFIK einer gewaehlten Stromganglinie (iU9-W12, Anwenderwunsch W12-E-2
   der Windows-Abnahme vom 05.09.2026).

   DER WUNSCH, woertlich: "Stelle die importierte Stromganglinie als Grafik dar
   (wie bisher, zoombar, umschaltbar auf sortiert)."

   "WIE BISHER" IST EINE FUNDSTELLE, DIE ES NICHT GIBT. Der Bestand zeigte eine
   Stromganglinie NIRGENDS als Kurve: Form_Stromganglinie_Admin (664 x 316,
   1c8c7c3^) fuehrte eine ListBox 335 x 174, vier Knoepfe und den Einlesekasten -
   kein Chart-Steuerelement; Form_Stromganglinie (58d02f6^) und
   Wizard_Stromlastgang (76f4279^) ebenso wenig; das einzige Chart der
   Stromverbraucher-Masken, Form_ErgStromverbraucher.chart1 (34e69ff^), zeichnete
   MONATSSAEULEN ("Monat" / "Strombedarf [MWh]"), keinen Jahresgang. Als Kurve
   erschien der Strom nur auf der Ergebnisseite: BildBedarfStrom, also
   ChartRenderer.GanglinieNormiert mit dem Schalter "sortiert". GENAU DIESES BILD
   steht hier - dieselbe Anordnung wie im GebaeudeBedarfDialog (W9.8): Kennzahlen,
   darunter der Schalter, darunter das Bild im Baustein Diagramm.

   EIN EIGENER BAUSTEIN, WEIL ZWEI LISTEN DARAUF ZEIGEN. Der Dialog fuehrt links
   die Projektzuordnungen und rechts den Katalog; die Grafik gehoert zu BEIDEN und
   steht deshalb unter ihnen, nicht in einer Spalte. Sie hier
   herauszuziehen haelt StromganglinieDialog lesbar und macht sie fuer die
   Verwaltungsmaske nachnutzbar.

   SEIT W9-E-3 TRAEGT SIE AUCH DIE WAERME. Der Anwenderwunsch vom 05.09.2026
   ("Gestalte den Dialog bei Waermebedarf -> Daten importieren analog zum Import
   des Strombedarf") verlangt dieselbe Grafik im Dialog "Waermebedarf Extern".
   Sie ist deshalb aus Dialoge/Strom nach Bausteine gezogen und traegt KEINEN
   Fachbezug mehr: Was auf der Achse steht, sagt der Wirt (Bildtext,
   LabelJahresarbeit, LabelSpitze), welche Farbe die Linie hat, entscheidet der
   Bildauftrag in der Huelle. Eine zweite, wortgleiche Fassung fuer die Waerme
   waere beim ersten Fachwechsel auseinandergelaufen.

   SIE RECHNET NICHTS UND ZEICHNET NICHTS. Die Kennzahlen kommen fertig herein
   (GanglinienAuswertungCtrl mit der Ausprägung GanglinienQuelle.Strom bzw.
   .Waermebedarf), das Bild holt ein Delegat aus dem Kern
   (ChartRenderer.GanglinieNormiert) - Regel R-W8-2: keine Zeichenbibliothek in
   dieser Bibliothek.

   DIE EINHEIT (Anwenderentscheid W8-O-5): MWh als Vorgabe, kWh waehlbar, gemerkt
   in derselben Ablage wie in den Bedarfsansichten (BedarfEinheitWahl). Sie gilt
   NUR fuer die Jahresarbeit - die Spitze ist eine Leistung in kW, die
   Vollbenutzungsstunden sind Stunden, und das Bild zeigt Prozent des
   Jahreshoechstwertes. *@

@namespace EPOS.UI.Bausteine
@using WindowsFormsApplication1
@using WindowsFormsApplication1.Zeichnung
@inherits Farbwahlwirt

<section class="epos-ganglinie-grafik" aria-label="@Bildtext">

    <p class="epos-kontextzeile">@Bezeichner</p>

    <dl class="epos-ganglinie-kennzahlen">
        <div class="epos-ganglinie-kennzahl">
            <dt>@LabelJahresarbeit</dt>
            <dd><span class="epos-ganglinie-wert">@Jahresarbeit</span> @_einheit.Text</dd>
        </div>
        <div class="epos-ganglinie-kennzahl">
            <dt>@LabelSpitze</dt>
            <dd><span class="epos-ganglinie-wert">@Zahl(Kennzahlen.SpitzeKw)</span> @EinheitKw</dd>
        </div>
        <div class="epos-ganglinie-kennzahl">
            <dt>@LabelVollbenutzung</dt>
            <dd><span class="epos-ganglinie-wert">@Vollbenutzung</span> @EinheitStunden</dd>
        </div>
    </dl>

    <div class="epos-ganglinie-leiste">
        <Schalter Bezeichnung="@LabelSortiert" Wert="@_sortiert" WertChanged="SortiertGesetzt" />
        <Auswahlfeld Bezeichnung="@LabelEinheit" Eintraege="@Einheitenwahl"
                     Auswahl="@EinheitIndex" AuswahlChanged="EinheitWaehlen" />
    </div>

    @* Der Zoom liegt im Bild (Etappe DG-E3, Gruppe (a)): Ein Zeitausschnitt ist die
       viewBox der Zeichenflaeche, „1:1" holt das ganze Jahr zurueck. Die Kennung
       traegt den Schluessel der Ganglinie — zwei Ganglinien nebeneinander duerfen
       nicht dieselbe clipPath-Kennung bekommen. *@
    <DiagrammSvg Modell="@Modell" Kennung="@Bildkennung" Bezeichnung="@Bildtext"
                 PlatzhalterText="@PlatzhalterBild" Einheit="@EinheitKw"
                 Achsenart="@(_sortiert ? Achsenart.Rang : Achsenart.Stuetzstelle)"
                 Palette="@Farbpalette.Aktuell"
                 FarbwahlErlaubt="@Farbwahl"
                 FarbeGewaehlt="FarbeUebernehmen"
                 FarbeZurueckgesetzt="FarbeVerwerfen" />

</section>

@code {
    /// <summary>
    /// Die IDENTITÄT der gezeigten Ganglinie. Ändert sie sich, fallen der
    /// Bildvorrat und der Achsenausschnitt weg — sonst zeigte die zweite Ganglinie
    /// das Bild der ersten.
    /// </summary>
    [Parameter] public string Schluessel { get; set; } = "";

    /// <summary>Der Name über der Grafik.</summary>
    [Parameter] public string Bezeichner { get; set; } = "";

    /// <summary>Die drei Kennzahlen; die Jahresarbeit liegt in MWh vor.</summary>
    [Parameter] public GanglinienKennzahlen Kennzahlen { get; set; } =
        new GanglinienKennzahlen(0, 0, null);

    /// <summary>
    /// Liefert die Jahresganglinie als ZEICHENMODELL — der Parameter ist die
    /// Schalterstellung „sortiert" (Dauerlinie). Ohne Delegat bleibt der Platzhalter
    /// stehen.
    ///
    /// <para>Ein zweiter Parameter für den aufgezogenen Bildausschnitt stand hier bis
    /// zur Etappe DG-E3; der Zeitausschnitt liegt seither im Bild (DG-E3-9).</para>
    /// </summary>
    [Parameter] public Func<bool, Zeichenmodell?>? Bildauftrag { get; set; }

    /// <summary>Die ANZEIGEEINHEIT beim Öffnen (Anwenderentscheid W8‑O‑5).</summary>
    [Parameter] public Energieeinheit Einheit { get; set; } = Energieeinheit.MWh;

    /// <summary>Meldet der Hülle die neu gewählte Einheit, damit sie gemerkt wird.</summary>
    [Parameter] public Action<Energieeinheit>? EinheitGewaehlt { get; set; }

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string LabelJahresarbeit { get; set; } = "Jahresarbeit:";
    [Parameter] public string LabelSpitze { get; set; } = "Spitzenlast:";
    [Parameter] public string LabelVollbenutzung { get; set; } = "Vollbenutzungsstunden:";
    [Parameter] public string LabelSortiert { get; set; } = "sortiert";
    [Parameter] public string LabelEinheit { get; set; } = "Einheit:";
    [Parameter] public string EinheitKw { get; set; } = "kW";
    [Parameter] public string EinheitStunden { get; set; } = "h/a";
    [Parameter] public string Bildtext { get; set; } = "Strombedarf Jahresganglinie";
    [Parameter] public string PlatzhalterBild { get; set; } = "Kein Diagramm vorhanden";

    /// <summary>Was statt eines fehlenden Wertes steht.</summary>
    [Parameter] public string LeerText { get; set; } = "—";

    // --- Stand -----------------------------------------------------------------

    private bool _sortiert;
    private Energieeinheit _einheit = Energieeinheit.MWh;
    private string _gezeigt = "";

    /// <summary>Steht der Schalter „sortiert"? Prüfhilfe für die Tests.</summary>
    public bool Sortiert => _sortiert;

    /// <summary>Die gewählte Anzeigeeinheit — Prüfhilfe für die Tests.</summary>
    public Energieeinheit Anzeigeeinheit => _einheit;

    protected override void OnParametersSet()
    {
        _einheit = Einheit ?? Energieeinheit.Vorgabe;

        if (_gezeigt == Schluessel) return;

        // Eine ANDERE Ganglinie: Der Modellvorrat gehoert zur alten.
        _gezeigt = Schluessel;
        _modelle.Clear();
    }

    // =================================================================================
    // Einheit
    // =================================================================================

    private IReadOnlyList<(int Id, string Text)> Einheitenwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                liste.Add((i, Energieeinheit.Alle[i].Text));
            return liste;
        }
    }

    private int EinheitIndex
    {
        get
        {
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                if (ReferenceEquals(Energieeinheit.Alle[i], _einheit)) return i;
            return 0;
        }
    }

    private void EinheitWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n >= Energieeinheit.Alle.Count) return;

        Energieeinheit neu = Energieeinheit.Alle[n];
        if (ReferenceEquals(neu, _einheit)) return;

        _einheit = neu;
        EinheitGewaehlt?.Invoke(neu);
    }

    // =================================================================================
    // Zahlen
    // =================================================================================

    /// <summary>Die Jahresarbeit in der gewählten Einheit — sie liegt in MWh vor.</summary>
    private string Jahresarbeit
        => _einheit.Formatiere(_einheit.AusMWh(Kennzahlen.JahresarbeitMwh));

    /// <summary>
    /// Eine LEISTUNG bzw. eine Stundenzahl — sie folgt der Einheitenwahl NICHT, aber
    /// der Anzeigekultur (zwei Nachkommastellen wie im Bestand).
    /// </summary>
    private string Zahl(double wert)
        => wert.ToString("F2", System.Globalization.CultureInfo.CurrentCulture);

    private string Vollbenutzung
        => Kennzahlen.VollbenutzungsstundenH is null
            ? LeerText
            : Zahl(Kennzahlen.VollbenutzungsstundenH.Value);

    // =================================================================================
    // Bild
    // =================================================================================

    /// <summary>
    /// Die gerechneten Zeichenmodelle, nach Schalterstellung getrennt.
    ///
    /// <para><b>Der Zwischenspeicher ist hier mehr als eine Ersparnis:</b> Der
    /// Baustein <c>DiagrammSvg</c> baut seinen Knotenbaum nur neu, wenn die REFERENZ
    /// des Modells wechselt. Ein Modell, das je Zeichenlauf neu entstünde, verwürfe
    /// mit dem Baum auch Zoom, Zeigerstelle und abgewählte Reihen.</para>
    /// </summary>
    private readonly Dictionary<bool, Zeichenmodell?> _modelle
        = new Dictionary<bool, Zeichenmodell?>();

    private Zeichenmodell? Modell
    {
        get
        {
            if (Bildauftrag is null) return null;
            if (_modelle.TryGetValue(_sortiert, out Zeichenmodell? vorhanden)) return vorhanden;

            Zeichenmodell? neu = Bildauftrag(_sortiert);
            _modelle[_sortiert] = neu;
            return neu;
        }
    }

    /// <summary>
    /// Die Kennung DIESER Grafik — sie trägt den Schlüssel der Ganglinie und die
    /// Schalterstellung, damit zwei Bilder nie dieselben <c>clipPath</c>-Kennungen
    /// bekommen.
    /// </summary>
    private string Bildkennung
        => "ganglinie-" + (Schluessel.Length > 0 ? Schluessel : "0") + (_sortiert ? "-s" : "");

    /// <summary>
    /// Ganglinie und Dauerlinie sind zwei Bilder; der Schalter tauscht das Modell,
    /// und mit ihm beginnt der Zoom des Bildes von vorn.
    /// </summary>
    private void SortiertGesetzt(bool wert) => _sortiert = wert;
}
