    // --- Prüfhilfen für die Tests -----------------------------------------------

    /// <summary>Die Senkenliste in Rangfolge.</summary>
    public IReadOnlyList<SenkenzeileDaten> Zeilen => _zeilen;

    /// <summary>Der gewählte Rang (0-basiert).</summary>
