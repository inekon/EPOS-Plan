        => _detail.Felder.Any(f => f.Feld == LabelBrennstofftyp);

    /// <summary>
    /// <b>Die Trägerwahl der Projektzeile</b> — ihr Bauplan steht EINMAL hier, weil sie an
    /// zwei Stellen erscheinen kann: im Paarblock unter „Brennstoff Typ" (der Regelfall)
    /// und ersatzweise dort, wo sie bis zum 16.09.2026 stand.
    /// </summary>
    private RenderFragment TraegerwahlFeld => @<Auswahlfeld Bezeichnung="@LabelTraeger" Eintraege="@_varianten"
                                                        Auswahl="@(_projektZeile is not null && _projektZeile.CarrierId > 0 ? _projektZeile.CarrierId : null)"
                                                        AuswahlChanged="BeiTraegerwechsel" />;

