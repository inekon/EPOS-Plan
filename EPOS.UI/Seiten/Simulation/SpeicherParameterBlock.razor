@* Die SPEICHERPARAMETER im Ergebnisreiter „Stromspeicher" (W11b‑B‑28,
   Sofortschreiben seit W11b‑B‑29).

   ANWENDERWUNSCH 10.09.2026 (Philipp Engelmann): „bringe den Tab Parameter →
   Stromspeicher aus Dialog ‚Detaillierte Simulation’ in den Tab ‚Stromspeicher’.
   Die Felder mit Parametern sollen änderbar sein (und die Möglichkeit die
   geänderten Parameter zu Speichern)."

   HERKUNFT. Der Inhalt ist das Blatt P3 des Reiters „Parameter"
   (ParameterReiter.razor, Vorläufer InitStromspeicherParameter :5690-5990) —
   Feld für Feld dasselbe, in derselben Reihenfolge, mit denselben Ressourcen.
   Dort ist es entfallen; die Parameter stehen jetzt bei den Zahlen, zu denen sie
   gehören, und der Optimierungsknopf mit ihnen.

   JEDES FELD SCHREIBT SOFORT — die Hausregel gilt auch hier (W11b‑B‑29,
   ANWENDERENTSCHEID 1 vom 10.09.2026: „Sofort schreiben, wie überall sonst im
   Programm."). W11b‑B‑28 hatte den Block als benannte AUSNAHME gebaut: Er
   sammelte in einer Arbeitskopie und schrieb auf Knopfdruck. Das ging schief,
   und zwar dreifach — der Knopf stand ganz unten und wurde nicht gefunden, der
   Puffer starb beim Reiterwechsel (Reiterblatt zeichnet nur das aktive Blatt,
   „@@if (Sichtbar)") und beim Schließen der Seite, und ein fehlgeschlagenes
   Update meldete trotzdem „gespeichert" (der Rückgabewert wurde weggeworfen).
   Der Datenbankbefund war eindeutig: Variantenzeile 14 des Projekts 1050 trug
   nach einer Sitzung voller Eingaben nur die Vorgabewerte.

   DAHER: Jede Änderung geht über Dienste.SpeicherfeldSchreiben SOFORT in die
   Datenbank, und die Statuszeile am KOPF des Blocks meldet jeden Schreibvorgang
   — auch seinen Fehlschlag. Geprüft wird VOR dem Schreiben, je Feld die Regel,
   die zu ihm gehört (SpeicherParameterPruefung im Kern, gerufen von der Hülle);
   der abgewiesene Wert bleibt im Feld stehen, damit der Anwender zu Ende tippen
   kann. Ohne Schreibdienst schreibt kein Feld — dann sind sie gesperrt, wie
   ohne Variante.

   EINSPALTIGER FORMULARRASTER wie im Herkunftsblatt (iU8‑E‑2, Paket P3): Unter
   mancher Zahl steht ihre Entsprechung („= 4,8 kWh") bzw. ein Hinweisabsatz, der
   zu dem Feld ÜBER ihm gehört; zweispaltig fiele beides neben ein fremdes Feld. *@

@namespace EPOS.UI.Seiten.Simulation
@using System.Globalization
@using WindowsFormsApplication1   @* DbWerte.SP_BERECHNUNG_NACHTNUTZUNG *@

<div class="epos-simerg-speicherparameter">

    @* DIE STATUSZEILE STEHT OBEN (W11b‑B‑29) — erst der Zustand („Aktive Variante:
       …"), dann die Rückmeldung des letzten Schreibvorgangs. Unten hat der
       Anwender sie nicht gefunden. *@
    <p class="@(Daten.VarianteVorhanden ? "epos-simerg-status" : "epos-simerg-status epos-simerg-warn")">@Daten.Variantenstatus</p>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <p class="@(_meldungWarnung ? "epos-simerg-status epos-simerg-warn" : "epos-simerg-status")">@_meldung</p>
    }

    @* DIE KNOPFZEILE, ebenfalls OBEN. „Kein Delegat ist kein Knopf" (Regel seit
       W2.2): ohne Sprungdelegat keine Optimierung. Speichern und Verwerfen gibt
       es nicht mehr — es ist nichts offen, was man speichern oder verwerfen
       könnte. *@
    @if (OptimierungMoeglich)
    {
        <div class="epos-simerg-knopfzeile">
            <button type="button" class="epos-simerg-knopf" @onclick="Optimierung" disabled="@Gesperrt"
                    title="@Resource.OPT_HINWEIS_ZIELFUNKTION">@Resource.OPT_BTN_OEFFNEN</button>
        </div>
    }

    <div class="epos-simerg-felder">
        <Formularraster Einspaltig="true">
            <KindInhalt>
                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_SOC_MIN" Wert="@Daten.SoCMinProzent"
                            Einheit="%" Aktiv="@Aktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.SoCMin, w, SoCMinGesetzt))" />
                <span class="epos-simerg-aequivalent">@Daten.SoCMinKwh</span>

                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_SOC_MAX" Wert="@Daten.SoCMaxProzent"
                            Einheit="%" Aktiv="@Aktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.SoCMax, w, SoCMaxGesetzt))" />
                <span class="epos-simerg-aequivalent">@Daten.SoCMaxKwh</span>

                @* GERÄTEGRÖSSE. Bis W11b‑B‑28 standen die beiden Felder in JEDEM Fall
                   gesperrt da (Befund W11-B10). Sie sind jetzt änderbar, aber nur bei
                   GENAU EINER Speicheranlage im Projekt: Varianten desselben Speichers
                   teilen sich EINE Gerätekopie, ein Schreibzugriff änderte sonst still
                   die Auslegung der Geschwister (dieselbe Grenze, die
                   StromspeicherSimCtrl.UebernehmeAuslegung zieht). Sie schreiben nicht
                   in die Variante, sondern in die Anlage — die Hülle nimmt dafür
                   denselben Weg wie die Auslegungsoptimierung. *@
                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_LADELEISTUNG"
                            Wert="@Daten.LadeleistungKw" Einheit="kW" Aktiv="@GeraetAktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.Leistung, w, v => Daten.LadeleistungKw = v))" />
                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_KAPAZITAET"
                            Wert="@Daten.KapazitaetKwh" Einheit="kWh" Aktiv="@GeraetAktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.Kapazitaet, w, KapazitaetGesetzt))" />

                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_LADESCHWELLE"
                            Wert="@Daten.Ladeschwellwert" Einheit="ct/kWh" Aktiv="@Aktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.Ladeschwelle, w, v => Daten.Ladeschwellwert = v))" />
            </KindInhalt>
        </Formularraster>
    </div>

    @if (!Daten.GeraetegroesseAenderbar)
    {
        <p class="epos-simerg-hinweis">@Resource.SP_PARAM_HINWEIS_LADELEISTUNG</p>
    }

    <Gruppenkopf Titel="@Resource.SP_PARAM_GRUPPE_BETRIEBSFUEHRUNG" />
    <div class="epos-simerg-felder">
        <Formularraster Einspaltig="true">
            <KindInhalt>
                <Auswahlfeld Bezeichnung="@Resource.SP_PARAM_LABEL_BETRIEBSART"
                             Eintraege="@Eintraege(Daten.Betriebsarten)"
                             Auswahl="@Index(Daten.Betriebsarten, Daten.Betriebsart)"
                             Aktiv="@Aktiv"
                             AuswahlChanged="@(i => Wahl(SpeicherFeld.Betriebsart, Daten.Betriebsarten, i, v => Daten.Betriebsart = v))" />

                <Auswahlfeld Bezeichnung="@Resource.SP_PARAM_LABEL_BERECHNUNGSART"
                             Eintraege="@Eintraege(Daten.Berechnungsarten)"
                             Auswahl="@Index(Daten.Berechnungsarten, Daten.Berechnungsart)"
                             Aktiv="@Aktiv"
                             AuswahlChanged="@(i => Wahl(SpeicherFeld.Berechnungsart, Daten.Berechnungsarten, i, BerechnungsartGesetzt))" />

                <Schalter Bezeichnung="@Resource.SP_PARAM_LABEL_KOMPATIBILITAET"
                          Wert="@Daten.Kompatibilitaet"
                          Aktiv="@(Aktiv && Daten.KompatibilitaetMoeglich)"
                          WertChanged="@(w => Schalten(SpeicherFeld.Kompatibilitaet, w, v => Daten.Kompatibilitaet = v))" />
            </KindInhalt>
        </Formularraster>
    </div>
    <p class="epos-simerg-hinweis">@Resource.SP_PARAM_HINWEIS_KOMPATIBILITAET</p>

    <Gruppenkopf Titel="@Resource.SP_PARAM_GRUPPE_QUELLEN" />
    <div class="epos-simerg-felder">
        <Formularraster Einspaltig="true">
            <KindInhalt>
                <Schalter Bezeichnung="@Resource.SP_PARAM_CHK_PV" Wert="@Daten.LadenAusPv" Aktiv="@Aktiv"
                          WertChanged="@(w => Schalten(SpeicherFeld.LadenPv, w, v => Daten.LadenAusPv = v))" />
                <Schalter Bezeichnung="@Resource.SP_PARAM_CHK_BHKW" Wert="@Daten.LadenAusBhkw" Aktiv="@Aktiv"
                          WertChanged="@(w => Schalten(SpeicherFeld.LadenBhkw, w, v => Daten.LadenAusBhkw = v))" />
                <Schalter Bezeichnung="@Resource.SP_PARAM_CHK_NETZENTLADUNG" Wert="@Daten.Netzentladung" Aktiv="@Aktiv"
                          WertChanged="@(w => Schalten(SpeicherFeld.Netzentladung, w, v => Daten.Netzentladung = v))" />
                @* Ausbaustufe 11: sichtbar, aber ohne Rechenweg — dauerhaft gesperrt. *@
                <Schalter Bezeichnung="@Resource.SP_PARAM_CHK_BHKW_STROMGEFUEHRT"
                          Wert="@Daten.BhkwStromgefuehrt" Aktiv="false" />
            </KindInhalt>
        </Formularraster>
    </div>
    <p class="epos-simerg-hinweis">@Resource.SP_PARAM_HINWEIS_AUSBAUSTUFE</p>

    <Gruppenkopf Titel="@Resource.SP_PARAM_GRUPPE_WIRTSCHAFT" />
    <div class="epos-simerg-felder">
        <Formularraster Einspaltig="true">
            <KindInhalt>
                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_KAPITALZINS" Wert="@Daten.Kapitalzins"
                            Einheit="%" Aktiv="@Aktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.Kapitalzins, w, v => Daten.Kapitalzins = v))" />
                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_NUTZUNGSDAUER" Wert="@Daten.Nutzungsdauer"
                            Einheit="a" Aktiv="@Aktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.Nutzungsdauer, w, v => Daten.Nutzungsdauer = v))" />
                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_LEISTUNGSPREIS" Wert="@Daten.Leistungspreis"
                            Einheit="€/(kW·a)" Aktiv="@Aktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.Leistungspreis, w, v => Daten.Leistungspreis = v))" />
                <Zahlenfeld Bezeichnung="@Resource.SP_PARAM_LABEL_NETZLADEAUFSCHLAG" Wert="@Daten.Netzladeaufschlag"
                            Einheit="ct/kWh" Aktiv="@Aktiv"
                            WertChanged="@(w => Zahl(SpeicherFeld.Netzladeaufschlag, w, v => Daten.Netzladeaufschlag = v))" />
            </KindInhalt>
        </Formularraster>
    </div>

    <Gruppenkopf Titel="@Resource.PREIS_PARAM_GRUPPE_PREISQUELLE" />
    <div class="epos-simerg-felder">
        <Formularraster Einspaltig="true">
            <KindInhalt>
                <Auswahlfeld Bezeichnung="@Resource.PREIS_PARAM_LABEL_PREISQUELLE"
                             Eintraege="@Eintraege(Daten.Preisquellen)"
                             Auswahl="@Index(Daten.Preisquellen, Daten.Preisquelle)"
                             Aktiv="@Aktiv"
                             AuswahlChanged="@(i => Wahl(SpeicherFeld.Preisquelle, Daten.Preisquellen, i, PreisquelleGesetzt))" />

                <Auswahlfeld Bezeichnung="@Daten.PreisreiheLabel" Eintraege="@Daten.Preisreihen"
                             Auswahl="@(Daten.PreisreiheId > 0 ? Daten.PreisreiheId : (int?)null)"
                             Aktiv="@(Aktiv && Daten.PreisreiheMoeglich)"
                             AuswahlChanged="PreisreiheGesetzt" />

                <Schalter Bezeichnung="@Resource.PREIS_PARAM_CHK_AUFSCHLAG" Wert="@Daten.Aufschlag" Aktiv="@Aktiv"
                          WertChanged="@(w => Schalten(SpeicherFeld.Aufschlag, w, v => Daten.Aufschlag = v))" />
            </KindInhalt>
        </Formularraster>
    </div>

    @if (!string.IsNullOrEmpty(Daten.Preisinfo))
    {
        <p class="@(Daten.PreisinfoWarnung ? "epos-simerg-hinweis epos-simerg-warn" : "epos-simerg-hinweis")">@Daten.Preisinfo</p>
    }

</div>

@code {
    /// <summary>Der gelesene Stand — und zugleich das, was der Anwender bearbeitet.</summary>
    [Parameter] public SpeicherParameterDaten Daten { get; set; } = new SpeicherParameterDaten();

    /// <summary>Die Datenseite; ohne Schreibdienst schreibt kein Feld.</summary>
    [Parameter] public SimulationErgebnisDienste? Dienste { get; set; }

    /// <summary>Gesperrt (Schemamigration) — die Felder bleiben sichtbar und lesbar.</summary>
    [Parameter] public bool Gesperrt { get; set; }

    /// <summary>Ruft die Auslegungsoptimierung (Überlagerung); ohne Delegat kein Knopf.</summary>
    [Parameter] public EventCallback Optimierung { get; set; }

    /// <summary>Zeigt die Auslegungsoptimierung an? Ohne Rechendelegat bleibt sie weg.</summary>
    [Parameter] public bool OptimierungMoeglich { get; set; }

    /// <summary>Die letzte Rückmeldung eines Schreibvorgangs (Prüfhilfe).</summary>
    public string Meldung => _meldung;

    private string _meldung = "";
    private bool _meldungWarnung;

    /// <summary>
    /// Ohne aktive Variante gäbe es kein Ziel für das Schreiben, ohne Schreibdienst
    /// keinen Weg dorthin — dann sind die Felder Attrappen.
    /// </summary>
    private bool Aktiv => !Gesperrt && Daten.VarianteVorhanden && Schreibbar;

    /// <summary>Die Gerätegröße zusätzlich nur bei genau einer Speicheranlage (siehe Markup).</summary>
    private bool GeraetAktiv => Aktiv && Daten.GeraetegroesseAenderbar;

    private bool Schreibbar => Dienste?.SpeicherfeldSchreiben is not null;

    // =====================================================================
    // Die Feldwege — sie merken UND schreiben, in dieser Reihenfolge
    // =====================================================================

    /// <summary>
    /// Ein Feld schreiben und die Rückmeldung in die Statuszeile stellen.
    /// </summary>
    /// <remarks>
    /// <b>Der Wert bleibt stehen, auch wenn die Prüfung ihn abweist.</b> Das Zahlenfeld
    /// meldet jede Taste (<c>@@oninput</c>) — die „8" auf dem Weg zur „85" ist ein
    /// Zwischenzustand, keine Fehleingabe. Die Meldung erscheint leise und verschwindet
    /// mit dem nächsten gültigen Wert; ein zurückgesetztes Feld dagegen risse dem
    /// Anwender die Eingabe unter den Fingern weg.
    /// </remarks>
    private void Schreiben(string feld, string wert)
    {
        if (Dienste?.SpeicherfeldSchreiben is null) return;

        Rueckmeldung antwort = Dienste.SpeicherfeldSchreiben(feld, wert);
        _meldung = antwort.Text;
        _meldungWarnung = !antwort.Erfolg;
    }

    private void Zahl(string feld, double? wert, Action<double> merken)
    {
        double w = wert ?? 0.0;
        merken(w);
        Schreiben(feld, w.ToString(CultureInfo.InvariantCulture));
    }

    private void Schalten(string feld, bool wert, Action<bool> merken)
    {
        merken(wert);
        Schreiben(feld, wert ? "1" : "0");
    }

    private void Wahl(string feld, IReadOnlyList<Steuerwahl> liste, int? index, Action<string> merken)
    {
        if (index is null || index < 0 || index >= liste.Count) return;

        string wert = liste[index.Value].Wert;
        merken(wert);
        Schreiben(feld, wert);
    }

    /// <summary>
    /// Der Kompatibilitätsmodus hängt an der Berechnungsart — dieselbe Regel, die die
    /// Hülle beim LESEN anwendet (nur bei Nachtnutzung). Sie muss hier mitlaufen, sonst
    /// bliebe der Schalter bis zum nächsten Lesen falsch gesperrt bzw. offen.
    /// </summary>
    private void BerechnungsartGesetzt(string wert)
    {
        Daten.Berechnungsart = wert;
        Daten.KompatibilitaetMoeglich =
            string.Equals(wert, DbWerte.SP_BERECHNUNG_NACHTNUTZUNG, StringComparison.Ordinal);
    }

    /// <summary>
    /// SoC-Minimum, SoC-Maximum und Kapazität ziehen die kWh-Äquivalente unter dem
    /// SoC-Band nach — sonst stünde darunter eine Zahl, die zu einem Prozentwert oder
    /// einem Gerät gehört, das der Anwender gerade weggeschrieben hat.
    /// </summary>
    private void SoCMinGesetzt(double wert)
    {
        Daten.SoCMinProzent = wert;
        AequivalenteNachziehen();
    }

    private void SoCMaxGesetzt(double wert)
    {
        Daten.SoCMaxProzent = wert;
        AequivalenteNachziehen();
    }

    private void KapazitaetGesetzt(double wert)
    {
        Daten.KapazitaetKwh = wert;
        AequivalenteNachziehen();
    }

    /// <summary>
    /// Der Wechsel der Preisquelle stellt Beschriftung UND Liste der Reihenauswahl um
    /// („Preisreihe" ↔ „Kostenprofil", beim Fixpreis leer und gesperrt). Geschrieben ist
    /// die Quelle da schon; die Liste ist eine reine ANZEIGEfrage. Ohne den Lesedienst
    /// bleibt sie, wie sie geliefert wurde — falsch beschriftet wäre schlimmer als
    /// unverändert.
    /// </summary>
    private void PreisquelleGesetzt(string wert)
    {
        Daten.Preisquelle = wert;

        SpeicherPreisreihenDaten? reihen = Dienste?.SpeicherPreisreihen?.Invoke(wert);
        if (reihen is null) return;

        Daten.PreisreiheLabel = reihen.Label;
        Daten.PreisreiheMoeglich = reihen.Moeglich;
        Daten.Preisreihen = reihen.Reihen;
        Daten.PreisreiheId = reihen.Id;
    }

    private void PreisreiheGesetzt(int? id)
    {
        Daten.PreisreiheId = id ?? 0;
        Schreiben(SpeicherFeld.Preisreihe,
                  Daten.PreisreiheId.ToString(CultureInfo.InvariantCulture));
    }

    // =====================================================================
    // Das kWh-Aequivalent des SoC-Bandes
    // =====================================================================

    /// <summary>
    /// Zieht die beiden Entsprechungen unter dem SoC-Band nach — mit derselben Formel
    /// und demselben Format wie <c>SimulationErgebnisHuelle.SoCText</c>, die sie beim
    /// Lesen setzt. Ohne Kapazität bleibt die Zeile leer statt eine Zahl zu erfinden.
    /// </summary>
    private void AequivalenteNachziehen()
    {
        Daten.SoCMinKwh = SoCText(Daten.SoCMinProzent);
        Daten.SoCMaxKwh = SoCText(Daten.SoCMaxProzent);
    }

    private string SoCText(double prozent)
    {
        if (Daten.KapazitaetKwh <= 0) return "";
        return string.Format(Resource.SP_PARAM_SOC_KWH,
                             (Daten.KapazitaetKwh * prozent / 100.0)
                                 .ToString("N1", CultureInfo.CurrentCulture));
    }

    // =====================================================================
    // Steuerwert <-> Listenplatz (Drei-Schichten-Regel)
    // =====================================================================

    private static IReadOnlyList<(int Id, string Text)> Eintraege(IReadOnlyList<Steuerwahl> liste)
    {
        var ergebnis = new List<(int, string)>(liste.Count);
        for (int i = 0; i < liste.Count; i++) ergebnis.Add((i, liste[i].Text));
        return ergebnis;
    }

    private static int? Index(IReadOnlyList<Steuerwahl> liste, string wert)
    {
        for (int i = 0; i < liste.Count; i++)
            if (string.Equals(liste[i].Wert, wert, StringComparison.Ordinal)) return i;
        return null;
    }
}
