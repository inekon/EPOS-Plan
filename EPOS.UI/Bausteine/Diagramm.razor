@* Der Rahmen, in dem JEDES Renderer-Bild steht (Windows-Abnahme 05.09.2026,
   Befund A-1: „Allgemein bei Charts: das Zoomen funktioniert nicht").

   WAS ER IST. Ein Rahmen mit Zoom. Im WinForms-Vorbild waren die Diagramme
   Chart-Steuerelemente mit Achsenzoom (Rad, aufgezogenes Rechteck, Rollbalken,
   Zuruecksetzen); seit iU7 zeichnet der Kern ein PNG, und W11b hat den Zoom
   ausdruecklich als Verlust festgehalten (A-7, Risiko R-W11-5). Dieser Baustein
   gibt ihn zurueck, in zwei Stufen:

     BILDZOOM   Rad, Kneifgeste, Ziehen, Doppelklick, + - 0. Er vergroessert das
                fertige Bild (CSS-Transform, kein Neuzeichnen) und gilt fuer
                JEDES Renderer-Bild - auch fuer Kuchen, Ringe und Kennlinien.

     DATENZOOM  Ein aufgezogenes Rechteck meldet seinen Ausschnitt nach oben;
                wer BereichGewaehlt bedient, laesst den Kern das Bild mit
                diesem Achsenbereich NEU zeichnen. Erst das macht 8 760 Stunden
                wirklich lesbar - vergroesserte Bildpunkte bleiben grob.
                Ohne Delegat gibt es den Knopf „Bereich" gar nicht.

   WARUM DER ZUSTAND IM BROWSER LIEGT. Verschieben und Vergroessern sind
   Bildpunktrechnungen, die zwanzigmal je Radbewegung anfallen. Sie durch die
   Interop-Bruecke zu schicken hiesse, fuer jede Rast einen Zeichenlauf der
   Komponente zu starten. Das Modul epos-diagramm.js haelt sie deshalb selbst
   und meldet nur die ANGEZEIGTE Stufe - und die nur, wenn sie sich aendert.

   WARUM ES OHNE JAVASCRIPT NICHT BRICHT. Laedt das Modul nicht (alte WebView,
   Pruefumgebung), steht das Bild da wie bisher. Die Anzeige „x1" und der Knopf
   „1:1" bleiben stehen und tun nichts - kein Fehlschlag, ein Schoenheitsfehler.

   DIE TEXTE STEHEN ALS PARAMETER mit deutschem Standardwert, nicht als
   Ressourcenschluessel: Der Baustein ist neu, und die Hausregel erlaubt den
   Literaltext so lange, bis die Huelle ihn auf einen Schluessel umstellt. *@

@namespace EPOS.UI.Bausteine
@using System.Globalization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="@Rahmenklasse">

    @* OHNE ZOOM KEINE LEISTE (Auftrag #222, Ausnahme zur Hausregel W8-E-2).
       Ein RING hat nichts zu zoomen: Er traegt fuenf Segmente, keine 8 760
       Stuetzstellen. Die Leiste „x1 · 1:1" darueber war deshalb Bedienflaeche
       ohne Gegenwert - und schlimmer: Auf x1,2 schnitt
       .epos-diagramm-flaeche { overflow: hidden } den Kreis an (Windows-Foto
       „Heinestr 15", rechte Grafik). Mit OhneZoom faellt die Leiste, und das
       JavaScript-Modul wird gar nicht erst gebunden. *@
    @if (!OhneZoom)
    {
        <div class="epos-diagramm-leiste">
            <span class="epos-diagramm-stufe" aria-live="polite">@Stufentext</span>

            @if (BereichGewaehlt.HasDelegate)
            {
                <button type="button" class="epos-diagramm-knopf" aria-pressed="@Bereichsmodus.ToString().ToLowerInvariant()"
                        title="@BereichHilfe" @onclick="BereichUmschalten">@BereichText</button>
            }

            <button type="button" class="epos-diagramm-knopf" title="@ZurueckHilfe"
                    @onclick="ZurueckGewaehlt">@ZurueckText</button>
        </div>
    }

    @* tabindex macht die Flaeche tastaturerreichbar (+ - 0); role="img" mit
       aria-label sagt der Sprachausgabe, was hier zu sehen ist. Ohne Zoom gibt
       es nichts zu bedienen - dann bleibt die Flaeche aus der Tabfolge. *@
    <div class="epos-diagramm-flaeche" @ref="_flaeche" tabindex="@(OhneZoom ? null : "0")"
         role="img" aria-label="@Bezeichnung">
        <div class="epos-diagramm-inhalt">@ChildContent</div>
        <div class="epos-diagramm-gummi" hidden></div>
    </div>

</div>

@code {
    /// <summary>Das Bild - ueblich ein <c>ChartBild</c>.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Was das Diagramm zeigt (<c>aria-label</c> der Flaeche).</summary>
    [Parameter] public string Bezeichnung { get; set; } = "";

    /// <summary>
    /// Der Anwender hat einen Bereich aufgezogen. OHNE Delegat bleibt es beim
    /// Bildzoom, und der Knopf „Bereich" erscheint nicht.
    /// </summary>
    [Parameter] public EventCallback<Diagrammbereich> BereichGewaehlt { get; set; }

    /// <summary>
    /// Der Knopf „1:1" wurde gedrueckt. Wer einen DATENZOOM fuehrt, verwirft hier
    /// seinen Achsenbereich - der eine Knopf stellt beides zurueck, den Bildzoom
    /// und den Ausschnitt. Doppelklick und Taste 0 stellen nur den Bildzoom
    /// zurueck; sie laufen im Browser und sollen ohne Zeichenlauf auskommen.
    /// </summary>
    [Parameter] public EventCallback Zurueckgesetzt { get; set; }

    /// <summary>Beschriftung des Knopfs, der auf 1:1 zurueckstellt.</summary>
    [Parameter] public string ZurueckText { get; set; } = "1:1";

    /// <summary>Sein Mouseover-Text.</summary>
    [Parameter] public string ZurueckHilfe { get; set; }
        = "Zurück zur vollen Ansicht (Doppelklick oder Taste 0)";

    /// <summary>Beschriftung des Umschalters „Bereich aufziehen".</summary>
    [Parameter] public string BereichText { get; set; } = "Bereich";

    /// <summary>Sein Mouseover-Text.</summary>
    [Parameter] public string BereichHilfe { get; set; }
        = "Einen Achsenbereich aufziehen (mit der Maus auch Umschalt + Ziehen)";

    /// <summary>
    /// Eine ZUSATZKLASSE am Rahmen — die MASSREGEL der Anzeige (Befund
    /// <b>W11b-B-4</b> der Windows-Abnahme V2 vom 07.09.2026). Sie sagt, welche
    /// GESTALT das Bild hat; wie breit eine Gestalt hoechstens erscheint, steht
    /// als EINE Regel im Stilblatt und nicht an dreissig Fundstellen.
    /// Heute gibt es genau eine: <c>epos-diagramm--rund</c> fuer Kuchen und Ring.
    /// </summary>
    [Parameter] public string Zusatzklasse { get; set; } = "";

    /// <summary>
    /// KEIN ZOOM an diesem Bild (Auftrag #222) — weder Leiste noch Rad, Ziehen,
    /// Kneifgeste oder Tasten.
    ///
    /// <para>Die Hausregel W8‑E‑2 („jedes Renderer-Bild steht im Baustein Diagramm
    /// und ist zoombar") bekommt damit ihre EINE Ausnahme: RING und KUCHEN. Sie
    /// tragen eine Handvoll Segmente statt 8 760 Stützstellen; ein Achsenausschnitt
    /// ist dort undenkbar, und ein vergrößerter Kreis sagt nichts, was der
    /// ungezoomte nicht sagt. Der Rahmen bleibt — die Regel „jedes Bild durch
    /// ChartBild" gilt unverändert, nur eben ohne Bedienung.</para>
    /// </summary>
    [Parameter] public bool OhneZoom { get; set; }

    /// <summary>Steht der Umschalter „Bereich" an? (Pruefhilfe)</summary>
    public bool Bereichsmodus => _bereich;

    /// <summary>Die Klasse des Rahmens — Hausklasse plus etwaige Zusatzklasse.</summary>
    private string Rahmenklasse => string.IsNullOrWhiteSpace(Zusatzklasse)
        ? "epos-diagramm"
        : "epos-diagramm " + Zusatzklasse.Trim();

    /// <summary>Die angezeigte Zoomstufe (Pruefhilfe).</summary>
    public double Stufe => _stufe;

    /// <summary>Die Zoomstufe als Text, z. B. „×2,5".</summary>
    private string Stufentext => "×" + _stufe.ToString("0.#", CultureInfo.CurrentCulture);

    private ElementReference _flaeche;
    private IJSObjectReference? _modul;
    private DotNetObjectReference<Diagramm>? _hilfe;
    private double _stufe = 1;
    private bool _bereich;

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || OhneZoom) return;

        try
        {
            _modul = await Js.InvokeAsync<IJSObjectReference>(
                "import", "./_content/EPOS.UI/epos-diagramm.js");
            _hilfe = DotNetObjectReference.Create(this);
            await _modul.InvokeVoidAsync("binden", _flaeche, _hilfe);
        }
        catch (Exception)
        {
            // Ohne das Modul bleibt das Bild starr - so wie vor dieser Welle.
            _modul = null;
        }
    }

    /// <summary>Das Modul meldet eine neue Zoomstufe (nur bei Aenderung).</summary>
    [JSInvokable]
    public Task ZoomGemeldet(double stufe)
    {
        _stufe = stufe;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Das Modul meldet ein aufgezogenes Rechteck. Danach steht das Bild wieder
    /// auf 1:1 - der Kern zeichnet es ja mit dem neuen Achsenbereich, ein
    /// zusaetzlicher Bildzoom waere doppelt.
    /// </summary>
    [JSInvokable]
    public async Task BereichGemeldet(double xVon, double xBis, double yVon, double yBis)
    {
        if (!BereichGewaehlt.HasDelegate) return;
        await BereichGewaehlt.InvokeAsync(new Diagrammbereich(xVon, xBis, yVon, yBis));
        await Zuruecksetzen();
    }

    /// <summary>Der Knopf „1:1": Bildzoom UND Achsenbereich zurueck.</summary>
    private async Task ZurueckGewaehlt()
    {
        await Zuruecksetzen();
        if (Zurueckgesetzt.HasDelegate) await Zurueckgesetzt.InvokeAsync();
    }

    /// <summary>Zurueck auf 1:1 - nur das Bild.</summary>
    private async Task Zuruecksetzen()
    {
        _stufe = 1;
        if (_modul is null) return;
        try { await _modul.InvokeVoidAsync("zuruecksetzen", _flaeche); }
        catch (Exception) { /* Die WebView ist schon weg. */ }
    }

    /// <summary>Schaltet das Aufziehen eines Rechtecks ein und aus.</summary>
    private async Task BereichUmschalten()
    {
        _bereich = !_bereich;
        if (_modul is null) return;
        try { await _modul.InvokeVoidAsync("bereichsmodus", _flaeche, _bereich); }
        catch (Exception) { /* Die WebView ist schon weg. */ }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        if (_modul is not null)
        {
            try
            {
                await _modul.InvokeVoidAsync("loesen", _flaeche);
                await _modul.DisposeAsync();
            }
            catch (Exception) { /* Die WebView ist schon weg. */ }
        }
        _hilfe?.Dispose();
    }
}
