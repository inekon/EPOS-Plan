610;7;I70=VdiIndex('700');
610;8;Ivon=VdiIWert('700',I70,'730',1,6);
610;9;B1=Ivon<1;
610;10;if(B1)then;
610;11;FTxT='Keine Daten zur Berechnung der Kesselbelastung vorhanden';
610;12;else;
610;13;Anzahl=VdiIWert('700',I70,'730',1,7);
610;14;IX=0;
610;15;OK=.TRUE.;
610;16;DO WHILE (OK);
610;17;IX=IX+1;
610;18;TVX(IX)=VDIRWERT('700',I70,'730',Ivon,5);
610;19;TRX(IX)=VDIRWERT('700',I70,'730',Ivon,6);
610;20;vonBELAST(IX)=VDIRWERT('700',I70,'730',Ivon,7);
610;21;bisBELAST(IX)=VDIRWERT('700',I70,'730',Ivon,8);
