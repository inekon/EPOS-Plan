@* Zeilendialog des Gesetzeskatalogs (iU9-W14c.1).

   VORBILD: Views/Admin/Form_GesetzparameterZeile.cs (258 Z.) und
   .Designer.cs (224 Z.) - 17 Steuerelemente, keine eigene .resx (Befund
   W14c-B2), kein Hilfeknopf (Befund W14c-B3, woertlich uebernommen).

   WOZU. Sieben Felder einer Zeile aus Tab_Gesetzesparameter: Schluessel,
   Bereich (Klasse), Gueltig ab, Wert, Einheit, Status, Quelle.

   ZWEI BETRIEBSARTEN. Neu und Aendern. BEIM AENDERN SIND SCHLUESSEL UND
   KLASSE GESPERRT: Sie sind die Identitaet der Reihe und in der Datenbank
   eingefroren - wer sie aendern will, legt eine neue Zeile an und loescht die
   alte.

   EIN LEERES WERTFELD IST KEIN NULLWERT. Es bedeutet "der Satz ist entfallen"
   (Verdraengungsstrommix ab 2027, Leitentscheidung L12) und wird als NULL
   gespeichert. Die graue Zeile unter dem Feld sagt das ausdruecklich - sie ist
   die einzige ihrer Art im ganzen Bestand.

   ER IST EINE UEBERLAGERUNG, KEIN FENSTER. Sein einziger Aufrufer ist der
   Gesetzeskatalog, und der ist seit W14c.2 selbst Blazor: zwei WebViews
   uebereinander sind Risiko R2 des Wellenplans.

   DIE DREI MESSAGEBOX WERDEN EIN WARNBANNER. Der Vorlaeufer prueft am
   OK-Knopf drei Dinge (Jahr, Wert, Schluessel) und meldet je mit einer
   modalen MessageBox. Hier steht die Meldung im Banner, und der Dialog bleibt
   offen - man sieht, was zu berichtigen ist, waehrend man es berichtigt.

   BEFUND W14c-B5, BEHOBEN: Die acht Klassen standen als Quelltextliste in
   dieser Maske - eine ZWEITE Quelle neben GesetzKatalog.Klassen() aus der
   Datenbank. Seit W14c.0a fuehrt der Katalog beide Listen: KlassenVorrat()
   (was man WAEHLEN kann) und Klassen() (was VORKOMMT).

   BEFUND W14c-B7, BEHOBEN: Schluessel-leer und Jahr 1990...2100 wurden hier
   UND in der Wirtsmaske geprueft. Geprueft wird jetzt EINMAL, ueber
   GesetzKatalog.Pruefe - der Dialog reicht die Frage als Delegat hinaus.

   BEFUND W14c-B8, WOERTLICH: Die Id wird nur durchgereicht; beim Anlegen ist
   sie 0, und Anlegen ignoriert sie ohnehin.

   DIE EINHEIT WIRD VORBELEGT (Anwenderentscheid 14.10.2026, Mockup
   Gesetzeskatalog_Einheit_Vorbelegung). Nur bei einer NEUEN Zeile und nur,
   solange der Anwender die Einheit nicht selbst gewaehlt hat. Die Regel steht im
   Kern (GesetzKatalog.EinheitVorschlagen): ein bestehender Schluessel gibt die
   Einheit seiner juengsten Zeile (Bereich und Quelle ebenso, solange nicht
   selbst gewaehlt), ein neuer die haeufigste Einheit seines Bereichs, sonst
   bleibt das Feld leer und ist Pflicht. Die Daten reicht der Wirt herein
   (Vorschlagsdaten); der Dialog fragt keine Datenbank. Eine eigene Wahl gewinnt
   gegen jeden spaeteren Wechsel von Bereich oder Schluessel; "Vorschlag
   uebernehmen" holt den Vorschlag zurueck. Ohne Bereich oder Einheit ist OK
   weich gesperrt, der Grund steht am Knopf - ein stilles "-" gibt es fuer eine
   neue Zeile nicht mehr. Beim Aendern bleibt die gespeicherte Einheit.

   DIE SCHLUESSELVORSCHLAEGE sind Knoepfe unter dem Feld, kein <datalist>
   (Hausregel EPOS.UI): Sie erscheinen beim Tippen eines Schluessels, der noch
   nicht genau einem bestehenden entspricht.

   TASTATUR: Esc bricht ab. Enter ist nicht belegt - der Dialog schreibt zwar
   nicht selbst, aber sein OK loest im Wirt sofort einen Schreibvorgang aus. *@

@namespace EPOS.UI.Dialoge.Wirtschaftlichkeit
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-gesetz-zeile" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: dieser Dialog steht ausschliesslich als Ueberlagerung im
       Gesetzeskatalog, und DIE traegt Titel und Schliesskreuz schon (Anwenderentscheid
       15.09.2026) - ein eigener Kopf haette "Neu"/"Ändern" zweimal uebereinander stehen
       und zwei Kreuze gezeigt. *@

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_meldung" />
    }

    @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben dem Feld,
       Zahlenfelder kurz. Der Raster ist GETEILT, weil die Herleitungszeile mitten
       im Feldlauf steht - sie ist ein Satz und fiele in einer Rasterzelle auf
       halbe Breite; beide Raster tragen dieselbe Beschriftungsspalte. *@
    <Formularraster>
        <KindInhalt>
            @* Schluessel und Klasse: beim Aendern gesperrt, beim Anlegen frei. *@
            <Textfeld Bezeichnung="@LabelSchluessel" Wert="@_schluessel" WertChanged="BeiSchluessel"
                      Hoechstlaenge="60" NurLesen="@(!IstNeu)" />

            @if (SchluesselTreffer.Count > 0)
            {
                <p class="epos-herleitung epos-gesetz-schluesselvorschlaege">
                    <span class="epos-herleitung-text">@TextSchluesselVorhanden</span>
                    @foreach (string treffer in SchluesselTreffer)
                    {
                        <button type="button" class="epos-knopf epos-vorschlag" @key="treffer"
                                @onclick="() => BeiSchluessel(treffer)">@treffer</button>
                    }
                </p>
            }

            <Auswahlfeld Bezeichnung="@LabelKlasse" Eintraege="@KlassenEintraege"
                         Auswahl="@_klasseIndex" AuswahlChanged="BeiKlasseGewaehlt" Aktiv="@IstNeu"
                         Platzhalter="@(IstNeu && _klasseIndex is null ? PlatzhalterWaehlen : null)" />

            <Ganzzahlfeld Bezeichnung="@LabelJahr" Wert="@_jahr" WertChanged="BeiJahr"
                          Min="@GesetzKatalog.JAHR_MIN" Max="@GesetzKatalog.JAHR_MAX"
                          Feldname="@LabelJahr" FehlerZustand="BeiFehler" />

            <Zahlenfeld Bezeichnung="@LabelWert" Wert="@_wert" WertChanged="BeiWert"
                        Feldname="@LabelWert" FehlerZustand="BeiFehler" />
        </KindInhalt>
    </Formularraster>

    <Herleitungszeile Text="@HinweisWertLeer" />

    <Formularraster>
        <KindInhalt>
            <Auswahlfeld Bezeichnung="@LabelEinheit" Eintraege="@EinheitEintraege"
                         Auswahl="@Stelle(Einheiten, WirksameEinheit)" AuswahlChanged="BeiEinheit"
                         Platzhalter="@(IstNeu ? PlatzhalterWaehlen : null)" />

            @if (IstNeu)
            {
                GesetzEinheitVorschlag vorschlag = Vorschlag;
                if (_einheitGewaehlt)
                {
                    if (vorschlag.Einheit.Length > 0 &&
                        !string.Equals(vorschlag.Einheit, WirksameEinheit, StringComparison.Ordinal))
                    {
                        <Vorschlagszeile Text="@TextIhreWahl"
                                         Knopftext="@string.Format(TextVorschlagUebernehmen, vorschlag.Einheit)"
                                         Uebernommen="VorschlagUebernehmen" />
                    }
                    else
                    {
                        <p class="epos-herleitung epos-gesetz-einheit-hinweis">
                            <span class="epos-herleitung-text">@TextIhreWahl</span>
                        </p>
                    }
                }
                else
                {
                    <p class="epos-herleitung epos-gesetz-einheit-hinweis@(vorschlag.Einheit.Length == 0 ? " epos-gesetz-einheit-hinweis--pflicht" : "")">
                        <span class="epos-herleitung-text">@EinheitHinweis(vorschlag)</span>
                    </p>
                }
            }

            <Auswahlfeld Bezeichnung="@LabelStatus" Eintraege="@StatusEintraege"
                         Auswahl="@_statusIndex" AuswahlChanged="BeiStatus" />

            <Textfeld Bezeichnung="@LabelQuelle" Wert="@_quelle" WertChanged="BeiQuelle"
                      Hoechstlaenge="120" />
        </KindInhalt>
    </Formularraster>

    <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText"
                     OkErlaubt="@(!_fehlerhaft)" OkSperrgrund="@Sperrgrund" Ergebnis="BeiLeiste" />
</div>

@code {
    /// <summary>
    /// Die sieben Werte einer Zeile, wie der Dialog sie liefert.
    ///
    /// <para><b>Warum ein eigener Traeger und nicht <c>GesetzParameter</c>:</b> Eine
    /// Komponente kennt die Fachklassen des Kerns nicht (EPOS.UI/CLAUDE.md). Der Wirt
    /// bildet die sieben Werte auf <c>GesetzKatalog.Anlegen</c> bzw. <c>.Aendern</c>
    /// ab — das ist seine Aufgabe, nicht die des Dialogs.</para>
    /// </summary>
    public sealed record Zeilenwerte(int Id, string Schluessel, string Klasse, int JahrVon,
                                     double? Wert, string Einheit, string Status, string Quelle);

    // =====================================================================
    // Parameter
    // =====================================================================

    /// <summary>Betriebsart: <c>true</c> = Neu (Schlüssel und Klasse frei), sonst Ändern.</summary>
    [Parameter] public bool IstNeu { get; set; }

    /// <summary>Die Id der bearbeiteten Zeile; 0 beim Anlegen (Befund W14c-B8).</summary>
    [Parameter] public int Id { get; set; }

    /// <summary>Vorbelegung: der Schlüssel.</summary>
    [Parameter] public string Schluessel { get; set; } = "";

    /// <summary>Vorbelegung: die Klasse als DB-Wert.</summary>
    [Parameter] public string Klasse { get; set; } = "";

    /// <summary>Vorbelegung: das Gültig-ab-Jahr.</summary>
    [Parameter] public int JahrVon { get; set; }

    /// <summary>Vorbelegung: der Wert; <c>null</c> = der Satz ist entfallen.</summary>
    [Parameter] public double? Wert { get; set; }

    /// <summary>Vorbelegung: die Einheit als DB-Wert.</summary>
    [Parameter] public string Einheit { get; set; } = "";

    /// <summary>Vorbelegung: der Status als DB-Wert.</summary>
    [Parameter] public string Status { get; set; } = "";

    /// <summary>Vorbelegung: die Quelle.</summary>
    [Parameter] public string Quelle { get; set; } = "";

    /// <summary>
    /// Die wählbaren Klassen als (DB-Wert, Anzeigename) — aus
    /// <c>GesetzKatalog.KlassenVorrat()</c> und <c>KlasseAnzeige()</c>. <b>Kein
    /// Anzeigetext ist je Steuerwert.</b>
    /// </summary>
    [Parameter] public IReadOnlyList<(string Wert, string Anzeige)> Klassen { get; set; }
        = Array.Empty<(string, string)>();

    /// <summary>Die fünfzehn Einheiten (DB-Werte, sie sind zugleich der Anzeigetext).</summary>
    [Parameter] public IReadOnlyList<string> Einheiten { get; set; } = Array.Empty<string>();

    /// <summary>Die Statuswerte (<c>GesetzKatalog.Statuswerte</c>, vier samt ABGEKUENDIGT).</summary>
    [Parameter] public IReadOnlyList<string> Statuswerte { get; set; } = Array.Empty<string>();

    /// <summary>
    /// Die Vorschlagsdaten der Einheit (<c>GesetzKatalog.Vorschlagsdaten</c>): je
    /// Schlüssel die jüngste Zeile, je Bereich die häufigste Einheit. Ohne Gabe gibt es
    /// keinen Vorschlag — die Einheit ist dann bei einer neuen Zeile Pflicht.
    /// </summary>
    [Parameter] public GesetzVorschlagsdaten Vorschlagsdaten { get; set; } = GesetzVorschlagsdaten.Leer;

    /// <summary>
    /// Die Prüfung vor dem Schließen (<c>GesetzKatalog.Pruefe</c>): leerer Text = in
    /// Ordnung, sonst der Meldungstext. <b>Sie läuft genau einmal</b> — die Wirtsmaske
    /// prüft nicht noch einmal (Befund W14c-B7).
    /// </summary>
    [Parameter] public Func<Zeilenwerte, Task<string>>? Pruefen { get; set; }

    /// <summary>Das Ergebnis; <c>null</c> = abgebrochen.</summary>
    [Parameter] public EventCallback<Zeilenwerte?> Geschlossen { get; set; }

    // =====================================================================
    // Texte
    // =====================================================================

    [Parameter] public string TitelNeu { get; set; } = Resource.GESETZ_DLG_TITEL_NEU;
    [Parameter] public string TitelAendern { get; set; } = Resource.GESETZ_DLG_TITEL_AENDERN;
    [Parameter] public string LabelSchluessel { get; set; } = Resource.GESETZ_SP_SCHLUESSEL;
    [Parameter] public string LabelKlasse { get; set; } = Resource.GESETZ_LBL_KLASSE;
    [Parameter] public string LabelJahr { get; set; } = Resource.GESETZ_SP_JAHRVON;
    [Parameter] public string LabelWert { get; set; } = Resource.GESETZ_SP_WERT;
    [Parameter] public string HinweisWertLeer { get; set; } = Resource.GESETZ_LBL_WERT_LEER;
    [Parameter] public string LabelEinheit { get; set; } = Resource.GESETZ_SP_EINHEIT;
    [Parameter] public string LabelStatus { get; set; } = Resource.GESETZ_SP_STATUS;
    [Parameter] public string LabelQuelle { get; set; } = Resource.GESETZ_SP_QUELLE;
    [Parameter] public string OkText { get; set; } = Resource.SIM_BTN_OK;
    // W-E2 (Mockup-Prüfung 04): Abbrechen ist ein Hausknopf — kein eigener,
    // gleichlautender Schlüssel je Dialog; GESETZ_BTN_ABBRECHEN bleibt in der .resx stehen.
    [Parameter] public string AbbrechenText { get; set; } = Resource.ALLG_BTN_ABBRECHEN;
    [Parameter] public string PlatzhalterWaehlen { get; set; } = Resource.GESETZ_PLATZHALTER_WAEHLEN;
    [Parameter] public string TextSchluesselVorhanden { get; set; } = Resource.GESETZ_SCHLUESSEL_VORHANDEN;
    [Parameter] public string VorlageHinweisSchluessel { get; set; } = Resource.GESETZ_EINHEIT_HINWEIS_SCHLUESSEL;
    [Parameter] public string VorlageHinweisBereich { get; set; } = Resource.GESETZ_EINHEIT_HINWEIS_BEREICH;
    [Parameter] public string VorlagePflichtWechsel { get; set; } = Resource.GESETZ_EINHEIT_PFLICHT_WECHSEL;
    [Parameter] public string TextPflichtBereich { get; set; } = Resource.GESETZ_EINHEIT_PFLICHT_BEREICH;
    [Parameter] public string TextPflichtOhne { get; set; } = Resource.GESETZ_EINHEIT_PFLICHT_OHNE;
    [Parameter] public string TextIhreWahl { get; set; } = Resource.GESETZ_EINHEIT_IHRE_WAHL;
    [Parameter] public string TextVorschlagUebernehmen { get; set; } = Resource.GESETZ_EINHEIT_VORSCHLAG_UEBERNEHMEN;
    [Parameter] public string TextSperreBereich { get; set; } = Resource.GESETZ_SPERRE_BEREICH;
    [Parameter] public string TextSperreEinheit { get; set; } = Resource.GESETZ_SPERRE_EINHEIT;

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private string _schluessel = "";
    private string _quelle = "";
    private int? _jahr;
    private double? _wert;
    private int? _klasseIndex;
    private int? _einheitIndex;
    private int? _statusIndex;

    // Die drei Wahlen des Anwenders (nur bei einer neuen Zeile von Belang): Was er
    // selbst gewählt hat, überschreibt kein Vorschlag mehr.
    private bool _einheitGewaehlt;
    private bool _klasseGewaehlt;
    private bool _quelleGewaehlt;

    private string _meldung = "";
    private readonly HashSet<string> _fehlerFelder = new();
    private bool _fehlerhaft => _fehlerFelder.Count > 0;

    /// <summary>Der Fenstertitel je Betriebsart.</summary>
    private string Titel => IstNeu ? TitelNeu : TitelAendern;

    /// <summary>Der Meldungstext des Banners (Prüfhilfe für Tests).</summary>
    public string Meldung => _meldung;

    private IReadOnlyList<(int Id, string Text)> KlassenEintraege =>
        Klassen.Select((k, i) => (i, k.Anzeige)).ToList();

    private IReadOnlyList<(int Id, string Text)> EinheitEintraege =>
        Einheiten.Select((e, i) => (i, e)).ToList();

    private IReadOnlyList<(int Id, string Text)> StatusEintraege =>
        Statuswerte.Select((s, i) => (i, s)).ToList();

    protected override void OnParametersSet()
    {
        if (!_ersterAufbau) return;

        _kiMaske ??= KiMaskenanmeldung.Fuer(KiMaskennamen.GESETZESKATALOG_ZEILE,
                                            () => KiSicht(), KiHaken());

        _schluessel = Schluessel ?? "";
        _quelle = Quelle ?? "";
        _jahr = JahrVon;
        _wert = Wert;
        _statusIndex = Suchen(Statuswerte, Status);

        if (IstNeu)
        {
            // Eine neue Zeile hat keinen Rückfall auf den ersten Eintrag: Ein unbekannter
            // Bereich bleibt ungewählt, eine hereingereichte Einheit gilt als Wahl.
            _klasseIndex = Stelle(KlassenWerte, Klasse);
            _einheitIndex = Stelle(Einheiten, Einheit);
            _einheitGewaehlt = _einheitIndex.HasValue;
            SchluesselNachziehen();
        }
        else
        {
            _klasseIndex = Suchen(KlassenWerte, Klasse);
            _einheitIndex = Suchen(Einheiten, Einheit);
        }
    }

    private IReadOnlyList<string> KlassenWerte => Klassen.Select(k => k.Wert).ToList();

    /// <summary>Der DB-Wert des gewählten Bereichs; leer, wenn keiner gewählt ist.</summary>
    private string KlasseWert => _klasseIndex is int ki && ki >= 0 && ki < Klassen.Count ? Klassen[ki].Wert : "";

    /// <summary>Der Anzeigename des gewählten Bereichs.</summary>
    private string KlasseAnzeigename => _klasseIndex is int ki && ki >= 0 && ki < Klassen.Count ? Klassen[ki].Anzeige : "";

    /// <summary>Der Vorschlag der Kernregel; beim Ändern keiner.</summary>
    private GesetzEinheitVorschlag Vorschlag => IstNeu
        ? GesetzKatalog.EinheitVorschlagen(_schluessel, KlasseWert, Vorschlagsdaten)
        : GesetzEinheitVorschlag.Keiner;

    /// <summary>
    /// Die Einheit, die gilt: beim Ändern und nach eigener Wahl die gewählte, sonst der
    /// Vorschlag — und nur, wenn er in der Liste der Einheiten steht.
    /// </summary>
    private string WirksameEinheit
    {
        get
        {
            if (!IstNeu || _einheitGewaehlt) return Eintrag(Einheiten, _einheitIndex);
            string v = Vorschlag.Einheit;
            return Stelle(Einheiten, v).HasValue ? v : "";
        }
    }

    /// <summary>Warum OK gesperrt ist — erst der Bereich, dann die Einheit; <c>null</c> = frei.</summary>
    private string? Sperrgrund
    {
        get
        {
            if (!IstNeu) return null;
            if (KlasseWert.Length == 0) return TextSperreBereich;
            if (WirksameEinheit.Length == 0) return TextSperreEinheit;
            return null;
        }
    }

    /// <summary>Der Hinweis unter der Einheit, solange der Anwender nicht selbst gewählt hat.</summary>
    private string EinheitHinweis(GesetzEinheitVorschlag v)
    {
        switch (v.Herkunft)
        {
            case GesetzEinheitHerkunft.Schluessel when v.Stand is not null:
                return string.Format(VorlageHinweisSchluessel, v.Stand.Schluessel,
                                     v.Stand.JahrVon.ToString(System.Globalization.CultureInfo.InvariantCulture));
            case GesetzEinheitHerkunft.Bereich:
                return string.Format(VorlageHinweisBereich, KlasseAnzeigename);
            case GesetzEinheitHerkunft.EinheitWechselt:
                return string.Format(VorlagePflichtWechsel, KlasseAnzeigename);
            default:
                return KlasseWert.Length > 0 ? TextPflichtBereich : TextPflichtOhne;
        }
    }

    /// <summary>
    /// Die bestehenden Schlüssel, die zum Getippten passen (höchstens sechs) — leer,
    /// solange nichts getippt ist oder der Schlüssel genau einem bestehenden entspricht.
    /// </summary>
    private IReadOnlyList<string> SchluesselTreffer
    {
        get
        {
            string s = (_schluessel ?? "").Trim();
            if (!IstNeu || s.Length == 0 || Vorschlagsdaten.Stand(s) is not null)
                return Array.Empty<string>();
            return Vorschlagsdaten.Schluessel
                .Select(z => z.Schluessel)
                .Where(z => z.Contains(s, StringComparison.OrdinalIgnoreCase))
                .Take(SCHLUESSELTREFFER_HOECHSTENS)
                .ToList();
        }
    }

    private const int SCHLUESSELTREFFER_HOECHSTENS = 6;

    /// <summary>
    /// Ein bestehender Schlüssel bringt Bereich und Quelle seiner jüngsten Zeile mit —
    /// nur bei einer neuen Zeile und nur, was der Anwender nicht selbst gewählt hat.
    /// </summary>
    private void SchluesselNachziehen()
    {
        if (!IstNeu) return;
        GesetzSchluesselStand? stand = Vorschlagsdaten.Stand(_schluessel);
        if (stand is null) return;
        if (!_klasseGewaehlt)
        {
            int? stelle = Stelle(KlassenWerte, stand.Klasse);
            if (stelle.HasValue) _klasseIndex = stelle;
        }
        if (!_quelleGewaehlt) _quelle = stand.Quelle;
    }

    /// <summary>
    /// Der Index eines DB-Werts in seiner Liste; ohne Treffer der erste Eintrag —
    /// dieselbe Rückfallregel wie <c>WaehleText</c> des Vorläufers.
    /// </summary>
    private static int? Suchen(IReadOnlyList<string> liste, string wert)
    {
        for (int i = 0; i < liste.Count; i++)
            if (string.Equals(liste[i], wert, StringComparison.Ordinal)) return i;
        return liste.Count > 0 ? 0 : (int?)null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    // =====================================================================
    // Eingaben
    // =====================================================================

    // =============================================================================
    // Der Hilfe-Assistent (Welle KI-F4)
    // =============================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GesetzeskatalogZeileKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die sieben lebenden Felder des Editors. Ein
    /// Daten-Objekt gibt es nicht — <c>Zeilenwerte</c> entsteht erst beim OK.
    /// </summary>
    private GesetzeskatalogZeileKiSicht KiSicht()
    {
        return _kiSicht ??= new GesetzeskatalogZeileKiSicht
        {
            SchluesselLesen = () => _schluessel,
            SchluesselSetzen = BeiSchluessel,

            KlasseLesen = () => _klasseIndex.HasValue && _klasseIndex.Value < Klassen.Count
                              ? Klassen[_klasseIndex.Value].Wert : "",
            KlasseSetzen = KiKlasse,
            KlassenEintraege = () => KiMaskenanmeldung.Eintraege(
                Klassen, z => z.Wert, z => z.Anzeige),

            JahrLesen = () => _jahr,
            JahrSetzen = BeiJahr,
            WertLesen = () => _wert,
            WertSetzen = BeiWert,

            EinheitLesen = () => WirksameEinheit,
            EinheitSetzen = wert => BeiEinheit(Stelle(Einheiten, wert)),
            EinheitEintraege = () => KiMaskenanmeldung.Eintraege(
                Einheiten, z => z, z => z),

            StatusLesen = () => Eintrag(Statuswerte, _statusIndex),
            StatusSetzen = wert => _statusIndex = Stelle(Statuswerte, wert),
            StatusEintraege = () => KiMaskenanmeldung.Eintraege(
                Statuswerte, z => z, z => z),

            QuelleLesen = () => _quelle,
            QuelleSetzen = BeiQuelle
        };
    }

    /// <summary>Der Text einer Liste an der Stelle; leer, wenn es sie nicht gibt.</summary>
    private static string Eintrag(IReadOnlyList<string> liste, int? stelle)
        => stelle.HasValue && stelle.Value >= 0 && stelle.Value < liste.Count
               ? liste[stelle.Value] : "";

    /// <summary>Die Stelle eines Textes in der Liste; <c>null</c>, wenn er fehlt.</summary>
    private static int? Stelle(IReadOnlyList<string> liste, string? wert)
    {
        for (int i = 0; i < liste.Count; i++)
            if (string.Equals(liste[i], wert, StringComparison.Ordinal)) return i;
        return null;
    }

    /// <summary>Die Klasse über ihren Steuerwert setzen — nur bei einer Neuanlage.</summary>
    private void KiKlasse(string wert)
    {
        for (int i = 0; i < Klassen.Count; i++)
        {
            if (!string.Equals(Klassen[i].Wert, wert, StringComparison.Ordinal)) continue;
            BeiKlasseGewaehlt(i);
            return;
        }
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> Der Editor meldet seine Zeile an den Katalog; der
    /// schreibt sie mit seinem eigenen Weg.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    private void BeiSchluessel(string text) { _schluessel = text ?? ""; _meldung = ""; SchluesselNachziehen(); }
    private void BeiKlasseGewaehlt(int? index) { _klasseIndex = index; _klasseGewaehlt = true; _meldung = ""; }
    private void BeiQuelle(string text) { _quelle = text ?? ""; _quelleGewaehlt = true; }
    private void BeiJahr(int? jahr) { _jahr = jahr; _meldung = ""; }
    private void BeiWert(double? wert) { _wert = wert; _meldung = ""; }
    /// <summary>
    /// Die Einheit wählen: beim Ändern einfach gesetzt; bei einer neuen Zeile ist jede
    /// Einheit eine Wahl, der Platzhalter nimmt die Wahl zurück und gibt den Vorschlag frei.
    /// </summary>
    private void BeiEinheit(int? index)
    {
        _einheitIndex = index;
        if (IstNeu) _einheitGewaehlt = index.HasValue;
        _meldung = "";
    }

    /// <summary>„Vorschlag übernehmen": die eigene Wahl verwerfen, der Vorschlag gilt wieder.</summary>
    private void VorschlagUebernehmen()
    {
        _einheitGewaehlt = false;
        _einheitIndex = null;
    }
    private void BeiStatus(int? index) { _statusIndex = index; }

    /// <summary>
    /// Ein Zahlenfeld meldet seinen Fehlerzustand mit NAMEN (seit W6.1) — solange
    /// eines fehlerhaft ist, bleibt „OK" gesperrt.
    /// </summary>
    private void BeiFehler((string Feld, bool Fehlerhaft) f)
    {
        if (f.Fehlerhaft) _fehlerFelder.Add(f.Feld); else _fehlerFelder.Remove(f.Feld);
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private async Task BeiLeiste(bool ok)
    {
        if (!ok) { await Geschlossen.InvokeAsync(null); return; }

        // Die weiche Sperre meldet den Versuch (Hausregel: der Grund steht am Knopf).
        string? sperre = Sperrgrund;
        if (sperre is not null) { _meldung = sperre; return; }

        Zeilenwerte werte = Sammeln();

        if (Pruefen is not null)
        {
            string fehler = await Pruefen(werte);
            if (!string.IsNullOrEmpty(fehler)) { _meldung = fehler; return; }
        }

        await Geschlossen.InvokeAsync(werte);
    }

    /// <summary>
    /// Die sieben Werte. Eine neue Zeile kommt nur mit Bereich und Einheit hierher (die
    /// Sperre davor) und nimmt die WIRKSAME Einheit — Wahl oder Vorschlag; einen stillen
    /// Rückfall auf <c>-</c> gibt es für sie nicht. Beim Ändern bleiben die Rückfälle des
    /// Vorläufers: ohne Klassenwahl <c>KWKG</c>, ohne Einheit <c>-</c>, ohne Status
    /// <c>GESICHERT</c>.
    /// </summary>
    private Zeilenwerte Sammeln()
    {
        string klasse = _klasseIndex is int ki && ki >= 0 && ki < Klassen.Count
            ? Klassen[ki].Wert : DbWerte.GESETZ_KLASSE_KWKG;
        string einheit = IstNeu
            ? WirksameEinheit
            : _einheitIndex is int ei && ei >= 0 && ei < Einheiten.Count
                ? Einheiten[ei] : DbWerte.GESETZ_EINHEIT_OHNE;
        string status = _statusIndex is int si && si >= 0 && si < Statuswerte.Count
            ? Statuswerte[si] : DbWerte.GESETZ_STATUS_GESICHERT;

        // Beim Aendern bleiben Schluessel und Klasse, was sie waren - die Felder sind
        // gesperrt, aber der Traeger soll trotzdem den richtigen Wert fuehren.
        return new Zeilenwerte(
            Id,
            IstNeu ? (_schluessel ?? "").Trim() : (Schluessel ?? "").Trim(),
            IstNeu ? klasse : (Klasse ?? ""),
            _jahr ?? 0,
            _wert,
            einheit,
            status,
            (_quelle ?? "").Trim());
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        return e.Key == "Escape" ? Geschlossen.InvokeAsync(null) : Task.CompletedTask;
    }
}
