    /// <summary>
    /// Die PV-Module des KATALOGS für die Modulspalte der Strangtabelle
    /// (<b>W6‑O‑6</b>): Id = <c>Tab_PV_STAMM.ID</c>. Die Klappliste je Strang zeigt
    /// davon nur die PROJEKTMODULE (<see cref="ProjektmoduleFuerStraenge"/>).
    /// </summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Strangmodule { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>
    /// Die Module, die die Strangtabelle anbietet: <b>nur die dem Projekt
    /// zugeordneten</b> (Anwenderwunsch 26.09.2026, wörtlich „nur die dem Projekt
    /// zugeordneten auswählbar") — je Projektzeile ihr Modul (<c>ID_PV</c> ist die
    /// STAMM-Id, <see cref="ErzeugerZeile.GeraetId"/>), in der Reihenfolge der
    /// Projektliste, jedes Modul einmal. Der Text kommt aus dem Katalog
    /// (<see cref="Strangmodule"/>); führt der ihn nicht (neu angelegter Satz), steht der
    /// Bezeichner der Zeile. Gerechnet wird bei jedem Zeichnen aus <see cref="Zeilen"/> —
    /// ordnet der Anwender ein Modul zu oder entfernt eines, folgt die Liste im selben
    /// Arbeitsstand.
    /// </summary>
    internal IReadOnlyList<(int Id, string Text)> ProjektmoduleFuerStraenge()
    {
        var liste = new List<(int, string)>();
        var ids = new HashSet<int>();
        var namen = new HashSet<string>(StringComparer.Ordinal);

        foreach (ErzeugerZeile z in Zeilen)
        {
            int id = z.GeraetId;
            string text = z.Bezeichner ?? "";

            // Das Katalogband ist die Id; ohne Id (Altbestand) hilft der Bezeichner.
            foreach (var m in Strangmodule)
            {
                if (id > 0 ? m.Id == id
                           : string.Equals(m.Text, text, StringComparison.Ordinal))
                {
                    id = m.Id;
                    text = m.Text;
                    break;
                }
            }

            if (id <= 0 || text.Length == 0) continue;
            if (!ids.Add(id) || !namen.Add(text)) continue;
            liste.Add((id, text));
        }
        return liste;
    }

