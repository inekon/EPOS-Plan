    /// Ueberlagerung der Wirtschaftlichkeitsseite tut es, die Ansicht der Wurzel
    /// nicht; weil „das Kreuz beim Titel steht", traegt dann sie auch das Kreuz.</summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

