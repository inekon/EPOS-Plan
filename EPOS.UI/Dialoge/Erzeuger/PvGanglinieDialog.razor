    public GanglinieKatalogseite? Katalogseite => _seite;

    private IEnumerable<string> ProjektBezeichner() => Zeilen.Select(z => z.Bezeichner);

    // =================================================================================
    // Projektkopie und Katalog (E113)
    // =================================================================================

    /// <summary>
    /// Die Abweichung je Name, einmal gefragt (die Hülle fragt die Datenbank) und erst nach einer Katalogänderung
    /// oder einer Erneuerung neu.
    /// </summary>
    private readonly Dictionary<string, string> _abweichung = new(StringComparer.Ordinal);

    private bool _erneuernOffen;
    private string _erneuernZiel = "";
    private string _erneuernAbweichung = "";
    private string _erneuernFehler = "";
    private string _erneuernStatus = "";

    /// <summary>Steht die Rückfrage „Aus dem Katalog erneuern"? (Prüfhilfe.)</summary>
    public bool ErneuernOffen => _erneuernOffen;

    /// <summary>Die Abweichung der markierten Projektzeile; leer ohne und bei einer ungespeicherten Zeile. (Prüfhilfe.)</summary>
    public string ProjektAbweichung => _projektZeile is null || IstUngespeichert(_projektZeile)
        ? "" : AbweichungZu(_projektZeile.Bezeichner);

    /// <summary>
    /// Der Stand der markierten Projektzeile gegen den Katalog für die KI-Sicht: „noch nicht gespeichert" bei einer
    /// ungespeicherten Zeile, sonst die Abweichung (leer bei Gleichheit).
    /// </summary>
    public string ProjektKatalogzustand => _projektZeile is not null && IstUngespeichert(_projektZeile)
        ? UngespeichertText : ProjektAbweichung;

    /// <summary>Die in dieser Sitzung aufgenommenen Zeilen — Rückfall, wenn die Hülle keinen Weg <see cref="Ungespeichert"/> gibt.</summary>
    private readonly HashSet<ErzeugerZeile> _neuAufgenommen = new(ReferenceEqualityComparer.Instance);

    private bool IstUngespeichert(ErzeugerZeile zeile)
        => Ungespeichert is not null ? Ungespeichert(zeile) : _neuAufgenommen.Contains(zeile);

    private string AbweichungZu(string bezeichner)
    {
        if (KatalogAbweichung is null || string.IsNullOrEmpty(bezeichner)) return "";
        if (!_abweichung.TryGetValue(bezeichner, out string? text))
        {
            // KT-6: Wirft die Frage (sie liest Projektkopie und Katalogsatz), gilt der Name als ohne Abweichung,
            // der Grund steht im Banner — einmal, nicht je Zeichenlauf.
            Func<string, string> abweichung = KatalogAbweichung;
            text = Katalogladung.Satz(() => abweichung(bezeichner), bezeichner, out string grund) ?? "";
            _abweichung[bezeichner] = text;
            if (grund.Length > 0)
            {
                _satzFehler = grund;
                _ = InvokeAsync(StateHasChanged);
            }
        }
        return text;
    }

    /// <summary>Der Katalog hat sich geändert (Nennleistung, Import, Löschen): die Abweichungen neu fragen.</summary>
    private void BeiKatalogGeaendert() => _abweichung.Clear();

    private void ErneuernOeffnen()
    {
        if (_projektZeile is null || AusKatalogErneuern is null) return;
        _erneuernZiel = _projektZeile.Bezeichner;
        _erneuernAbweichung = ProjektAbweichung;
        _erneuernFehler = "";
        _erneuernStatus = "";
        _erneuernOffen = true;
    }

    private void ErneuernSchliessen()
    {
        _erneuernOffen = false;
        _erneuernFehler = "";
    }

    /// <summary>
    /// OK erneuert — scheitert es, bleibt die Rückfrage mit dem Grund offen; sonst fragt der Dialog die Abweichung
    /// neu und nennt das Ergebnis samt Hinweis auf die nächste Simulation.
    /// </summary>
    private async Task BeiErneuernErgebnis(bool ok)
    {
        if (!ok || AusKatalogErneuern is null) { ErneuernSchliessen(); return; }
        // KT-6: Wirft das Erneuern, bleibt die Rückfrage mit dem Grund offen; die Projektkopie bleibt, wie sie war.
        Func<string, Task<PvGanglinieErneuerung>> erneuern = AusKatalogErneuern;
        string ziel = _erneuernZiel;
        PvGanglinieErneuerung erg = await Katalogladung.SchreibenAsync(
            () => erneuern(ziel), ziel, g => new PvGanglinieErneuerung(false, g));
        if (!erg.Erfolgreich)
        {
            _erneuernFehler = erg.Meldung;
            return;
        }
        _abweichung.Remove(_erneuernZiel);
        ErneuernSchliessen();
        _erneuernStatus = erg.Meldung;
    }

    protected override void OnParametersSet()
    {
        // Der Kopf der WAHLSPALTE kommt weiter ueber den eigenen Text des Wirtes.
        Filtertexte.SpalteWahl = SpalteWahl;
    }

    protected override void OnInitialized()
    {
        // Der Filterstand je Katalog, fuer die Sitzung (Frage Q2).
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(
            Katalogprofil?.Schluessel ?? ("ZEITREIHE_" + Zeitreihenart.PvGanglinie));

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.PV_GANGLINIE, () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent liest die markierte Ganglinie (Muster Solarganglinie)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private PvGanglinieKiSicht? _kiSicht;

    /// <summary>Die Sicht des Assistenten: die Katalogwahl und der Detailblock, der ihr folgt.</summary>
    private PvGanglinieKiSicht KiSicht()
    {
        return _kiSicht ??= new PvGanglinieKiSicht
        {
            KatalogLesen = () => _katalogGewaehlt,
            KatalogSetzen = KatalogZeileWaehlen,
            KatalogEintraege = () => KiMaskenanmeldung.Eintraege(
                Katalog, z => z.Bezeichner, z => z.Bezeichner),

            ProjektganglinieLesen = () => _projektZeile?.Bezeichner ?? "",
            QuelleLesen = () => _beschreibung,
            AufloesungLesen = () => _raster,
            JahressummeLesen = () => _jahresarbeit,
            NennleistungLesen = () => _nennleistung,
            ImProjektLesen = () => _name.Length > 0
                && Zeilen.Any(z => string.Equals(z.Bezeichner, _name, StringComparison.Ordinal)),
            KatalogAbweichungLesen = () => ProjektKatalogzustand,
            ImportzustandLesen = Importzustand,
            KatalogbetriebLesen = () => Katalogbetrieb
        };
    }

    /// <summary>
    /// Der Stand des Imports in einem Satz: offen (samt Meldung), das Ergebnis des letzten Imports samt
    /// Protokoll, sonst „kein Import".
    /// </summary>
    private string Importzustand()
    {
        if (_seite is null) return "";
        if (_seite.ImportOffen)
            return _seite.Importmeldung.Length > 0
                ? Resource.KI_DLG_PVG_IMPORT_OFFEN + ": " + _seite.Importmeldung
                : Resource.KI_DLG_PVG_IMPORT_OFFEN;
        if (_seite.Status.Length > 0)
            return _seite.Protokoll.Length > 0 ? _seite.Status + " " + _seite.Protokoll : _seite.Status;
        return Resource.KI_DLG_PVG_IMPORT_KEIN;
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf: nur auffrischen. Kein Speicherweg — die
    /// Zuordnungsliste gehört dem Wirt und geht erst mit dem OK an ihn; Import, Löschen und Schloss bleiben
    /// Handlungen des Anwenders.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    /// <summary>
    /// Die Wahl zeigt Name UND Beschreibung — auch für eine Projektzeile (aus dem Katalog).
    /// </summary>
    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _erneuernStatus = "";
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _name = zeile.Bezeichner;
        _beschreibung = BeschreibungZu(zeile.Bezeichner);
        Kennwerte(KatalogzeileZu(zeile.Bezeichner));
        // Eine noch nicht gespeicherte Zeile traegt die Katalog-Id: dann ueber den Namen den Katalogsatz.
        GrafikAnstossen(new GanglinienWahl(false, IstUngespeichert(zeile) ? 0 : zeile.GeraetId, zeile.Bezeichner));
    }

    /// <summary>Die Wahl über den Bezeichner — der Weg des Assistenten.</summary>
    private void KatalogZeileWaehlen(string bezeichner)
    {
        Katalogfilterzeile? zeile = Katalog.FirstOrDefault(z => z.Bezeichner == bezeichner);
        if (zeile is null) return;
        Katalogzeile_(zeile);
    }

    /// <summary>Die Katalogseite meldet eine Wahl (<c>null</c>: die Wahl ist weg, etwa gelöscht).</summary>
    private void BeiKatalogzeile(Katalogfilterzeile? zeile)
    {
        if (zeile is null)
        {
            if (_katalogZeile is null) return;
            _katalogZeile = null;
            _katalogGewaehlt = "";
            _name = "";
            _beschreibung = "";
            Kennwerte(null);
            _grafik.Verwerfen();
            return;
        }
        Katalogzeile_(zeile);
    }

    private void Katalogzeile_(Katalogfilterzeile zeile)
    {
        _katalogZeile = zeile;
        _katalogGewaehlt = zeile.Bezeichner;
        _projektZeile = null;
        _name = zeile.Bezeichner;
        _beschreibung = zeile.Text(Katalogfilterprofil.SpBeschreibung);
        Kennwerte(zeile);
        GrafikAnstossen(new GanglinienWahl(true, zeile.Id, zeile.Bezeichner));
    }

    private string BeschreibungZu(string bezeichner)
        => KatalogzeileZu(bezeichner)?.Text(Katalogfilterprofil.SpBeschreibung) ?? "";

    private Katalogfilterzeile? KatalogzeileZu(string bezeichner)
    {
        foreach (Katalogfilterzeile k in Katalog)
            if (string.Equals(k.Bezeichner, bezeichner, StringComparison.Ordinal))
                return k;
        return null;
    }

    /// <summary>
    /// Raster, Jahresarbeit und Nennleistung der markierten Ganglinie aus ihrer Katalogzeile; ohne Zeile leer.
    /// Eine nicht gepflegte Nennleistung sagt, was der Lauf statt ihrer nimmt (die Spitze der Reihe).
    /// </summary>
    private void Kennwerte(Katalogfilterzeile? k)
    {
        var kultur = System.Globalization.CultureInfo.CurrentCulture;
        if (k is null) { _raster = ""; _jahresarbeit = ""; _nennleistung = ""; return; }
        double? raster = k.Zahl(Katalogfilterprofil.SpZeitintervall);
        _raster = raster is null ? "" : raster.Value == 15 ? Resource.PVG_RASTER_VIERTEL : Resource.PVG_RASTER_STUNDE;
        double? mwh = k.Zahl(Katalogfilterprofil.SpJahresarbeitMwh);
        _jahresarbeit = mwh is null ? "" : mwh.Value.ToString("N1", kultur) + " MWh";
        double? nenn = k.Zahl(Katalogfilterprofil.SpNennleistungKwp);
        _nennleistung = nenn is null ? Resource.PVG_NENN_NICHT_GEPFLEGT : nenn.Value.ToString("N2", kultur) + " kWp";
    }

    /// <summary>„In das Projekt übernehmen" — die Auswahl des Katalogs (Kästchen, sonst die Wahl).</summary>
    private void BeiHinzu()
    {
        if (Aufnehmen is null) return;
        ErzeugerZeile? letzte = null;
        var neue = new List<string>();
        // KT-6: Jedes Aufnehmen über die Fangstelle — wirft es, bleibt die Liste, wie sie war, die übrigen
        // Sätze kommen dazu, und der Grund steht im Banner.
        Func<int, ErzeugerZeile?> aufnehmen = Aufnehmen;
        string grund = "";
        foreach (Katalogfilterzeile k in KatalogZiele())
        {
            int id = k.Id;
            ErzeugerZeile? neu = Katalogladung.Schreiben(() => aufnehmen(id), k.Bezeichner,
                                                         g => { grund = g; return (ErzeugerZeile?)null; });
            if (neu is null) continue;
            Zeilen.Add(neu);
            _neuAufgenommen.Add(neu);
            neue.Add(Projektschluessel(neu));
            letzte = neu;
        }
        _schreibFehler = grund;
        if (letzte is null) return;
        // Die Wahl folgt der Uebernahme (DZ1-N2): genau die neuen Zeilen.
        if (neue.Count > 1) _projektWahl.Setzen(neue); else _projektWahl.Leeren();
        ProjektZeileWaehlen(letzte);
    }

    /// <summary>
    /// „Aus dem Projekt entfernen": die angekreuzten Zeilen, sonst die gewählte — bei zwei Zuordnungen
    /// derselben Ganglinie genau die markierte.
    /// </summary>
    private void BeiEntfernen()
    {
        List<ErzeugerZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;
        foreach (ErzeugerZeile zeile in ziele)
        {
            Zeilen.Remove(zeile);
            _neuAufgenommen.Remove(zeile);
            Entfernen?.Invoke(zeile);
        }
        _projektWahl.Leeren();
        if (_projektZeile is not null && ziele.Contains(_projektZeile))
        {
            _projektZeile = null;
            _name = "";
            _beschreibung = "";
            Kennwerte(null);
            _grafik.Verwerfen();
        }
    }

    /// <summary>
    /// OK schreibt über <see cref="Speichern"/> und schließt erst danach; scheitert oder wirft der Weg, bleibt der
    /// Dialog mit seinen Eingaben und dem Grund offen (KT-6). Abbrechen schließt ohne zu schreiben.
    /// </summary>
    private Task BeiErgebnis(bool ok)
    {
        if (ok && Speichern is not null)
        {
            Func<bool> speichern = Speichern;
            string grund = "";
            bool geschrieben = Katalogladung.Schreiben(speichern, TitelText, g => { grund = g; return false; });
            if (!geschrieben)
            {
                _schreibFehler = grund.Length > 0 ? grund : SchreibfehlerText;
                return Task.CompletedTask;
            }
            _schreibFehler = "";
        }
        return Geschlossen.InvokeAsync(ok);
    }

    /// <summary>✕ wirkt wie Esc: Abbrechen im Projektbetrieb, Beenden im Katalogbetrieb.</summary>
    private Task BeiKreuz() => Geschlossen.InvokeAsync(Katalogbetrieb);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _seite?.HaeltEsc == true || _erneuernOffen
            || _zweispalten?.SatzUeberlagerungOffen == true) return Task.CompletedTask;
        return BeiKreuz();
    }
}
