    /// <summary>
    /// Wie <c>Kontext_Geaendert</c>: einmal fragen, alles neu zeigen.
    ///
    /// <para><paramref name="eingabenUebernehmen"/> trennt die zwei Anlässe: Ein
    /// echter KONTEXTWECHSEL (andere Komponente, andere Kategorie, andere
    /// Variante) zeigt andere Zeilen — dort ist das Verwerfen gewollt. Eine
    /// ZEILENAKTION im selben Kontext (Position anlegen, Position löschen,
    /// Übernahme) lädt denselben Stand nur AUF; dann werden die ungespeicherten
    /// Eingaben der bestehenden Zeilen mitgenommen (siehe
    /// <see cref="EingabenUebertragen"/>).</para>
    /// </summary>
    private void KontextLaden(int? varianteId, bool eingabenUebernehmen = false)
    {
        if (Laden is null) return;

        IReadOnlyList<KostenPositionZeile> vorher = eingabenUebernehmen
            ? _stand.Zeilen
            : Array.Empty<KostenPositionZeile>();

        _stand = Laden(new KostenKomponenteKontext(_eintragId, _invest, varianteId));
        _neuerName = "";

        EingabenUebertragen(vorher);
    }

    /// <summary>
    /// Trägt die ungespeicherten Eingaben der bisherigen Zeilen auf die neu
    /// geladenen Objekte gleicher Id über (Ä12/Ä19).
    ///
    /// <para><b>Warum es das braucht.</b> Die Hülle baut bei JEDEM <c>Laden</c>
    /// neue Zeilenobjekte aus der Datenbank (<c>RasterAufbauen</c>). Eine
    /// Eingabe, die bis „Speichern" nur im Objekt lebt, stünde danach nicht mehr
    /// da — eine Zeilenaktion würde die Arbeit an allen anderen Zeilen
    /// vernichten. Übertragen werden ausschließlich die vier EINGEBBAREN Felder,
    /// und nur, wo sie vom geladenen Stand abweichen; danach zieht
    /// <see cref="Nachziehen"/> je Zeile Einheit, Betrag, Kette und Kurztexte
    /// nach — genau wie nach einer Eingabe —, zuletzt der Summenfuß.</para>
    ///
    /// <para><b>Was NICHT übertragen wird.</b> Wo ein Unterdialog die Position
    /// bereits GESCHRIEBEN hat (Zeileneditor, Worst/Best), ist der geladene
    /// Stand der neuere: Dort lädt der Dialog ohne Übertrag, sonst überschriebe
    /// der alte Anzeigewert das eben Gespeicherte.</para>
    /// </summary>
    private void EingabenUebertragen(IReadOnlyList<KostenPositionZeile> vorher)
    {
        if (vorher.Count == 0 || _stand.Zeilen.Count == 0) return;

        Dictionary<int, KostenPositionZeile> alt = new Dictionary<int, KostenPositionZeile>();
        foreach (KostenPositionZeile a in vorher) alt[a.Id] = a;

        bool etwas = false;
        foreach (KostenPositionZeile neu in _stand.Zeilen)
        {
            if (!alt.TryGetValue(neu.Id, out KostenPositionZeile? a)) continue;
            if (ReferenceEquals(a, neu)) continue;

            bool geaendert = false;
            if (!string.Equals(a.Bezeichnung, neu.Bezeichnung, StringComparison.Ordinal))
            {
                neu.Bezeichnung = a.Bezeichnung;
                geaendert = true;
            }
            if (a.BemessungId != neu.BemessungId) { neu.BemessungId = a.BemessungId; geaendert = true; }
            if (a.Satz != neu.Satz) { neu.Satz = a.Satz; geaendert = true; }
            if (a.Nutzungsdauer != neu.Nutzungsdauer)
            {
                neu.Nutzungsdauer = a.Nutzungsdauer;
                geaendert = true;
            }

            if (!geaendert) continue;
            Nachziehen?.Invoke(neu);
            etwas = true;
        }

        if (etwas) SummenNachziehen();
    }

