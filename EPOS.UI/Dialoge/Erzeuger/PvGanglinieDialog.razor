        => _seite?.Ziele() ?? (_katalogZeile is null ? Array.Empty<Katalogfilterzeile>() : new[] { _katalogZeile });

    /// <summary>
    /// Klick in eine Projektzeile (AW3b, wie Heizkessel): Die Zeile wird der gewählte Satz, die Detailzeile folgt;
    /// die Kästchen der Mehrfachwahl bleiben unberührt — wie in der Katalogliste.
    /// </summary>
    private void ProjektZeileKlick(ErzeugerZeile zeile)
    {
        if (_projektZeile != zeile) ProjektZeileWaehlen(zeile);
    }

    /// <summary>Die Hervorhebung der gewählten Projektzeile — dieselbe Klasse wie in der Katalogliste.</summary>
    private string? ProjektZeilenklasse(ErzeugerZeile zeile) => zeile == _projektZeile ? "epos-zeile--gewaehlt" : null;

    /// <summary>↑ ↓ Pos1 Ende in der Projektliste: die Regel rechnet der Baustein.</summary>
    private Task BeiProjektTaste(KeyboardEventArgs e)
        => _zweispalten is null ? Task.CompletedTask : _zweispalten.ProjektTasteAsync(e.Key);

    /// <summary>Die Tastenführung hat eine andere Projektzeile gewählt.</summary>
    private void BeiProjektTastenwahl(string schluessel)
    {
        ErzeugerZeile? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == schluessel);
        if (zeile is not null) ProjektZeileKlick(zeile);
    }

    /// <summary>
    /// Der Grund der weichen Sperre von Schloss… und Löschen der Katalogseite (AW3b): Sie wirken nur auf
    /// Katalogsätze; steht ein Projektsatz, nennen sie „Katalogsatz wählen".
    /// </summary>
    private string? KatalogSperrgrund => SatzArt == Satzmarke.Projektsatz ? Resource.AUSWAHL_SPERRE_KATALOGSATZ : null;

    /// <summary>
    /// „Bearbeiten…" am gewählten Satz (AW3b): dasselbe wie der Stift der Zeile — die Ganglinie als Ansicht in der
    /// Satz-Überlagerung (einen Katalogeditor und einen Speicherweg der Projektkopie gibt es hier nicht).
    /// </summary>
    private Task BeiSatzBearbeiten()
        => _projektZeile is not null ? BeiProjektStift(_projektZeile)
         : _katalogZeile is not null ? BeiKatalogStift(_katalogZeile)
         : Task.CompletedTask;

    private void BeiWahlGeaendert(Auswahlbereich bereich)
    {
        if (bereich != Auswahlbereich.Projekt || _projektWahl.Zuletzt is not string s) return;
        if (!_projektWahl.IstGewaehlt(s)) return;
        ErzeugerZeile? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == s);
        if (zeile is not null && zeile != _projektZeile) ProjektZeileWaehlen(zeile);
    }

    /// <summary>Die Katalogseite hat ihre Fragmente geändert: der Wirt zeichnet die Slots nach.</summary>
    private void Nachgezogen() { }

    /// <summary>UeS2: der Stift einer Projektzeile — ihre Ganglinie in der Satz-Überlagerung.</summary>
    private async Task BeiProjektStift(ErzeugerZeile zeile)
    {
        if (_projektZeile != zeile) ProjektZeileKlick(zeile);
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// UeS2: der Stift einer Katalogzeile (die Seite hat sie schon gewählt) — gesperrt oder nicht, die
    /// Ganglinie öffnet als Ansicht in der Satz-Überlagerung; einen Katalogeditor gibt es nicht.
    /// </summary>
    private async Task BeiKatalogStift(Katalogfilterzeile zeile)
    {
        if (_katalogZeile?.Bezeichner != zeile.Bezeichner) Katalogzeile_(zeile);
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

