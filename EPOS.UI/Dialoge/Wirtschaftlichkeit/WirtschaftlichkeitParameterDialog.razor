@* Dialog "Wirtschaftlichkeits-Parameter" - die Razor-Fassung (iU9-W2.5).

   HERKUNFT. Die WinForms-Fassung Views/Wirtschaftlichkeit/
   Form_WirtschaftlichkeitParameter.cs (740 Zeilen, K4 - programmatisch
   aufgebaut) ist mit dieser Komponente GELOESCHT - Regel M1. Uebernommen sind
   Feldbestand, Reihenfolge, Wertebereiche, die Nullsemantik und die
   Sichtbarkeitsregel wortgleich.

   KATEGORISIERT (Vorgabe 12.08.2026): "Allgemein" und "Strom" immer sichtbar;
   die Erzeuger-Gruppen erscheinen NUR, wenn der Erzeugertyp in der
   Vergleichsgruppe vorkommt (WirtschaftlichkeitCtrl.ErzeugerDerGruppe). Werte
   ausgeblendeter Gruppen bleiben beim Speichern unveraendert erhalten - das
   ergibt sich hier von selbst: Der Parametersatz kommt vollstaendig herein und
   geht vollstaendig zurueck; die Komponente aendert nur, was sie zeigt.

   DER BHKW-AUSZUG (Etappe B5/BW9). Die beiden BHKW-Gruppen sind mit B5 in den
   Dialog "BHKW-Wirtschaftlichkeit" gezogen. Die WinForms-Fassung baute sie
   trotzdem weiter auf und blendete sie unmittelbar danach aus, damit ihr
   Speicherweg dieselben Steuerelemente auslesen konnte (Bw9Ausblenden). Hier
   entfaellt dieser Umweg: Was nicht gebaut wird, wird auch nicht geschrieben,
   und der geladene Satz traegt die Werte unveraendert weiter. Uebrig bleibt der
   blosse Verweis auf den Dialog; er fuehrt selbst nicht dorthin, denn der
   Einstieg in "BHKW-Wirtschaftlichkeit" steht in der Fussleiste der
   Wirtschaftlichkeitsseite.

   EIN EINZIGER UNTERDIALOG (iU9-W14c.3). Der Gesetzeskatalog ist seit W14c.2
   selbst eine Razor-Komponente und erscheint als UEBERLAGERUNG in diesem
   Dialog - mit der Vorwahl der Klasse CO2_PREIS, die bis dahin
   Sprungziel.GesetzesparameterCo2 setzte. Dieser Dialog verlaesst sich also
   auf keinen Sprung mehr: Er schliesst oder er bleibt stehen.

   ER KENNT KEINE DATENBANK (Hausregel EPOS.UI). Parametersatz, Erzeugerflags,
   Kraftwerksparkliste, die Referenzkesselzeile und das Prognosejahr des
   CO2-Pfads kommen fertig geladen als [Parameter] herein.

   TASTATUR. Esc schliesst, Enter bleibt unbelegt (A-7 aus B5b). *@

@namespace EPOS.UI.Dialoge.Wirtschaftlichkeit

@using System.Globalization
@using WindowsFormsApplication1
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Kosten
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: eingebettet in der Ueberlagerung "Parameter"
       (WirtschaftlichkeitSeite) traegt DIE den Titel; der Wirt setzt dort
       TitelAnzeigen="false" - dann bleiben Titel und Kreuz hier aus, die
       Ueberlagerung traegt beides. Der Titel kommt aus dem Textbuendel _t, nicht
       aus einem leerbaren TitelText. *@
    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@_t.Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Abbrechen" />
        }
    </div>

    @* ------------------------------------------------------- Allgemein *@
    <Gruppenkopf Titel="@_t.GAllgemein" Symbol="∑">
        <KindInhalt>
            @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben dem
               Feld, Zahlenfelder kurz mit der Einheit dahinter. *@
            <Formularraster>
                <KindInhalt>
                    <Zahlenfeld Bezeichnung="@_t.Zins" Wert="@Parameter.Zinssatz"
                                WertChanged="@(w => Parameter.Zinssatz = w ?? Parameter.Zinssatz)"
                                Min="0" Max="15" Nachkommastellen="2" Einheit="%" />
                    <Ganzzahlfeld Bezeichnung="@_t.Jahre" Wert="@Parameter.Betrachtungszeitraum"
                                  WertChanged="@(w => Parameter.Betrachtungszeitraum = w ?? Parameter.Betrachtungszeitraum)"
                                  Min="1" Max="50" Einheit="a" />
                    <Zahlenfeld Bezeichnung="@_t.PreisEnergie" Wert="@Parameter.PreissteigerungEnergie"
                                WertChanged="@(w => Parameter.PreissteigerungEnergie = w ?? Parameter.PreissteigerungEnergie)"
                                Min="-10" Max="20" Nachkommastellen="2" Einheit="%/a" />
                    <Zahlenfeld Bezeichnung="@_t.PreisBetrieb" Wert="@Parameter.PreissteigerungBetrieb"
                                WertChanged="@(w => Parameter.PreissteigerungBetrieb = w ?? Parameter.PreissteigerungBetrieb)"
                                Min="-10" Max="20" Nachkommastellen="2" Einheit="%/a" />

                    @* ETAPPE W5-B-12 (Anwenderentscheid 09.09.2026): p_I neben p_B.
                       LEER IST HIER ERLAUBT und bedeutet "wie Betrieb" - deshalb wird
                       der Wert OHNE Rueckfall auf den alten Wert uebernommen, anders
                       als bei den drei Feldern darueber. Eine 0 waere die Aussage
                       "Investitionsgueter werden nie teurer"; die hat niemand
                       getroffen. *@
                    <Zahlenfeld Bezeichnung="@_t.PreisInvest"
                                Wert="@Parameter.PreissteigerungInvestition"
                                WertChanged="@(w => Parameter.PreissteigerungInvestition = w)"
                                Min="-10" Max="20" Nachkommastellen="2" Einheit="%/a" />
                </KindInhalt>
            </Formularraster>
            <Herleitungszeile Text="@PreisInvestZeile" />
        </KindInhalt>
    </Gruppenkopf>

    @* -------------------------------------------------------- Szenarien *@
    @* ETAPPE W5-B-9 (Anwenderentscheid 09.09.2026). Drei Spalten, seit
       W5-B-12 sieben Zeilen.

       WARUM EINE TABELLE UND KEIN FORMULARRASTER. Das Raster stellt Beschriftung
       neben EIN Feld; hier gehoert eine Beschriftung zu DREI Werten, und der
       Vergleich zwischen den Spalten ist der ganze Zweck der Anzeige. Es ist
       deshalb dieselbe Bauform wie die Vergleichsmatrix der Seite: eine
       gewoehnliche Tabelle mit den Hausklassen epos-raster/epos-matrix, hier
       zusaetzlich epos-raster--bearbeitbar, weil Zellen Eingabefelder tragen.

       DIE ERWARTET-SPALTE IST ANZEIGE. Sie wiederholt, was oben unter
       "Allgemein" gepflegt wird - "Kein Delegat ist kein Knopf". Investition,
       Ertraege und Nutzungsdauer stehen dort auf 0: Der Erwartungsfall weicht
       vom Erwartungsfall nicht ab.

       DIE FELDER ZEIGEN DEN WIRKSAMEN WERT, nicht den gepflegten. Ein leeres
       Feld gaebe es sonst fuer jede Vorgabe, und niemand saehe, womit gerechnet
       wird. Wer tippt, pflegt; "Vorgaben" setzt alle vierzehn Felder zurueck. Ob
       ein Satz aus Vorgaben oder gepflegten Werten besteht, sagt die
       Herleitungszeile darunter.

       ETAPPE E9b: NEUN ZEILEN. Betrachtungszeitraum und Mengenaenderung stehen als
       Zeilen 8 und 9 darunter - ohne Vorgabe, deshalb mit dem GEPFLEGTEN Wert im
       Feld (siehe dort). "Vorgaben" leert seither alle achtzehn Felder der Tafel;
       die Einspeiseverguetungen je Szenario pflegt der ±-Knopf an ihrem Feld in der
       Gruppe "Strom" (bzw. im Dialog "BHKW-Wirtschaftlichkeit"), sie bleiben dabei
       stehen. *@
    <Gruppenkopf Titel="@_t.GSzenarien" Symbol="⚖">
        <KindInhalt>
            <div class="epos-raster-huelle">
                <table class="epos-raster epos-matrix epos-raster--bearbeitbar">
                    <thead>
                        <tr>
                            <th scope="col">@_t.SzGroesse</th>
                            <th scope="col">@_t.SzErwartet</th>
                            <th scope="col">@_t.SzBest</th>
                            <th scope="col">@_t.SzWorst</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzZins</th>
                            <td class="epos-matrix-zelle">@Zahl(Parameter.Zinssatz, 2) %</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="2"
                                            Min="0" Max="15"
                                            Wert="@Best.ZinsWirksam(Parameter.Zinssatz)"
                                            WertChanged="@(w => Best.Zinssatz = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="2"
                                            Min="0" Max="15"
                                            Wert="@Worst.ZinsWirksam(Parameter.Zinssatz)"
                                            WertChanged="@(w => Worst.Zinssatz = w)" />
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzPreisE</th>
                            <td class="epos-matrix-zelle">@Zahl(Parameter.PreissteigerungEnergie, 2) %/a</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%/a" Nachkommastellen="2"
                                            Min="-10" Max="20"
                                            Wert="@Best.PreisEnergieWirksam(Parameter.PreissteigerungEnergie)"
                                            WertChanged="@(w => Best.PreissteigerungEnergie = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%/a" Nachkommastellen="2"
                                            Min="-10" Max="20"
                                            Wert="@Worst.PreisEnergieWirksam(Parameter.PreissteigerungEnergie)"
                                            WertChanged="@(w => Worst.PreissteigerungEnergie = w)" />
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzPreisB</th>
                            <td class="epos-matrix-zelle">@Zahl(Parameter.PreissteigerungBetrieb, 2) %/a</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%/a" Nachkommastellen="2"
                                            Min="-10" Max="20"
                                            Wert="@Best.PreisBetriebWirksam(Parameter.PreissteigerungBetrieb)"
                                            WertChanged="@(w => Best.PreissteigerungBetrieb = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%/a" Nachkommastellen="2"
                                            Min="-10" Max="20"
                                            Wert="@Worst.PreisBetriebWirksam(Parameter.PreissteigerungBetrieb)"
                                            WertChanged="@(w => Worst.PreissteigerungBetrieb = w)" />
                            </td>
                        </tr>
                        @* ETAPPE W5-B-12: die siebte Groesse. Die Erwartet-Spalte zeigt
                           den WIRKSAMEN Erwartet-Satz (gepflegtes p_I oder p_B) - genau
                           den Wert, um den sich die Vorgaben von Best und Worst
                           spannen. *@
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzPreisI</th>
                            <td class="epos-matrix-zelle">@Zahl(Parameter.PreisInvestWirksam, 2) %/a</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%/a" Nachkommastellen="2"
                                            Min="-10" Max="20"
                                            Wert="@Best.PreisInvestWirksam(Parameter.PreisInvestWirksam)"
                                            WertChanged="@(w => Best.PreissteigerungInvestition = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%/a" Nachkommastellen="2"
                                            Min="-10" Max="20"
                                            Wert="@Worst.PreisInvestWirksam(Parameter.PreisInvestWirksam)"
                                            WertChanged="@(w => Worst.PreissteigerungInvestition = w)" />
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzInvest</th>
                            <td class="epos-matrix-zelle">0 %</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="1"
                                            Min="-90" Max="200" Wert="@Best.InvestWirksam"
                                            WertChanged="@(w => Best.InvestitionAenderung = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="1"
                                            Min="-90" Max="200" Wert="@Worst.InvestWirksam"
                                            WertChanged="@(w => Worst.InvestitionAenderung = w)" />
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzErtrag</th>
                            <td class="epos-matrix-zelle">0 %</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="1"
                                            Min="-100" Max="200" Wert="@Best.ErtragWirksam"
                                            WertChanged="@(w => Best.ErtragAenderung = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="1"
                                            Min="-100" Max="200" Wert="@Worst.ErtragWirksam"
                                            WertChanged="@(w => Worst.ErtragAenderung = w)" />
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzDauer</th>
                            <td class="epos-matrix-zelle">0 a</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="a" Nachkommastellen="1"
                                            Min="-30" Max="30" Wert="@Best.DauerWirksam"
                                            WertChanged="@(w => Best.NutzungsdauerAenderung = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="a" Nachkommastellen="1"
                                            Min="-30" Max="30" Wert="@Worst.DauerWirksam"
                                            WertChanged="@(w => Worst.NutzungsdauerAenderung = w)" />
                            </td>
                        </tr>

                        @* ETAPPE E9b (Konzept § 2.11.5, Pflege): die Zeilen 8 und 9 - der
                           Betrachtungszeitraum und die Mengenaenderung je Szenario, gelesen vom
                           Kern seit E9a (SzenarioSatz.Zeitraum, .Menge).

                           ANDERS ALS DIE SIEBEN ZEILEN DARUEBER haben sie KEINE Vorgabe
                           (E9a-Q5): leer heisst "wie Erwartet". Die Felder zeigen deshalb den
                           GEPFLEGTEN Wert - ein leeres Feld bleibt leer, und der Platzhalter
                           nennt den Wert, mit dem dann gerechnet wird (der Erwartungswert).
                           Der Zeitraum ist eine ganze Zahl von Jahren (1 bis 50 wie das Feld
                           "Betrachtungszeitraum" oben), die Mengenaenderung ein Prozentsatz
                           wie die Ertragsaenderung. *@
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzZeitraum</th>
                            <td class="epos-matrix-zelle">@Parameter.Betrachtungszeitraum a</td>
                            <td>
                                <Ganzzahlfeld Bezeichnung="" Einheit="a" Min="1" Max="50"
                                              Platzhalter="@ZeitraumPlatzhalter"
                                              Wert="@Best.Zeitraum"
                                              WertChanged="@(w => Best.Zeitraum = w)" />
                            </td>
                            <td>
                                <Ganzzahlfeld Bezeichnung="" Einheit="a" Min="1" Max="50"
                                              Platzhalter="@ZeitraumPlatzhalter"
                                              Wert="@Worst.Zeitraum"
                                              WertChanged="@(w => Worst.Zeitraum = w)" />
                            </td>
                        </tr>
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@_t.SzMenge</th>
                            <td class="epos-matrix-zelle">0 %</td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="1"
                                            Min="-100" Max="200" Platzhalter="0"
                                            Wert="@Best.Menge"
                                            WertChanged="@(w => Best.Menge = w)" />
                            </td>
                            <td>
                                <Zahlenfeld Bezeichnung="" Einheit="%" Nachkommastellen="1"
                                            Min="-100" Max="200" Platzhalter="0"
                                            Wert="@Worst.Menge"
                                            WertChanged="@(w => Worst.Menge = w)" />
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <button type="button" class="epos-knopf" @onclick="VorgabenKlick">@_t.SzVorgaben</button>

            <Herleitungszeile Text="@SzenarioZeileBest" />
            <Herleitungszeile Text="@SzenarioZeileWorst" />
            <Herleitungszeile Text="@_t.SzHinweis" />
        </KindInhalt>
    </Gruppenkopf>

    @* ----------------------------------- Bewertung (DIN EN 17463): NICHT HIER *@
    @* AUFTRAG #325 (Anwenderwunsch 17.09.2026): Die Gruppe "Bewertung nach
       DIN EN 17463" ist herausgenommen und steht als aufklappbarer Block auf der
       SEITE "Wirtschaftlichkeit", unter der Kennzahltabelle - dort, wo auch der
       Kapitalwert steht; die Norm will beides nebeneinander.

       Es ist dasselbe Feld an derselben Modelleigenschaft
       (WirtschaftlichkeitParameter.NichtMonetaer), nur an einer anderen
       Eingabestelle. Der geladene Satz traegt den Text unveraendert weiter: Was
       dieser Dialog nicht zeigt, schreibt er auch nicht. *@

    @* ------------------------------------------------------------ Strom *@
    @* AUFTRAG #325 (Anwenderwunsch 17.09.2026): Der KWK-Satz ist HERAUSGENOMMEN -
       er steht jetzt im Dialog "BHKW-Wirtschaftlichkeit", bei der Anlage, deren
       Strom er verguetet.

       DER PV-SATZ BLEIBT, und zwar aus einem gemessenen Grund (Haltepunkt des
       Auftrags): Er wird auch dort gebraucht, wo das Projekt gar keine PV-Anlage
       fuehrt - der Einstieg in den PV-Verguetungsdialog haengt aber an genau
       dieser Anlage (WirtschaftlichkeitStand.MitPhotovoltaik). Zwei Rechenwege
       lesen ihn ohne PV:

         (a) StromPreisCtrl.VerguetungenBauen: v_bhkw = KWK-Satz, sonst PV-Satz -
             ein Projekt mit BHKW und Stromspeicher, aber ohne PV, bewertet seinen
             eingespeisten BHKW-Strom mit diesem Satz;
         (b) StromPreisCtrl: der VERKAUFSERLOES der Arbitrage ist bei jeder
             Preisquelle ausser Spotmarkt eine Kopie von v_pv - ein Speicher, der
             ins Netz verkauft, braucht keine PV-Anlage.

       Ein Satz, den die Rechnung braucht und den niemand mehr erreichen kann,
       waere schlimmer als ein Abschnitt zu viel in diesem Dialog.

       DER "BEZUG" AUS DEM GRUPPENTITEL steht nicht hier und stand auch nie hier:
       Der Strombezug wird im Arbeitspreis des Stromtraegers ("Strompreis Details"
       im Energietraegerdialog, dort auch die Leistungspreis-Staffel), im
       Rollenmodell der Tarifstruktur (BHKW-Sicht) und in der Gruppe "Strompreis /
       Bezugsbewertung" des PV-Verguetungsdialogs gepflegt. Der Titel bleibt unveraendert - an ihm ist
       nichts zu aendern beauftragt. *@
    <Gruppenkopf Titel="@_t.GStrom" Symbol="⚡">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                    <Zahlenfeld Bezeichnung="@_t.EinspeisungPv" Wert="@Parameter.Einspeiseverguetung"
                                WertChanged="@(w => Parameter.Einspeiseverguetung = w ?? Parameter.Einspeiseverguetung)"
                                Min="0" Max="2" Nachkommastellen="4" />

                    @* SP-E-2: Der Anzeigeschalter "Aufschlaege beruecksichtigen" ist
                       entfallen. Die Preisanteile des Stromtraegers ZERLEGEN seinen
                       Arbeitspreis ("Strompreis Details" im Energietraegerdialog), sie
                       kommen nicht mehr auf ihn - es gibt nichts an- oder abzuschalten. *@
                </KindInhalt>
            </Formularraster>

            @* ETAPPE E9b (Konzept § 2.11.5, Pflege; E9b-Q1): der ±-Knopf der
               Einspeiseverguetung PV. Ihr Best/Worst-Paar steht im Szenariosatz
               (SzenarioSatz.Einspeiseverguetung, Schemaschritt 118) und geht mit dem
               Parametersatz in die Zeile. Ist ein Paar gepflegt, sagen die
               Kohaerenzzeilen darunter, wann die flache Verguetung im Lauf nicht wirkt
               (E9a-Q7: Tarif-Rollenmodell, PV-Verguetungsdialog) - Hinweise, keine
               Sperre. Die Einspeiseverguetung KWK traegt ihren ±-Knopf dort, wo ihr
               Erwartet-Wert gepflegt wird: im Dialog "BHKW-Wirtschaftlichkeit". *@
            <div class="epos-szenarioleiste">
                <SzenarioKnopf Text="@_t.SzEinspeisung" Gepflegt="@EinspeisungSzenarioGepflegt"
                               Kurztext="@EinspeisungSzenarioKurztext"
                               GepflegtText="@_sz.Gepflegt" WarnungText="@_sz.OhneErwartetKurz"
                               Angefordert="EinspeisungSzenarioOeffnen" />
            </div>
            @if (EinspeisungSzenarioGepflegt)
            {
                @foreach (string hinweis in EinspeisungSzenarioHinweise)
                {
                    <Kohaerenzzeile Text="@hinweis" Zustand="KohaerenzZustand.Abweichend" />
                }
            }

            @* SP-E-5 (a): Der Satz stellt AUCH den Verkaufspreis der Speicherwelt.
               Wer ihn hier aendert, aendert die Speicherrechnung mit - und das muss
               dort stehen, wo er ihn aendert. *@
            <Herleitungszeile Text="@_t.EinspeisungHinweis" />
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------------------------- BHKW *@
    @* Die Gruppe ist reiner VERWEIS: Die KWKG- und Steuerangaben stehen im
       Dialog "BHKW-Wirtschaftlichkeit", der ueber die Fussleiste der
       Wirtschaftlichkeitsseite aufgeht. Dieser Dialog fuehrt keinen eigenen
       Weg dorthin - ein Sprung von hier wuerde nur schliessen. *@
    @if (HatBhkw)
    {
        <Gruppenkopf Titel="@_t.GBhkw" Symbol="⚙">
            <KindInhalt>
                <Herleitungszeile Text="@_t.BhkwVerweis" />
            </KindInhalt>
        </Gruppenkopf>
    }

    @* ------------------------------------------------------- Brennstoff *@
    @if (HatBrennstoff)
    {
        <Gruppenkopf Titel="@_t.GBrennstoff" Symbol="🔥">
            <KindInhalt>
                @* K6: Der CO2-Preis kommt jahresgenau aus dem Gesetzeskatalog;
                   dieses Feld ist nur noch der Override "konstanter Preis". *@
                <Formularraster>
                    <KindInhalt>
                        <Zahlenfeld Bezeichnung="@_t.Co2" Wert="@Parameter.CO2Preis"
                                    WertChanged="@(w => Parameter.CO2Preis = w ?? Parameter.CO2Preis)"
                                    Min="0" Max="500" Nachkommastellen="0" Einheit="€/t" />
                    </KindInhalt>
                </Formularraster>
                <Herleitungszeile Text="@Co2Zeile" />

                @if (GesetzeGaben is not null)
                {
                    <button type="button" class="epos-knopf epos-sprung"
                            @onclick="KatalogKlick">@_t.Co2Katalog</button>
                }

                <Formularraster>
                    <KindInhalt>
                        <Auswahlfeld Bezeichnung="@_t.Park" Eintraege="@Kraftwerksparks"
                                     Auswahl="@Parameter.IdKraftwerkspark"
                                     AuswahlChanged="@(n => Parameter.IdKraftwerkspark = n ?? 0)" />
                    </KindInhalt>
                </Formularraster>

                @* Referenzkessel kommt seit Phase 11 aus der DB - hier nur Anzeige. *@
                <Herleitungszeile Text="@ReferenzkesselZeile" />

                @* Die Untergruppe des Vorlaeufers (Form_WirtschaftlichkeitParameter.Gruppe)
                   ist jetzt eine Formulargruppe - dieselbe leise Zwischenueberschrift,
                   aber die Felder bleiben direkte Rasterkinder. *@
                <Formularraster>
                    <KindInhalt>
                        <Formulargruppe Titel="@_t.GBilanz">
                            <KindInhalt>
                                <Ganzzahlfeld Bezeichnung="@_t.BilanzJahr" Wert="@Parameter.BilanzJahr"
                                              WertChanged="@(w => Parameter.BilanzJahr = w ?? Parameter.BilanzJahr)"
                                              Min="0" Max="2100" />
                                <Auswahlfeld Bezeichnung="@_t.Methode"
                                             Eintraege="@TarifWahlen.Eintraege(_methoden)"
                                             Auswahl="@TarifWahlen.NummerZu(_methoden, Parameter.EmissionsMethode)"
                                             AuswahlChanged="@(n => Parameter.EmissionsMethode = TarifWahlen.WertZu(_methoden, n))" />
                                <Auswahlfeld Bezeichnung="@_t.Biomasse"
                                             Eintraege="@TarifWahlen.Eintraege(_biomasse)"
                                             Auswahl="@TarifWahlen.NummerZu(_biomasse, Parameter.BiomasseKonvention)"
                                             AuswahlChanged="@(n => Parameter.BiomasseKonvention = TarifWahlen.WertZu(_biomasse, n))" />
                                <Schalter Bezeichnung="@_t.Nachweis"
                                          Wert="@Parameter.NachhaltigkeitsnachweisBiomasse"
                                          WertChanged="@(w => Parameter.NachhaltigkeitsnachweisBiomasse = w)" />
                            </KindInhalt>
                        </Formulargruppe>
                    </KindInhalt>
                </Formularraster>
            </KindInhalt>
        </Gruppenkopf>
    }

    <Herleitungszeile Text="@Hinweis" />

    @if (!string.IsNullOrEmpty(_fehler))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" />
    }

    <SpeichernLeiste OkText="@_t.BtnSpeichern" AbbrechenText="@_t.BtnAbbrechen"
                     Ergebnis="BeiErgebnis" />

    @* Der Gesetzeskatalog als UEBERLAGERUNG (iU9-W14c.3). Bis W14c fuehrte hier
       Sprungziel.GesetzesparameterCo2 ueber die Sprungbruecke zu einem
       WinForms-Fenster; das Ziel ist jetzt selbst Razor. Die Vorwahl der Klasse
       CO2_PREIS steckt im Parametersatz der Huelle. *@
    <Ueberlagerung Offen="@_katalogOffen"
                   Titel="@_t.Co2Katalog" Geschlossen="() => KatalogFertigMachen(false)">
        <KindInhalt>
            @if (_katalogGaben is not null)
            {
                @* Ein Titel, eine Stelle: die Ueberlagerung traegt den Titel. Der Satz
                   der Huelle (GesetzeskatalogHuelle.Gaben, derselbe wie fuer das eigene
                   Fenster) bleibt unveraendert; TitelText="" steht RECHTS vom Satz und
                   gilt deshalb auch dann, wenn er einen Titel mitbraechte. *@
                <GesetzeskatalogDialog @attributes="_katalogGaben" TitelText=""
                                       Geschlossen="KatalogFertigMachen" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* ETAPPE E9b: das Szenariopaar der Einspeiseverguetung PV - der CaseEingabeDialog
       als allgemeiner Baustein (E9b-Q1). Ein Titel, eine Stelle: Die Ueberlagerung
       traegt Titel und Kreuz, TitelText="" steht RECHTS vom Satz. OK legt die Werte auf
       den Szenariosatz; geschrieben wird mit "Speichern" des Dialogs. *@
    <Ueberlagerung Offen="@(_szenarioGaben is not null)" Titel="@_szenarioTitel"
                   Geschlossen="() => EinspeisungSzenarioFertig(null)">
        <KindInhalt>
            @if (_szenarioGaben is not null)
            {
                <CaseEingabeDialog @attributes="_szenarioGaben" TitelText=""
                                   Geschlossen="EinspeisungSzenarioFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    // =====================================================================
    // Was hereinkommt
    // =====================================================================

    /// <summary>
    /// Der Parametersatz des Stammprojekts
    /// (<c>WirtschaftlichkeitCtrl.LadeParameter</c>), fertig geladen. Der Dialog
    /// schreibt seine Eingaben in DIESES Objekt zurück; alles, was er nicht
    /// zeigt — die BHKW-Angaben, der Referenzkessel —, bleibt unverändert
    /// stehen und geht wertgleich mit in die Zeile.
    /// </summary>
    [Parameter] public WirtschaftlichkeitParameter Parameter { get; set; }
        = new WirtschaftlichkeitParameter();

    /// <summary>Führt die Vergleichsgruppe ein BHKW? (<c>ErzeugerFlags.Bhkw</c>)</summary>
    [Parameter] public bool HatBhkw { get; set; }

    /// <summary>Führt sie einen Brennstoff-Erzeuger? (<c>ErzeugerFlags.Brennstoff</c>)</summary>
    [Parameter] public bool HatBrennstoff { get; set; }

    /// <summary>
    /// Die Referenz-Kraftwerksparks (<c>EmissionsBilanzRechner.LadeKatalog</c>),
    /// mit „(keine Emissionsbilanz)" als Id 0 an erster Stelle.
    /// </summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Kraftwerksparks { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Die fertig formulierte Referenzkesselzeile
    /// (<c>WirtschaftlichkeitCtrl.LiesReferenzkessel</c>) — reine Anzeige.</summary>
    [Parameter] public string ReferenzkesselZeile { get; set; } = "";

    /// <summary>Erstes Kalenderjahr des CO₂-Pfads mit dem Status PROGNOSE.</summary>
    [Parameter] public int Co2PrognoseAb { get; set; } = 2028;

    /// <summary>
    /// Der Parametersatz des Gesetzeskatalogs (<c>GesetzeskatalogHuelle.Gaben</c>,
    /// mit der Vorwahl CO₂-Preis). Ohne ihn bleibt der Knopf weg — bis W14c stand
    /// hier <c>Sprung(Sprungziel.GesetzesparameterCo2)</c>.
    /// </summary>
    [Parameter] public Func<IReadOnlyDictionary<string, object>>? GesetzeGaben { get; set; }

    /// <summary>Schreibt den Parametersatz fort. <c>true</c> = gespeichert.</summary>
    [Parameter] public Func<bool>? Speichern { get; set; }

    /// <summary>
    /// ETAPPE E9b (E9a‑Q7): die Kohärenzzeilen des ±-Knopfes der Einspeisevergütung PV —
    /// die Fälle, in denen die flache Vergütung im Lauf nicht wirkt (aktives
    /// Tarif-Rollenmodell, aktiver PV-Vergütungsdialog). Die Hülle bildet sie aus den
    /// Sätzen des Kerns (<c>WIRT_SZ_ROLLEN_EINSPEISUNG</c>,
    /// <c>WIRT_SZ_PV_DIALOG_EINSPEISUNG</c>); leer = sie wirkt.
    /// </summary>
    [Parameter] public IReadOnlyList<string> EinspeisungSzenarioHinweise { get; set; }
        = Array.Empty<string>();

    /// <summary>Was der Dialog beim Schließen meldet.</summary>
    [Parameter] public EventCallback<WirtParameterErgebnis> Geschlossen { get; set; }

    /// <summary>Schlüssel des Hilfeknopfes — dieselbe Wikiseite wie bisher.</summary>
    [Parameter] public string HilfeSchluessel { get; set; }
        = "Form_WirtschaftlichkeitParameter.btn_Help";

    /// <summary>
    /// Zeigt der Dialog seinen eigenen Kopf — Titel UND Schließkreuz? Vorgabe
    /// <c>true</c> — im eigenen Fenster der Windows-Schale trägt ihn sonst
    /// niemand. Steckt der Dialog dagegen in einer <c>Ueberlagerung</c>, die
    /// denselben Titel schon führt, setzt die Einbettungsstelle <c>false</c>:
    /// Ein Titel, eine Stelle. Und weil „das Kreuz beim Titel steht", trägt
    /// dann auch die <c>Ueberlagerung</c> das Kreuz, nicht dieser Dialog.
    /// </summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

    // =====================================================================
    // Zustand
    // =====================================================================

    private readonly WirtschaftlichkeitParameterTexte _t = new();
    private readonly SzenariopaarTexte _sz = new();
    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private IReadOnlyList<Steuerwahl> _methoden = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _biomasse = Array.Empty<Steuerwahl>();

    private string _fehler = "";

    /// <summary>Steht der Gesetzeskatalog als Überlagerung? (Prüfhilfe für Tests)</summary>
    private bool _katalogOffen;
    private IReadOnlyDictionary<string, object>? _katalogGaben;

    /// <summary>Steht die Katalog-Überlagerung? (Prüfhilfe für Tests)</summary>
    public bool KatalogOffen => _katalogOffen;
    private bool _gespeichert;

    protected override void OnInitialized()
    {
        _methoden = WirtParameterWahlen.Methode(_t);
        _biomasse = WirtParameterWahlen.Biomasse(_t);

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.WIRTSCHAFTLICHKEIT_PARAMETER,
                                          () => KiSicht(), KiHaken());
    }

    // =============================================================================
    // Der Hilfe-Assistent (Welle KI-F4)
    // =============================================================================

    private KiMaskenanmeldung? _kiMaske;
    private WirtschaftlichkeitParameterKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: der Parametersatz des Projekts UND die zwei
    /// Szenariosätze. Alle drei sind Fachklassen des Kerns mit öffentlichen FELDERN;
    /// die Maskenbrücke löst über Eigenschaften auf.
    /// </summary>
    private WirtschaftlichkeitParameterKiSicht KiSicht()
    {
        return _kiSicht ??= new WirtschaftlichkeitParameterKiSicht
        {
            ParameterLesen = () => Parameter,
            BestLesen = () => Best,
            WorstLesen = () => Worst,

            ParkEintraege = () => KiMaskenanmeldung.Eintraege(
                Kraftwerksparks, z => z.Id, z => z.Text),
            MethodeEintraege = () => KiMaskenanmeldung.Eintraege(
                _methoden, z => z.Wert, z => z.Text),
            BiomasseEintraege = () => KiMaskenanmeldung.Eintraege(
                _biomasse, z => z.Wert, z => z.Text),

            Nachziehen = () => _ = InvokeAsync(StateHasChanged)
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> „Speichern" schreibt den Parametersatz samt beiden
    /// Szenariosätzen in die Datenbank; das läuft über <c>dialog_speichern</c> samt
    /// Rückfrage und Sicherungspunkt (Anwenderentscheid KI‑D‑Q4).
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private static CultureInfo Kultur => BhwTexte.Kultur;

    /// <summary>
    /// Die Zeile unter dem CO₂-Feld: 0 heißt seit K6 nicht mehr „aus", sondern
    /// „Pfad" — der Satz sagt, welcher der beiden Fälle gilt.
    /// </summary>
    public string Co2Zeile => Parameter.CO2Preis > 0
        ? string.Format(Kultur, _t.Co2Konstant, Parameter.CO2Preis.ToString("N0", Kultur))
        : string.Format(Kultur, _t.Co2Pfad, Co2PrognoseAb.ToString(CultureInfo.InvariantCulture));

    // =====================================================================
    // ETAPPE W5-B-9 — Szenarien
    // =====================================================================

    /// <summary>Der Best-Satz des Parametersatzes; nie <c>null</c> (der Kern legt ihn
    /// mit lauter Vorgaben an, und eine Testfassung ohne Sätze bekäme hier eine).</summary>
    public SzenarioSatz Best
    {
        get
        {
            if (Parameter.SatzBest is null)
                Parameter.SatzBest = SzenarioSatz.Vorgabe(WirtschaftlichkeitSzenario.BEST);
            return Parameter.SatzBest;
        }
    }

    /// <inheritdoc cref="Best"/>
    public SzenarioSatz Worst
    {
        get
        {
            if (Parameter.SatzWorst is null)
                Parameter.SatzWorst = SzenarioSatz.Vorgabe(WirtschaftlichkeitSzenario.WORST);
            return Parameter.SatzWorst;
        }
    }

    /// <summary>Die Erwartet-Spalte: der Projektwert, gleich formatiert wie die
    /// Eingabefelder daneben.</summary>
    private static string Zahl(double wert, int stellen) =>
        wert.ToString("N" + stellen.ToString(CultureInfo.InvariantCulture), Kultur);

    /// <summary>
    /// ETAPPE W5‑B‑12: die Herleitungszeile unter „Allgemein“ — sie nennt den WIRKSAMEN
    /// p_I und seine Herkunft. Ohne sie wäre ein leeres Feld eine offene Frage: 0 %/a
    /// oder „wie Betrieb“?
    /// </summary>
    public string PreisInvestZeile => string.Format(Kultur, _t.PreisInvestZeile,
        Zahl(Parameter.PreisInvestWirksam, 2),
        Parameter.PreissteigerungInvestition.HasValue
            ? _t.PreisInvestGepflegt : _t.PreisInvestWieB);

    /// <summary>
    /// „Vorgaben“ — alle Felder der Tafel auf <c>null</c> zurück: seit W5‑B‑12 vierzehn,
    /// seit ETAPPE E9b achtzehn (Zeilen 8 und 9, <see cref="SzenarioSatz.TafelZuruecksetzen"/>).
    /// Das ist NICHT dasselbe wie „auf die heutigen Vorgabezahlen setzen“: Ein leeres
    /// Feld zieht bei einer geänderten Projektangabe mit, eine eingetragene Zahl nicht.
    ///
    /// <para><b>ETAPPE E9b: Die Einspeisevergütungen je Szenario bleiben.</b> Sie stehen
    /// nicht in der Tafel; ihr Paar pflegt der ±-Knopf an ihrem Feld. Bis E9b ersetzte der
    /// Knopf beide Sätze als Ganzes — mit den neuen Größen hätte er eine Pflege gelöscht,
    /// die an dieser Stelle niemand sieht.</para>
    /// </summary>
    private void VorgabenKlick()
    {
        Best.TafelZuruecksetzen();
        Worst.TafelZuruecksetzen();
    }

    /// <summary>
    /// ETAPPE E9b: der Platzhalter der leeren Zeitraumfelder — der Erwartungswert, mit
    /// dem ein leeres Feld rechnet („wie Erwartet").
    /// </summary>
    private string ZeitraumPlatzhalter =>
        Parameter.Betrachtungszeitraum.ToString(CultureInfo.InvariantCulture);

    /// <summary>Herleitungszeile des Best-Satzes: Herkunft und die WIRKSAMEN Zahlen.</summary>
    public string SzenarioZeileBest => SzenarioZeile(_t.SzBest, Best);

    /// <inheritdoc cref="SzenarioZeileBest"/>
    public string SzenarioZeileWorst => SzenarioZeile(_t.SzWorst, Worst);

    /// <summary>
    /// ETAPPE E9b: Die Zeile nennt Betrachtungszeitraum, Mengenänderung und die
    /// Einspeisevergütungen NUR, wenn dieses Szenario sie gepflegt hat — „wie Erwartet"
    /// steht schon in der Erwartet-Spalte (<see cref="SzenarioSatz.Nachweis(WirtschaftlichkeitParameter, CultureInfo, bool)"/>).
    /// </summary>
    private string SzenarioZeile(string name, SzenarioSatz satz) =>
        string.Format(Kultur, satz.NurVorgaben ? _t.SzHerkunftVorgabe : _t.SzHerkunftGepflegt,
                      name, satz.Nachweis(Parameter, Kultur, true));

    // =====================================================================
    // ETAPPE E9b — der ±-Knopf der Einspeisevergütung PV
    // =====================================================================

    private IReadOnlyDictionary<string, object>? _szenarioGaben;
    private string _szenarioTitel = "";

    /// <summary>Steht die Überlagerung des Szenariopaars? (Prüfhilfe für Tests)</summary>
    public bool SzenarioOffen => _szenarioGaben is not null;

    /// <summary>ETAPPE E9b: Trägt die Einspeisevergütung PV ein gepflegtes Paar
    /// (1e−9-Regel gegen den Projektwert)?</summary>
    public bool EinspeisungSzenarioGepflegt =>
        Szenariopaar.Gepflegt(Best.Einspeiseverguetung, Worst.Einspeiseverguetung,
                              Parameter.Einspeiseverguetung);

    private string EinspeisungSzenarioKurztext =>
        Szenariopaar.Kurztext(Best.Einspeiseverguetung, Worst.Einspeiseverguetung,
                              Parameter.Einspeiseverguetung, "€/kWh", 4);

    /// <summary>
    /// ETAPPE E9b: „±" an der Einspeisevergütung PV — der <c>CaseEingabeDialog</c> als
    /// Szenariopaar gegen den Wert des Feldes daneben (€/kWh, vier Stellen, bis 2 wie das
    /// Feld). Keine Warnung ohne Erwartet-Wert: Eine Vergütung von 0 ist keine Datenlücke,
    /// sondern „keine Vergütung".
    /// </summary>
    private void EinspeisungSzenarioOeffnen()
    {
        _szenarioTitel = Szenariopaar.Titel(_t.SzEinspeisung);
        _szenarioGaben = Szenariopaar.Gaben(_t.SzEinspeisung, _t.SzEinspeisung, "€/kWh",
            Parameter.Einspeiseverguetung, Best.Einspeiseverguetung, Worst.Einspeiseverguetung,
            4, 2, EinspeisungSzenarioHinweise, warnenOhneErwartet: false);
    }

    /// <summary>ETAPPE E9b: das Ergebnis auf beide Szenariosätze — 0 heißt „wie Erwartet".
    /// Geschrieben wird mit „Speichern" des Dialogs.</summary>
    private void EinspeisungSzenarioFertig(CaseEingabeErgebnis? ergebnis)
    {
        _szenarioGaben = null;
        if (ergebnis is null) return;
        Best.Einspeiseverguetung = Szenariopaar.Wert(ergebnis.BestCase);
        Worst.Einspeiseverguetung = Szenariopaar.Wert(ergebnis.WorstCase);
    }

    /// <summary>Der Schlusshinweis — je nach Erzeugerlage um zwei Absätze länger.</summary>
    public string Hinweis
    {
        get
        {
            string s = _t.Hinweis;
            if (HatBhkw)
            {
                s += " " + _t.HinweisKwkg;
                if (!string.IsNullOrEmpty(_t.HinweisKwkgKatalog)) s += " " + _t.HinweisKwkgKatalog;
                if (!string.IsNullOrEmpty(_t.HinweisSteuerformulare)) s += " " + _t.HinweisSteuerformulare;
            }
            if (HatBrennstoff && !string.IsNullOrEmpty(_t.HinweisBilanz)) s += " " + _t.HinweisBilanz;
            return s;
        }
    }

    // =====================================================================
    // Der Gesetzeskatalog
    // =====================================================================

    /// <summary>
    /// Der Gesetzeskatalog — eine ÜBERLAGERUNG in diesem Dialog (iU9-W14c.3).
    /// Die Werte dieses Dialogs bleiben unberührt: Der Katalog ist eine eigene
    /// Tabelle ohne Projektbezug.
    /// </summary>
    private void KatalogKlick()
    {
        if (GesetzeGaben is null) return;
        _fehler = "";
        _katalogGaben = GesetzeGaben();
        _katalogOffen = true;
    }

    private void KatalogFertigMachen(bool ok)
    {
        _katalogOffen = false;
        _katalogGaben = null;
        StateHasChanged();
    }

    // =====================================================================
    // Speichern
    // =====================================================================

    private async Task BeiErgebnis(bool ok)
    {
        if (!ok) { await Schliessen(); return; }

        _fehler = "";
        if (Speichern is null || !Speichern())
        {
            _fehler = _t.MsgSpeicherfehler;
            return;
        }

        _gespeichert = true;
        await Schliessen();
    }

    private Task Schliessen() =>
        Geschlossen.InvokeAsync(new WirtParameterErgebnis(_gespeichert));

    /// <summary>
    /// Abbrechen: schließt ohne zu speichern. Das ist der Weg von Esc UND vom
    /// Schließkreuz im Kopf — das Kreuz tut genau, was Esc tut. Solange der
    /// Katalog obenauf liegt, gehört die Geste ihm.
    /// </summary>
    private Task Abbrechen() => _katalogOffen || SzenarioOffen ? Task.CompletedTask : Schliessen();

    /// <summary>Esc schließt die OBERSTE Ebene — erst den Katalog, dann den Dialog.</summary>
    private Task BeiTaste(KeyboardEventArgs e)
        => e.Key == "Escape" ? Abbrechen() : Task.CompletedTask;
}
