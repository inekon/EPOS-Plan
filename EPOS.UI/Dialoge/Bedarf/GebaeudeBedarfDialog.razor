    protected override void OnInitialized()
    {
        _einheit = Einheit ?? Energieeinheit.Vorgabe;

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE_BEDARF,
                                          () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent liest den Bedarf und stellt die Anzeige (Welle KI-F3)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GebaeudeBedarfKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die drei Kennzahlen aus dem eingefrorenen Satz und
    /// die zwei Bedienelemente der Maske.
    /// </summary>
    private GebaeudeBedarfKiSicht KiSicht()
    {
        return _kiSicht ??= new GebaeudeBedarfKiSicht
        {
            EinheitLesen = () => EinheitIndex,
            EinheitSetzen = EinheitWaehlen,
            EinheitEintraege = () => KiMaskenanmeldung.Eintraege(
                Einheitenwahl, e => e.Id, e => e.Text),

            SortiertLesen = () => _sortiert,
            SortiertSetzen = w => SortiertGesetzt(w),

            DiagrammLesen = () => Diagrammwahl.Count > 0 ? _bildzone : null,
            DiagrammSetzen = DiagrammWaehlen,
            DiagrammEintraege = () => KiMaskenanmeldung.Eintraege(
                Diagrammwahl, e => e.Id, e => e.Text),

            SatzLesen = () => Daten
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Nur Auffrischen.</b> Diese Maske zeigt ein gerechnetes Ergebnis und schreibt
    /// nichts; einen Schreibschutz und einen Speicherweg gibt es nicht.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =================================================================================
    // Einheit
    // =================================================================================

    private IReadOnlyList<(int Id, string Text)> Einheitenwahl
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                liste.Add((i, Energieeinheit.Alle[i].Text));
            return liste;
        }
    }

    private int EinheitIndex
    {
        get
        {
            for (int i = 0; i < Energieeinheit.Alle.Count; i++)
                if (ReferenceEquals(Energieeinheit.Alle[i], _einheit)) return i;
            return 0;
        }
    }

    private void EinheitWaehlen(int? id)
    {
        int n = id ?? 0;
        if (n < 0 || n >= Energieeinheit.Alle.Count) return;

        Energieeinheit neu = Energieeinheit.Alle[n];
        if (ReferenceEquals(neu, _einheit)) return;

        _einheit = neu;
        EinheitGewaehlt?.Invoke(neu);
    }

