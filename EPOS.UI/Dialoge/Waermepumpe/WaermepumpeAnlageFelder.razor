    public bool UebernahmeOffen => _vorschau is not null;

    /// <summary>
    /// Führt das Projekt eine eigene Gerätekopie? Ohne Delegat <c>true</c> — eine Seite
    /// ohne Gaben soll zeichnen und bedienbar sein, nicht gesperrt dastehen.
    /// </summary>
    private bool Projektkopie
        => ProjektkopieVorhanden is null || (Daten.IdWp > 0 && ProjektkopieVorhanden(Daten.IdWp));

    /// <summary>Der Grund der weichen Sperre — <c>null</c>, solange nichts gesperrt ist.</summary>
    private string? Sperrgrund => Projektkopie ? null : MeldungNichtGespeichert;

    private string RuecklaufVorschlagszeile
        => string.Format(RuecklaufFormat, string.Join(", ", RuecklaufVorschlaege));

    private string Kostensummen
    {
        get
        {
            if (!_kostenBereit || Kostensumme is null) return TextKostenKeine;
            (double invest, double betrieb) = Kostensumme();
            return string.Format(TextKostenSummen, invest, betrieb);
        }
    }

    /// <summary>
    /// Die Vorlaufstufen des gewählten Geräts. Steht der gespeicherte Vorlauf nicht
    /// darunter, wird er vorangestellt — der Vorläufer hatte eine frei beschreibbare
    /// <c>ComboBox</c>, und ein <c>select</c> würde ihn still verwerfen (A-16).
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Vorlaufeintraege
    {
        get
        {
            var l = new List<(int, string)>();
            if (Daten.Vorlauf is int v && !_vorlaufstufen.Contains(v)) l.Add((v, v.ToString()));
            foreach (int stufe in _vorlaufstufen) l.Add((stufe, stufe.ToString()));
            return l;
        }
    }

    protected override void OnInitialized()
    {
        _extrapolation = ExtrapolationErlaubt;

        // W7-B-2: Ein Altwert aus Tab_Energieanlagen wird auf den Steuerwert
        // gezogen - sonst zeigte die Klappliste nichts und die Engine laese
        // weiter einen Wert, den sie zeichengleich vergleicht.
        Daten.Betriebsart = DbWerte.BetriebsartOderDefault(Daten.Betriebsart);

        // STILLE Vorwahl: Der Aufbau fuellt aus den Daten und laesst Daten.IdWp
        // unberuehrt - er ist der Fall, gegen den sich der Vorlaeufer mit
        // m_bStilleFuellung wehren musste (Ä21).
        Auffrischen();

        // Welle KI-F1: den Feldsatz der Anlage beim Hilfe-Assistenten anmelden. Er ist
        // die EINE Quelle aller drei Bloecke - Dialog, Konfiguration und Stammfelder;
        // die Stammfelder arbeiten auf einem Abbild, das nach einer Feldsetzung neu
        // aufgebaut wird (siehe KiHaken).
        // KI-F1b: Die fünf Klapplisten der Maske sind WAHLFELDER. Ihre Einträge stehen
        // dort, wo auch die Maske sie herholt — der Trägerkatalog kommt aus der Hülle,
        // die vier festen Listen aus den Bausteinen.
        // Welle #458: Angemeldet ist eine SICHTKLASSE - sie reicht Daten unveraendert
        // durch und traegt dazu die Projekteinstellung „Extrapolation der WP-Kennlinie
        // erlauben", die nicht am Feldsatz haengt (Muster PhotovoltaikKiSicht, KI-F7).
        // Stufe KU2 Welle 3: Die Sichtklasse traegt auch die Kuehlgaben - mit ihnen loest sie
        // die drei Wahlfelder des Kuehlbetriebs auf und lehnt ab, was die Maske weich sperrt.
        _kiSicht = new WaermepumpeAnlageKiSicht
        {
            Datenquelle = () => Daten,
            VorlaufWeg = BeiVorlauf,
            ExtrapolationLesen = () => _extrapolation,
            ExtrapolationSetzen = KiExtrapolationSetzen,
            Kuehlgaben = () => Kuehlung
        };
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.WAERMEPUMPE_ANLAGE,
                                          () => _kiSicht, KiHaken(),
                                          ("energietraeger", Traegereintraege),
                                          ("betriebsart", Betriebsarteintraege),
                                          ("typ", () => KiMaskenanmeldung.Eintraege(
                                                            WaermepumpeStammFelder.TYPEN, s => s, s => s)),
                                          ("leistungsstufen", () => KiMaskenanmeldung.Eintraege(
                                                            WaermepumpeStammFelder.LEISTUNGSSTUFEN, s => s, s => s)),
                                          ("aufstellung", () => KiMaskenanmeldung.Eintraege(
                                                            WaermepumpeStammFelder.AUFSTELLUNGEN, s => s, s => s)),
                                          ("baujahr", () => KiMaskenanmeldung.Eintraege(
                                                            WaermepumpeStammFelder.BAUJAHRE, j => j)));
    }

    /// <summary>Die Energieträger des Katalogs für den Assistenten (KI-F1b).</summary>
    private IReadOnlyList<KiWahleintrag> Traegereintraege()
        => KiMaskenanmeldung.Eintraege(Traegerkatalog, e => e.Id, e => e.Name);

    /// <summary>
    /// Die drei Betriebsarten der Konfiguration für den Assistenten (KI-F1b) —
    /// Schlüssel UND Text sind der Steuerwert, genau wie in der Klappliste.
    /// </summary>
    private static IReadOnlyList<KiWahleintrag> Betriebsarteintraege()
        => KiMaskenanmeldung.Eintraege(WaermepumpeKonfiguration.BETRIEBSARTEN, s => s, s => s);

    // =================================================================================
    // Der Hilfe-Assistent liest und setzt die Anlagenfelder (Welle KI-F1)
    // =================================================================================

    /// <summary>
    /// Die Anmeldung bei der <c>KiMaskenbruecke</c>. Sie hält die Getter auf
    /// <see cref="Daten"/> und fällt mit dem Dialog.
    /// </summary>
    /// <remarks>
    /// <b>Angemeldet heißt nicht übertragen.</b> Ob ein Feldwert hinausgeht,
    /// entscheiden der Schalter „Feldwerte mitsenden" im Chat und die
    /// Einwilligungsstufe „Dialogdaten" (KI‑D‑Q2).
    /// </remarks>
    private KiMaskenanmeldung? _kiMaske;

    /// <summary>Die Sicht des Assistenten auf Daten und Extrapolationsschalter (Welle #458).</summary>
    private WaermepumpeAnlageKiSicht? _kiSicht;

    /// <summary>
    /// Der Assistent legt den Extrapolationsschalter — derselbe Weg wie der Schalter
    /// (<see cref="ExtrapolationUebernehmen"/>); Rückgabe: der Grund, warum nichts
    /// geschrieben wurde, sonst <c>null</c>.
    /// </summary>
    private string? KiExtrapolationSetzen(bool wert)
    {
        if (ExtrapolationSchreiben is null) return Resource.KI_SIM_KEIN_SCHREIBWEG;
        return ExtrapolationUebernehmen(wert) ? null : WarnungExtrapolation;
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>AUFFRISCHEN heißt hier mehr als neu zeichnen.</b> Der Stammfeldblock
    /// bindet an <c>_stamm</c>, das ABBILD von <see cref="Daten"/>; nach einer
    /// Feldsetzung muss es neu aufgebaut werden, sonst zeigte die Maske weiter die alte
    /// Zahl. <see cref="Auffrischen"/> tut genau das — und verliert dabei nichts, weil
    /// jede Eingabe im Block ohnehin sofort nach <see cref="Daten"/> zurückschreibt
    /// (<see cref="StammfeldGeaendert"/>).</para>
    /// <para><b>Die PRÜFUNG ist dieselbe, die der OK-Knopf ruft</b>
    /// (<see cref="ErsterFehler"/>): Der Assistent ersetzt sie nicht, er löst sie
    /// aus, und ihr Befund geht als Meldung an den Chat zurück.</para>
    /// <para><b>KEIN Speicherweg.</b> Dieser Dialog schreibt nicht selbst — geschrieben
    /// wird im OK-Weg, und zwar von der Hülle, die den Satz zurücknimmt.
    /// <c>dialog_speichern</c> lehnt deshalb benannt ab, statt still nichts zu
    /// tun.</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(() => { Auffrischen(); StateHasChanged(); }),
        Pruefen = () => ErsterFehler().Meldung ?? "",
        Schreibgeschuetzt = () => NurLesen
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>Vorlaufstufen, Bilder, Kostenzeile und Stammfelder zum aktuellen Gerät nachziehen.</summary>
    private void Auffrischen()
    {
        _vorlaufstufen = (Vorlaeufe is not null && Daten.IdWp > 0)
            ? Vorlaeufe(Daten.IdWp) : Array.Empty<int>();
        _bilder = (Bilder is not null && Daten.IdWp > 0)
            ? Bilder(Daten.IdWp) : KennlinienBilder.Leer;
        _kostenBereit = KostenBereit?.Invoke() ?? false;
        StammabbildNachziehen();
    }

    /// <summary>
    /// Das Abbild der ANLAGENFELDER für den Baustein aufbauen (Anwenderentscheid
    /// 16.09.2026).
    ///
    /// <para><b>Quelle ist <see cref="Daten"/>, nicht der Katalog.</b> Bis zum Vormittag
    /// holte diese Stelle den Katalogsatz gleichen Namens und schrieb auch dorthin zurück —
    /// wer hier Nennleistung oder Baujahr änderte, änderte sie für jedes andere Projekt
    /// mit. Die Felder gehören der Anlage; <c>Daten</c> trägt sie seit Ä23 alle
    /// (<c>WaermepumpeGeraeteCtrl.GeraetedatenFuellen</c> füllt sie Projektkopie vor
    /// Katalog).</para>
    ///
    /// <para><see cref="WaermepumpeStammDaten.Modulkosten"/> steht im Baustein nur lesend
    /// und läuft unverändert mit. Die <see cref="WaermepumpeStammDaten.Kuehlleistung"/>
    /// dagegen ist seit dem 16.09.2026 eine Spalte der PROJEKTKOPIE wie die Nennleistung
    /// — sie kommt aus <see cref="Daten"/> und geht dorthin zurück
    /// (<c>KuehlleistungAenderbar="true"</c>).</para>
    /// </summary>
    private void StammabbildNachziehen()
    {
        _stamm = new WaermepumpeStammDaten
        {
            Id = Daten.IdWp,
            Name = Daten.Bezeichner,
            Firma = Daten.Firma,
            Beschreibung = Daten.Beschreibung,
            Typ = Daten.Typ,
            Regelung = Daten.Regelung,
            Aufstellung = Daten.Aufstellung,
            Baujahr = Daten.Baujahr,
            Nennleistung = Daten.Nennleistung,
            Heizstab = Daten.HeizstabLeistung,
            Kuehlleistung = Daten.Kuehlleistung ?? 0,
            Modulkosten = Daten.Modulkosten,
            // Welle M4 (WP1): Mindestleistung und C_d der Projektkopie - im Baustein nur lesend.
            MindestleistungKw = Daten.MindestleistungKw,
            TaktverlustfaktorCd = Daten.TaktverlustfaktorCd
        };
        _stammMeldung = "";
    }

    /// <summary>
    /// „Kennlinien aus dem Katalog übernehmen" (Befund <b>W7‑B‑3</b>): Der Weg
    /// schreibt die Stützstellen des Katalogsatzes gleichen Namens in die
    /// Projektkopie — in EINER Transaktion, und ohne anzurühren, was schon da ist.
    /// Danach zeigt der Reiter die PROJEKTkennlinien, und die Herleitungszeile
    /// verschwindet von selbst.
    /// </summary>
    private void BeiKennlinienUebernehmen()
    {
        if (KennlinienUebernehmen is null || Daten.IdWp <= 0) return;

        int zeilen = KennlinienUebernehmen(Daten.IdWp);

        if (zeilen > 0)
        {
            _kennlinienStufe = WarnStufe.Hinweis;
            _kennlinienMeldung = string.Format(TextKennlinienUebernommen, zeilen);
        }
        else
        {
            _kennlinienStufe = WarnStufe.Warnung;
            _kennlinienMeldung = TextKennlinienOhneKatalog;
        }

        Auffrischen();
    }

    /// <summary>Das Band ist verfallen — der Dialog vergisst seine Meldung.</summary>
    private void MeldungVergessen() => _kennlinienMeldung = "";

    /// <summary>
    /// Ein anderer Vorlauf. Steht im Rücklauf noch der unberührte VORSCHLAG (die Zeile
    /// „Rücklauf vorbelegt …" ist da), zieht er mit — sonst ergäbe ein tieferer Vorlauf
    /// ein vertauschtes Paar, das der OK-Knopf meldet, obwohl niemand es eingegeben hat.
    /// Ein vom Anwender eingetragener Rücklauf bleibt stehen.
    /// </summary>
    private void BeiVorlauf(int? wert)
    {
        Daten.Vorlauf = wert;
        if (RuecklaufVorbelegen is null || string.IsNullOrEmpty(Daten.RuecklaufHerleitung)) return;

        Daten.Ruecklauf = null;
        Daten.RuecklaufHerleitung = "";
        RuecklaufVorbelegen(Daten);
    }

    /// <summary>Eine Eingabe macht den Rücklauf zu dem des Anwenders — die Vorschlagszeile geht.</summary>
    private void BeiRuecklauf(int? wert)
    {
        Daten.Ruecklauf = wert;
        Daten.RuecklaufHerleitung = "";
    }

    // =================================================================================
    // Kosten, Katalog, Konfiguration, Stammfelder, Kennlinieneditor
    // =================================================================================

    // --- Die Bruecke zur Kostenleiste ------------------------------------------
    //
    // Dasselbe Muster wie im HeizkesselDialog: Die Leiste bekommt einen Delegaten
    // ODER null, und null heisst "kein Knopf". Hier haengt daran ZUSAETZLICH die
    // weiche Sperre des Vorlaeufers - Kosten und Traeger dieser Anlage gibt es erst,
    // wenn die Anlagenzeile gespeichert ist (Ä22), und in der Ansicht "nur lesen"
    // fuehrte jeder der drei Knoepfe in eine BEARBEITBARE Verwaltung.
    private Func<bool, Task>? KostenLeiste
        => KostenOeffnen is null || NurLesen || !_kostenBereit
               ? null
               : (Func<bool, Task>)BeiKosten;

    private Func<Task>? EnergieLeiste
        => EnergiekostenOeffnen is null || NurLesen || !_kostenBereit
               ? null
               : (Func<Task>)BeiEnergiekosten;

    /// <summary>
    /// „Investitionskosten…" / „Betriebskosten…" — dieselbe Maske, unterschieden nur
    /// durch <paramref name="betrieb"/>. Nach der Rückkehr werden Bereitschaft und
    /// Summenzeile nachgezogen (der alte <c>KostenSummenAnzeigen</c>-Nachlauf).
    /// </summary>
    private async Task BeiKosten(bool betrieb)
    {
        if (KostenOeffnen is null) return;
        await KostenOeffnen(betrieb);
        _kostenBereit = KostenBereit?.Invoke() ?? false;   // KostenSummenAnzeigen nach der Rueckkehr
    }

    /// <summary>
    /// „Energiekosten…" — die Energieträgerverwaltung, eingeengt auf Strom. Der
    /// Feldsatz geht mit; er trägt Träger und Gerät dieser Anlage.
    /// </summary>
    private Task BeiEnergiekosten()
        => EnergiekostenOeffnen?.Invoke(Daten) ?? Task.CompletedTask;

    /// <summary>
    /// W10b‑B‑3: schreibt die Projekteinstellung sofort; bei Fehlschlag bleibt der Schalter,
    /// wie er war, und das Band bei den Kennlinien sagt es.
    /// </summary>
    private void ExtrapolationGesetzt(bool wert) => ExtrapolationUebernehmen(wert);

    /// <summary>Der Schreibweg des Schalters — für ihn und den Assistenten; <c>true</c> = geschrieben.</summary>
    private bool ExtrapolationUebernehmen(bool wert)
    {
        if (ExtrapolationSchreiben is null) return false;
        if (ExtrapolationSchreiben(wert))
        {
            _extrapolation = wert;
            return true;
        }
        _extrapolationSchluessel++;                 // der Schalter zeigt wieder den gespeicherten Stand
        _kennlinienMeldung = WarnungExtrapolation;
        _kennlinienStufe = WarnStufe.Fehler;
        return false;
    }

    // ---------------------------------------------------------------------------------
    // Die Konfiguration in der Ueberlagerung (16.09.2026)
    // ---------------------------------------------------------------------------------

    /// <summary>
    /// „Konfiguration…" — die acht Felder werden gesichert, BEVOR der Baustein in
    /// <see cref="Daten"/> schreibt; „Abbrechen" schreibt sie zurück.
    /// </summary>
    private void KonfigurationOeffnen()
    {
        if (NurLesen) return;
        _konfigSicherung = Daten.Kopie();
        _konfigWarnung = "";
        _konfigOffen = true;
    }

    /// <summary>Der Baustein hat geschrieben — die Meldung der Überlagerung verfällt.</summary>
    private void KonfigurationGeaendert()
    {
        _konfigWarnung = "";
    }

    /// <summary>
    /// OK prüft und schließt; ein Mangel hält die Überlagerung offen und nennt ihn DORT —
    /// der Anwender soll das Feld sehen, das gemeint ist.
    /// </summary>
    private void KonfigurationErgebnis(bool ok)
    {
        if (!ok) { KonfigurationAbbrechen(); return; }

        (string? fehler, string feld) = KonfigurationsFehler();
        if (fehler is not null) { _konfigWarnung = fehler; _mangel = feld; return; }

        _konfigWarnung = "";
        _konfigSicherung = null;
        _konfigOffen = false;
    }

    /// <summary>Abbrechen, ✕ und Esc: der gesicherte Stand geht zurück in <see cref="Daten"/>.</summary>
    private void KonfigurationAbbrechen()
    {
        if (_konfigSicherung is WaermepumpeAnlageDaten alt)
        {
            Daten.Heizstab = alt.Heizstab;
            Daten.Sperrung = alt.Sperrung;
            Daten.SperrzeitVon = alt.SperrzeitVon;
            Daten.SperrzeitBis = alt.SperrzeitBis;
            Daten.Sperrfenster = alt.Sperrfenster?.Select(z => z.Kopie()).ToList();
            Daten.BivalenterBetrieb = alt.BivalenterBetrieb;
            Daten.Betriebsart = alt.Betriebsart;
            Daten.Abschaltpunkt = alt.Abschaltpunkt;
            Daten.CarrierId = alt.CarrierId;
            Daten.KuehlfelderAus(alt);   // KU2 Welle 3: die fünf Kühlfelder ebenso
        }
        _konfigSicherung = null;
        _konfigWarnung = "";
        _konfigOffen = false;
    }

    // ---------------------------------------------------------------------------------
    // Die Stammfelder im Kenndatenblock (16.09.2026)
    // ---------------------------------------------------------------------------------

    /// <summary>
    /// Eine Eingabe im Feldraster — sie geht SOFORT in <see cref="Daten"/> zurück
    /// (Anwenderentscheid 16.09.2026).
    ///
    /// <para><b>Und damit erst mit dem OK des Dialogs hinaus:</b> <c>Daten</c> ist die
    /// Kopie, die der Dialog bearbeitet; die Hülle überträgt sie beim OK in die
    /// Anlagenzeile und zieht danach die Projektkopie nach. „Abbrechen" verwirft sie —
    /// die Hausregel „Geschrieben wird im OK-Weg" bleibt gewahrt.</para>
    ///
    /// <para>Der BEZEICHNER wird NICHT zurückgeschrieben: Er steht im Baustein nur lesend
    /// (<c>BezeichnerAenderbar="false"</c>), und die Kopplung Projektkopie ↔ Katalogsatz
    /// hängt an ihm. Die Modulkosten sind ebenfalls nur lesend; die KÜHLLEISTUNG ist es
    /// seit dem 16.09.2026 nicht mehr — sie ist eine Spalte der Projektkopie und geht
    /// denselben Weg wie die Nennleistung.</para>
    /// </summary>
    private void StammfeldGeaendert()
    {
        _stammMeldung = "";

        Daten.Firma = _stamm.Firma ?? "";
        Daten.Beschreibung = _stamm.Beschreibung ?? "";
        Daten.Typ = _stamm.Typ ?? "";
        Daten.Regelung = _stamm.Regelung ?? "";
        Daten.Aufstellung = _stamm.Aufstellung ?? "";
        Daten.Baujahr = _stamm.Baujahr ?? 0;
        Daten.Nennleistung = _stamm.Nennleistung ?? 0;
        Daten.HeizstabLeistung = _stamm.Heizstab;
        Daten.Kuehlleistung = _stamm.Kuehlleistung;
    }

    // ---------------------------------------------------------------------------------
    // „In Stamm übernehmen…" (Anwenderentscheid 16.09.2026)
    // ---------------------------------------------------------------------------------

    /// <summary>
    /// Der Klick auf den Knopf. Ist er weich gesperrt, MELDET er den Grund, statt still
    /// nichts zu tun (Hausregel „Bedienung"); sonst holt er die Vorschau und öffnet die
    /// Überlagerung.
    /// </summary>
    private void BeiInStamm()
    {
        if (!Projektkopie) { NichtGespeichertMelden(); return; }
        if (InStammUebernehmen is null || UebernahmeVorschau is null || NurLesen) return;

        WaermepumpeUebernahmeVorschau? v = UebernahmeVorschau(Daten.IdWp);
        if (v is null || string.IsNullOrEmpty(v.Bezeichner))
        {
            NichtGespeichertMelden();
            return;
        }

        _mitKennlinien = false;
        _vorschau = v;
    }

    /// <summary>
    /// Der Warntext zum Fall — je Fall EIN Satz, und er nennt den Namen.
    ///
    /// <para><b>Drei Fälle, nicht zwei</b> (16.09.2026): Seit Schemaschritt 80 hängt die
    /// Projektkopie über <c>ID_Stamm</c> an ihrem Katalogsatz, und der kann inzwischen
    /// ANDERS heißen. Dann steht beides da — der Name der Anlage und der heutige Name im
    /// Katalog —, denn sonst suchte der Anwender nach einem Satz, den es unter diesem
    /// Namen nicht mehr gibt.</para>
    /// </summary>
    private string UebernahmeWarntext(WaermepumpeUebernahmeVorschau v)
    {
        if (v.ReadOnly) return MeldungUebernahmeReadOnly;
        if (!v.KatalogsatzVorhanden) return string.Format(UebernahmeTextNeu, v.Bezeichner);

        return Umbenannt(v)
            ? string.Format(UebernahmeTextUmbenannt, v.Bezeichner, v.KatalogBezeichner,
                            v.AnzahlProjekteMitKopie)
            : string.Format(UebernahmeTextUeberschreiben, v.Bezeichner,
                            v.AnzahlProjekteMitKopie);
    }

    /// <summary>
    /// Heißt der verknüpfte Katalogsatz anders als die Anlage? Ein leerer
    /// <c>KatalogBezeichner</c> ist KEINE Umbenennung, sondern eine Vorschau ohne die
    /// Angabe — die Aufrufer, die sie nicht führen, bleiben beim bisherigen Wortlaut.
    /// </summary>
    private static bool Umbenannt(WaermepumpeUebernahmeVorschau v)
        => !string.IsNullOrEmpty(v.KatalogBezeichner) &&
           !string.Equals(v.KatalogBezeichner, v.Bezeichner, StringComparison.Ordinal);

    /// <summary>✕, Esc und „Schließen" des ReadOnly-Falls: nichts geschieht.</summary>
    private void UebernahmeSchliessen()
    {
        _vorschau = null;
        _mitKennlinien = false;
    }

    /// <summary>
    /// OK der Überlagerung: <b>hier</b> wird in den Katalog geschrieben — der einzige
    /// Weg, auf dem dieser Dialog den Katalog anfasst. Danach wird die Stammliste neu
    /// geladen: Ein neu angelegter Satz steht jetzt darin.
    /// </summary>
    private void UebernahmeErgebnis(bool ok)
    {
        if (!ok) { UebernahmeSchliessen(); return; }

        if (InStammUebernehmen is null) { UebernahmeSchliessen(); return; }

        KatalogSpeicherErgebnis ergebnis = InStammUebernehmen(Daten.IdWp, _mitKennlinien);

        _stammStufe = ergebnis.Ok ? WarnStufe.Hinweis : WarnStufe.Warnung;
        _stammMeldung = ergebnis.Meldung ?? "";


        UebernahmeSchliessen();
    }

    /// <summary>
    /// Die Meldung der weichen Sperre — sie steht bei den Kenndaten, also dort, wo auch
    /// die beiden gesperrten Knöpfe stehen.
    /// </summary>
    private void NichtGespeichertMelden()
    {
        _stammMeldung = MeldungNichtGespeichert;
        _stammStufe = WarnStufe.Hinweis;
    }

    // ---------------------------------------------------------------------------------
    // Der Kennlinieneditor (16.09.2026 aus der Stammdatenpflege uebernommen)
    // ---------------------------------------------------------------------------------

    /// <summary>
    /// „Kennliniendaten Ansicht/Bearbeiten…" — der Editor bearbeitet seit dem 16.09.2026
    /// die PROJEKTKENNLINIEN (<c>Tab_Kenndaten</c>) zu <c>Daten.IdWp</c>.
    ///
    /// <para>Vor dem ersten Speichern gibt es keine: Der Knopf ist dann WEICH gesperrt und
    /// meldet den Grund, statt still nichts zu tun.</para>
    /// </summary>
    private void BeiKenndaten()
    {
        if (!Projektkopie) { NichtGespeichertMelden(); return; }
        if (Kennlinien is null || Daten.IdWp <= 0) return;

        _kennlinienZeilen = Kennlinien(Daten.IdWp).Select(z => z.Kopie()).ToList();
    }

    private void KenndatenFertig(IReadOnlyList<KennlinienZeile>? stand)
    {
        _kennlinienZeilen = null;
        if (stand is null || NurLesen) return;   // Abbruch

        // AW2: der Stand vor der ERSTEN Aenderung - das Abbrechen des Wirts schreibt ihn zurueck.
        _kennlinienMerker ??= (Daten.IdWp, Kennlinien?.Invoke(Daten.IdWp).Select(z => z.Kopie()).ToList());
        KennlinienAbgleichen?.Invoke(Daten.IdWp, stand);

        // Die Bilder lesen Tab_Kenndaten - nach dem Editor stehen sie neu da.
        Auffrischen();
    }

