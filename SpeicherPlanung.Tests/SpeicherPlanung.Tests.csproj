    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpeicherEngine\SpeicherEngine.csproj" />
    <ProjectReference Include="..\SpeicherPlanung\SpeicherPlanung.csproj" />
  </ItemGroup>

</Project>
