    /// <summary>
    /// Die Prüfungen von <c>btn_Beenden_Click</c>:197 in derselben Reihenfolge.
    /// Statt drei <c>MessageBox</c> und der Meldungen aus <c>Program.GanzzahlPruefen</c>
    /// steht ein Warnbanner, das das Feld beim Namen nennt — und seit W7‑B‑2 sagt der
    /// zweite Rückgabewert auch, WELCHES Feld zu markieren ist.
    /// </summary>
    private (string? Meldung, string Feld) ErsterFehler()
    {
        (string? konfig, string konfigFeld) = KonfigurationsFehler();
        if (konfig is not null && konfigFeld == MANGEL_BETRIEBSART) return (konfig, konfigFeld);

        if (string.IsNullOrEmpty(Daten.Bezeichner))
            return (WarnungWaermepumpe, "");

        string? temperatur = TemperaturenPruefen?.Invoke(Daten.Vorlauf, Daten.Ruecklauf);
        if (temperatur is not null) return (temperatur, MANGEL_TEMPERATUR);

        if (konfig is not null) return (konfig, konfigFeld);

        // Die Nutzungsdauer ist KEINE Pflichtangabe dieses Dialogs mehr (Anwenderauftrag
        // 30.09.2026) - sie steht im Kostendialog, an den Investitionspositionen.
        if (Daten.HeizstabLeistung is null) return (string.Format(WarnungFeldFormat, LabelPHeizstabKurz), MANGEL_HEIZSTAB);

        // Die Bivalenztemperatur ist je nach Betriebsart ausgeblendet - ein leeres
        // Feld ist deshalb erlaubt und laesst den bisherigen Wert stehen.
        return (null, "");
    }

    /// <summary>
    /// Die Prüfregeln, die an den Feldern der KONFIGURATION hängen — EINE Stelle für
    /// beide Ausgänge: das OK der Überlagerung und das OK des Dialogs
    /// (<see cref="ErsterFehler"/>).
    /// </summary>
    private (string? Meldung, string Feld) KonfigurationsFehler()
    {
        if (string.IsNullOrEmpty(Daten.Betriebsart) && Daten.BivalenterBetrieb)
            return (WarnungBetriebsart, MANGEL_BETRIEBSART);
        if (Daten.SperrzeitVon is null)
            return (string.Format(WarnungFeldFormat, KonfigTexte.LabelVon), MANGEL_VON);
        if (Daten.SperrzeitBis is null)
            return (string.Format(WarnungFeldFormat, KonfigTexte.LabelBis), MANGEL_BIS);
        // V14: jedes Sperrfenster braucht Beginn (0 … 24 h) und Dauer (über 0 bis 24 h).
        foreach (SperrfensterZeile f in Daten.Sperrfenster ?? new List<SperrfensterZeile>())
        {
            if (f.VonH is not double von || von < 0 || von > 24)
                return (string.Format(WarnungFeldFormat, KonfigTexte.LabelSperrVon), MANGEL_VON);
            if (f.DauerH is not double dauer || dauer <= 0 || dauer > 24)
                return (string.Format(WarnungFeldFormat, KonfigTexte.LabelSperrDauer), MANGEL_BIS);
        }
        // KU2 Welle 3: die Prüfregel der Kühlfelder - EINE Stelle für beide Wirte.
        string? kuehl = WaermepumpeKonfiguration.KuehlFehler(Daten, Kuehlung, KonfigTexte);
        if (kuehl is not null) return (kuehl, MANGEL_KUEHLUNG);
        // Anlagenkopplung AK2 (9.3): Zeitprogramm und hoechster Vorlauf - dieselbe Regel wie in Simulation › Konfiguration.
        string? zeiten = WaermepumpeKonfiguration.BetriebszeitenFehler(Daten, KonfigTexte);
        if (zeiten is not null) return (zeiten, MANGEL_KUEHLUNG);
        return (null, "");
    }

    /// <summary>
    /// Ein Mangel an einem Feld der KONFIGURATION öffnet die Überlagerung und meldet ihn
    /// DORT (16.09.2026). Ein Band, das ein Feld nennt, das der Anwender gar nicht sehen
    /// kann, hilft nicht weiter — dieselbe Überlegung wie bei W7‑B‑2.
    /// </summary>
    private void MangelSetzen(string? fehler, string feld)
    {
        _warnung = fehler ?? "";
        _mangel = feld;

        if (fehler is null || NurLesen) return;
        if (feld is not (MANGEL_BETRIEBSART or MANGEL_VON or MANGEL_BIS or MANGEL_KUEHLUNG)) return;

        if (!_konfigOffen) _konfigSicherung = Daten.Kopie();
        _konfigWarnung = fehler;
        _konfigOffen = true;
    }

    /// <summary>
    /// EINGEBETTET (W7‑B‑3): die Prüfung des OK-Knopfs als Aufruf für den Wirt — er ruft sie,
    /// bevor er die Zeile wechselt oder schließt. <c>null</c> = alles steht; sonst der Wortlaut,
    /// und das bemängelte Feld trägt die Mangelklasse wie beim OK.
    /// </summary>
    public string? Pruefen()
    {
        (string? fehler, string feld) = ErsterFehler();
        MangelSetzen(fehler, feld);
        return fehler;
    }

    /// <summary>Der Stand der Projektkennlinien vor der ersten Änderung im Editor; <c>null</c> = unverändert.</summary>
    private (int IdWp, List<KennlinienZeile>? Zeilen)? _kennlinienMerker;

    /// <summary>Hat der Kennlinieneditor in dieser Sitzung geschrieben? (Prüfhilfe.)</summary>
    public bool KennlinienGeaendert => _kennlinienMerker is not null;

    /// <summary>
    /// AW2: Abbrechen der Satz-Überlagerung — die Projektkennlinien stehen wieder wie beim Öffnen. Der Editor
    /// schreibt bei seinem OK sofort (die Bilder zeigen den neuen Stand); erst das OK des Wirts behält ihn.
    /// </summary>
    public void KennlinienZuruecksetzen()
    {
        if (_kennlinienMerker is not (int id, List<KennlinienZeile> zeilen) || NurLesen) { _kennlinienMerker = null; return; }
        KennlinienAbgleichen?.Invoke(id, zeilen);
        _kennlinienMerker = null;
    }

    /// <summary>AW2: das OK des Wirts behält den Stand der Kennlinien.</summary>
    public void KennlinienBehalten() => _kennlinienMerker = null;


}
