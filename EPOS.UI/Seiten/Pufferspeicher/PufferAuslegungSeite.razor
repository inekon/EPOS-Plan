    /// <summary>Der Schalter der Vorlage für das Kriterium (ohne Abweichung des Anwenders).</summary>
    private bool VorlageAn(string kennung)
        => GewaehlteVorlage?.Kriterien is { } k && k.TryGetValue(kennung, out bool an) && an;

    /// <summary>Gilt das Kriterium — Abweichung des Anwenders vor dem Schalter der Vorlage?</summary>
    private bool KriteriumAn(string kennung)
        => _eingabe.Kriterien.TryGetValue(kennung, out bool an) ? an : VorlageAn(kennung);

    private void KriteriumSetzen(string kennung, bool an)
    {
        Schalten(() =>
        {
            if (an == VorlageAn(kennung)) _eingabe.Kriterien.Remove(kennung);
            else _eingabe.Kriterien[kennung] = an;
        });
    }

    /// <summary>Die Karten in der Reihenfolge der Vorlage; Schnell zeigt nur die eingeschalteten.</summary>
    private IEnumerable<string> Karten
        => (GewaehlteVorlage?.Kriterien.Keys ?? Enumerable.Empty<string>())
           .Where(k => AbStandard || KriteriumAn(k));

    private string Kriteriumswert(PufferKriteriumDaten? k)
    {
        if (k is null) return _ergebnis is null ? Texte.KritNochNicht : "—";
        if (!k.Gueltig) return Texte.KritNichtGueltig;
        return k.VolumenL is double v ? Z(v) + " l" : "—";
    }

    private RenderFragment Karte(string kennung) => @<section @key="kennung" data-kriterium="@kennung"
            class="@("epos-pausl-karte" + (KriteriumAn(kennung) ? "" : " epos-pausl-karte--aus")
                     + (_ergebnis?.Bemisst(kennung) == true ? " epos-pausl-karte--bemessend" : ""))">
        @{
            PufferKriteriumDaten? k = _ergebnis?.Kriterium(kennung);
            bool ueber = _eingabe.Kriterien.ContainsKey(kennung);
        }
        <header class="epos-pausl-karte-kopf">
            <span class="epos-pausl-kennung">@kennung</span>
            <h3 class="epos-pausl-karte-titel">@Texte.Kriterium(kennung)</h3>
            <span class="epos-pausl-karte-wert">@Kriteriumswert(k)</span>
            @if (_ergebnis?.Bemisst(kennung) == true)
            {
                <span class="epos-pausl-bemessend">@Texte.KritBemessend</span>
            }
            <span class="@("epos-pausl-marke" + (ueber ? " epos-pausl-marke--ueberschrieben" : ""))">@(ueber ? Texte.QuelleUeberschrieben : Texte.QuelleVorlage)</span>
        </header>
        <Schalter Bezeichnung="@Texte.KritAn" Wert="@KriteriumAn(kennung)"
                  WertChanged="@((bool w) => KriteriumSetzen(kennung, w))" />
        @if (k is not null && k.Herkunft.Length > 0)
        {
            <p class="epos-pausl-karte-herkunft">@k.Herkunft</p>
        }
        @if (AbStandard && k is not null && k.Rechenweg.Length > 0)
        {
            <p class="epos-pausl-rechenweg"><span class="epos-pausl-beschriftung">@Texte.KritRechenweg</span> @k.Rechenweg</p>
        }
        @if (Experte && kennung == "K4")
        {
            PufferKriteriumDaten? e = _ergebnis?.Kriterium("K4e");
            <div class="epos-pausl-expertenzeile" data-kriterium="K4e">
                <span class="epos-pausl-beschriftung">@Texte.Kriterium("K4e")</span>
                <span>@Kriteriumswert(e)</span>
                @if (e is not null && e.Rechenweg.Length > 0)
                {
                    <span class="epos-pausl-rechenweg">@e.Rechenweg</span>
                }
                <Schalter Bezeichnung="@Texte.Expertenweg" Wert="@_eingabe.SperrzeitExpertenweg"
                          WertChanged="@((bool w) => Schalten(() => _eingabe.SperrzeitExpertenweg = w))" />
            </div>
        }
        @if (Experte && kennung == "K9")
        {
            PufferKriteriumDaten? e = _ergebnis?.Kriterium("K9e");
            <div class="epos-pausl-expertenzeile" data-kriterium="K9e">
                <span class="epos-pausl-beschriftung">@Texte.Kriterium("K9e")</span>
                <span>@Kriteriumswert(e)</span>
            </div>
        }
    </section>;

    private RenderFragment SchrittKriterien => @<div class="epos-pausl-schritt epos-pausl-schritt--kriterien">
        <p class="epos-leisezeile">@Texte.KriterienHinweis</p>
        @if (_eingabe.KlasseHeizung || _eingabe.KlasseProzess)
        {
            <div class="epos-pausl-karten">
                @foreach (string kennung in Karten)
