@* Kapitalwert-Verlauf ueber den Nutzungszeitraum (iU9-W1.6).

   Vorbild: Views/Wirtschaftlichkeit/Form_WirtschaftlichkeitVerlauf.cs (289 Z.)
   und .Designer.cs (Phase 11). Uebernommen sind der Feldbestand der Feldkarte
   (Jahre 2..60, Szenario, "Aktualisieren", zwei Bilder, Restwertzeile,
   Statuszeile, "Schliessen"), das Zeichnen beim Oeffnen (Form_Load rief
   btnZeichnen_Click) und das Sperrwerk waehrend der Rechnung (SetBusy: die
   Eingaben sind gesperrt, der Schliessen-Knopf heisst "Abbrechen").

   DIE RECHNUNG LIEGT IN DER HUELLE. Sie sammelt die Simulationsdaten
   (BerichtsDatenSammler, einmal), rechnet den Verlauf und zeichnet die beiden
   Bilder mit dem Kern-Renderer; die Komponente bekommt zwei PNG und zwei
   Textzeilen. Der CancellationToken kommt aus der Komponente, damit
   "Abbrechen" und das Schliessen des Fensters denselben Weg gehen.

   KEINE FORTSCHRITTSANZEIGE. Der Vorlaeufer hatte eine ProgressBar, die der
   Sammler ueber IProgress fuellte. Ein Fortschrittsbaustein entsteht in EPOS.UI
   erst in Welle 11 (Bausteinluecke 13); bis dahin sagt die Statuszeile, dass
   gerechnet wird. *@

@namespace EPOS.UI.Dialoge.Wirtschaftlichkeit
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
    </div>

    <div class="epos-neuzeile">
        <Ganzzahlfeld Bezeichnung="@LabelJahre" Wert="@_jahre"
                      Min="@MinJahre" Max="@MaxJahre"
                      WertChanged="@(w => _jahre = w ?? _jahre)" />
        <Auswahlfeld Bezeichnung="@LabelSzenario" Eintraege="@Szenarien"
                     Auswahl="@_szenario" Aktiv="@(!_laeuft)"
                     AuswahlChanged="@(id => _szenario = id)" />
        <button type="button" class="epos-knopf" disabled="@_laeuft"
                @onclick="Zeichnen">@ZeichnenText</button>
    </div>

    @if (!string.IsNullOrEmpty(_fehler))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" />
    }

    <ChartBild Png="@_differenz" Alt="@AltDifferenz" PlatzhalterText="@PlatzhalterText" />
    <ChartBild Png="@_absolut" Alt="@AltAbsolut" PlatzhalterText="@PlatzhalterText" />

    @if (!string.IsNullOrEmpty(_restwert))
    {
        <Herleitungszeile Text="@_restwert" />
    }
    <Herleitungszeile Text="@_status" />

    <div class="epos-leiste">
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="BeiSchliessen">@(_laeuft ? AbbrechenText : SchliessenText)</button>
    </div>
</div>

@code {
    /// <summary>Die waehlbaren Szenarien (Id, Anzeigetext) — die Huelle uebersetzt
    /// die Id in den Persistenzwert <c>Tab_ErgebnisWirtschaftlichkeit.Szenario</c>.</summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Szenarien { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Vorgewaehltes Szenario; <c>null</c> = das erste (ERWARTET).</summary>
    [Parameter] public int? SzenarioVorwahl { get; set; }

    /// <summary>
    /// Vorbelegung des Zeitraums. Der Vorlaeufer nahm den gespeicherten
    /// Betrachtungszeitraum, wenn er zwischen 2 und 60 lag
    /// (<c>ParameterVorbelegen</c>); das entscheidet weiter die Huelle.
    /// </summary>
    [Parameter] public int JahreVorgabe { get; set; } = 20;

    /// <summary>Kleinster Zeitraum (Designer: numJahre.Minimum).</summary>
    [Parameter] public int MinJahre { get; set; } = 2;

    /// <summary>Groesster Zeitraum (Designer: numJahre.Maximum).</summary>
    [Parameter] public int MaxJahre { get; set; } = 60;

    /// <summary>
    /// Der Rechenweg: Jahre, Szenario-Id und ein Abbruchmerker hinein, zwei
    /// Bilder und zwei Textzeilen heraus. Die Huelle laesst ihn auf einem
    /// eigenen Faden laufen (<c>Task.Run</c>).
    /// </summary>
    [Parameter] public Func<int, int, CancellationToken, Task<KapitalwertVerlaufBilder>>? Berechnen { get; set; }

    /// <summary>Der Dialog ist zu Ende.</summary>
    [Parameter] public EventCallback Geschlossen { get; set; }

    /// <summary>Fenstertitel (der Aufrufer haengt den Stammnamen an).</summary>
    [Parameter] public string TitelText { get; set; }
        = "Kapitalwert-Verlauf über den Nutzungszeitraum";

    /// <summary>Beschriftung des Zeitraumfeldes (Designer: lblZeitraum).</summary>
    [Parameter] public string LabelJahre { get; set; } = "Zeitraum [Jahre]:";

    /// <summary>Beschriftung der Szenarioliste (Designer: lblSzenario).</summary>
    [Parameter] public string LabelSzenario { get; set; } = "Szenario:";

    /// <summary>Beschriftung des Rechenknopfes (Designer: btnZeichnen).</summary>
    [Parameter] public string ZeichnenText { get; set; } = "Aktualisieren";

    /// <summary>Beschriftung des schliessenden Knopfes (Designer: btnSchliessen).</summary>
    [Parameter] public string SchliessenText { get; set; } = "Schließen";

    /// <summary>Beschriftung desselben Knopfes waehrend der Rechnung (SetBusy).</summary>
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Statuszeile waehrend der Rechnung.</summary>
    [Parameter] public string LaeuftText { get; set; } = "Berechnung läuft …";

    /// <summary>Statuszeile nach einem Abbruch (wortgleich aus dem Vorlaeufer).</summary>
    [Parameter] public string AbgebrochenText { get; set; } = "Vorgang abgebrochen.";

    /// <summary>Vorlage der Fehlermeldung, ein Platzhalter (frueher eine MessageBox).</summary>
    [Parameter] public string VorlageFehler { get; set; } = "Fehler beim Berechnen des Verlaufs: {0}";

    /// <summary>Alternativtext des oberen Bildes.</summary>
    [Parameter] public string AltDifferenz { get; set; }
        = "Kapitalwert-Verlauf: Differenz zur Stamm-Referenz";

    /// <summary>Alternativtext des unteren Bildes.</summary>
    [Parameter] public string AltAbsolut { get; set; }
        = "Kapitalwert-Verlauf: kumulierte Barwerte je Projekt";

    /// <summary>Text an der Stelle eines noch nicht gezeichneten Bildes.</summary>
    [Parameter] public string PlatzhalterText { get; set; } = "Noch kein Diagramm";

    /// <summary>Schluessel des Hilfeknopfes — die vorhandene Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_WirtschaftlichkeitVerlauf.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private int _jahre = 20;
    private int? _szenario;
    private bool _laeuft;

    private byte[]? _differenz;
    private byte[]? _absolut;
    private string _restwert = "";
    private string _status = "";
    private string _fehler = "";

    private CancellationTokenSource? _abbruch;

    /// <summary>Laeuft gerade eine Rechnung? (Pruefhilfe fuer Tests.)</summary>
    public bool Laeuft => _laeuft;

    /// <summary>Die Statuszeile (Pruefhilfe fuer Tests).</summary>
    public string Status => _status;

    protected override void OnInitialized()
    {
        _jahre = Math.Min(MaxJahre, Math.Max(MinJahre, JahreVorgabe));
        _szenario = SzenarioVorwahl ?? (Szenarien.Count > 0 ? Szenarien[0].Id : (int?)null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();

        // Form_WirtschaftlichkeitVerlauf_Load rief btnZeichnen_Click.
        await Zeichnen();
    }

    /// <summary>Wie <c>btnZeichnen_Click</c>: ein Lauf zur Zeit, Eingaben gesperrt.</summary>
    private async Task Zeichnen()
    {
        if (_laeuft || Berechnen is null) return;

        _laeuft = true;
        _fehler = "";
        _status = LaeuftText;
        _abbruch = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            KapitalwertVerlaufBilder bilder =
                await Berechnen(_jahre, _szenario ?? 0, _abbruch.Token);

            _differenz = bilder.Differenz;
            _absolut = bilder.Absolut;
            _restwert = bilder.Restwerttext ?? "";
            _status = bilder.Statustext ?? "";
        }
        catch (OperationCanceledException)
        {
            _status = AbgebrochenText;
        }
        catch (Exception ex)
        {
            // Frueher eine MessageBox — jetzt ein Warnbanner an Ort und Stelle.
            _fehler = string.Format(VorlageFehler, ex.Message);
            _status = "";
        }
        finally
        {
            _abbruch?.Dispose();
            _abbruch = null;
            _laeuft = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Wie <c>btnSchliessen_Click</c>: Waehrend der Rechnung bricht der Knopf ab,
    /// sonst schliesst er. Der Vorlaeufer schloss nach dem Abbruch von selbst
    /// (<c>_schliessenNachAbbruch</c>) — hier bleibt der Dialog stehen und sagt
    /// „Vorgang abgebrochen", damit ein versehentliches Abbrechen nicht zugleich
    /// das Fenster nimmt.
    /// </summary>
    private Task BeiSchliessen()
    {
        if (_laeuft)
        {
            _abbruch?.Cancel();
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync();
    }

    private Task BeiTaste(KeyboardEventArgs e) => e.Key switch
    {
        "Escape" => BeiSchliessen(),
        _ => Task.CompletedTask
    };

    /// <summary>Ein noch laufender Lauf wird beim Schliessen des Fensters abgebrochen.</summary>
    public void Dispose()
    {
        try { _abbruch?.Cancel(); } catch { /* schon entsorgt */ }
        _abbruch?.Dispose();
        _abbruch = null;
    }
}
