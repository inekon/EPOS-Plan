#25970=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('fc2b7f9e-f128-4161-98cb-62a7e11bf6be'),$);
