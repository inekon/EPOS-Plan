    /// <summary>
    /// <b>Die Kennlinie als Bild</b> (KD-3): Reiter EER und Kälteleistung, je ein <c>DiagrammSvg</c> mit dem Modell der
    /// Hülle — Abszisse Rückkühltemperatur (bei Luft Außentemperatur), eine Linie je Kaltwassertemperatur. Ohne Weg
    /// der Hülle kein Bild.
    /// </summary>
    private RenderFragment Kennlinienbild(KaeltemaschineDaten d) => __builder =>
    {
        if (Kennlinienbilder is null) return;
        KaeltemaschineKennlinienbilder bilder = BilderZu(d);
        <div class="epos-kaeltemaschine-kennlinienbild">
            <Reiter Bezeichnung="@Texte.KennlinienbildBezeichnung" Kennung="km-kennlinie" @bind-Aktiv="_kennlinienreiter">
                <KindInhalt>
                    <Reiterblatt Schluessel="EER" Titel="@Texte.ReiterEer">
                        <KindInhalt>
                            <DiagrammSvg Modell="@bilder.Eer" Kennung="km-kennlinie-eer"
                                         Bezeichnung="@Texte.ReiterEer" PlatzhalterText="@Texte.PlatzhalterKennlinienbild" />
                        </KindInhalt>
                    </Reiterblatt>
                    <Reiterblatt Schluessel="LEISTUNG" Titel="@Texte.ReiterLeistung">
                        <KindInhalt>
                            <DiagrammSvg Modell="@bilder.Leistung" Kennung="km-kennlinie-leistung"
                                         Bezeichnung="@Texte.ReiterLeistung" PlatzhalterText="@Texte.PlatzhalterKennlinienbild" />
                        </KindInhalt>
                    </Reiterblatt>
                </KindInhalt>
            </Reiter>
        </div>
    };

    /// <summary>
    /// Die Bilder zum Stand <paramref name="d"/> aus dem Zwischenspeicher; neu gebaut nur bei geändertem Abzug
    /// (Rückkühlart und alle Punkte), damit das Bild jeder Eingabe folgt und sonst seine Referenz behält.
    /// </summary>
    private KaeltemaschineKennlinienbilder BilderZu(KaeltemaschineDaten d)
    {
        if (Kennlinienbilder is null) return KaeltemaschineKennlinienbilder.Leer;
        string abzug = Kennlinienabzug(d);
        if (_kennlinienbilder.TryGetValue(d, out var alt) && alt.Abzug == abzug) return alt.Bilder;
        if (_kennlinienbilder.Count > 8) _kennlinienbilder.Clear();
        KaeltemaschineKennlinienbilder neu = Kennlinienbilder(d) ?? KaeltemaschineKennlinienbilder.Leer;
        _kennlinienbilder[d] = (abzug, neu);
        return neu;
    }

    private static string Kennlinienabzug(KaeltemaschineDaten d)
    {
        var sb = new System.Text.StringBuilder();
        sb.Append(d.RueckkuehlartIndex?.ToString(CultureInfo.InvariantCulture) ?? "-");
        foreach (KaeltemaschinePunktDaten p in d.Kennlinie)
            sb.Append('|').Append(Abzugswert(p.Rueckkuehltemperatur)).Append(';').Append(Abzugswert(p.Kaltwassertemperatur))
              .Append(';').Append(Abzugswert(p.Eer)).Append(';').Append(Abzugswert(p.Kaelteleistung));
        return sb.ToString();
    }

    private static string Abzugswert(double? v) => v?.ToString("R", CultureInfo.InvariantCulture) ?? "-";

    /// <summary>Die Kennlinie als Zeilenraster: vier Zahlen je Punkt, Entfernen je Zeile, Hinzufügen darunter.</summary>
    private RenderFragment Kennlinienfelder(KaeltemaschineDaten d) => __builder =>
    {
        <Zeilenraster Bezeichnung="@Texte.KennlinieRaster" Spalten="@KennlinienSpalten"
                      Spaltenmass="minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) auto">
            <KindInhalt>
                @for (int i = 0; i < d.Kennlinie.Count; i++)
                {
                    int index = i;
                    KaeltemaschinePunktDaten p = d.Kennlinie[index];
                    string nummer = string.Format(CultureInfo.CurrentCulture, Texte.Punkt, index + 1);
                    <div class="epos-zr-zeile epos-kaeltemaschine-punkt" role="row" @key="p">
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Rueckkuehltemperatur" Titel="@(nummer + " – " + Texte.SpalteRueckkuehltemperatur)"
                                        Feldname="@(nummer + " – " + Texte.SpalteRueckkuehltemperatur)"
                                        WertChanged="w => Punktfeld(() => p.Rueckkuehltemperatur = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Kaltwassertemperatur" Titel="@(nummer + " – " + Texte.SpalteKaltwassertemperatur)"
                                        Feldname="@(nummer + " – " + Texte.SpalteKaltwassertemperatur)"
                                        WertChanged="w => Punktfeld(() => p.Kaltwassertemperatur = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Eer" Titel="@(nummer + " – " + Texte.SpalteEer)"
                                        Feldname="@(nummer + " – " + Texte.SpalteEer)"
                                        WertChanged="w => Punktfeld(() => p.Eer = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <Zahlenfeld Wert="@p.Kaelteleistung" Titel="@(nummer + " – " + Texte.SpalteKaelteleistung)"
                                        Feldname="@(nummer + " – " + Texte.SpalteKaelteleistung)"
                                        WertChanged="w => Punktfeld(() => p.Kaelteleistung = w)" />
                        </div>
                        <div class="epos-zr-zelle" role="cell">
                            <span class="epos-zr-aktionen">
                                <button type="button" class="epos-knopf epos-zr-knopf" title="@Texte.PunktEntfernen"
                                        aria-label="@(nummer + " – " + Texte.PunktEntfernen)"
                                        @onclick="() => PunktEntfernen(index)"><span aria-hidden="true">✕</span></button>
                            </span>
                        </div>
                    </div>
                }
            </KindInhalt>
            <AbschlussZeile>
                <div class="epos-zr-neuzeile epos-kaeltemaschine-punkt-neu" role="row">
                    @if (d.Kennlinie.Count == 0)
                    {
                        <p class="epos-leisezeile">@Texte.KennlinieLeer</p>
                    }
                    <button type="button" class="epos-textknopf" @onclick="PunktAnlegen">@Texte.PunktNeu</button>
                </div>
            </AbschlussZeile>
        </Zeilenraster>
    };

    private IReadOnlyList<string> KennlinienSpalten => new[]
    {
        Texte.SpalteRueckkuehltemperatur + " [" + Texte.EinheitGradC + "]",
        Texte.SpalteKaltwassertemperatur + " [" + Texte.EinheitGradC + "]",
        Texte.SpalteEer,
        Texte.SpalteKaelteleistung + " [" + Texte.EinheitKw + "]",
        ""
    };

    // =====================================================================
    // Teillast und Takten (KM3-E3-a)
    // =====================================================================

    private static IReadOnlyList<(int Id, string Text)> Eintraege(IReadOnlyList<string> texte)
        => texte.Select((t, i) => (i, t)).ToList();

    private static string Text(IReadOnlyList<string> texte, int? platz, string leer)
        => platz is int p && p >= 0 && p < texte.Count ? texte[p] : leer;

    /// <summary>Die acht Felder der Gruppe — Auswahl und Zahlen, leer = Vorgabe (Platzhalter).</summary>
    private RenderFragment Teillastfelder(KaeltemaschineDaten d) => __builder =>
    {
        <Formularraster>
            <KindInhalt>
                <Auswahlfeld Bezeichnung="@Texte.LabelTeillastWeg" Eintraege="@Eintraege(Texte.TeillastWege)"
                             Platzhalter="@Texte.TeillastWegBestand"
                             Auswahl="@d.TeillastWegIndex" AuswahlChanged="w => Feld(d, () => d.TeillastWegIndex = w)" />
                <Auswahlfeld Bezeichnung="@Texte.LabelVerdichterregelung" Eintraege="@Eintraege(Texte.Verdichterregelungen)"
                             Platzhalter="@Texte.RegelungKeine"
                             Auswahl="@d.VerdichterregelungIndex" AuswahlChanged="w => Feld(d, () => d.VerdichterregelungIndex = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelKurveA" Feldname="@Texte.LabelKurveA" Platzhalter="@Texte.PlatzhalterVorgabe"
                            Wert="@d.KurveA" WertChanged="w => Feld(d, () => d.KurveA = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelKurveB" Feldname="@Texte.LabelKurveB" Platzhalter="@Texte.PlatzhalterVorgabe"
                            Wert="@d.KurveB" WertChanged="w => Feld(d, () => d.KurveB = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelKurveC" Feldname="@Texte.LabelKurveC" Platzhalter="@Texte.PlatzhalterVorgabe"
                            Wert="@d.KurveC" WertChanged="w => Feld(d, () => d.KurveC = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelKurveLastgradMin" Feldname="@Texte.LabelKurveLastgradMin"
                            Platzhalter="@Texte.PlatzhalterVorgabe"
                            Wert="@d.KurveLastgradMin" WertChanged="w => Feld(d, () => d.KurveLastgradMin = w)" />
                <Zahlenfeld Bezeichnung="@Texte.LabelCd" Feldname="@Texte.LabelCd" Platzhalter="@Texte.PlatzhalterCd"
                            Wert="@d.Cd" WertChanged="w => Feld(d, () => d.Cd = w)" />
                <Auswahlfeld Bezeichnung="@Texte.LabelRandweg" Eintraege="@Eintraege(Texte.Randwege)"
                             Platzhalter="@Texte.PlatzhalterRandweg"
                             Auswahl="@d.RandwegIndex" AuswahlChanged="w => Feld(d, () => d.RandwegIndex = w)" />
            </KindInhalt>
        </Formularraster>
    };

    /// <summary>Verweis, Lesezeile, Nenn-EER-Hinweis, kleine Kurve, Schnellwahlen und Auskunft zum Stand <paramref name="d"/>.</summary>
    private RenderFragment Teillastlesung(KaeltemaschineDaten d) => __builder =>
    {
        <p class="epos-leisezeile">@Texte.VerweisMindestteillast</p>
        @if (Lesezeile is not null)
        {
            KaeltemaschineTeillastLesestand l = Lesezeile(d);
            <p class="epos-leisezeile epos-kaeltemaschine-lesezeile">@LesezeileText(l)</p>
            @if (l.Hinweis.Length > 0)
            {
                <p class="epos-leisezeile epos-kaeltemaschine-teillasthinweis">@l.Hinweis</p>
            }
        }
        @if (NennEerHinweis?.Invoke(d) is string nenn && nenn.Length > 0)
        {
            <Warnbanner Stufe="WarnStufe.Hinweis" Text="@nenn" />
        }
        @if (Teillastbild is not null)
        {
            <DiagrammSvg Modell="@Teillastbild(d)" Kennung="km-teillast" Bezeichnung="@Texte.BildTeillast" />
        }
        <div class="epos-knopfreihe epos-kaeltemaschine-schnellwahl">
            @if (!_auslieferung && KurveAusTypkennfeld is not null && TypkennfeldVorhanden)
            {
                <button type="button" class="epos-textknopf" @onclick="() => TypwahlOeffnen(Typwahl.Kurve)">@Texte.KnopfKurveTypkennfeld</button>
            }
            @if (Skalieren is not null && Speichern is not null && TypkennfeldVorhanden)
            {
                <button type="button" class="epos-textknopf" @onclick="() => TypwahlOeffnen(Typwahl.Skalieren)">@Texte.KnopfSkalieren</button>
            }
            @if (Auskunft is not null)
            {
                <button type="button" class="epos-textknopf" @onclick="AuskunftOeffnen">@Texte.KnopfTeillastpunkte</button>
