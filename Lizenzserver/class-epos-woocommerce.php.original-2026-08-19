<?php
/**
 * WooCommerce-Integration für "Mein Konto" (/mein-konto/):
 *
 * 1. Der Menüpunkt "Lizenzschlüssel" zeigt die EPOS-Lizenzverwaltung
 *    (dieselbe Ansicht wie das Lizenzportal) statt des leeren
 *    "License Manager for WooCommerce"-Endpunkts (view-license-keys).
 * 2. Die Konto-Startseite (Dashboard) erhält einen deutschen Begrüßungstext
 *    mit Kontakt per E-Mail (info@inekon.de) statt des englischen
 *    Platzhaltertexts mit Telefonnummer.
 */

if ( ! defined( 'ABSPATH' ) ) {
	exit;
}

class Epos_Woocommerce {

	const ENDPUNKT = 'epos-lizenz';
	const KONTAKT_EMAIL = 'info@inekon.de';

	public static function init() {
		self::endpunkt_registrieren();

		add_filter( 'woocommerce_account_menu_items', array( __CLASS__, 'menue_anpassen' ), 99 );
		add_action( 'woocommerce_account_' . self::ENDPUNKT . '_endpoint', array( __CLASS__, 'endpunkt_inhalt' ) );
		add_filter( 'woocommerce_endpoint_' . self::ENDPUNKT . '_title', array( __CLASS__, 'endpunkt_titel' ) );

		// Deutsche Konto-Startseite (überschreibt auch Theme-Vorlagen)
		add_filter( 'wc_get_template', array( __CLASS__, 'dashboard_vorlage' ), 99, 2 );
	}

	public static function endpunkt_registrieren() {
		add_rewrite_endpoint( self::ENDPUNKT, EP_ROOT | EP_PAGES );
	}

	/**
	 * "Lizenzschlüssel" auf unseren Endpunkt umbiegen; den Menüpunkt des
	 * License-Manager-Plugins (view-license-keys) dabei ersetzen.
	 */
	public static function menue_anpassen( $items ) {
		$neu = array();
		$eingefuegt = false;

		foreach ( $items as $slug => $beschriftung ) {
			if ( 'view-license-keys' === $slug ) {
				$neu[ self::ENDPUNKT ] = 'Lizenzschlüssel';
				$eingefuegt = true;
				continue;
			}
			$neu[ $slug ] = $beschriftung;
			// Falls kein License-Manager-Eintrag existiert: hinter "Bestellungen" einfügen
			if ( ! $eingefuegt && 'orders' === $slug ) {
				$neu[ self::ENDPUNKT ] = 'Lizenzschlüssel';
				$eingefuegt = true;
			}
		}
		if ( ! $eingefuegt ) {
			$neu[ self::ENDPUNKT ] = 'Lizenzschlüssel';
		}
		return $neu;
	}

	public static function endpunkt_titel( $titel ) {
		return 'Lizenzschlüssel';
	}

	/** Inhalt des Tabs: die EPOS-Lizenzverwaltung (wie im Lizenzportal). */
	public static function endpunkt_inhalt() {
		echo Epos_Portal::shortcode(); // phpcs:ignore -- erzeugt escaptes HTML
	}

	/** Eigene deutsche Dashboard-Vorlage für die Konto-Startseite. */
	public static function dashboard_vorlage( $template, $template_name ) {
		if ( 'myaccount/dashboard.php' === $template_name ) {
			$eigene = EPOS_LIZENZ_DIR . 'templates/myaccount-dashboard.php';
			if ( file_exists( $eigene ) ) {
				return $eigene;
			}
		}
		return $template;
	}
}


