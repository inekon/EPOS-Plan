@* Abschnitt „Ertrag/Bonus" der Kostenverwaltung (iU9-W4.1).

   Vorbild: Views/Kosten/ucErtragBonus.cs (217 Z.) und .Designer.cs — Etappe
   KD5, Konzept Kostendialoge § 6. Der Abschnitt ist REINE ANZEIGE vorhandener
   Wahrheiten, keine Zweitpflege:

   * BHKW (§ 6.1): KWKG-Zuschlagstabelle, Sonderregel, selbst genutzter Strom,
     Foerderdauer samt Jahresdeckel und die Steuerverguenstigungen — alles aus
     DENSELBEN Katalogschluesseln, mit denen der KwkgSatzRechner rechnet
     (Abnahmekriterium KD5). Dazu der Sprung in den Gesetzeskatalog.
   * Photovoltaik (§ 6.2, Konzept Wirtschaftlichkeit § 2.16): der Einstieg in den
     Verguetungsdialog und die WAHL der Variante - „vom Stammprojekt uebernehmen"
     (Vorgabe) oder „eigene Verguetung" - mit ihrer Erklaerzeile. Ein Stammprojekt
     fuehrt immer eigene Werte und bekommt statt der Wahl die Zeile, wie viele
     Varianten seine Verguetung uebernehmen. Im Admin-Kontext waehlt eine Klappliste
     das Projekt (VV-Q7); im Projektmodus steht der Stand fest, dort entfaellt sie.
   * Alle uebrigen Komponenten (§ 6.3, FK5): der Abschnitt erscheint gar nicht;
     der Wirt fragt vorher HatInhalt.

   DIE ZAHLEN KOMMEN FERTIG HEREIN. Der Vorlaeufer las den GesetzKatalog selbst
   und baute daraus fuenf Textbloecke; das ist Datenseite und liegt jetzt in der
   Huelle (Hausregel: keine Datenbank in EPOS.UI). Die Komponente bekommt die
   fertigen Saetze und zeigt sie — auf iOS dieselbe Komponente mit denselben
   Texten aus demselben Controller. *@

@namespace EPOS.UI.Dialoge.Kosten
@using EPOS.UI.Dialoge.Allgemein

<div class="epos-ertragbonus">

    @if (IstBhkw)
    {
        <Gruppenkopf Titel="@TitelKwkg">
            <KindInhalt>
                <p class="epos-untergruppe">@TitelEinspeisung</p>
                <pre class="epos-ertrag-tabelle">@EinspeisungText</pre>
                <Herleitungszeile Text="@SonderregelText" />
                <Herleitungszeile Text="@EigenText" />
            </KindInhalt>
        </Gruppenkopf>

        <Gruppenkopf Titel="@TitelDauer">
            <KindInhalt>
                <Herleitungszeile Text="@DauerText" />
            </KindInhalt>
        </Gruppenkopf>

        <Gruppenkopf Titel="@TitelSteuern">
            <KindInhalt>
                <p class="epos-ertrag-absatz">@SteuernText</p>
            </KindInhalt>
        </Gruppenkopf>

        <Gruppenkopf Titel="@TitelVerweise">
            <KindInhalt>
                @if (GesetzeGewuenscht.HasDelegate)
                {
                    <button type="button" class="epos-knopf" @onclick="BeiGesetze">@GesetzeText</button>
                }
                <Herleitungszeile Text="@Fk7Text" />
            </KindInhalt>
        </Gruppenkopf>
    }

    @if (IstPv)
    {
        <Gruppenkopf Titel="@TitelPv">
            <KindInhalt>
                <Herleitungszeile Text="@PvErklaerungText" />

                @* KONZEPT § 2.16 - die Wahl je VARIANTE. Ein Stammprojekt fuehrt
                   immer eigene Werte; es bekommt statt der Optionsgruppe die Zeile,
                   wie viele Varianten seine Verguetung uebernehmen. *@
                @if (IstVariante)
                {
                    <Formularraster>
                        <KindInhalt>
                            <Optionsgruppe Bezeichnung="@LabelPvWahl" Eintraege="@_wahlen"
                                           Auswahl="@(Uebernommen ? UEBERNEHMEN : EIGENE)"
                                           AuswahlChanged="BeiWahl" />
                        </KindInhalt>
                    </Formularraster>
                }
                @if (!string.IsNullOrEmpty(HerkunftText))
                {
                    <Herleitungszeile Text="@HerkunftText" />
                }

                @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben
                   dem Feld. Die Ertragstafel und die Herleitungszeilen bleiben
                   Text - sie sind Ergebnis, kein Formularblock.

                   VV-Q7: Die Liste fuehrt ALLE Projekte und gehoert deshalb in den
                   Admin-Kontext (Kostendialog ohne geoeffnetes Projekt). Im
                   Projektmodus steht der Stand fest - dort waere sie eine zweite
                   Projektwahl neben der, die der Anwender schon getroffen hat. *@
                @if (ProjektlisteZeigen)
                {
                    <Formularraster>
                        <KindInhalt>
                            <Auswahlfeld Bezeichnung="@LabelPvProjekt" Eintraege="@Projekte"
                                         Auswahl="@_projektId" AuswahlChanged="BeiProjekt" />
                        </KindInhalt>
                    </Formularraster>
                }

                <button type="button" class="epos-knopf" disabled="@KnopfGesperrt"
                        @onclick="BeiPvOeffnen">@PvOeffnenText</button>

                @* ETAPPE E2 (Mockup-Pruefung 03/#29): Der Knopf in die
                   Gesetzesparameter stand nur im BHKW-Zweig. Die EEG-Saetze der
                   Photovoltaik stehen in demselben Katalog - anzulegender Wert,
                   Degression, Ausfallverguetung -, und der Rueckruf ist fuer die
                   ganze Komponente verdrahtet. Die Wache bleibt dieselbe wie oben:
                   kein Delegat, kein Knopf. *@
                @if (GesetzeGewuenscht.HasDelegate)
                {
                    <button type="button" class="epos-knopf" @onclick="BeiGesetze">@GesetzeText</button>
                }
            </KindInhalt>
        </Gruppenkopf>
    }

    @if (!IstBhkw && !IstPv)
    {
        <Herleitungszeile Text="@LeerText" />
    }
</div>

@code {
    /// <summary>Der Traeger ist ein BHKW (<c>DbWerte.KOSTEN_KOMPONENTE_BHKW</c>).</summary>
    [Parameter] public bool IstBhkw { get; set; }

    /// <summary>Der Traeger ist eine Photovoltaikanlage.</summary>
    [Parameter] public bool IstPv { get; set; }

    // ---- BHKW: die fertigen Saetze aus dem Gesetzeskatalog ---------------

    /// <summary>Die Tranchentabelle (<c>lblEinspeisung</c>), Zeile je Tranche.</summary>
    [Parameter] public string EinspeisungText { get; set; } = "";

    /// <summary>Sonderregel § 7 Abs. 3a (<c>lblSonderregel</c>).</summary>
    [Parameter] public string SonderregelText { get; set; } = "";

    /// <summary>Selbst genutzter KWK-Strom § 7 Abs. 2 (<c>lblEigen</c>).</summary>
    [Parameter] public string EigenText { get; set; } = "";

    /// <summary>Foerderkontingent und Jahresdeckel (<c>lblDauer</c>).</summary>
    [Parameter] public string DauerText { get; set; } = "";

    /// <summary>Die drei Steuerabsaetze (<c>lblSteuern</c>).</summary>
    [Parameter] public string SteuernText { get; set; } = "";

    /// <summary>Der FK7-Vermerk (<c>lblFk7</c>).</summary>
    [Parameter] public string Fk7Text { get; set; } = "";

    // ---- Photovoltaik ----------------------------------------------------

    /// <summary>Die waehlbaren Stammprojekte (<c>cmbPvProjekt</c>).</summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Projekte { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Vorwahl in der Projektliste; <c>null</c> = das erste.</summary>
    [Parameter] public int? ProjektVorwahl { get; set; }

    /// <summary>Erklaerungssatz ueber der Liste (<c>lblPvErklaerung</c>).</summary>
    [Parameter] public string PvErklaerungText { get; set; } = "";

    /// <summary>„PV-Verguetungsdialog oeffnen…" mit dem gewaehlten Stammprojekt.</summary>
    [Parameter] public EventCallback<int> PvOeffnen { get; set; }

    // ---- KONZEPT § 2.16: die Verguetungswahl je Variante ------------------

    /// <summary>
    /// Ist das geoeffnete Projekt eine VARIANTE? Nur dann gibt es eine Wahl — ein
    /// Stammprojekt fuehrt immer eigene Werte. <c>false</c> ist auch der
    /// Admin-Kontext (kein Projekt geoeffnet).
    /// </summary>
    [Parameter] public bool IstVariante { get; set; }

    /// <summary>Uebernimmt diese Variante die Verguetung ihres Stamms? Vorgabe
    /// <c>true</c> — keine Zeile heisst uebernehmen.</summary>
    [Parameter] public bool Uebernommen { get; set; } = true;

    /// <summary>
    /// Die neue Wahl (<c>true</c> = uebernehmen). Die HUELLE schreibt sie — diese
    /// Komponente kennt keine Datenbank. „Eigene Verguetung" legt dabei die
    /// Stammwerte vor (VV‑Q6) und oeffnet den Verguetungsdialog.
    /// </summary>
    [Parameter] public EventCallback<bool> WahlGeaendert { get; set; }

    /// <summary>
    /// Nach der Wahl baut der WIRT die Gaben dieses Blatts neu — derselbe Weg wie
    /// nach dem Gesetzeskatalog. Ohne Rueckruf bleibt die Anzeige, wie sie war.
    /// </summary>
    [Parameter] public EventCallback NeuLaden { get; set; }

    /// <summary>
    /// Die Erklaerzeile unter der Wahl: „uebernommen von ‹Stamm› · anzulegender Wert
    /// ‹AW› ct/kWh, ‹Vermarktungsform›" bzw. „eigene Werte dieser Variante"; beim
    /// Stamm „Stammprojekt — ‹n› Varianten uebernehmen diese Verguetung". Sie kommt
    /// FERTIG herein, wie jeder andere Satz dieses Blatts.
    /// </summary>
    [Parameter] public string HerkunftText { get; set; } = "";

    /// <summary>
    /// Zeigt die Klappliste aller Projekte? <c>true</c> = Admin-Kontext (Vorgabe,
    /// VV‑Q7); im Projektmodus setzt die Huelle <c>false</c> — dort steht der Stand
    /// fest.
    /// </summary>
    [Parameter] public bool ProjektlisteZeigen { get; set; } = true;

    // ---- Weiterfuehren ---------------------------------------------------

    /// <summary>
    /// Der Wunsch nach dem Gesetzeskatalog (iU9-W14c.3). <b>Bis W14c war das ein
    /// Sprung</b> (<c>Sprungziel.Gesetzesparameter</c> über die
    /// <c>Sprungbruecke</c>) — seit der Katalog selbst eine Razor-Komponente ist,
    /// wäre daraus ein zweiter WebView über dem ersten geworden (Risiko R2).
    ///
    /// <para>Diese Komponente ist KEIN Fenster, sondern ein Reiterblatt in
    /// <c>KostenKomponenteDialog</c>. Sie kann eine Überlagerung deshalb nicht selbst
    /// öffnen; sie meldet den Wunsch nach oben, und der Wirt zeigt den Katalog. Ohne
    /// Rückruf bleibt der Knopf weg (A-18 aus Welle 2 — ein Knopf, der nichts tut, ist
    /// eine Behauptung, die nicht stimmt).</para>
    /// </summary>
    [Parameter] public EventCallback GesetzeGewuenscht { get; set; }

    // ---- Texte -----------------------------------------------------------

    [Parameter] public string TitelKwkg { get; set; }
        = "KWKG-Zuschlag (§ 7 KWKG 2025) — Anzeige aus dem Gesetzeskatalog";
    [Parameter] public string TitelEinspeisung { get; set; } = "Eingespeister KWK-Strom (Tranchen):";
    [Parameter] public string TitelDauer { get; set; } = "Förderdauer und Jahresdeckel";
    [Parameter] public string TitelSteuern { get; set; }
        = "Steuervergünstigungen (HF6, Sätze aus dem Gesetzeskatalog)";
    [Parameter] public string TitelVerweise { get; set; } = "Pflegeorte (eine Wahrheit je Größe)";
    [Parameter] public string GesetzeText { get; set; } = "Gesetzesparameter…";
    [Parameter] public string TitelPv { get; set; }
        = "PV-Vergütung (EEG) — eine Vergütungswahrheit (V4/F7)";
    [Parameter] public string LabelPvProjekt { get; set; } = "Projekt:";
    [Parameter] public string LabelPvWahl { get; set; } = "Vergütung:";
    [Parameter] public string UebernehmenText { get; set; } = "vom Stammprojekt übernehmen";
    [Parameter] public string EigeneText { get; set; } = "eigene Vergütung";
    [Parameter] public string PvOeffnenText { get; set; } = "PV-Vergütungsdialog öffnen…";
    [Parameter] public string LeerText { get; set; }
        = "Diese Komponente führt keine laufenden Erträge — Förderungen/Zuschüsse "
        + "laufen als Zuschuss-Position in den Investitionskosten (FK5).";

    private int? _projektId;

    /// <summary>Die zwei Optionen — die Reihenfolge ist die des Mockups: erst die
    /// Vorgabe „übernehmen", dann „eigene Vergütung".</summary>
    private const int UEBERNEHMEN = 0;
    private const int EIGENE = 1;

    private IReadOnlyList<(int Id, string Text)> _wahlen
        => new[] { (UEBERNEHMEN, UebernehmenText), (EIGENE, EigeneText) };

    /// <summary>Das gewaehlte Stammprojekt (Pruefhilfe fuer Tests).</summary>
    public int? GewaehltesProjekt => _projektId;

    // ---------------------------------------------------------------------------------
    // Der Zugang des Hilfe-Assistenten (Welle KI-F7): Der WIRT meldet an, nicht das
    // Blatt darin (Hausregel EPOS.UI) - er braucht dafuer die drei Wege hierher.
    // ---------------------------------------------------------------------------------

    /// <summary>
    /// Die zwei Eintraege der Verguetungswahl — dieselbe Liste, die die Optionsgruppe
    /// zeichnet.
    /// </summary>
    public IReadOnlyList<(int Id, string Text)> Verguetungswahlen => _wahlen;

    /// <summary>
    /// Die gewaehlte Verguetung als Listenplatz: 0 = vom Stammprojekt uebernehmen,
    /// 1 = eigene Verguetung.
    /// </summary>
    public int Verguetungswahl => Uebernommen ? UEBERNEHMEN : EIGENE;

    /// <summary>
    /// Waehlt ein Stammprojekt — derselbe Weg wie ein Griff in die Klappliste. Er laedt
    /// nichts nach: Die Wahl bestimmt allein das Ziel des Knopfes
    /// „PV-Verguetungsdialog oeffnen…".
    /// </summary>
    public void ProjektWaehlen(int? id) => BeiProjekt(id);

    protected override void OnParametersSet()
    {
        if (_projektId.HasValue) return;
        _projektId = ProjektVorwahl ?? (Projekte.Count > 0 ? Projekte[0].Id : null);
    }

    private void BeiProjekt(int? id) => _projektId = id;

    /// <summary>
    /// Der Knopf ist gesperrt, solange kein Ziel feststeht. Im Projektmodus ist das
    /// geoeffnete Projekt das Ziel — dort genuegt die Vorwahl; im Admin-Kontext
    /// braucht es einen Eintrag in der Liste.
    /// </summary>
    private bool KnopfGesperrt => !_projektId.HasValue;

    private Task BeiPvOeffnen()
        => _projektId.HasValue ? PvOeffnen.InvokeAsync(_projektId.Value) : Task.CompletedTask;

    /// <summary>
    /// Die Wahl geht an die Hülle (sie schreibt) und danach an den Wirt (er baut die
    /// Gaben neu) — dieselbe Arbeitsteilung wie beim Gesetzeskatalog. Eine Wahl, die
    /// schon steht, löst nichts aus: „eigene Vergütung" öffnet sonst bei jedem
    /// Neuzeichnen den Vergütungsdialog.
    /// </summary>
    private async Task BeiWahl(int? nummer)
    {
        bool uebernehmen = nummer != EIGENE;
        if (uebernehmen == Uebernommen) return;

        Uebernommen = uebernehmen;
        await WahlGeaendert.InvokeAsync(uebernehmen);
        await NeuLaden.InvokeAsync();
    }

    /// <summary>
    /// Wie <c>btnGesetze_Click</c>: Der Wirt öffnet den Katalog und lädt danach die
    /// Gaben dieses Reiterblatts neu — der Vorläufer rief nach dem Sprung selbst
    /// <c>BhkwFuellen</c> erneut.
    /// </summary>
    private Task BeiGesetze() => GesetzeGewuenscht.InvokeAsync();
}
