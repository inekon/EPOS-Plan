    private void KatalogNeuLaden()
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, Texte.Titel, out _listeFehler);
        VerwendungStempeln();
        _katalogZeile = _katalog.FirstOrDefault(z => z.Schluessel == _katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
        _bilder.Clear();
    }

    /// <summary>Die Verwendungsmarke „im Projekt": über den Gerätenamen der Projektkopie.</summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Sichtbare.Select(z => z.Arbeit.Geraet?.Bezeichner ?? z.Arbeit.Bezeichner));

    private IReadOnlyList<string> ProjektSchluessel() => Sichtbare.Select(z => z.Schluessel).ToList();

    private IReadOnlyList<string> KatalogSichtbar()
        => (_katalogliste?.Angezeigt ?? _katalog).Select(z => z.Schluessel).ToList();

    /// <summary>Die Ziele einer Projektaktion: die angekreuzten Zeilen, sonst die gewählte.</summary>
    private List<Zeile> ProjektZiele()
    {
        if (_projektWahl.Anzahl > 0)
            return _projektWahl.Gewaehlte.Select(s => Sichtbare.FirstOrDefault(z => z.Schluessel == s)).OfType<Zeile>().ToList();
        return Aktuell is Zeile a ? new() { a } : new();
    }

    /// <summary>Die Ziele einer Katalogaktion: die angekreuzten Sätze, sonst der gewählte.</summary>
    private List<Katalogfilterzeile> KatalogZiele()
    {
        if (_katalogWahl.Anzahl > 0)
            return _katalogWahl.Gewaehlte.Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s)).OfType<Katalogfilterzeile>().ToList();
        return _katalogZeile is null ? new() : new() { _katalogZeile };
    }

    /// <summary>
    /// Klick in eine Projektzeile (AW3b, wie Heizkessel): Die Zeile wird der gewählte Satz, die Detailzeile folgt;
    /// die Kästchen der Mehrfachwahl bleiben unberührt — wie in der Katalogliste.
    /// </summary>
    private void ProjektZeileKlick(Zeile zeile)
    {
        if (zeile.Schluessel != _gewaehlt) ProjektZeileWaehlen(zeile);
    }

    /// <summary>Die Hervorhebung der gewählten Projektzeile — dieselbe Klasse wie in der Katalogliste.</summary>
    private string? ProjektZeilenklasse(Zeile zeile) => zeile.Schluessel == _gewaehlt ? "epos-zeile--gewaehlt" : null;

    /// <summary>↑ ↓ Pos1 Ende in der Projektliste: die Regel rechnet der Baustein.</summary>
    private Task BeiProjektTaste(KeyboardEventArgs e)
        => _zweispalten is null ? Task.CompletedTask : _zweispalten.ProjektTasteAsync(e.Key);

    /// <summary>Die Tastenführung hat eine andere Projektzeile gewählt.</summary>
    private void BeiProjektTastenwahl(string schluessel)
    {
        if (Sichtbare.FirstOrDefault(z => z.Schluessel == schluessel) is Zeile zeile) ProjektZeileKlick(zeile);
    }

    /// <summary>
    /// Der Grund der weichen Sperre von Schloss… und Löschen (AW3b): Sie wirken nur auf Katalogsätze; steht ein
    /// Projektsatz, nennen sie „Katalogsatz wählen".
    /// </summary>
    private string? KatalogSperrgrund => SatzArt == Satzmarke.Projektsatz ? Resource.AUSWAHL_SPERRE_KATALOGSATZ : null;

    private void BeiWahlGeaendert(Auswahlbereich bereich)
    {
        if (bereich != Auswahlbereich.Projekt || _projektWahl.Zuletzt is not string s) return;
        if (!_projektWahl.IstGewaehlt(s)) return;
        if (Sichtbare.FirstOrDefault(z => z.Schluessel == s) is Zeile zeile && zeile.Schluessel != _gewaehlt) ProjektZeileWaehlen(zeile);
    }

    private void BeiKatalogKaestchen(IReadOnlyList<string> gewaehlt)
    {
        _katalogKaestchen = gewaehlt;
        _katalogWahl.Setzen(gewaehlt);
    }

    private void KatalogKaestchenLeeren()
    {
        _katalogWahl.Leeren();
        _katalogKaestchen = new List<string>();
    }

    /// <summary>Wählt eine Anlage (auch der Weg des Assistenten); der Katalogsatz tritt zurück.</summary>
    private void Waehlen(string schluessel)
    {
        if (Sichtbare.FirstOrDefault(z => z.Schluessel == schluessel) is Zeile z) ProjektZeileWaehlen(z);
    }

    private void ProjektZeileWaehlen(Zeile zeile)
    {
        _gewaehlt = zeile.Schluessel;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _katalogWerte = null;
        _satzFehler = "";
        KostenNachziehen();
    }

    private void KatalogZeileWaehlen(string schluessel)
    {
        _katalogGewaehlt = schluessel ?? "";
        _katalogZeile = _katalog.FirstOrDefault(z => z.Schluessel == _katalogGewaehlt);
        _gewaehlt = "";
        _kosten = null;
        _katalogWerte = _katalogZeile is Katalogfilterzeile k
            ? Katalogladung.Satz(() => Katalogwerte?.Invoke(k.Id), k.Bezeichner, out _satzFehler)
            : null;
        if (_katalogZeile is null) _satzFehler = "";
    }

    private bool KatalogsatzGesperrt => _katalogZeile?.Geschuetzt == true;

    private KaeltemaschineGeraetwerte? SatzGeraet => Aktuell is Zeile a ? a.Arbeit.Geraet ?? new KaeltemaschineGeraetwerte { Bezeichner = a.Arbeit.Bezeichner }
                                                   : _katalogZeile is not null ? _katalogWerte ?? new KaeltemaschineGeraetwerte { Bezeichner = _katalogZeile.Bezeichner }
                                                   : null;

    private Satzmarke SatzArt => Aktuell is not null ? Satzmarke.Projektsatz
                               : _katalogZeile is not null ? Satzmarke.Katalogsatz : Satzmarke.Keiner;

    private string? SatzName => Aktuell?.Arbeit.Bezeichner ?? _katalogZeile?.Bezeichner;

    /// <summary>Die Kenndaten der zugeklappten Detailzeile: die ersten drei Angaben, beim gesperrten Satz der Hinweis.</summary>
    private string? SatzKenndaten
    {
        get
        {
            if (SatzArt == Satzmarke.Keiner) return null;
            var teile = Zusammenfassung().Take(3).Select(a => a.Beschriftung + " " + a.Wert).ToList();
            if (KatalogsatzGesperrt) teile.Add(Resource.AUSWAHL_SATZ_NUR_LESEN);
            return string.Join(" · ", teile);
        }
    }

    private RenderFragment MarkeKatalogsatz => @<span class="epos-zweispalten-marke epos-zweispalten-marke--satz">@Resource.AUSWAHL_MARKE_KATALOGSATZ</span>;

    /// <summary>
    /// <b>Die Zusammenfassung des gewählten Satzes</b> (UeS2): beim Projektsatz Nennkälteleistung, EER, Rückkühlart,
    /// Anzahl, Kühlträger, Zähler und die Kosten; beim Katalogsatz Hersteller, Nennkälteleistung, EER, Rückkühlart
    /// und Geräteart aus den Spalten der Katalogliste.
    /// </summary>
    internal IReadOnlyList<Satzangabe> Zusammenfassung()
    {
        var liste = new List<Satzangabe>();
        if (Aktuell is Zeile a)
        {
            KaeltemaschineAnlageDaten d = a.Arbeit;
            KaeltemaschineGeraetwerte? g = d.Geraet;
            if (g?.Nennkaelteleistung is double kw)
            {
                liste.Add(new(Texte.LabelNennkaelteleistung, Satzangaben.Zahl(kw, Texte.EinheitKw)));
                if ((d.Anzahl ?? 1) > 1)
                    liste.Add(new(Resource.AUSWAHL_ZF_LEISTUNG_GESAMT, Satzangaben.Zahl(kw * (d.Anzahl ?? 1), Texte.EinheitKw)));
            }
            if (EerText(g) is { Length: > 0 } eer) liste.Add(new(Texte.SpalteEer, eer));
            if (!string.IsNullOrWhiteSpace(g?.Rueckkuehlart)) liste.Add(new(Texte.LabelRueckkuehlart, g!.Rueckkuehlart));
            liste.Add(new(Resource.AUSWAHL_ZF_ANZAHL, AnzahlText(d)));
            if (TraegerText(d) is { Length: > 0 } traeger) liste.Add(new(Texte.LabelTraeger, traeger));
            liste.Add(new(Texte.LabelZaehler, d.KuehlEigenerZaehler ? Texte.Ja : Texte.Nein));
            Satzangaben.Kosten(liste, _kosten);
        }
        else if (_katalogZeile is Katalogfilterzeile z)
        {
            Satzangaben.Katalog(liste, z, Profil, Katalogfilterprofil.SpHersteller, Katalogfilterprofil.SpNennkaelteleistung,
                                Katalogfilterprofil.SpEer, Katalogfilterprofil.SpRueckkuehlart, Katalogfilterprofil.SpGeraeteart);
        }
        return liste;
    }

    private void KostenNachziehen()
    {
        _kosten = null;
        if (Kostensumme is null || Aktuell is not Zeile a || a.Arbeit.AnlagenId <= 0) return;
        // KT-8c: über die Fangstelle — wirft die Summe, fehlt die Angabe, und der Banner nennt den Grund.
        Func<int, (double Invest, double Betrieb)> summe = Kostensumme;
        int anlagenId = a.Arbeit.AnlagenId;
        _kosten = Katalogladung.Wert<(double Invest, double Betrieb)?>(() => summe(anlagenId), a.Arbeit.Bezeichner, null,
                                                                      out string kostenGrund);
        if (kostenGrund.Length > 0) Melden(kostenGrund, true);
    }

    /// <summary>
    /// KT-8c: Der Weg in die Kostenverwaltung läuft über die Fangstelle
    /// (<c>Katalogladung.SchreibenAsync</c>): Wirft er, nennt der Banner den Grund, das Protokoll
    /// hat einen Vermerk, und der Dialog bleibt offen.
    /// </summary>
    private async Task BeiKosten(Zeile zeile, bool betrieb)
    {
        if (KostenOeffnen is null || zeile.Arbeit.AnlagenId <= 0) return;
        Func<int, bool, Task> oeffnen = KostenOeffnen;
        string grund = await Katalogladung.SchreibenAsync(async () => { await oeffnen(zeile.Arbeit.AnlagenId, betrieb); return ""; },
                                                          zeile.Arbeit.Bezeichner, g => g);
        if (grund.Length > 0) { Melden(grund, true); StateHasChanged(); }
    }

