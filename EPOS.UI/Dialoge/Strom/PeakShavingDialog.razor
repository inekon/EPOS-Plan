    // Stammblatt: Kopf
    // =====================================================================

    /// <summary>„Projekt · 35 040 Werte · berechnet".</summary>
    private string Unterzeile
    {
        get
        {
            if (Fokuszeile is null) return "";
            var k = CultureInfo.CurrentCulture;
            var teile = new List<string>();
            string quelle = Fokuszeile.Text(Katalogfilterprofil.SpQuelle);
            if (quelle.Length > 0 && quelle != ParameterVerwendung.LEER) teile.Add(quelle);
            if (_lastgang is not null && _lastgang.Length > 0)
                teile.Add(string.Format(k, Resource.PEAK_SB_WERTE, _lastgang.Length.ToString("N0", k)));
            else teile.Add(TextKeineReihe);
            teile.Add(_ergebnis is not null ? Resource.PEAK_SB_BERECHNET : Resource.PEAK_SB_OFFEN);
            return string.Join(" · ", teile);
        }
    }

    /// <summary>Die Spitze ohne Speicher, nach dem Lauf dazu die Spitze mit Speicher und der Ertrag.</summary>
    private IReadOnlyList<Stammblattkennzahl> Kopfkennzahlen
    {
        get
        {
            var k = CultureInfo.CurrentCulture;
            if (_ergebnis is not null)
                return new[]
                {
                    new Stammblattkennzahl(_ergebnis.PAltMaxKw.ToString("N0", k) + " kW", Resource.PEAK_KZ_KOPF_ALT),
                    new Stammblattkennzahl(_ergebnis.PNeuMaxKw.ToString("N0", k) + " kW", Resource.PEAK_KZ_KOPF_NEU),
                    new Stammblattkennzahl(_ergebnis.ErtragPsEur.ToString("N0", k) + " €", Resource.PEAK_KZ_KOPF_ERTRAG)
                };
            if (_lastgang is not null && _lastgang.Length > 0)
                return new[] { new Stammblattkennzahl(Maximum(_lastgang).ToString("N0", k) + " kW", Resource.PEAK_KZ_KOPF_ALT) };
            return Array.Empty<Stammblattkennzahl>();
        }
    }

