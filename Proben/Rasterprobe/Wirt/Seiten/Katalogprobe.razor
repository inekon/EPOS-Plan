@page "/katalogprobe"
@using Microsoft.AspNetCore.WebUtilities
@using EPOS.UI.Dialoge.Klimadaten
@using EPOS.UI.Dialoge.Bedarf
@using EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Solarthermie
@using EPOS.UI.Dialoge.Waermepumpe
@using EPOS.UI.Dialoge.Strom
@inject NavigationManager Navigation

@*  DIE KATALOGPROBE (Auftrag KL-5).

    Sie stellt einen GANZEN Katalogdialog - Rahmen, Liste und Eingabeblock -
    in den Browser, damit sich messen laesst, was bunit nicht misst: WO die
    Kaesten liegen. Der Anwenderbefund ist eine UEBERLAGERUNG (Reiterleiste
    und Diagrammkasten malen ueber die Listenzeilen, der Eingabeblock ueber
    die Fussleiste); ohne Layout ist sie nicht zu sehen.

    Gaben ueber die Adresse:
      ?maske=klima|bedarf|modul|waermebedarf|solar|browser|waermepumpe|
             stromganglinie|rahmen|gebaeude|gebaeudetyp|peak|
             tww|wohnungen|kategorien  (Zapfprofilgenerator, Stufe Z4)|
             projekt-heizkessel|projekt-gebaeude  (Projektdialoge; gebaeude ist
             die Verwaltung, projekt-gebaeude der Gebaeudedialog des Projekts)
      ?zeilen=35   Wie viele Katalogzeilen die Liste traegt.
      ?bilder=1|0  Nur fuer klima: Diagramme befuellt (nach dem Import) oder
                   Platzhalter (davor). Vor dem Import war das Bild in Ordnung.
      ?art=...     Die Auspraegung (Neuordnung Stufe 1): fuer browser
                   heizkessel|bhkw|solarkollektoren|pufferspeicher, fuer modul
                   photovoltaik|wechselrichter|stromspeicher, fuer bedarf
                   brauchwasser|prozesswaerme|stromverbraucher, fuer kategorien
                   lesen (gesperrte Nutzungsart). Ohne Angabe
                   der Stand von KL-5 (BHKW, Photovoltaik, Stromverbraucher).
      ?voll=1      JEDE Spalte des Profils belegt, in den Textlaengen der
                   Testdatenbank (Zeilenbau.Voll) - die Breite der Liste ist
                   sonst schmaler als in Wirklichkeit.

    Die Zeilen und die Bilder sind synthetisch, aber in Aufbau und MASSEN wie
    die echten: Das Diagramm kommt aus demselben ChartRenderer.Jahresgang
    (1 304 x 440 px), den die Windows-Huelle ruft.
*@

<div class="epos-probe-wirt">
    @switch (_maske)
    {
        case "klima":
            <KlimadatenDialog Regionen="@KlimaRegionen" Ansicht="@KlimaAnsicht"
                              Filterstandvorgabe="@_filterstand"
                              Importieren="@KlimaImport" Loeschen="@(n => Task.FromResult(true))"
                              Schloss="@ProbeSchloss"
                              Ortsvorschlaege="@_orte" Geschlossen="@(b => { })" />
            break;

        case "bedarf":
            <BedarfAdminDialog Art="@_bedarfArt"
                               Katalogzeilen="@(() => BedarfZeilen())"
                               Katalogprofil="@Katalogfilterprofil.FuerBedarf(_bedarfArt, Uebersetzt)"
                               Filterstandvorgabe="@_filterstand"
                               Kopf="@(n => n.Length > 0 ? ("Beschreibung " + n, "Typ " + n) : ((string, string)?)null)"
                               Jahressumme="@(n => n.Length > 0 ? "123,45" : "")"
                               Loeschen="@(_ => BedarfLoeschAusgang.Geloescht)"
                               Exists="@(_ => false)"
                               Schloss="@ProbeSchloss"
                               TitelText="Stromverbraucher Verwaltung"
                               LabelKatalog="Datenbank Stromverbraucher"
                               LabelJahressumme="jährlicher Strombedarf:" EinheitText="MWh"
                               BtnAendernText="Verbraucher in DB ändern..."
                               BtnNeuText="Verbraucher in DB neu..."
                               BtnTypAendernText="Typ in DB ändern..."
                               BtnLoeschenText="Verbraucher in DB löschen"
                               MeldungKeineWahl="Bitte wählen Sie zuerst einen Verbraucher aus!"
                               Geschlossen="@(b => { })" />
            break;

        case "modul":
            <ModulKatalogDialog Art="@_modulArt"
                                ProfilVorgabe="@ModulProfil"
                                Filterstandvorgabe="@_filterstand"
                                Wege="@ModulWege"
                                Geschlossen="@(e => { })" />
            break;

        case "waermebedarf":
            <WaermebedarfAdminDialog Katalogzeilen="@(() => Task.FromResult(ZeitreihenZeilen()))"
                                     Katalogprofil="@Katalogfilterprofil.FuerZeitreihe(Zeitreihenart.Waermebedarf, Uebersetzt)"
                                     Filterstandvorgabe="@_filterstand"
                                     HatProjektzuordnung="@(_ => Task.FromResult(false))"
                                     Loeschen="@(_ => Task.FromResult(true))"
                                     Schloss="@ProbeSchloss"
                                     Ansicht="@GanglinieAnsicht" Verwendung="@Verwendung"
                                     Einlesen="@((_, _, _) => Task.FromResult(new GanglinienImportErgebnis()))"
                                     DateiWaehlen="@(_ => Task.FromResult<string?>(null))"
                                     Ordner="C:\Users\probe\AppData\Local\WP-Plan\Waermebedarf"
                                     Geschlossen="@(b => { })" />
            break;

        case "solar":
            <SolarganglinieAdminDialog Katalogzeilen="@(() => Task.FromResult(ZeitreihenZeilen()))"
                                       Katalogprofil="@Katalogfilterprofil.FuerZeitreihe(Zeitreihenart.Solarganglinie, Uebersetzt)"
                                       Filterstandvorgabe="@_filterstand"
                                       HatProjektzuordnung="@(_ => Task.FromResult(false))"
                                       Loeschen="@(_ => Task.FromResult(true))"
                                       Schloss="@ProbeSchloss"
                                       Ansicht="@GanglinieAnsicht" Verwendung="@Verwendung"
                                       Einlesen="@((_, _) => Task.FromResult(new EPOS.UI.Dialoge.Solarthermie.SolarganglinieImportErgebnis()))"
                                       DateiWaehlen="@(_ => Task.FromResult<string?>(null))"
                                       Ordner="D:\VDI-3805-Daten\Solarthermie"
                                       Geschlossen="@(b => { })" />
            break;

        case "projekt-heizkessel":
            @* Ein PROJEKTDIALOG (Neuordnung Stufe 1, nicht Gegenstand): Er erbt die
               Katalogliste mit ihren Raengen und soll dadurch nicht schlechter werden -
               die Liste darf in der Zweispaltenauswahl nicht auf null zusammenfallen
               (sie ist seit V2 ein Container ihrer Breite). *@
            <HeizkesselDialog Zeilen="@(new List<ErzeugerZeile>())"
                              Katalogprofil="@Katalogfilterprofil.MitVerwendung(Anlagenart.Heizkessel, Uebersetzt)"
                              Katalogzeilen="@(() => Zeilenbau.Voll(Katalogfilterprofil.MitVerwendung(Anlagenart.Heizkessel, Uebersetzt), _anzahl))"
                              Filterstandvorgabe="@_filterstand"
                              Varianten="@(_ => new[] { (5, "Erdgas E Variante") })"
                              Geschlossen="@(b => { })" />
            break;

        case "stromganglinie":
            @* Die Stromganglinie (A8) steht seit Stufe 1 der Neuordnung im
               gemeinsamen Rahmen - vorher stand sie frei in der Maske. *@
            <StromganglinieAdminDialog Katalogzeilen="@(() => Task.FromResult(ZeitreihenZeilen()))"
                                       Katalogprofil="@Katalogfilterprofil.FuerZeitreihe(Zeitreihenart.Stromganglinie, Uebersetzt)"
                                       Filterstandvorgabe="@_filterstand"
                                       Loeschen="@(_ => Task.FromResult(true))"
                                       Schloss="@ProbeSchloss"
                                       Ansicht="@GanglinieAnsicht" Verwendung="@Verwendung"
                                       Einlesen="@((_, _, _) => Task.FromResult(new GanglinienImportErgebnis()))"
                                       DateiWaehlen="@(_ => Task.FromResult<string?>(null))"
                                       Geschlossen="@(b => { })" />
            break;

        case "browser":
            <KatalogBrowserDialog Art="@_browserArt"
                                  ProfilVorgabe="@BrowserProfil"
                                  Filterstandvorgabe="@_filterstand"
                                  Wege="@BrowserWege"
                                  Geschlossen="@(e => { })" />
            break;

        case "waermepumpe":
            <WaermepumpeStammDialog Filterstandvorgabe="@_filterstand"
                                    Filterprofil="@Katalogfilterprofil.Finde(Anlagenart.Waermepumpe, Uebersetzt)"
                                    Liste="@(() => WaermepumpenZeilen())"
                                    Satz="@WaermepumpeSatz"
                                    Bilder="@((id, kuehl) => new KennlinienBilder(_modell, _modell))"
                                    HatKuehlung="@(id => true)"
                                    Kennlinien="@(_ => Kennlinien())"
                                    KennlinienAbgleichen="@((_, _) => true)"
                                    Speichern="@((d, _) => new KatalogSpeicherErgebnis(true, "Gespeichert", d.Name))"
                                    GesperrtDurch="@(_ => null)"
                                    Loeschen="@(_ => true)"
                                    Duplizieren="@((id, n) => new KatalogSpeicherErgebnis(true, "", n))"
                                    Schloss="@ProbeSchloss"
                                    ImportGaben="@(() => KatalogImport(KatalogImportArt.Waermepumpe))"
                                    Geschlossen="@(b => { })" />
            break;

        case "rahmen":
            @* DER KATALOGRAHMEN MIT EINGABEBLOCK (seit Stufe 4 der Neuordnung): Keine
               Verwaltung steht mehr in der Anordnung "Liste oben, Eingabeblock darunter" -
               die letzten, Klimadaten und die Zeitreihen, tragen seit Stufe 4 das
               Stammblatt. Der Baustein fuehrt die Anordnung weiter (Schlitz Eingabe),
               und die Gegenprobe zu KL-5 (G1) braucht einen Gegenstand: Diese Seite
               stellt den Klimadialog von vor Stufe 4 im Bau nach - Liste, darunter die
               zwei Bilder in Reitern und ein Feldblock, darunter die Fussleiste. *@
            <div class="epos-dialog epos-katalog-dialog">
                <div class="epos-dialog-kopf"><h1 class="epos-dialog-titel">Katalograhmen mit Eingabeblock</h1></div>
                <Katalograhmen>
                    <Liste>
                        <Katalogliste Profil="@RahmenProfil" Zeilen="@_rahmenZeilen" Filterstand="@_filterstand"
                                      Gewaehlt="@_rahmenWahl" GewaehltChanged="@(w => _rahmenWahl = w)"
                                      ZeileIstWahl="true" />
                    </Liste>
                    <Eingabe>
                        <Reiter Bezeichnung="Jahresverlauf" Aktiv="@_rahmenReiter" AktivChanged="@(s => _rahmenReiter = s)">
                            <KindInhalt>
                                <Reiterblatt Schluessel="EINS" Titel="Temperatur">
                                    <KindInhalt>
                                        <DiagrammSvg Modell="@_modell" Kennung="rahmen-eins" Bezeichnung="Temperatur" />
                                    </KindInhalt>
                                </Reiterblatt>
                                <Reiterblatt Schluessel="ZWEI" Titel="Sonnenwinkel">
                                    <KindInhalt>
                                        <DiagrammSvg Modell="@_modell" Kennung="rahmen-zwei" Bezeichnung="Sonnenwinkel" />
                                    </KindInhalt>
                                </Reiterblatt>
                            </KindInhalt>
                        </Reiter>
                        <Formularraster Einspaltig="true">
                            <KindInhalt>
                                @for (int i = 1; i <= 8; i++)
                                {
                                    <Textfeld Bezeichnung="@("Feld " + i)" Wert="@("Wert " + i)" />
                                }
                            </KindInhalt>
                        </Formularraster>
                    </Eingabe>
                </Katalograhmen>
                <div class="epos-leiste">
                    <button type="button" class="epos-knopf">Daten einlesen</button>
                    <span class="epos-leiste-fueller"></span>
                    <button type="button" class="epos-knopf">Löschen</button>
                    <button type="button" class="epos-knopf epos-knopf--primaer">Beenden</button>
                </div>
            </div>
            break;

        case "gebaeude":
            @* STUFE 5 (V16, A9): die Gebaeudeverwaltung im Geruest - Katalogliste mit
               Profil statt eigener Tabelle, Stammblatt mit Kenndaten, Huelle und
               "Alle Daten". "Gebaeudetypen..." oeffnet die Typen als Ueberlagerung. *@
            <GebaeudeAdminDialog Katalogzeilen="@(() => GebaeudeZeilen)"
                                 Katalogprofil="@Katalogfilterprofil.FuerGebaeude(Uebersetzt)"
                                 Filterstandvorgabe="@_filterstand"
                                 Satz="@GebaeudeSatz"
                                 Gebaeudetypen="@(() => new[] { "Wohnblock", "Schule", "Hotel", "Verwaltung" })"
                                 Gebaeudearten="@(() => new[] { "grosses Mehrfamilienhaus", "Verwaltungsgebaeude", "Einfamilienhaus", "Hotel" })"
                                 Baualtersklassen="@GebaeudeStammklassen"
                                 Speichern="@((d, _, _) => new GebaeudeKatalogErgebnis(true, ""))"
                                 Loeschen="@(_ => true)"
                                 Duplizieren="@((id, n) => new KatalogSpeicherErgebnis(true, "", n))"
                                 Schloss="@ProbeSchloss"
                                 Exists="@(_ => false)"
                                 GebaeudetypGaben="@(() => GebaeudetypGaben)"
                                 Geschlossen="@(b => { })" />
            break;

        case "projekt-gebaeude":
            @* STUFE G3, WELLE K: der Gebaeude-PROJEKTDIALOG (Eingabe der Gebaeudedaten) -
               Projektliste oben, Uebernahmeleiste, darunter die Katalogliste mit dem Profil
               der Verwaltung (FuerGebaeude). Als Projektdialog traegt sie die Wahlspalte und
               das Zeilenmass 53 px (kein ZeileIstWahl, keine Tastenfuehrung). zeilen=<n> ist
               die Zahl der Katalogsaetze (ab 120 virtualisiert, bis 6 654); die Projektliste
               traegt zwei Zeilen. Profil und Zeilen sind EINE Instanz je Seite - wie in der
               Huelle, die sie einmal je Parametersatz baut. *@
            <GebaeudeDialog Zeilen="@GebaeudeProjektzeilen"
                            Katalogzeilen="@(() => GebaeudeZeilen)"
                            Katalogprofil="@GebaeudeProfil"
                            Filterstandvorgabe="@_filterstand"
                            StammDetail="@GebaeudeStammdetail"
                            StammSatz="@GebaeudeStammsatz"
                            Geschlossen="@(b => { })" />
            break;

        case "gebaeudetyp":
            @* STUFE 5 (V16, A10): die Gebaeudetypen - Typliste als Katalogliste,
               Tagesprofil im Stammblatt, "Stundenwerte..." als Ueberlagerung. *@
            <GebaeudetypDialog @attributes="GebaeudetypGaben" Geschlossen="@(b => { })" />
            break;

        case "peak":
            @* STUFE 5 (V16, A11): die Lastspitzenkappung - Liste der Lastgaenge,
               Parameter und Ergebnis im Stammblatt, "Lastgang aus Datei..." als
               Ueberlagerung. *@
            <PeakShavingDialog Ganglinien="@PeakGanglinien" Lastgangzeilen="@PeakZeilen"
                               Katalogprofil="@Katalogfilterprofil.FuerLastgang(Uebersetzt)"
                               Filterstandvorgabe="@_filterstand"
                               Werte="@(_ => Task.FromResult(PeakReihe))"
                               DateiWaehlen="@(_ => Task.FromResult<string?>(null))"
                               Einlesen="@((_, _) => Task.FromResult(new GanglinienImportErgebnis()))"
                               Rechnen="@PeakRechnen"
                               CsvSpeichern="@(_ => Task.FromResult(true))"
                               VarianteUebernehmen="@((_, _) => Task.FromResult(true))"
                               VariantenBerechnungsart="@(() => Task.FromResult<string?>("PeakShaving"))"
                               Geschlossen="@(b => { })" />
            break;

        case "tww":
            @* ZAPFPROFILGENERATOR (Stufe Z4, Gruppe 3): der Katalog der Brauchwasser-
               Nutzungsarten - Katalogliste mit sechs Spalten (Profil FuerTwwNutzungsart),
               Stammblatt mit Kennwerten und Vorschaubildern, Fuss Import/Neu/Beenden;
               "Kategorien..." oeffnet das Raster der Zapfkategorien als Ueberlagerung. Die
               Auslieferungszeilen tragen das Schloss; Zeilen und Werte erfunden. *@
            <TwwNutzungsartAdminDialog Katalogzeilen="@(() => TwwZeilen)"
                                       Katalogprofil="@Katalogfilterprofil.FuerTwwNutzungsart(Uebersetzt)"
                                       Filterstandvorgabe="@_filterstand"
                                       Detail="@TwwDetail"
                                       EditorLaden="@((id, m) => new TwwNutzungsartEditorDaten { Modus = m })"
                                       Speichern="@((m, e) => new TwwNutzungsartSpeicherErgebnis(true, e.IdBezug, "", ""))"
                                       Loeschen="@(id => new TwwNutzungsartSpeicherErgebnis(true, id, "", ""))"
                                       KategorienGaben="@(_ => new Dictionary<string, object> { ["Daten"] = KategorienDaten, ["Texte"] = new ZapfprofilTexte(), ["Pruefen"] = new Func<IReadOnlyList<ZapfprofilKategorieDaten>, ZapfprofilKategorienPruefungDaten>(KategorienPruefen) })"
                                       PaketWaehlen="@(_ => Task.FromResult(""))"
                                       Importieren="@(_ => new TwwImportberichtDaten())"
                                       Geschlossen="@(b => { })" />
            break;

        case "wohnungen":
            @* ZAPFPROFILGENERATOR (Stufe Z4, Gruppe 2a): die Wohnungstabelle der Stufe
               Erweitert - ein bearbeitbares Raster ohne eigene Hoechsthoehe (Begrenzt=false)
               im Gruppenkopf "Belegung und Anlage". Die Probe schaltet die Stufe per Klick. *@
            <ZapfprofilDialog Daten="@ZapfDaten" Texte="@(new ZapfprofilTexte())"
                              Pruefen="@(_ => Array.Empty<ZapfprofilMeldung>())" EntprellungMs="0"
                              Geschlossen="@(e => { })" />
            break;

        case "kategorien":
            @* ZAPFPROFILGENERATOR (Stufe Z4, Gruppe 2b): das Raster der Zapfkategorien -
               bearbeitbar (Standard) oder lesend (art=lesen, gesperrte Nutzungsart), ohne
               eigene Hoechsthoehe (Begrenzt=false). *@
            <ZapfkategorienEditor Daten="@KategorienDaten" Texte="@(new ZapfprofilTexte())"
                                  Pruefen="@KategorienPruefen" Geschlossen="@(e => { })" />
            break;

        default:
            <p>unbekannte Maske: @_maske</p>
            break;
    }
</div>

@code {
    private string _maske = "klima";
    private int _anzahl = 35;
    private bool _mitBildern = true;

    private readonly Katalogfilterstand _filterstand = new();
    private readonly IReadOnlyList<string> _orte = new[] { "Stuttgart", "Berlin", "Hamburg" };

    /// <summary>
    /// Das Zeichenmodell der Bilder (seit Etappe E2 SVG statt PNG) — Klimadialog wie
    /// Kennlinienmaske: Seit Gruppe (b) nimmt auch die Wärmepumpe ein Modell.
    /// </summary>
    private Zeichenmodell? _modell;

    protected override void OnInitialized()
    {
        var abfrage = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        if (abfrage.TryGetValue("maske", out var m)) _maske = m.ToString();
        if (abfrage.TryGetValue("zeilen", out var z) && int.TryParse(z, out int n)) _anzahl = n;
        if (abfrage.TryGetValue("bilder", out var b)) _mitBildern = b.ToString() != "0";
        if (abfrage.TryGetValue("voll", out var v)) _voll = v.ToString() == "1";
        if (abfrage.TryGetValue("art", out var a)) { _art = a.ToString(); ArtSetzen(_art); }

        _modell = Diagrammmodell();
    }

    // ------------------------------------------- Auspraegung (Stufe 1)
    private bool _voll;
    private string _art = "";
    private KatalogBrowserArt _browserArt = KatalogBrowserArt.Bhkw;
    private ModulKatalogArt _modulArt = ModulKatalogArt.Photovoltaik;
    private BedarfsArt _bedarfArt = BedarfsArt.Stromverbraucher;

    private void ArtSetzen(string art)
    {
        switch (art)
        {
            case "heizkessel": _browserArt = KatalogBrowserArt.Heizkessel; break;
            case "bhkw": _browserArt = KatalogBrowserArt.Bhkw; break;
            case "solarkollektoren": _browserArt = KatalogBrowserArt.Solarkollektoren; break;
            case "pufferspeicher": _browserArt = KatalogBrowserArt.Pufferspeicher; break;
            case "photovoltaik": _modulArt = ModulKatalogArt.Photovoltaik; break;
            case "wechselrichter": _modulArt = ModulKatalogArt.Wechselrichter; break;
            case "stromspeicher": _modulArt = ModulKatalogArt.Stromspeicher; break;
            case "brauchwasser": _bedarfArt = BedarfsArt.Brauchwasser; break;
            case "prozesswaerme": _bedarfArt = BedarfsArt.Prozesswaerme; break;
            case "stromverbraucher": _bedarfArt = BedarfsArt.Stromverbraucher; break;
        }
    }

    /// <summary>Die Beschriftungen aus der Ressource — sonst stuenden die Schluessel im Kopf, breiter als die Texte.</summary>
    private static string Uebersetzt(string schluessel)
        => Resource.ResourceManager.GetString(schluessel) ?? schluessel;

    // ---------------------------------------------------------------- Bild
    // DASSELBE Bild wie die Windows-Huelle: ChartRenderer.JahresgangModell mit
    // 8 760 Stundenwerten, 1 304 x 440 px. Die MASSE entscheiden hier - ein
    // kleineres Ersatzbild verfehlte genau den Befund.
    private static Zeichenmodell Diagrammmodell()
    {
        var werte = new double[8760];
        for (int i = 0; i < werte.Length; i++)
            werte[i] = 10.0 - 12.0 * Math.Cos(2 * Math.PI * i / 8760.0)
                     + 4.0 * Math.Sin(2 * Math.PI * i / 24.0);

        // Der Zeitausschnitt liegt seit Etappe E2 im Browser (die viewBox des
        // inneren svg); das Modell wird deshalb EINMAL gebaut und nicht je Zug
        // neu gezeichnet.
        return ChartRenderer.JahresgangModell(
            "Jahrestemperatur Verlauf",
            new[] { new ChartRenderer.Reihe("Temperatur", werte, ChartRenderer.C_AUSSENTEMPERATUR) },
            "Stunde des Jahres", "Temperatur [°C]");
    }

    // -------------------------------------------------------------- Klima
    private Task<IReadOnlyList<Katalogfilterzeile>> KlimaRegionen()
    {
        var liste = new List<Katalogfilterzeile>(_anzahl);
        for (int i = 0; i < _anzahl; i++)
        {
            string name = Regionsname(i);
            bool geschuetzt = i % 7 == 0;
            liste.Add(new Katalogfilterzeile(i + 1, name) { Geschuetzt = geschuetzt }
                .MitText(Katalogfilterprofil.SpBezeichner, name)
                .MitText(Katalogfilterprofil.SpQuelle, "DWD-Testreferenzjahr (Regionaldaten)")
                .MitText(Katalogfilterprofil.SpStandort, Ortsname(i) + ", Deutschland")
                .MitZahl(Katalogfilterprofil.SpLongitude, 9.18 + i / 100.0, 4)
                .MitZahl(Katalogfilterprofil.SpLatitude, 48.77 + i / 100.0, 4)
                .MitText(Katalogfilterprofil.SpImportdatum, "2026-09-18")
                .MitKennzeichen(Katalogfilterprofil.SpSchreibschutz, geschuetzt));
        }
        return Task.FromResult<IReadOnlyList<Katalogfilterzeile>>(liste);
    }

    private static string Ortsname(int i)
    {
        string[] orte = { "Stuttgart", "Berlin", "Hamburg", "München", "Köln", "Dresden",
                          "Rostock", "Freiburg im Breisgau", "Kassel", "Nürnberg" };
        return orte[i % orte.Length];
    }

    private static string Regionsname(int i)
        // Die laufende Nummer steht MIT im Namen: Der Klimadialog haelt seine
        // Zeilen am Bezeichner, und zwei gleiche Namen brechen den Zeichenlauf
        // ab ("More than one sibling ... has the same key value").
        => Ortsname(i) + " TRY " + (2015 + i % 5)
         + " Zone " + (i % 15 + 1) + " (" + (i + 1).ToString("D2") + ")";

    private Task<KlimadatenDialog.Regionsansicht> KlimaAnsicht(string name)
        => Task.FromResult(new KlimadatenDialog.Regionsansicht(
            "TRY-Datensatz " + name + ", Deutscher Wetterdienst, Bezugsjahr 2015",
            9.18, 48.77,
            _mitBildern ? _modell : null,
            _mitBildern ? _modell : null,
            _mitBildern ? "" : "Keine Daten vorhanden.")
        {
            // Stufe 4: die drei Kennzahlen im Kopf des Stammblatts.
            Jahresmittel = _mitBildern ? 9.4 : null,
            Tiefstwert = _mitBildern ? -12.3 : null,
            Hoechstwert = _mitBildern ? 31.1 : null
        });

    // ---------------------------------------- Rahmen mit Eingabeblock (G1)
    private string _rahmenWahl = "";
    private string _rahmenReiter = "EINS";
    private IReadOnlyList<Katalogfilterzeile>? _rahmenZeilenVorrat;

