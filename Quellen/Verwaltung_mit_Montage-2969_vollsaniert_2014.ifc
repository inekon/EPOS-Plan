#3722=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('6c2058a1-f6aa-41ea-b8b3-08c2d504e091'),$);
