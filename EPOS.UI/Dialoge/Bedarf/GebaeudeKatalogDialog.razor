    /// <summary>
    /// Die 17 Pflichtzahlen des ersten Reiters — <c>InitModelFromControls</c>:154-172 in
    /// derselben Reihenfolge. Die Meldung nennt das erste fehlende Feld.
    /// </summary>
    private bool PflichtzahlenStehen()
    {
        (double? wert, string name)[] pflicht =
        {
            (Daten.WohnflaecheGesamt, FeldWohnflaeche),
            (Daten.FlaecheNutzer, FeldFlaecheNutzer),
            (Daten.Waermegewinne, FeldWaermegewinne),
            (Daten.Fensterdurchlassgrad, FeldFensterdurchlassgrad),
            (Daten.Raumhoehe, FeldRaumhoehe),
            (Daten.FensterflaecheSued, FeldFFSued),
            (Daten.FensterflaecheOstWest, FeldFFOstWest),
            (Daten.FensterflaecheNord, FeldFFNord),
            (Daten.FlaecheAussenwand, FeldFlaecheAussenwand),
            (Daten.Dachflaeche, FeldDachflaeche),
            (Daten.Grundflaeche, FeldGrundflaeche),
            (Daten.SonstigeFlaechen, FeldSonstigeFlaechen),
            (Daten.UWertAussenwand, FeldUAussenwand),
            (Daten.UWertFenster, FeldUFenster),
            (Daten.UWertDachflaeche, FeldUDachflaeche),
            (Daten.UWertGrundflaeche, FeldUGrundflaeche),
            (Daten.UWertSonstiges, FeldUSonstiges)
        };

        foreach ((double? wert, string name) in pflicht)
        {
            if (wert is null)
            {
                Melden(string.Format(MeldungZahlFehlt, name), WarnStufe.Warnung);
                _reiter = "FLAECHEN";
                return false;
            }
        }
        return true;
    }

    private void BeiUeberschreiben()
    {
        if (Modus == GebaeudeKatalogModus.Neu) return;
        if (!PflichtzahlenStehen()) return;
        Schreiben(istNeu: false, bezeichner: _ursprungsname);
    }

    /// <summary>
    /// „Speichern unter" bzw. „Speichern" — <c>btn_NeuerDatensatz_Click</c>:226. Der Name
    /// ist Pflicht, danach wird ANGELEGT.
    /// </summary>
    private void BeiSpeichern()
    {
        if (Modus == GebaeudeKatalogModus.Admin) return;

        if (string.IsNullOrWhiteSpace(Daten.Name))
        {
            Melden(MeldungNameFehlt, WarnStufe.Warnung);
            return;
        }
        if (!PflichtzahlenStehen()) return;
        Schreiben(istNeu: true, bezeichner: Daten.Name);
    }

    private void Schreiben(bool istNeu, string bezeichner)
    {
        if (Speichern is null) return;

        // W9-O-2: Die Bauweise entsteht aus der BAUART und der Wohnflaeche - beide
        // koennen bis hierher noch geaendert worden sein.
        BauweiseNachfuehren();

        GebaeudeKatalogErgebnis ergebnis = Speichern(Daten, istNeu, bezeichner);
        if (!ergebnis.Erfolg)
        {
            Melden(ergebnis.Meldung, WarnStufe.Warnung);
            return;
        }

        if (istNeu) _ursprungsname = bezeichner;
        Melden(istNeu ? MeldungGespeichert : MeldungUeberschrieben, WarnStufe.Hinweis);
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Die Ueberlagerung wertet Esc zuerst fuer sich aus.
        if (e.Key != "Escape" || _brauchwasserGaben is not null) return Task.CompletedTask;
        return Geschlossen.InvokeAsync(true);
    }

