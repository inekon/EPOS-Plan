    public string Gewaehlt => _gewaehlt;

    /// <summary>Der Text des Warnbanners (Prüfhilfe für Tests).</summary>
    public string Meldung => _meldung;

    /// <summary>Läuft gerade ein Import? (Prüfhilfe für Tests)</summary>
    public bool Laeuft => _laeuft;

    private bool LoeschenErlaubt => !_laeuft && _gewaehlt.Length > 0 && Loeschen is not null;

    /// <summary>
    /// Der STANDORT: ein Ortsname ODER die drei Handangaben. Er wird bei JEDER Quelle
    /// gebraucht — ohne ihn ließe sich weder die Sonnengeometrie noch die nächste
    /// TRY-Region bestimmen. Bei einer TRY-Datei füllt ihn
    /// <see cref="StandortAusDatei"/> aus dem Dateikopf vor (Auftrag KL-2); der
    /// Anwender kann jedes Feld überschreiben.
    /// </summary>
    private bool StandortSteht =>
        _ortsname.Trim().Length > 0 ||
        (_longitude.HasValue && _latitude.HasValue && _bezeichnung.Trim().Length > 0);

    /// <summary>
    /// „Daten einlesen" braucht einen Standort und — je nach Quelle — eine Datei:
    /// <list type="bullet">
    ///   <item><description><b>PVGIS</b>: Standort, wie bisher.</description></item>
    ///   <item><description><b>TRY-Datei</b>: zusätzlich der Pfad der
    ///     <c>.dat</c>-Datei.</description></item>
    ///   <item><description><b>TRY-Regionaldaten</b>: Standort wie bisher; das
    ///     Regionalpaket darf leer bleiben, dann wird die eingestellte Adresse
    ///     abgerufen.</description></item>
    /// </list>
    /// Ein fehlerhaftes Zahlenfeld sperrt in jedem Fall.
    /// </summary>
    private bool ImportErlaubt => !_laeuft && Importieren is not null &&
        _fehlerFelder.Count == 0 && StandortSteht &&
        (_quelle != KlimaQuelle.TryDatei || _tryPfad.Trim().Length > 0);

    /// <summary>
    /// Der Standort, den die REGIONSVORSCHAU braucht: ein Ortsname ODER ein
    /// Koordinatenpaar. <b>Ohne die Bezeichnung</b> — anders als
    /// <see cref="StandortSteht"/>: Die Vorschau legt nichts an, sie sagt nur, welche
    /// Region der Punkt trifft; ein Name wäre dafür eine Hürde ohne Grund.
    /// </summary>
    private bool StandortFuerVorschau =>
        _ortsname.Trim().Length > 0 || (_longitude.HasValue && _latitude.HasValue);

    /// <summary>„Region ermitteln" braucht die Regionaldaten als Quelle und einen
    /// Standort; ein fehlerhaftes Zahlenfeld sperrt wie beim Einlesen.</summary>
    private bool RegionErlaubt => !_laeuft && !_regionLaeuft && RegionErmitteln is not null &&
        _quelle == KlimaQuelle.TryRegional && _fehlerFelder.Count == 0 && StandortFuerVorschau;

