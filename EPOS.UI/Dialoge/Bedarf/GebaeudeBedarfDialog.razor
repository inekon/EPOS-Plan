    [Parameter] public string GruppeVergleich { get; set; } = "Vergleich der Rechenwege";
    [Parameter] public string SpalteKennzahl { get; set; } = "Kennzahl";
    [Parameter] public string SpalteTagesbilanz { get; set; } = "Tagesbilanz";
