    /// </summary>
    [Parameter] public Func<Zeichenmodell?>? BildauftragKuehlvorlauf { get; set; }

    /// <summary><c>GEBB_BILD_KUEHLVORLAUF_RUECKLAUF</c></summary>
    [Parameter] public string BildtextKuehlvorlauf { get; set; } = "Kühlvorlauf und Kühlrücklauf";

    /// <summary><c>GEBB_KACHEL_KUEHLVORLAUF_RUECKLAUF</c></summary>
    [Parameter] public string KachelKuehlvorlauf { get; set; } = "Kühlvorlauf / Kühlrücklauf";

    /// <summary><c>GEBB_KACHEL_KUEHL_BEGRENZT</c></summary>
    [Parameter] public string KachelKuehlBegrenzt { get; set; } = "Stunden mit begrenzter Kühlübergabe";

    /// <summary><c>GEBB_HRL_KUEHLVORLAUF_LUECKEN</c></summary>
    [Parameter] public string HinweisKuehlvorlaufLuecken { get; set; } =
        "Stunden ohne Kühlbetrieb bleiben im Bild leer; der Kaltwasser-Vorlauf ist fest, der Rücklauf gehört zur gelieferten Kühlleistung.";

    /// <summary>
    /// Liefert das Bild der Kältelast (Stufe KU1, Kühlkonzept 8.4) — Parameter die
