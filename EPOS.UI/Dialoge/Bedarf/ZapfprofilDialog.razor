    /// <summary>Der Titel der Überlagerung — aus dem Textbündel der Auslegung, sonst der Knopftext.</summary>
    private string AuslegungTitel
        => _auslegungGaben is not null && _auslegungGaben.TryGetValue("Texte", out object? t) && t is ZapfprofilAuslegungTexte texte
            ? texte.Titel : Texte.KnopfAuslegung.TrimEnd('…');

    /// <summary>Der übernommene Punkt als Kurztext: „V l · Φ kW", nur Leistung, oder „Eingaben ohne Punkt".</summary>
    private string Auslegungspunkt
    {
        get
        {
            ZapfprofilAuslegungEingabeDaten? a = _eingabe.Auslegung;
            if (a?.PunktVolumenL is double v)
                return Zahl(v, "N0") + " l" + (a.PunktLeistungKw is double p ? " · " + Zahl(p, "N1") + " kW" : "");
            if (a?.PunktLeistungKw is double l) return Zahl(l, "N1") + " kW";
            return Texte.AuslegungOhnePunkt;
        }
    }

    /// <summary>
    /// Eine Kopie des Arbeitsstands mit der Stufe des Dialogs als Laufangabe — die Überlagerung setzt
    /// die Marke „Schnellauslegung" nur in der Stufe Einfach (N11 (c)).
    /// </summary>
    private ZapfprofilEingabeDaten MitStufe()
    {
        ZapfprofilEingabeDaten kopie = _eingabe.Kopie();
        kopie.Stufe = _stufe;
        return kopie;
    }

    /// <summary>Öffnet die Überlagerung zum aktuellen Arbeitsstand (Zonen und bisherige Auslegung).</summary>
    private void AuslegungOeffnen()
    {
        if (AuslegungGaben is null) return;
        _hinweis = "";
        _auslegungStochastisch = false;
        _auslegungGaben = AuslegungGaben(MitStufe(), false);
    }

    // =================================================================================
    // Stochastisch rechnen (5.1): nebenläufig, mit Status und Abbruch
    // =================================================================================

    /// <summary>Steht „Stochastisch rechnen" offen? Es braucht die Auslegung oder die Jahresreihe.</summary>
    private bool StochastikMoeglich => AuslegungGaben is not null || Jahresreihe is not null;

    /// <summary>
    /// „Stochastisch rechnen" (5.1, Mockup): Bei Rechenweg „stochastisch" zieht der Dialog
    /// nebenläufig die Jahresreihe (Konsistenzprobe im Reiter Kennzahlen); dazu öffnet er die
    /// Überlagerung „Auslegung" mit eingeschaltetem Schalter — sie zieht das Ensemble des
    /// Bedarfstags für Perzentil und Gleichzeitigkeit, ebenfalls nebenläufig. Welche Reihe in die
    /// Bilanz geht, wählt allein der Rechenweg der Jahresreihe.
    /// </summary>
    private void StochastikRechnen()
    {
        if (!StochastikMoeglich) return;
        _hinweis = "";
        bool jahresreihe = _eingabe.JahresreiheStochastisch && Jahresreihe is not null;
        if (jahresreihe) JahresreiheStarten();
        if (AuslegungGaben is not null)
        {
            _auslegungStochastisch = true;
            _auslegungGaben = AuslegungGaben(MitStufe(), true);
        }
        else if (!jahresreihe)
            _hinweis = Texte.HinweisJahresreiheDeterministisch;
    }

    /// <summary>Startet den Lauf der Jahresreihe zum Arbeitsstand; ein laufender endet vorher.</summary>
    private void JahresreiheStarten()
    {
        JahresreiheVerwerfen();
        var quelle = new CancellationTokenSource();
        _jahresreihe = quelle;
        _ = JahresreiheLaufen(quelle, _eingabe.Kopie());
    }

    /// <summary>
    /// Der Lauf: Der Delegat der Hülle rechnet auf einem Arbeitsfaden; das Ergebnis kommt über
    /// <c>InvokeAsync</c> in den Verteiler. Ein überholter Lauf (neue Eingabe, neuer Lauf, OK,
    /// Abbrechen) hinterlässt nichts; ein abgebrochener nennt den Abbruch als leise Zeile. Jede
    /// Ausnahme bleibt hier — ein loser Task erreichte die Fehlerschranke nicht.
    /// </summary>
    private async Task JahresreiheLaufen(CancellationTokenSource quelle, ZapfprofilEingabeDaten kopie)
    {
        ZapfprofilVorschauDaten? ergebnis = null;
        bool abgebrochen = false;
        try
        {
            ergebnis = await Jahresreihe!(kopie, quelle.Token);
        }
        catch (OperationCanceledException) { abgebrochen = true; }
        catch (Exception ex)
        {
            ergebnis = new ZapfprofilVorschauDaten
            {
                Zustand = ZapfprofilVorschauZustand.Abgebrochen,
                Grund = ex.Message,
                Status = Format(Texte.StatusOhneVorschau, ex.Message)
            };
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!ReferenceEquals(_jahresreihe, quelle)) return;
                _jahresreihe = null;
                if (abgebrochen) _hinweis = Texte.HinweisJahresreiheAbgebrochen;
                else _stochastik = ergebnis;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* der Dialog ist gegangen */ }
        finally { quelle.Dispose(); }
    }

    /// <summary>„Abbrechen" am Fortschritt: Der Lauf endet an der nächsten Einheit; der Arbeitsstand bleibt.</summary>
    private void JahresreiheAbbrechen()
    {
        try { _jahresreihe?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Verwirft Lauf und Ergebnis der Jahresreihe — sie gehören zum alten Arbeitsstand.</summary>
    private void JahresreiheVerwerfen()
    {
        CancellationTokenSource? offen = _jahresreihe;
        _jahresreihe = null;
        _stochastik = null;
        if (offen is null) return;
        try { offen.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>OK der Überlagerung: Eingaben samt Punkt in den Arbeitsstand (der Punkt gilt wieder); Abbrechen verwirft.</summary>
    private void AuslegungGeschlossen(ZapfprofilAuslegungEingabeDaten? auslegung)
    {
        _auslegungGaben = null;
        if (auslegung is null) return;
        _eingabe.Auslegung = auslegung.Kopie();
        _eingabe.Auslegung.Stochastisch = false;             // eine Laufangabe — jedes Öffnen setzt sie neu
        // Ladeleistung, Ladefenster und Speichertemperatur führt auch der Dialog: Das OK gleicht sie an.
        _eingabe.Gebaeude?.AusAuslegung(_eingabe.Auslegung);
        _eingabe.PunktUeberholt = false;
        _okMeldung = "";
        _okKennung = null;
    }

    // =================================================================================
    // Messdaten, Vergleich und Kalibrierung (Stufe Z5, Gruppe 3)
    // =================================================================================

    /// <summary>„Messdaten…" der Fußleiste: die Überlagerung mit den Messreihen des Projekts.</summary>
    private void MessdatenOeffnen()
    {
        if (MessreihenGaben is null) return;
        _messreihenGaben = MessreihenGaben();
    }

    /// <summary>
    /// Der Messdaten-Dialog ist zu: Haben sich die Reihen geändert, wird die Wahlliste neu gelesen;
    /// ein Vergleich, dessen Reihe es nicht mehr gibt, fällt weg (nie ein Ergebnis zu einer Reihe,
    /// die nicht mehr da ist), und eine gewählte Reihe, die weg ist, wird abgewählt.
    ///
    /// <para>Das Kreuz und Esc der Überlagerung rufen denselben Weg mit <c>true</c>: Der eingebettete
    /// Dialog schreibt sofort, es gibt also nichts zu verwerfen — wer ihn geöffnet hatte, kann
    /// eingespielt oder gelöscht haben. Neu zu lesen kostet eine Abfrage, ein Vergleich gegen eine
    /// gelöschte Reihe kostet den Anwender das Vertrauen in die Zahl.</para>
    /// </summary>
    private void MessdatenGeschlossen(bool geaendert)
    {
        _messreihenGaben = null;
        if (!geaendert) return;
        MessreihenLaden();
        if (_vergleichReihe.Length > 0 && !_messreihen.Reihen.Any(r => r.Bezeichnung == _vergleichReihe))
        {
            _vergleichReihe = "";
            VergleichVerwerfen();
        }
    }

    /// <summary>Die Messreihen des Projekts — ohne Delegat eine leere Liste mit benanntem Grund.</summary>
    private void MessreihenLaden()
        => _messreihen = Messreihen?.Invoke() ?? new TwwMessreihenstandDaten { Grund = Texte.VergleichOhneReihe };

    /// <summary>Die Einträge der Messreihenwahl: die Nummer der Zeile (ab 1) und ihre Bezeichnung.</summary>
    private IReadOnlyList<(int Id, string Text)> Messreihenwahl
        => _messreihen.Reihen.Select((r, i) => (i + 1, r.Bezeichnung)).ToList();

    /// <summary>Die Nummer der gewählten Reihe in der Wahlliste; <c>null</c> = keine gewählt.</summary>
    private int? VergleichWahlId
    {
        get
        {
            int i = _messreihen.Reihen.FindIndex(r => r.Bezeichnung == _vergleichReihe);
            return i < 0 ? null : i + 1;
        }
    }

    /// <summary>Die Wahl der Messreihe; ein Wechsel verwirft das Ergebnis der alten.</summary>
    private void VergleichReiheSetzen(int? id)
    {
        int i = (id ?? 0) - 1;
        string neu = i >= 0 && i < _messreihen.Reihen.Count ? _messreihen.Reihen[i].Bezeichnung : "";
        if (neu == _vergleichReihe) return;
        _vergleichReihe = neu;
        VergleichVerwerfen();
    }

    /// <summary>Steht der Vergleich zur Verfügung? Er braucht den Delegaten, die Stufe und eine Reihe.</summary>
    private bool VergleichMoeglich => Messvergleich is not null && AbErweitert && _messreihen.Reihen.Count > 0;

    /// <summary>Lässt sich rechnen? Eine Reihe ist gewählt, und es läuft nichts.</summary>
    private bool VergleichRechenbar => VergleichMoeglich && _vergleichReihe.Length > 0 && !VergleichLaeuft;

    /// <summary>Warum der Vergleich nicht geht — der Grund steht am Knopf, nie eine stille Sperre.</summary>
    private string VergleichSperrgrund
        => Messvergleich is null ? Texte.GrundNochNicht
         : !AbErweitert ? Texte.VergleichNurErweitert
         : _messreihen.Reihen.Count == 0 ? (_messreihen.Grund.Length > 0 ? _messreihen.Grund : Texte.VergleichOhneReihe)
         : _vergleichReihe.Length == 0 ? Texte.VergleichOhneWahl
         : VergleichLaeuft ? VergleichLaufText : "";

    /// <summary>Läuft der Vergleich gerade? Prüfhilfe für die Tests.</summary>
    public bool VergleichLaeuft => _vergleichLauf is not null;

    /// <summary>Das Ergebnis des letzten Vergleichs — Prüfhilfe für die Tests.</summary>
    public ZapfprofilMessvergleichDaten? Vergleichsergebnis => _vergleich;

    /// <summary>Gehört das Ergebnis zu einem früheren Arbeitsstand? Prüfhilfe für die Tests.</summary>
    public bool VergleichUeberholt => _vergleichUeberholt;

    private string VergleichLaufText => Format(Texte.VergleichLaeuft, _vergleichReihe);

    /// <summary>Die Statuszeile über dem Vergleich: Lauf, Ergebnis, Abbruch oder Veraltet-Vermerk.</summary>
    private string VergleichStatus
        => VergleichLaeuft ? VergleichLaufText
         : _vergleichHinweis.Length > 0 ? _vergleichHinweis
         : _vergleich is { Ok: true } ? Format(Texte.VergleichStatus, _vergleich.Reihe)
         : "";

    /// <summary>Was an der Stelle der Kennzahlen steht, solange kein Ergebnis da ist.</summary>
    private string VergleichErklaerung
        => !AbErweitert ? Texte.VergleichNurErweitert
         : _messreihen.Reihen.Count == 0 ? (_messreihen.Grund.Length > 0 ? _messreihen.Grund : Texte.VergleichOhneReihe)
         : _vergleichReihe.Length == 0 ? Texte.VergleichOhneWahl
         : Texte.VergleichLeer;

    /// <summary>
    /// „Vergleich rechnen": Der Delegat der Hülle rechnet nebenläufig (Muster „Stochastisch
    /// rechnen", 5.1) — derselbe Rechenweg wie der Lauf, abbrechbar, nie im Zeichenfaden.
    /// </summary>
    private void VergleichRechnen()
    {
        if (!VergleichRechenbar)
        {
            _vergleichHinweis = VergleichSperrgrund;
            return;
        }
        _vergleichHinweis = "";
        VergleichLaufVerwerfen();
        var quelle = new CancellationTokenSource();
        _vergleichLauf = quelle;
        _ = VergleichLaufen(quelle, _eingabe.Kopie(), _vergleichReihe);
    }

    /// <summary>
    /// Der Lauf des Vergleichs: Das Ergebnis kommt über <c>InvokeAsync</c> in den Verteiler. Ein
    /// überholter Lauf hinterlässt nichts; ein abgebrochener nennt den Abbruch als leise Zeile.
    /// Jede Ausnahme bleibt hier — ein loser Task erreichte die Fehlerschranke nicht.
    /// </summary>
    private async Task VergleichLaufen(CancellationTokenSource quelle, ZapfprofilEingabeDaten kopie, string reihe)
    {
        ZapfprofilMessvergleichDaten? ergebnis = null;
        bool abgebrochen = false;
        try
        {
            ergebnis = await Messvergleich!(kopie, reihe, quelle.Token);
        }
        catch (OperationCanceledException) { abgebrochen = true; }
        catch (Exception ex)
        {
            ergebnis = new ZapfprofilMessvergleichDaten { Reihe = reihe, Abbruch = ex.Message };
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!ReferenceEquals(_vergleichLauf, quelle)) return;
                _vergleichLauf = null;
                if (abgebrochen) _vergleichHinweis = Texte.VergleichAbgebrochen;
                else
                {
                    _vergleich = ergebnis;
                    _vergleichUeberholt = false;
                }
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* der Dialog ist gegangen */ }
        finally { quelle.Dispose(); }
    }

    /// <summary>„Abbrechen" am Fortschritt: Der Lauf endet an der nächsten Einheit.</summary>
    private void VergleichAbbrechen()
    {
        try { _vergleichLauf?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Verwirft einen laufenden Vergleich, ohne sein Ergebnis anzutasten.</summary>
    private void VergleichLaufVerwerfen()
    {
        CancellationTokenSource? offen = _vergleichLauf;
        _vergleichLauf = null;
        if (offen is null) return;
        try { offen.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Der Vermerk einer Formzeile: die Tage beider Seiten und das Urteil gegen die Schwelle.</summary>
    private string Formvermerk(ZapfprofilFormabgleichDaten f)
    {
        string tage = Format(Texte.VermerkTage, Zahl(f.TageGemessen, "N0"), Zahl(f.TageGerechnet, "N0"));
        string urteil = f.ImRahmen ? Texte.FormImRahmen
                                   : Format(Texte.FormUeberSchwelle, Zahl(_vergleich?.Formschwelle ?? 0.0, "N4"));
        return tage + " · " + urteil;
    }

    /// <summary>
    /// Verwirft Lauf UND Ergebnis — der Vergleich gehörte zu einer anderen Reihe. Eine laufende
    /// Kalibrierung rechnet gegen dieselbe alte Reihe und endet mit.
    /// </summary>
    private void VergleichVerwerfen()
    {
        VergleichLaufVerwerfen();
        KalibrierLaufVerwerfen();
        _vergleich = null;
        _vergleichUeberholt = false;
        _vergleichHinweis = "";
    }

    /// <summary>
    /// Der Arbeitsstand hat sich geändert: Ein Ergebnis bleibt sichtbar, trägt aber den
    /// Veraltet-Vermerk — eine verschwundene Tabelle wäre schlechter als eine gekennzeichnete
    /// (der Anwender sieht, gegen WAS er gerechnet hat). Ein laufender Vergleich bricht ab.
    /// </summary>
    private void VergleichVeralten()
    {
        VergleichLaufVerwerfen();
        if (_vergleich is not null) _vergleichUeberholt = true;
    }

    /// <summary>
    /// Die Zeilen des Vergleichsberichts: Kennzahl, Wert als Verhältnis, Vermerk. Was der Vergleich
    /// nicht entscheiden konnte, steht als Strich mit dem Grund im Vermerk — nie als Null.
    /// </summary>
    private IReadOnlyList<(string Kennzahl, string Wert, string Vermerk, bool Gelb)> Vergleichszeilen(ZapfprofilMessvergleichDaten v)
    {
        // ZU35: Unter der Mindestzahl der Einheiten trägt die Bandzeile „nicht bewertbar" mit dem
        // Grund (Einheiten, Mindestzahl) und gelber Kennzeichnung statt des Dauerlinienvermerks.
        bool nichtBewertbar = v.Lage == ZapfprofilSpitzenlage.NichtBewertbar;
        var zeilen = new List<(string, string, string, bool)>(8)
        {
            (Texte.KzEnergie, VglZahl(v.EnergieVerhaeltnis, "N3"), v.Stochastisch ? Texte.VergleichStochastisch : "", false),
            (Texte.KzEnergieAbweichung, VglProzent(v.EnergieAbweichung), "", false),
            (Texte.KzSpitze, VglZahl(v.Spitzenverhaeltnis, "N3"), Lagetext(v.Lage), false),
            // Die Perzentile mit einer Nachkommastelle: P99,9 ist keine P100.
            (Format(Texte.KzBand, Zahl(v.PerzentilUnten * 100.0, "0.#"), Zahl(v.PerzentilOben * 100.0, "0.#")),
             Bandtext(v),
             nichtBewertbar
                ? Format(Texte.VermerkBandNichtBewertbar, Zahl(v.BandEinheiten, "N0"), Zahl(v.BandMindestEinheiten, "N0"))
                : v.Dauerlinienwerte > 0 ? Format(Texte.VermerkDauerlinie, Zahl(v.Dauerlinienwerte, "N0")) : "",
             nichtBewertbar),
            (Texte.KzSpitzenstreuung, Streuungstext(v),
             v.Streubreite is double sb ? Format(Texte.VermerkStreubreite, Zahl(v.Realisierungen, "N0"), Zahl(sb, "N3"))
             : v.EnsembleZonen > 1 ? Texte.VermerkEnsembleZonen
             : Texte.VermerkOhneEnsemble, false),
            (Texte.KzWurzelN, VglZahl(v.Skalierungsmass, "N3"),
             v.Einheiten is int n && v.WurzelNVerhaeltnis is double wn
                ? Format(Texte.VermerkEinheiten, Zahl(n, "N0"), Zahl(wn, "N3")) : Texte.VermerkOhneWert, false),
            (Texte.KzForm, VglZahl(v.Formmass, "N4"),
             v.Formmass is null ? Texte.VermerkOhneWert
             : v.FormImRahmen ? Texte.FormImRahmen
             : Format(Texte.FormUeberSchwelle, Zahl(v.Formschwelle, "N4")), false),
            (Texte.KzMonate, VglProzent(v.MonateGroessteAbweichung),
             v.MonateGroessterMonat > 0 ? Format(Texte.VermerkMonat, Zahl(v.MonateGroessterMonat, "N0")) : "", false)
        };
        return zeilen;
    }

    /// <summary>Die beiden Bandgrenzen als Verhältnisse; ein Strich, wenn sie nicht zu bilden sind.</summary>
    private string Bandtext(ZapfprofilMessvergleichDaten v)
        => v.BandUnten is double u && v.BandOben is double o
            ? Zahl(u, "N3") + " … " + Zahl(o, "N3") : STRICH;

    /// <summary>Die beiden Grenzen der Realisierungsspitzen; ein Strich ohne Ensemble.</summary>
    private string Streuungstext(ZapfprofilMessvergleichDaten v)
        => v.StreuungUnten is double u && v.StreuungOben is double o
            ? Zahl(u, "N3") + " … " + Zahl(o, "N3") : STRICH;

    private string Lagetext(ZapfprofilSpitzenlage lage)
        => lage switch
        {
            ZapfprofilSpitzenlage.ImBand => Texte.LageImBand,
            ZapfprofilSpitzenlage.Oberhalb => Texte.LageOberhalb,
            ZapfprofilSpitzenlage.Unterhalb => Texte.LageUnterhalb,
            ZapfprofilSpitzenlage.NichtBewertbar => Texte.LageNichtBewertbar,
            _ => Texte.LageUnbestimmt
        };

    /// <summary>
    /// Eine Zahl des Vergleichs; ein <c>null</c> ist ein STRICH, keine Null — was nicht entschieden
    /// ist, wird nicht als Ergebnis gezeichnet (Hausregel <c>EPOS.UI/CLAUDE.md</c>).
    /// </summary>
    private static string VglZahl(double? wert, string format)
        => wert is double d ? d.ToString(format, CultureInfo.CurrentCulture) : STRICH;

    /// <summary>Eine Verhältniszahl in Prozent; ein <c>null</c> ist ein Strich.</summary>
    private static string VglProzent(double? wert)
        => wert is double d ? (d * 100.0).ToString("N2", CultureInfo.CurrentCulture) + " %" : STRICH;

    // --- „Aus Messreihe kalibrieren" --------------------------------------------------

    /// <summary>Steht „Aus Messreihe kalibrieren" offen? Es braucht den Delegaten und eine gewählte Reihe.</summary>
    private bool Kalibrierbar
        => Messkalibrierung is not null && AbErweitert && _vergleichReihe.Length > 0 && !KalibrierungLaeuft;

    /// <summary>Warum „Aus Messreihe kalibrieren" gesperrt ist — der Grund nennt auch die Stufe.</summary>
    private string Kalibriersperre
        => Messkalibrierung is null ? Texte.GrundNochNicht
         : !AbErweitert ? Texte.VergleichNurErweitert
         : _messreihen.Reihen.Count == 0 ? (_messreihen.Grund.Length > 0 ? _messreihen.Grund : Texte.VergleichOhneReihe)
         : _vergleichReihe.Length == 0 ? Texte.VergleichOhneWahl
         : KalibrierungLaeuft ? KalibrierLaufText : "";

    /// <summary>Läuft die Kalibrierung gerade? Prüfhilfe für die Tests.</summary>
    public bool KalibrierungLaeuft => _kalibrierLauf is not null;

    /// <summary>Der Text am Fortschritt der Kalibrierung.</summary>
    private string KalibrierLaufText => Format(Texte.KalibrierungLaeuft, _vergleichReihe);

    private void KalibrierenFragen(ZapfprofilZoneDaten z)
    {
        if (Messkalibrierung is null) return;
        if (!Kalibrierbar)
        {
            _hinweis = Kalibriersperre;
            return;
        }
        _frageZone = z;
        _frageArt = FRAGE_KALIBRIEREN;
        _frage = Format(Texte.FrageKalibrieren, z.Name, _vergleichReihe);
        _frageOffen = true;
    }

    /// <summary>
    /// Die Kalibrierung: Der Jahresmesswert der Zone kommt aus der Reihe — Wert, Einheit,
    /// Bilanzgrenze, Quelle und Zeitraum in EINEM Schritt. Geschrieben wird nichts: Der
    /// Arbeitsstand trägt die Werte, das OK des Dialogs speichert sie.
    /// </summary>
    private void KalibrierenAusfuehren(ZapfprofilZoneDaten z)
    {
        if (Messkalibrierung is null) return;
        int index = _eingabe.Zonen.IndexOf(z);
        if (index < 0) return;
        KalibrierLaufVerwerfen();
        var quelle = new CancellationTokenSource();
        _kalibrierLauf = quelle;
        _ = KalibrierenLaufen(quelle, _eingabe.Kopie(), _vergleichReihe, z, index);
    }

    /// <summary>
    /// Der Lauf der Kalibrierung: Das Ergebnis kommt über <c>InvokeAsync</c> in den Verteiler. Ein
    /// überholter Lauf (neue Eingabe, neuer Lauf, OK, Abbrechen) hinterlässt nichts; ein
    /// abgebrochener nennt den Abbruch als leise Zeile. Jede Ausnahme bleibt hier — ein loser Task
    /// erreichte die Fehlerschranke nicht.
    /// </summary>
    private async Task KalibrierenLaufen(CancellationTokenSource quelle, ZapfprofilEingabeDaten kopie,
                                         string reihe, ZapfprofilZoneDaten zone, int index)
    {
        ZapfprofilMesskalibrierungDaten? ergebnis = null;
        bool abgebrochen = false;
        try
        {
            ergebnis = await Messkalibrierung!(kopie, reihe, index, quelle.Token);
        }
        catch (OperationCanceledException) { abgebrochen = true; }
        catch (Exception ex)
        {
            ergebnis = new ZapfprofilMesskalibrierungDaten { Reihe = reihe, Abbruch = ex.Message };
        }

        try
        {
            await InvokeAsync(() =>
            {
                if (!ReferenceEquals(_kalibrierLauf, quelle)) return;
                _kalibrierLauf = null;
                if (abgebrochen) _hinweis = Texte.KalibrierungAbgebrochen;
                else KalibrierungUebernehmen(ergebnis!, zone);
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* der Dialog ist gegangen */ }
        finally { quelle.Dispose(); }
    }

    /// <summary>
    /// Das Ergebnis in die Felder der Zone: Wert, Einheit, Bilanzgrenze, Quelle und Zeitraum. Die
    /// Statuszeile steht NACH der Übernahme — <c>Angabe</c> räumt sie über <c>Geaendert</c>.
    /// </summary>
    private void KalibrierungUebernehmen(ZapfprofilMesskalibrierungDaten k, ZapfprofilZoneDaten z)
    {
        _kalibrierung = k;
        if (!k.Ok)
        {
            _hinweis = k.Abbruch;
            return;
        }
        Angabe(z, a =>
        {
            a.Jahresmesswert = k.Wert;
            a.JahresmesswertEinheit = (ZapfprofilMesswerteinheit)k.EinheitId;
            a.JahresmesswertBilanzgrenze = k.BilanzgrenzeId is int g ? (ZapfprofilBilanzgrenze)g : null;
            a.JahresmesswertQuelle = k.Quelle;
            a.JahresmesswertZeitraum = k.Zeitraum;
        });
        _kalibrierstatus = Format(Texte.StatusKalibriert, k.Reihe);
    }

    /// <summary>„Abbrechen" am Fortschritt der Kalibrierung: Der Lauf endet an der nächsten Einheit.</summary>
    private void KalibrierenAbbrechen()
    {
        try { _kalibrierLauf?.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    /// <summary>Verwirft einen laufenden Lauf der Kalibrierung; das Ergebnis eines früheren bleibt.</summary>
    private void KalibrierLaufVerwerfen()
    {
        CancellationTokenSource? offen = _kalibrierLauf;
        _kalibrierLauf = null;
        if (offen is null) return;
        try { offen.Cancel(); }
        catch (ObjectDisposedException) { }
    }

    // --- „Vorschlag übernehmen…" ------------------------------------------------------

    /// <summary>Steht der Kalibriervorschlag offen? Er braucht den Delegaten und eine gewählte Reihe.</summary>
    private bool Vorschlagbar => Kalibriervorschlag is not null && _vergleichReihe.Length > 0;

    /// <summary>Der Vorschlag als Vorschau — geschrieben wird nichts, bis die Rückfrage mit Ja endet.</summary>
    private void VorschlagOeffnen(ZapfprofilZoneDaten z)
    {
        if (Kalibriervorschlag is null) return;
        if (!Vorschlagbar)
        {
            _hinweis = Kalibriersperre;
            return;
        }
        int index = _eingabe.Zonen.IndexOf(z);
        if (index < 0) return;
        _vorschlagZone = z;
        _vorschlag = Kalibriervorschlag(_eingabe.Kopie(), _vergleichReihe, index);
        _vorschlagHinweise.Clear();
        _vorschlagHinweise.AddRange(_vorschlag.Hinweise);
    }

    private void VorschlagSchliessen()
    {
        _vorschlag = null;
        _vorschlagZone = null;
    }

    private void VorschlagFragen()
    {
        if (_vorschlag is not { Ok: true } v || _vorschlagZone is null || VorschlagUebernehmen is null) return;
        _frageZone = _vorschlagZone;
        _frageArt = FRAGE_VORSCHLAG;
        _frage = Format(Texte.FrageVorschlag, v.Reihe, v.Kopie);
        _frageOffen = true;
    }

    /// <summary>
    /// Die Übernahme: Der Kern legt die Anwenderkopie in EINEM Vorgang an, die Zone wird auf sie
    /// umgestellt, und der Katalog wird neu gelesen — sonst stünde die neue Nutzungsart nicht in der
    /// Wahlliste. Die Vorlage bleibt unberührt (K7).
    /// </summary>
    private void VorschlagAusfuehren(ZapfprofilZoneDaten z)
    {
        if (VorschlagUebernehmen is null) return;
        int index = _eingabe.Zonen.IndexOf(z);
        if (index < 0) return;
        ZapfprofilVorschlagErgebnisDaten e = VorschlagUebernehmen(_eingabe.Kopie(), _vergleichReihe, index);
        if (!e.Ok)
        {
            _hinweis = e.Abbruch;
            return;
        }
        VorschlagSchliessen();
        KatalogNeuLesen();
        ZonenNutzungsartSetzen(z, e.IdNutzungsart);
        // Die Hinweise des uebernommenen Vorschlags gehoeren den Werten der Kopie: Sie bleiben in
        // der Warnliste, obwohl die Vorschau zugeht.
        _vorschlagHinweise.Clear();
        _vorschlagHinweise.AddRange(e.Hinweise);
        _kalibrierstatus = e.Meldung;
    }

    // --- Die Rückfrage der beiden Handlungen ------------------------------------------

    private const string FRAGE_KALIBRIEREN = "kalibrieren";
    private const string FRAGE_VORSCHLAG = "vorschlag";

    /// <summary>Steht eine Rückfrage? Prüfhilfe für die Tests.</summary>
    public bool FrageOffen => _frageOffen;

    /// <summary>Der Text der offenen Rückfrage; Prüfhilfe für die Tests.</summary>
    public string Fragetext => _frage;

    private void FrageBeantwortet(bool? antwort)
    {
        _frageOffen = false;
        string art = _frageArt;
        ZapfprofilZoneDaten? zone = _frageZone;
        _frageArt = "";
        _frageZone = null;
        if (antwort != true || zone is null) return;
        if (art == FRAGE_KALIBRIEREN) KalibrierenAusfuehren(zone);
        else if (art == FRAGE_VORSCHLAG) VorschlagAusfuehren(zone);
    }
}
