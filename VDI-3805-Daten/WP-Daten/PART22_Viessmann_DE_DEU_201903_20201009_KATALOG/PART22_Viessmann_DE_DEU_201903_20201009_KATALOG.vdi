610;30;IF(IAN>=2) H2=VDIRWERT('700',I70,'730',I73,5);
610;31;IF(IAN>=3) H3=VDIRWERT('700',I70,'730',I73,6);
610;32;IF(IAN>=4) H4=VDIRWERT('700',I70,'730',I73,7);
610;33;I73=VDIFOLGE('700',I70,'730',I73);
610;34;ENDIF;
