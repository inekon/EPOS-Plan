@page "/diagrammsvg"
@using Microsoft.AspNetCore.WebUtilities
@using SvgProbe
@inject NavigationManager Navigation

@*  DIE PRUEFSEITE DES BAUSTEINS DiagrammSvg (Konzept Diagramme, Etappen E2/E3).

    WOZU. bunit hat weder Layout noch JavaScript: Es kann beweisen, was die
    Komponente aus einer GEMELDETEN Stunde oder einem gemeldeten Fenster macht,
    aber nicht, dass Rad, Ziehen, Kneifgeste und Gummiband im Browser wirklich
    die viewBox bewegen. Diese Seite stellt den Baustein deshalb so, wie ein
    Dialog ihn stellt - mit echten Modellen aus dem Kern -, damit sich die
    Bedienung messen laesst:

      * Rad und Kneifgeste zoomen die ZEITACHSE, y bleibt voll,
      * Ziehen verschiebt, Doppelklick und die Taste 0 stellen 1:1 her,
      * "Bereich" zieht ein Rechteck auf, das den Ausschnitt setzt,
      * die Zeile unter dem Bild zeigt die Werte am Mauszeiger,
      * ein Klick auf den Legendentext blendet die Reihe ODER FLAECHE aus,
      * ein Klick auf ihr Farbfeld oeffnet den Farbwaehler.

    DREI REIHEN, ZWEI FAELLE (Jahresgang). Zwei Reihen tragen HAUSFARBEN und
    damit eine Farbrolle - ihr Legendeneintrag hat ein Farbfeld. Die dritte
    traegt eine fest gerechnete Farbe ohne Rolle; sie bekommt keinen Waehler,
    und genau das soll man hier sehen.

    WAS DIE ETAPPE E3 DAZUGELEGT HAT (Gaben ?bild=…):

      erzeugerstapel  zwei gestapelte FLAECHEN, eine Linie darueber und eine
                      Reihe auf der ZWEITEN y-Achse (kWh neben kW). Alle vier
                      Reihen zaehlen 35 040 VIERTELSTUNDEN - damit buendelt die
                      Pfadregel, und ab dem vierfachen Zoom rechnet der Baustein
                      den Ausschnitt roh nach (DG-E3-3). Die Zahl der
                      nachgerechneten Pfade steht als data-nachgeladen im Stand.
      stundenprofil   eine FLAECHE MIT RANDLINIE ueber 168 Wochenstunden; x
                      zaehlt den INDEX der Reihe (1 … 168), nicht die
                      Jahresstunde - die Teilung im Ausschnitt ist ganzzahlig.
      speicherbetrieb drei Leistungen um die Nulllinie und der LADEZUSTAND auf
                      der zweiten Achse; zum Pruefen, dass yachse2 faellt,
                      sobald der Ladezustand abgewaehlt ist.

    WAS DIE GRUPPEN (b) UND (c) DAZUGELEGT HABEN. Vier der fuenf neuen Bilder
    haben GAR KEINE Zeichenflaeche (DG-E3-7): kein inneres svg, kein Zoom,
    keine Leiste und keine JS-Anbindung. Ihr Wert steht am ELEMENT, und die
    Zeigerzeile zeigt den des Elements, auf das der Zeiger zeigt (DG-E3-10).
    Genau das laesst sich hier messen - der Stand traegt ihn als
    data-wert-am-zeiger:

      raster       eine Rasterkarte Kapazitaet x C-Rate mit gesperrten Zellen
                   und einem Loch; jede Zelle nennt ihre Stelle und ihren Wert,
                   eine gesperrte haengt "(unzulaessig)" an.
      ring         ein Ring mit vier Segmenten. LEGENDE NICHT SCHALTBAR - ein
                   Kreis, dem ein Segment fehlt, ist kein Kreis mehr -, Werte
                   am Zeiger ja.
      kennlinien   drei Vorlaufstufen als Kennlinien mit Punktmarken; jede
                   Marke nennt Aussentemperatur und Wert.
      kapitalwert  ZWEI Verlaeufe ueber dem Projektjahr - das einzige der fuenf
                   MIT Zeichenflaeche: x zaehlt einen WERT (Achsenart.Wert,
                   Einheit "a"), und damit gibt es Zoom und die Zeigerzeile aus
                   den Reihen.
      streuwolke   8 760 Punkte ueber der Aussentemperatur. Sie traegt eine
                   Zeichenflaeche mit Achsenart.Wert und Einheit "°C" - hier
                   laesst sich pruefen, dass die Zeigerzeile den NAECHSTLIEGENDEN
                   Punkt nimmt statt eines Index (DG-E3-11).

    DIE FARBWAHL SPEICHERT NICHTS. Der Delegat setzt allein
    Farbpalette.Aktuell - die Einstellung des Anwenders bleibt unberuehrt. Eine
    Probe, die in Properties.Settings schriebe, veraenderte den Rechner, auf dem
    sie laeuft.

    Gaben aus der Adresse:
      ?bild=…       jahresgang (Vorgabe) | erzeugerstapel | stundenprofil |
                    speicherbetrieb | raster | ring | kennlinien | streuwolke |
                    kapitalwert
      ?reihen=3     Anzahl der Reihen des Jahresgangs (1…3)
      ?zoom=0       ohne Leiste und ohne JS-Anbindung (OhneZoom)
      ?farben=0     ohne Farbwaehler (nur der Legendenschalter bleibt)
*@

<h1 class="epos-ueberschrift">DiagrammSvg-Probe @_bild</h1>

<p id="diagrammsvg-stand" class="epos-hinweis"
   data-bild="@_bild" data-reihen="@_reihen" data-fenster="@_fensterText"
   data-farbe="@_farbeText" data-nachgeladen="@Nachgeladen"
   data-achse2aus="@(Achse2Aus ? "1" : "0")"
   data-wert-am-zeiger="@WertAmZeiger">
    @_bild · @_reihen Reihen · Fenster @_fensterText · zuletzt gesetzt: @_farbeText
    · nachgeladen: @Nachgeladen · zweite Achse aus: @(Achse2Aus ? "ja" : "nein")
    · Wert am Zeiger: @(WertAmZeiger.Length > 0 ? WertAmZeiger : "—")
</p>

<DiagrammSvg @ref="_diagramm"
             Modell="@_modell" Kennung="probe" Bezeichnung="@_bezeichnung"
             Einheit="@_einheit" EinheitRechts="@_einheitRechts"
             Palette="@Farbpalette.Aktuell"
             OhneZoom="@(!_mitZoom)"
             LegendeSchaltbar="@_legendeSchaltbar"
             FarbwahlErlaubt="@_mitFarben"
             FarbeGewaehlt="FarbeSetzen"
             FarbeZurueckgesetzt="FarbeZurueck"
             FensterGeaendert="FensterGemerkt"
             WertAmZeigerGeaendert="WertGemerkt" />

@code {
    /// <summary>Wie viele VIERTELstunden das Jahr hat — das Raster der Stapelprobe.</summary>
    private const int VIERTELSTUNDEN = 35040;

    /// <summary>Wie viele Stunden eine Woche hat — das Raster des Stundenprofils.</summary>
    private const int WOCHENSTUNDEN = 168;

    private DiagrammSvg? _diagramm;

    private Zeichenmodell? _modell;
    private string _bild = "jahresgang";
    private int _reihen = 3;
    private bool _mitZoom = true;
    private bool _mitFarben = true;

    private string _bezeichnung = "Jahresgang der Probe";
    private string _einheit = "kW";
    private string _einheitRechts = "";

    /// <summary>
    /// Darf ein Klick auf den Legendentext die Reihe ausblenden? Bei Ring und Kuchen
    /// NICHT: Ein Kreis, dem ein Segment fehlt, ist kein Kreis mehr.
    /// </summary>
    private bool _legendeSchaltbar = true;

    private string _fensterText = "voll";
    private string _farbeText = "—";

    /// <summary>
    /// Der Wert des Elements unter dem Zeiger (DG-E3-10) — der Baustein meldet ihn
    /// über <c>WertAmZeigerGeaendert</c>, damit ihn der Stand über dem Bild zeigen
    /// kann. Ohne diesen Rückruf bliebe die Zeile stehen: Ein Zeichenlauf der
    /// Komponente frischt die Seite darüber nicht auf.
    /// </summary>
    private string WertAmZeiger { get; set; } = "";

    /// <summary>
    /// Wie viele Pfade der Baustein gerade roh nachgerechnet hat (DG-E3-3);
    /// 0 heißt „der Vollpfad des Schreibers steht".
    /// </summary>
    private int Nachgeladen => _diagramm?.Ausschnittpfade.Count ?? 0;

    /// <summary>Sind alle Reihen der zweiten y-Achse abgewählt?</summary>
    private bool Achse2Aus => _diagramm?.ZweiteAchseAus ?? false;

    /// <summary>
    /// Die Farben der drei Reihen des Jahresgangs: zwei Hausfarben (Rolle
    /// vorhanden, Farbfeld in der Legende) und eine fest gerechnete ohne Rolle
    /// (kein Farbfeld).
    /// </summary>
    private static readonly SkiaSharp.SKColor[] FARBEN =
    {
        ChartRenderer.C_WP,          // Hausfarbe -> Rolle
        ChartRenderer.C_PV,          // Hausfarbe -> Rolle
        new SkiaSharp.SKColor(0x7B, 0x1F, 0xA2)   // keine Hausfarbe -> kein Waehler
    };

    private static readonly string[] NAMEN = { "Wärmepumpe", "Photovoltaik", "Sonstiges" };

    protected override void OnInitialized()
    {
        var abfrage = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (abfrage.TryGetValue("bild", out var b)) _bild = b.ToString().ToLowerInvariant();
        if (abfrage.TryGetValue("reihen", out var r) && int.TryParse(r, out int n))
            _reihen = Math.Clamp(n, 1, 3);
        if (abfrage.TryGetValue("zoom", out var z)) _mitZoom = z.ToString() != "0";
        if (abfrage.TryGetValue("farben", out var f)) _mitFarben = f.ToString() != "0";

        switch (_bild)
        {
            case "erzeugerstapel": Erzeugerstapel(); break;
            case "stundenprofil": Stundenprofil(); break;
            case "speicherbetrieb": Speicherbetrieb(); break;
            case "raster": Raster(); break;
            case "ring": Ring(); break;
            case "kennlinien": Kennlinien(); break;
            case "streuwolke": Streuwolke(); break;
            case "kapitalwert": Kapitalwert(); break;
            default: Jahresgang(); break;
        }
    }

    // =====================================================================
    //  Die neun Bilder
    // =====================================================================

    /// <summary>
    /// Der Jahresgang der Etappe E2 — unverändert. Die Reihen kommen aus der
    /// SVG-Probe (Jahresgang, Tagesgang, einzelne Spitzen ZWISCHEN den
    /// Stützstellen der Schrittweite); das BILD baut der Kern, damit hier kein
    /// zweiter Renderer entsteht.
    /// </summary>
    private void Jahresgang()
    {
        _bild = "jahresgang";
        _bezeichnung = "Jahresgang der Probe";

        double[][] werte = SvgZeichner.Jahresreihen(_reihen);

        var reihen = new List<ChartRenderer.Reihe>(_reihen);
        for (int i = 0; i < _reihen; i++)
            reihen.Add(new ChartRenderer.Reihe(NAMEN[i], werte[i], FARBEN[i]));

        _modell = ChartRenderer.JahresgangModell(
            "Jahresgang der Probe", reihen, "Monat", "Leistung [kW]");
    }

    /// <summary>
    /// <b>Der Erzeugerstapel</b> — das Bild, an dem die Etappe E3 hängt: zwei
    /// gestapelte FLÄCHEN, eine Linie darüber und eine Reihe auf der ZWEITEN
    /// y-Achse in kWh.
    ///
    /// <para><b>35 040 Viertelstunden je Reihe.</b> Über 8 760 Stützstellen (oder
    /// mehr als drei Reihen) bündelt die Pfadregel — und erst ein gebündelter
    /// Pfad lässt sich nachladen. Genau das soll hier messbar sein: Ab dem
    /// vierfachen Zoom rechnet der Baustein den sichtbaren Ausschnitt roh nach
    /// und zählt die Pfade in <c>data-nachgeladen</c>.</para>
    /// </summary>
    private void Erzeugerstapel()
    {
        _einheit = "kW";
        _einheitRechts = "kWh";
        _bezeichnung = "Erzeugerstapel der Probe";

        double[] heizung = Viertelstundenreihe(0.0, 1.0);
        double[] warmwasser = Viertelstundenreihe(1.4, 0.35);
        double[] bedarf = new double[VIERTELSTUNDEN];
        for (int i = 0; i < VIERTELSTUNDEN; i++) bedarf[i] = heizung[i] + warmwasser[i] + 12.0;

        var stapel = new List<ChartRenderer.Reihe>
        {
            new ChartRenderer.Reihe("Heizwärmebedarf", heizung, ChartRenderer.C_WP,
                                    ChartRenderer.Stapelart.Flaeche),
            new ChartRenderer.Reihe("Warmwasserbedarf", warmwasser, ChartRenderer.C_PV,
                                    ChartRenderer.Stapelart.Flaeche)
        };

        var linien = new List<ChartRenderer.Reihe>
        {
            new ChartRenderer.Reihe("Wärmebedarf gesamt", bedarf, ChartRenderer.C_NETZ)
        };

        // Die zweite Achse: der Speicherinhalt in kWh, eine ganz andere Skala.
        var zweite = new List<ChartRenderer.Reihe>
        {
            new ChartRenderer.Reihe("Speicherinhalt", Speicherreihe(), ChartRenderer.C_SPEICHER[0])
        };

        _modell = ChartRenderer.ErzeugerStapelModell(
            "Erzeugerstapel der Probe", stapel, linien, null, "Leistung [kW]",
            ChartRenderer.Achse.Monate, false, zweite, "Speicherinhalt [kWh]");
    }

    /// <summary>
    /// <b>Das Stundenprofil</b> — eine FLÄCHE MIT RANDLINIE über 168
    /// Wochenstunden. x zählt hier den INDEX der Reihe: Die Fläche geht von 0
    /// bis n, die Reihe von 1 bis n (Protokoll DG-E3, „Was x je Bild bedeutet"),
    /// und die Teilung im Ausschnitt ist deshalb ganzzahlig statt kalendarisch.
    /// </summary>
    private void Stundenprofil()
    {
        _einheit = "%";
        _einheitRechts = "";
        _bezeichnung = "Stundenprofil der Probe";

        var werte = new double[WOCHENSTUNDEN];
        for (int i = 0; i < WOCHENSTUNDEN; i++)
        {
            double stunde = i % 24;
            double tag = i / 24;
            double werktag = tag < 5 ? 1.0 : 0.55;
            werte[i] = Math.Round(
                werktag * (20 + 60 * Math.Max(0.0, Math.Sin(Math.PI * (stunde - 5) / 14.0))), 3);
        }

        _modell = ChartRenderer.StundenprofilModell(
            "Stundenprofil der Probe", werte, 24, "Wochenstunde (1..168)", "Verteilung");
    }

    /// <summary>
    /// <b>Der Speicherbetrieb</b> — drei Leistungen um die Nulllinie und der
    /// Ladezustand auf der zweiten Achse. Hier lässt sich messen, dass die
    /// Elemente der Marke <c>yachse2</c> verschwinden, sobald der Ladezustand
    /// über die Legende abgewählt ist.
    /// </summary>
    private void Speicherbetrieb()
    {
        _einheit = "kW";
        _einheitRechts = "kWh";
        _bezeichnung = "Speicherbetrieb der Probe";

        double[] ohne = Viertelstundenreihe(0.2, 1.0);
        double[] speicher = new double[VIERTELSTUNDEN];
        double[] mit = new double[VIERTELSTUNDEN];
        for (int i = 0; i < VIERTELSTUNDEN; i++)
        {
            speicher[i] = Math.Round(18.0 * Math.Sin(2 * Math.PI * (i % 96) / 96.0), 3);
            mit[i] = Math.Round(ohne[i] - speicher[i], 3);
        }

        var reihen = new List<ChartRenderer.Reihe>
        {
            new ChartRenderer.Reihe("Netzbezug ohne Speicher", ohne, ChartRenderer.C_BEDARF),
            new ChartRenderer.Reihe("Netzbezug mit Speicher", mit, ChartRenderer.C_NETZ),
            new ChartRenderer.Reihe("Speicherleistung", speicher, ChartRenderer.C_WP)
        };

        var ladezustand = new ChartRenderer.Reihe("Ladezustand [kWh]", Speicherreihe(),
                                                  ChartRenderer.C_SPEICHER[0]);

        _modell = ChartRenderer.SpeicherbetriebModell(
            "Speicherbetrieb der Probe", reihen, "Leistung [kW]", ladezustand,
            "Ladezustand [kWh]", false);
    }

    // =====================================================================
    //  Die fünf Bilder der Gruppen (b) und (c) — Werte am Element
    // =====================================================================

    /// <summary>
    /// <b>Die Rasterkarte</b> — sechs Kapazitäten × fünf C-Raten. Sie hat KEINE
    /// Zeichenfläche (DG-E3-7): Jede Zelle ist ein Pixel-Element mit ihrem
    /// <c>data-wert</c>, und die Zeigerzeile zeigt den der Zelle unter dem Zeiger
    /// (DG-E3-10).
    ///
    /// <para><b>Ein LOCH und zwei gesperrte Zellen</b>, damit beide Sonderfälle des
    /// Werttextes messbar sind: Eine nicht gerechnete Stelle nennt statt der Zahl
    /// „nicht gerechnet", eine gesperrte hängt „(unzulässig)" an.</para>
    /// </summary>
    private void Raster()
    {
        _bezeichnung = "Rasterkarte der Probe";
        _einheit = "€/a";
        _einheitRechts = "";

        double[] cRaten = { 0.25, 0.5, 1.0, 1.5, 2.0 };
        double[] kapazitaeten = { 100, 200, 300, 400, 500, 600 };

        var werte = new double[kapazitaeten.Length][];
        var gesperrt = new bool[kapazitaeten.Length][];
        for (int z = 0; z < kapazitaeten.Length; z++)
        {
            werte[z] = new double[cRaten.Length];
            gesperrt[z] = new bool[cRaten.Length];
            for (int s = 0; s < cRaten.Length; s++)
            {
                // Eine glatte Schale mit einem Optimum in der Mitte - kein Zufall,
                // damit zwei Laeufe dasselbe Bild ergeben.
                double dz = z - 2.5, ds = s - 2.0;
                werte[z][s] = Math.Round(9000 - 400 * (dz * dz) - 700 * (ds * ds), 0);
            }
        }

        // Das Loch: hier ist nichts gerechnet worden (#226).
        werte[0][4] = double.NaN;
        // Zwei gesperrte Stellen (#193) - sie tragen die Schraffur UND den Zusatz.
        gesperrt[5][0] = true;
        gesperrt[5][1] = true;

        _modell = ChartRenderer.OptimierungsrasterModell(
            "Rasterkarte der Probe", "C-Rate [1/h]", "Kapazität [kWh]", "ΔJ [€/a]",
            cRaten, kapazitaeten, werte, 2, 2, gesperrt,
            "Das Raster ist endlich — zwischen zwei Stellen liegt nichts.");
    }

    /// <summary>
    /// <b>Der Ring</b> — vier Segmente und eine Zahl in der Mitte. <b>Seine Legende
    /// ist NICHT schaltbar</b> (Gruppen (b)/(c), Oberfläche): Ein Kreis, dem ein
    /// Segment fehlt, ist kein Kreis mehr — die Anteile summierten sich dann nicht
    /// mehr auf hundert Prozent. Der Wert am Zeiger bleibt, und die Farbwahl über das
    /// Farbfeld auch.
    /// </summary>
    private void Ring()
    {
        _bezeichnung = "Ring der Probe";
        _einheit = "";
        _einheitRechts = "";
        _legendeSchaltbar = false;

        var segmente = new List<ChartRenderer.Ringsegment>
        {
            new ChartRenderer.Ringsegment("Wärmepumpe", 480.0, ChartRenderer.C_WP),
            new ChartRenderer.Ringsegment("Solarthermie", 120.0, ChartRenderer.C_SOLAR),
            new ChartRenderer.Ringsegment("BHKW", 240.0, ChartRenderer.C_BHKW),
            new ChartRenderer.Ringsegment("Heizkessel", 160.0, ChartRenderer.C_KESSEL)
        };

        _modell = ChartRenderer.RingModell("Wärmedeckung der Probe", segmente, 1000.0, "MWh");
    }

    /// <summary>
    /// <b>Die Kennlinien</b> — drei Vorlaufstufen über der Außentemperatur, mit
    /// Punktmarken. Keine Zeichenfläche (DG-E3-7): Zwischen zwei Stützstellen liegt
    /// nichts, worauf ein Zoom zeigen könnte. <b>Jede Punktmarke nennt ihren Wert</b>
    /// („Außentemperatur −5 °C · 35°C: 4,25"), und die Zeigerzeile zeigt ihn.
    /// </summary>
    private void Kennlinien()
    {
        _bezeichnung = "Kennlinien der Probe";
        _einheit = "";
        _einheitRechts = "";

        var reihen = new List<ChartRenderer.KennlinienReihe>();
        foreach (int vorlauf in new[] { 35, 45, 55 })
        {
            var punkte = new List<(double Temperatur, double Wert)>();
            for (int t = -15; t <= 20; t += 5)
                // Der COP steigt mit der Aussentemperatur und faellt mit dem Vorlauf.
                punkte.Add((t, Math.Round(2.0 + (t + 20) * 0.11 - (vorlauf - 35) * 0.035, 2)));
            reihen.Add(new ChartRenderer.KennlinienReihe(vorlauf, punkte));
        }

        _modell = ChartRenderer.KennlinienModell(
            "COP-Kennlinien der Probe", "COP", "Außentemperatur [°C]", reihen,
            ChartRenderer.Kennlinienmarke.Kreis);
    }

    /// <summary>
    /// <b>Die Streuwolke</b> — 8 760 Punkte, x die Außentemperatur, y die Leistung.
    /// Sie trägt eine Zeichenfläche mit <c>Achsenart.Wert</c> und der Einheit „°C";
    /// hier lässt sich prüfen, dass die Zeigerzeile den NÄCHSTLIEGENDEN Punkt nimmt
    /// statt eines gleichmäßigen Index (DG-E3-11) — die Punkte liegen ungleichmäßig
    /// über der Temperaturachse.
    /// </summary>
    private void Streuwolke()
    {
        _bezeichnung = "Streuwolke der Probe";
        _einheit = "kW";
        _einheitRechts = "";

        var punkte = new List<(double X, double Y)>(8760);
        for (int i = 0; i < 8760; i++)
        {
            double tag = i / 24.0;
            double temperatur = Math.Round(
                9.0 - 11.0 * Math.Cos(2 * Math.PI * (tag - 15) / 365.0)
                + 4.0 * Math.Sin(2 * Math.PI * (i % 24) / 24.0), 2);
            // Die Heizlast faellt linear mit der Temperatur und endet bei 15 °C.
            double leistung = Math.Round(Math.Max(0.0, (15.0 - temperatur) * 3.2), 2);
            punkte.Add((temperatur, leistung));
        }

        var reihen = new List<ChartRenderer.Punktreihe>
        {
            new ChartRenderer.Punktreihe("Heizlast", punkte, ChartRenderer.C_WP)
        };

        _modell = ChartRenderer.StreuwolkeModell(
            "Leistung über Außentemperatur", "Außentemperatur [°C]", "Leistung [kW]", reihen);
    }

    /// <summary>
    /// <b>Der Kapitalwertverlauf</b> — zwei Verläufe über dem Projektjahr. Das
    /// einzige der fünf Bilder MIT Zeichenfläche: x zählt einen WERT
    /// (<c>Achsenart.Wert</c>, Einheit „a"), also gibt es Zoom, Zeigerlinie und die
    /// Zeigerzeile aus den Reihen — und die x-Einheit kommt aus dem MODELL, nicht
    /// mehr aus einem Parameter (DG-E3-11).
    /// </summary>
    private void Kapitalwert()
    {
        _bezeichnung = "Kapitalwertverlauf der Probe";
        _einheit = "€";
        _einheitRechts = "";

        const int JAHRE = 21;
        var variante = new double[JAHRE];
        var referenz = new double[JAHRE];
        double s1 = -180000, s2 = -120000;
        for (int j = 0; j < JAHRE; j++)
        {
            variante[j] = Math.Round(s1, 0);
            referenz[j] = Math.Round(s2, 0);
            s1 += 21000;
            s2 += 13500;
        }

        var reihen = new List<ChartRenderer.Reihe>
        {
            new ChartRenderer.Reihe("Variante", variante, ChartRenderer.C_WP),
            new ChartRenderer.Reihe("Stamm", referenz, ChartRenderer.C_STAMM)
        };

        _modell = ChartRenderer.KapitalwertVerlaufModell(
            "Kapitalwertverlauf der Probe", reihen,
            "Nominal, ohne Abzinsung — synthetische Zahlen der Probe.");
    }

    // =====================================================================
    //  Die synthetischen Reihen — fest verdrahtet, ohne Zufall
    // =====================================================================

    /// <summary>
    /// Eine Viertelstundenreihe über ein Jahr: Saison mal Tagesgang, dazu eine
    /// schnelle Welle und alle paar Wochen eine einzelne Spitze. Die Spitzen
    /// stehen zwischen zwei Bildpunktspalten — sie zeigen, was die Bündelung
    /// hält und was ein nachgerechneter Ausschnitt genauer zeigt.
    /// </summary>
    private static double[] Viertelstundenreihe(double phase, double faktor)
    {
        var w = new double[VIERTELSTUNDEN];
        for (int i = 0; i < VIERTELSTUNDEN; i++)
        {
            double tag = i / 96.0;
            double saison = 0.5 + 0.5 * Math.Cos(2 * Math.PI * (tag - 15) / 365.0);
            double tagesgang = 0.5 + 0.5 * Math.Sin(2 * Math.PI * (i % 96) / 96.0 + phase);
            double wert = 8 + 40 * saison * (0.6 + 0.4 * tagesgang) + 6 * Math.Sin(i * 0.11 + phase);
            if (i % 3989 == 7) wert += 35;
            w[i] = Math.Round(Math.Max(0.0, wert * faktor), 3);
        }
        return w;
    }

    /// <summary>Der Speicherinhalt in kWh — eine ganz andere Skala als die Leistungen.</summary>
    private static double[] Speicherreihe()
    {
        var w = new double[VIERTELSTUNDEN];
        for (int i = 0; i < VIERTELSTUNDEN; i++)
            w[i] = Math.Round(600 + 400 * Math.Sin(2 * Math.PI * (i % 96) / 96.0 - 1.1), 3);
        return w;
    }

    // =====================================================================
    //  Die Rückrufe
    // =====================================================================

    /// <summary>
    /// Die gewählte Farbe wirkt SOFORT und NUR in diesem Prozess: Sie geht in
    /// <c>Farbpalette.Aktuell</c>, nicht in die Anwendungseinstellung. Das Modell
    /// bleibt, wie es ist — es trägt Rollen, keine Zahlen.
    /// </summary>
    private Task FarbeSetzen((Farbrolle Rolle, Farbe Farbe) wahl)
    {
        Farbpalette.Aktuell = new Farbpalette(
            new Dictionary<Farbrolle, Farbe> { { wahl.Rolle, wahl.Farbe } },
            Farbpalette.Aktuell);
        _farbeText = wahl.Rolle.Name + " = " + Diagrammfarben.Hex(wahl.Farbe);
        return Task.CompletedTask;
    }

    /// <summary>„Hausfarbe" — dieselbe Runde zurück zur Vorgabe.</summary>
    private Task FarbeZurueck(Farbrolle rolle)
    {
        Farbpalette.Aktuell = new Farbpalette(
            new Dictionary<Farbrolle, Farbe> { { rolle, Farbpalette.Vorgabe[rolle] } },
            Farbpalette.Aktuell);
        _farbeText = rolle.Name + " = Hausfarbe";
        return Task.CompletedTask;
    }

    /// <summary>
    /// Der Ausschnitt, den das JS-Modul am Ende einer Geste meldet — hier nur zum
    /// Ablesen. Ein Wirt der Anwendung würde ihn merken oder drucken.
    /// </summary>
    private Task FensterGemerkt(ChartRenderer.Achsenfenster? fenster)
    {
        _fensterText = fenster is null
            ? "voll"
            : fenster.Von.ToString("N0", CultureInfo.CurrentCulture) + " … "
              + (fenster.Bis - 1).ToString("N0", CultureInfo.CurrentCulture)
              + (_modell?.Flaeche?.X == Achsenart.Stunden ? " h" : "");

        // Der Stand zeigt, wie viele Pfade der Baustein nachgerechnet hat; das
        // weiss er erst NACH seinem eigenen Zeichenlauf.
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// Der Wert des Elements unter dem Zeiger (DG-E3-10). Er steht am Element, nicht
    /// in einer Reihe — der Baustein meldet ihn, und der Stand über dem Bild zeigt ihn
    /// als <c>data-wert-am-zeiger</c>.
    /// </summary>
    private Task WertGemerkt(string wert)
    {
        WertAmZeiger = wert ?? "";
        return Task.CompletedTask;
    }
}
