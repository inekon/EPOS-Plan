        new Stammblattwert(Texte.LabelBezeichner, d.Bezeichner),
        new Stammblattwert(Texte.LabelBeschreibung, d.Beschreibung),
        new Stammblattwert(Texte.LabelBauart, string.IsNullOrEmpty(d.Bauart) ? VorgabeText(BauartText("")) : BauartText(d.Bauart)),
        new Stammblattwert(Texte.LabelNennleistung, Lesewert(d.NennleistungKw, null, "0.#", Texte.EinheitKw))
    };

    private IReadOnlyList<Stammblattwert> Annaeherungswerte(RueckkuehlwerkDaten d) => new[]
    {
        new Stammblattwert(Texte.LabelAnnaeherungNenn, Lesewert(d.AnnaeherungNennK, VorgabenZu(d)?.AnnaeherungK, "0.#", Texte.EinheitK)),
        new Stammblattwert(Texte.LabelAnnaeherungWeg, Auswahlwert(Wege, d.AnnaeherungWeg))
    };

    private IReadOnlyList<Stammblattwert> Ventilatorwerte(RueckkuehlwerkDaten d)
    {
        RueckkuehlwerkVorgaben? v = VorgabenZu(d);
        return new[]
        {
            new Stammblattwert(Texte.LabelVentilatorNenn, d.VentilatorNennKw.HasValue ? Zahl(d.VentilatorNennKw, "0.##", Texte.EinheitKw) : Texte.VorgabeVentilator),
            new Stammblattwert(Texte.LabelVentilatorRegelung, Auswahlwert(Regelungen, d.VentilatorRegelung)),
            new Stammblattwert(Texte.LabelVentilatorStufen, d.VentilatorStufen.HasValue
                ? d.VentilatorStufen.Value.ToString(CultureInfo.CurrentCulture)
                : v is null ? "–" : VorgabeText(v.VentilatorStufen.ToString(CultureInfo.CurrentCulture))),
            new Stammblattwert(Texte.LabelVentilatorDrehzahlMin, Lesewert(d.VentilatorDrehzahlMin, v?.VentilatorDrehzahlMin, "0.##", ""))
