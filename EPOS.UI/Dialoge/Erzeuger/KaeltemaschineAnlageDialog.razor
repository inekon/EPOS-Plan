    /// <summary>Die Bilder eines Satzes aus dem Zwischenspeicher — sonst verlöre <c>DiagrammSvg</c> mit der Referenz Zoom und Legendenwahl.</summary>
    private (KaeltemaschineKennlinienbilder? Bilder, WindowsFormsApplication1.Zeichnung.Zeichenmodell? Teillast) BilderZu(int id, bool katalog)
    {
        if (id <= 0) return (null, null);
        if (_bilder.TryGetValue((id, katalog), out var alt)) return alt;
        KaeltemaschineKennlinienbilder? bilder = null;
        WindowsFormsApplication1.Zeichnung.Zeichenmodell? teillast = null;
        string fehler = "";
        if (Kennlinienbilder is not null)
            bilder = Katalogladung.SatzDazu(() => Kennlinienbilder(id, katalog), SatzName, ref fehler);
        if (Teillastbild is not null)
            teillast = Katalogladung.SatzDazu(() => Teillastbild(id, katalog), SatzName, ref fehler);
        if (fehler.Length > 0) _satzUeberlagerungFehler = fehler;
        _bilder[(id, katalog)] = (bilder, teillast);
        return (bilder, teillast);
    }

    // =====================================================================
    // In das Projekt übernehmen — sofort angelegt, Abbrechen räumt ab
    // =====================================================================

    /// <summary>
    /// Legt für jeden gewählten Katalogsatz Projektkopie und Anlagenzeile sofort an (Fangweg
    /// <c>Katalogladung.Schreiben</c>) und nimmt die gelesene Anlage in die Liste; die in der Sitzung angelegten
    /// räumt Abbrechen wieder ab.
    /// </summary>
    private void BeiInsProjekt()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        _meldung = "";
        Zeile? letzte = null;
        foreach (Katalogfilterzeile z in ziele)
        {
            if (KatalogIstWp(z.Schluessel)) { WpUebernehmen(z); continue; }
            if (Anlegen is null) continue;
            string grund = "";
            int id = Katalogladung.Schreiben(() => Anlegen(z.Id, z.Bezeichner), z.Bezeichner, g => { grund = g; return -1; });
            if (id <= 0)
            {
                Melden(grund.Length > 0 ? grund : string.Format(CultureInfo.CurrentCulture, Texte.AnlegenFehlt, z.Bezeichner), true);
                continue;
            }
            KaeltemaschineAnlageDaten gelesen = AnlageLesen(id) ?? Notstand(id, z);
            var zeile = new Zeile { Schluessel = NeuerSchluessel(), Gelesen = gelesen, Arbeit = gelesen.Kopie() };
            _zeilen.Add(zeile);
            letzte = zeile;
        }
        KatalogKaestchenLeeren();
        VerwendungStempeln();
        if (letzte is not null)
        {
            _projektWahl.Leeren();
            ProjektZeileWaehlen(letzte);
        }
    }

    /// <summary>Die soeben angelegte Anlage, so wie die Hülle sie liest; <c>null</c> = nicht lesbar.</summary>
    /// <summary>
    /// KM-K1: übernimmt eine Katalog-Wärmepumpe — Kopie, Anlage, Kühlbetrieb und Rang sofort über die Hülle; eine Ablehnung
    /// des Kerns steht im Banner (Kopie und Anlage bleiben vorgemerkt, Abbrechen nimmt sie zurück).
    /// </summary>
    private void WpUebernehmen(Katalogfilterzeile z)
    {
        if (WaermepumpeUebernehmen is null || !KuehlerzeugerKatalogCtrl.IstWaermepumpe(z.Schluessel, out int stamm)) return;
        KuehlWpUebernahme? u = Katalogladung.Schreiben(() => WaermepumpeUebernehmen(stamm), z.Bezeichner, g => (KuehlWpUebernahme?)
            new KuehlWpUebernahme(false, 0, z.Bezeichner, false, g, null));
        if (u is null) return;
        if (u.Merker is not null) _wpUebernahmen.Add(u.Merker);
        if (u.IdWp <= 0) { Melden(string.IsNullOrEmpty(u.Meldung) ? Resource.KMA_MSG_WP_FEHLER : u.Meldung!, true); return; }
        bool warAn = _wp.Any(w => w.Daten.IdWp == u.IdWp && !w.Entfernt);
        if (u.Ok && !_wp.Any(w => w.Daten.IdWp == u.IdWp)) _wpEingeschaltet.Add(u.IdWp);
        try
        {
            WpNeuLesen(u.Ok ? u.IdWp : null);
            _raenge = KaelteRaenge?.Invoke() ?? _raenge;
        }
        catch (Exception ex) { Melden(ex.Message, true); return; }
        if (!u.Ok)
        {
            Melden(string.Format(CultureInfo.CurrentCulture, Resource.KMA_MSG_WP_ABGELEHNT, u.Bezeichner, u.Meldung ?? ""), true);
            return;
        }
        WpEintrag? neu = _wp.FirstOrDefault(w => w.Daten.IdWp == u.IdWp);
        string rang = RangText(neu?.Daten.Rang);
        Melden(string.Format(CultureInfo.CurrentCulture,
                             u.SchonImProjekt || warAn ? Resource.KMA_MSG_WP_SCHON_IM_PROJEKT : Resource.KMA_MSG_WP_UEBERNOMMEN,
                             u.Bezeichner, rang.Length > 0 ? rang : Resource.KMA_RANG_KEINER), false);
        if (neu is not null) { _projektWahl.Leeren(); WpZeileWaehlen(neu); }
    }

    private KaeltemaschineAnlageDaten? AnlageLesen(int anlagenId)
    {
        try { return Anlagen?.Invoke()?.FirstOrDefault(a => a.AnlagenId == anlagenId); }
        catch { return null; }
    }

    /// <summary>Ohne Lesestand: die Anlage aus dem Katalogsatz (Name, Anzahl 1, Vorauswahl des Kühlträgers).</summary>
    private KaeltemaschineAnlageDaten Notstand(int anlagenId, Katalogfilterzeile z)
    {
        KaeltemaschineGeraetwerte? werte = null;
        try { werte = Katalogwerte?.Invoke(z.Id); } catch { werte = null; }
        return new KaeltemaschineAnlageDaten
        {
            AnlagenId = anlagenId, StammId = z.Id, Bezeichner = z.Bezeichner, Anzahl = 1, Geraet = werte,
            KuehlCarrierId = KuehltraegerVorauswahl is int vor && vor > 0 ? vor : null
        };
    }

    /// <summary>
    /// „Aus dem Projekt entfernen": Eine in der Sitzung angelegte Anlage geht sofort, eine gespeicherte wird
    /// vorgemerkt und beim OK gelöscht.
    /// </summary>
    private void BeiEntfernen()
    {
        List<Zeile> ziele = ProjektZiele();
        List<WpEintrag> wpZiele = WpZiele();
        if (ziele.Count == 0 && wpZiele.Count == 0) return;
        foreach (WpEintrag w in wpZiele)
        {
            // KM-K1: bei einer Wärmepumpe nur der Kühlbetrieb - beim OK aus, Gerät und Anlage bleiben (Hinweis).
            w.Entfernt = true;
            Melden(string.Format(CultureInfo.CurrentCulture, Resource.KMA_MSG_WP_ENTFERNT, w.Daten.Bezeichner), false);
        }
        foreach (Zeile z in ziele)
        {
            if (z.Neu)
            {
                AnlageLoeschen(z);
                _zeilen.Remove(z);
            }
            else z.Entfernt = true;
        }
        _projektWahl.Leeren();
        VerwendungStempeln();
        if (Sichtbare.FirstOrDefault() is Zeile naechste) ProjektZeileWaehlen(naechste);
        else if (SichtbareWp.FirstOrDefault() is WpEintrag nw) WpZeileWaehlen(nw);
        else { _gewaehlt = ""; _kosten = null; }
    }

    /// <summary>Löscht eine Anlage über die Gabe; ein Wurf meldet im Banner.</summary>
    private bool AnlageLoeschen(Zeile z)
    {
        if (Loeschen is null || z.Arbeit.AnlagenId <= 0) return true;
        string grund = Katalogladung.Schreiben(() => { Loeschen(z.Arbeit.AnlagenId); return ""; }, z.Arbeit.Bezeichner, g => g);
        if (grund.Length == 0) return true;
        Melden(grund, true);
        return false;
    }

    // =====================================================================
    // Die Satz-Überlagerung: „Bearbeiten" eines Satzes
    // =====================================================================

    private void BeiSatzVergroessert()
    {
        _satzGross = true;
        _satzUeberlagerungFehler = null;
        _anlagenmerker = Aktuell?.Arbeit.Kopie();
    }

    /// <summary>
    /// OK der Überlagerung: prüft die Anlage mit den Regeln des Kerns und schreibt sie über den Fangweg
    /// (<c>Katalogladung.Schreiben</c>); abgelehnt bleibt die Überlagerung offen und nennt den Grund.
    /// </summary>
    private void BeiSatzUebernommen()
    {
        if (Aktuell is Zeile a && !AnlageSchreiben(a, out string? grund))
        {
            _satzUeberlagerungFehler = grund;
            _zweispalten?.SatzOffenHalten();
            return;
        }
        _satzGross = false;
        _satzUeberlagerungFehler = null;
        _anlagenmerker = null;
        KostenNachziehen();   // die Kostenknoepfe der Ueberlagerung koennen die Summen geaendert haben
    }

    /// <summary>Abbrechen, ✕ und Esc der Überlagerung: die Anlagenfelder wie beim Öffnen.</summary>
    private void BeiSatzVerworfen()
    {
        _satzGross = false;
        _satzUeberlagerungFehler = null;
        if (_anlagenmerker is KaeltemaschineAnlageDaten merker && Aktuell is Zeile a) a.Arbeit = merker;
        _anlagenmerker = null;
        KostenNachziehen();
    }

    /// <summary>Prüft und schreibt eine geänderte Anlage; <c>false</c> = abgelehnt, <paramref name="grund"/> nennt es.</summary>
    private bool AnlageSchreiben(Zeile z, out string? grund)
    {
        grund = Pruefbefund(z.Arbeit);
        if (grund is not null) return false;
        if (z.Arbeit.GleicheEingaben(z.Gelesen) || Speichern is null) return true;
        KaeltemaschineAnlageDaten arbeit = z.Arbeit;
        string? fehler = Katalogladung.Schreiben(() => Speichern(arbeit), arbeit.Bezeichner, g => g);
        if (!string.IsNullOrEmpty(fehler)) { grund = fehler; return false; }
        z.Gelesen = arbeit.Kopie();
        z.Gespeichert = true;
        return true;
    }

    private async Task BeiProjektBearbeiten()
    {
        List<Zeile> ziele = ProjektZiele();
        if (ziele.Count == 0 || _zweispalten is null) return;
        if (ziele[0].Schluessel != _gewaehlt) ProjektZeileWaehlen(ziele[0]);
        await _zweispalten.SatzUeberlagerungOeffnen();
    }

    private async Task BeiProjektStift(string schluessel)
    {
        if (_zweispalten is null) return;
        if (schluessel != _gewaehlt) Waehlen(schluessel);
        if (AktuellWp is not null) { BeiSchlossAbgelehnt(Resource.KMA_WP_BEARBEITEN_GESPERRT); return; }
        await _zweispalten.SatzUeberlagerungOeffnen();
    }

    // =====================================================================
    // Katalog: Bearbeiten…, Stift, Vergleichen…, Schloss, Löschen
    // =====================================================================

    /// <summary>
    /// „Bearbeiten…" des Katalogs: ein freier Satz öffnet den Katalogeditor mit diesem Satz; ein gesperrter
    /// Satz öffnet nur lesend in der Satz-Überlagerung („Erst Schloss aufheben"). Bei mehreren Sätzen gilt der
    /// erste freie.
    /// </summary>
    private async Task BeiKatalogBearbeiten()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele().Where(z => !KatalogIstWp(z.Schluessel)).ToList();
        if (ziele.Count == 0) return;
        Katalogfilterzeile? frei = ziele.FirstOrDefault(z => !z.Geschuetzt);
        if (frei is not null) { await KatalogsatzOeffnen(frei); return; }
        await KatalogsatzOeffnen(ziele[0]);
    }

    private Task BeiKatalogStift(Katalogfilterzeile zeile)
    {
        if (!KatalogIstWp(zeile.Schluessel)) return KatalogsatzOeffnen(zeile);
        KatalogZeileWaehlen(zeile.Schluessel);
        BeiSchlossAbgelehnt(Resource.KMA_WP_BEARBEITEN_GESPERRT);
        return Task.CompletedTask;
    }

    private async Task KatalogsatzOeffnen(Katalogfilterzeile zeile)
    {
        if (_katalogZeile?.Schluessel != zeile.Schluessel) KatalogZeileWaehlen(zeile.Schluessel);
        if (!zeile.Geschuetzt && EditorOeffnen(zeile.Id)) return;
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>Öffnet den Katalogeditor als Überlagerung; <c>false</c> = es gibt die Gaben nicht (oder sie werfen).</summary>
    private bool EditorOeffnen(int vorwahl)
    {
        if (KatalogGaben is null) return false;
        IReadOnlyDictionary<string, object>? gaben = Katalogladung.Satz(() => KatalogGaben(), Texte.TitelEditor, out string fehler);
        if (gaben is null) { if (fehler.Length > 0) Melden(fehler, true); return false; }
        _editorVorwahl = vorwahl;
        _editorGaben = gaben;
        return true;
    }

    /// <summary>Der Katalogeditor schließt: Katalog neu lesen, die Wahl bleibt.</summary>
    private void EditorFertig(bool _)
    {
        _editorGaben = null;
        _editorNeu = false;
        KatalogNeuLaden();
        if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Schluessel);
    }

    /// <summary>
    /// „Vergleichen…" über beide Listen (KA-E-24, die Zweispaltenauswahl führt den Knopf): die Kennwerte einer
    /// Anlage aus ihrer Projektkopie samt Kennlinie in derselben Parameterliste wie die des Katalogsatzes
    /// (<see cref="VergleichsparameterProjekt"/>); ohne diese Gabe oder ohne gespeicherte Projektkopie die Felder der
    /// Gerätegruppe.
    /// </summary>
    /// <summary>
    /// KM-K1: die Arten dessen, was „Vergleichen…“ vergleichen würde — dieselbe Regel wie im Baustein (die Kreuze beider
    /// Listen, ohne Kreuze die letzte Wahl beider Listen).
    /// </summary>
    private bool VergleichGemischt
    {
        get
        {
            var projekt = _projektWahl.Anzahl > 0 ? _projektWahl.Gewaehlte.ToList() : new List<string>();
            var katalog = _katalogWahl.Anzahl > 0 ? _katalogWahl.Gewaehlte.ToList() : new List<string>();
            if (projekt.Count + katalog.Count == 0)
            {
                if (_letzteProjektwahl is string p && ProjektSchluessel().Contains(p)) projekt.Add(p);
                if (_letzteKatalogwahl is string k && _katalog.Any(z => z.Schluessel == k)) katalog.Add(k);
                if (projekt.Count == 0 || katalog.Count == 0) return false;
            }
            var arten = projekt.Select(s => s.StartsWith("W", StringComparison.Ordinal))
                               .Concat(katalog.Select(KatalogIstWp)).Distinct().Count();
            return arten > 1;
        }
    }

    private Func<string, Vergleichssatz?>? VergleichProjektGabe => VergleichGemischt ? null : VergleichProjektsatz;
    private Func<string, Vergleichssatz?>? VergleichKatalogGabe => VergleichGemischt ? null : VergleichKatalogsatz;

    private Vergleichssatz? VergleichProjektsatz(string schluessel)
    {
        if (SichtbareWp.FirstOrDefault(w => w.Schluessel == schluessel) is WpEintrag w)
        {
            if (VergleichsparameterWpProjekt is null) return null;
            string g = "";
            IReadOnlyList<Parameterwert>? pw = Katalogladung.SatzDazu(() => VergleichsparameterWpProjekt(w.Daten.IdWp), w.Daten.Bezeichner, ref g);
            if (g.Length > 0) BeiSchlossAbgelehnt(g);
            return Vergleichssatz.AusParametern(Satzmarke.Projektsatz, w.Daten.Bezeichner, pw);
        }
        Zeile? z = Sichtbare.FirstOrDefault(r => r.Schluessel == schluessel);
        if (z is null) return null;
        if (VergleichsparameterProjekt is not null && z.Arbeit.GeraetId is int id && id > 0)
        {
            string grund = "";
            IReadOnlyList<Parameterwert>? werte = Katalogladung.SatzDazu(() => VergleichsparameterProjekt(id),
                                                                         z.Arbeit.Bezeichner, ref grund);
            if (grund.Length > 0) BeiSchlossAbgelehnt(grund);
            return Vergleichssatz.AusParametern(Satzmarke.Projektsatz, z.Arbeit.Bezeichner, werte);
        }
        if (z.Arbeit.Geraet is null) return null;
        return new Vergleichssatz(Satzmarke.Projektsatz, z.Arbeit.Bezeichner, GeraetWerte(z.Arbeit.Geraet));
    }

    /// <summary>Die Kennwerte eines Katalogsatzes für „Vergleichen…" — die Parameterübersicht, ohne sie die Profilspalten.</summary>
    private Vergleichssatz? VergleichKatalogsatz(string schluessel)
    {
        Katalogfilterzeile? k = _katalog.FirstOrDefault(r => r.Schluessel == schluessel);
        if (k is null) return null;
        if (KatalogIstWp(k.Schluessel))
            return VergleichsparameterWp is not null
                ? Vergleichssatz.AusParametern(Satzmarke.Katalogsatz, k.Bezeichner, VergleichsparameterWp(k.Bezeichner))
                : Vergleichssatz.AusSpalten(Satzmarke.Katalogsatz, Profil, k);
        return Vergleichsparameter is not null
            ? Vergleichssatz.AusParametern(Satzmarke.Katalogsatz, k.Bezeichner, Vergleichsparameter(k.Bezeichner))
            : Vergleichssatz.AusSpalten(Satzmarke.Katalogsatz, Katalogprofil, k);
    }

    /// <summary>Die Kennwerte einer Projektkopie für den Vergleich — dieselben Felder wie die Gerätegruppe des Satzes.</summary>
    private IReadOnlyList<(string Beschriftung, string Wert)> GeraetWerte(KaeltemaschineGeraetwerte g)
    {
        static string Mit(string name, string einheit) => einheit.Length > 0 ? name + " [" + einheit + "]" : name;
        return new List<(string, string)>
        {
            (Texte.LabelFirma, g.Firma ?? ""),
            (Texte.LabelTyp, g.Typ ?? ""),
            (Mit(Texte.LabelNennkaelteleistung, Texte.EinheitKw), Zahl(g.Nennkaelteleistung, 1)),
            (Texte.LabelNennEer, Zahl(g.NennEer, 2)),
            (Texte.LabelRueckkuehlart, g.Rueckkuehlart ?? ""),
            (Mit(Texte.LabelMindestteillast, Texte.EinheitProzent), Zahl(g.Mindestteillast, 0)),
            (Mit(Texte.LabelKaltwasserMin, Texte.EinheitGradC), Zahl(g.KaltwasserMin, 1)),
            (Texte.LabelTeillastWeg, g.TeillastWeg ?? ""),
            (Texte.LabelVerdichterregelung, g.Verdichterregelung ?? ""),
            (Texte.LabelTaktverlust, g.Taktverlustfaktor ?? ""),
            (Texte.LabelKennfeldrand, g.Kennfeldrand ?? ""),
        };
    }

    /// <summary>„Neu…" der Knopfleiste am Satz (AW3b): legt immer einen Katalogsatz an — der Katalogeditor im Modus Neu.</summary>
    private void BeiNeu()
    {
        if (EditorOeffnen(0)) _editorNeu = true;
    }

    private void BeiLoeschenGefragt()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele().Where(z => !z.Geschuetzt).ToList();
        if (ziele.Count == 0) { BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN); return; }
        _loeschziele = ziele;
        _loeschfrageText = ziele.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, Texte.FrageKatalogLoeschen, ziele[0].Bezeichner)
            : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, ziele.Count,
                            string.Join(", ", ziele.Select(z => "„" + z.Bezeichner + "“")));
        _loeschfrage = true;
    }

    /// <summary>Löscht die Sätze über den Fangweg (<c>Katalogladung.Loeschen</c>); ein abgelehnter meldet den Grund.</summary>
    private void BeiLoeschfrage(bool? ja)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (ja != true) return;
        int geloescht = 0;
        foreach (Katalogfilterzeile z in ziele)
        {
            Func<int, string>? weg = KatalogIstWp(z.Schluessel) ? WpKatalogLoeschen : KatalogLoeschen;
            if (weg is null) continue;
            string grund = Katalogladung.Loeschen(() => weg(z.Id) ?? "", z.Bezeichner, g => g);
            if (grund.Length > 0) { Melden(grund, true); continue; }
            geloescht++;
            if (z.Schluessel == _katalogGewaehlt) { _katalogGewaehlt = ""; _katalogZeile = null; _katalogWerte = null; }
        }
        if (geloescht == 0) return;
        KatalogKaestchenLeeren();
        KatalogNeuLaden();
    }

    private void BeiSchlossGeschaltet(string status)
    {
        KatalogNeuLaden();
        if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Schluessel);
        Melden(status ?? "", false);
    }

    private void BeiSchlossAbgelehnt(string grund) => Melden(grund ?? "", true);

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    /// <summary>„Typkennfelder laden…": lädt über die Gabe, liest den Katalog neu und meldet im Banner.</summary>
    private void TypkennfelderEinspielen()
    {
        if (TypkennfelderLaden is null) return;
        KaeltemaschineTypkennfelderErgebnis e = Katalogladung.Schreiben(TypkennfelderLaden, Texte.Titel,
            g => new KaeltemaschineTypkennfelderErgebnis(false, 0, 0, g));
        if (!e.Ok)
        {
            Melden(e.Meldung.Length > 0 ? e.Meldung : Texte.TypkennfelderFehler, true);
            return;
        }
        Melden(string.Format(CultureInfo.CurrentCulture, Texte.TypkennfelderGeladen, e.Neu, e.Uebersprungen), false);
        KatalogNeuLaden();
    }

    /// <summary>
    /// „Katalogverwaltung…": der Katalogeditor als Überlagerung, wenn die Hülle die Gaben reicht; sonst die Naht
    /// <c>Dienste.Navigation</c> (iOS: freie Ansicht der Wurzel) — dann halten ungespeicherte Änderungen an,
    /// denn die Verwaltung löst diese Ansicht ab.
    /// </summary>
    private void VerwaltungOeffnen()
    {
        if (EditorOeffnen(_katalogZeile?.Id ?? 0)) return;
        if (ArbeitsstandGeaendert) { Melden(Texte.VerwaltungUngespeichert, true); return; }
        bool offen = WindowsFormsApplication1.Dienste.Navigation
            .OeffneMaske(EPOS.UI.Seiten.Seitenschluessel.KaeltemaschineKatalog, "");
        if (!offen) Melden(Texte.VerwaltungNicht, true);
    }

    /// <summary>Steht im Arbeitsstand etwas, das erst der OK-Weg schreibt (oder Abbrechen zurücknimmt)?</summary>
    private bool ArbeitsstandGeaendert
        => _wp.Any(w => w.Entfernt) || _wpUebernahmen.Count > 0 || _wpEingeschaltet.Count > 0 || _zeilen.Any(z => z.Entfernt || z.Neu || z.Gespeichert || !z.Arbeit.GleicheEingaben(z.Gelesen));

    // =====================================================================
    // Wärmepumpen im Kühlbetrieb — Ausschalten beim OK, Zurücknehmen beim Abbrechen (KM-K1)
    // =====================================================================

    private bool WaermepumpenSchreiben()
    {
        if (WpKuehlbetriebSetzen is null) return true;
        foreach (WpEintrag w in _wp.Where(w => w.Entfernt).ToList())
        {
            string? grund;
            try { grund = WpKuehlbetriebSetzen(w.Daten.IdWp, false); }
            catch (Exception) { grund = Texte.WaermepumpenFehler; }
            if (!string.IsNullOrEmpty(grund)) { Melden(grund, true); return false; }
            _wp.Remove(w);
        }
        _wpUebernahmen.Clear();
        _wpEingeschaltet.Clear();
        return true;
    }

    /// <summary>Abbrechen: Übernahmen zurück (jüngste zuerst), eingeschaltete Wärmepumpen aus, Ränge wie beim Öffnen.</summary>
    private void WaermepumpenVerwerfen()
    {
        bool angefasst = _wpUebernahmen.Count > 0 || _wpEingeschaltet.Count > 0;
        for (int i = _wpUebernahmen.Count - 1; i >= 0; i--)
        {
            object m = _wpUebernahmen[i];
            Katalogladung.Schreiben(() => { WpUebernahmeZuruecknehmen?.Invoke(m); return ""; }, Texte.Titel, g => g);
        }
        foreach (int id in _wpEingeschaltet)
            Katalogladung.Schreiben(() => WpKuehlbetriebSetzen?.Invoke(id, false) ?? "", Texte.Titel, g => g);
        if (angefasst && KaelteRaengeWiederherstellen is not null)
            Katalogladung.Schreiben(() => KaelteRaengeWiederherstellen(_raengeBeimOeffnen) ?? "", Texte.Titel, g => g);
        _wpUebernahmen.Clear();
        _wpEingeschaltet.Clear();
    }

    // =====================================================================
    // OK / Abbrechen
    // =====================================================================

    /// <summary>Der Prüfbefund einer Anlage; <c>null</c> = in Ordnung.</summary>
    private string? Pruefbefund(KaeltemaschineAnlageDaten d)
    {
        string? grund = Pruefen?.Invoke(d);
        return string.IsNullOrEmpty(grund) ? null : grund;
    }

    private async Task BeiErgebnis(bool ok)
    {
        if (!ok) { await Verwerfen(); return; }
        if (Schreiben()) await Geschlossen.InvokeAsync(true);
    }

    /// <summary>
    /// Der OK-Weg: prüft jede Anlage, schreibt noch offene Eingaben (etwa des Assistenten), löscht die
    /// vorgemerkten Anlagen und schreibt die Schalter der Wärmepumpen. <c>false</c> = abgelehnt, Meldung steht;
    /// ein zweites OK wiederholt nichts, was schon geschrieben ist.
    /// </summary>
    private bool Schreiben()
    {
        _meldung = "";
        foreach (Zeile z in Sichtbare)
        {
            if (!AnlageSchreiben(z, out string? grund))
            {
                ProjektZeileWaehlen(z);
                Melden(grund ?? "", true);
                return false;
            }
        }
        foreach (Zeile z in _zeilen.Where(z => z.Entfernt).ToList())
        {
            if (!AnlageLoeschen(z)) return false;
            _zeilen.Remove(z);
        }
        foreach (Zeile z in _zeilen) z.Original = z.Gelesen?.Kopie() ?? z.Arbeit.Kopie();   // nichts mehr abzuräumen
        return WaermepumpenSchreiben();
    }

    /// <summary>
    /// Abbrechen, ✕ und Esc: die in der Sitzung angelegten Anlagen gehen wieder (Projektkopievormerkung), eine
    /// in der Sitzung geschriebene Anlage bekommt ihren Stand beim Öffnen zurück; vorgemerkte Entfernungen und
    /// die Schalter der Wärmepumpen verfallen.
    /// </summary>
    private Task Verwerfen()
    {
        foreach (Zeile z in _zeilen.ToList())
        {
            if (z.Neu) { AnlageLoeschen(z); _zeilen.Remove(z); continue; }
            if (z.Gespeichert && z.Original is KaeltemaschineAnlageDaten alt && Speichern is not null)
                Katalogladung.Schreiben(() => Speichern(alt), alt.Bezeichner, g => g);
        }
        WaermepumpenVerwerfen();
        return Geschlossen.InvokeAsync(false);
    }

    private async Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (_katalogschloss?.FrageOffen == true || _editorGaben is not null || _satzGross) return;
        if (_loeschfrage) { _loeschfrage = false; return; }
        await Verwerfen();
    }

