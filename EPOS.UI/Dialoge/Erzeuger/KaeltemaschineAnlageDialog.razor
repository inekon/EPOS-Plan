    /// <summary>
    /// <b>Die Zusammenfassung des gewählten Satzes</b> (UeS2): beim Projektsatz Nennkälteleistung, EER, Rückkühlart,
    /// Anzahl, Kühlträger, Zähler und die Kosten; beim Katalogsatz Hersteller, Nennkälteleistung, EER, Rückkühlart
    /// und Geräteart aus den Spalten der Katalogliste.
    /// </summary>
    public IReadOnlyList<Satzangabe> Zusammenfassung()
    {
        var liste = new List<Satzangabe>();
        if (SatzArt != Satzmarke.Keiner)
            liste.Add(new(Resource.KMA_SP_ART, SatzIstWaermepumpe ? Resource.KMA_ART_WAERMEPUMPE : Resource.KMA_ART_KAELTEMASCHINE));
        if (AktuellWp is WpEintrag w)
        {
            // KM-K1: die Kurzangaben der Wärmepumpe (Konzept 5.10a) und ihre Zeile „Zulässigkeit“.
            KuehlWaermepumpeZeile wd = w.Daten;
            if (wd.KuehlleistungKw is double wkw) liste.Add(new(Resource.KMA_LBL_KUEHLLEISTUNG, Satzangaben.Zahl(wkw, Texte.EinheitKw)));
            if (wd.Eer is double weer) liste.Add(new(Texte.SpalteEer, Zahl(weer, 2)));
            if (wd.KuehlVorlauf is int vl) liste.Add(new(Resource.KMA_LBL_KUEHLVORLAUF, vl.ToString(CultureInfo.CurrentCulture) + " " + Texte.EinheitGradC));
            if (!string.IsNullOrWhiteSpace(wd.Quelle)) liste.Add(new(Resource.KMA_LBL_QUELLE, wd.Quelle));
            if (!string.IsNullOrWhiteSpace(wd.Kuehltraeger)) liste.Add(new(Texte.LabelTraeger, wd.Kuehltraeger));
            liste.Add(new(Texte.LabelZaehler, wd.EigenerZaehler ? Texte.Ja : Texte.Nein));
            liste.Add(new(Resource.KMA_LBL_RANG, wd.Rang is int wr ? wr.ToString(CultureInfo.CurrentCulture) : Resource.KMA_RANG_KEINER));
            if (!string.IsNullOrWhiteSpace(wd.Zulaessigkeit)) liste.Add(new(Resource.KMA_LBL_ZULAESSIGKEIT, wd.Zulaessigkeit));
            return liste;
        }
        if (Aktuell is Zeile a)
        {
            KaeltemaschineAnlageDaten d = a.Arbeit;
            KaeltemaschineGeraetwerte? g = d.Geraet;
            if (g?.Nennkaelteleistung is double kw)
            {
                liste.Add(new(Texte.LabelNennkaelteleistung, Satzangaben.Zahl(kw, Texte.EinheitKw)));
                if ((d.Anzahl ?? 1) > 1)
                    liste.Add(new(Resource.AUSWAHL_ZF_LEISTUNG_GESAMT, Satzangaben.Zahl(kw * (d.Anzahl ?? 1), Texte.EinheitKw)));
            }
            if (EerText(g) is { Length: > 0 } eer) liste.Add(new(Texte.SpalteEer, eer));
            if (!string.IsNullOrWhiteSpace(g?.Rueckkuehlart)) liste.Add(new(Texte.LabelRueckkuehlart, g!.Rueckkuehlart));
            liste.Add(new(Resource.AUSWAHL_ZF_ANZAHL, AnzahlText(d)));
            if (TraegerText(d) is { Length: > 0 } traeger) liste.Add(new(Texte.LabelTraeger, traeger));
            liste.Add(new(Texte.LabelZaehler, d.KuehlEigenerZaehler ? Texte.Ja : Texte.Nein));
            if (RangKm(a) is { Length: > 0 } rang) liste.Add(new(Resource.KMA_LBL_RANG, rang));
            if (!string.IsNullOrWhiteSpace(d.Zulaessigkeit)) liste.Add(new(Resource.KMA_LBL_ZULAESSIGKEIT, d.Zulaessigkeit));
            Satzangaben.Kosten(liste, _kosten);
        }
        else if (_katalogZeile is Katalogfilterzeile z)
        {
            if (KatalogIstWp(z.Schluessel))
                Satzangaben.Katalog(liste, z, Profil, Katalogfilterprofil.SpHersteller, Katalogfilterprofil.SpNennkaelteleistung,
                                    Katalogfilterprofil.SpEer, Katalogfilterprofil.SpQuelle);
            else
                Satzangaben.Katalog(liste, z, Profil, Katalogfilterprofil.SpHersteller, Katalogfilterprofil.SpNennkaelteleistung,
                                    Katalogfilterprofil.SpEer, Katalogfilterprofil.SpRueckkuehlart, Katalogfilterprofil.SpGeraeteart);
            // Ein Katalogsatz trägt kein Inbetriebnahmejahr: die Zulässigkeit ist „nicht geprüft“ (offener Punkt 3).
            liste.Add(new(Resource.KMA_LBL_ZULAESSIGKEIT, Resource.KMA_ZULAESSIGKEIT_NICHT_GEPRUEFT));
        }
        return liste;
    }

    private void KostenNachziehen()
    {
        _kosten = null;
        if (Kostensumme is null || Aktuell is not Zeile a || a.Arbeit.AnlagenId <= 0) return;
        // KT-8c: über die Fangstelle — wirft die Summe, fehlt die Angabe, und der Banner nennt den Grund.
        Func<int, (double Invest, double Betrieb)> summe = Kostensumme;
        int anlagenId = a.Arbeit.AnlagenId;
        _kosten = Katalogladung.Wert<(double Invest, double Betrieb)?>(() => summe(anlagenId), a.Arbeit.Bezeichner, null,
                                                                      out string kostenGrund);
        if (kostenGrund.Length > 0) Melden(kostenGrund, true);
    }

    /// <summary>
    /// KT-8c: Der Weg in die Kostenverwaltung läuft über die Fangstelle
    /// (<c>Katalogladung.SchreibenAsync</c>): Wirft er, nennt der Banner den Grund, das Protokoll
    /// hat einen Vermerk, und der Dialog bleibt offen.
    /// </summary>
    private async Task BeiKosten(Zeile zeile, bool betrieb)
    {
        if (KostenOeffnen is null || zeile.Arbeit.AnlagenId <= 0) return;
        Func<int, bool, Task> oeffnen = KostenOeffnen;
        string grund = await Katalogladung.SchreibenAsync(async () => { await oeffnen(zeile.Arbeit.AnlagenId, betrieb); return ""; },
                                                          zeile.Arbeit.Bezeichner, g => g);
        if (grund.Length > 0) { Melden(grund, true); StateHasChanged(); }
    }

