    /// <summary>Wechsel der Geltung: Zur Anlage hin nimmt sie die gerade geltende Wahl
    /// mit, zum Projekt hin folgt sie wieder der Projektvorgabe.</summary>
    private void UebScope(int? n)
    {
        if (_uebA is null) return;
        bool nurAnlage = n == 1;
        if (nurAnlage == _uebNurAnlage) return;
        if (nurAnlage)
        {
            _uebA.EnergiesteuerWahl = UebEsWahlWert();
            _uebA.AufteilungMethode = UebAufteilungWert();
        }
        else
        {
            _uebA.EnergiesteuerWahl = "";
            _uebA.AufteilungMethode = "";
        }
        _uebNurAnlage = nurAnlage;
    }

