610;36;IAN=VDIRWERT('700',I70,'730',I73,3);
610;37;IF(IAN>=1) B1=VDIRWERT('700',I70,'730',I73,4);
610;38;IF(IAN>=2) B2=VDIRWERT('700',I70,'730',I73,5);
610;39;IF(IAN>=3) B3=VDIRWERT('700',I70,'730',I73,6);
610;40;IF(IAN>=4) B4=VDIRWERT('700',I70,'730',I73,7);
610;41;I73=VDIFOLGE('700',I70,'730',I73);
610;42;ENDIF;
610;43;IF(I73==5) THEN;
