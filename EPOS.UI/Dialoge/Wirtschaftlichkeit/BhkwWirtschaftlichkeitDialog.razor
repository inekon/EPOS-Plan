    ///
    /// <para><b>Warum das nötig ist.</b> <c>Anwenden</c> läuft VOR dem Schreibaufruf —
    /// nach einem gescheiterten Versuch gleichen Arbeitsstand und hereingereichtes
    /// Objekt einander. Ohne dieses Merkmal hielte die Änderungsprüfung des OK-Wegs
    /// (04/B30) den Schritt für erledigt und überspränge ihn: Der zweite OK schlösse
    /// den Dialog, ohne dass die Angabe jemals geschrieben wäre. Ein gescheiterter
    /// Schritt bleibt deshalb fällig, bis er gelingt.</para>
    /// </summary>
    private readonly List<bool> _anlageFehlversuch = new List<bool>();

    /// <summary>Der Arbeitsstand der Projektvorgaben.</summary>
    private BhkwVorgabenstand _vorgaben = new BhkwVorgabenstand();

    /// <summary>Sind die Projektvorgaben im OK-Weg schon geschrieben?</summary>
    private bool _vorgabenGeschrieben;

    /// <inheritdoc cref="_anlageFehlversuch"/>
    private bool _vorgabenFehlversuch;

