@* Zeileneditor einer Vorlagenposition (iU9-W1.1).

   Vorbild: Views/Kosten/Form_VorlagenPosition.cs und .Designer.cs (Etappe KD2,
   Konzept Kostendialoge Rev. 1.2, § 5.2 - Stift-Symbol). Uebernommen sind der
   Feldbestand der Feldkarte (Bezeichnung, Kostenart, Erlös-Kennzeichen,
   Empfehlung von/bis), die Vorbelegung aus SetControls samt Rueckfall auf
   "sonstige" und die Regel, dass eine leere Empfehlung zulaessig ist
   (Program.ZahlPruefen mit leerErlaubt = true).

   NICHT uebernommen ist die Kostenartenliste selbst: Der Vorlaeufer baute sie
   im Konstruktor aus DbWerte.KOSTENART_* und uebersetzte sie ueber
   Resource.KOSTENART_*. Beides gehoert in den Kern; die Komponente bekommt die
   fertigen Eintraege als Parameter und gibt die gewaehlte Id zurueck.

   Nutzungsdauer und Satz stehen im Raster der Hostmaske (FK4) und werden hier
   wie bisher NICHT gedoppelt.

   TEXTE. Der Vorlaeufer traegt unlokalisierte deutsche Literale. Sie stehen
   hier woertlich als Standardwerte von [Parameter] string; die Huelle setzt sie
   auf die Schluessel VPOS_* (Sammelnachtrag W1.7).

   TASTATUR. Wie im ersten Dialog (iZ5): Wurzel-div mit tabindex="-1",
   Erstfokus dort, Enter = OK, Esc = Abbrechen. *@

@namespace EPOS.UI.Dialoge.Kosten
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="@(() => BeiErgebnis(false))" />
        }
    </div>

    @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben dem Feld,
       Zahlenfelder kurz mit der Einheit dahinter. *@
    <Formularraster>
        <KindInhalt>
            <Textfeld Bezeichnung="@LabelBezeichnung" Wert="@_bezeichnung" WertChanged="BeiBezeichnung" />

            <Auswahlfeld Bezeichnung="@LabelKostenart"
                         Eintraege="@Kostenarten"
                         Auswahl="@_kostenart"
                         AuswahlChanged="BeiKostenart" />

            <Schalter Bezeichnung="@LabelErloes" Wert="@_istErloes" WertChanged="BeiErloes" />

            @* U8 (Stufe S2, Konzept Nutzungsdauer 2.4.3): DER PFLEGEORT DER
               POSITIONSART. Bis dahin setzte sie ausschliesslich die
               Vorlagenuebernahme - kein Dialog liess sie waehlen, und eine
               Abgasanlage bekam damit nie eine andere Dauer als ihr Kessel. Die
               Liste ist leer, wo es die Nutzungsdauertabelle nicht gibt; dann
               steht das Feld gar nicht erst da. *@
            @if (Positionsarten.Count > 0)
            {
                <Auswahlfeld Bezeichnung="@LabelPositionsart"
                             Eintraege="@Positionsarten"
                             Platzhalter="@PositionsartKeine"
                             Auswahl="@_positionsart"
                             AuswahlChanged="BeiPositionsart" />
                <Herleitungszeile Text="@InfoPositionsart" />
            }

            @* ETAPPE E7c (Schritt E, Entscheid A6, Mockup U39): ERSATZ UND RESTWERT JE
               POSITION, entkoppelt und dreiwertig - leer (wie bisher), ja, nein. Nur auf
               der Investitionsseite und nur, wo die Datenbank die Spalten fuehrt
               (Schemaschritt 111); sonst steht das Feld gar nicht erst da. Die Eintraege,
               der Platzhalter und die Herleitungszeile kommen fertig aus dem Kern. *@
            @if (MitKennzeichen)
            {
                <Auswahlfeld Bezeichnung="@LabelErsatz"
                             Eintraege="@Kennzeichen"
                             Platzhalter="@KennzeichenLeer"
                             Auswahl="@_ersatz"
                             AuswahlChanged="BeiErsatz" />
                <Auswahlfeld Bezeichnung="@LabelRestwert"
                             Eintraege="@Kennzeichen"
                             Platzhalter="@KennzeichenLeer"
                             Auswahl="@_restwert"
                             AuswahlChanged="BeiRestwert" />
                <Herleitungszeile Text="@InfoKennzeichen" />
            }

            @* ETAPPE E16 (V-G3, DIN EN 17463 6.3.1): DIE WIEDERHOLPERIODE "alle ... Jahre" -
               1 = jaehrlich. Nur auf der Betriebsseite und nur, wo die Datenbank die Spalte
               fuehrt (Schemaschritt E16); sonst steht das Feld gar nicht erst da. Die
               Herleitungszeile nennt "alle n Jahre ab Jahr X" - den Satz baut der Kern. *@
            @if (MitWiederholperiode)
            {
                <Ganzzahlfeld Bezeichnung="@LabelWiederholperiode"
                              Wert="@_periode"
                              WertChanged="BeiPeriode"
                              Einheit="@EinheitWiederholperiode"
                              Min="1"
                              Max="@WiederholperiodeMax" />
                <Herleitungszeile Text="@InfoPeriode" />
            }

            <Zahlenfeld Bezeichnung="@LabelEmpfehlungVon" Wert="@_empfVon" WertChanged="BeiEmpfVon" />

            <Zahlenfeld Bezeichnung="@LabelEmpfehlungBis" Wert="@_empfBis" WertChanged="BeiEmpfBis" />
        </KindInhalt>
    </Formularraster>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_meldung" />
    }

    <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
</div>

@code {
    /// <summary>
    /// Die waehlbaren Kostenarten nach VDI 2067 in Anzeigereihenfolge - fertig
    /// uebersetzt. Die Id ist der Index in der Liste des Aufrufers.
    /// </summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Kostenarten { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Bezeichnung der Position beim Oeffnen.</summary>
    [Parameter] public string Bezeichnung { get; set; } = "";

    /// <summary>
    /// Id der Kostenart beim Oeffnen. <c>null</c> waehlt den Rueckfall
    /// (<see cref="RueckfallKostenartId"/>) - genau wie
    /// <c>SetControls</c>: <c>index &gt;= 0 ? index : 3</c>.
    /// </summary>
    [Parameter] public int? KostenartId { get; set; }

    /// <summary>
    /// Die Kostenart, die eine unbekannte oder fehlende Angabe bekommt. Vorgabe 3
    /// = "sonstige", der Rueckfall des Vorlaeufers.
    /// </summary>
    [Parameter] public int RueckfallKostenartId { get; set; } = 3;

    /// <summary>Erlös/Zuschuss beim Oeffnen.</summary>
    [Parameter] public bool IstErloes { get; set; }

    /// <summary>Untere Empfehlung beim Oeffnen; <c>null</c> = nicht gepflegt.</summary>
    [Parameter] public double? EmpfehlungVon { get; set; }

    /// <summary>Obere Empfehlung beim Oeffnen; <c>null</c> = nicht gepflegt.</summary>
    [Parameter] public double? EmpfehlungBis { get; set; }

    /// <summary>
    /// U8 (Stufe S2): Die waehlbaren POSITIONSARTEN dieser Technik (Zeilen der
    /// Technik, danach die technikuebergreifenden) - Id ist
    /// <c>Tab_Nutzungsdauer.ID</c>. Leere Liste = kein Feld; so bleibt der Dialog
    /// auf einer Datenbank ohne die Nutzungsdauertabelle der von vorher.
    /// </summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Positionsarten { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Die Positionsart beim Oeffnen; <c>null</c> = keine.</summary>
    [Parameter] public int? PositionsartId { get; set; }

    /// <summary>
    /// ETAPPE E7c (Schritt E): Zeigt der Dialog die zwei Kennzeichen „Ersatzbeschaffung
    /// führen" und „Restwert ansetzen"? Die Huelle setzt es auf der Investitionsseite,
    /// sofern die Datenbank die Spalten fuehrt (Schemaschritt 111).
    /// </summary>
    [Parameter] public bool MitKennzeichen { get; set; }

    /// <summary>ETAPPE E7c: die Eintraege beider Klapplisten („ja", „nein") — fertig
    /// uebersetzt; leer ist der Platzhalter (<see cref="KennzeichenLeer"/>).</summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Kennzeichen { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>ETAPPE E7c: der Platzhalter beider Klapplisten — leer = wie bisher.</summary>
    [Parameter] public string KennzeichenLeer { get; set; } = "(leer — wie bisher)";

    /// <summary>ETAPPE E7c: „Ersatzbeschaffung führen" beim Oeffnen; <c>null</c> = leer.</summary>
    [Parameter] public int? ErsatzAuswahl { get; set; }

    /// <summary>ETAPPE E7c: „Restwert ansetzen" beim Oeffnen; <c>null</c> = leer.</summary>
    [Parameter] public int? RestwertAuswahl { get; set; }

    /// <summary>ETAPPE E7c: Beschriftung der ersten Klappliste.</summary>
    [Parameter] public string LabelErsatz { get; set; } = "Ersatzbeschaffung führen:";

    /// <summary>ETAPPE E7c: Beschriftung der zweiten Klappliste.</summary>
    [Parameter] public string LabelRestwert { get; set; } = "Restwert ansetzen:";

    /// <summary>ETAPPE E7c: die Herleitungszeile unter beiden Klapplisten.</summary>
    [Parameter] public string InfoKennzeichen { get; set; } = "";

    /// <summary>
    /// ETAPPE E16 (V‑G3): Zeigt der Dialog das Ganzzahlfeld „alle … Jahre"? Die Huelle setzt
    /// es auf der Betriebsseite, sofern die Datenbank die Spalte fuehrt.
    /// </summary>
    [Parameter] public bool MitWiederholperiode { get; set; }

    /// <summary>ETAPPE E16: die Wiederholperiode beim Oeffnen [a]; 1 oder <c>null</c> = jaehrlich.</summary>
    [Parameter] public int? Wiederholperiode { get; set; }

    /// <summary>ETAPPE E16: die Obergrenze des Feldes [a].</summary>
    [Parameter] public int? WiederholperiodeMax { get; set; } = 99;

    /// <summary>ETAPPE E16: Beschriftung des Feldes.</summary>
    [Parameter] public string LabelWiederholperiode { get; set; } = "Zahlung alle:";

    /// <summary>ETAPPE E16: die Einheit hinter dem Feld.</summary>
    [Parameter] public string EinheitWiederholperiode { get; set; } = "Jahre";

    /// <summary>ETAPPE E16: die leise Zeile unter dem Feld — was 1 und n bedeuten.</summary>
    [Parameter] public string InfoWiederholperiode { get; set; }
        = "1 = jährlich. Ab 2 zahlt die Position im Startjahr und danach alle n Jahre (DIN EN 17463, 6.3.1).";

    /// <summary>
    /// ETAPPE E16: die Herleitung „alle n Jahre ab Jahr X" zu einer Periode — gebaut vom Kern
    /// (Startjahr der Projektzeile); leer bei jaehrlich. <c>null</c> = keine Herleitung.
    /// </summary>
    [Parameter] public Func<int?, string>? WiederholperiodeHerleitung { get; set; }

    /// <summary>Das Ergebnis bei OK, <c>null</c> bei Abbrechen. Geschlossen wird von der Huelle.</summary>
    [Parameter] public EventCallback<VorlagenPositionErgebnis?> Geschlossen { get; set; }

    /// <summary>Fenstertitel (Designer: lblKopfTitel / Form.Text).</summary>
    [Parameter] public string TitelText { get; set; } = "Position bearbeiten";

    /// <summary>Beschriftung des Textfeldes (Designer: lblBezeichnung).</summary>
    [Parameter] public string LabelBezeichnung { get; set; } = "Bezeichnung:";

    /// <summary>Beschriftung der Auswahlliste (Designer: lblKostenart).</summary>
    [Parameter] public string LabelKostenart { get; set; } = "Kostenart:";

    /// <summary>Beschriftung des Schalters (Designer: chkErloes).</summary>
    [Parameter] public string LabelErloes { get; set; } = "Erlös/Zuschuss (negativer Ausweis)";

    /// <summary>Beschriftung des ersten Zahlenfeldes (Designer: lblEmpfehlung).</summary>
    [Parameter] public string LabelEmpfehlungVon { get; set; } = "Empfehlung von/bis:";

    /// <summary>Beschriftung des zweiten Zahlenfeldes (Designer: lblBis).</summary>
    [Parameter] public string LabelEmpfehlungBis { get; set; } = "bis";

    /// <summary>U8: Beschriftung der Positionsart-Klappliste.</summary>
    [Parameter] public string LabelPositionsart { get; set; } = "Positionsart:";

    /// <summary>U8: Die leere Zeile der Klappliste — keine Positionsart gepflegt.</summary>
    [Parameter] public string PositionsartKeine { get; set; } = "(keine — Standardzeile der Technik)";

    /// <summary>U8: Die leise Zeile unter der Klappliste.</summary>
    [Parameter] public string InfoPositionsart { get; set; }
        = "Die Positionsart bestimmt die Nutzungsdauer aus „Nutzungsdauern (AfA)\"; "
        + "eine Änderung setzt sie neu.";

    /// <summary>
    /// Meldung bei leerer Bezeichnung (A-1: der Vorlaeufer liess den alten Namen
    /// still stehen).
    /// </summary>
    [Parameter] public string MeldungNameFehlt { get; set; } = "Bitte eine Bezeichnung eingeben.";

    /// <summary>Beschriftung des OK-Knopfes.</summary>
    [Parameter] public string OkText { get; set; } = "OK";

    /// <summary>Beschriftung des Abbrechen-Knopfes.</summary>
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Schluessel des Hilfeknopfes - die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_VorlagenPosition.btn_Help";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private string _bezeichnung = "";
    private int? _kostenart;
    private bool _istErloes;
    private double? _empfVon;
    private double? _empfBis;
    private int? _positionsart;
    private int? _ersatz;
    private int? _restwert;
    private int? _periode = 1;
    private string _meldung = "";

    /// <summary>ETAPPE E16: die eingegebene Wiederholperiode (Pruefhilfe fuer Tests).</summary>
    public int? Periode => _periode;

    /// <summary>ETAPPE E16: die Zeile unter dem Feld — Bedeutung und, bei n ≥ 2, die
    /// Herleitung „alle n Jahre ab Jahr X".</summary>
    private string InfoPeriode
    {
        get
        {
            string herleitung = WiederholperiodeHerleitung?.Invoke(_periode) ?? "";
            return herleitung.Length > 0 ? InfoWiederholperiode + " " + herleitung : InfoWiederholperiode;
        }
    }

    /// <summary>ETAPPE E7c: die Wahl „Ersatzbeschaffung führen" (Pruefhilfe fuer Tests).</summary>
    public int? Ersatz => _ersatz;

    /// <summary>ETAPPE E7c: die Wahl „Restwert ansetzen" (Pruefhilfe fuer Tests).</summary>
    public int? Restwert => _restwert;

    /// <summary>Die gewaehlte Kostenart (Pruefhilfe fuer Tests).</summary>
    public int? Kostenart => _kostenart;

    /// <summary>Die gewaehlte Positionsart (Pruefhilfe fuer Tests).</summary>
    public int? Positionsart => _positionsart;

    protected override void OnInitialized()
    {
        _bezeichnung = Bezeichnung ?? "";
        _istErloes = IstErloes;
        _empfVon = EmpfehlungVon;
        _empfBis = EmpfehlungBis;
        // U8: Eine Positionsart, die es in dieser Technik nicht (mehr) gibt, faellt
        // auf "keine" zurueck - dieselbe Vorsicht wie bei der Kostenart.
        _positionsart = PositionsartId.HasValue && ArtBekannt(PositionsartId.Value)
            ? PositionsartId : null;
        // ETAPPE E7c: Eine unbekannte Wahl faellt auf leer (wie bisher) zurueck -
        // dieselbe Vorsicht wie bei der Positionsart.
        _ersatz = ErsatzAuswahl.HasValue && KennzeichenBekannt(ErsatzAuswahl.Value)
            ? ErsatzAuswahl : null;
        _restwert = RestwertAuswahl.HasValue && KennzeichenBekannt(RestwertAuswahl.Value)
            ? RestwertAuswahl : null;
        // ETAPPE E16: leer, 0 oder negativ heisst jaehrlich (1); ueber der Grenze wird geklemmt.
        _periode = PeriodeGeklemmt(Wiederholperiode);
        // Wie SetControls: eine unbekannte Kostenart faellt auf "sonstige" zurueck.
        _kostenart = KostenartId.HasValue && Bekannt(KostenartId.Value)
            ? KostenartId : RueckfallKostenartId;

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.VORLAGENPOSITION,
                                          () => KiSicht(), KiHaken());
    }

    // =================================================================================
    // Der Hilfe-Assistent (Welle KI-F4)
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private VorlagenPositionKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die sechs lebenden Felder des Zeileneditors. Ein
    /// Daten-Objekt gibt es nicht — <c>VorlagenPositionErgebnis</c> entsteht erst
    /// beim OK und ist unveränderlich.
    /// </summary>
    private VorlagenPositionKiSicht KiSicht()
    {
        return _kiSicht ??= new VorlagenPositionKiSicht
        {
            BezeichnungLesen = () => _bezeichnung,
            BezeichnungSetzen = BeiBezeichnung,

            KostenartLesen = () => _kostenart,
            KostenartSetzen = BeiKostenart,
            KostenartEintraege = () => KiMaskenanmeldung.Eintraege(
                Kostenarten, z => z.Id, z => z.Text),

            ErloesLesen = () => _istErloes,
            ErloesSetzen = BeiErloes,

            PositionsartLesen = () => _positionsart,
            PositionsartSetzen = BeiPositionsart,
            PositionsartEintraege = () => KiMaskenanmeldung.Eintraege(
                Positionsarten, z => z.Id, z => z.Text),

            VonLesen = () => _empfVon,
            VonSetzen = w => _empfVon = w,
            BisLesen = () => _empfBis,
            BisSetzen = w => _empfBis = w,

            // ETAPPE E7c (Schritt E): die zwei Kennzeichen — nur, wenn der Dialog sie
            // zeigt; sonst liefert die Wahlliste nichts und der Assistent setzt nichts.
            ErsatzLesen = () => _ersatz,
            ErsatzSetzen = w => { if (MitKennzeichen) BeiErsatz(w); },
            RestwertLesen = () => _restwert,
            RestwertSetzen = w => { if (MitKennzeichen) BeiRestwert(w); },
            KennzeichenEintraege = () => MitKennzeichen
                ? KiMaskenanmeldung.Eintraege(Kennzeichen, z => z.Id, z => z.Text)
                : Array.Empty<KiKern.KiWahleintrag>(),

            // ETAPPE E16 (V‑G3): die Wiederholperiode — nur, wenn der Dialog das Feld zeigt.
            WiederholperiodeLesen = () => MitWiederholperiode ? _periode : null,
            WiederholperiodeSetzen = w => { if (MitWiederholperiode) BeiPeriode(w); }
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> Der Editor meldet sein Ergebnis an den Wirt; der
    /// schreibt es mit seinem eigenen OK.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private bool Bekannt(int id)
    {
        foreach (var eintrag in Kostenarten)
        {
            if (eintrag.Id == id) return true;
        }
        return false;
    }

    private void BeiBezeichnung(string wert)
    {
        _bezeichnung = wert;
        if (!string.IsNullOrWhiteSpace(wert)) _meldung = "";
    }

    private bool ArtBekannt(int id)
    {
        foreach (var eintrag in Positionsarten)
        {
            if (eintrag.Id == id) return true;
        }
        return false;
    }

    private void BeiKostenart(int? id) => _kostenart = id;

    private void BeiPositionsart(int? id) => _positionsart = id;

    private bool KennzeichenBekannt(int id)
    {
        foreach (var eintrag in Kennzeichen)
        {
            if (eintrag.Id == id) return true;
        }
        return false;
    }

    private void BeiErsatz(int? id) => _ersatz = id.HasValue && KennzeichenBekannt(id.Value) ? id : null;

    private void BeiRestwert(int? id) => _restwert = id.HasValue && KennzeichenBekannt(id.Value) ? id : null;

    private void BeiPeriode(int? wert) => _periode = PeriodeGeklemmt(wert);

    /// <summary>ETAPPE E16: leer, 0 und negative Zahlen heissen jaehrlich (1); die
    /// Obergrenze klemmt.</summary>
    private int? PeriodeGeklemmt(int? wert)
    {
        if (!wert.HasValue || wert.Value < 1) return 1;
        return WiederholperiodeMax.HasValue ? Math.Min(wert.Value, WiederholperiodeMax.Value) : wert;
    }

    private void BeiErloes(bool wert) => _istErloes = wert;

    private void BeiEmpfVon(double? wert) => _empfVon = wert;

    private void BeiEmpfBis(double? wert) => _empfBis = wert;

    private async Task BeiErgebnis(bool ok)
    {
        if (!ok)
        {
            await Geschlossen.InvokeAsync(null);
            return;
        }

        // A-1: btnOk_Click uebernahm den Namen nur, wenn er nicht leer war - ein
        // geleertes Feld holte still den alten Namen zurueck. Hier sagt es der
        // Dialog, statt die Eingabe stumm rueckgaengig zu machen.
        if (string.IsNullOrWhiteSpace(_bezeichnung))
        {
            _meldung = MeldungNameFehlt;
            return;
        }

        await Geschlossen.InvokeAsync(new VorlagenPositionErgebnis(
            _bezeichnung.Trim(),
            _kostenart ?? RueckfallKostenartId,
            _istErloes,
            _empfVon,
            _empfBis,
            _positionsart,
            MitKennzeichen ? _ersatz : null,
            MitKennzeichen ? _restwert : null,
            MitWiederholperiode ? _periode : null));
    }

    private Task BeiTaste(KeyboardEventArgs e) => e.Key switch
    {
        "Enter" => BeiErgebnis(true),
        "Escape" => BeiErgebnis(false),
        _ => Task.CompletedTask
    };
}
