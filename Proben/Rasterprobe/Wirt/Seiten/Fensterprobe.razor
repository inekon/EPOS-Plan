    protected override void OnInitialized()
    {
        var abfrage = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        if (abfrage.TryGetValue("fall", out var f)) _fall = f.ToString();
        if (abfrage.TryGetValue("kalender", out var kl) && kl.ToString() == "leer") _kpKalender.Clear();
        if (abfrage.TryGetValue("gebaeude", out var gb) && gb.ToString() == "0") _kpGebaeude.Clear();
        _steckbrief = abfrage.TryGetValue("steckbrief", out var sb) && sb == "1";   // WP1b: voller Feldsatz
        if (abfrage.TryGetValue("marke", out var m)) _marke = m.ToString() != "0";
        if (abfrage.TryGetValue("meldung", out var g)) { _meldung = g.ToString() == "1"; _meldungListe = g.ToString() == "liste"; }
        if (abfrage.TryGetValue("lizenz", out var l)) _lizenz = l.ToString() == "1";
        if (abfrage.TryGetValue("zeilen", out var z) && int.TryParse(z, out int n)) _anzahl = n;
        if (abfrage.TryGetValue("verwendet", out var v)) _verwendet = v.ToString() == "1";
        if (abfrage.TryGetValue("summe", out var s)) _summe = s.ToString();
        if (abfrage.TryGetValue("aufnahme", out var u)) _aufnahme = u.ToString() == "1";
    }

