@* Der WAERMEGANG-Reiter der Ergebnisseite (NavigatorWaerme, iU9-W11b.10).

   VORBILD. NavigatorWaerme (1 083 Z.) - das reichste Diagramm der Anwendung:
   Jahresganglinie ODER Jahresdauerlinie, wahlweise als PRODUKTION je Erzeuger
   oder als DECKUNG je Bedarfsart, dazu die Fuellstaende aller Speicher und die
   Bedarfslinie.

   ANWENDERRUECKMELDUNG 12.09.2026 (#234), zwei Punkte an dieser Stelle:
     VORBELEGUNG  Der Reiter startete ohne eine einzige gewaehlte Reihe - das
                  Bild zeigte beim Oeffnen den Leerhinweis. Beim ERSTEN Befuellen
                  sind jetzt alle vorhandenen Erzeuger, alle Speicher und die
                  Bedarfslinie an (OnParametersSet, Muster _erstBelegt aus
                  StromgangReiter).
     GEDAECHTNIS  Reiterblatt zeichnet @if (Sichtbar); beim Blattwechsel entsteht
                  diese Komponente NEU. Die Schalterstellung liegt deshalb in
                  Ganglinienstand und ueberlebt die Sitzung (nicht dauerhaft, kein
                  Datenzoom).
   Die zweite Y-Achse traegt seither den SPEICHERINHALT [kWh] und nicht mehr die
   Waermelast; die liegt als Leistung bei der Produktion auf der Primaerachse
   (SimulationErgebnisHuelle.Bilder.BildWaermegang).

   DREI ZUSTANDSACHSEN, woertlich uebernommen:
     _bedarfskanal   -1 = Gesamt (Produktion), sonst Kanalindex (Deckung),
     _sortiert       Ganglinie <-> Dauerlinie,
     _praesenz       welche Erzeuger zum Ergebnis gehoeren.
   Die Ereignissperre _imAufbau entfaellt: Ein Modellfeld loest kein Ereignis aus.

   FEHLENDE REIHEN WERDEN AUSGEBLENDET UND ABGEWAEHLT - sonst naehme der
   CSV-Export eine unsichtbare Spalte mit (NavigatorStrom :266, dieselbe Regel
   hier). Die Auswahl haengt deshalb an den Schluesseln der VORHANDENEN Reihen.

   DIE SUMMENLINIE IST EINE REIHE WIE JEDE ANDERE (Anwenderwunsch 15.09.2026):
   „Summe Waermeerzeugung" (Schluessel GESAMT) steht als erster Eintrag der
   Erzeugerliste, von ihren Summanden durch eine Trennlinie abgesetzt, ist
   vorbelegt an und faellt in dasselbe Sitzungsgedaechtnis. In den CSV-Export
   geht sie nicht: Die Huelle kennt zu GESAMT keinen Vektor, die Spalte entfaellt
   still - genau wie im Stromgang.

   DER EXPORT IST IMMER CHRONOLOGISCH, auch im sortierten Modus - woertlich
   (Begruendung NavigatorWaerme :295-297): Eine Dauerlinie hat keine Zeitachse,
   und eine CSV ohne Zeitstempel ist keine.

   WAS ENTFAELLT: CheckboxenAnordnen (72 Z. Pixelarithmetik), SerieAnlegen,
   ApplyCheckboxStates, WaermebedarfAchseAktualisieren (70 Z. zweite Achse) und
   SchluesselEintrag - ein Auswahlfeld trennt Steuerwert und Anzeigetext
   ohnehin. *@

@namespace EPOS.UI.Seiten.Simulation
@using WindowsFormsApplication1.Zeichnung
@inherits Farbwahlwirt

<div class="epos-simerg-block">

    <div class="epos-simerg-schalter">
        <Auswahlfeld Bezeichnung="@Resource.SIM_LABEL_BEDARFSART"
                     Eintraege="@Bedarfsarten" Auswahl="@_bedarfsart"
                     AuswahlChanged="BedarfsartGesetzt" />

        <Schalter Bezeichnung="@Resource.SIM_CHK_SORTIERT" Wert="@_sortiert"
                  WertChanged="@(w => { _sortiert = w; Merken(); })" />

        <Schalter Bezeichnung="@Resource.SIM_CHK_WAERMEBEDARF_EINBLENDEN" Wert="@_bedarfslinie"
                  WertChanged="@(w => { _bedarfslinie = w; Merken(); })" />
    </div>

    <div class="epos-simerg-spalten">
        @* DIE SUMMENLINIE STEHT UEBER IHREN SUMMANDEN (Anwenderwunsch 15.09.2026):
           „Summe Waermeerzeugung" ist der erste Eintrag der Erzeugerliste, durch eine
           Trennlinie abgesetzt (AbsatzNach) - und damit abschaltbar wie jeder einzelne
           Erzeuger. Sie liegt in DERSELBEN Liste, also fassen „Alle" und „Keine" sie
           mit, und das Sitzungsgedaechtnis merkt sie wie jede andere Reihe. *@
        <Mehrfachauswahl Bezeichnung="@Resource.SIMERG_LBL_ERZEUGERAUSWAHL"
                         Eintraege="@Eintraege(Vorhandene(Daten.Erzeuger))"
                         AbsatzNach="@AbsatzNach"
                         Gewaehlt="@_erzeuger" GewaehltChanged="@(w => { _erzeuger = w; Merken(); })" />

        @if (Vorhandene(Daten.Speicher).Count > 0)
        {
            <Mehrfachauswahl Bezeichnung="@Resource.SIMERG_LBL_SPEICHERAUSWAHL"
                             Eintraege="@Eintraege(Vorhandene(Daten.Speicher))"
                             Gewaehlt="@_speicher" GewaehltChanged="@(w => { _speicher = w; Merken(); })" />
        }
    </div>

    @* DER ZOOM LIEGT IM BILD (Etappe DG-E3, Gruppe (a)): Rad, Ziehen, Kneifgeste und
       die Tasten + − 0 verschieben die viewBox der Zeichenflaeche; „1:1" holt das
       ganze Jahr zurueck. Die SPEICHERFUELLSTAENDE stehen auf der zweiten Achse in
       kWh, alles andere in kW. *@
    <DiagrammSvg Modell="@ModellGang" Kennung="simerg-waermegang"
                 Bezeichnung="@Resource.CHART_TITEL_WAERMELAST_JAHRESGANGLINIE"
                 Einheit="kW" EinheitRechts="kWh"
                 Palette="@Farbpalette.Aktuell"
                 FarbwahlErlaubt="@Farbwahl"
                 FarbeGewaehlt="FarbeUebernehmen"
                 FarbeZurueckgesetzt="FarbeVerwerfen" />

    @if (Csv.HasDelegate)
    {
        <button type="button" class="epos-simerg-knopf" @onclick="CsvGewuenscht">
            @Resource.SIM_BTN_CSV_EXPORT
        </button>
    }

</div>

@code {
    /// <summary>Erzeugerreihen, Speicherreihen und die waehlbaren Bedarfsarten.</summary>
    [Parameter] public WaermegangDaten Daten { get; set; } = new WaermegangDaten();

    /// <summary>Liefert das Zeichenmodell zur aktuellen Schalterstellung.</summary>
    [Parameter] public Func<Bildauftrag, Zeichenmodell?>? Modell { get; set; }

    /// <summary>
    /// Der CSV-Export: Bedarfsart, gewaehlte Erzeuger, gewaehlte Speicher.
    /// Ohne Delegat kein Knopf.
    /// </summary>
    [Parameter] public EventCallback<(int Kanal, IReadOnlyList<string> Erzeuger,
                                      IReadOnlyList<string> Speicher)> Csv { get; set; }

    /// <summary>
    /// Das Sitzungsgedaechtnis dieses Reiters (#234). Ohne Angabe der prozessweite
    /// Stand aus <see cref="Ganglinienregister"/> — genau wie
    /// <c>Filterstandvorgabe</c> bei den Katalogdialogen (S2.5). Eine Probe gibt
    /// ihren EIGENEN Stand herein und teilt mit keinem Nachbarfall.
    /// </summary>
    [Parameter] public Ganglinienstand? Gedaechtnis { get; set; }

    /// <summary>Die gewaehlte Bedarfsart; −1 = Gesamt/Produktion (Pruefhilfe).</summary>
    public int Bedarfsart => _bedarfsart ?? -1;

    /// <summary>Die gewaehlten Erzeugerschluessel (Pruefhilfe).</summary>
    public IReadOnlyList<string> GewaehlteErzeuger => Schluessel(Vorhandene(Daten.Erzeuger), _erzeuger);

    /// <summary>Die gewaehlten Speicherschluessel (Pruefhilfe).</summary>
    public IReadOnlyList<string> GewaehlteSpeicher => Schluessel(Vorhandene(Daten.Speicher), _speicher);

    /// <summary>Ist die Bedarfslinie eingeblendet? (Pruefhilfe)</summary>
    public bool Bedarfslinie => _bedarfslinie;

    /// <summary>Steht die Dauerlinie vorn? (Pruefhilfe)</summary>
    public bool Sortiert => _sortiert;

    /// <summary>Der Schluessel der Summenlinie - dieselbe Schreibweise wie im Bild.</summary>
    private const string SUMME = "GESAMT";

    /// <summary>
    /// Trennt die Summenlinie von ihren Summanden, wenn sie vorn steht; sonst 0.
    /// Fuehrt ein Lauf keine Summe (kein einziger Erzeuger), gibt es auch nichts
    /// abzusetzen.
    /// </summary>
    private int AbsatzNach
    {
        get
        {
            List<Ganglinienreihe> erz = Vorhandene(Daten.Erzeuger);
            return erz.Count > 0 && erz[0].Schluessel == SUMME ? 1 : 0;
        }
    }

    private int? _bedarfsart = -1;
    private bool _sortiert;
    private bool _bedarfslinie;
    private IReadOnlyList<int> _erzeuger = Array.Empty<int>();
    private IReadOnlyList<int> _speicher = Array.Empty<int>();
    private Ganglinienstand _stand = new Ganglinienstand();
    private bool _erstBelegt;

    protected override void OnInitialized()
        => _stand = Gedaechtnis ?? Ganglinienregister.Stand(Ganglinienregister.WAERMEGANG);

    /// <summary>
    /// <b>Das erste Befuellen — Anwenderrueckmeldung 12.09.2026 (#234).</b> Der Reiter
    /// startete ohne eine einzige gewaehlte Reihe und zeigte deshalb beim Oeffnen den
    /// Leerhinweis „Keine Simulationsdaten vorhanden."; der Anwender musste erst
    /// zusammenklicken, was das Blatt zeigen soll. Jetzt sind beim ersten Aufbau ALLE
    /// vorhandenen Erzeuger, ALLE vorhandenen Speicher und die Bedarfslinie an —
    /// Bedarfsart bleibt „Gesamt" (−1), „sortiert" bleibt aus.
    ///
    /// <para>Gibt es schon ein GEDAECHTNIS dieser Sitzung, gilt es vor der
    /// Vorbelegung (der zweite Teil der Rueckmeldung). Unbekannte Schluessel fallen
    /// dabei still weg: Welche Reihen ein Lauf fuehrt, entscheidet er selbst.</para>
    ///
    /// <para>Die Wache <c>_erstBelegt</c> ist woertlich aus <c>StromgangReiter</c>:
    /// <c>OnParametersSet</c> laeuft bei JEDER Parameteraenderung, und ohne sie
    /// ueberschriebe der naechste Durchlauf die Anwenderwahl.</para>
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_erstBelegt) return;

        List<Ganglinienreihe> erz = Vorhandene(Daten.Erzeuger);
        List<Ganglinienreihe> sp = Vorhandene(Daten.Speicher);
        if (erz.Count == 0 && sp.Count == 0) return;

        _erstBelegt = true;

        if (_stand.Belegt)
        {
            _bedarfsart = _stand.Bedarfsart;
            _sortiert = _stand.Sortiert;
            _bedarfslinie = _stand.Bedarfslinie;
            _erzeuger = Auswahl(erz, _stand.Reihen);
            _speicher = Auswahl(sp, _stand.Reihen);
            return;
        }

        _erzeuger = Alle(erz.Count);
        _speicher = Alle(sp.Count);
        _bedarfslinie = true;
        Merken();
    }

    /// <summary>Die Plaetze 0…n−1 — „alles an".</summary>
    private static IReadOnlyList<int> Alle(int anzahl)
    {
        var liste = new List<int>(anzahl);
        for (int i = 0; i < anzahl; i++) liste.Add(i);
        return liste;
    }

    /// <summary>
    /// Die Plaetze zu den gemerkten SCHLUESSELN. Ein Schluessel, den dieser Lauf
    /// nicht fuehrt, fehlt hier einfach — er kann damit auch nicht in den Export.
    /// </summary>
    private static IReadOnlyList<int> Auswahl(IReadOnlyList<Ganglinienreihe> reihen,
                                              IReadOnlyList<string> schluessel)
    {
        var liste = new List<int>();
        for (int i = 0; i < reihen.Count; i++)
            if (schluessel.Contains(reihen[i].Schluessel)) liste.Add(i);
        return liste;
    }

    /// <summary>
    /// Schreibt die Schalterstellung ins Sitzungsgedaechtnis — nach JEDER Aenderung.
    /// Der Zeitausschnitt gehoert ausdruecklich NICHT dazu; er lebt im Bild.
    /// </summary>
    private void Merken()
    {
        var reihen = new List<string>(GewaehlteErzeuger);
        reihen.AddRange(GewaehlteSpeicher);
        _stand.Merken(Bedarfsart, _sortiert, _bedarfslinie, reihen);
    }

    private IReadOnlyList<(int Id, string Text)> Bedarfsarten
    {
        get
        {
            var liste = new List<(int, string)>();
            foreach ((int Kanal, string Text) e in Daten.Bedarfsarten) liste.Add((e.Kanal, e.Text));
            return liste;
        }
    }

    private void BedarfsartGesetzt(int? wert)
    {
        _bedarfsart = wert ?? -1;
        Merken();
    }

    /// <summary>
    /// Nur die Reihen, die der Lauf FUEHRT. Fehlende erscheinen gar nicht — und
    /// koennen damit auch nicht in den Export geraten.
    /// </summary>
    private static List<Ganglinienreihe> Vorhandene(IReadOnlyList<Ganglinienreihe> alle)
    {
        var liste = new List<Ganglinienreihe>();
        foreach (Ganglinienreihe r in alle) if (r.Vorhanden) liste.Add(r);
        return liste;
    }

    private static IReadOnlyList<(int Id, string Text)> Eintraege(IReadOnlyList<Ganglinienreihe> reihen)
    {
        var liste = new List<(int, string)>(reihen.Count);
        for (int i = 0; i < reihen.Count; i++) liste.Add((i, reihen[i].Text));
        return liste;
    }

    private static IReadOnlyList<string> Schluessel(IReadOnlyList<Ganglinienreihe> reihen,
                                                    IReadOnlyList<int> gewaehlt)
    {
        var liste = new List<string>();
        foreach (int i in gewaehlt) if (i >= 0 && i < reihen.Count) liste.Add(reihen[i].Schluessel);
        return liste;
    }

    /// <summary>
    /// Die Reihenliste des Bildes: Erzeuger, Speicher und - als eigener
    /// Schluessel - die Bedarfslinie. Wo die einzelne Reihe im Bild landet,
    /// entscheidet die Huelle: Erzeuger und Bedarf auf der Primaerachse [kW],
    /// die Speicherfuellstaende auf der zweiten [kWh] (#234).
    /// </summary>
    private IReadOnlyList<string> Reihen()
    {
        var liste = new List<string>(GewaehlteErzeuger);
        liste.AddRange(GewaehlteSpeicher);
        if (_bedarfslinie) liste.Add("WAERMEBEDARF");
        return liste;
    }

    private Zeichenmodell? ModellGang =>
        Modell?.Invoke(new Bildauftrag(Bilder.Waermegang, _sortiert, Bedarfsart, Reihen()));

    private Task CsvGewuenscht()
        => Csv.InvokeAsync((Bedarfsart, GewaehlteErzeuger, GewaehlteSpeicher));
}
