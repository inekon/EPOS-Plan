#50342=IFCPROPERTYENUMERATEDVALUE('EmbeddedSystemPositionType','Kennung f\X\FCr die Position von fl\X\E4chenintegrierten Systemen innerhalb des Geb\X\E4udeelementes Anhand der Eigenschaft wird festgelegt, ob ein fl\X\E4chenintegriertes System innerhalb des Geb\X\E4udebauteils installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein fl\X\E4chenintegriertes System vorgesehen ist. Wenn die Position des fl\X\E4chenintegrierten Systems noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
#50343=IFCPROPERTYENUMERATEDVALUE('Generator','Kennung f\X\FCr den Ersteller/Bearbeiter des Geb\X\E4udeelementes. Der Generator dient nur zur Information. Die Kennung darf nicht f\X\FCr die Identifizierung von Modellobjekten verwendet werden.',(IFCLABEL('mgt2D3D')),$);
#50344=IFCPROPERTYSINGLEVALUE('GUID','Bezeichner, der w\X\E4hrend der Lebenszeit des Modellobjektes erhalten bleibt. Der Bezeichner ist nicht eindeutig.',IFCLABEL('0bbf6b11-37e9-4ac7-94a2-f216396b3780'),$);
#50345=IFCPROPERTYSINGLEVALUE('ID','Kennung f\X\FCr das Modellobjekt. MUSS innerhalb des Projektes eindeutig sein.',IFCIDENTIFIER('-1'),$);
#50346=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('5e6a9f01-0147-bd78-90ad-67cf493a720a'),$);
#50347=IFCPROPERTYENUMERATEDVALUE('LoadBearingType','Kennung f\X\FCr die Tragf\X\E4higkeit des Bauteils',(IFCLABEL('elbNone')),$);
#50348=IFCPROPERTYSINGLEVALUE('Name','Name des Bauteils',IFCLABEL('DF 016-1'),$);
