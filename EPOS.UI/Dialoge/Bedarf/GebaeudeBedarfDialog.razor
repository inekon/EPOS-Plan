@* Waermebedarf EINES Gebaeudes (iU9-W9.8, Anwenderwunsch W9-E-2 vom 05.09.2026).

   DER WUNSCH, woertlich: "Der Waermebedarf vom Gebaeude (Screenshot 1) sollte aus
   diesem Dialog (mit Button Simulation) aufgerufen werden koennen - analog wie aus
   dem Simulationsbereich (Screenshot 2)." Nachtrag: "(ohne Brauchwasser und ohne
   gesamt)".

   KEIN VORBILD IM BESTAND. Die geloeschte Form_Gebaeude fuehrte im Detailblock
   "Gebaeude: Verbrauch" nur den Knopf "Aendern"; die einzige Maske mit einem Knopf
   "Simulation" war Form_Simulation_Kurz (mit iF29 stillgelegt), und die rechnete das
   GANZE Projekt samt Kaskade. Neu ist hier also die AUSKUNFT, nicht die Rechnung:
   Gerechnet wird mit GebaeudeBedarfCtrl, und der ruft dieselben zwei Methoden von
   SimulationWaermebedarf wie der Lauf.

   DAS VORBILD DER ANSICHT ist der Bedarfsreiter der Ergebnisseite
   (Seiten/Simulation/BedarfReiter.razor): Kennzahlen links, darunter der Schalter
   "sortiert", darunter die Jahresganglinie als Renderer-Bild (B1,
   ChartRenderer.GanglinieNormiert) im Baustein Diagramm mit Bild- und Datenzoom.
   WEG BLEIBEN, wie gewuenscht: der Block "Waermebedarf je Bedarfsart", die Schalter
   "Gesamt" und "Brauchwasser" und die Strombedarfsspalte - dieser Dialog kennt genau
   EINE Reihe.

   DIE EINHEIT (Anwenderentscheid W8-O-5): MWh als Vorgabe, kWh waehlbar; die Wahl
   liegt in BedarfEinheitWahl, also derselben Ablage wie im Bedarfsprofil- und im
   Bedarfsergebnisdialog. Umgerechnet werden nur die ENERGIEMENGEN - die Hoechstlast
   ist eine Leistung in kW, die Vollbenutzungsstunden sind Stunden, und das Bild zeigt
   Prozent des Jahreshoechstwertes.

   ER ERSCHEINT ALS UEBERLAGERUNG im Gebaeudedialog, nicht als zweites Fenster
   (Risiko R2) - wie die drei Unterdialoge, die dort schon stehen.

   TASTATUR: Esc und Enter schliessen; der Dialog zeigt nur an und traegt einen
   einzigen Knopf. *@

@namespace EPOS.UI.Dialoge.Bedarf
@using WindowsFormsApplication1
@using WindowsFormsApplication1.Zeichnung
@using System.Globalization
@inherits Farbwahlwirt
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="Schliessen" />
        }
    </div>

    <p class="epos-kontextzeile">@Daten.Name</p>

    @* Die Einheit gilt fuer die Kennzahl und die Monatstabelle; sie steht deshalb
       ueber beiden. *@
    <Auswahlfeld Bezeichnung="@LabelEinheit" Eintraege="@Einheitenwahl"
                 Auswahl="@EinheitIndex" AuswahlChanged="EinheitWaehlen" />

    @* ---- Die drei Kennzahlen -------------------------------------------- *@
    <section class="gebb-abschnitt" data-seite="waerme">
    <Gruppenkopf Titel="@GruppeKennzahlen">
        <KindInhalt>
            <div class="epos-raster-huelle">
                <table class="epos-raster gebb-kennzahlen">
                    <tbody>
                        <tr>
                            <td>@LabelHeizwaerme</td>
                            <td class="epos-zahl">@Heizwaerme</td>
                            <td>@_einheit.Text</td>
                        </tr>
                        <tr>
                            <td>@LabelMaxLast</td>
                            <td class="epos-zahl">@Zahl(Daten.MaxLastKw)</td>
                            <td>@EinheitKw</td>
                        </tr>
                        <tr>
                            <td>@LabelVollbenutzung</td>
                            <td class="epos-zahl">@Vollbenutzung</td>
                            <td>@EinheitStunden</td>
                        </tr>
                        @* Stufe G1 (ADR-006, Konzept 2.7): der Rechenweg, auf dem die Zahlen
                           entstanden - auf dem Altweg "Tagesbilanz (Bestandsweg)". *@
                        @if (Daten.Modelltext.Length > 0)
                        {
                            <tr>
                                <td>@LabelRechenweg</td>
                                <td colspan="2">@Daten.Modelltext</td>
                            </tr>
                        }
                        @* Anlagenkopplung AK3 (Festlegung 20): die Auskunft rechnet ohne geschlossenen Kreis - benannt. *@
                        @if (Daten.Rueckstufe.Length > 0)
                        {
                            <tr class="gebb-rueckstufe">
                                <td colspan="3">@Daten.Rueckstufe</td>
                            </tr>
                        }
                        @* Stufe G2 (Konzept 4.6, 8.2): die Kennzahlen, die es nur auf dem
                           VDI-Weg gibt - auf dem Altweg stehen sie nicht da, statt "—" zu zeigen.
                           Kuehlbedarf, Kuehlstunden und Ueberhitzung stehen seit KU1 im Abschnitt
                           „Kaeltebedarf" darunter (Kuehlkonzept 8.4). *@
                        @if (Daten.IstVdi6007)
                        {
                            <tr class="gebb-vdi">
                                <td>@LabelMittlereRaumtemperatur</td>
                                <td class="epos-zahl">@Zahl(Daten.MittlereRaumtemperaturC)</td>
                                <td>°C</td>
                            </tr>
                            <tr class="gebb-vdi">
                                <td>@LabelSommerlueftung</td>
                                <td class="epos-zahl">@Ganzzahl(Daten.SommerlueftungsstundenH)</td>
                                <td>@EinheitStundenZahl</td>
                            </tr>
                        }
                        @* Stufe KP2, Welle U1 (Konzept Konditionierungsprofile 3.7): die Stunden mit
                           Nachtauskuehlung - NUR mit Wert, also nur, wenn eine gesetzt ist. *@
                        @if (Daten.NachtauskuehlstundenH is int nachtauskuehlung)
                        {
                            <tr class="gebb-nachtauskuehlung">
                                <td>@LabelNachtauskuehlung</td>
                                <td class="epos-zahl">@Ganzzahl(nachtauskuehlung)</td>
                                <td>@EinheitStundenZahl</td>
                            </tr>
                        }
                        @* #573: das Warmwasser des PROJEKTS als Auskunft - es haengt nicht am
                           Gebaeude, sondern an den Brauchwasserprofilen bzw. dem Zapfprofil und
                           laeuft im Kanal Warmwasser; die Zeile darunter sagt das. *@
                        @if (Daten.WarmwasserProjektMwh is double warmwasser)
                        {
                            <tr class="gebb-warmwasser">
                                <td>@LabelWarmwasserProjekt</td>
                                <td class="epos-zahl">@Energie(warmwasser)</td>
                                <td>@_einheit.Text</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Daten.WarmwasserProjektMwh is double ww)
            {
                <Herleitungszeile Text="@(ww > 0 ? HinweisWarmwasserProjekt : HinweisWarmwasserOhneProfil)" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ---- Anlagenkopplung AK1 (Konzept 9.4, 12.1): zwei Kennzahlkacheln des Heizkreises -
       die Mittel von Vorlauf und Ruecklauf ueber die Heizstunden und die Stunden, in denen die
       Uebergabe die Grenze war. Nur fuer ein gekoppelt gerechnetes Gebaeude. *@
    @if (Daten.IstGekoppelt)
    {
        <div class="gebb-heizkreis">
            <Kachelraster>
                <KindInhalt>
                    <Kennzahlkachel Titel="@KachelVorlaufRuecklauf" Wert="@VorlaufRuecklaufWert"
                                    Quelle="@Daten.Heizkreiszeile" />
                    <Kennzahlkachel Titel="@KachelBegrenzt" Wert="@BegrenztWert" Quelle="@QuelleBegrenzt" />
                </KindInhalt>
            </Kachelraster>
        </div>
    }

    @* ---- Anlagenkopplung AK2 (Konzept 9.4, 5.5, 6.2): die Komfortkacheln NEBEN dem Restbedarf - nie ohne
       ihn. Am gekoppelt gerechneten Gebaeude (oder im Lauf mit Fahrplan); ein nicht erhobener Wert zeigt „—" (K18). Dazu im
       Lauf mit Fahrplan der Bedarfsbegriff und die Stunden am Fahrplan. *@
    @if (Daten.IstVdi6007 && (Daten.IstGekoppelt || Daten.IstKuehlgekoppelt || Daten.KomfortErhoben || Daten.Bedarfsbegriff.Length > 0))
    {
        <div class="gebb-komfort" data-komfort="@(Daten.KomfortErhoben ? "erhoben" : "ohne")">
            <Kachelraster>
                <KindInhalt>
                    <Kennzahlkachel Titel="@KachelKomfortStunden" Wert="@Stunden(Daten.KomfortUnterschreitungsstundenH)" Quelle="@QuelleKomfort" />
                    <Kennzahlkachel Titel="@KachelKomfortKelvin" Wert="@Kelvinstunden(Daten.KomfortKelvinstundenKh)" />
                    <Kennzahlkachel Titel="@KachelKomfortStrecke" Wert="@Stunden(Daten.KomfortLaengsteStreckeH)" />
                    <Kennzahlkachel Titel="@KachelRestbedarf" Wert="@RestbedarfWert" Quelle="@QuelleRestbedarf" />
                    @if (Daten.KomfortUeberschreitungsstundenH.HasValue)
                    {
                        <Kennzahlkachel Titel="@KachelKomfortUeber" Wert="@Stunden(Daten.KomfortUeberschreitungsstundenH)" />
                        <Kennzahlkachel Titel="@KachelKomfortKelvinKuehl" Wert="@Kelvinstunden(Daten.KomfortKelvinstundenKuehlungKh)" />
                    }
                    @if (Daten.Bedarfsbegriff.Length > 0)
                    {
                        <Kennzahlkachel Titel="@KachelBedarfsbegriff" Wert="@Daten.Bedarfsbegriff" />
                        <Kennzahlkachel Titel="@KachelFahrplanBegrenzt" Wert="@Stunden(Daten.FahrplanBegrenztStundenH)" />
                    }
                </KindInhalt>
            </Kachelraster>
            @if (!Daten.KomfortErhoben)
            {
                <Herleitungszeile Text="@HinweisKomfortOhne" />
            }
        </div>
    }

    @* ---- Anlagenkopplung AK3 (Entwurf AK3 Festlegung 22): die Kennzahlen des geschlossenen Kreises aus dem letzten
       Projektlauf - nur, wenn er den Kreis rechnete. *@
    @if (Daten.Ak3Erhoben)
    {
        <div class="gebb-ak3">
            <Kachelraster>
                <KindInhalt>
                    <Kennzahlkachel Titel="@KachelAk3Durchlaeufe" Wert="@Ak3DurchlaeufeWert" Quelle="@QuelleAk3" />
                    <Kennzahlkachel Titel="@KachelAk3Fallwechsel" Wert="@Anzahl(Daten.Ak3Fallwechsel)" />
                    <Kennzahlkachel Titel="@KachelAk3Schranke" Wert="@Stunden(Daten.Ak3SchrankeStundenH)" />
                    <Kennzahlkachel Titel="@KachelAk3SpeicherLeer" Wert="@Stunden(Daten.Ak3SpeicherLeerStundenH)" />
                    <Kennzahlkachel Titel="@KachelAk3Restbedarf" Wert="@Stunden(Daten.Ak3RestbedarfStundenH)" />
                </KindInhalt>
            </Kachelraster>
        </div>
    }

    @* ---- AK3-K (Entwurf AK3-K 3.5, Festlegung 20): Zonensperre und Kaelteseite im Kreis aus dem letzten Projektlauf -
       jede Seite nur, wenn der Lauf sie erhob. *@
    @if (Daten.ZonensperreErhoben || Daten.Ak3KaelteErhoben)
    {
        <div class="gebb-ak3k">
            <Kachelraster>
                <KindInhalt>
                    @if (Daten.ZonensperreErhoben)
                    {
                        <Kennzahlkachel Titel="@KachelZonensperreTage" Wert="@Anzahl(Daten.ZonensperreTage)" Quelle="@QuelleZonensperre" />
                        <Kennzahlkachel Titel="@KachelZonensperreGesperrt" Wert="@GesperrtWert" />
                    }
                    @if (Daten.Ak3KaelteErhoben)
                    {
                        <Kennzahlkachel Titel="@KachelAk3Kaelteschranke" Wert="@Stunden(Daten.Ak3KaelteschrankeStundenH)" Quelle="@QuelleAk3Kaelte" />
                        <Kennzahlkachel Titel="@KachelAk3Umschaltung" Wert="@Stunden(Daten.Ak3UmschaltStundenH)" />
                        <Kennzahlkachel Titel="@KachelAk3Kaelterest" Wert="@KaelterestWert" />
                    }
                </KindInhalt>
            </Kachelraster>
        </div>
    }

    @* ---- Stufe KP3, Welle O2 (E59, E60): die Gruppe „Aufheizung" - Bemessung, Zaehlungen, Hinweise W1-W5,
       Zonen und die Auslegungsgroesse mit ihren Teilen; ohne Daten steht sie nicht da. *@
    <GebaeudeBedarfAufheizung Daten="@Daten.Aufheizung" Texte="@AufheizTexte" />
    </section>

    @* ---- Die Zonen (Stufe G6b, Anwenderentscheid A2): eine Zeile je Zone, auch unbeheizt -
       dort ohne Heizwaerme und Last. Nur bei einem Gebaeude mit mindestens zwei Zonen. *@
    @if (Daten.Zonen.Count >= 2)
    {
        <Gruppenkopf Titel="@ZonenTexte.Gruppe">
            <KindInhalt>
                <div class="epos-raster-huelle">
                    <table class="epos-raster gebb-zonen">
                        <thead>
                            <tr>
                                <th>@ZonenTexte.SpalteZone</th>
                                <th>@ZonenTexte.SpalteBeheizt</th>
                                <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteHeizwaerme, _einheit.Text)</th>
                                <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteMaxLast, EinheitKw)</th>
                                <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteRaumtemperatur, "°C")</th>
                                <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteUeberhitzung, EinheitStundenZahl)</th>
                                @if (ZonenMitNachtauskuehlung)
                                {
                                    <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteNachtauskuehlung, EinheitStundenZahl)</th>
                                }
                                @if (ZonenMitKaelte)
                                {
                                    <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteKaelte, _einheit.Text)</th>
                                    <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteKaeltespitze, EinheitKw)</th>
                                    <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteKuehlstunden, EinheitStundenZahl)</th>
                                }
                                @if (ZonenMitHeizkreis)
                                {
                                    <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteVorlauf, "°C")</th>
                                    <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteRuecklauf, "°C")</th>
                                    <th class="epos-zahl">@Kennzahltext(ZonenTexte.SpalteBegrenzt, EinheitStundenZahl)</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Daten.Zonen.Count; i++)
                            {
                                GebaeudeBedarfZoneDaten z = Daten.Zonen[i];
                                <tr @key="i" class="@(z.IstBeheizt ? "" : "gebb-zone-unbeheizt")">
                                    <td>@z.Name</td>
                                    <td>@(z.IstBeheizt ? ZonenTexte.BeheiztJa : ZonenTexte.BeheiztNein)</td>
                                    <td class="epos-zahl">@Energie(z.HeizwaermeMwh)</td>
                                    <td class="epos-zahl">@Zahl(z.MaxLastKw)</td>
                                    <td class="epos-zahl">@Zahl(z.MittlereRaumtemperaturC)</td>
                                    <td class="epos-zahl">@Ganzzahl(z.UeberhitzungsstundenH)</td>
                                    @if (ZonenMitNachtauskuehlung)
                                    {
                                        <td class="epos-zahl">@Ganzzahl(z.NachtauskuehlstundenH)</td>
                                    }
                                    @if (ZonenMitKaelte)
                                    {
                                        <td class="epos-zahl gebb-zone-kaelte">@Energie(z.KaeltebedarfMwh)</td>
                                        <td class="epos-zahl">@Zahl(z.KaeltespitzeKw)</td>
                                        <td class="epos-zahl">@Ganzzahl(z.KuehlstundenH)</td>
                                    }
                                    @if (ZonenMitHeizkreis)
                                    {
                                        <td class="epos-zahl">@Temperatur(z.VorlaufMittelC)</td>
                                        <td class="epos-zahl">@Temperatur(z.RuecklaufMittelC)</td>
                                        <td class="epos-zahl">@Stunden(z.UebergabeBegrenztH)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <Herleitungszeile Text="@ZonenTexte.Herleitung" />
                @if (Gleichzeitigzeile is string gleichzeitig)
                {
                    <Herleitungszeile Text="@gleichzeitig" />
                }
                @if (ZonenMitHeizkreis)
                {
                    <Herleitungszeile Text="@ZonenTexte.HerleitungUebergabe" />
                }
            </KindInhalt>
        </Gruppenkopf>
    }

    @* ---- Vergleich alt/neu (Konzept 8.2, Umsetzungskonzept 2.7; bis Stufe GA) ---- *@
    @if (Daten.Vergleich is not null)
    {
        <Gruppenkopf Titel="@GruppeVergleich">
            <KindInhalt>
                <div class="epos-raster-huelle">
                    <table class="epos-raster gebb-vergleich">
                        <thead>
                            <tr>
                                <th>@SpalteKennzahl</th>
                                <th>@SpalteTagesbilanz</th>
                                <th>@SpalteVdi6007</th>
                                <th>@SpalteAbweichung</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>@Kennzahltext(LabelHeizwaerme, _einheit.Text)</td>
                                <td class="epos-zahl">@Energie(Tagesbilanzsatz.HeizwaermeMwh)</td>
                                <td class="epos-zahl">@Energie(Vdisatz.HeizwaermeMwh)</td>
                                <td class="epos-zahl">@Abweichung(Tagesbilanzsatz.HeizwaermeMwh, Vdisatz.HeizwaermeMwh)</td>
                            </tr>
                            <tr>
                                <td>@Kennzahltext(LabelSpitzeStunde, EinheitKw)</td>
                                <td class="epos-zahl">@Zahl(Tagesbilanzsatz.MaxLastKw)</td>
                                <td class="epos-zahl">@Zahl(Vdisatz.MaxLastKw)</td>
                                <td class="epos-zahl">@Abweichung(Tagesbilanzsatz.MaxLastKw, Vdisatz.MaxLastKw)</td>
                            </tr>
                            <tr>
                                <td>@Kennzahltext(LabelSpitzeTagesmittel, EinheitKw)</td>
                                <td class="epos-zahl">@Zahl(Tagesbilanzsatz.SpitzeTagesmittelKw)</td>
                                <td class="epos-zahl">@Zahl(Vdisatz.SpitzeTagesmittelKw)</td>
                                <td class="epos-zahl">@Abweichung(Tagesbilanzsatz.SpitzeTagesmittelKw, Vdisatz.SpitzeTagesmittelKw)</td>
                            </tr>
                            <tr>
                                <td>@Kennzahltext(LabelSpitzeQuantil95, EinheitKw)</td>
                                <td class="epos-zahl">@Zahl(Tagesbilanzsatz.SpitzeQuantil95Kw)</td>
                                <td class="epos-zahl">@Zahl(Vdisatz.SpitzeQuantil95Kw)</td>
                                <td class="epos-zahl">@Abweichung(Tagesbilanzsatz.SpitzeQuantil95Kw, Vdisatz.SpitzeQuantil95Kw)</td>
                            </tr>
                            <tr>
                                <td>@Kennzahltext(LabelVollbenutzung, EinheitStunden)</td>
                                <td class="epos-zahl">@Zahl(Tagesbilanzsatz.VollbenutzungsstundenH)</td>
                                <td class="epos-zahl">@Zahl(Vdisatz.VollbenutzungsstundenH)</td>
                                <td class="epos-zahl">@Abweichung(Tagesbilanzsatz.VollbenutzungsstundenH, Vdisatz.VollbenutzungsstundenH)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </KindInhalt>
        </Gruppenkopf>
    }

    @* ---- Die Jahresganglinie -------------------------------------------- *@
    <div class="epos-leiste">
        <Schalter Bezeichnung="@LabelSortiert" Wert="@_sortiert" WertChanged="SortiertGesetzt" />
        @* Stufe G6b (Mehrzonenkonzept 2.8): die Bilder Waermelast und Raumtemperatur fuer das
           ganze Gebaeude oder eine seiner Zonen. *@
        @if (Diagrammwahl.Count > 0)
        {
            <Auswahlfeld Bezeichnung="@ZonenTexte.LabelDiagramm" Eintraege="@Diagrammwahl"
                         Auswahl="@_bildzone" AuswahlChanged="DiagrammWaehlen" />
        }
    </div>

    @* Der Zoom liegt im Bild (Etappe DG-E3, Gruppe (a)): Ein Zeitausschnitt ist die
       viewBox der Zeichenflaeche, „1:1" holt das ganze Jahr zurueck. Mit der Zonenwahl
       wandert die Zone in die Kennung - jedes Bild fuehrt seinen Ausschnitt selbst. *@
    <DiagrammSvg Modell="@Modell" Kennung="@("gebaeude-bedarf" + Zonenzusatz)" Bezeichnung="@Bildtext"
                 PlatzhalterText="@PlatzhalterLast" Einheit="kW"
                 Palette="@Farbpalette.Aktuell"
                 FarbwahlErlaubt="@Farbwahl"
                 FarbeGewaehlt="FarbeUebernehmen"
                 FarbeZurueckgesetzt="FarbeVerwerfen" />

    @* ---- Raumtemperatur (Stufe G2, Konzept 8.2): nur auf dem VDI-Weg. Ein eigenes Bild
       mit eigenem Zoom - jede Jahresganglinie fuehrt ihren Ausschnitt selbst. *@
    @if (BildauftragRaumtemperatur is not null)
    {
        <DiagrammSvg Modell="@Raummodell" Kennung="@("gebaeude-raumtemperatur" + Zonenzusatz)" Bezeichnung="@BildtextRaumtemperatur"
                     PlatzhalterText="@PlatzhalterBild" Einheit="°C"
                     Palette="@Farbpalette.Aktuell"
                     FarbwahlErlaubt="@Farbwahl"
                     FarbeGewaehlt="FarbeUebernehmen"
                     FarbeZurueckgesetzt="FarbeVerwerfen" />
    }

    @* ---- Vorlauf und Ruecklauf (Anlagenkopplung AK1, Konzept 9.4): nur gekoppelt. Stunden ohne
       Heizbetrieb sind Luecken der Linie - dort gibt es keinen Vorlauf, und das Bild erfindet keinen. *@
    @if (BildauftragVorlauf is not null)
    {
        <DiagrammSvg Modell="@Vorlaufmodell" Kennung="gebaeude-vorlauf" Bezeichnung="@BildtextVorlauf"
                     PlatzhalterText="@PlatzhalterBild" Einheit="°C"
                     Palette="@Farbpalette.Aktuell"
                     FarbwahlErlaubt="@Farbwahl"
                     FarbeGewaehlt="FarbeUebernehmen"
                     FarbeZurueckgesetzt="FarbeVerwerfen" />
        <Herleitungszeile Text="@HinweisVorlaufLuecken" />
    }

    @* ---- Raumtemperatur und Sollwert (Anlagenkopplung AK2, E80): die Woche mit der groessten
       Unterschreitung, die gezaehlten Stunden markiert. Nur mit erhobenem Komfort und einer Stunde. *@
    @if (BildauftragKomfortwoche is not null)
    {
        <DiagrammSvg Modell="@Komfortwochenmodell" Kennung="gebaeude-komfortwoche" Bezeichnung="@BildtextKomfortwoche"
                     PlatzhalterText="@PlatzhalterBild" Einheit="°C"
                     Palette="@Farbpalette.Aktuell"
                     FarbwahlErlaubt="@Farbwahl"
                     FarbeGewaehlt="FarbeUebernehmen"
                     FarbeZurueckgesetzt="FarbeVerwerfen" />
        <Herleitungszeile Text="@HinweisKomfortwoche" />
    }

    @* ---- Kaeltebedarf (Stufe KU1; Kuehlkonzept 8.4; E21, F-K18, K5, K6) ----
       DIESELBEN BAUSTEINE WIE DIE WAERMESEITE, in derselben Folge: Kennzahltabelle
       (Energie, Leistung, Vollbenutzungsstunden an denselben Plaetzen), das EIGENE Bild der
       Kaeltelast (nicht im Waermebild - sonst normierte der Kaeltewert die Waermelinie mit)
       und die Monatswerte als zweite Spalte der Monatsuebersicht. Hinzu kommen, benannt:
       Stunden mit Kuehlbedarf, Ueberhitzungsstunden und die Stunden mit Heizen und Kuehlen
       (Zugewinne der Kaelteseite, 6.4), und die Herleitungszeilen - wie der Kaeltebedarf
       entsteht und die Grenze der Zahl (K5), an jeder Kaeltezahl. Auf dem Bestandsweg steht
       der Abschnitt mit 0 und Hinweis (Loeschliste GA); ein Gebaeude ohne wirksame Kuehlung
       laeuft frei - seine Kaeltezahlen stehen als „—", die Ueberhitzungsstunden mit Wert (E32). *@
    @if (Daten.KaelteAbschnitt)
    {
        <section class="gebb-abschnitt" data-seite="kaelte">
            <Gruppenkopf Titel="@GruppeKaelte">
                <KindInhalt>
                    <div class="epos-raster-huelle">
                        <table class="epos-raster gebb-kennzahlen">
                            <tbody>
                                <tr class="gebb-kaelte">
                                    <td>@LabelKuehlbedarf</td>
                                    <td class="epos-zahl">@Energie(Daten.KuehlenergieMwh)</td>
                                    <td>@_einheit.Text</td>
                                </tr>
                                <tr class="gebb-kaelte">
                                    <td>@LabelKaeltelastMax</td>
                                    <td class="epos-zahl">@Zahl(Daten.KaeltelastMaxKw)</td>
                                    <td>@EinheitKw</td>
                                </tr>
                                @if (Daten.VollbenutzungsstundenKaelteH.HasValue)
                                {
                                    <tr class="gebb-kaelte">
                                        <td>@LabelVollbenutzung</td>
                                        <td class="epos-zahl">@Zahl(Daten.VollbenutzungsstundenKaelteH)</td>
                                        <td>@EinheitStunden</td>
                                    </tr>
                                }
                                <tr class="gebb-kaelte">
                                    <td>@LabelKuehlstunden</td>
                                    <td class="epos-zahl">@Ganzzahl(Daten.KuehlstundenH)</td>
                                    <td>@EinheitStundenZahl</td>
                                </tr>
                                @if (Daten.UeberhitzungsstundenH.HasValue)
                                {
                                    <tr class="gebb-kaelte">
                                        <td>@LabelUeberhitzung</td>
                                        <td class="epos-zahl">@Ganzzahl(Daten.UeberhitzungsstundenH)</td>
                                        <td>@EinheitStundenZahl</td>
                                    </tr>
                                }
                                @if (Daten.StundenHeizenUndKuehlenH.HasValue)
                                {
                                    <tr class="gebb-kaelte">
                                        <td>@LabelHeizenUndKuehlen</td>
                                        <td class="epos-zahl">@Ganzzahl(Daten.StundenHeizenUndKuehlenH)</td>
                                        <td>@EinheitStundenZahl</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @foreach (string zeile in Daten.KaelteHerleitung)
                    {
                        <Herleitungszeile Text="@zeile" />
                    }
                </KindInhalt>
            </Gruppenkopf>

            @* E37: die zwei Kennzahlkacheln des Kaeltekreises, gespiegelt zum Heizkreis - die
               Mittel von Kuehlvorlauf und Kuehlruecklauf ueber die Kuehlstunden und die Stunden,
               in denen die Kuehluebergabe die Grenze war (davon an der Vorlaufgrenze). Die Zeilen
               tragen „sensibel" und „keine Taupunktgrenze" (K5). Nur kuehlgekoppelt. *@
            @if (Daten.IstKuehlgekoppelt)
            {
                <div class="gebb-kuehlkreis">
                    <Kachelraster>
                        <KindInhalt>
                            <Kennzahlkachel Titel="@KachelKuehlvorlauf" Wert="@KuehlvorlaufWert"
                                            Quelle="@Daten.Kuehlkreiszeile" />
                            <Kennzahlkachel Titel="@KachelKuehlBegrenzt" Wert="@KuehlBegrenztWert"
                                            Quelle="@Daten.KuehlBegrenztzeile" />
                        </KindInhalt>
                    </Kachelraster>
                </div>
            }

            @* Das eigene Bild der Kaeltelast - derselbe Schalter „sortiert" wie oben, eigener
               Ausschnitt, eigene Kennung. *@
            @if (BildauftragKaelte is not null)
            {
                <DiagrammSvg Modell="@Kaeltemodell" Kennung="gebaeude-kaelte" Bezeichnung="@BildtextKaelte"
                             PlatzhalterText="@PlatzhalterBild" Einheit="kW"
                             Palette="@Farbpalette.Aktuell"
                             FarbwahlErlaubt="@Farbwahl"
                             FarbeGewaehlt="FarbeUebernehmen"
                             FarbeZurueckgesetzt="FarbeVerwerfen" />
            }

            @* E37: Kuehlvorlauf und Kuehlruecklauf - dasselbe Bild wie auf der Heizseite. *@
            @if (BildauftragKuehlvorlauf is not null)
            {
                <DiagrammSvg Modell="@Kuehlvorlaufmodell" Kennung="gebaeude-kuehlvorlauf" Bezeichnung="@BildtextKuehlvorlauf"
                             PlatzhalterText="@PlatzhalterBild" Einheit="°C"
                             Palette="@Farbpalette.Aktuell"
                             FarbwahlErlaubt="@Farbwahl"
                             FarbeGewaehlt="FarbeUebernehmen"
                             FarbeZurueckgesetzt="FarbeVerwerfen" />
                <Herleitungszeile Text="@HinweisKuehlvorlaufLuecken" />
            }
        </section>
    }

    @* ---- Die Monatsuebersicht ------------------------------------------- *@
    @if (Daten.MonatswerteMwh.Count >= 12)
    {
        <Gruppenkopf Titel="@GruppeMonate">
            <KindInhalt>
                <div class="epos-raster-huelle">
                    <table class="epos-raster gebb-monate">
                        @* Stufe KU1: mit Abschnitt „Kaeltebedarf" traegt die Tabelle eine zweite
                           Wertspalte - Heiz- und Kuehlanteil nebeneinander, nicht verrechnet (K6). *@
                        @if (KuehlspalteDa)
                        {
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>@SpalteHeizung</th>
                                    <th>@SpalteKuehlung</th>
                                    <th></th>
                                </tr>
                            </thead>
                        }
                        <tbody>
                            @for (int m = 0; m < 12; m++)
                            {
                                int monat = m;
                                <tr>
                                    <td>@Monatsname(monat)</td>
                                    <td class="epos-zahl">@Monatswert(monat)</td>
                                    @if (KuehlspalteDa)
                                    {
                                        <td class="epos-zahl gebb-kaelte-monat">@Kuehlmonatswert(monat)</td>
                                    }
                                    <td>@_einheit.Text</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </KindInhalt>
        </Gruppenkopf>
    }

    <SpeichernLeiste OkText="@OkText" MitAbbrechen="false" Ergebnis="BeiErgebnis" />
</div>

@code {
    /// <summary>Das eingefrorene Ergebnis; die Hülle rechnet es.</summary>
    [Parameter] public GebaeudeBedarfDaten Daten { get; set; } = new();

    /// <summary>Die Texte der Zonentabelle und der Diagrammwahl (Stufe G6b).</summary>
    [Parameter] public GebaeudeBedarfZonenTexte ZonenTexte { get; set; } = new();

    /// <summary>Die Beschriftungen der Gruppe „Aufheizung" (Stufe KP3, Welle O2).</summary>
    [Parameter] public GebaeudeBedarfAufheizTexte AufheizTexte { get; set; } = new();

    /// <summary>
    /// Liefert das Wärmelastbild EINER Zone (Stufe G6b) — Parameter der Platz der Zone in
    /// <see cref="GebaeudeBedarfDaten.Zonen"/> und die Schalterstellung „sortiert"; <c>null</c> =
    /// kein Bild (unbeheizte Zone). Ohne Delegat keine Diagrammwahl.
    /// </summary>
    [Parameter] public Func<int, bool, Zeichenmodell?>? BildauftragZone { get; set; }

    /// <summary>Liefert das Bild „Raumtemperatur" EINER Zone (Stufe G6b) — Parameter der Platz der Zone.</summary>
    [Parameter] public Func<int, Zeichenmodell?>? BildauftragRaumtemperaturZone { get; set; }

    /// <summary>
    /// Liefert die Jahresganglinie als PNG — erster Parameter die Schalterstellung
    /// „sortiert" (Dauerlinie). Ohne Delegat bleibt der Platzhalter stehen.
    ///
    /// <para>Gerechnet wird im Kern (<c>ChartRenderer.GanglinieNormiertModell</c>) —
    /// diese Bibliothek ruft keinen Renderer (Risiko R‑W8‑2). Ein zweiter Parameter
    /// für den aufgezogenen Bildausschnitt stand hier bis zur Etappe DG-E3; der
    /// Zeitausschnitt liegt seither im Bild (DG-E3-9).</para>
    /// </summary>
    [Parameter] public Func<bool, Zeichenmodell?>? Bildauftrag { get; set; }

    /// <summary>
    /// Liefert das Bild „Raumtemperatur" (Stufe G2) — Raumluft und operativ mit dem
    /// Sollwertband, gezeichnet im Kern. <c>null</c> = kein Bild (Tagesbilanz-Weg).
    /// </summary>
    [Parameter] public Func<Zeichenmodell?>? BildauftragRaumtemperatur { get; set; }

    // --- Anlagenkopplung AK1 (Konzept Anlagenkopplung 9.4, 12.1) ---------------------

    /// <summary>
    /// Liefert das Bild „Vorlauf und Rücklauf" — gezeichnet im Kern, nur für ein gekoppelt
    /// gerechnetes Gebäude. <c>null</c> = kein Bild.
    /// </summary>
    [Parameter] public Func<Zeichenmodell?>? BildauftragVorlauf { get; set; }

    // --- Anlagenkopplung AK2 (Konzept Anlagenkopplung 9.4, 5.5) -------------------------

    /// <summary>Liefert das Bild „Raumtemperatur und Sollwert" (Woche mit der größten Unterschreitung); <c>null</c> = kein Bild.</summary>
    [Parameter] public Func<Zeichenmodell?>? BildauftragKomfortwoche { get; set; }

    /// <summary><c>GEBB_BILD_KOMFORTWOCHE</c></summary>
    [Parameter] public string BildtextKomfortwoche { get; set; } = "Raumtemperatur und Sollwert — Woche mit der größten Unterschreitung";

    /// <summary><c>GEBB_HRL_KOMFORTWOCHE</c>, fertig formuliert mit dem Wochenbeginn.</summary>
    [Parameter] public string HinweisKomfortwoche { get; set; } = "";

    /// <summary><c>GEBB_KACHEL_KOMFORT_STUNDEN</c></summary>
    [Parameter] public string KachelKomfortStunden { get; set; } = "Unterschreitungsstunden";

    /// <summary><c>GEBB_KACHEL_KOMFORT_KELVIN</c></summary>
    [Parameter] public string KachelKomfortKelvin { get; set; } = "Kelvinstunden";

    /// <summary><c>GEBB_KACHEL_KOMFORT_STRECKE</c></summary>
    [Parameter] public string KachelKomfortStrecke { get; set; } = "Längste Strecke";

    /// <summary><c>GEBB_KACHEL_KOMFORT_QUELLE</c></summary>
    [Parameter] public string QuelleKomfort { get; set; } = "Stunden der Nutzungszeit mehr als 1,0 K unter dem Sollwert";

    /// <summary><c>GEBB_KACHEL_RESTBEDARF</c></summary>
    [Parameter] public string KachelRestbedarf { get; set; } = "Restbedarf (Projekt, letzter Lauf)";

    /// <summary><c>GEBB_KACHEL_RESTBEDARF_QUELLE</c></summary>
    [Parameter] public string QuelleRestbedarf { get; set; } = "Wärme, die kein Erzeuger gedeckt hat — steht neben den Komfortstunden";

    /// <summary><c>GEBB_KACHEL_KOMFORT_UEBER</c></summary>
    [Parameter] public string KachelKomfortUeber { get; set; } = "Überschreitungsstunden Kühlung";

    /// <summary><c>GEBB_KACHEL_KOMFORT_KELVIN_KUEHL</c></summary>
    [Parameter] public string KachelKomfortKelvinKuehl { get; set; } = "Kelvinstunden Kühlung";

    /// <summary><c>GEBB_KACHEL_BEDARFSBEGRIFF</c></summary>
    [Parameter] public string KachelBedarfsbegriff { get; set; } = "Bedarfsbegriff";

    /// <summary><c>GEBB_KACHEL_FAHRPLAN_BEGRENZT</c></summary>
    [Parameter] public string KachelFahrplanBegrenzt { get; set; } = "Stunden am Fahrplan begrenzt";

    /// <summary><c>GEBB_HRL_KOMFORT_OHNE</c></summary>
    [Parameter] public string HinweisKomfortOhne { get; set; } = "Komfortstunden gibt es nur für ein gekoppelt gerechnetes Gebäude.";

    /// <summary><c>AK3_GEBB_KACHEL_DURCHLAEUFE</c></summary>
    [Parameter] public string KachelAk3Durchlaeufe { get; set; } = "Durchläufe je Stunde (Mittel / Höchstwert)";

    /// <summary><c>AK3_GEBB_KACHEL_FALLWECHSEL</c></summary>
    [Parameter] public string KachelAk3Fallwechsel { get; set; } = "Fallwechsel";

    /// <summary><c>AK3_GEBB_KACHEL_SCHRANKE</c></summary>
    [Parameter] public string KachelAk3Schranke { get; set; } = "Stunden an der Schranke";

    /// <summary><c>AK3_GEBB_KACHEL_SPEICHER_LEER</c></summary>
    [Parameter] public string KachelAk3SpeicherLeer { get; set; } = "Stunden mit leerem Speicher";

    /// <summary><c>AK3_GEBB_KACHEL_RESTBEDARF</c></summary>
    [Parameter] public string KachelAk3Restbedarf { get; set; } = "Stunden mit Restbedarf";

    /// <summary><c>AK3_GEBB_QUELLE</c></summary>
    [Parameter] public string QuelleAk3 { get; set; } = "Geschlossener Kreis (AK3), Projekt, letzter Lauf";

    /// <summary><c>AK3K_GEBB_KACHEL_SPERRTAGE</c></summary>
    [Parameter] public string KachelZonensperreTage { get; set; } = "Tage mit Sperre der Gegenseite";

    /// <summary><c>AK3K_GEBB_KACHEL_GESPERRT</c></summary>
    [Parameter] public string KachelZonensperreGesperrt { get; set; } = "Gesperrte Energie (Heizen / Kühlen)";

    /// <summary><c>AK3K_GEBB_QUELLE_ZONENSPERRE</c></summary>
    [Parameter] public string QuelleZonensperre { get; set; } = "Zonensperre, Projekt, letzter Lauf";

    /// <summary><c>AK3K_GEBB_KACHEL_KAELTESCHRANKE</c></summary>
    [Parameter] public string KachelAk3Kaelteschranke { get; set; } = "Stunden an der Kälteschranke";

    /// <summary><c>AK3K_GEBB_KACHEL_UMSCHALTUNG</c></summary>
    [Parameter] public string KachelAk3Umschaltung { get; set; } = "Umschaltstunden";

    /// <summary><c>AK3K_GEBB_KACHEL_KAELTEREST</c></summary>
    [Parameter] public string KachelAk3Kaelterest { get; set; } = "Kälte-Restbedarf";

    /// <summary><c>AK3K_GEBB_QUELLE_KREIS</c></summary>
    [Parameter] public string QuelleAk3Kaelte { get; set; } = "Kälteseite im Kreis (AK3), Projekt, letzter Lauf";

    /// <summary>„0,05 / 0,01 MWh" — gesperrte Raumheizung und Raumkühlung des Probetags; ohne Wert der Leertext.</summary>
    private string GesperrtWert
        => Daten.ZonensperreHeizenGesperrtMwh is double h && Daten.ZonensperreKuehlenGesperrtMwh is double c
            ? h.ToString("N2", System.Globalization.CultureInfo.CurrentCulture) + " / " +
              c.ToString("N2", System.Globalization.CultureInfo.CurrentCulture) + " MWh"
            : LeerText;

    /// <summary>„3 h, 0,25 MWh" — Stunden und Menge des Kälte-Restbedarfs; ohne Wert der Leertext.</summary>
    private string KaelterestWert
        => Daten.Ak3KaelterestStundenH is int s && Daten.Ak3KaelterestMwh is double m
            ? Stunden(s) + ", " + m.ToString("N2", System.Globalization.CultureInfo.CurrentCulture) + " MWh"
            : LeerText;

    /// <summary>„1,84 / 6" — Mittel und Höchstwert der Durchläufe je Stunde; ohne Wert der Leertext.</summary>
    private string Ak3DurchlaeufeWert
        => Daten.Ak3DurchlaeufeMittel is double m
            ? m.ToString("N2", System.Globalization.CultureInfo.CurrentCulture) + " / " +
              (Daten.Ak3DurchlaeufeMax is int x ? x.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) : LeerText)
            : LeerText;

    /// <summary>Eine Zahl ohne Einheit („12"); ohne Wert der Leertext.</summary>
    private string Anzahl(int? n)
        => n is int w ? w.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) : LeerText;

    /// <summary>„273 h" — eine Stundenzahl; ohne Wert der Leertext („—").</summary>
    private string Stunden(int? h)
        => h is int w ? w.ToString("N0", System.Globalization.CultureInfo.CurrentCulture) + " " + EinheitStundenZahl : LeerText;

    /// <summary>„412,5 Kh" — Kelvinstunden; ohne Wert der Leertext.</summary>
    private string Kelvinstunden(double? kh)
        => kh is double w ? w.ToString("N1", System.Globalization.CultureInfo.CurrentCulture) + " Kh" : LeerText;

    /// <summary>„12,34 MWh/a" — der Restbedarf des Projekts; ohne Lauf der Leertext.</summary>
    private string RestbedarfWert
        => Daten.RestbedarfProjektMwh is double r
            ? r.ToString("N2", System.Globalization.CultureInfo.CurrentCulture) + " MWh/a"
            : LeerText;

    /// <summary>Das Bild der Komfortwoche — einmal gerechnet, damit der Zoom stehen bleibt.</summary>
    private Zeichenmodell? _komfortwochenmodell;
    private bool _komfortwochenmodellGerechnet;
    private Zeichenmodell? Komfortwochenmodell
    {
        get
        {
            if (BildauftragKomfortwoche is null) return null;
            if (!_komfortwochenmodellGerechnet)
            {
                _komfortwochenmodell = BildauftragKomfortwoche();
                _komfortwochenmodellGerechnet = true;
            }
            return _komfortwochenmodell;
        }
    }

    /// <summary><c>GEBB_BILD_VORLAUF_RUECKLAUF</c></summary>
    [Parameter] public string BildtextVorlauf { get; set; } = "Vorlauf und Rücklauf";

    /// <summary><c>GEBB_KACHEL_VORLAUF_RUECKLAUF</c></summary>
    [Parameter] public string KachelVorlaufRuecklauf { get; set; } = "Vorlauf / Rücklauf";

    /// <summary><c>GEBB_KACHEL_BEGRENZT</c></summary>
    [Parameter] public string KachelBegrenzt { get; set; } = "Stunden mit begrenzter Übergabe";

    /// <summary><c>GEBB_KACHEL_BEGRENZT_QUELLE</c></summary>
    [Parameter] public string QuelleBegrenzt { get; set; } =
        "Stunden, in denen die Übergabe weniger lieferte, als der Sollwert verlangte";

    /// <summary><c>GEBB_HRL_VORLAUF_LUECKEN</c></summary>
    [Parameter] public string HinweisVorlaufLuecken { get; set; } =
        "Stunden ohne Heizbetrieb bleiben im Bild leer — dort gibt es keinen Vorlauf.";

    // --- E37: der Kältekreis (Anlagenkopplung 8.3, 10.5) ------------------------------

    /// <summary>
    /// Liefert das Bild „Kühlvorlauf und Kühlrücklauf" — dasselbe Bild wie auf der Heizseite, nur
