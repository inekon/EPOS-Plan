    // --- Stand ------------------------------------------------------------------

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private readonly List<SenkenzeileDaten> _zeilen = new();
    private int _index;
    private IReadOnlyList<int> _verbund = Array.Empty<int>();

