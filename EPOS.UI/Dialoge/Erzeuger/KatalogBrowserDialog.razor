    public IReadOnlyList<Vergleichszeile> Vergleichszeilen
        => _vergleichszeilen ?? Array.Empty<Vergleichszeile>();

    /// <summary>Steht das Stammblatt im schmalen Fenster als Blatt über der Liste? (Prüfhilfe.)</summary>
    public bool BlattOffen => _auswahl.BlattOffen;

    /// <summary>
    /// <b>Die Handlungen der Auswahlleiste</b> (V8): Vergleichen ab zwei gewählten Zeilen,
    /// Duplizieren… für genau eine, Löschen für jede Zahl — weich gesperrt, wenn jede
    /// Zielzeile ein Auslieferungssatz ist (V13). Im Lesemodus sind Duplizieren und
    /// Löschen hart gesperrt, wie „Neu…".
    /// </summary>
    private IReadOnlyList<Auswahlhandlung> Handlungen()
    {
        var liste = new List<Auswahlhandlung>(3)
        {
            new(Filtertexte.Vergleichen, _vergleichen)
            {
                Mindestens = 2,
                ZahlGrund = Resource.ADM_AW_VERGLEICHEN_GRUND,
                Gedrueckt = _auswahl.Vergleich
            }
        };
        if (Wege.Duplizieren is not null)
            liste.Add(new(BtnDuplizierenText, _duplizieren)
            {
                Hoechstens = 1,
                ZahlGrund = Resource.ADM_AW_DUPLIZIEREN_GRUND,
                Aus = NurLesen
            });
        // AD-Q15: die Beschriftung folgt der Auswahl; hart gesperrt im Lesemodus.
        if (_schloss.Handlung(Wege.Schloss, _schlossHandlung, SchlossZiele, NurLesen) is { } schloss)
            liste.Add(schloss);
        liste.Add(new(BtnLoeschenText, _loeschen) { Sperrgrund = LoeschSperrgrund, Aus = NurLesen });
        return liste;
    }

    /// <summary>
    /// <b>Löschen eines Auslieferungssatzes ist weich gesperrt</b> (V13): Sind ALLE
    /// Zielzeilen Auslieferungssätze, nennt der Knopf den Grund und den Weg über
    /// „Duplizieren…". Ist nur ein Teil geschützt, löscht er den Rest, und die Rückfrage
    /// nennt, was stehen bleibt (AD-Q9).
    /// </summary>
    private string LoeschSperrgrund
    {
        get
        {
            IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
            if (ziele.Count == 0) return "";
            foreach (string z in ziele)
                if (!_geschuetzt.Contains(z)) return "";
            return Resource.ADM_AW_LOESCHEN_GESPERRT;
        }
    }

    /// <summary>„Stammblatt ›" nur, solange das Blatt nicht schon offen ist.</summary>
    private EventCallback BlattOeffnenWeg => _auswahl.BlattOffen ? default : _blattOeffnen;

    /// <summary>„Hersteller · Brennstoff · eigener Satz" — aus der Zeile der Liste.</summary>
    private string Unterzeile => Stammblattkopf.Unterzeile(
        Profil.Filterprofil, _fokuszeile,
        _auslieferung ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ);

    /// <summary>Die drei Kennzahlen im Kopf — die ersten Zahlenspalten des Profils.</summary>
    private IReadOnlyList<Stammblattkennzahl> Kennzahlen
        => Stammblattkopf.Kennzahlen(Profil.Filterprofil, _fokuszeile);

    /// <summary>„Alle Daten" — der Aufklapper der Parameterübersicht im Stammblatt.</summary>
    private static string TextAlleDaten => Resource.ADM_SB_ALLE_DATEN;

    /// <summary>
    /// Der Fuß des Stammblatts: „2 Felder geändert" — gezählt gegen die Werte beim Laden,
    /// eine Fehleingabe zählt mit (sie hat den Wert noch nicht geschrieben).
    /// </summary>
    private string Aenderungshinweis
    {
        get
        {
            if (!_geaendert) return "";
            int n = 0;
            foreach (BrowserFeldwert f in _felder)
                if (!_geladen.TryGetValue(f.Schluessel, out string? w) || w != f.Wert) n++;
            n = Math.Max(n, _fehlerhaft.Count);
            if (n == 0) return "";
            return n == 1
                ? Resource.ADM_SB_GEAENDERT_EINS
                : string.Format(CultureInfo.CurrentCulture, Resource.ADM_SB_GEAENDERT, n);
        }
    }

    /// <summary>Die Liste meldet ihre Kästchen (V6) — ein laufender Vergleich folgt ihnen.</summary>
    private void BeiKaestchen(IReadOnlyList<string> gewaehlte)
    {
        _auswahl.Setzen(gewaehlte);
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;
    }

    /// <summary>„Auswahl aufheben" — nur über die Leiste; Esc bleibt Beenden.</summary>
    private void BeiAufheben()
    {
        _auswahl.Aufheben();
        _vergleichszeilen = null;
    }

    /// <summary>„Vergleichen" schaltet das Stammblatt auf den Vergleich und zurück (V12).</summary>
    private void BeiVergleichen()
    {
        if (_auswahl.VergleichUmschalten()) VergleichBauen();
        else _vergleichszeilen = null;
    }

    /// <summary>„‹ Stammblatt von …", Kreuz und Esc der breiten Ansicht.</summary>
    private void BeiVergleichZurueck()
    {
        _auswahl.VergleichBeenden();
        _vergleichszeilen = null;
    }

    /// <summary>
    /// <b>Der Vergleich über die KATALOGFELDER</b> (V12) — dieselben Felder, die das
    /// Stammblatt zeigt, je gewähltem Satz; dazu die Herkunft. Der Bezeichner steht im
    /// Spaltenkopf und nicht noch einmal als Zeile. Ohne Detailweg vergleicht er die
    /// Spalten der Liste. Gerechnet wird beim Anstellen und wenn sich die Kästchen
    /// ändern, nicht je Zeichenlauf — hinter <c>Wege.Detail</c> steht ein
    /// Datenbankzugriff je Satz.
    /// </summary>
    private void VergleichBauen()
    {
        IReadOnlyList<string> namen = _auswahl.Gewaehlte;
        _vergleichskoepfe = namen;

        if (Wege.Detail is null)
        {
            var zeilen = new List<Katalogfilterzeile>();
            foreach (string n in namen)
            {
                Katalogfilterzeile? z = _zeilen.FirstOrDefault(x => x.Schluessel == n);
                if (z is not null) zeilen.Add(z);
            }
            _vergleichszeilen = Vergleichsbau.AusSpalten(Profil.Filterprofil, zeilen);
            return;
        }

        var saetze = new List<IReadOnlyList<Vergleichsfeld>>(namen.Count);
        foreach (string name in namen)
        {
            var felder = new List<Vergleichsfeld>();
            foreach (BrowserFeldwert f in Wege.Detail(name) ?? Array.Empty<BrowserFeldwert>())
            {
                if (f.Schluessel == KatalogBrowserProfil.FeldBezeichner) continue;
                felder.Add(new Vergleichsfeld(f.Schluessel, Feldbeschriftung(f), Feldanzeige(f)));
            }
            felder.Add(new Vergleichsfeld(HERKUNFT, Resource.ADM_VG_HERKUNFT,
                _geschuetzt.Contains(name) ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ));
            saetze.Add(felder);
        }
        _vergleichszeilen = Vergleichsbau.AusFeldern(saetze);
    }

    /// <summary>
    /// Die Gruppe „Kosten" — nur, wo der Satz Kostenfelder führt; ohne Inhalt keine
    /// Gruppe (ohne Satz gibt es keine Felder).
    /// </summary>
    /// <summary>
    /// <b>Die Felder als Text</b> (V13, Stufe 4): Ein Auslieferungssatz — und der
    /// Lesemodus des Wirts — zeigt Kenndaten und Kosten im Stammblatt als Liste aus Name
    /// und Wert statt als gesperrte Eingaben; ein Schalter steht als Ja/Nein da.
    /// </summary>
    private static IReadOnlyList<Stammblattwert> Lesewerte(IEnumerable<BrowserFeldwert> felder)
        => felder.Select(f => new Stammblattwert(
               f.Bezeichnung,
               f.Art == BrowserFeldArt.Schalter
                   ? (f.Schalterwert ? Resource.ALLG_BTN_JA : Resource.ALLG_BTN_NEIN)
                   : f.Wert,
               f.Einheit)).ToList();

    private RenderFragment? KostenInhalt => _kosten.Count == 0 ? null :
        @<Katalogfelder Felder="@_kosten" NurLesen="@(NurLesen || Auslieferungssatz)"
                        Geaendert="BeiFeldAenderung" FehlerZustand="BeiFehlerZustand" />;

    private static string Feldbeschriftung(BrowserFeldwert f)
        => f.Einheit.Length > 0 ? f.Feldname + " [" + f.Einheit + "]" : f.Feldname;

    private string Feldanzeige(BrowserFeldwert f)
        => f.Art == BrowserFeldArt.Schalter ? (f.Schalterwert ? JaText : NeinText) : f.Wert;

    protected override void OnParametersSet()
    {
        if (ProfilVorgabe is null && (_profil is null || _profil.Art != Art))
            _profil = KatalogBrowserProfil.Finde(Art);

        // Der Kopf der WAHLSPALTE kommt weiter über den eigenen Text der Hülle
        // (KFAK_SP_WAHL) — dasselbe Wort in allen neun Katalogdialogen.
        Filtertexte.SpalteWahl = SpalteWahlText;

        // Das Schloss nennt den Ausweg, wo es ihn gibt (V10, AD-Q11).
        Filtertexte.Schloss = Wege.Duplizieren is not null && !NurLesen
            ? Resource.ADM_SCHLOSS_DUPLIZIEREN
            : Resource.ADM_SCHLOSS;
    }

    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _duplizieren = EventCallback.Factory.Create(this, BeiDuplizieren);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _loeschen = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        if (ProfilVorgabe is null) _profil = KatalogBrowserProfil.Finde(Art);
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Profil.Filterprofil.Art);
        ListeAufbauen();

        // Welle #456: VIER Katalogschluessel auf EINER Komponente - welcher gilt, sagt
        // das Profil (eine ProfilVorgabe schlaegt den Parameter Art, und angemeldet
        // gehoert die Maske, die der Anwender vor sich hat).
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.KatalogBrowser(Profil.Art),
                                          () => KiSicht(), KiHaken());
    }

    // =====================================================================
    // Der Hilfe-Assistent (Welle #456)
    // =====================================================================

    private KiMaskenanmeldung? _kiMaske;
    private KatalogBrowserKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die Listenwahl und je Profilfeld ein Eintrag der
    /// Feldtafel über dem LEBENDEN Feldsatz. Sie wird EINMAL erzeugt und hält nur
    /// Delegaten — der Feldsatz wechselt mit jeder Zeilenwahl, die Sicht nicht.
    /// </summary>
    private KatalogBrowserKiSicht KiSicht()
    {
        return _kiSicht ??= new KatalogBrowserKiSicht
        {
            Feldsuche = Feld,
            Gesetzt = BeiFeldAenderung,
            SatzLesen = () => _gewaehlt,
            SatzSetzen = KiSatzWaehlen,
            SatzEintraege = () => KiMaskenanmeldung.Eintraege(
                _zeilen, z => z.Bezeichner, z => z.Bezeichner)
        };
    }

    /// <summary>
    /// <b>Der Assistent wählt eine Zeile</b> — derselbe Weg wie ein Klick
    /// (<see cref="BeiZeile"/>). Geänderte Felder halten den Wechsel an (V11); der
    /// Assistent bekommt dann denselben Satz, den das Warnband zeigt, statt still
    /// „gesetzt" zu melden.
    /// </summary>
    private string? KiSatzWaehlen(string bezeichner)
    {
        string neu = bezeichner ?? "";
        if (neu == _gewaehlt) return null;

        if (_geaendert)
        {
            Warnen(MeldungUngespeichert);
            return MeldungUngespeichert;
        }

        BeiZeile(neu);
        return null;
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf.
    /// </summary>
    /// <remarks>
    /// <para><b>Schreibschutz</b> ist der Lesemodus des Wirts ODER ein Auslieferungssatz
    /// (AD-Q11): Solange er steht, lehnt schon <c>feld_setzen</c> ab, nicht erst der
    /// Speicherknopf — und die Absage nennt den Weg über „Duplizieren…". Die Wahl des
    /// Satzes bleibt frei; aus einem Auslieferungssatz heraus lässt sich der eigene
    /// wählen.</para>
    /// <para><b>Die Prüfung ist DIESELBE, die der Speicherknopf ruft</b>
    /// (<see cref="EingabenPruefen"/>), der Speicherweg DERSELBE Schreibweg
    /// (<see cref="Schreiben"/>).</para>
    /// <para><b>Nicht über den Assistenten</b>: Neu…, Duplizieren…, Löschen, Import… —
    /// sie legen Sätze an oder nehmen sie weg (KI-D-Q11).</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => NurLesen || Auslieferungssatz,
        Schreibschutzgrund = () => NurLesen ? Resource.KI_DLG_KBROW_NURLESEN : MeldungSpeichernGesperrt,
        Pruefen = () => EingabenPruefen() ? "" : _meldung,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>
    /// <b>„Speichern" über den Assistenten</b> — derselbe Weg wie der Knopf; ein
    /// Auslieferungssatz und der Lesemodus werden benannt abgelehnt, ebenso ein Aufruf
    /// ohne Satz oder ohne Änderung.
    /// </summary>
    private KiErgebnis KiSpeichern()
    {
        if (!Profil.HatSpeicherweg || Wege.Speichern is null)
            return KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", Profil.Titel));

        if (NurLesen) return KiErgebnis.Abgelehnt(Resource.KI_DLG_KBROW_NURLESEN);

        if (_gewaehlt.Length == 0)
            return KiErgebnis.Abgelehnt(Resource.KI_DLG_ADMIN_OHNE_SATZ.Replace("{0}", Profil.Titel));

        if (_auslieferung) return KiErgebnis.Abgelehnt(MeldungSpeichernGesperrt);

        if (!_geaendert)
            return KiErgebnis.Abgelehnt(Resource.KI_DLG_ADMIN_OHNE_AENDERUNG.Replace("{0}", Profil.Titel));

        if (!EingabenPruefen()) return KiErgebnis.Abgelehnt(_meldung);

        return Schreiben()
            ? KiErgebnis.Ok(_status, anzahl: 1)
            : KiErgebnis.Fehlgeschlagen(_meldung);
    }

    /// <summary>Die Anmeldung fällt mit dem Dialog.</summary>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =====================================================================
    // Liste und Detailblock
    // =====================================================================

    /// <summary>
    /// Baut die Liste neu und stellt die Markierung auf denselben Satz zurück
    /// (wortgleich <c>Form_BHKWAdmin.ListeAktualisieren</c>).
    /// </summary>
    /// <remarks>
    /// Der FILTER ruft sie nicht mehr: Er wirkt auf die ANZEIGE, nie auf die Auswahl
    /// (Hausregel aus dem <c>EnergietraegerDialog</c>, W4) — das erledigt seit
    /// W14a‑E‑10 die <c>Katalogliste</c> auf der ungefilterten Menge. Hier wird nur
    /// nach einem SCHREIBweg neu gelesen (Speichern, Löschen, Editor).
    /// </remarks>
    private void ListeAufbauen()
    {
        _zeilen = Wege.Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();

        _geschuetzt = new HashSet<string>(_zeilen.Where(z => z.Geschuetzt).Select(z => z.Bezeichner),
                                          StringComparer.Ordinal);

        // Kaestchen verschwundener Zeilen fallen (V6); ein laufender Vergleich liest
        // die Saetze neu - ein Speichern hat ihre Werte geaendert.
        _auswahl.Abgleichen(_zeilen.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        if (_gewaehlt.Length > 0 && _zeilen.Any(z => z.Bezeichner == _gewaehlt))
        {
            _fokuszeile = _zeilen.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
            return;
        }

        // Wie der Bestand: nach dem Aufbau steht die erste Zeile.
        _gewaehlt = _zeilen.Count > 0 ? _zeilen[0].Bezeichner : "";
        DetailLaden();
    }

    private void DetailLaden()
    {
        _fehlerhaft.Clear();
        _geaendert = false;

        // Der Schreibschutz kommt aus der Zeile der Liste (Katalogfilterzeile.Geschuetzt,
        // aus ReadOnly) - fuer alle vier Auspraegungen, nicht nur das BHKW (AD-Q11).
        // Dieselbe Zeile gibt dem Stammblatt Herkunft und Kennzahlen (V9).
        _fokuszeile = _gewaehlt.Length > 0 ? _zeilen.FirstOrDefault(z => z.Bezeichner == _gewaehlt) : null;
        _auslieferung = _fokuszeile?.Geschuetzt == true;

        // Die Uebersicht wird AUCH OHNE Auswahl geholt: Sie beantwortet die Frage
        // „welche Parameter gibt es hier ueberhaupt", und die haengt nicht am Satz
        // (W14a-E-8). Ohne Bezeichner stehen lauter Leerwerte darin.
        _uebersicht = Uebersicht?.Invoke(_gewaehlt) ?? Array.Empty<Parameterwert>();

        _felder = _gewaehlt.Length == 0
            ? new List<BrowserFeldwert>()
            : (Wege.Detail?.Invoke(_gewaehlt) ?? Array.Empty<BrowserFeldwert>()).ToList();

        // Die zwei Gruppen des Stammblatts (V9) teilen DIESELBEN Objekte - geschrieben
        // wird weiter aus _felder.
        _kenndaten = _felder.Where(f => !KatalogBrowserProfil.IstKostenfeld(f.Schluessel)).ToList();
        _kosten = _felder.Where(f => KatalogBrowserProfil.IstKostenfeld(f.Schluessel)).ToList();

        _geladen = new Dictionary<string, string>(StringComparer.Ordinal);
        foreach (BrowserFeldwert f in _felder) _geladen[f.Schluessel] = f.Wert;
    }

    /// <summary>
    /// Eine andere Zeile — per Klick oder Pfeiltaste. <b>Geänderte Felder halten die
    /// Wahl fest</b> (V11): Der Wechsel verwürfe sie still; das Warnband sagt
    /// „Speichern oder Verwerfen", und die Liste springt auf die gehaltene Zeile zurück.
    /// </summary>
    private void BeiZeile(string bezeichner)
    {
        string neu = bezeichner ?? "";
        if (neu == _gewaehlt) return;

        if (_geaendert)
        {
            Warnen(MeldungUngespeichert);
            return;
        }

        _gewaehlt = neu;
        _meldung = "";
        _status = "";
        DetailLaden();
    }

    private void Warnen(string text)
    {
        _meldung = text ?? "";
        _meldungStufe = WarnStufe.Warnung;
    }

    /// <summary>
    /// Ein Speichern ist abgelehnt (Sperre, Prüfregel, Schreibfehler): Der Grund steht im
    /// Warnband oben UND rot in der Statuszeile neben dem Knopf — das Band ist bei einer
    /// langen Liste nicht im Blick.
    /// </summary>
    private void SpeichernAbgelehnt(string grund)
    {
        Warnen(grund);
        _status = grund ?? "";
        _statusFehler = true;
    }

    // =====================================================================
    // Die Felder des Speicherwegs
    // =====================================================================

    /// <summary>
    /// Ein Feld im Baustein <c>Katalogfelder</c> hat sich geändert - der Browser führt
    /// daraufhin seinen „geändert"-Zustand nach und nimmt eine stehende Meldung weg.
    /// </summary>
    /// <remarks>
    /// <b>WAS sich geändert hat, interessiert hier nicht.</b> Der Baustein schreibt in
    /// dieselben <see cref="BrowserFeldwert"/>-Objekte, die der Browser ohnehin hält;
    /// gespeichert wird beim Knopfdruck aus genau dieser Liste.
    /// </remarks>
    private void BeiFeldAenderung()
    {
        _geaendert = true;
        _meldung = "";
        _status = "";
        SummeNachziehen();
    }

    /// <summary>
    /// <b>Der Gesamtwirkungsgrad des BHKW läuft mit</b> (Anwenderentscheid
    /// 20.09.2026): Er ist ein ANZEIGEFELD, und was es zeigt, ist die Summe der zwei
    /// Anteile — sobald einer von beiden sich ändert.
    /// </summary>
    /// <remarks>
    /// <para><b>Die Rechnung steht im Kern</b> (<c>BhkwWirkungsgrad.GesamtAnzeige</c>,
    /// Schemaschritt 99) — dieselbe, die der Katalogeditor zeigt und die der
    /// Schreibweg in die Spalte stellt. Hier steht nur, WANN sie gezogen wird.</para>
    /// <para><b>Sind beide Anteile leer, bleibt das Feld stehen</b>: Dann trägt es den
    /// Altbestandswert eines Satzes von vor Schritt 99, und den soll das Ändern eines
    /// anderen Feldes nicht wegwischen.</para>
    /// </remarks>
    private void SummeNachziehen()
    {
        if (Profil.Art != KatalogBrowserArt.Bhkw) return;

        BrowserFeldwert? el = Feld(KatalogBrowserProfil.FeldWirkungsgradEl);
        BrowserFeldwert? th = Feld(KatalogBrowserProfil.FeldWirkungsgradTh);
        BrowserFeldwert? gesamt = Feld(KatalogBrowserProfil.FeldWirkungsgrad);
        if (el is null || th is null || gesamt is null) return;

        double? elWert = Zahlen.ZahlParsen(el.Wert, out double e) ? e : null;
        double? thWert = Zahlen.ZahlParsen(th.Wert, out double t) ? t : null;
        if (elWert is null && thWert is null) return;

        gesamt.Wert = BhkwWirkungsgrad.GesamtAnzeige(elWert, thWert, null);
    }

    private BrowserFeldwert? Feld(string schluessel)
        => _felder.FirstOrDefault(f => f.Schluessel == schluessel);

    /// <summary>
    /// Sammelt, welche Zahlenfelder gerade keinen gueltigen Text tragen.
    /// </summary>
    /// <remarks>
    /// Eine FEHLEINGABE gilt als Aenderung und gibt den Speichern-Knopf frei — sonst
    /// bliebe er gesperrt, und der Anwender bekaeme die Pruefmeldung nie zu sehen. Der
    /// Vorlaeufer setzte <c>m_bGeaendert</c> ebenso in <c>TextChanged</c>, ohne den
    /// Text vorher anzusehen.
    /// </remarks>
    private void BeiFehlerZustand((string Feld, bool Fehlerhaft) meldung)
    {
        if (meldung.Fehlerhaft)
        {
            if (!_fehlerhaft.Contains(meldung.Feld)) _fehlerhaft.Add(meldung.Feld);
            _geaendert = true;
        }
        else
        {
            _fehlerhaft.Remove(meldung.Feld);
        }
    }

    private bool EingabenPruefen()
    {
        if (_fehlerhaft.Count == 0) return true;

        _meldung = string.Format(MeldungZahlUngueltig, _fehlerhaft[0]);
        _meldungStufe = WarnStufe.Warnung;
        return false;
    }

    // =====================================================================
    // Die Knoepfe der Fussleiste
    // =====================================================================

    /// <summary>
    /// „Speichern" — die Felder des gewählten Satzes. <b>Ein Auslieferungssatz wird nie
    /// überschrieben</b> (AD-Q11): Der Knopf ist weich gesperrt, ein Klick nennt den Weg
    /// über „Duplizieren…". Die Rückfrage des BHKW „Trotzdem überschreiben?" gibt es
    /// deshalb nicht mehr, und der Schreibweg bekommt nie die Erlaubnis, den Schutz zu
    /// übergehen.
    /// </summary>
    private void BeiSpeichern()
    {
        if (SpeichernWeichGesperrt)
        {
            SpeichernAbgelehnt(MeldungSpeichernGesperrt);
            return;
        }

        if (!SpeichernErlaubt || Wege.Speichern is null) return;
        if (!EingabenPruefen()) { SpeichernAbgelehnt(_meldung); return; }

        Schreiben();
    }

    /// <summary>
    /// Schreibt die Felder; Erfolg in die Statuszeile, ein Fehlschlag ins Warnband und rot
    /// in die Statuszeile.
    /// </summary>
    private bool Schreiben()
    {
        KatalogSpeicherErgebnis ergebnis = Wege.Speichern!(_gewaehlt, _felder, false);

        if (!ergebnis.Ok)
        {
            SpeichernAbgelehnt(ergebnis.Meldung);
            return false;
        }

        _meldung = "";
        _status = ergebnis.Meldung;
        _geaendert = false;
        ListeAufbauen();
        return true;
    }

    private void BeiNeu()
    {
        if (NurLesen) return;
        if (_geaendert) { Warnen(MeldungUngespeichert); return; }
        _meldung = "";
        _namensfrage = true;
    }

    // =====================================================================
    // „Duplizieren…" (Entscheid AD-Q11)
    // =====================================================================

    /// <summary>
    /// <b>„Duplizieren…"</b>: fragt den Namen — vorbelegt mit „Name (Kopie)", der erste
    /// freie — und legt den eigenen Satz an. Wie „Neu…" beginnt es mit der
    /// Namensabfrage; anders als „Neu…" übernimmt es alle Werte des gewählten Satzes.
    /// Geänderte Felder halten es auf — kopiert wird der Stand im Katalog.
    /// </summary>
    private void BeiDuplizieren()
    {
        if (!DuplizierenErlaubt) return;
        if (_geaendert) { Warnen(MeldungUngespeichert); return; }

        // Kopiert wird die EINE Zielzeile: die gewaehlte, sonst die Fokuszeile (V8).
        _duplizierQuelle = _auswahl.Ziele(_gewaehlt)[0];
        _meldung = "";
        _kopievorschlag = Katalogkopie.Namensvorschlag(_duplizierQuelle, NameVergeben);
        _duplizierfrage = true;
    }

    private bool NameVergeben(string name)
        => _zeilen.Any(z => z.Bezeichner == name) || Wege.Existiert?.Invoke(name) == true;

    /// <summary>Die Namensprüfung der Abfrage — ein vergebener Name hält sie offen.</summary>
    private string? NameBelegt(string name) => NameVergeben(name) ? MeldungNameBelegt : null;

    private void BeiDuplizierName(string? name)
    {
        _duplizierfrage = false;
        if (name is null || Wege.Duplizieren is null) return;

        Katalogfilterzeile? zeile = _zeilen.FirstOrDefault(z => z.Bezeichner == _duplizierQuelle);
        if (zeile is null) return;

        string alt = _duplizierQuelle;
        KatalogSpeicherErgebnis ergebnis = Wege.Duplizieren(zeile.Id, name);
        if (!ergebnis.Ok)
        {
            Warnen(ergebnis.Meldung);
            return;
        }

        // Die Kopie ist gewaehlt - ihr Stammblatt steht bearbeitbar da, und die
        // Kaestchen fallen: Die naechste Handlung gilt der Kopie.
        _auswahl.Aufheben();
        _vergleichszeilen = null;
        _gewaehlt = ergebnis.Name;
        ListeAufbauen();
        DetailLaden();
        _status = string.Format(MeldungDupliziert, alt, ergebnis.Name);
    }

    // =====================================================================
    // „Schloss setzen…" / „Schloss aufheben…" (Entscheid AD-Q15)
    // =====================================================================

    /// <summary>Die Zeilen, auf die die Auswahlleiste gerade wirkt.</summary>
    private IReadOnlyList<Katalogfilterzeile> SchlossZiele
        => Schlossumschaltung.Zeilen(_auswahl.Ziele(_gewaehlt), _zeilen);

    /// <summary>
    /// Der Klick: Rückfrage in beiden Richtungen, Vorgabe „Nein". Geänderte Felder halten
    /// sie auf — sonst verschwänden sie unter einem gesetzten Schloss.
    /// </summary>
    private void BeiSchloss()
    {
        if (NurLesen) return;
        string? grund = _schloss.Fragen(Wege.Schloss, SchlossZiele, _geaendert);
        if (grund is not null) { Warnen(grund); return; }
        _meldung = "";
    }

    /// <summary>
    /// Nach dem „Ja": schalten, die Liste neu lesen — Schloss, Lesemodus des Stammblatts
    /// und Speichern folgen aus der Fokuszeile —, Erfolg in die Statuszeile.
    /// </summary>
    private void BeiSchlossAntwort(bool? antwort)
    {
        Schlossausgang a = _schloss.Beantwortet(antwort, Wege.Schloss);
        if (!a.Geschrieben)
        {
            if (a.Fehler.Length > 0) Warnen(a.Fehler);
            return;
        }
        ListeAufbauen();
        if (_gewaehlt.Length > 0) DetailLaden();
        _meldung = "";
        _status = a.Status;
    }

    /// <summary>
    /// „Neu…": Namensabfrage → <c>Exists</c>-Vorabtest → Editor im Modus „Neu".
    /// <b>Angleichung:</b> Der Vorabtest gab es im Bestand nur bei Heizkessel und
    /// Pufferspeicher (dort als inline-SQL, Befund W14-B27); BHKW und
    /// Solarkollektoren legten ohne ihn an.
    /// </summary>
    private void BeiNamensfrage(string? name)
    {
        _namensfrage = false;
        if (name is null) return;

        if (Wege.Existiert?.Invoke(name) == true)
        {
            _meldung = MeldungNameBelegt;
            _meldungStufe = WarnStufe.Warnung;
            return;
        }

        EditorOeffnen(name, neu: true);
    }

    /// <summary>
    /// „Verwerfen" (AD-Q6): Die Felder des gewählten Satzes kommen neu aus dem Katalog,
    /// die Änderungen sind zurückgenommen, eine Prüfmeldung ist weg. Geschrieben wird
    /// nichts.
    /// </summary>
    private void BeiVerwerfen()
    {
        if (!VerwerfenErlaubt) return;
        _meldung = "";
        DetailLaden();
    }

    private void EditorOeffnen(string name, bool neu)
    {
        if (EditorGaben is null || EditorInhalt is null) return;

        _editorGaben = EditorGaben(name, neu, EditorFertig);
        _editorOffen = true;
    }

    /// <summary>
    /// Nach dem Editor: Liste neu bauen und die Markierung auf den (ggf. neuen) Namen
    /// stellen — die Reihenfolge aller vier Vorläufer.
    /// </summary>
    private void EditorFertig(string? name)
    {
        _editorOffen = false;
        _editorGaben = null;

        if (name is not null) _gewaehlt = name;
        ListeAufbauen();
        if (name is not null) DetailLaden();
        StateHasChanged();
    }

    /// <summary>
    /// <b>„Löschen" aus der Auswahlleiste</b> (V8, AD-Q9): wirkt auf die gewählten Zeilen,
    /// sonst auf die Fokuszeile. Auslieferungssätze bleiben stehen (V13) — sind es alle,
    /// ist der Knopf weich gesperrt und kommt gar nicht hierher. Die Rückfrage nennt,
    /// was gelöscht wird und was stehen bleibt; sie ist die einzige der Maske.
    /// </summary>
    private void BeiLoeschen()
    {
        if (NurLesen) return;

        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count == 0) { Ausgewaehlt(); return; }

        var loeschbar = ziele.Where(z => !_geschuetzt.Contains(z)).ToList();
        var bleiben = ziele.Where(z => _geschuetzt.Contains(z)).ToList();
        if (loeschbar.Count == 0) { Warnen(Resource.ADM_AW_LOESCHEN_GESPERRT); return; }

        _loeschziele = loeschbar;
        _loeschBleiben = bleiben.Count;

        string frage = loeschbar.Count == 1
            ? string.Format(FrageLoeschen, loeschbar[0])
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_FRAGE_MEHR,
                            loeschbar.Count, string.Join(", ", loeschbar));
        if (bleiben.Count > 0)
            frage += " " + string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_BLEIBEN,
                                         string.Join(", ", bleiben));

        _loeschtext = frage;
        _loeschfrage = true;
    }

    /// <summary>
    /// Nach dem „Ja": je Zeile ein benannter Schreibschritt (Hausregel „Bedienung"). Was
    /// der Katalog ablehnt (in Verwendung), bleibt stehen und nennt seinen Grund im
    /// Warnband; die Statuszeile nennt, wie viele gelöscht wurden und wie viele blieben.
    /// </summary>
    private void BeiLoeschAntwort(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || Wege.Loeschen is null) return;

        int geloescht = 0;
        var gruende = new List<string>();
        foreach (string name in _loeschziele)
        {
            KatalogSpeicherErgebnis ergebnis = Wege.Loeschen(name);
            if (ergebnis.Ok)
            {
                geloescht++;
                if (name == _gewaehlt) _gewaehlt = "";
            }
            else if (!gruende.Contains(ergebnis.Meldung))
            {
                gruende.Add(ergebnis.Meldung);
            }
        }

        int ziele = _loeschziele.Count + _loeschBleiben;
        int blieben = ziele - geloescht;
        _loeschziele = new List<string>();

        if (gruende.Count > 0) Warnen(string.Join(" ", gruende));
        else _meldung = "";

        if (geloescht > 0) ListeAufbauen();

        _status = ziele <= 1 || geloescht == 0 ? ""
                : blieben > 0 ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT_BLEIBEN, geloescht, blieben)
                : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT, geloescht);
    }

    /// <summary>
    /// <b>„Beenden"</b> — der eine Schlussweg (V15); das Kreuz und Esc nehmen ihn auch.
    /// Die Verwaltung hat keinen Arbeitsstand, der zu verwerfen wäre: Speichern,
    /// Duplizieren und Löschen schreiben sofort.
    ///
    /// <para><b>Geänderte Felder halten sie auf</b> (Konzept 3.3, V11): Beenden sagt
    /// im Warnband „Speichern oder Verwerfen" und bleibt offen. Bis Stufe 1 schrieb „OK"
    /// die Änderungen still zurück und „Abbrechen" (✕, Esc) verwarf sie still — beides
    /// entschied ein Knopf, dessen Name es nicht sagte.</para>
    /// </summary>
    private Task BeiBeenden()
    {
        if (_geaendert)
        {
            Warnen(MeldungUngespeichert);
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(new BrowserErgebnis(true, _gewaehlt));
    }

    /// <summary>
    /// Die Leerprüfung der Knöpfe. BHKW und Solarkollektoren MELDEN, Heizkessel und
    /// Pufferspeicher kehren still zurück — bitgleich zum Bestand, deshalb steht der
    /// Text im Profil und ist dort für zwei der vier leer.
    /// </summary>
    private bool Ausgewaehlt()
    {
        if (_gewaehlt.Length > 0) return true;

        if (Profil.MeldungOhneAuswahl.Length > 0)
        {
            _meldung = Profil.MeldungOhneAuswahl;
            _meldungStufe = WarnStufe.Warnung;
        }
        return false;
    }

    // =====================================================================
    // "Import..." (Konzept Administrationsdialoge 7.1 d, Zweitweg zu V14)
    // =====================================================================

    /// <summary>„Import…" — <c>ADM_BTN_IMPORT</c>.</summary>
    [Parameter] public string BtnImportText { get; set; } = Resource.ADM_BTN_IMPORT;

    private IReadOnlyDictionary<string, object>? _importGaben;
    private HashSet<string> _vorImport = new(StringComparer.Ordinal);

    /// <summary>Steht der Import als Überlagerung? (Prüfhilfe für Tests.)</summary>
    public bool ImportOffen => _importGaben is not null;

    /// <summary>
    /// „Import…" öffnet den Herstellerimport dieses Katalogs als Überlagerung. Geänderte
    /// Felder halten an wie bei „Neu…" (Konzept 3.3).
    /// </summary>
    private void ImportOeffnen()
    {
        if (Wege.ImportGaben is null || NurLesen) return;
        if (_geaendert) { Warnen(MeldungUngespeichert); return; }
        _meldung = "";
        _vorImport = new HashSet<string>(_zeilen.Select(z => z.Bezeichner), StringComparer.Ordinal);
        _importGaben = Wege.ImportGaben();
    }

    /// <summary>
    /// Der Import ist zu. Hat er geschrieben, liest die Liste neu, und die neuen Sätze sind
    /// die Auswahl (V14, 7.1 d): ab zweien über ihre Kästchen („n gewählt"), der erste steht
    /// als Fokuszeile im Stammblatt; die Statuszeile nennt ihre Zahl.
    /// </summary>
    private void ImportFertig(bool geschrieben)
    {
        _importGaben = null;
        if (!geschrieben) return;

        ListeAufbauen();
        List<Katalogfilterzeile> neu = _zeilen.Where(z => !_vorImport.Contains(z.Bezeichner)).ToList();
        if (neu.Count == 0) return;

        _auswahl.Uebernommen(neu.Select(z => z.Schluessel));
        _vergleichszeilen = null;
        _gewaehlt = neu[0].Bezeichner;
        DetailLaden();
        _status = neu.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_EINGELESEN, neu[0].Bezeichner)
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_IMPORTIERT, neu.Count);
    }

    /// <summary>
    /// Esc schließt die oberste Ebene — zuletzt den Dialog, und dort wie „Beenden".
    /// Enter bleibt unbelegt: „Löschen", „Speichern" und „Duplizieren…" schreiben sofort.
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_editorOffen || _namensfrage || _duplizierfrage || _loeschfrage || _schloss.FrageOffen
            || _importGaben is not null)
            return Task.CompletedTask;

        // Im schmalen Fenster schliesst Esc zuerst das Blatt (Konzept 3.3), dann den Dialog.
        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }

        return BeiBeenden();
    }
}
