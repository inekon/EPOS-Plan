#22722=IFCPROPERTYENUMERATEDVALUE('EmbeddedSystemPositionType','Kennung f\X\FCr die Position von fl\X\E4chenintegrierten Systemen innerhalb des Geb\X\E4udeelementes Anhand der Eigenschaft wird festgelegt, ob ein fl\X\E4chenintegriertes System innerhalb des Geb\X\E4udebauteils installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein fl\X\E4chenintegriertes System vorgesehen ist. Wenn die Position des fl\X\E4chenintegrierten Systems noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
#22723=IFCPROPERTYENUMERATEDVALUE('Generator','Kennung f\X\FCr den Ersteller/Bearbeiter des Geb\X\E4udeelementes. Der Generator dient nur zur Information. Die Kennung darf nicht f\X\FCr die Identifizierung von Modellobjekten verwendet werden.',(IFCLABEL('mgt2D3D')),$);
#22724=IFCPROPERTYSINGLEVALUE('GUID','Bezeichner, der w\X\E4hrend der Lebenszeit des Modellobjektes erhalten bleibt. Der Bezeichner ist nicht eindeutig.',IFCLABEL('56960cdb-e40f-43e5-9265-272685c0ff20'),$);
#22725=IFCPROPERTYSINGLEVALUE('ID','Kennung f\X\FCr das Modellobjekt. MUSS innerhalb des Projektes eindeutig sein.',IFCIDENTIFIER('-1'),$);
#22726=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('9e4ef0da-63d0-4514-848c-1c208b916c91'),$);
#22727=IFCPROPERTYENUMERATEDVALUE('LoadBearingType','Kennung f\X\FCr die Tragf\X\E4higkeit des Bauteils',(IFCLABEL('elbNone')),$);
#22728=IFCPROPERTYSINGLEVALUE('Name','Name des Bauteils',IFCLABEL('AW 010'),$);
#22729=IFCPROPERTYSINGLEVALUE('Number','Kurzbeschreibung des Objektes. (50 Zeichen)',IFCLABEL(''),$);
#22730=IFCPROPERTYSINGLEVALUE('Orientation (\X\B0)','Orientierung betogen auf das Bauteil',IFCLABEL('180,070016554622'),$);
#22731=IFCPROPERTYENUMERATEDVALUE('Orientation.Type','Orientierung Type (Enum)',(IFCLABEL('botS')),$);
#22732=IFCPROPERTYENUMERATEDVALUE('RadiatorPositionType','Kennung f\X\FCr die Position des Heizk\X\F6rpers zum Geb\X\E4udeelement Anhand der Eigenschaft wird festgelegt, ob ein Heizk\X\F6rper an dem Geb\X\E4udebauteil installiert werden SOLL. Die Typenkennung \X2\201E\X0\mprNone\X2\201C\X0\ wird dann gesetzt, wenn kein Heizk\X\F6rper vorgesehen ist. Wenn die Position des Heizk\X\F6rpers noch offen ist, dann KANN die Typenkennung \X2\201E\X0\mprCenter\X2\201C\X0\ verwendet werden.',(IFCLABEL('mprNone')),$);
