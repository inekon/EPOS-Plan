    protected override void OnInitialized()
    {
        _eingabe = (Daten.Eingabe ?? new ZapfprofilEingabeDaten()).Kopie();
        _stufe = ZapfprofilStufe.Einfach;
        _vorschau = Daten.Vorschau;
        _vorschauAktuell = _vorschau is not null;
        _wahl = _eingabe.Zonen.Count > 0 ? 0 : -1;
        MessreihenLaden();

        // Welle #458, Stufe 3a: die Ueberlagerung als EIGENE Maske - solange sie offen
        // steht; ihr Dispose meldet sie ab.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.ZAPFPROFIL, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        StatusNachziehen();
        if (_wurzelFokusNoetig)
        {
            // Rückweg aus dem Blatt des Katalogs: die Wurzel, ohne zu rollen (den Rollstand stellt das Blatt her).
            _wurzelFokusNoetig = false;
            await _wurzel.FocusAsync(preventScroll: true);
        }
        if (_fokusNutzungsart)
        {
            _fokusNutzungsart = false;
            await NutzungsartFokussieren();
        }
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    /// <summary>
    /// Der Fokus auf die Klappliste Nutzungsart — ohne zu rollen, über das kleine Modul
    /// <c>epos-sprung.js</c>. Ohne das Modul (Prüfstand) bleibt der Fokus, wo er ist: ein
    /// Schönheitsfehler, kein Fehlschlag.
    /// </summary>
    private async Task NutzungsartFokussieren()
    {
        try
        {
            IJSObjectReference modul = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/EPOS.UI/epos-sprung.js");
            if (modul is not null) await modul.InvokeVoidAsync("feldFokus", _zonenfelder, "select:not([disabled])");
        }
        catch (Exception)
        {
            // Kein Modul, kein Fokus — der nächste Schritt steht trotzdem als Zeile im Block.
        }
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        _kiMaske?.Dispose();
        EntprellungAbbrechen();
        JahresreiheVerwerfen();
        KalibrierLaufVerwerfen();
    }

