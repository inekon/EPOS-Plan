@* Modulkatalog der Erzeuger - EINE Komponente, ZWEI Auspraegungen (iU9-W14a.3).

   Vorbilder: Views/Stromspeicher/Form_AdminStromspeicher.cs (505 Z., die
   zweitgroesste der Welle) und Views/Photovoltaik/Form_AdminPV.cs (297 Z.).

   FAMILIE C DER VERMESSUNG: Browser UND Editor in einem. Liste links,
   editierbare Felder rechts, "Speichern" schreibt unmittelbar in die
   Stammtabelle - kein zweiter Dialog, kein Katalogeditor. Dieselbe Bauart, zwei
   sehr verschiedene Pflegezustaende: Der Stromspeicher ist die gepflegte
   Fassung (AP3-Gerätetechnik, MyResource, Rueckfrage beim Loeschen, zwei
   fachliche Vorgaben), die Photovoltaik die liegengebliebene. Eine Komponente
   mit zwei Auspraegungen bringt die PV auf den Stand des Stromspeichers - das
   ist der eigentliche Gewinn des Paars.

   FORMVORBILD ist WaermepumpeStammDialog (W7.3), der naechste Verwandte im
   Bestand.

   DER AP3-LAYOUTBLOCK ENTFAELLT ERSATZLOS. Der Vorlaeufer baute sechs
   Steuerelemente ZUR LAUFZEIT mit gerechneten Koordinaten (Z. 391-461) und
   vergroesserte dabei das Fenster von 614 auf 1 036 px (Befund W14-B43); in
   Razor ist eine zweite Feldgruppe CSS. Sie steht als Gruppe 1 im Profil.

   FUENFZEHN MessageBox WERDEN BANNER UND EINE RUECKFRAGE. Geloescht wird in
   BEIDEN Auspraegungen mit Rueckfrage (Angleichung E-3); die Photovoltaik war
   die EINZIGE der elf Masken, die kommentarlos loeschte (Befund W14-B35).

   TASTATUR. Esc schliesst die oberste Ebene. Enter ist NICHT belegt -
   "Speichern" und "Loeschen" schreiben sofort.

   STUFE 2 DER NEUORDNUNG (Konzept Administrationsdialoge, V4, V10, V11, V15,
   Entscheid AD-Q11) - dieselben Regeln wie im KatalogBrowserDialog:
     * Die ZEILE ist die Wahl (Klick, Pfeiltasten, Pos1, Ende).
     * Der Modulkatalog WERTET ReadOnly AUS: Ein Auslieferungssatz traegt das
       Schloss, seine Felder sind nur lesbar, "Speichern" ist weich gesperrt,
       und "Duplizieren..." legt den eigenen Satz an. Bis hierher kannte diese
       Maske keinen Schutz je Satz, obwohl die drei Tabellen ReadOnly fuehren.
     * Fussleiste Speichern - Verwerfen - Fueller - Neu... - Duplizieren... -
       Loeschen - Beenden; Kreuz und Esc wie Beenden. Geaenderte Felder (auch
       ein angelegter, noch nicht gespeicherter Satz) halten Beenden und den
       Zeilenwechsel an: "Speichern oder Verwerfen".
     * Gelungenes steht in der Statuszeile, Gescheitertes im Warnband.

   STUFE 3 (V3, V6, V8, V9, V12, V13) - dieselben Regeln wie in der Verwaltung
   Heizkessel: Stammblatt neben der Liste (Kenndaten in den Gruppen des
   Profils, Kosten, Alle Daten), Kaestchen und Auswahlleiste (Vergleichen,
   Duplizieren..., Loeschen - auch mehrere Zeilen, Auslieferungssaetze bleiben
   stehen), Vergleich im Stammblatt. Die Fussleiste heisst Speichern -
   Verwerfen - Fueller - Neu... - Beenden. *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-katalog-dialog epos-modulkatalog" tabindex="-1"
     @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@Profil.Titel</h1>
        <InfoKnopf Schluessel="@Profil.HilfeSchluessel" />
        <Schliesskreuz Geschlossen="BeiBeenden" />
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    @* --- STUFE 3 (Konzept Administrationsdialoge, V3 V6 V8 V9 V12 V13): Liste
           LINKS ueber die ganze Hoehe, rechts Auswahlleiste und STAMMBLATT - so
           standen auch beide Vorbilder: Form_AdminPV (607 x 489, Liste 211 x 259
           links, Felder ab x 253) und Form_AdminStromspeicher (614 x 367, Liste
           201 x 293 links, Felder ab x 240). Die Ueberschrift ueber der Liste
           entfaellt: Sie nahm der Liste eine Zeile. *@
    <Katalograhmen BlattOffen="@_auswahl.BlattOffen">
        <Liste>
            @* DIE EINE KATALOGLISTE (Anwenderentscheid W14a-E-10, 07.09.2026) - fuer
               PV-Module (20 749 Zeilen nach dem CEC-Import) und Stromspeicher (6 658)
               der einzige Filterweg. Seit Stufe 3 mit Kaestchen (V6). *@
            <Katalogliste Profil="@Profil.Filterprofil" Zeilen="@_zeilen"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_gewaehlt" GewaehltChanged="BeiZeile"
                          Vergleichsparameter="@Uebersicht" ZeileIstWahl="true"
                          Kaestchen="true" Gewaehlte="@_auswahl.Gewaehlte"
                          GewaehlteChanged="BeiKaestchen"
                          Zeigeanlass="@_auswahl.Uebernahmen" />
        </Liste>

        <Auswahl>
            <Auswahlleiste Fokus="@_gewaehlt" Anzahl="@_auswahl.Anzahl"
                           Handlungen="@Handlungen()"
                           Aufheben="BeiAufheben" Gesperrt="Warnen"
                           Stammblatt="@BlattOeffnenWeg" />
        </Auswahl>

        <Blatt>
            @* DAS STAMMBLATT (V9): "Kenndaten" traegt die Gruppen des Profils
               (Moduldaten; Geraet, Eingang, Wirkungsgrad; Speicherdaten,
               Geraetetechnik) als leise Zwischenueberschriften, "Kosten" die
               Kostenfelder aller Gruppen (ModulKatalogProfil.IstKostenfeld), "Alle
               Daten" die Parameteruebersicht. Ein Auslieferungssatz ist nur lesbar,
               und der Kopf sagt es in Worten (V13). *@
            <Stammblatt Name="@Blattname" Unterzeile="@Unterzeile"
                        Auslieferung="@NurLesbar" SchlossText="@Filtertexte.Schloss"
                        Entsperrt="@(!_neu && _schloss.Entsperrt(_fokuszeile))"
                        Kennzahlen="@Kennzahlen" Hinweis="@Aenderungshinweis"
                        ZurListe="@_blattSchliessen"
                        Vergleichskoepfe="@(_auswahl.Vergleich ? _vergleichskoepfe : null)"
                        Vergleichszeilen="@(_auswahl.Vergleich ? _vergleichszeilen : null)"
                        VergleichZurueck="BeiVergleichZurueck"
                        Kosten="@KostenInhalt"
                        Lesemodus="@NurLesbar"
                        KenndatenWerte="@(NurLesbar ? Kenndatenwerte : null)"
                        KostenWerte="@(NurLesbar ? Kostenwerte : null)">
                <Kenndaten>
                    <Formularraster>
                        <KindInhalt>
                            @for (int gruppe = 0; gruppe <= 2; gruppe++)
                            {
                                int g = gruppe;
                                var felder = _felder.Where(f => f.Gruppe == g && !ModulKatalogProfil.IstKostenfeld(f.Schluessel)).ToList();
                                if (felder.Count == 0) { continue; }
                                <Formulargruppe Titel="@Gruppentitel(g)">
                                    <KindInhalt>
                                        @foreach (ModulFeldwert feld in felder)
                                        {
                                            @Feldmarkup(feld)
                                        }
                                    </KindInhalt>
                                </Formulargruppe>
                            }
                        </KindInhalt>
                    </Formularraster>
                </Kenndaten>
                <AlleDaten>
                    @* ALLE PARAMETER UND IHRE VERWENDUNG (W14a-E-8) - zugeklappt; ohne
                       den Delegaten gibt es den Aufklapper nicht. *@
                    @if (Uebersicht is not null)
                    {
                        <Parameteruebersicht Zeilen="@_uebersicht" Beschriftung="@Resource.ADM_SB_ALLE_DATEN" />
                    }
                </AlleDaten>
                <Nachsatz>
                    @* H13: der Weg in die Wikirubrik "Berechnung" - Modul und
                       Wechselrichter fuehren auf dieselbe Seite "Photovoltaik". *@
                    <div class="epos-berechnungshilfe">
                        <InfoKnopf Schluessel="@Profil.BerechnungsSchluessel"
                                   StandardKurztext="@Profil.BerechnungsKurztext" />
                    </div>
                </Nachsatz>
            </Stammblatt>
        </Blatt>
    </Katalograhmen>

    @* DIE FUSSLEISTE DER VERWALTUNG (V15, Stufe 3): Speichern - Verwerfen -
       Fueller (Statuszeile) - Neu... - Beenden. Duplizieren... und Loeschen
       stehen in der Auswahlleiste (V8). "Speichern" eines Auslieferungssatzes ist
       weich gesperrt und nennt den Grund (AD-Q11). *@
    <div class="epos-leiste">
        @if (SpeichernWeichGesperrt)
        {
            <button type="button" class="epos-knopf" aria-disabled="true"
                    title="@MeldungSpeichernGesperrt"
                    @onclick="BeiSpeichern">@BtnSpeichernText</button>
        }
        else
        {
            <button type="button" class="epos-knopf" disabled="@(_gewaehlt.Length == 0 && !_neu)"
                    @onclick="BeiSpeichern">@BtnSpeichernText</button>
        }
        <button type="button" class="epos-knopf" disabled="@(!Ungespeichert)"
                @onclick="BeiVerwerfen">@BtnVerwerfenText</button>
        <span class="epos-leiste-fueller epos-status@(_statusFehler ? " epos-status--fehler" : "")" role="status">@_status</span>
        <button type="button" class="epos-knopf" @onclick="BeiNeu">@BtnNeuText</button>
        @* "IMPORT..." (Konzept 7.1 d, Zweitweg zu V14): der Herstellerimport - CEC,
           PAN/OND bzw. der Stromspeicherimport - als Ueberlagerung. *@
        @if (Wege.ModulImportGaben is not null || Wege.KatalogImportGaben is not null)
        {
            <button type="button" class="epos-knopf epos-importknopf"
                    @onclick="ImportOeffnen">@BtnImportText</button>
        }
        <button type="button" class="epos-knopf epos-knopf--primaer"
                @onclick="BeiBeenden">@BtnBeendenText</button>
    </div>

    @* --- "Import..." als Ueberlagerung (7.1 d): Titel und Kreuz traegt der
           Importdialog selbst - waehrend eines Laufs steht es nicht. *@
    <EPOS.UI.Dialoge.Import.ImportUeberlagerung KatalogGaben="@_katalogImportGaben"
                                                ModulGaben="@_modulImportGaben"
                                                Geschlossen="ImportFertig" />

    <Rueckfrage Offen="@_loeschfrage" TitelText="@TitelLoeschen" Frage="@_loeschtext"
                JaText="@JaText" NeinText="@NeinText" Beantwortet="BeiLoeschAntwort" />

    @* --- Rueckfrage vor dem Umschalten des Schlosses (AD-Q15, Vorgabe Nein) *@
    <Rueckfrage Offen="@_schloss.FrageOffen" TitelText="@_schloss.Titel" Frage="@_schloss.Frage"
                VorgabeNein="true" JaText="@JaText" NeinText="@NeinText" Beantwortet="BeiSchlossAntwort" />

    @* --- Namensabfrage von „Neu…" ---------------------------------------- *@
    <Ueberlagerung Offen="@_namensfrage" Titel="@BtnNeuText"
                   Geschlossen="() => _namensfrage = false">
        <KindInhalt>
            <NamensDialog TitelText="" FrageText="@Profil.Listenbeschriftung"
                          MeldungLeer="@MeldungNameFehlt"
                          OkText="@OkText" AbbrechenText="@AbbrechenText"
                          Geschlossen="BeiNamensfrage" />
        </KindInhalt>
    </Ueberlagerung>

    @* --- Namensabfrage von „Duplizieren…" (AD-Q11) ------------------------ *@
    <Ueberlagerung Offen="@_duplizierfrage" Titel="@BtnDuplizierenText"
                   Geschlossen="() => _duplizierfrage = false">
        <KindInhalt>
            @if (_duplizierfrage)
            {
                <NamensDialog TitelText="" FrageText="@Profil.Listenbeschriftung"
                              Vorbelegung="@_kopievorschlag"
                              MeldungLeer="@MeldungNameFehlt" Pruefung="NameBelegt"
                              OkText="@OkText" AbbrechenText="@AbbrechenText"
                              Geschlossen="BeiDuplizierName" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    // =====================================================================
    // Die Auspraegung
    // =====================================================================

    /// <summary>Welcher der beiden Kataloge (Vorgabe: Stromspeicher).</summary>
    [Parameter] public ModulKatalogArt Art { get; set; } = ModulKatalogArt.Stromspeicher;

    /// <summary>
    /// Das Profil zur <see cref="Art"/>. Die Huelle reicht es fertig uebersetzt herein;
    /// ohne sie baut die Komponente es selbst (dann tragen die Texte die Schluessel).
    /// </summary>
    [Parameter] public ModulKatalogProfil? ProfilVorgabe { get; set; }

    private ModulKatalogProfil Profil => ProfilVorgabe ?? _profil!;
    private ModulKatalogProfil? _profil;

    /// <summary>Die Datenwege der Huelle.</summary>
    [Parameter] public ModulKatalogWege Wege { get; set; } = new();

    /// <summary>
    /// <b>Alle Parameter des gewaehlten Moduls samt ihrer Verwendung</b>
    /// (Anwenderwunsch W14a-E-8) — der Weg zu
    /// <c>ParameterUebersichtCtrl.Werte(art, bezeichner)</c>. Ohne ihn zeigt der
    /// Dialog keinen Aufklapper.
    /// </summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Uebersicht { get; set; }

    /// <summary>
    /// Der Katalog ist zu. <c>Bestaetigt</c> ist immer <c>true</c>: „Beenden", das Kreuz
    /// und Esc sind EIN Weg (V15).
    /// </summary>
    [Parameter] public EventCallback<ModulErgebnis> Geschlossen { get; set; }

    // --- Texte -----------------------------------------------------------

    [Parameter] public string BtnNeuText { get; set; } = "Neu...";
    [Parameter] public string BtnLoeschenText { get; set; } = "Löschen";
    [Parameter] public string BtnSpeichernText { get; set; } = "Speichern";
    [Parameter] public string BtnBeendenText { get; set; } = Resource.ADM_BTN_BEENDEN;

    /// <summary>„Verwerfen" — nimmt geänderte Felder und einen ungespeicherten neuen Satz zurück.</summary>
    [Parameter] public string BtnVerwerfenText { get; set; } = Resource.ADM_BTN_VERWERFEN;

    /// <summary>„Duplizieren…" (AD-Q11).</summary>
    [Parameter] public string BtnDuplizierenText { get; set; } = Resource.ADM_BTN_DUPLIZIEREN;

    /// <summary>Der Grund am weich gesperrten „Speichern" eines Auslieferungssatzes (AD-Q11).</summary>
    [Parameter] public string MeldungSpeichernGesperrt { get; set; } = Resource.ADM_SPEICHERN_GESPERRT;

    /// <summary>„Speichern oder Verwerfen" (V11).</summary>
    [Parameter] public string MeldungUngespeichert { get; set; } = Resource.ADM_MSG_UNGESPEICHERT;

    /// <summary>Die Statuszeile nach „Duplizieren…"; <c>{0}</c> = Original, <c>{1}</c> = Kopie.</summary>
    [Parameter] public string MeldungDupliziert { get; set; } = Resource.ADM_MSG_DUPLIZIERT;

    /// <summary>Meldung, wenn der Name der Kopie schon vergeben ist.</summary>
    [Parameter] public string MeldungNameBelegt { get; set; } = Resource.PSP_MELDUNG_NAME_EXISTIERT;
    [Parameter] public string OkText { get; set; } = "OK";
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";
    [Parameter] public string JaText { get; set; } = "Ja";
    [Parameter] public string NeinText { get; set; } = "Nein";
    [Parameter] public string SpalteWahlText { get; set; } = "Wahl";

    /// <summary>
    /// Die Beschriftungen der Katalogliste (Suche, Trefferzahl, „Filter zurücksetzen",
    /// „Kein Treffer.", Trichter) — EIN Bündel. Sie füllen sich selbst aus
    /// <c>MyResource</c>.
    /// </summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>
    /// <b>Ein eigener Filterstand statt des Registers</b> — dasselbe Muster wie
    /// <c>ProfilVorgabe</c>. Ohne ihn holt der Dialog seinen Stand aus dem
    /// <c>Katalogfilterregister</c> (S2.5: je Katalog EINER, für die Sitzung,
    /// gemeinsam mit den anderen Dialogen desselben Katalogs). Ein Prüfstand gibt
    /// hier seinen eigenen herein und bleibt damit von den anderen Fällen getrennt;
    /// dass das Register wirklich teilt, prüft <c>KatalogfilterstandTests</c>.
    /// </summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }


    /// <summary>Rückfrage vor dem Löschen; <c>{0}</c> nimmt den Bezeichner auf.</summary>
    [Parameter] public string FrageLoeschen { get; set; } = "Soll {0} wirklich gelöscht werden ?";
    [Parameter] public string TitelLoeschen { get; set; } = "Löschen";

    /// <summary>Meldung, wenn die Namensabfrage ohne Namen bestätigt wird.</summary>
    [Parameter] public string MeldungNameFehlt { get; set; } = "Bitte einen gültigen Bezeichner eingeben!";

    /// <summary>Meldung bei ungültiger oder fehlender Zahl; <c>{0}</c> = Feldname.</summary>
    [Parameter] public string MeldungZahlUngueltig { get; set; } =
        "Bitte für \"{0}\" eine Zahl eingeben (Dezimaltrennzeichen Komma oder Punkt).";

    /// <summary>
    /// Meldung, wenn ein PFLICHTfeld leer ist. Der Vorläufer meldete beim Stromspeicher
    /// „Eingaben überprüfen!" für den Typ und den Feldnamen für die fünf Zahlen.
    /// </summary>
    [Parameter] public string MeldungFeldLeer { get; set; } = "Bitte \"{0}\" ausfüllen.";

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private IReadOnlyList<Katalogfilterzeile> _zeilen = Array.Empty<Katalogfilterzeile>();

    /// <summary>
    /// Der Filterzustand — er gehört dem WIRT und nicht dem Popover (offener Punkt
    /// O‑6): Der <c>@key</c>-Fix W6‑B‑2 baut das Raster beim Filtern neu auf.
    ///
    /// <para><b>Seit S2.5 kommt er aus dem <see cref="Katalogfilterregister"/></b>
    /// (Frage Q2 = Sitzung, je Katalog, gemeinsam für Verwaltung und
    /// Projektdialog).</para>
    /// </summary>
    private Katalogfilterstand _filterstand = new();

    private List<ModulFeldwert> _felder = new();
    private IReadOnlyList<Parameterwert> _uebersicht = Array.Empty<Parameterwert>();
    private string _gewaehlt = "";

    /// <summary>Der Bezeichner, unter dem der Satz zuletzt geladen wurde — WHERE-Schlüssel.</summary>
    private string _schluessel = "";

    /// <summary><c>true</c> nach „Neu…" (Bestandsfeld <c>m_Neu</c>).</summary>
    private bool _neu;

    private string _meldung = "";
    private WarnStufe _meldungStufe = WarnStufe.Warnung;

    /// <summary>Die Statuszeile der Fußleiste — was gelang (V11).</summary>
    /// <summary>
    /// Die Statuszeile der Fußleiste. Jede Zuweisung ist eine Erfolgs- oder neutrale
    /// Meldung und nimmt die rote Färbung zurück; rot färbt allein
    /// <see cref="SpeichernAbgelehnt"/>.
    /// </summary>
    private string _status
    {
        get => _statusText;
        set { _statusText = value; _statusFehler = false; }
    }
    private string _statusText = "";

    /// <summary>Ist die Statuszeile ein abgelehntes Speichern? Dann steht sie rot.</summary>
    private bool _statusFehler;

    private bool _loeschfrage;
    private string _loeschtext = "";
    private bool _namensfrage;

    private bool _duplizierfrage;
    private string _kopievorschlag = "";

    /// <summary>Ein Feld des geladenen Satzes wurde geändert (V11).</summary>
    private bool _geaendert;

    /// <summary>Ist der geladene Satz ein Auslieferungssatz (ReadOnly)?</summary>
    private bool _auslieferung;

    private readonly List<string> _fehlerhaft = new();

    /// <summary>Die Zeilen der Liste (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<Katalogfilterzeile> Zeilen => _zeilen;

    /// <summary>Der Filterzustand der Liste (Prüfhilfe für Tests).</summary>
    public Katalogfilterstand Filterstand => _filterstand;

    /// <summary>Der gewählte Bezeichner (Prüfhilfe für Tests).</summary>
    public string Gewaehlt => _gewaehlt;

    /// <summary>Der Feldsatz des geladenen Satzes (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<ModulFeldwert> Felder => _felder;

    /// <summary>Die aktuelle Meldung (Prüfhilfe für Tests).</summary>
    public string Meldung => _meldung;

    /// <summary>Steht die Löschrückfrage? (Prüfhilfe für Tests.)</summary>
    public bool Loeschfrage => _loeschfrage;

    /// <summary>Steht die Namensabfrage? (Prüfhilfe für Tests.)</summary>
    public bool Namensfrage => _namensfrage;

    /// <summary>Ist ein neuer, noch nicht geschriebener Satz in Arbeit? (Prüfhilfe.)</summary>
    public bool IstNeu => _neu;

    /// <summary>Die Statuszeile der Fußleiste (Prüfhilfe für Tests).</summary>
    public string Status => _status;

    /// <summary>Ist der gewählte Satz ein Auslieferungssatz? (Prüfhilfe für Tests.)</summary>
    public bool Auslieferungssatz => _auslieferung;

    /// <summary>Steht die Namensabfrage von „Duplizieren…"? (Prüfhilfe für Tests.)</summary>
    public bool Duplizierfrage => _duplizierfrage;

    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe für Tests.)</summary>
    public bool Schlossfrage => _schloss.FrageOffen;

    /// <summary>
    /// Trägt die Maske etwas, das noch nicht geschrieben ist — ein geändertes Feld oder
    /// einen neuen Satz? Dann halten Zeilenwechsel und Beenden an (V11).
    /// </summary>
    private bool Ungespeichert => _geaendert || _neu;

    /// <summary>„Speichern" eines Auslieferungssatzes ist weich gesperrt (AD-Q11).</summary>
    private bool SpeichernWeichGesperrt => !_neu && _auslieferung && _gewaehlt.Length > 0;

    private bool DuplizierenErlaubt => !_neu && _auswahl.Ziele(_gewaehlt).Count == 1
                                    && Wege.Duplizieren is not null;

    // =====================================================================
    // Stufe 3: Auswahlleiste, Stammblatt, Vergleich (V3 V6 V8 V9 V12 V13)
    // =====================================================================

    private readonly Zeilenauswahl _auswahl = new();
    private Katalogfilterzeile? _fokuszeile;
    private HashSet<string> _geschuetzt = new(StringComparer.Ordinal);
    private IReadOnlyList<string>? _vergleichskoepfe;
    private IReadOnlyList<Vergleichszeile>? _vergleichszeilen;
    private List<string> _loeschziele = new();
    private int _loeschBleiben;
    private string _duplizierQuelle = "";

    private EventCallback _vergleichen;
    private EventCallback _duplizieren;
    private EventCallback _schlossHandlung;
    private EventCallback _loeschen;

    /// <summary>„Schloss setzen…" / „Schloss aufheben…" (AD-Q15) — Rückfrage und die in dieser Sitzung entsperrten Sätze.</summary>
    private readonly Schlossumschaltung _schloss = new();
    private EventCallback _blattOeffnen;
    private EventCallback _blattSchliessen;

    private const string HERKUNFT = "__HERKUNFT";

    /// <summary>Die über das Kästchen gewählten Zeilen (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<string> Kaestchen => _auswahl.Gewaehlte;

    /// <summary>Zeigt das Stammblatt den Vergleich? (Prüfhilfe für Tests.)</summary>
    public bool Vergleicht => _auswahl.Vergleich && _vergleichszeilen is not null;

    /// <summary>Die Zeilen des Vergleichs (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<Vergleichszeile> Vergleichszeilen
        => _vergleichszeilen ?? Array.Empty<Vergleichszeile>();

    /// <summary>Die Überschrift einer Feldgruppe des Profils in den Kenndaten.</summary>
    private string Gruppentitel(int gruppe) => gruppe switch
    {
        0 => Profil.GruppeBestand,
        1 => Profil.GruppeZwei,
        _ => Profil.GruppeDrei
    };

    /// <summary>Der Name im Kopf des Stammblatts — bei „Neu…" der Bezeichner des neuen Satzes.</summary>
    private string Blattname
    {
        get
        {
            if (!_neu) return _gewaehlt;
            string name = _felder.FirstOrDefault(f => f.Schluessel == ModulKatalogProfil.FeldBezeichner)?.Wert ?? "";
            return name.Length > 0 ? name : BtnNeuText;
        }
    }

    private string Unterzeile => Stammblattkopf.Unterzeile(
        Profil.Filterprofil, _neu ? null : _fokuszeile,
        NurLesbar ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ);

    private IReadOnlyList<Stammblattkennzahl> Kennzahlen
        => _neu ? Array.Empty<Stammblattkennzahl>() : Stammblattkopf.Kennzahlen(Profil.Filterprofil, _fokuszeile);

    private string Aenderungshinweis => Ungespeichert ? Resource.ADM_SB_GEAENDERT_OFFEN : "";

    private EventCallback BlattOeffnenWeg => _auswahl.BlattOffen ? default : _blattOeffnen;

    /// <summary>Die Gruppe „Kosten" — nur, wo der Satz Kostenfelder führt.</summary>
    /// <summary>
    /// <b>Die Kenndaten im Lesemodus</b> (V13, Stufe 4): Ein Auslieferungssatz zeigt seine
    /// Felder als TEXT statt als gesperrte Eingaben — je Gruppe des Profils mit ihrer
    /// Zwischenüberschrift, eine Klappliste mit dem Text ihrer Option.
    /// </summary>
    private IReadOnlyList<Stammblattwert> Kenndatenwerte
    {
        get
        {
            var liste = new List<Stammblattwert>();
            for (int g = 0; g <= 2; g++)
            {
                var felder = _felder.Where(f => f.Gruppe == g && !ModulKatalogProfil.IstKostenfeld(f.Schluessel)).ToList();
                if (felder.Count == 0) continue;
                string titel = Gruppentitel(g);
                if (titel.Length > 0) liste.Add(Stammblattwert.Abschnitt(titel));
                liste.AddRange(felder.Select(Lesewert));
            }
            return liste;
        }
    }

    /// <summary>Die Kostenfelder im Lesemodus (V13).</summary>
    private IReadOnlyList<Stammblattwert> Kostenwerte
        => _felder.Where(f => ModulKatalogProfil.IstKostenfeld(f.Schluessel)).Select(Lesewert).ToList();

    /// <summary>Ein Feld als Wert: die Klappliste mit dem Text ihrer Option.</summary>
    private static Stammblattwert Lesewert(ModulFeldwert feld)
    {
        string wert = feld.Wert ?? "";
        if (feld.Art == BrowserFeldArt.Auswahl)
        {
            foreach ((string w, string text) in feld.Optionen)
                if (string.Equals(w, wert, StringComparison.Ordinal)) { wert = text; break; }
        }
        return new Stammblattwert(feld.Bezeichnung, wert, feld.Einheit);
    }

    private RenderFragment? KostenInhalt
    {
        get
        {
            var kosten = _felder.Where(f => ModulKatalogProfil.IstKostenfeld(f.Schluessel)).ToList();
            if (kosten.Count == 0) return null;
            return @<Formularraster>
                        <KindInhalt>
                            @foreach (ModulFeldwert feld in kosten)
                            {
                                @Feldmarkup(feld)
                            }
                        </KindInhalt>
                    </Formularraster>;
        }
    }

    /// <summary>
    /// <b>Die Handlungen der Auswahlleiste</b> (V8) — dieselben drei wie in der
    /// Verwaltung Heizkessel.
    /// </summary>
    private IReadOnlyList<Auswahlhandlung> Handlungen()
    {
        var liste = new List<Auswahlhandlung>(3)
        {
            new(Filtertexte.Vergleichen, _vergleichen)
            {
                Mindestens = 2,
                ZahlGrund = Resource.ADM_AW_VERGLEICHEN_GRUND,
                Gedrueckt = _auswahl.Vergleich
            }
        };
        if (Wege.Duplizieren is not null)
            liste.Add(new(BtnDuplizierenText, _duplizieren)
            {
                Hoechstens = 1,
                ZahlGrund = Resource.ADM_AW_DUPLIZIEREN_GRUND
            });
        // AD-Q15: die Beschriftung folgt der Auswahl.
        if (_schloss.Handlung(Wege.Schloss, _schlossHandlung, SchlossZiele, false) is { } schloss)
            liste.Add(schloss);
        liste.Add(new(BtnLoeschenText, _loeschen) { Sperrgrund = LoeschSperrgrund });
        return liste;
    }

    private string LoeschSperrgrund
    {
        get
        {
            IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
            if (ziele.Count == 0) return "";
            foreach (string z in ziele)
                if (!_geschuetzt.Contains(z)) return "";
            return Resource.ADM_AW_LOESCHEN_GESPERRT;
        }
    }

    private void BeiKaestchen(IReadOnlyList<string> gewaehlte)
    {
        _auswahl.Setzen(gewaehlte);
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiAufheben()
    {
        _auswahl.Aufheben();
        _vergleichszeilen = null;
    }

    private void BeiVergleichen()
    {
        if (_auswahl.VergleichUmschalten()) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiVergleichZurueck()
    {
        _auswahl.VergleichBeenden();
        _vergleichszeilen = null;
    }

    /// <summary>
    /// <b>Der Vergleich über die Felder des Profils</b> (V12) — je gewähltem Satz sein
    /// Feldsatz, ohne den Bezeichner (er steht im Kopf), dazu die Herkunft.
    /// </summary>
    private void VergleichBauen()
    {
        IReadOnlyList<string> namen = _auswahl.Gewaehlte;
        _vergleichskoepfe = namen;

        if (Wege.Detail is null)
        {
            var zeilen = namen.Select(n => _zeilen.FirstOrDefault(x => x.Schluessel == n))
                              .Where(x => x is not null).Select(x => x!).ToList();
            _vergleichszeilen = Vergleichsbau.AusSpalten(Profil.Filterprofil, zeilen);
            return;
        }

        var saetze = new List<IReadOnlyList<Vergleichsfeld>>(namen.Count);
        foreach (string name in namen)
        {
            var felder = new List<Vergleichsfeld>();
            foreach (ModulFeldwert f in Wege.Detail(name) ?? Array.Empty<ModulFeldwert>())
            {
                if (f.Schluessel == ModulKatalogProfil.FeldBezeichner) continue;
                string titel = f.Feldname + (f.Einheit.Length > 0 ? " [" + f.Einheit + "]" : "");
                felder.Add(new Vergleichsfeld(f.Schluessel, titel, Anzeigewert(f)));
            }
            felder.Add(new Vergleichsfeld(HERKUNFT, Resource.ADM_VG_HERKUNFT,
                _geschuetzt.Contains(name) ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ));
            saetze.Add(felder);
        }
        _vergleichszeilen = Vergleichsbau.AusFeldern(saetze);
    }

    /// <summary>Der Anzeigewert eines Feldes — bei einer Auswahl der Text der Option.</summary>
    private static string Anzeigewert(ModulFeldwert f)
    {
        if (f.Art != BrowserFeldArt.Auswahl) return f.Wert;
        foreach (var o in f.Optionen)
            if (string.Equals(o.Wert, f.Wert ?? "", StringComparison.Ordinal)) return o.Text;
        return f.Wert;
    }

    protected override void OnParametersSet()
    {
        if (ProfilVorgabe is null && (_profil is null || _profil.Art != Art))
            _profil = ModulKatalogProfil.Finde(Art);

        // Der Kopf der WAHLSPALTE kommt weiter über den eigenen Text der Hülle
        // (KFAK_SP_WAHL) — dasselbe Wort in allen neun Katalogdialogen.
        Filtertexte.SpalteWahl = SpalteWahlText;

        // Das Schloss nennt den Ausweg, wo es ihn gibt (V10, AD-Q11).
        Filtertexte.Schloss = Wege.Duplizieren is not null
            ? Resource.ADM_SCHLOSS_DUPLIZIEREN
            : Resource.ADM_SCHLOSS;
    }

    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _duplizieren = EventCallback.Factory.Create(this, BeiDuplizieren);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _loeschen = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        if (ProfilVorgabe is null) _profil = ModulKatalogProfil.Finde(Art);
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Profil.Filterprofil.Art);
        ListeAufbauen();

        // KI-F5: DREI Katalogschluessel auf EINER Komponente - welcher gilt, sagt die
        // Auspraegung. Das Wahlfeld der Zelltechnologie loest die Bruecke ueber die
        // Begleiteigenschaft TechnologieWahl der Sichtklasse selbst auf.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskenname, () => KiSicht(), KiHaken());
    }

    // =====================================================================
    // Der Hilfe-Assistent (Welle KI-F5)
    // =====================================================================

    private KiMaskenanmeldung? _kiMaske;
    private ModulKatalogKiSicht? _kiSicht;

    /// <summary>
    /// Der Katalogschlüssel dieser Ausprägung — <c>Form_AdminPV</c>,
    /// <c>Form_AdminStromspeicher</c> oder <c>Form_AdminWechselrichter</c>.
    /// </summary>
    /// <remarks>
    /// Gefragt wird <see cref="Profil"/> und nicht <see cref="Art"/>: Eine
    /// <see cref="ProfilVorgabe"/> schlägt den Parameter, und angemeldet gehört die
    /// Maske, die der Anwender vor sich hat.
    /// </remarks>
    private string KiMaskenname => Profil.Art switch
    {
        ModulKatalogArt.Photovoltaik => KiMaskennamen.PV_MODULKATALOG,
        ModulKatalogArt.Wechselrichter => KiMaskennamen.WECHSELRICHTER_KATALOG,
        _ => KiMaskennamen.STROMSPEICHER_KATALOG
    };

    /// <summary>
    /// Die Sicht des Assistenten: je Profilschlüssel eine benannte Eigenschaft über
    /// dem lebenden Feldsatz. Sie wird EINMAL erzeugt und hält nur Delegaten — der
    /// Feldsatz wechselt mit jeder Zeilenwahl, die Sicht nicht.
    /// </summary>
    private ModulKatalogKiSicht KiSicht()
    {
        return _kiSicht ??= new ModulKatalogKiSicht
        {
            Feldsuche = schluessel => _felder.FirstOrDefault(
                f => string.Equals(f.Schluessel, schluessel, StringComparison.Ordinal)),
            Gesetzt = () => { _meldung = ""; _geaendert = true; }
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <para><b>Die Prüfung ist DIESELBE, die der Speicherknopf ruft</b>
    /// (<see cref="EingabenPruefen"/>): erst die ungültigen Texte, dann die
    /// Pflichtfelder des Profils.</para>
    /// <para><b>Der Haken „Schreibgeschützt"</b> trägt den Auslieferungsschutz des
    /// gewählten Satzes (AD-Q11): Solange er steht, lehnt schon <c>feld_setzen</c> ab,
    /// nicht erst der Speicherknopf — dieselbe Regel wie in der Wärmepumpenverwaltung.
    /// Gesperrt bleiben daneben einzelne FELDER (Bezeichner, Herkunft).</para>
    /// <para><b>„Löschen" bleibt draußen.</b> Es entfernt einen Katalogsatz ohne
    /// Umweg und ist damit eine Aktion mit Rückfrage und Sicherungspunkt, kein
    /// Speicherweg.</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => SpeichernWeichGesperrt,
        Pruefen = () => EingabenPruefen() ? "" : _meldung,
        Speichern = KiSpeichern
    };

    private Task<KiErgebnis> KiSpeichern()
    {
        if (Wege.Speichern is null)
            return Task.FromResult(KiErgebnis.Abgelehnt(
                Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", Profil.Titel)));

        if (_gewaehlt.Length == 0 && !_neu)
            return Task.FromResult(KiErgebnis.Abgelehnt(Profil.MeldungOhneAuswahl));

        if (SpeichernWeichGesperrt)
            return Task.FromResult(KiErgebnis.Abgelehnt(MeldungSpeichernGesperrt));

        if (!EingabenPruefen())
            return Task.FromResult(KiErgebnis.Abgelehnt(_meldung));

        KatalogSpeicherErgebnis ergebnis = Schreiben();
        return Task.FromResult(ergebnis.Ok
            ? KiErgebnis.Ok(ergebnis.Meldung, anzahl: 1)
            : KiErgebnis.Fehlgeschlagen(ergebnis.Meldung));
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =====================================================================
    // Liste und Felder
    // =====================================================================

    /// <summary>
    /// Baut die Liste neu. Beim Öffnen steht die erste Zeile — wortgleich
    /// <c>Form_Stromspeicher_Load</c> (Z. 86-89) und <c>Form_AdminPV_Load</c> (Z. 55).
    /// </summary>
    private void ListeAufbauen()
    {
        _zeilen = Wege.Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();

        _geschuetzt = new HashSet<string>(_zeilen.Where(z => z.Geschuetzt).Select(z => z.Bezeichner),
                                          StringComparer.Ordinal);

        // Kaestchen verschwundener Zeilen fallen (V6); ein laufender Vergleich liest neu.
        _auswahl.Abgleichen(_zeilen.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        if (_gewaehlt.Length > 0 && _zeilen.Any(z => z.Bezeichner == _gewaehlt))
        {
            _fokuszeile = _zeilen.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
            return;
        }

        _gewaehlt = _zeilen.Count > 0 ? _zeilen[0].Bezeichner : "";
        DetailLaden();
    }

    private void DetailLaden()
    {
        _fehlerhaft.Clear();
        _neu = false;
        _geaendert = false;
        _schluessel = _gewaehlt;

        // Der Schutz kommt aus der Zeile der Liste (ReadOnly der Stammtabelle) - bis
        // hierher wertete diese Maske ihn nicht aus (Konzept V13, AD-Q11). Dieselbe
        // Zeile gibt dem Stammblatt Herkunft und Kennzahlen (V9).
        _fokuszeile = _gewaehlt.Length > 0 ? _zeilen.FirstOrDefault(z => z.Bezeichner == _gewaehlt) : null;
        _auslieferung = _fokuszeile?.Geschuetzt == true;

        // Auch ohne Auswahl (W14a-E-8): Was es an Parametern GIBT, haengt am Katalog
        // und nicht am Satz — dann stehen lauter Leerwerte darin.
        _uebersicht = Uebersicht?.Invoke(_gewaehlt) ?? Array.Empty<Parameterwert>();

        if (_gewaehlt.Length == 0) { _felder = new List<ModulFeldwert>(); return; }
        _felder = (Wege.Detail?.Invoke(_gewaehlt) ?? Array.Empty<ModulFeldwert>()).ToList();
    }

    /// <summary>
    /// Eine andere Zeile. Geänderte Felder oder ein ungespeicherter neuer Satz halten
    /// die Wahl fest (V11) — die Liste springt zurück, das Warnband sagt warum.
    /// </summary>
    private void BeiZeile(string bezeichner)
    {
        string neu = bezeichner ?? "";
        if (neu == _gewaehlt && !_neu) return;

        if (Ungespeichert)
        {
            Warnen(MeldungUngespeichert);
            return;
        }

        _gewaehlt = neu;
        _meldung = "";
        _status = "";
        DetailLaden();
    }

    private void Warnen(string text)
    {
        _meldung = text ?? "";
        _meldungStufe = WarnStufe.Warnung;
    }

    /// <summary>
    /// Ein Speichern ist abgelehnt (Sperre, Prüfregel, Schreibfehler): Der Grund steht im
    /// Warnband oben UND rot in der Statuszeile neben dem Knopf — das Band ist bei einer
    /// langen Liste nicht im Blick.
    /// </summary>
    private void SpeichernAbgelehnt(string grund)
    {
        Warnen(grund);
        _status = grund ?? "";
        _statusFehler = true;
    }

    /// <summary>
    /// „Verwerfen": Die Felder des gewählten Satzes kommen neu aus dem Katalog; ein
    /// neuer, noch nicht gespeicherter Satz fällt weg, und die erste Zeile steht wieder.
    /// </summary>
    private void BeiVerwerfen()
    {
        if (!Ungespeichert) return;
        _meldung = "";
        if (_neu)
        {
            _neu = false;
            _gewaehlt = "";
            ListeAufbauen();
            return;
        }
        DetailLaden();
    }

    private static double? Zahl(ModulFeldwert feld) =>
        Zahlen.ZahlParsen(feld.Wert, out double d) ? d : null;

    private static int? Ganzzahl(ModulFeldwert feld) =>
        Zahlen.GanzzahlParsen(feld.Wert, out int i) ? i : null;

    private void TextSetzen(ModulFeldwert feld, string wert)
    {
        if (feld.Gesperrt || NurLesbar) return;
        feld.Wert = wert;
        Geaendert();
    }

    private void ZahlSetzen(ModulFeldwert feld, double? wert)
    {
        if (NurLesbar) return;
        feld.Wert = wert?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "";
        Geaendert();
    }

    private void GanzzahlSetzen(ModulFeldwert feld, int? wert)
    {
        if (NurLesbar) return;
        feld.Wert = wert?.ToString(System.Globalization.CultureInfo.CurrentCulture) ?? "";
        Geaendert();
    }

    /// <summary>Ein Feld hat sich geändert — Warnband und Statuszeile sind damit überholt.</summary>
    private void Geaendert()
    {
        _geaendert = true;
        _meldung = "";
        _status = "";
    }

    /// <summary>
    /// Stehen die Felder nur zum Lesen da? Bei einem Auslieferungssatz (AD-Q11) —
    /// geändert wird die eigene Kopie, die „Duplizieren…" anlegt.
    /// </summary>
    private bool NurLesbar => !_neu && _auslieferung;

    private void BeiFehlerZustand((string Feld, bool Fehlerhaft) meldung)
    {
        if (meldung.Fehlerhaft)
        {
            if (!_fehlerhaft.Contains(meldung.Feld)) _fehlerhaft.Add(meldung.Feld);
            _geaendert = true;
        }
        else
        {
            _fehlerhaft.Remove(meldung.Feld);
        }
    }

    /// <summary>
    /// Die Prüfkette der beiden Speicherknöpfe: erst die ungültigen Texte, dann die
    /// PFLICHTfelder. Die <c>leerErlaubt</c>-Regel steht je Feld im Profil und ist
    /// bitgleich aus dem Bestand übernommen — beim Stromspeicher darf KEINES der fünf
    /// Bestandsfelder leer sein, bei der Photovoltaik nur die Nennleistung nicht.
    /// </summary>
    private bool EingabenPruefen()
    {
        if (_fehlerhaft.Count > 0)
        {
            _meldung = string.Format(MeldungZahlUngueltig, _fehlerhaft[0]);
            _meldungStufe = WarnStufe.Warnung;
            return false;
        }

        foreach (ModulFeldwert feld in _felder)
        {
            if (feld.LeerErlaubt || feld.Gesperrt) continue;
            if (feld.Wert.Trim().Length > 0) continue;

            _meldung = string.Format(MeldungFeldLeer, feld.Feldname);
            _meldungStufe = WarnStufe.Warnung;
            return false;
        }
        return true;
    }

    // =====================================================================
    // Die vier Knoepfe
    // =====================================================================

    /// <summary>
    /// „Speichern". Ein Auslieferungssatz wird nie überschrieben (AD-Q11): Der Knopf ist
    /// weich gesperrt, ein Klick nennt den Weg über „Duplizieren…".
    /// </summary>
    private void BeiSpeichern()
    {
        if (SpeichernWeichGesperrt)
        {
            SpeichernAbgelehnt(MeldungSpeichernGesperrt);
            return;
        }

        if (Wege.Speichern is null) return;
        if (_gewaehlt.Length == 0 && !_neu) return;
        if (!EingabenPruefen()) { SpeichernAbgelehnt(_meldung); return; }

        // Ein Fehlschlag steht im Warnband UND rot neben dem Knopf.
        KatalogSpeicherErgebnis ergebnis = Schreiben();
        if (!ergebnis.Ok) SpeichernAbgelehnt(ergebnis.Meldung);
    }

    /// <summary>
    /// Der reine SCHREIBVORGANG samt Nachlauf — ohne die drei Wachen davor.
    /// </summary>
    /// <remarks>
    /// Er steht für sich, weil ihn zwei Wege rufen: der Speicherknopf und
    /// <c>dialog_speichern</c> des Assistenten (Welle KI‑F5). Beide prüfen vorher
    /// dasselbe; nur der Assistent BENENNT, woran es lag.
    /// </remarks>
    private KatalogSpeicherErgebnis Schreiben()
    {
        KatalogSpeicherErgebnis ergebnis = Wege.Speichern!(_felder, _neu, _schluessel);

        if (!ergebnis.Ok)
        {
            _meldung = ergebnis.Meldung;
            _meldungStufe = WarnStufe.Warnung;
            return ergebnis;
        }

        // Gelungen - die Statuszeile sagt es, das Warnband ist frei (V11).
        _meldung = "";
        _status = ergebnis.Meldung;
        _neu = false;
        _geaendert = false;
        _gewaehlt = ergebnis.Name;
        _schluessel = ergebnis.Name;
        ListeAufbauen();
        return ergebnis;
    }

    private void BeiNeu()
    {
        if (Ungespeichert) { Warnen(MeldungUngespeichert); return; }
        _meldung = "";
        _namensfrage = true;
    }

    // =====================================================================
    // „Duplizieren…" (Entscheid AD-Q11)
    // =====================================================================

    /// <summary>
    /// „Duplizieren…": Namensabfrage, vorbelegt mit „Name (Kopie)" (der erste freie),
    /// dann der eigene Satz mit allen Werten des gewählten. Ungespeichertes hält es auf.
    /// </summary>
    private void BeiDuplizieren()
    {
        if (!DuplizierenErlaubt) return;
        if (Ungespeichert) { Warnen(MeldungUngespeichert); return; }

        // Kopiert wird die EINE Zielzeile: die gewaehlte, sonst die Fokuszeile (V8).
        _duplizierQuelle = _auswahl.Ziele(_gewaehlt)[0];
        _meldung = "";
        _kopievorschlag = Katalogkopie.Namensvorschlag(_duplizierQuelle, NameVergeben);
        _duplizierfrage = true;
    }

    private bool NameVergeben(string name) => _zeilen.Any(z => z.Bezeichner == name);

    private string? NameBelegt(string name) => NameVergeben(name) ? MeldungNameBelegt : null;

    private void BeiDuplizierName(string? name)
    {
        _duplizierfrage = false;
        if (name is null || Wege.Duplizieren is null) return;

        Katalogfilterzeile? zeile = _zeilen.FirstOrDefault(z => z.Bezeichner == _duplizierQuelle);
        if (zeile is null) return;

        string alt = _duplizierQuelle;
        KatalogSpeicherErgebnis ergebnis = Wege.Duplizieren(zeile.Id, name);
        if (!ergebnis.Ok)
        {
            Warnen(ergebnis.Meldung);
            return;
        }

        // Die Kopie ist gewaehlt, die Kaestchen fallen: Die naechste Handlung gilt ihr.
        _auswahl.Aufheben();
        _vergleichszeilen = null;
        _gewaehlt = ergebnis.Name;
        ListeAufbauen();
        DetailLaden();
        _status = string.Format(MeldungDupliziert, alt, ergebnis.Name);
    }

    // =====================================================================
    // „Schloss setzen…" / „Schloss aufheben…" (Entscheid AD-Q15)
    // =====================================================================

    /// <summary>Die Zeilen, auf die die Auswahlleiste gerade wirkt.</summary>
    private IReadOnlyList<Katalogfilterzeile> SchlossZiele
        => Schlossumschaltung.Zeilen(_auswahl.Ziele(_gewaehlt), _zeilen);

    /// <summary>
    /// Der Klick: Rückfrage in beiden Richtungen, Vorgabe „Nein". Geänderte Felder oder ein
    /// ungespeicherter neuer Satz halten sie auf.
    /// </summary>
    private void BeiSchloss()
    {
        string? grund = _schloss.Fragen(Wege.Schloss, SchlossZiele, Ungespeichert);
        if (grund is not null) { Warnen(grund); return; }
        _meldung = "";
    }

    /// <summary>
    /// Nach dem „Ja": schalten, die Liste neu lesen — Schloss, Lesemodus und Speichern
    /// folgen aus der Fokuszeile —, Erfolg in die Statuszeile.
    /// </summary>
    private void BeiSchlossAntwort(bool? antwort)
    {
        Schlossausgang a = _schloss.Beantwortet(antwort, Wege.Schloss);
        if (!a.Geschrieben)
        {
            if (a.Fehler.Length > 0) Warnen(a.Fehler);
            return;
        }
        ListeAufbauen();
        if (_gewaehlt.Length > 0) DetailLaden();
        _meldung = "";
        _status = a.Status;
    }

    /// <summary>
    /// „Neu…": Namensabfrage, dann die Vorbelegungen aus dem Profil. Beim
    /// Stromspeicher sind darunter die zwei fachlichen Vorgaben
    /// (<c>eta_RT = 0,90</c>, <c>c_ver = 0,025</c>) und die Zelltechnologie aus
    /// <c>DbWerte.SP_TYP_LITHIUM_IONEN</c>.
    /// </summary>
    private void BeiNamensfrage(string? name)
    {
        _namensfrage = false;
        if (name is null) return;

        _neu = true;
        _gewaehlt = "";
        _schluessel = "";
        _fehlerhaft.Clear();

        var liste = new List<ModulFeldwert>();
        foreach (ModulKatalogFeld feld in Profil.Felder)
        {
            liste.Add(new ModulFeldwert
            {
                Schluessel = feld.Schluessel,
                Bezeichnung = feld.Bezeichnung,
                Einheit = feld.Einheit,
                Art = feld.Art,
                LeerErlaubt = feld.LeerErlaubt,
                Gesperrt = feld.Gesperrt,
                Gruppe = feld.Gruppe,
                Optionen = feld.Optionen,
                Wert = feld.Schluessel == ModulKatalogProfil.FeldBezeichner ? name : feld.Vorgabe
            });
        }
        _felder = liste;
    }

    /// <summary>
    /// „Löschen" fragt zurück — <b>Angleichung E-3</b>: Die Photovoltaik war die
    /// EINZIGE der elf Masken, die kommentarlos löschte (Befund W14-B35).
    /// </summary>
    private void BeiLoeschen()
    {
        IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
        if (ziele.Count == 0)
        {
            _meldung = Profil.MeldungOhneAuswahl;
            _meldungStufe = WarnStufe.Warnung;
            return;
        }

        // Stufe 3 (V8, AD-Q9): auf die gewaehlten Zeilen, sonst die Fokuszeile;
        // Auslieferungssaetze bleiben stehen (V13).
        var loeschbar = ziele.Where(z => !_geschuetzt.Contains(z)).ToList();
        var bleiben = ziele.Where(z => _geschuetzt.Contains(z)).ToList();
        if (loeschbar.Count == 0) { Warnen(Resource.ADM_AW_LOESCHEN_GESPERRT); return; }

        _loeschziele = loeschbar;
        _loeschBleiben = bleiben.Count;

        string frage = loeschbar.Count == 1
            ? string.Format(FrageLoeschen, loeschbar[0])
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_FRAGE_MEHR,
                            loeschbar.Count, string.Join(", ", loeschbar));
        if (bleiben.Count > 0)
            frage += " " + string.Format(CultureInfo.CurrentCulture, Resource.ADM_LOESCHEN_BLEIBEN,
                                         string.Join(", ", bleiben));
        _loeschtext = frage;
        _loeschfrage = true;
    }

    /// <summary>
    /// Nach dem „Ja": je Zeile ein benannter Schreibschritt; was der Katalog ablehnt,
    /// nennt seinen Grund im Warnband, die Statuszeile nennt beide Zahlen.
    /// </summary>
    private void BeiLoeschAntwort(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || Wege.Loeschen is null) return;

        int geloescht = 0;
        var gruende = new List<string>();
        foreach (string name in _loeschziele)
        {
            KatalogSpeicherErgebnis ergebnis = Wege.Loeschen(name);
            if (ergebnis.Ok)
            {
                geloescht++;
                if (name == _gewaehlt) _gewaehlt = "";
            }
            else if (!gruende.Contains(ergebnis.Meldung))
            {
                gruende.Add(ergebnis.Meldung);
            }
        }

        int ziele = _loeschziele.Count + _loeschBleiben;
        int blieben = ziele - geloescht;
        _loeschziele = new List<string>();

        if (gruende.Count > 0)
        {
            _meldung = string.Join(" ", gruende);
            _meldungStufe = WarnStufe.Warnung;
        }
        else _meldung = "";

        if (geloescht > 0) ListeAufbauen();

        _status = ziele <= 1 || geloescht == 0 ? ""
                : blieben > 0 ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT_BLEIBEN, geloescht, blieben)
                : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_GELOESCHT, geloescht);
    }

    /// <summary>
    /// <b>„Beenden"</b> — der eine Schlussweg (V15), auch für das Kreuz und Esc.
    /// Ungespeichertes hält ihn auf: „Speichern oder Verwerfen" im Warnband (V11).
    /// </summary>
    private Task BeiBeenden()
    {
        if (Ungespeichert)
        {
            Warnen(MeldungUngespeichert);
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(new ModulErgebnis(true, _gewaehlt));
    }

    // =====================================================================
    // "Import..." (Konzept Administrationsdialoge 7.1 d, Zweitweg zu V14)
    // =====================================================================

    /// <summary>„Import…" — <c>ADM_BTN_IMPORT</c>.</summary>
    [Parameter] public string BtnImportText { get; set; } = Resource.ADM_BTN_IMPORT;

    private IReadOnlyDictionary<string, object>? _modulImportGaben;
    private IReadOnlyDictionary<string, object>? _katalogImportGaben;
    private HashSet<string> _vorImport = new(StringComparer.Ordinal);

    /// <summary>Steht der Import als Überlagerung? (Prüfhilfe für Tests.)</summary>
    public bool ImportOffen => _modulImportGaben is not null || _katalogImportGaben is not null;

    /// <summary>„Import…" öffnet den Herstellerimport; geänderte Felder halten an (Konzept 3.3).</summary>
    private void ImportOeffnen()
    {
        if (Ungespeichert) { Warnen(MeldungUngespeichert); return; }
        _vorImport = new HashSet<string>(_zeilen.Select(z => z.Bezeichner), StringComparer.Ordinal);
        _modulImportGaben = Wege.ModulImportGaben?.Invoke();
        _katalogImportGaben = _modulImportGaben is null ? Wege.KatalogImportGaben?.Invoke() : null;
    }

    /// <summary>
    /// Der Import ist zu. Hat er geschrieben, liest die Liste neu, und die neuen Sätze sind
    /// die Auswahl (V14, 7.1 d): ab zweien über ihre Kästchen („n gewählt"), der erste steht
    /// als Fokuszeile im Stammblatt; die Statuszeile nennt ihre Zahl.
    /// </summary>
    private void ImportFertig(bool geschrieben)
    {
        _modulImportGaben = null;
        _katalogImportGaben = null;
        if (!geschrieben) return;

        ListeAufbauen();
        List<Katalogfilterzeile> neu = _zeilen.Where(z => !_vorImport.Contains(z.Bezeichner)).ToList();
        if (neu.Count == 0) return;

        _auswahl.Uebernommen(neu.Select(z => z.Schluessel));
        _vergleichszeilen = null;
        _gewaehlt = neu[0].Bezeichner;
        DetailLaden();
        _meldung = "";
        _status = neu.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_EINGELESEN, neu[0].Bezeichner)
            : string.Format(CultureInfo.CurrentCulture, Resource.ADM_MSG_IMPORTIERT, neu.Count);
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_namensfrage || _duplizierfrage || _loeschfrage || _schloss.FrageOffen || ImportOffen)
            return Task.CompletedTask;

        // Im schmalen Fenster schliesst Esc zuerst das Blatt (Konzept 3.3).
        if (_auswahl.BlattOffen)
        {
            _auswahl.BlattOffen = false;
            return Task.CompletedTask;
        }
        return BeiBeenden();
    }

    // =====================================================================
    // Das Markup eines Feldes
    // =====================================================================

    private static IReadOnlyList<(int Id, string Text)> AuswahlEintraege(ModulFeldwert feld)
    {
        var liste = new List<(int, string)>();
        for (int i = 0; i < feld.Optionen.Count; i++) liste.Add((i, feld.Optionen[i].Text));
        return liste;
    }

    private static int? AuswahlIndex(ModulFeldwert feld)
    {
        for (int i = 0; i < feld.Optionen.Count; i++)
            if (string.Equals(feld.Optionen[i].Wert, feld.Wert ?? "", StringComparison.Ordinal)) return i;
        return feld.Optionen.Count > 0 ? 0 : null;
    }

    private void AuswahlSetzen(ModulFeldwert feld, int? index)
    {
        if (NurLesbar) return;
        feld.Wert = index.HasValue && index.Value >= 0 && index.Value < feld.Optionen.Count
            ? feld.Optionen[index.Value].Wert : "";
        Geaendert();
    }

    private RenderFragment Feldmarkup(ModulFeldwert feld) => builder =>
    {
        // Ein Auslieferungssatz zeigt jedes Feld nur lesend (AD-Q11).
        bool gesperrt = feld.Gesperrt || NurLesbar;

        if (feld.Art == BrowserFeldArt.Zahl && !gesperrt)
        {
            builder.OpenComponent<Zahlenfeld>(0);
            builder.AddAttribute(1, "Bezeichnung", feld.Bezeichnung);
            builder.AddAttribute(2, "Einheit", feld.Einheit);
            builder.AddAttribute(3, "Feldname", feld.Feldname);
            builder.AddAttribute(4, "Wert", Zahl(feld));
            builder.AddAttribute(5, "WertChanged",
                EventCallback.Factory.Create<double?>(this, w => ZahlSetzen(feld, w)));
            builder.AddAttribute(6, "FehlerZustand",
                EventCallback.Factory.Create<(string, bool)>(this, BeiFehlerZustand));
            builder.CloseComponent();
            return;
        }

        if (feld.Art == BrowserFeldArt.Ganzzahl && !gesperrt)
        {
            builder.OpenComponent<Ganzzahlfeld>(10);
            builder.AddAttribute(11, "Bezeichnung", feld.Bezeichnung);
            builder.AddAttribute(12, "Einheit", feld.Einheit);
            builder.AddAttribute(13, "Feldname", feld.Feldname);
            builder.AddAttribute(14, "Wert", Ganzzahl(feld));
            builder.AddAttribute(15, "WertChanged",
                EventCallback.Factory.Create<int?>(this, w => GanzzahlSetzen(feld, w)));
            builder.AddAttribute(16, "FehlerZustand",
                EventCallback.Factory.Create<(string, bool)>(this, BeiFehlerZustand));
            builder.CloseComponent();
            return;
        }

        if (feld.Art == BrowserFeldArt.Auswahl && !gesperrt)
        {
            // Paket B (Merge 5): die Zelltechnologie - Optionen aus dem Profil, der Wert
            // ist der Datenbankcode (leer = NULL).
            builder.OpenComponent<Auswahlfeld>(30);
            builder.AddAttribute(31, "Bezeichnung", feld.Bezeichnung);
            builder.AddAttribute(32, "Eintraege", AuswahlEintraege(feld));
            builder.AddAttribute(33, "Auswahl", AuswahlIndex(feld));
            builder.AddAttribute(34, "AuswahlChanged",
                EventCallback.Factory.Create<int?>(this, i => AuswahlSetzen(feld, i)));
            builder.CloseComponent();
            return;
        }

        builder.OpenComponent<Textfeld>(20);
        builder.AddAttribute(21, "Bezeichnung", feld.Bezeichnung);
        builder.AddAttribute(22, "Wert", feld.Wert);
        builder.AddAttribute(23, "WertChanged",
            EventCallback.Factory.Create<string>(this, w => TextSetzen(feld, w)));
        builder.AddAttribute(24, "NurLesen", gesperrt);
        builder.AddAttribute(25, "Mehrzeilig", feld.Art == BrowserFeldArt.Mehrzeilig);
        builder.AddAttribute(26, "Zeilen", 2);
        builder.CloseComponent();
    };
}
