600;10;REAL MKWT,KEWIG(4),KB;
600;11;INTEGER STATUS;
600;12;CHARACTER(20) STUFE_IST(4);
600;13;CHARACTER(128) FUNCTION WE_KEWIGRAD(KB,MKWT, KEWIG,STUFE_IST,STATUS);
610;1;CHARACTER(128) FUNCTION WE_KEWIGRAD(KB,KTEMP, KEW,STU_IST,STAT);
610;2;CHARACTER(20)STU_IST(4);
610;3;CHARACTER(128) FTXT;
610;4;INTEGER STAT,IX,I,I70,Ivon,Anzahl;
610;5;REAL KTEMP,KEW(4),KB,KBalt;
610;6;REAL BELAST(10),vonMKWT(10),bisMKWT(10),a0(10),a1(10),a2(10),a3(10);
610;7;LOGICAL OK,B1,B2,B3,GRENZEN;
610;8;FTXT='';
610;9;I70=VdiIndex('700');
610;10;Ivon=VdiIWert('700',I70,'730',1,4);
610;11;B1=Ivon<1;
610;12;if(B1)then;
610;13;FTxT='Keine Daten zur Berechnung des Kesselwirkungsgrades vorhanden';
610;14;else;
610;15;Anzahl=VdiIWert('700',I70,'730',1,5);
610;16;IX=0;
610;17;OK=.TRUE.;
610;18;DO WHILE (OK);
610;19;IX=IX+1;
610;20;BELAST(IX)=VDIRWERT('700',I70,'730',Ivon,5);
610;21;vonMKWT(IX)=VDIRWERT('700',I70,'730',Ivon,6);
610;22;bisMKWT(IX)=VDIRWERT('700',I70,'730',Ivon,7);
610;23;a3(IX)=VDIRWERT('700',I70,'730',Ivon,11);
610;24;a2(IX)=VDIRWERT('700',I70,'730',Ivon,10);
610;25;a1(IX)=VDIRWERT('700',I70,'730',Ivon,9);
610;26;a0(IX)=VDIRWERT('700',I70,'730',Ivon,8);
610;27;Ivon=Ivon+1;
610;28;OK=IX<Anzahl;
610;29;ENDDO;
610;30;I=1;
610;31;STAT=0;
610;32;KBalt=0;
610;33;GRENZEN=KB>0 .AND. KTEMP>15;
610;34;DO WHILE (GRENZEN);
610;35;B2=KB<=BELAST(I) .AND. KTEMP>=vonMKWT(I) .AND. KTEMP <=bisMKWT(I);
610;36;IF(B2)THEN;
610;37;B3=KBalt /= BELAST(I);
610;38;IF(B3) STAT=STAT+1;
610;39;KBalt=BELAST(I);
610;40;KEW(STAT)=a3(I)*KTEMP**3 + a2(I)*KTEMP**2 + a1(I)*KTEMP + a0(I);
610;41;STU_IST(STAT)=VDISTRING('Belastung ### %',BELAST(I));
610;42;ENDIF;
610;43;I=I+1;
610;44;GRENZEN=I <= Anzahl;
610;45;ENDDO;
610;46;OK=STAT==0;
610;47;IF(OK)FTXT='Belastung und/oder mittl. Kesselwassertemperatur ausserhalb der Grenzwerte.';
610;48;endif;
610;49;WE_KEWIGRAD=FTXT;
610;50;END FUNCTION WE_KEWIGRAD;
600;14;REAL KEWIG(4),TV,TR,KB;
600;15;INTEGER STATUS;
600;16;CHARACTER(20) STUFE_IST(4);
600;17;CHARACTER(128) FUNCTION WE_ETA(KB,TV,TR,KEWIG,STUFE_IST,STATUS);
610;1;CHARACTER(128) FUNCTION WE_ETA(KB,TV,TR, KEW,STUFE_IST,STAT);
610;2;CHARACTER(20)STUFE_IST(4);
610;3;CHARACTER(128) FTXT;
610;4;INTEGER STAT,IX,I,I70,Ivon,Anzahl;
610;5;REAL KEW(4), X3(10),X2(10),X1(10),X0(10),KB,TV,TR,vonBELAST(10),bisBELAST(10),TVX(10),TRX(10);
610;6;LOGICAL OK,B1,B2,gefunden;
610;7;I70=VdiIndex('700');
610;8;Ivon=VdiIWert('700',I70,'730',1,6);
610;9;B1=Ivon<1;
610;10;if(B1)then;
610;11;FTxT='Keine Daten zur Berechnung der Kesselbelastung vorhanden';
610;12;else;
610;13;Anzahl=VdiIWert('700',I70,'730',1,7);
610;14;IX=0;
610;15;OK=.TRUE.;
610;16;DO WHILE (OK);
610;17;IX=IX+1;
610;18;TVX(IX)=VDIRWERT('700',I70,'730',Ivon,5);
610;19;TRX(IX)=VDIRWERT('700',I70,'730',Ivon,6);
610;20;vonBELAST(IX)=VDIRWERT('700',I70,'730',Ivon,7);
610;21;bisBELAST(IX)=VDIRWERT('700',I70,'730',Ivon,8);
610;22;X0(IX)=VDIRWERT('700',I70,'730',Ivon,9);
610;23;X1(IX)=VDIRWERT('700',I70,'730',Ivon,10);
610;24;X2(IX)=VDIRWERT('700',I70,'730',Ivon,11);
610;25;X3(IX)=VDIRWERT('700',I70,'730',Ivon,12);
610;26;Ivon=Ivon+1;
610;27;OK=IX<Anzahl;
610;28;ENDDO;
610;29;B1=TV>TR;
610;30;if(B1)then;
610;31;OK=IX>0;
610;32;I=1;
610;33;IF(OK)THEN;
610;34;GEFUNDEN=.TRUE.;
610;35;OK=.FALSE.;
610;36;DO WHILE (GEFUNDEN);
610;37;GEFUNDEN=TV<=TVX(I) .AND. TR>=TRX(I);
610;38;IF(GEFUNDEN)THEN;
610;39;GEFUNDEN=.FALSE.;
610;40;OK=.TRUE.;
610;41;ELSE;
610;42;I=I+1;
610;43;GEFUNDEN=I<=IX;
610;44;ENDIF;
610;45;ENDDO;
610;46;ENDIF;
610;47;IF(OK)THEN;
610;48;FTXT='';
610;49;STAT=1;
610;50;B2=.FALSE.;
610;51;GEFUNDEN=.TRUE.;
610;52;DO WHILE (GEFUNDEN);
610;53;B1=KB>=vonBELAST(I) .AND. KB<=bisBELAST(I);
610;54;IF(B1)THEN;
610;55;IF(B2) STAT=STAT+1;
610;56;KEW(STAT)=X3(I)*KB**3 + X2(I)*KB**2 + X1(I)*KB + X0(I);
610;57;STUFE_IST(STAT)=VDISTRING('### %',kb);
610;58;ENDIF;
610;59;B2=vonBELAST(I)==bisBELAST(I);
610;60;I=I+1;
610;61;GEFUNDEN=TV<=TVX(I) .AND. TR>=TRX(I) .and. I<=IX;
610;62;ENDDO;
610;63;ENDIF;
610;64;OK=.NOT.OK;
610;65;IF(OK)FTXT='Belastung und/oder TV/TR ausserhalb der Grenzwerte.';
610;66;endif;
610;67;endif;
610;68;WE_ETA=FTXT;
610;69;END FUNCTION WE_ETA;
