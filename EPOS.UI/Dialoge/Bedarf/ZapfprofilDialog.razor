    /// <summary>Der eingespielte Stand der Typtage — nach dem Importdialog der neu gelesene.</summary>
    private TwwTyptagStandDaten Typtagstand => _katalogstand?.Typtagstand ?? Daten.Typtagstand;

    /// <summary>Sind Typtage eingespielt? Nur dann ist der Schalter bedienbar.</summary>
    private bool TyptageDa => Typtagstand.Vorhanden;

    /// <summary>Die Klimazonen des eingespielten Pakets als Wahlliste (Nummer = Id).</summary>
    private IReadOnlyList<(int Id, string Text)> Typtagzonen
    {
        get
        {
            var liste = Typtagstand.Klimazonen.Select(z => (z, z.ToString(CultureInfo.CurrentCulture))).ToList();
            // Eine gespeicherte Wahl, die das Paket nicht (mehr) führt, bleibt sichtbar — sonst
            // stünde im Feld ein anderer Wert als in der Datenbank.
            if (_eingabe.TyptageKlimazone is int z2 && liste.All(e => e.Item1 != z2))
                liste.Insert(0, (z2, z2.ToString(CultureInfo.CurrentCulture)));
            return liste;
        }
    }

    /// <summary>Die Gebäudearten des eingespielten Pakets als Wahlliste (Platz in der Liste = Id).</summary>
    private IReadOnlyList<(int Id, string Text)> Typtagarten
    {
        get
        {
            List<string> namen = Typtagartnamen;
            return namen.Select((n, i) => (i + 1, n)).ToList();
        }
    }

    /// <summary>Die Namen der Gebäudearten samt einer gespeicherten Wahl, die das Paket nicht führt.</summary>
    private List<string> Typtagartnamen
    {
        get
        {
            var namen = new List<string>(Typtagstand.Gebaeudearten);
            string wahl = _eingabe.TyptageGebaeudeart ?? "";
            if (wahl.Length > 0 && !namen.Contains(wahl, StringComparer.Ordinal)) namen.Insert(0, wahl);
            return namen;
        }
    }

    /// <summary>Die gewählte Gebäudeart als Platz in der Wahlliste; <c>null</c> = keine Wahl.</summary>
    private int? TyptagartWahl
    {
        get
        {
            string wahl = _eingabe.TyptageGebaeudeart ?? "";
            if (wahl.Length == 0) return null;
            int i = Typtagartnamen.FindIndex(n => string.Equals(n, wahl, StringComparison.Ordinal));
            return i < 0 ? null : i + 1;
        }
    }

    /// <summary>
    /// Der Schalter „Typtage nach VDI 4655": Er gilt für das ganze Projekt. Beim Einschalten werden
    /// Zone und Gebäudeart vorbelegt, wenn das Paket genau eine führt — eine Wahl, die es ohnehin
    /// nur einmal gibt, muss niemand treffen.
    /// </summary>
    private void TyptageAktivSetzen(bool wert)
    {
        if (!TyptageDa) return;
        if (_eingabe.TyptageAktiv == wert) return;
        _eingabe.TyptageAktiv = wert;
        if (wert)
        {
            if (_eingabe.TyptageKlimazone is null && Typtagstand.Klimazonen.Count == 1)
                _eingabe.TyptageKlimazone = Typtagstand.Klimazonen[0];
            if (string.IsNullOrEmpty(_eingabe.TyptageGebaeudeart) && Typtagstand.Gebaeudearten.Count == 1)
                _eingabe.TyptageGebaeudeart = Typtagstand.Gebaeudearten[0];
        }
        Geaendert();
    }

    private void TyptagzoneSetzen(int? id)
    {
        if (_eingabe.TyptageKlimazone == id) return;
        _eingabe.TyptageKlimazone = id;
        Geaendert();
    }

    private void TyptagartSetzen(int? id)
    {
        List<string> namen = Typtagartnamen;
        string wahl = id is int i && i >= 1 && i <= namen.Count ? namen[i - 1] : "";
        if (string.Equals(_eingabe.TyptageGebaeudeart ?? "", wahl, StringComparison.Ordinal)) return;
        _eingabe.TyptageGebaeudeart = wahl;
        Geaendert();
    }

    /// <summary>„VDI-4655-Typtage…": die Überlagerung des Importdialogs.</summary>
    private void TyptageOeffnen()
    {
        if (TyptagGaben is null) return;
        _typtagGaben = TyptagGaben();
    }

    /// <summary>
    /// Der Importdialog ist zu: Hat sich der eingespielte Stand geändert, wird der Katalogstand
    /// neu gelesen (die Wahllisten ziehen nach), und eine Wahl, die es nicht mehr geben kann, fällt
    /// benannt zurück auf den Bestandsweg — nie still auf eine Zone, die das Paket nicht führt.
    ///
    /// <para>Das Kreuz und Esc der Überlagerung rufen denselben Weg mit <c>true</c>: Der Importdialog
    /// schreibt sofort, also ist nach dem Kreuz alles möglich geschehen. Das ist die sichere Seite —
    /// ein überholter Punkt der Auslegung ist neu zu rechnen, ein stehen gebliebener wäre falsch.</para>
    /// </summary>
    private void TyptageGeschlossen(bool geaendert)
    {
        _typtagGaben = null;
        if (!geaendert) return;
        bool vorher = _eingabe.TyptageAktiv;
        KatalogNeuLesen();
        if (!TyptageDa && _eingabe.TyptageAktiv)
        {
            _eingabe.TyptageAktiv = false;
            _editorStatus = Texte.HinweisTyptageOhne;
        }
        // Der Punkt der Auslegung ist nur ueberholt, wenn der Typtagweg den Jahresgang traegt —
        // vorher oder nachher; ein Einspielen ohne gewaehlten Typtagweg laesst ihn stehen.
        if (vorher || _eingabe.TyptageAktiv) PunktUeberholen();
        GeaendertNachEditor();
    }

    /// <summary>Die Beschriftung eines Feldes der Wohnungstabelle: „Anzahl, Zeile 2".</summary>
    private string WohnFeld(string spalte, ZapfprofilZonenangabenDaten a, ZapfprofilWohnungDaten w)
        => Format(Texte.FeldZeile, spalte, a.Wohnungen.IndexOf(w) + 1);

