<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Referenzlauf-Suite (Paket B1, Kapitel 9 des Simulationskonzepts).

    Eigenstaendiges Konsolenwerkzeug: friert die Ergebnisvektoren mehrerer Realprojekte
    als CSV ein und vergleicht spaetere Laeufe mit Toleranz dagegen.

    BEWUSST NICHT IN WP-Plan.sln aufgenommen - das Werkzeug wird separat gebaut. MSBuild-Pfad
    je nach Fassung: ...\Microsoft Visual Studio\18\Community\... (VS 2026) oder ...\2022\...
    Sicherer ueber vswhere, siehe WindowsFormsApplication1\CLAUDE.md:
      $msb = & "${env:ProgramFiles(x86)}\Microsoft Visual Studio\Installer\vswhere.exe" -latest ^
             -prerelease -products * -requires Microsoft.Component.MSBuild ^
             -find MSBuild\**\Bin\MSBuild.exe
      & $msb Referenzlauf\Referenzlauf.csproj -p:Configuration=Debug -p:Platform=x64
    Seit Paket P2 wird ausschliesslich x64 gebaut; dazu muss Microsoft.ACE.OLEDB.12.0 als
    64-Bit-Engine installiert sein. Fehlt sie, laesst sich die Kenndaten.accdb zur Laufzeit
    nicht oeffnen.
    "dotnet build" scheitert an MSB4803 (COM-Referenzen des referenzierten App-Projekts).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>

    <!-- Wegen der Projektreferenz auf die WinForms-App zwingend erforderlich. -->
    <UseWindowsForms>true</UseWindowsForms>

    <!-- x64 wie die App: Microsoft.ACE.OLEDB.12.0 muss als 64-Bit-Engine vorliegen
         (Konzept_Umstellung_64Bit_EPOS-Plan.md, P2). -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>

    <RootNamespace>WindowsFormsApplication1.Referenzlauf</RootNamespace>
    <AssemblyName>Referenzlauf</AssemblyName>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <!-- Gleiche Toleranz gegenueber Legacy-Warnungen wie im App-Projekt. -->
    <NoWarn>$(NoWarn);CA1416;MSB3568;CS1701;CS1702;NU1701;MSB3277;NETSDK1206;WFAC010</NoWarn>
    <SatelliteResourceLanguages>de-DE;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsFormsApplication1\WindowsFormsApplication1.csproj" />
  </ItemGroup>

</Project>
