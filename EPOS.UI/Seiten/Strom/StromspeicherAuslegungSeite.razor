    private async Task ProjektflotteUebernehmen()
    {
        if (_veraltet || _flottenErgebnis is null || Dienste?.ProjektflotteAktivieren is null) return;
        try
        {
            string fehler = await Dienste.ProjektflotteAktivieren(_flottenErgebnis);
            if (fehler.Length > 0) { _fehler = fehler; return; }
            _projektAktiv = true;
            _meldungErfolg = true;
            _meldung = Resource.FLOTTE_DLG_MSG_AKTIVIERT;
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }

    private async Task ProjektflotteDeaktivieren()
    {
        if (Dienste?.ProjektflotteDeaktivieren is null) return;
        try
        {
            string fehler = await Dienste.ProjektflotteDeaktivieren();
            if (fehler.Length > 0) { _fehler = fehler; return; }
            _projektAktiv = false;
            _meldungErfolg = true;
            _meldung = Resource.FLOTTE_DLG_MSG_DEAKTIVIERT;
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }

    private async Task BesteFlotteUebernehmen()
    {
        if (_veraltet || _flottenErgebnis?.Auslegung?.BesteKonfiguration is null) return;

        FlotteSetzen(_flottenErgebnis.Auslegung.BesteKonfiguration);
        try
        {
            if (Dienste?.EinstellungenSpeichern is not null)
            {
                string fehler = await EinstellungenSichern(_eingaben);
                if (fehler.Length > 0) { _fehler = fehler; return; }
            }
            _schritt = AuslegungSchritt.Speicher;
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }

    /// <summary>
    /// Der EINE Weg, auf dem eine gerechnete Konfiguration zur Flotte in Schritt 1 wird
    /// (#196). Er räumt die Suchachsen weg und schaltet den Suchlauf ab — was übernommen
    /// ist, ist eine feste Flotte und kein Suchraum mehr —, und
    /// <see cref="Geaendert"/> markiert Schritt 5 als veraltet: Das stehende Ergebnis
    /// gehört zur vorigen Flotte.
    /// </summary>
    private void FlotteSetzen(FlottenStudieKonfiguration konfiguration)
    {
        Auslegung.Flotte = SpeicherAuslegungKopie.Von(konfiguration);
        Auslegung.Flotte.Auslegung.Achsen.Clear();
        Auslegung.FlottenGroessenOptimieren = false;
        Geaendert();
    }

    // =====================================================================
    //  „Kandidat uebernehmen" aus der Groessen-Sicht (#196, Konzept 2.5)
    // =====================================================================

    /// <summary>
    /// Wie viele Einheiten die Größen-Sicht je Einheit anbieten darf. Maßgeblich ist die
    /// Flotte des LAUFS und nicht der Arbeitsstand: Die Karte zeigt dessen Kandidaten,
    /// und eine Einheitenwahl, die es in ihnen nicht gibt, zeigte eine leere Karte.
    /// Ohne Laufkonfiguration bleibt der Arbeitsstand.
    /// </summary>
    private int Einheitenzahl => _flottenErgebnis?.Konfiguration?.Einheiten is { } einheiten
        ? einheiten.Count : Flotte.Einheiten.Count;

    /// <summary>
    /// „Kandidat übernehmen": Die gewählte Rastervariante wird die Flotte in Schritt 1.
    /// <b>Trägt Schritt 1 ungespeicherte Eingaben, wird vorher gefragt</b> (Muster
    /// 62b‑E‑1) — der Kandidat ersetzt sie, und das ist nicht rückgängig zu machen.
    /// </summary>
    private Task KandidatUebernehmen(FlottenKandidatZusammenfassung kandidat)
    {
        if (_laeuft || kandidat is null) return Task.CompletedTask;
        if (_ungespeichert) { _kandidat = kandidat; return Task.CompletedTask; }
        return KandidatAnwenden(kandidat);
    }

    /// <summary>
    /// Die Antwort auf die Rückfrage: <c>true</c> speichert den bisherigen Stand, bevor
    /// der Kandidat ihn ersetzt, <c>false</c> verwirft ihn, <c>null</c> („Bleiben", auch
    /// Esc) lässt alles, wie es ist.
    /// </summary>
    private async Task KandidatBeantwortet(bool? antwort)
    {
        FlottenKandidatZusammenfassung? kandidat = _kandidat;
        _kandidat = null;
        if (antwort is null || kandidat is null) return;

        if (antwort == true)
        {
            string fehler = await EinstellungenSichern(_eingaben);
            if (fehler.Length > 0) { _fehler = fehler; return; }
        }

        await KandidatAnwenden(kandidat);
    }

    /// <summary>
    /// Übernimmt den Kandidaten und führt zurück auf Schritt 1. Die Konfiguration baut
    /// der KERN (<see cref="SpeicherFlottenAnzeigeCtrl.KandidatKonfiguration"/>); für den
    /// besten Kandidaten gibt er die Konfiguration des Optimierers zurück — denselben
    /// Stand, den „Beste Flotte übernehmen" nimmt.
    /// </summary>
    private Task KandidatAnwenden(FlottenKandidatZusammenfassung kandidat)
    {
        try
        {
            FlottenStudieKonfiguration konfiguration = SpeicherFlottenAnzeigeCtrl
                .KandidatKonfiguration(_flottenErgebnis?.Auslegung, Flotte, kandidat);
            if (konfiguration is null) return Task.CompletedTask;

            FlotteSetzen(konfiguration);
            _schritt = AuslegungSchritt.Speicher;

            // Die Meldung steht NACH Geaendert() (in FlotteSetzen), weil das die
            // Meldezeile raeumt - dasselbe Muster wie beim uebernommenen Peak-Ziel.
            _meldungErfolg = true;
            _meldung = string.Format(Kultur, KandidatBannerFormat, kandidat.KandidatId);
        }
        catch (Exception ex) { _fehler = ex.Message; }
        return Task.CompletedTask;
    }

    /// <summary>Der Variantenvergleich als CSV — er führt ALLE Kandidaten des Laufs.</summary>
    private Task KandidatenCsv()
        => _flottenErgebnis is null ? Task.CompletedTask
            : CsvSchreiben(SpeicherFlottenAnzeigeCtrl.VergleichCsv(_flottenErgebnis));

    private void AuslegungUebernehmen((double Kwh, double Kw) auslegung)
    {
        if (Dienste?.AuslegungUebernehmen is null) return;
        Rueckmeldung antwort = Dienste.AuslegungUebernehmen(auslegung.Kwh, auslegung.Kw);
        _meldungErfolg = antwort.Erfolg;
        _meldung = antwort.Text ?? "";
    }

    private async Task CsvSchreiben(string csv)
    {
        if (Dienste?.Csv is null) return;
        Rueckmeldung antwort = await Dienste.Csv(csv);
        _meldungErfolg = antwort.Erfolg;
        _meldung = antwort.Text ?? "";
    }

    private void PrognosenOeffnen() => _prognosenOffen = true;

    private void PrognosenSchliessen() => _prognosenOffen = false;

    private async Task CsvOeffnen(bool prognosen)
    {
        if (Dienste?.DateiWaehlen is null) return;
        try
        {
            SpeicherImportDatei datei = await Dienste.DateiWaehlen();
            if (datei is null || datei.Inhalt.Length == 0) return;
            _csvPrognosen = prognosen;
            _csvDatei = datei;
            _prognosenOffen = false;
            _fehler = "";
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }

    private void CsvSchliessen() => _csvDatei = null;

    /// <summary>
    /// Ein CSV-Import hat den Arbeitsstand VON AUSSEN geändert. Der Auslegungseditor
    /// hält eine eigene Kopie und frischt sie nur auf, wenn sich die REFERENZ ändert
    /// (<c>SpeicherAuslegungEditor.OnParametersSet</c>) — ohne einen neuen Stand
    /// schriebe er beim nächsten „Einstellungen speichern" den alten zurück und der
    /// eben eingelesene Dateiname wäre wieder weg.
    /// </summary>
    private void Uebernommen()
    {
        _eingaben = _eingaben.Kopie();
        Geaendert();
    }

    private Task PrognosenUebernehmen(List<FlottenPrognoseSnapshot> snapshots, SpeicherFlottenCsvOptionen optionen)
    {
        Auslegung.FlottenPrognosen = snapshots;
        Auslegung.FlottenPrognoseDatei = _csvDatei?.Dateiname ?? "";
        Auslegung.FlottenPrognoseCsvOptionen = SpeicherAuslegungKopie.Von(optionen);
        _csvDatei = null;
        Uebernommen();
        return Task.CompletedTask;
    }

    private Task JahresdatenUebernehmen(List<FlottenProjektjahr> jahre, SpeicherFlottenCsvOptionen optionen)
    {
        Auslegung.FlottenProjektjahre = jahre;
        Auslegung.FlottenJahresdatenDatei = _csvDatei?.Dateiname ?? "";
        Auslegung.FlottenJahresCsvOptionen = SpeicherAuslegungKopie.Von(optionen);
        _csvDatei = null;
        Uebernommen();
        return Task.CompletedTask;
    }

    // =====================================================================
    //  Verlassen (Muster 62b-E-1)
    // =====================================================================

    private async Task Verlassen()
    {
        if (await FrageVerlassen() == AssistentVerlassen.Bleiben) return;
        await Geschlossen.InvokeAsync();
    }

    /// <summary>
    /// Fragt den Anwender, ob er die Ansicht verlassen will, und liefert den gewählten
    /// Weg. <b>Ohne ungespeicherte Eingaben gibt es keine Rückfrage</b> (62b‑E‑1).
    /// </summary>
    /// <remarks>
    /// Der Wirt ruft das, BEVOR er die Ansicht wechselt (<c>AppWurzel</c>) oder das
    /// Programm schließt. Scheitert das Speichern, bleibt die Ansicht stehen und zeigt
    /// ihre Meldung — die Antwort ist dann <see cref="AssistentVerlassen.Bleiben"/>.
    /// </remarks>
    public async Task<EPOS.UI.Seiten.Assistent.AssistentVerlassen> FrageVerlassen()
    {
        if (_frageOffen) return AssistentVerlassen.Bleiben;      // sie steht schon
        if (!_ungespeichert) return AssistentVerlassen.Verwerfen;

        _frageWartet = new TaskCompletionSource<bool?>();
        _frageOffen = true;
        await InvokeAsync(StateHasChanged);

        bool? antwort = await _frageWartet.Task;
        _frageWartet = null;
        _frageOffen = false;

        if (antwort is null) { await InvokeAsync(StateHasChanged); return AssistentVerlassen.Bleiben; }
        if (antwort == false) { await InvokeAsync(StateHasChanged); return AssistentVerlassen.Verwerfen; }

        string fehler = await EinstellungenSichern(_eingaben);
        if (fehler.Length > 0)
        {
            _fehler = fehler;
            await InvokeAsync(StateHasChanged);
            return AssistentVerlassen.Bleiben;
        }

        await InvokeAsync(StateHasChanged);
        return AssistentVerlassen.Gespeichert;
    }

    private void VerlassenBeantwortet(bool? antwort)
    {
        _frageOffen = false;
        _frageWartet?.TrySetResult(antwort);
    }
}
