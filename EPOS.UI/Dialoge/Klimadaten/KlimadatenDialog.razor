    public IReadOnlyList<Vergleichszeile> Vergleichszeilen
        => _vergleichszeilen ?? Array.Empty<Vergleichszeile>();

    /// <summary>
    /// Der STANDORT: ein Ortsname ODER die drei Handangaben. Er wird bei JEDER Quelle
    /// gebraucht — ohne ihn ließe sich weder die Sonnengeometrie noch die nächste
    /// TRY-Region bestimmen. Bei einer TRY-Datei füllt ihn
    /// <see cref="StandortAusDatei"/> aus dem Dateikopf vor (Auftrag KL-2).
    /// </summary>
    private bool StandortSteht =>
        _ortsname.Trim().Length > 0 ||
        (_longitude.HasValue && _latitude.HasValue && _bezeichnung.Trim().Length > 0);

    /// <summary>
    /// „Daten einlesen" braucht einen Standort und — je nach Quelle — eine Datei:
    /// PVGIS den Standort; die TRY-Datei zusätzlich ihren Pfad; die TRY-Regionaldaten
    /// den Standort (das Paket darf leer bleiben). Ein fehlerhaftes Zahlenfeld sperrt.
    /// </summary>
    private bool ImportErlaubt => !_laeuft && Importieren is not null &&
        _fehlerFelder.Count == 0 && StandortSteht &&
        (_quelle != KlimaQuelle.TryDatei || _tryPfad.Trim().Length > 0);

    /// <summary>
    /// Der Standort, den die REGIONSVORSCHAU braucht: ein Ortsname ODER ein
    /// Koordinatenpaar — ohne Bezeichnung: Die Vorschau legt nichts an.
    /// </summary>
    private bool StandortFuerVorschau =>
        _ortsname.Trim().Length > 0 || (_longitude.HasValue && _latitude.HasValue);

    /// <summary>„Region ermitteln" braucht die Regionaldaten als Quelle und einen Standort.</summary>
    private bool RegionErlaubt => !_laeuft && !_regionLaeuft && RegionErmitteln is not null &&
        _quelle == KlimaQuelle.TryRegional && _fehlerFelder.Count == 0 && StandortFuerVorschau;

    // =====================================================================
    // Stammblatt (Stufe 4): Kopf, Kennzahlen, Herkunft
    // =====================================================================

    /// <summary>„Quelle · Standort · Auslieferungssatz" — aus den Spalten der Zeile.</summary>
    private string Unterzeile => Stammblattkopf.Unterzeile(Filterprofil, _fokuszeile,
        _fokuszeile is null ? "" : _auslieferung ? Resource.ADM_SB_AUSLIEFERUNG : Resource.ADM_SB_EIGENER_SATZ);

    /// <summary>
    /// Die drei Kennzahlen der Außentemperatur (Jahresmittel, Tiefst-, Höchstwert) —
    /// gerechnet in der Hülle aus den Stundenwerten, hier nur formatiert.
    /// </summary>
    private IReadOnlyList<Stammblattkennzahl> Kennzahlen => _gewaehlt.Length == 0
        ? Array.Empty<Stammblattkennzahl>()
        : new[]
        {
            new Stammblattkennzahl(Grad(_jahresmittel), KennzahlMittelText),
            new Stammblattkennzahl(Grad(_tiefstwert), KennzahlTiefstText),
            new Stammblattkennzahl(Grad(_hoechstwert), KennzahlHoechstText)
        };

    private string Grad(double? wert) => wert is double w
        ? w.ToString("0.0", CultureInfo.CurrentCulture) + " " + EinheitTemperaturText
        : ParameterVerwendung.LEER;

    /// <summary>
    /// <b>Die Gruppe Herkunft</b> (V9) als Text: Quelle, Importdatum, Standort, Lage
    /// und der Herkunftsvermerk. Die Koordinaten stehen in der Liste nur bei viel
    /// Platz (Rang „breit") — hier immer.
    /// </summary>
    private IReadOnlyList<Stammblattwert> Herkunftswerte
    {
        get
        {
            if (_fokuszeile is null) return Stammblattwert.Keine;
            return new[]
            {
                new Stammblattwert(SpalteQuelleText, _fokuszeile.Text(Katalogfilterprofil.SpQuelle)),
                new Stammblattwert(SpalteImportdatumText, _fokuszeile.Text(Katalogfilterprofil.SpImportdatum)),
                new Stammblattwert(SpalteStandortText, _fokuszeile.Text(Katalogfilterprofil.SpStandort)),
                new Stammblattwert(SpalteLongitudeText, _fokuszeile.Text(Katalogfilterprofil.SpLongitude), EinheitWinkelText),
                new Stammblattwert(SpalteLatitudeText, _fokuszeile.Text(Katalogfilterprofil.SpLatitude), EinheitWinkelText),
                new Stammblattwert(Stammblattwert.OhneDoppelpunkt(LabelDetails), _details)
            };
        }
    }

    /// <summary>Gibt es ein Bild zum Vergrößern?</summary>
    private bool HatBild => _modellTemperatur is not null || _modellSonnenwinkel is not null;

    private Zeichenmodell? GrossModell => _reiter == "SONNENWINKEL" ? _modellSonnenwinkel : _modellTemperatur;

    private string GrossTitel => _gewaehlt.Length == 0
        ? GruppeJahresverlaufText
        : GruppeJahresverlaufText + " – " + _gewaehlt;

    private EventCallback BlattOeffnenWeg => _auswahl.BlattOffen ? default : _blattOeffnen;

    /// <summary>
    /// <b>Die Handlungen der Auswahlleiste</b> (V8): Vergleichen ab zwei Kästchen und
    /// Löschen — weich gesperrt, wenn jede Zielzeile eine Auslieferungsregion ist
    /// (V13). Kein Duplizieren: Eine Region entsteht nur durch Einlesen.
    /// </summary>
    private IReadOnlyList<Auswahlhandlung> Handlungen()
    {
        var liste = new List<Auswahlhandlung>(2)
        {
            new(Texte.Vergleichen, _vergleichen)
            {
                Mindestens = 2,
                ZahlGrund = Resource.ADM_AW_VERGLEICHEN_GRUND,
                Gedrueckt = _auswahl.Vergleich
            }
        };
        if (Loeschen is not null)
            liste.Add(new(LoeschenText, _loeschenWeg) { Sperrgrund = LoeschSperrgrund, Aus = _laeuft });
        return liste;
    }

    private string LoeschSperrgrund
    {
        get
        {
            IReadOnlyList<string> ziele = _auswahl.Ziele(_gewaehlt);
            if (ziele.Count == 0) return "";
            foreach (string z in ziele)
                if (!_geschuetzt.Contains(z)) return "";
            return Resource.ADM_AW_LOESCHEN_GESPERRT_OHNE_KOPIE;
        }
    }

    private void Warnen(string text) => Melden(text, WarnStufe.Warnung);

    private void BeiKaestchen(IReadOnlyList<string> gewaehlte)
    {
        _auswahl.Setzen(gewaehlte);
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiAufheben()
    {
        _auswahl.Aufheben();
        _vergleichszeilen = null;
    }

    private void BeiVergleichen()
    {
        if (_auswahl.VergleichUmschalten()) VergleichBauen();
        else _vergleichszeilen = null;
    }

    private void BeiVergleichZurueck()
    {
        _auswahl.VergleichBeenden();
        _vergleichszeilen = null;
    }

    /// <summary>
    /// <b>Der Vergleich</b> (V12): die Spalten der Liste nebeneinander — Quelle,
    /// Standort, Koordinaten, Importdatum —, dazu die Herkunft (Auslieferungssatz oder
    /// eigener Satz).
    /// </summary>
    private void VergleichBauen()
    {
        IReadOnlyList<string> namen = _auswahl.Gewaehlte;
        _vergleichskoepfe = namen;

        var zeilen = namen.Select(n => _regionen.FirstOrDefault(x => x.Schluessel == n))
                          .Where(x => x is not null).Select(x => x!).ToList();
        var liste = new List<Vergleichszeile>(Vergleichsbau.AusSpalten(Filterprofil, zeilen));
        var herkunft = zeilen.Select(z => _geschuetzt.Contains(z.Bezeichner)
                                              ? Resource.ADM_SB_AUSLIEFERUNG
                                              : Resource.ADM_SB_EIGENER_SATZ).ToList();
        liste.Add(new Vergleichszeile(Resource.ADM_VG_HERKUNFT, herkunft, Vergleichsbau.Abweichend(herkunft)));
        _vergleichszeilen = liste;
    }

