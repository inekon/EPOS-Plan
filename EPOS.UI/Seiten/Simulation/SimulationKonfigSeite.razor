@* Die SIMULATIONSKONFIGURATION als Seite (iU9-W10b.1).

   VORBILD. WindowsFormsApplication1/Views/Simulation/Form_Simulation_Config
   in vier Teildateien (4 558 Z.) samt drei Steuerelement-Klassen und dem
   Zeichenmodell.

   ENTSCHEID R-W10b-1. Der Wellenplan nennt sie eine SEITE, und als solche ist
   sie gebaut: SeitenZustand fuer den Projektwechsel, ein Eintrag in
   Seitenschluessel und AppWurzel, damit iOS sie als Seite zeigt. Unter Windows
   erscheint sie BIS W16 in einer modalen Dialoghuelle
   (BlazorDialogForm<SimulationKonfigSeite>), weil ihre beiden Aufrufer die
   modale Rueckkehr brauchen (Form_Start und Form_Simulation_Detail springen
   danach auf ihren gemerkten Reiter zurueck). Ein spaeteres Umhaengen in einen
   Reiter aendert nur die Huelle.

   ZWEI ANSICHTEN, EINE AUSWAHL. Der Umschalter rechts oben wechselt zwischen
   den Kartenspalten und dem Schema; BEIDE zeigen dieselben Daten und teilen
   sich _auswahl (den sprachneutralen Knotenschluessel). Die Auswahl ueberlebt
   das Umschalten - sie haengt an einem Schluessel und nicht an einem Objekt.

   NEUN AUFFRISCHUNGSSTELLEN WERDEN EINE. Der Vorlaeufer rief
   AktualisiereErzeugerUebersicht an neun Stellen (Befund W10-B40, der
   Quelltextkommentar sprach von acht). Hier gibt es genau ein Neuladen().

   KEINE DATENBANK. Alles kommt ueber SimulationKonfigDienste herein; die
   Huelle (Views/Simulation/SimulationKonfigHuelle.cs) haelt die Controller. *@

@namespace EPOS.UI.Seiten.Simulation
@implements IDisposable

<div class="epos-simkonfig">

    <div class="epos-simkonfig-kopf">
        <span class="epos-simkonfig-titel">@KopfText</span>
        <InfoKnopf Schluessel="@HilfeSchluessel" />

        <span class="epos-simkonfig-ansicht">
            <span class="epos-simkonfig-ansichtlabel">@AnsichtLabel</span>
            <button type="button" class="@Ansichtklasse(ANSICHT_LISTE)"
                    aria-pressed="@(_ansicht == ANSICHT_LISTE ? "true" : "false")"
                    @onclick="() => AnsichtWaehlen(ANSICHT_LISTE)">@AnsichtListe</button>
            <button type="button" class="@Ansichtklasse(ANSICHT_SCHEMA)"
                    aria-pressed="@(_ansicht == ANSICHT_SCHEMA ? "true" : "false")"
                    @onclick="() => AnsichtWaehlen(ANSICHT_SCHEMA)">@AnsichtSchema</button>
        </span>
    </div>

    @if (_daten.Gesperrt)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_daten.Sperrgrund" />
    }

    <fieldset class="epos-simkonfig-bereich" disabled="@_daten.Gesperrt">

        @* DIE NETZVERLUSTE (Windows-Abnahme #216 vom 11.09.2026, Punkt 3: „Nimm
           Parameter heraus — die Netzverluste koennen an eine andere Stelle
           (werden diese ueberhaupt verwendet?)"). Sie WERDEN verwendet:
           SimulationLaufCtrl prueft sie (Z. 72) und uebergibt sie an
           SimulationWaermebedarf.Netzverluste (Z. 118-119), das sie stuendlich
           umrechnet und ueber SimulationKanaele.NetzverlusteVerteilen anteilig
           auf die Bedarfskanaele legt. Deshalb stehen sie hier, beim WAERMEBEDARF
           des Projekts, und nicht mehr in einem Reiter des Ergebnisses. *@
        @if (Parameter?.Laden is not null)
        {
            <section class="epos-simkonfig-bedarf" aria-label="@Resource.SIMKONF_GRP_WAERMEBEDARF">
                <Gruppenkopf Titel="@Resource.SIMKONF_GRP_WAERMEBEDARF" />
                <div class="epos-simkonfig-felder">
                    <Formularraster Einspaltig="true">
                        <KindInhalt>
                            <Zahlenfeld Bezeichnung="@Resource.SIMERG_LBL_NETZVERLUSTE"
                                        Wert="@_parameter.Netzverluste"
                                        Einheit="@_parameter.NetzverlusteEinheit"
                                        Aktiv="@(!_daten.Gesperrt && Parameter?.NetzverlusteSchreiben is not null)"
                                        WertChanged="NetzverlusteGesetzt" />
                            <Herleitungszeile Text="@Resource.SIMKONF_HRL_NETZVERLUSTE" />
                        </KindInhalt>
                    </Formularraster>
                </div>
            </section>
        }

        @if (_ansicht == ANSICHT_SCHEMA)
        {
            <Schema Layout="@_schema" Gewaehlt="@_auswahl"
                    LeerText="@SchemaLeerText" WarnungText="@SchemaWarnungText"
                    KetteKopfText="@SchemaKetteKopfText" KeineKetteText="@SchemaKeineKetteText"
                    Ausgewaehlt="SchemaAuswahl" BearbeitenGewuenscht="SchemaBearbeiten" />
        }
        else
        {
            <div class="epos-simkonfig-spalten">

                <section class="epos-simkonfig-erzeuger">
                    <Gruppenkopf Titel="@KopfErzeuger" />

                    @* H13: der Rechenweg zum Abschnitt, der die Rechnung parametriert -
                       die Reihenfolge der Erzeuger IST die Kaskade. Der Fensterknopf oben
                       im Kopfband bleibt, was er ist: die Bedienhilfe zur Seite. *@
                    <p class="epos-simkonfig-hinweis">
                        <InfoKnopf Schluessel="@HilfeSchluesselBerechnung"
                                   StandardKurztext="@HilfeKurztextBerechnung" />
                    </p>

                    @* #190 - DIE LUECKE WIRD SICHTBAR (Abnahmeliste „PV mit
                       Heizkessel"). Bis hierher verschwand ein angelegter, aber nicht
                       aufgenommener Erzeuger STILL hinter dem Schalter am Spaltenende:
                       Der Anwender legte einen Heizkessel an, die Simulation rechnete
                       ihn nie, und nichts auf dieser Seite sagte warum. Die Leiste
                       nennt die Zahl; AUFGENOMMEN wird weiterhin von Hand
                       (Anwenderentscheid HK-E-1a vom 11.09.2026 - kein automatisches
                       Aufnehmen, sonst aenderten sich Ergebnisse im Bestand). *@
                    @if (LueckeAnzahl > 0)
                    {
                        <div class="epos-simkonfig-luecke" role="alert">
                            <span class="epos-simkonfig-luecke-text">@LueckeText</span>
                            @if (!_verfuegbareZeigen)
                            {
                                <button type="button" class="epos-simkonfig-luecke-knopf"
                                        @onclick="VerfuegbareUmschalten">@NichtAufgenommenKnopf</button>
                            }
                        </div>
                    }

                    @foreach (KachelGruppe gruppe in _daten.Gruppen)
                    {
                        <h3 class="epos-simkonfig-gruppe">@gruppe.Titel</h3>

                        @foreach (ErzeugerZeile z in Sichtbare(gruppe))
                        {
                            ErzeugerZeile zeile = z;
                            <ErzeugerKachel Aufbau="@zeile.Kachel"
                                            Parameterbereich="@Erzeugerparameter(zeile)"
                                            AufnehmenText="@AufnehmenText"
                                            TipHoch="@TipHoch" TipRunter="@TipRunter"
                                            TipBearbeiten="@TipBearbeiten" TipEntfernen="@TipEntfernen"
                                            TipAufnehmen="@TipAufnehmen" TipAufklappen="@TipAufklappen"
                                            NachOben="() => Verschieben(zeile, -1)"
                                            NachUnten="() => Verschieben(zeile, +1)"
                                            Bearbeiten="() => KachelBearbeiten(zeile)"
                                            Aufnehmen="() => Aufnehmen(zeile)"
                                            Entfernen="() => Entfernen(zeile)"
                                            ChipBearbeiten="c => ChipEditorOeffnen(zeile, c)"
                                            Umschalten="() => StromUmschalten(zeile)"
                                            Ausgewaehlt="() => KarteAusgewaehlt(zeile)" />
                        }

                        @if (!string.IsNullOrEmpty(gruppe.LeerText))
                        {
                            <p class="epos-simkonfig-hinweis">@gruppe.LeerText</p>
                        }
                    }

                    @if (_verfuegbareZeigen || VerfuegbarVersteckt > 0)
                    {
                        <button type="button" class="epos-simkonfig-verfuegbar"
                                @onclick="VerfuegbareUmschalten">
                            @(_verfuegbareZeigen
                                ? VerfuegbarAusblenden
                                : string.Format(VerfuegbarEinblenden, VerfuegbarVersteckt))
                        </button>
                    }

                    <p class="epos-simkonfig-hinweis">@AnlageHinzuText</p>
                </section>

                <section class="epos-simkonfig-speicher">
                    <Gruppenkopf Titel="@KopfSpeicher" />

                    @foreach (Bausteine.SpeicherKachelDaten s in _daten.Speicher)
                    {
                        Bausteine.SpeicherKachelDaten sp = s;
                        <SpeicherKachel Inhalt="@sp" Aufgeklappt="@(sp.IdPuffer == _offenerSpeicher)"
                                        BilanzText="@BilanzText"
                                        TipBearbeiten="@TipSpeicherBearbeiten"
                                        TipAufklappen="@TipSpeicherAufklappen"
                                        Umschalten="SpeicherUmschalten"
                                        Bearbeiten="PufferVerwaltungOeffnen"
                                        Ausgewaehlt="SpeicherAusgewaehlt" />
                    }

                    @* Anwenderwunsch 08.09.2026 (W10b-B-2): "Nehme (falls vorhanden) den
                       Stromspeicher auf die Spalte 'Speicher im Projekt'" - alle Speicher des
                       Projekts stehen hier, nicht nur die Puffer. Die Betriebsfuehrung des
                       Stromspeichers (Variante, SoC-Band, Netzentladung) bleibt links unter
                       "Energiespeicher"; hier stehen Name und die ersten Kennwerte. *@
                    @foreach (ErzeugerZeile z in Stromspeicher)
                    {
                        <div class="epos-stromspeicherkachel" title="@StromspeicherHinweis">
                            <div class="epos-speicherkachel-kopf">
                                <span class="epos-speicherkachel-name">@z.Kachel.Titel</span>
                            </div>
                            <div class="epos-stromspeicherkachel-chips">
                                @foreach (Bausteine.ChipDaten chip in z.Kachel.Chips.Take(3))
                                {
                                    <span class="epos-chip" title="@chip.Hinweis">@chip.Text</span>
                                }
                            </div>
                        </div>
                    }

                    @if (_daten.Speicher.Count == 0)
                    {
                        <p class="epos-simkonfig-hinweis">@_daten.SpeicherLeerText</p>
                    }

                    <button type="button" class="epos-knopf" disabled="@(IdProjekt <= 0)"
                            @onclick="() => PufferVerwaltungOeffnen(0)">@BtnPufferVerwalten</button>
                </section>
            </div>
        }
    </fieldset>

    <div class="epos-simkonfig-fuss">

        <div class="epos-simkonfig-schalter">
            @* Der Schalter "Extrapolation der WP-Kennlinie erlauben" steht seit W10b-B-3
               (08.09.2026) in der Detailansicht der Waermepumpe bei "Kenndaten
               Kennlinien" (WaermepumpeAnlageDialog) - hier nicht mehr. *@

            @if (_daten.BoosterSichtbar)
            {
                <Schalter Bezeichnung="@LesepunktText" Aktiv="@(!_daten.Gesperrt)"
                          Wert="@_daten.BoosterDavor"
                          WertChanged="LesepunktGesetzt" />
            }
        </div>

        @if (!string.IsNullOrEmpty(_status))
        {
            <Warnbanner Stufe="@_statusStufe" Text="@_status" />
        }

        @* AUFTRAG #207: Hier stand eine SpeichernLeiste mit „Konfiguration
           speichern" UND „Beenden". Der zweite Knopf ist gefallen — seit die Seite
           Schritt ① der Ansicht SIMULATION ist, verlaesst man sie ueber die
           Ablaufleiste oder ueber das eine „← zurueck" im Kopf der Ansicht
           (Anwenderentscheid SIM-Q1). Damit bleibt EIN Knopf, und der Baustein
           lohnt nicht mehr: Seine Statuszeile hat diese Seite nie benutzt, sie
           meldet ueber ihr eigenes Warnbanner darueber. *@
        <div class="epos-leiste">
            <button type="button" class="epos-knopf epos-knopf--primaer"
                    disabled="@_daten.Gesperrt" @onclick="SpeichernGeklickt">@BtnSpeichern</button>
        </div>
    </div>

    @* =================================================================
       EBENE 1 — die Editoren, die aus einer Kachel oder aus dem Schema
       heraus geoeffnet werden. Sie stehen IM selben Fenster (Risiko R2).
       ================================================================= *@

    <Ueberlagerung Offen="@(_ebene1 == Editor.Quellenwahl)" Titel="@QuellenwahlTitel"
                   Geschlossen="Ebene1Schliessen">
        <KindInhalt>
            <div class="epos-simkonfig-quellenwahl" role="group" aria-label="@QuellenwahlTitel">
                @foreach (Quellentyp t in _quellentypen)
                {
                    Quellentyp typ = t;
                    <button type="button" class="@Quellenklasse(typ.Wert)"
                            aria-pressed="@(typ.Wert == _quelleTypJetzt ? "true" : "false")"
                            @onclick="() => QuelleGewaehlt(typ.Wert)">@typ.Text</button>
                }
            </div>
        </KindInhalt>
    </Ueberlagerung>

    <EPOS.UI.Dialoge.Simulation.WertAbfrage
        Offen="@(_ebene1 == Editor.WpPrioritaet)" TitelText="@PrioTitel"
        Beschriftung="@_wertFrage" Vorgabe="@_wertVorgabe"
        Beantwortet="PrioBeantwortet" />

    <EPOS.UI.Dialoge.Simulation.WertAbfrage
        Offen="@(_ebene1 == Editor.QuelleKonstant)" TitelText="@KonstantTitel"
        Beschriftung="@_wertFrage" Vorgabe="@_wertVorgabe"
        Beantwortet="KonstantBeantwortet" />

    <Rueckfrage Offen="@(_ebene1 == Editor.QuelleCsvFrage)" TitelText="@CsvTitel"
                Frage="@_csvFrage" JaText="@CsvJaText" NeinText="@CsvNeinText"
                Beantwortet="CsvBeantwortet" />

    @if (_gaben1 is not null && _ebene1 == Editor.Betriebsmodus)
    {
        <Ueberlagerung Offen="true" Titel="@ModusTitel" Geschlossen="Ebene1Schliessen">
            <KindInhalt>
                <EPOS.UI.Dialoge.Simulation.BetriebsmodusDialog @attributes="_gaben1"
                                                                Geschlossen="ModusFertig" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @if (_gaben1 is not null && _ebene1 == Editor.Waermesenke)
    {
        <Ueberlagerung Offen="true" Titel="@SenkeTitel" Geschlossen="Ebene1Schliessen">
            <KindInhalt>
                <EPOS.UI.Dialoge.Simulation.WaermesenkeDialog @attributes="_gaben1"
                                                              Geschlossen="SenkeFertig" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @if (_gaben1 is not null && _ebene1 == Editor.Pufferverwaltung)
    {
        <Ueberlagerung Offen="true" Titel="@VerwaltungTitel" Geschlossen="Ebene1Schliessen">
            <KindInhalt>
                <EPOS.UI.Dialoge.Simulation.PufferSpProjektDialog @attributes="_gaben1" TitelAnzeigen="false"
                                                                  Geschlossen="VerwaltungFertig" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @* =================================================================
       EBENE 2 — die drei Quellendialoge aus der Quellenwahl. Ihre eigenen
       Unterdialoge (Pufferverwaltung, Klimazonenkarte) bringen sie selbst
       mit; das ist dann Ebene 3.
       ================================================================= *@

    @if (_gaben2 is not null && _ebene2 == Editor.QuellePuffer)
    {
        <Ueberlagerung Offen="true" Titel="@QuellePufferTitel" Geschlossen="Ebene2Schliessen">
            <KindInhalt>
                <EPOS.UI.Dialoge.Simulation.QuellePufferspeicherDialog @attributes="_gaben2"
                                                                       Geschlossen="QuellePufferFertig" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @if (_gaben2 is not null && _ebene2 == Editor.Quellprofil)
    {
        <Ueberlagerung Offen="true" Titel="@QuellprofilTitel" Geschlossen="Ebene2Schliessen">
            <KindInhalt>
                <EPOS.UI.Dialoge.Simulation.QuellprofilDialog @attributes="_gaben2"
                                                              Geschlossen="QuellprofilFertig" />
            </KindInhalt>
        </Ueberlagerung>
    }

    @if (_gaben2 is not null && _ebene2 == Editor.QuelleErdreich)
    {
        <Ueberlagerung Offen="true" Titel="@ErdreichTitel" Geschlossen="Ebene2Schliessen">
            <KindInhalt>
                <EPOS.UI.Dialoge.Simulation.QuelleErdreichDialog @attributes="_gaben2"
                                                                 Geschlossen="ErdreichFertig" />
            </KindInhalt>
        </Ueberlagerung>
    }
</div>

@code {
    // =====================================================================
    // Steuerwerte der Ansicht (sprachneutral, Drei-Schichten-Regel)
    // =====================================================================

    /// <summary>Steuerwert der Kartenansicht.</summary>
    public const string ANSICHT_LISTE = "LISTE";

    /// <summary>Steuerwert der Schema-Ansicht.</summary>
    public const string ANSICHT_SCHEMA = "SCHEMA";

    // =====================================================================
    // Parameter
    // =====================================================================

    /// <summary>Die Datenseite; ohne sie zeigt die Seite eine leere Konfiguration.</summary>
    [Parameter] public SimulationKonfigDienste? Dienste { get; set; }

    /// <summary>
    /// Der geteilte Zustand der Huelle: Projektwechsel und Auffrischen. Ohne ihn
    /// gilt <see cref="StartProjekt"/>.
    /// </summary>
    [Parameter] public EPOS.UI.Dienste.SeitenZustand? Zustand { get; set; }

    /// <summary>Das Projekt beim Aufbau, wenn kein <see cref="Zustand"/> gesetzt ist.</summary>
    [Parameter] public int StartProjekt { get; set; }

    /// <summary>
    /// Der Stand hat sich geaendert: <c>true</c> = es gibt ungespeicherte
    /// Aenderungen an der Kaskade (Auftrag #207).
    /// </summary>
    /// <remarks>
    /// <b>Warum die Seite das MELDET, statt bloss gefragt zu werden.</b> Die
    /// Ansicht SIMULATION sperrt Schritt ② („Simulation starten"), solange die
    /// Konfiguration ungespeichert ist, und fragt beim Verlassen nach (62b‑E‑1) —
    /// beides auch dann, wenn Schritt ① gerade nicht sichtbar ist. Ein Wirt, der
    /// den Stand selbst haelt, kommt ohne stehende Komponente aus.
    /// </remarks>
    [Parameter] public EventCallback<bool> UngespeichertGeaendert { get; set; }

    /// <summary>
    /// Die FÜNF LAUFPARAMETER des gefallenen Reiters „Parameter" (Windows-Abnahme
    /// <b>#216</b> vom 11.09.2026, Punkt 3); <c>null</c> = die Plattform bietet sie
    /// nicht an, dann steht weder der Abschnitt „Wärmebedarf" noch ein
    /// Parameterbereich an einer Erzeugerkarte.
    /// </summary>
    /// <remarks>
    /// <para><b>Warum hier und nicht im Ergebnis.</b> „Nimm Parameter heraus — die
    /// Netzverluste können an eine andere Stelle." Sie parametrieren den LAUF, nicht
    /// sein Ergebnis: Die Netzverluste gehören zum Wärmebedarf des Projekts, die
    /// drei Erzeugerwerte an die Karte des Erzeugers, den sie betreffen — dorthin,
    /// wo der Anwender ihn ohnehin konfiguriert.</para>
    /// <para><b>Jedes Feld schreibt sofort</b>, wie im abgelösten Reiter; der Knopf
    /// „Konfiguration speichern" darunter gehört der Kaskade und nicht diesen fünf.
    /// Der Schreibweg ist derselbe geblieben (<c>KonfigSchreiben</c> der
    /// Ergebnishülle), die Werte landen in denselben Spalten von
    /// <c>Tab_Einstellungen</c>.</para>
    /// </remarks>
    [Parameter] public SimulationParameterDienste? Parameter { get; set; }

    // ---- Texte (deutscher Rueckfall; die Huelle setzt die Ressourcen) ----

    [Parameter] public string KopfText { get; set; } = "Erzeuger definieren, Pufferspeicher zuordnen:";
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_Simulation_Config.btn_Help";

    /// <summary>
    /// H13 — der ZWEITE Hilfeschlüssel: der RECHENWEG statt der Bedienung. Er zeigt auf
    /// die Wikiseite „Programm Dokumentation/Berechnung/Simulationsablauf"
    /// (help_mapping.txt, Abschnitt „H13 — Rubrik Berechnung").
    /// </summary>
    [Parameter] public string HilfeSchluesselBerechnung { get; set; } = "Form_Simulation_Config.Berechnung";

    /// <summary>Kurztext des Rechenweg-Knopfes, solange der Katalog den Schlüssel nicht kennt.</summary>
    [Parameter] public string HilfeKurztextBerechnung { get; set; } = "Berechnungsweg: Simulationsablauf";

    [Parameter] public string AnsichtLabel { get; set; } = "Ansicht:";
    [Parameter] public string AnsichtListe { get; set; } = "Liste";
    [Parameter] public string AnsichtSchema { get; set; } = "Schema";

    [Parameter] public string KopfErzeuger { get; set; } = "Komponenten der Simulation";
    [Parameter] public string KopfSpeicher { get; set; } = "Speicher im Projekt";

    /// <summary>Werkzeugtipp der Stromspeicherkachel rechts (W10b‑B‑2).</summary>
    [Parameter] public string StromspeicherHinweis { get; set; }
        = "Stromspeicher des Projekts — Betriebsführung links unter „Energiespeicher“.";

    [Parameter] public string AnlageHinzuText { get; set; }
        = "+ Anlage hinzufügen: Anlagen werden über die Projektseite angelegt.";

    [Parameter] public string VerfuegbarEinblenden { get; set; }
        = "+ Nicht gewählte Komponenten anzeigen ({0}) …";
    [Parameter] public string VerfuegbarAusblenden { get; set; }
        = "− Nicht gewählte Komponenten ausblenden";

    /// <summary>SIM_KARTE_NICHT_AUFGENOMMEN_EINER (#190).</summary>
    [Parameter] public string NichtAufgenommenEiner { get; set; }
        = "Ein Erzeuger ist im Projekt angelegt, aber nicht in der Simulation — er rechnet nicht.";

    /// <summary>SIM_KARTE_NICHT_AUFGENOMMEN_MEHRERE ({0} = Anzahl, #190).</summary>
    [Parameter] public string NichtAufgenommenMehrere { get; set; }
        = "{0} Erzeuger sind im Projekt angelegt, aber nicht in der Simulation — sie rechnen nicht.";

    /// <summary>SIM_KARTE_NICHT_AUFGENOMMEN_KNOPF (#190).</summary>
    [Parameter] public string NichtAufgenommenKnopf { get; set; } = "einblenden";

    [Parameter] public string AufnehmenText { get; set; } = "+ aufnehmen";
    [Parameter] public string TipHoch { get; set; } = "In der Kaskade nach vorn";
    [Parameter] public string TipRunter { get; set; } = "In der Kaskade nach hinten";
    [Parameter] public string TipBearbeiten { get; set; } = "Wärmesenken bearbeiten";
    [Parameter] public string TipEntfernen { get; set; } = "Aus der Simulation nehmen";
    [Parameter] public string TipAufnehmen { get; set; } = "In die Simulation aufnehmen";
    [Parameter] public string TipAufklappen { get; set; } = "Gerätedaten anzeigen";

    [Parameter] public string BilanzText { get; set; } = "{0} Lader · {1} Abnehmer";
    [Parameter] public string TipSpeicherBearbeiten { get; set; } = "Pufferspeicher bearbeiten";
    [Parameter] public string TipSpeicherAufklappen { get; set; } = "Einzelheiten anzeigen";
    [Parameter] public string BtnPufferVerwalten { get; set; } = "Pufferspeicher anlegen / verwalten…";

    [Parameter] public string LesepunktText { get; set; }
        = "Booster liest Speicherzustand vom Stundenanfang (konservativ)";

    [Parameter] public string BtnSpeichern { get; set; } = "Konfiguration speichern";

    [Parameter] public string StatusGespeichert { get; set; }
        = "✔ Konfiguration erfolgreich gespeichert";
    [Parameter] public string StatusLesepunktDavor { get; set; }
        = "Der Booster liest den Speicherzustand vom Stundenanfang.";
    [Parameter] public string StatusLesepunktDanach { get; set; }
        = "Der Booster liest den Speicherzustand nach der vorrangigen Anlage.";
    [Parameter] public string StatusEinstellungFehler { get; set; }
        = "Die Einstellung konnte nicht gespeichert werden.";

    [Parameter] public string SchemaLeerText { get; set; }
        = "Für dieses Projekt ist noch keine Hydraulik konfiguriert.";
    [Parameter] public string SchemaWarnungText { get; set; } = "Vorlauf unter dem Puffer-Sollwert";
