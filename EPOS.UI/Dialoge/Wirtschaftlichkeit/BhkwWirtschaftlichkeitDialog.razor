@* Dialog "BHKW-Wirtschaftlichkeit" - die Razor-Fassung (Etappe B5b).

   HERKUNFT. Die WinForms-Fassung Views/Wirtschaftlichkeit/
   Form_BhkwWirtschaftlichkeit.cs (Etappe B5, 03.09.2026) ist mit dieser
   Komponente GELOESCHT - Regel M1 des Umsetzungskonzepts iOS: keine zweite
   Fassung derselben Maske. Uebernommen sind Feldbestand, Reihenfolge,
   Nullsemantik, Zustandslogik, Warn- und Kohaerenzzeilen wortgleich; die
   Beschriftungen kommen aus denselben Schluesseln BHW_*
   (BhkwWirtschaftlichkeitTexte).

   ER RECHNET NICHTS (BW8). Saetze und Herleitung kommen aus dem Bestands-
   rechner KwkgSatzRechner, die Vorschauzahlen und die Steuerherkunft aus dem
   ZULETZT GEBUCHTEN Lauf, die Mengenkette aus KwkgModulNachweis (B3b), die
   Kohaerenzzeilen aus KohaerenzPruefung. Eine Zweitrechnung waere genau die
   zweite Wahrheit, die BW8 verhindern soll.

   ER KENNT KEINE DATENBANK (Hausregel EPOS.UI). Alles kommt als [Parameter]
   herein: die Anlagenzeilen, der Parametersatz, die Ergebnisse des Laufs und
   - als Delegat, wie es KwkgSatzRechner selbst haelt (Leitentscheidung L9) -
   der Zugang zum Gesetzeskatalog. Geschrieben wird ueber die beiden Rueckrufe
   SpeichereAnlage und SpeichereVorgaben; die Huelle ruft damit
   KwkgAnlagenCtrl.Speichere(g, true) (K7, alle Spalten des Dialogs - seit E7c
   samt Kennzeichen und Stromkennzahl der Ueberlagerung „Saetze und Herkunft") bzw.
   WirtschaftlichkeitCtrl.SpeichereParameter.

   ER FUEHRT EINEN ARBEITSSTAND, UND GESCHRIEBEN WIRD IM OK-WEG. Jede Eingabe
   landet in BhkwAnlagenstand bzw. BhkwVorgabenstand - nicht in den Objekten,
   die der Wirt hereingereicht hat. Erst OK legt den Stand auf diese Objekte
   und schreibt sie, in der Reihenfolge Anlagenzeilen (Listenreihenfolge) und
   danach Projektvorgaben. Scheitert ein Schritt, bleibt der Dialog offen und
   nennt die Zahl der gescheiterten Saetze; was geschrieben ist, gilt und wird
   bei einem zweiten OK nicht wiederholt. Abbrechen, das Kreuz der
   Ueberlagerung und Esc verlassen den Dialog OHNE einen einzigen
   Schreibzugriff - und ohne dass ein hereingereichtes Objekt sich veraendert
   haette. Der Sprungknopf "BHKW-Tarif..." nimmt denselben Weg wie OK: Er schreibt
   und schliesst, sonst waeren die Eingaben mit dem Sprung verloren - aber er
   schreibt NUR, wenn sich der Arbeitsstand seit dem Laden wertlich geaendert
   hat. Wer nur nachschlagen will, soll keinen Schreibzugriff ausloesen; ein
   Schreiben ohne Aenderung ueberschriebe in einer Mehrbenutzerlage fremde
   Aenderungen mit dem eigenen geladenen Stand. Scheitert das Schreiben, findet
   der Sprung nicht statt und die Maske bleibt offen.

   NULLSEMANTIK durchgehend: An der Anlage heisst leer bzw. 0 "kein eigener
   Wert - es gilt die Projektvorgabe" (E6-/B3a-Muster); nur beim
   Hilfsenergieanteil heisst 0 "keine Hilfsenergie" (BF4).

   TASTATUR. Eine BlazorWebView sieht AcceptButton und CancelButton des
   Formulars nicht; Esc wird deshalb hier beantwortet. Enter bleibt bewusst
   unbelegt - anders als beim Anlegedialog waere ein versehentliches Enter in
   einer Maske mit dreissig Feldern kein Bestaetigen, sondern ein Zufall. *@

@namespace EPOS.UI.Dialoge.Wirtschaftlichkeit

@using WindowsFormsApplication1
@using Microsoft.AspNetCore.Components.QuickGrid
@using EPOS.UI.Dialoge.Kosten
@implements IDisposable

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: Zeigt der Wirt schon einen Titel - die Ueberlagerung
       der Wirtschaftlichkeitsseite tut es -, bleibt der eigene Kopf weg; der
       Hilfeknopf bleibt immer. Der Titel ist hier ein gerechneter Kopftitel
       (Textbuendel plus Stammname), kein leerbares TitelText. Das Kreuz steht
       beim Titel und geht denselben Weg wie Esc: Verwerfen, ohne zu schreiben. *@
    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@Kopftitel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Verwerfen" />
        }
    </div>

    @* ------------------------------------------------ Gruppe 1: Anlagen *@
    <Gruppenkopf Titel="@_t.G1" Symbol="⚙">
        <KindInhalt>
            <Raster TZeile="KwkgAnlagenAngabe" Zeilen="@Anlagen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpWahl">
                        <button type="button"
                                class="@Wahlklasse(context)"
                                aria-pressed="@(Gewaehlt(context) ? "true" : "false")"
                                @onclick="() => Waehle(context)">@(Gewaehlt(context) ? "●" : "○")</button>
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpProjekt">
                        @context.Projektname
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpAnlage">
                        @context.Bezeichner
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpPel">
                        @context.PelKW.ToString("N0", BhwTexte.Kultur)
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpBrennstoff">
                        @context.Brennstoffname
                    </TemplateColumn>
                    @* Die drei Spalten zeigen den ARBEITSSTAND, nicht die geladene
                       Zeile - sonst widerspraeche die Tabelle den Feldern darunter. *@
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpStichtag">
                        @BhwTexte.Kurzdatum(Tag(Stand(context).Stichtag))
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpIbn">
                        @BhwTexte.Kurzdatum(Tag(Stand(context).Inbetriebnahme))
                    </TemplateColumn>
                    <TemplateColumn TGridItem="KwkgAnlagenAngabe" Title="@_t.SpAnlagenart">
                        @BhkwWahlen.TextZu(_artA, Stand(context).Anlagenart)
                    </TemplateColumn>
                </KindInhalt>
            </Raster>

            @foreach (string zeile in Anlagenwarnungen())
            {
                <Warnbanner Stufe="WarnStufe.Warnung" Text="@zeile" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------- Gruppe 1b: Angaben der gewaehlten Anlage *@
    <Gruppenkopf Titel="@_t.G1b">
        <KindInhalt>
            @if (AktuellerStand is null)
            {
                <Herleitungszeile Text="@_t.AOhneWahl" />
            }
            else
            {
                @* Formularraster (iU8-E-2 / W14a-E-7, Paket P2): Beschriftung neben
                   dem Feld, Zahlenfelder kurz mit der Einheit dahinter. Die
                   Herleitungszeile bleibt ausserhalb - sie ist ein Satz, kein Feld. *@
                <Formularraster>
                    <KindInhalt>
                    <Datumsfeld Bezeichnung="@_t.AStichtag"
                                Wert="@Tag(AktuellerStand.Stichtag)" WertChanged="StichtagA" />

                    <Datumsfeld Bezeichnung="@_t.AIbn"
                                Wert="@Tag(AktuellerStand.Inbetriebnahme)" WertChanged="IbnA" />

                    <Auswahlfeld Bezeichnung="@_t.AAnlagenart"
                                 Eintraege="@BhkwWahlen.Eintraege(_artA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_artA, AktuellerStand.Anlagenart)"
                                 AuswahlChanged="ArtA" />

                    <Auswahlfeld Bezeichnung="@_t.AEigenfall"
                                 Eintraege="@BhkwWahlen.Eintraege(_fallA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_fallA, AktuellerStand.Eigenfall)"
                                 AuswahlChanged="FallA" />

                    @* ETAPPE BK1 (Anwenderwunsch 17.09.2026, Entscheid BK-E-1 a):
                       DER KNOPF STEHT AM FELD, und die Grundlage daneben. Ein
                       Sammelknopf am Ende der Gruppe schrieb mehrere Felder auf
                       einmal; wer ihn drueckte, sah erst danach, was er getroffen
                       hatte. Die Vorschlagszeile spannt im Formularraster ueber die
                       volle Breite und steht damit unter IHREM Feld.

                       VIER NACHKOMMASTELLEN, wie WPAR_EINSP_KWK sie fuehrt: Der
                       Vorschlagsknopf schreibt den gerechneten Satz UNGERUNDET in
                       den Arbeitsstand (300 kW: 5,5667 ct/kWh). Zeigte das Feld nur
                       zwei Stellen, sah der Anwender 5,57 - und die naechste
                       Beruehrung des Feldes meldete genau diese 5,57 zurueck:
                       0,0033 ct/kWh weniger, still. Der Kern kennt keinen
                       Rueckfall, das Feld IST der Satz
                       (WirtschaftlichkeitCtrl.SatzEigenDerAnlage). *@
                    <Zahlenfeld Bezeichnung="@_t.ASatzEinsp" Einheit="ct/kWh"
                                Min="0" Max="30" Nachkommastellen="4"
                                Wert="@AktuellerStand.SatzEinspCt" WertChanged="SatzEinspA" />
                    <Vorschlagszeile Text="@GrundlageEinsp()" Knopftext="@_t.BtnVorschlagFeld"
                                     Erlaubt="@VorschlagEinspErlaubt"
                                     Sperrgrund="@_t.SperrOhnePel"
                                     Uebernommen="VorschlagEinspUebernehmen" />

                    <Zahlenfeld Bezeichnung="@_t.ASatzEigen" Einheit="ct/kWh"
                                Min="0" Max="30" Nachkommastellen="4"
                                Wert="@AktuellerStand.SatzEigenCt" WertChanged="SatzEigenA" />
                    <Vorschlagszeile Text="@GrundlageEigen()" Knopftext="@_t.BtnVorschlagFeld"
                                     Erlaubt="@VorschlagEigenErlaubt"
                                     Sperrgrund="@SperrgrundEigen"
                                     Uebernommen="VorschlagEigenUebernehmen" />

                    <Zahlenfeld Bezeichnung="@_t.AKontingent" Einheit="h"
                                Min="0" Max="200000" Nachkommastellen="0"
                                Wert="@AktuellerStand.VbhKontingent" WertChanged="KontingentA" />
                    <Vorschlagszeile Text="@GrundlageKontingent()" Knopftext="@_t.BtnVorschlagFeld"
                                     Erlaubt="@VorschlagKontingentErlaubt"
                                     Sperrgrund="@_t.SperrOhneAnlagenart"
                                     Uebernommen="VorschlagKontingentUebernehmen" />

                    <Zahlenfeld Bezeichnung="@_t.ADeckel" Einheit="h/a"
                                Min="0" Max="8760" Nachkommastellen="0"
                                Wert="@AktuellerStand.VbhDeckel" WertChanged="DeckelA" />

                    @* BK1: Der Kostenanteil gehoert zur Anlage, weil § 8 Abs. 2/3 die
                       Kontingentstufe aus IHREM Anteil waehlt (Schemaschritt 89). *@
                    <Zahlenfeld Bezeichnung="@_t.AKostenanteil" Einheit="%"
                                Min="0" Max="100" Nachkommastellen="1"
                                Wert="@AktuellerStand.Kostenanteil" WertChanged="KostenanteilA" />

                    <Auswahlfeld Bezeichnung="@_t.AEnergiesteuer"
                                 Eintraege="@BhkwWahlen.Eintraege(_esA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_esA, AktuellerStand.EnergiesteuerWahl)"
                                 AuswahlChanged="EnergiesteuerA" />

                    <Auswahlfeld Bezeichnung="@_t.AAufteilung"
                                 Eintraege="@BhkwWahlen.Eintraege(_aufA)"
                                 Auswahl="@BhkwWahlen.NummerZu(_aufA, AktuellerStand.AufteilungMethode)"
                                 AuswahlChanged="AufteilungA" />

                    @* K2/K6: Die Bemessungsbasis steht ausdruecklich in der Beschriftung -
                       gerechnet wird am ENDENERGIEbedarf (Brennstoff) der Anlage, nicht an
                       den Kosten; die Saetze der beiden Wege sind nicht austauschbar.
                       Das Feld ist nur fuer BHKW-Anlagen gedacht (AnteilPflegbar). *@

                    @if (AnteilSichtbar)
                    {
                        <Zahlenfeld Bezeichnung="@_t.AHilfsanteil" Einheit="%"
                                    Min="0" Max="100" Nachkommastellen="1"
                                    Wert="@AktuellerStand.HilfsenergieAnteil" WertChanged="HilfsAnteilA" />
                    }
                    </KindInhalt>
                </Formularraster>

                @if (AnteilSichtbar)
                {
                    <Herleitungszeile Text="@_t.AHilfsBasis" />
                }

                @* ETAPPE E7c (Befund K-1, Entscheid E7-Q2 (5)): der Fall des § 2 Nr. 16
                   KWKG dieser Anlage als Zeile, und der Knopf in die Ueberlagerung
                   „Saetze und Herkunft", die Kennzeichen und Stromkennzahl pflegt. Bewusst
                   KEINE Vorschlagszeile (epos-vorschlag): Der Knopf uebernimmt keinen
                   Vorschlag, er oeffnet die Ueberlagerung. *@
                <p class="epos-herleitung epos-kwkstrom">
                    <span class="epos-herleitung-text">@KwkStromZeile()</span>
                    <button type="button" class="epos-knopf epos-ueb-oeffnen"
                            @onclick="UebOeffnen">@_t.UebKnopf</button>
                </p>
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------- Gruppe 2: KWK-Zuschlag *@
    <Gruppenkopf Titel="@_t.G2">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                @* AUFTRAG #325 (Anwenderwunsch 17.09.2026): "heraus nehmen aus
                   Parameter Dialog: … Strom — Einspeisung und Bezug und in
                   BHKW-Dialog Kosten". Der Satz, mit dem der EINGESPEISTE KWK-Strom
                   verguetet wird, steht jetzt hier - bei den Geldgroessen des BHKW
                   und nicht mehr in einem Sammelabschnitt der
                   Wirtschaftlichkeits-Parameter. Er steht VOR den Zuschlaegen, weil
                   er die Verguetung ist und der Zuschlag obendrauf kommt.

                   DIESELBE WAHRHEIT, andere Eingabestelle: Es ist unveraendert
                   WirtschaftlichkeitParameter.EinspeiseverguetungKWK in EUR/kWh, und
                   geschrieben wird er wie die uebrigen Projektvorgaben dieser Gruppe
                   ueber den Arbeitsstand erst im OK-Weg.

                   0 HEISST "NICHT GEPFLEGT" - die Regel zieht mit. Eine gepflegte 0
                   waere die Aussage "bringt nichts ein" und von einem nie
                   angefassten Feld an dieser Zahl nicht zu unterscheiden. *@
                <Zahlenfeld Bezeichnung="@_t.PEinspKwk" Einheit="€/kWh"
                            Min="0" Max="2" Nachkommastellen="4"
                            Wert="@(_vorgaben.EinspeiseverguetungKwk ?? 0)"
                            WertChanged="EinspeisungKwkP" />

                @* ETAPPE BK1 (Entscheid BK-E-1 a) und BK1b (Entscheid BK1-4 a): HIER
                   STEHT NUR NOCH, WAS WIRKLICH PROJEKTWEIT IST. Satz, Kontingent,
                   Jahresdeckel, Anlagenart, Tatbestand und Kostenanteil sind seit
                   Schemaschritt 89 Angaben DER ANLAGE - § 7 bemisst den Satz an ihrer
                   Leistung, § 8 das Kontingent an ihrer Anlagenart UND ihrem
                   Kostenanteil. Sie hier ein zweites Mal zu fuehren, war die doppelte
                   Wahrheit samt Rueckfallkette, die BK1 aufloest. *@
                <Zahlenfeld Bezeichnung="@_t.PAbschlag" Einheit="%"
                            Min="0" Max="50" Nachkommastellen="1"
                            Wert="@_vorgaben.KwkgAbschlagNegativ" WertChanged="AbschlagP" />

                <Schalter Bezeichnung="@_t.PPauschal"
                          Wert="@_vorgaben.KwkgPauschalmodus" WertChanged="PauschalP" />

                <Datumsfeld Bezeichnung="@_t.PStichtag"
                            Wert="@Tag(_vorgaben.KwkgStichtag)" WertChanged="StichtagP" />

                @* BK1: Dasselbe Feld, neu beschriftet. Es ist keine "Vorgabe je
                   Anlage" mehr, sondern der FOERDERBEGINN - das Startjahr ALLER
                   jahresscharfen Reihen (KWKG, CO2, Steuern), auch ohne BHKW. *@
                <Datumsfeld Bezeichnung="@_t.PIbn"
                            Wert="@Tag(_vorgaben.KwkgInbetriebnahme)" WertChanged="IbnP" />
                </KindInhalt>
            </Formularraster>

            @* AUFTRAG #325 / SP-E-5 (a): Was der Einspeisesatz sonst noch bewegt.
               Wer ihn aendert, aendert die Speicherrechnung mit - und das muss
               dort stehen, wo er ihn aendert. *@
            <Herleitungszeile Text="@_t.PEinspKwkHinweis" />

            @* ETAPPE E9b (Konzept § 2.11.5, Pflege; E9b-Q1): der ±-Knopf der
               Einspeiseverguetung KWK - HIER, weil ihr Erwartet-Wert hier gepflegt wird
               ("dasselbe Muster wandert an jeden Ort, an dem ein Erwartet-Wert gepflegt
               wird"). Das Paar steht im Szenariosatz des Parametersatzes
               (SzenarioSatz.EinspeiseverguetungKwk, Schemaschritt 118) und reist wie
               die uebrigen Projektvorgaben im Arbeitsstand bis zum OK-Weg. Ist es
               gepflegt und das Tarif-Rollenmodell wirksam, sagt die Kohaerenzzeile, dass
               es im Lauf nicht wirkt (E9a-Q7). *@
            <div class="epos-szenarioleiste">
                <SzenarioKnopf Text="@_t.SzEinspKwk" Gepflegt="@EinspeisungKwkSzenarioGepflegt"
                               Kurztext="@EinspeisungKwkSzenarioKurztext"
                               GepflegtText="@_sz.Gepflegt" WarnungText="@_sz.OhneErwartetKurz"
                               Angefordert="EinspeisungKwkSzenarioOeffnen" />
            </div>
            @if (EinspeisungKwkSzenarioGepflegt)
            {
                @foreach (string hinweis in EinspeisungKwkSzenarioHinweise)
                {
                    <Kohaerenzzeile Text="@hinweis" Zustand="KohaerenzZustand.Abweichend" />
                }
            }

            @* BK1: Wo die uebrigen KWK-Angaben hin sind - sonst sucht ein Anwender,
               der den Dialog kennt, die Saetze. *@
            <Herleitungszeile Text="@_t.PNurProjektweit" />
        </KindInhalt>
    </Gruppenkopf>

    @* -------------------------------------------- Gruppe 3: Energiesteuer *@
    <Gruppenkopf Titel="@_t.G3">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                <Auswahlfeld Bezeichnung="@_t.EWahl"
                             Eintraege="@BhkwWahlen.Eintraege(_esP)"
                             Auswahl="@BhkwWahlen.NummerZu(_esP, _vorgaben.EnergiesteuerWahl)"
                             AuswahlChanged="EnergiesteuerP" />

                <Auswahlfeld Bezeichnung="@_t.EAufteilung"
                             Eintraege="@BhkwWahlen.Eintraege(_aufP)"
                             Auswahl="@BhkwWahlen.NummerZu(_aufP, _vorgaben.AufteilungMethode)"
                             AuswahlChanged="AufteilungP" />

                @* K5: Der Jahresnutzungsgrad bleibt eine PROJEKTgroesse (B3a-Stand) - ein
                   anlagenscharfer Wert waere eine eigene Datenfrage. *@
                <Zahlenfeld Bezeichnung="@_t.ENutzungsgrad" Einheit="%"
                            Min="0" Max="100" Nachkommastellen="1"
                            Wert="@_vorgaben.Jahresnutzungsgrad" WertChanged="NutzungsgradP" />
                </KindInhalt>
            </Formularraster>

            <Herleitungszeile Text="@Steuerherkunft()" />

            @* ETAPPE E7c2 (U22): der zweite Weg in die Ueberlagerung „Saetze und
               Herkunft" — „Wahl und Herkunft…" bei der Energiesteuer. Er oeffnet dieselbe
               Ueberlagerung fuer die gewaehlte Anlage; ohne Anlage gibt es keinen
               Zwischenstand und deshalb keinen Knopf. *@
            @if (AktuellerStand is not null)
            {
                <button type="button" class="epos-knopf epos-ueb-oeffnen-steuern"
                        @onclick="UebOeffnen">@_t.UebKnopfSteuern</button>
            }
        </KindInhalt>
    </Gruppenkopf>

    @* --------------------------------------------- Gruppe 4: Stromsteuer *@
    <Gruppenkopf Titel="@_t.G4">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                @* BW4: Die Unternehmensart ist das fuehrende Feld der Stromsteuerseite. *@
                <Auswahlfeld Bezeichnung="@_t.SUnternehmensart"
                             Eintraege="@BhkwWahlen.Eintraege(_uaP)"
                             Auswahl="@BhkwWahlen.NummerZu(_uaP, _vorgaben.Unternehmensart)"
                             AuswahlChanged="UnternehmensartP" />

                <Schalter Bezeichnung="@_t.SRaeumlich"
                          Wert="@_vorgaben.RaeumlicherZusammenhang" WertChanged="RaeumlichP" />

                <Schalter Bezeichnung="@_t.SHocheffizienz"
                          Wert="@_vorgaben.HocheffizienzNachweis" WertChanged="HocheffizienzP" />

                @* Das Modusfeld des § 9 Abs. 1 Nr. 3 (BW3) schreibt seit dem
                   Schemaschritt 88 nach Tab_ProjektWirtschaftlichkeit.Stromst_Befreiung_Modus.
                   Vorgabe ist AUSWEIS - NummerZu faellt auf den ersten Eintrag zurueck,
                   solange nichts gepflegt ist. *@
                <Auswahlfeld Bezeichnung="@_t.SModus"
                             Eintraege="@BhkwWahlen.Eintraege(_modus)"
                             Auswahl="@BhkwWahlen.NummerZu(_modus, _vorgaben.StromsteuerBefreiungModus)"
                             AuswahlChanged="BefreiungsmodusP" />
                </KindInhalt>
            </Formularraster>

            @* ETAPPE E18 (Konzept § 6.3 Nr. 16): der Rueckweg zur Unternehmensart - der
               im Strompreis erfasste Stromsteueranteil, NUR ANZEIGE; gepflegt wird er
               in "Strompreis Details" des Energietraegers. *@
            <div class="epos-stanteil">
                @foreach (StromsteueranteilZeile z in StAnteilZeilen(_vorgaben.Unternehmensart))
                {
                    @if (z.Zustand is KohaerenzZustand zustand)
                    {
                        <Kohaerenzzeile Text="@z.Text" Zustand="@zustand" />
                    }
                    else
                    {
                        <Herleitungszeile Text="@z.Text" />
                    }
                }
            </div>

            <Herleitungszeile Text="@_t.SModusHerleitung" />

            @* Kein Funktionsverlust durch K8 = c: Der Knopf der Wirtschaftlichkeitsseite,
               der bis B5 die BHKW-Sicht der Tarifstruktur oeffnete, fuehrt jetzt hierher -
               die Sicht selbst bleibt ueber diesen Sprung erreichbar. Der zweite Sprung
               "Strombezug..." ist mit Q11 entfallen: Den Zeitzonentarif gibt es nicht
               mehr, und die Leistungspreis-Staffel pflegt der Stromtraeger in der
               Kostenverwaltung. *@
            <button type="button" class="epos-knopf epos-sprung"
                    @onclick="SprungBhkwTarif">@_t.BtnBhkwTarif</button>

            @* Der Satz kuendigt das Schreiben an - er steht deshalb nur, wenn ein
               Sprung jetzt wirklich schreiben wuerde (Anwenderentscheid 15.09.2026). *@
            @if (SprungSchreibtMit)
            {
                <Herleitungszeile Text="@_t.SSprungHinweis" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------- Kohaerenzpruefung (A-2) *@
    <Gruppenkopf Titel="@_t.GKohaerenz">
        <KindInhalt>
            @if (SteuerlicheHinweise().Count == 0)
            {
                <Kohaerenzzeile Zustand="KohaerenzZustand.Ok" Text="@_t.KLeer" />
            }
            else
            {
                @foreach (KohaerenzHinweis h in SteuerlicheHinweise())
                {
                    <Warnbanner Stufe="@Stufe(h.Schwere)" Text="@h.Text" />
                }
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ---------------------------------------------- Gruppe 5: Hilfsstrom *@
    <Gruppenkopf Titel="@_t.G5">
        <KindInhalt>
            @* K1: Es gibt bewusst KEIN Feld "Deckung je Modul" - die Spalte ist mit
               § 4.5 des Konzepts gestrichen (BW6). *@
            <Herleitungszeile Text="@_t.HBasis" />

            @foreach (string zeile in Mengenkette())
            {
                <Herleitungszeile Text="@zeile" />
            }

            @foreach (KohaerenzHinweis h in Doppelpflegehinweise())
            {
                <Warnbanner Stufe="@Stufe(h.Schwere)" Text="@h.Text" />
            }

            @* K6: Der Anteil gilt formal fuer jede Anlagenart, gelesen wird er in B3 aber
               nur fuer BHKW und Kessel. Gepflegt wird er hier allein am BHKW; fuer Kessel
               steht hier der Verweis, die Waermepumpe kommt spaeter. *@
            @if (Kesselhinweis)
            {
                <Herleitungszeile Text="@_t.HKessel" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------------------ Gruppe 6: Vorschau *@
    <Gruppenkopf Titel="@_t.G6" Symbol="Σ">
        <KindInhalt>
            @foreach ((string Titel, string Wert) z in Vorschau())
            {
                <Herleitungszeile Text="@z.Titel" Formel="@z.Wert" />
            }
        </KindInhalt>
    </Gruppenkopf>

    @* ETAPPE E13 (E7c3-Q6 a): Ladefehler und Vorsorgewarnung des Kerns, je Grund einmal. *@
    @foreach (string zeile in Fehlergruende())
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@zeile" />
    }

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_meldung" />
    }

    @* Zwei Ausgaenge, wie in jeder Maske des Hauses: OK schreibt den ganzen
       Arbeitsstand und schliesst, Abbrechen verlaesst ihn ohne einen einzigen
       Schreibzugriff. Einen nicht schliessenden Speichern-Knopf gibt es nicht
       mehr - er war der Grund, warum diese Maske kein Abbrechen tragen konnte. *@
    <SpeichernLeiste @ref="_leiste" MitSpeichern="false" MitAbbrechen="true"
                     OkText="@_t.Speichern" AbbrechenText="@_t.Abbrechen"
                     Ergebnis="BeiErgebnis" />

    @* ETAPPE E7c (Befund K-1, Entscheid E7-Q2 (5)) und E7c2 (E7c1-Q7) — die
       Ueberlagerung „Saetze und Herkunft" (Mockup U22). Sie trifft jede Wahl, die einen
       Satz bestimmt, nennt zu jedem Satz Vorschlag und Herkunft, fuehrt je Groesse einen
       eigenen Wert (leer = der Vorschlag gilt) und zeigt unten die Wirkung im ersten
       Jahr. Drei Gruppen: KWK-Zuschlag dieser Anlage (Anlagenart, Tatbestand, Fall des
       § 2 Nr. 16 mit Stromkennzahl, Satztafel, Wirkung Jahr 1), Energiesteuer (Geltung
       Projekt oder Anlage, Entlastung, Aufteilung) und Stromsteuer des Projekts
       (Unternehmensart, Befreiung § 9 Abs. 1 Nr. 3, Modus).

       ETAPPE E7c3 (Mockup U22, E7c2-Q8 b): Jede Wahl steht als ANZEIGEZEILE — Wahlknopf,
       Text und dahinter ihre Wirkung (Optionsgruppe.Wirkungen); die Energiesteuer nennt je
       Wahl Satz und Betrag aus der Vorschau des Kerns
       (WirtschaftlichkeitErgebnis.EnergiesteuerVorschau). Die Klapplisten des Formulars
       bleiben: gewaehlt wird dort oder hier.

       Gerechnet wird NICHTS: Vorschlaege aus KwkgSatzRechner/KwkgKontingentRechner/
       KwkStromRechner, die Wirkung aus KwkgJahresbetrag — denselben Funktionen, die der
       Lauf ruft — mit den Mengen des zuletzt gebuchten Laufs. Die Ueberlagerung fuehrt
       einen EIGENEN Zwischenstand (Kopien von Anlagen- und Projektstand); „Uebernehmen"
       legt ihn auf den Arbeitsstand, geschrieben wird erst im OK-Weg des Dialogs.
       Abbrechen, das Kreuz und Esc aendern nichts. *@
    <Ueberlagerung Offen="@_uebOffen" Titel="@UebTitel" Geschlossen="UebAbbrechen">
        <KindInhalt>
            @if (_uebA is not null && _uebP is not null)
            {
            <div class="epos-ueb-saetze">
                <Gruppenkopf Titel="@_t.UebGKwkg">
                    <KindInhalt>
                        <div class="epos-ueb-art">
                            <Optionsgruppe Bezeichnung="@_t.UebArt"
                                           Eintraege="@ArtEintraege()"
                                           Auswahl="@ArtAuswahl()"
                                           AuswahlChanged="UebArt"
                                           Wirkungen="@ArtWirkungen()" />
                            <Herleitungszeile Text="@_t.UebArtHinweis" />
                        </div>

                        <div class="epos-ueb-eigenfall">
                            <Optionsgruppe Bezeichnung="@_t.UebEigenfall"
                                           Eintraege="@BhkwWahlen.Eintraege(_fallA)"
                                           Auswahl="@EigenfallAuswahl()"
                                           AuswahlChanged="UebEigenfall"
                                           Wirkungen="@EigenfallWirkungen()" />
                        </div>

                        <div class="epos-ueb-fall">
                            <Optionsgruppe Bezeichnung="@_t.UebKwkStrom"
                                           Eintraege="@FallEintraege()"
                                           Auswahl="@(_uebA.Abwaermeabfuhr ? 1 : 0)"
                                           AuswahlChanged="UebFall"
                                           Wirkungen="@FallWirkungen()" />
                        </div>

                        <div class="epos-raster-huelle">
                            <table class="epos-raster epos-ueb-herkunft">
                                <thead>
                                    <tr>
                                        <th>@_t.UebSpGroesse</th>
                                        <th>@_t.UebSpVorschlag</th>
                                        <th>@_t.UebSpHerkunft</th>
                                        <th>@(_t.UebSpEigen + " (" + _t.UebLeerVorschlag + ")")</th>
                                        <th>@_t.UebSpGilt</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr class="epos-ueb-sigma">
                                        <td>@_t.UebSigma</td>
                                        <td class="epos-zahl">@SigmaVorschlagText()</td>
                                        <td>@SigmaHerkunft()</td>
                                        <td>
                                            <Zahlenfeld Min="0" Max="5" Nachkommastellen="3"
                                                        Wert="@_uebA.Stromkennzahl" WertChanged="UebSigma" />
                                            <button type="button" class="epos-knopf epos-ueb-vorschlag"
                                                    title="@(SigmaVorschlagErlaubt ? null : _t.UebHerkunftSigmaOhne)"
                                                    aria-disabled="@(SigmaVorschlagErlaubt ? "false" : "true")"
                                                    @onclick="UebSigmaVorschlag">@_t.BtnVorschlagFeld</button>
                                        </td>
                                        <td>@SigmaGilt()</td>
                                    </tr>
                                    <tr class="epos-ueb-einsp">
                                        <td>@_t.UebZEinsp</td>
                                        <td class="epos-zahl">@SatzVorschlagText(UebSatzvorschlag().SatzEinspeisungCt)</td>
                                        <td>@UebSatzvorschlag().HerleitungEinspeisung</td>
                                        <td>
                                            <Zahlenfeld Min="0" Max="30" Nachkommastellen="4"
                                                        Wert="@_uebEinsp" WertChanged="UebEinsp" />
                                            <button type="button" class="epos-knopf epos-ueb-vorschlag"
                                                    title="@(SatzVorschlagErlaubt ? null : _t.SperrOhnePel)"
                                                    aria-disabled="@(SatzVorschlagErlaubt ? "false" : "true")"
                                                    @onclick="UebEinspVorschlag">@_t.BtnVorschlagFeld</button>
                                        </td>
                                        <td>@SatzGilt(_uebEinsp, UebSatzvorschlag().SatzEinspeisungCt)</td>
                                    </tr>
                                    <tr class="epos-ueb-eigen">
                                        <td>@_t.UebZEigen</td>
                                        <td class="epos-zahl">@SatzVorschlagText(UebSatzvorschlag().SatzEigenCt)</td>
                                        <td>@UebSatzvorschlag().HerleitungEigen</td>
                                        <td>
                                            <Zahlenfeld Min="0" Max="30" Nachkommastellen="4"
                                                        Wert="@_uebEigen" WertChanged="UebEigen" />
                                            <button type="button" class="epos-knopf epos-ueb-vorschlag"
                                                    title="@(SatzVorschlagErlaubt ? null : _t.SperrOhnePel)"
                                                    aria-disabled="@(SatzVorschlagErlaubt ? "false" : "true")"
                                                    @onclick="UebEigenVorschlag">@_t.BtnVorschlagFeld</button>
                                        </td>
                                        <td>@SatzGilt(_uebEigen, UebSatzvorschlag().SatzEigenCt)</td>
                                    </tr>
                                    <tr class="epos-ueb-kontingent">
                                        <td>@_t.UebZKontingent</td>
                                        <td class="epos-zahl">@KontingentVorschlagText()</td>
                                        <td>@UebKontingentvorschlag().Herleitung</td>
                                        <td>
                                            <Zahlenfeld Min="0" Max="200000" Nachkommastellen="0"
                                                        Wert="@_uebKontingent" WertChanged="UebKontingent" />
                                            <button type="button" class="epos-knopf epos-ueb-vorschlag"
                                                    title="@(KontingentVorschlagErlaubt ? null : _t.SperrOhneAnlagenart)"
                                                    aria-disabled="@(KontingentVorschlagErlaubt ? "false" : "true")"
                                                    @onclick="UebKontingentVorschlag">@_t.BtnVorschlagFeld</button>
                                        </td>
                                        <td>@KontingentGilt()</td>
                                    </tr>
                                    <tr class="epos-ueb-deckel">
                                        <td>@_t.UebZDeckel</td>
                                        <td class="epos-zahl">@_t.UebStaffel</td>
                                        <td>@DeckelHerkunft()</td>
                                        <td>
                                            <Zahlenfeld Min="0" Max="8760" Nachkommastellen="0"
                                                        Wert="@_uebDeckel" WertChanged="UebDeckel" />
                                            <button type="button" class="epos-knopf epos-ueb-vorschlag"
                                                    @onclick="UebDeckelVorschlag">@_t.BtnVorschlagFeld</button>
                                        </td>
                                        <td>@DeckelGilt()</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <Herleitungszeile Text="@_t.UebInfo" />
                        <Herleitungszeile Text="@_t.UebInfoSaetze" />

                        <div class="epos-ueb-wirkung epos-ueb-wirkung-kwkg">
                            @foreach (string zeile in WirkungKwkg())
                            {
                                <Herleitungszeile Text="@zeile" />
                            }
                        </div>
                    </KindInhalt>
                </Gruppenkopf>

                <Gruppenkopf Titel="@_t.UebGEnergiest">
                    <KindInhalt>
                        <div class="epos-ueb-es-scope">
                            <Optionsgruppe Bezeichnung="@_t.UebScope"
                                           Eintraege="@ScopeEintraege()"
                                           Auswahl="@(_uebNurAnlage ? 1 : 0)"
                                           AuswahlChanged="UebScope" />
                        </div>

                        <div class="epos-ueb-es-wahl">
                            <Optionsgruppe Bezeichnung="@_t.UebEsWahl"
                                           Eintraege="@BhkwWahlen.Eintraege(_esP)"
                                           Auswahl="@BhkwWahlen.NummerZu(_esP, UebEsWahlWert())"
                                           AuswahlChanged="UebEsWahl"
                                           Wirkungen="@EsWirkungen()" />
                        </div>

                        <div class="epos-ueb-es-aufteilung">
                            <Optionsgruppe Bezeichnung="@_t.UebEsAufteilung"
                                           Eintraege="@BhkwWahlen.Eintraege(_aufP)"
                                           Auswahl="@BhkwWahlen.NummerZu(_aufP, UebAufteilungWert())"
                                           AuswahlChanged="UebAufteilung"
                                           Wirkungen="@AufteilungWirkungen()" />
                        </div>

                        @if (EsVorschauHinweis() is { Length: > 0 } vorschauHinweis)
                        {
                            <Herleitungszeile Text="@vorschauHinweis" />
                        }
                        <Herleitungszeile Text="@Steuerherkunft()" />

                        <div class="epos-ueb-wirkung epos-ueb-wirkung-es">
                            @foreach (string zeile in WirkungEnergiesteuer())
                            {
                                <Herleitungszeile Text="@zeile" />
                            }
                        </div>
                    </KindInhalt>
                </Gruppenkopf>

                <Gruppenkopf Titel="@_t.UebGStromst">
                    <KindInhalt>
                        <div class="epos-ueb-ua">
                            <Optionsgruppe Bezeichnung="@_t.UebUa"
                                           Eintraege="@BhkwWahlen.Eintraege(_uaP)"
                                           Auswahl="@BhkwWahlen.NummerZu(_uaP, _uebP.Unternehmensart)"
                                           AuswahlChanged="UebUnternehmensart"
                                           Wirkungen="@UnternehmensartWirkungen()" />
                        </div>

                        @* ETAPPE E18: derselbe Rueckweg wie in Gruppe 4, zur Wahl der Ueberlagerung. *@
                        <div class="epos-stanteil epos-ueb-stanteil">
                            @foreach (StromsteueranteilZeile z in StAnteilZeilen(_uebP.Unternehmensart))
                            {
                                @if (z.Zustand is KohaerenzZustand zustand)
                                {
                                    <Kohaerenzzeile Text="@z.Text" Zustand="@zustand" />
                                }
                                else
                                {
                                    <Herleitungszeile Text="@z.Text" />
                                }
                            }
                        </div>

                        <Formularraster>
                            <KindInhalt>
                            <Schalter Bezeichnung="@_t.SHocheffizienz"
                                      Wert="@_uebP.HocheffizienzNachweis" WertChanged="UebHocheffizienz" />
                            <Schalter Bezeichnung="@_t.SRaeumlich"
                                      Wert="@_uebP.RaeumlicherZusammenhang" WertChanged="UebRaeumlich" />
                            </KindInhalt>
                        </Formularraster>

                        <div class="epos-ueb-modus">
                            <Optionsgruppe Bezeichnung="@(_t.UebBefreiung + " — " + _t.UebModus)"
                                           Eintraege="@BhkwWahlen.Eintraege(_modus)"
                                           Auswahl="@BhkwWahlen.NummerZu(_modus, _uebP.StromsteuerBefreiungModus)"
                                           AuswahlChanged="UebModus"
                                           Wirkungen="@ModusWirkungen()" />
                        </div>

                        <div class="epos-ueb-wirkung epos-ueb-wirkung-st">
                            @foreach (string zeile in WirkungStromsteuer())
                            {
                                <Herleitungszeile Text="@zeile" />
                            }
                        </div>
                    </KindInhalt>
                </Gruppenkopf>

                <Herleitungszeile Text="@_t.UebFuss" />

                <div class="epos-leiste">
                    <button type="button" class="epos-knopf" @onclick="UebAbbrechen">@_t.Abbrechen</button>
                    <button type="button" class="epos-knopf epos-knopf--primaer"
                            @onclick="UebUebernehmen">@_t.UebUebernehmen</button>
                </div>
            </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* ETAPPE E9b: das Szenariopaar der Einspeiseverguetung KWK - der CaseEingabeDialog
       als allgemeiner Baustein (E9b-Q1). Ein Titel, eine Stelle: Die Ueberlagerung traegt
       Titel und Kreuz, TitelText="" steht RECHTS vom Satz. OK legt die Werte auf den
       Arbeitsstand der Projektvorgaben; geschrieben wird im OK-Weg des Dialogs. *@
    <Ueberlagerung Offen="@(_szenarioGaben is not null)" Titel="@_szenarioTitel"
                   Geschlossen="() => EinspeisungKwkSzenarioFertig(null)">
        <KindInhalt>
            @if (_szenarioGaben is not null)
            {
                <CaseEingabeDialog @attributes="_szenarioGaben" TitelText=""
                                   Geschlossen="EinspeisungKwkSzenarioFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    // =====================================================================
    // Was hereinkommt
    // =====================================================================

    /// <summary>Anzeigename des Stammprojekts - er steht hinter dem Titel.</summary>
    [Parameter] public string StammName { get; set; } = "";

    /// <summary>
    /// Die BHKW-Anlagen der Vergleichsgruppe (<c>KwkgAnlagenCtrl.LadeGruppe</c>),
    /// fertig geladen.
    ///
    /// <para><b>Der Dialog laesst sie bis zum OK in Ruhe.</b> Jede Eingabe steht im
    /// Arbeitsstand (<see cref="BhkwAnlagenstand"/>); erst der OK-Weg legt ihn auf
    /// diese Zeilen und schreibt sie. Nach Abbrechen sind sie unveraendert.</para>
    /// </summary>
    [Parameter] public IList<KwkgAnlagenAngabe> Anlagen { get; set; } = new List<KwkgAnlagenAngabe>();

    /// <summary>Der Parametersatz des Stammprojekts
    /// (<c>WirtschaftlichkeitCtrl.LadeParameter</c>). Auch er bleibt bis zum OK
    /// unangetastet — der Arbeitsstand dazu ist <see cref="BhkwVorgabenstand"/>.</summary>
    [Parameter] public WirtschaftlichkeitParameter Parameter { get; set; } = new WirtschaftlichkeitParameter();

    /// <summary>Id des Stammprojekts - Bezugspunkt von Vorschau und Steuerherkunft.</summary>
    [Parameter] public int IdStamm { get; set; }

    /// <summary>true, wenn die Vergleichsgruppe einen Heizkessel fuehrt
    /// (<c>ErzeugerFlags.Heizkessel</c>) - dann erscheint der K6-Hinweis.</summary>
    [Parameter] public bool HatHeizkessel { get; set; }

    /// <summary>
    /// Lesefassade auf <c>Tab_Gesetzesparameter</c>
    /// (<c>GesetzKatalog.WertMitHerkunft</c>) - dieselbe Uebergabe als Delegat, die
    /// <c>KwkgSatzRechner</c> selbst verlangt (Leitentscheidung L9). <c>null</c> =
    /// kein Katalog; dann gelten die Rueckfallwerte, und die Herleitung sagt es.
    /// </summary>
    [Parameter] public Func<string, int, GesetzParameter>? Katalog { get; set; }

    /// <summary>Die laufunabhaengige Doppelpflege-Pruefung
    /// (<c>KohaerenzPruefung.Pruefe(idStamm, null)</c>) - der Zweig, der keinen
    /// Steuerlauf braucht. Sie ruft die Huelle, weil die Pruefung <c>internal</c> zum
    /// Kern ist.</summary>
    [Parameter] public IReadOnlyList<KohaerenzHinweis> Doppelpflege { get; set; }
        = Array.Empty<KohaerenzHinweis>();

    /// <summary>
    /// Die Ergebnisse des zuletzt GERECHNETEN Laufs, vom Wirt durchgereicht.
    ///
    /// <para>Zwei ihrer Bestandteile sind nicht persistiert und deshalb aus der
    /// Datenbank nicht zu holen: die Kohaerenzhinweise (B2-O4) und die
    /// KWKG-Modulnachweise mit der Mengenkette (E7/B3b). Leere Liste = noch nicht
    /// gerechnet; dann fallen Vorschau und Steuerherkunft auf den gebuchten Stand
    /// zurueck (<see cref="ErgebnisseLaden"/>).</para>
    /// </summary>
    [Parameter] public IReadOnlyList<WirtschaftlichkeitErgebnis> ErgebnisseAusLauf { get; set; }
        = Array.Empty<WirtschaftlichkeitErgebnis>();

    /// <summary>Der gebuchte Stand aus der Datenbank
    /// (<c>WirtschaftlichkeitCtrl.LadeErgebnisse</c>) - nur gerufen, wenn kein Lauf
    /// durchgereicht wurde.</summary>
    [Parameter]
    public Func<IReadOnlyList<int>, IReadOnlyList<WirtschaftlichkeitErgebnis>>? ErgebnisseLaden { get; set; }

    /// <summary>
    /// Schreibt EINE Anlagenzeile (<c>KwkgAnlagenCtrl.Speichere(a, true)</c>, K7,
    /// alle Spalten des Dialogs samt Kennzeichen und Stromkennzahl aus E7c);
    /// <c>false</c> = fehlgeschlagen. <b>Nur im OK-Weg.</b>
    ///
    /// <para><b>Warum je Zeile und nicht ein Rueckruf fuer alles.</b> Scheitert ein
    /// Schritt, bleibt der Dialog offen — und ein zweites OK darf das bereits
    /// Geschriebene nicht wiederholen. Dafuer muss der Dialog wissen, welche Zeile
    /// durch ist; ein Rueckruf, der nur eine Fehlerzahl liefert, sagt es nicht.</para>
    ///
    /// <para><b>Warum kein <c>EventCallback</c>.</b> Der Dialog braucht eine Antwort —
    /// gelungen oder nicht. Ein <c>EventCallback</c> liefert keine; der Rueckruf zum
    /// Schliessen (<see cref="Geschlossen"/>) bleibt deshalb einer, diese hier sind
    /// <see cref="Func{T, TResult}"/>.</para>
    /// </summary>
    [Parameter] public Func<KwkgAnlagenAngabe, bool>? SpeichereAnlage { get; set; }

    /// <summary>Schreibt die Projektvorgaben
    /// (<c>WirtschaftlichkeitCtrl.SpeichereParameter</c>); <c>false</c> =
    /// fehlgeschlagen. <b>Nur im OK-Weg</b>, und erst nach den Anlagenzeilen.</summary>
    [Parameter] public Func<WirtschaftlichkeitParameter, bool>? SpeichereVorgaben { get; set; }

    /// <summary>
    /// ETAPPE E13 (E7c3‑Q6 a): der Grund des zuletzt gescheiterten Schreibwegs
    /// (<c>WirtschaftlichkeitCtrl.Speicherfehler</c> bzw. der gefangene Fehler), einmal
    /// gelesen; <c>null</c> = keiner. Der Dialog nennt ihn neben der Meldung des OK-Wegs.
    /// </summary>
    [Parameter] public Func<string>? Speicherfehler { get; set; }

    /// <summary>
    /// ETAPPE E13 (E7c3‑Q6 a): der Ladefehler des Kerns nach <see cref="ErgebnisseLaden"/>
    /// (<c>WirtschaftlichkeitCtrl.Ladefehler</c>); <c>null</c> = vollständig geladen.
    /// </summary>
    [Parameter] public Func<string>? Ladefehler { get; set; }

    /// <summary>
    /// ETAPPE E13 (E7c3‑Q6 a): die Warnung der Tabellenvorsorge beim Öffnen
    /// (<c>WirtschaftlichkeitCtrl.Vorsorgewarnung</c>); leer = keine.
    /// </summary>
    [Parameter] public string Vorsorgewarnung { get; set; } = "";

    /// <summary>
    /// ETAPPE E9b (E9a‑Q7): die Kohärenzzeilen des ±-Knopfes der Einspeisevergütung KWK —
    /// ist das Tarif-Rollenmodell wirksam, bewertet es die Einspeisung mit seinem
    /// Einspeisetarif, und eine Szenario-Einspeisevergütung bleibt ohne Wirkung
    /// (<c>WIRT_SZ_ROLLEN_EINSPEISUNG</c>). Leer = sie wirkt.
    /// </summary>
    [Parameter] public IReadOnlyList<string> EinspeisungKwkSzenarioHinweise { get; set; }
        = Array.Empty<string>();

    /// <summary>
    /// ETAPPE E18 (Konzept § 6.3 Nr. 16) — der im Strompreis erfasste Stromsteueranteil
    /// (<c>StrompreisZerlegungCtrl.StromsteuerErfasst</c>, gelesen von der Huelle).
    /// <c>null</c> = nicht mitgegeben; dann zeigt der Dialog keine Zeile.
    /// </summary>
    [Parameter] public StromsteueranteilStand? Stromsteueranteil { get; set; }

