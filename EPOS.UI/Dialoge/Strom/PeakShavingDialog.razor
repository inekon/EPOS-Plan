    protected override void OnInitialized()
    {
        _blattOeffnen = EventCallback.Factory.Create(this, () => _blattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _blattOffen = false);
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Profil.Schluessel);

        PeakShavingEingaben v = PeakShavingEingaben.Aus(Vorgaben);

        _pKw = v.PKw;
        _kapazitaet = v.KapazitaetKwh;
        _socMin = v.SoCMinProzent;
        _socMax = v.SoCMaxProzent;
        _startSoC = v.StartSoCProzent;
        _eta = v.WirkungsgradRt;
        _lp = v.LeistungspreisEurProKwA;
        _bezugspreis = v.BezugspreisMittelCtKwh;
        _cCap = v.CCapEurProKwh;
        _cPow = v.CPowEurProKw;
        _iFix = v.IFixEur;
        _zins = v.KapitalzinsProzent;
        _nutzungsdauer = v.NutzungsdauerA;
        _kompatibel = v.Kompatibilitaetsmodus;
        _adaptiv = true;                       // feste Vorgabe, nicht aus der Variante (:250)

        _herkunft = Vorgaben is not null && Vorgaben.AusProjekt
            ? string.Format(CultureInfo.CurrentCulture, VorlageHerkunft, Vorgaben.Bezeichner)
            : TextHerkunftVorgabe;

        ZeilenBauen();
        if (_zeilen.Count > 0) _gewaehlt = _zeilen[0].Schluessel;
        _reiheText = TextKeineReihe;

        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.PEAK_SHAVING,
                                          () => KiSicht(), KiHaken());
    }

    /// <summary>
    /// Die Liste: die Zeilen der Hülle (sonst aus <see cref="Ganglinien"/> gebaut), dahinter
    /// die eingelesenen Dateien dieser Sitzung.
    /// </summary>
    private void ZeilenBauen()
    {
        var liste = new List<Katalogfilterzeile>();
        if (Lastgangzeilen is not null) liste.AddRange(Lastgangzeilen);
        else
            foreach ((int Id, string Text) g in Ganglinien)
                liste.Add(new Katalogfilterzeile(g.Id, g.Text) { Schluessel = GANGLINIE + g.Id }
                    .MitText(Katalogfilterprofil.SpBezeichner, g.Text));
        liste.AddRange(_dateizeilen);
        _zeilen = liste;
    }

