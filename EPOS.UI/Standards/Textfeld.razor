@* Textfeld - Bezeichner, Codes, Variantennamen und (mehrzeilig) Protokolle.

   Bewusst ohne Pruefung: Was ein gueltiger Text ist, weiss nur der Dialog
   (meist "nicht leer"), und er sagt es ueber OkErlaubt der SpeichernLeiste.

   MEHRZEILIG (iU9-W3.0) ist dasselbe Feld mit <textarea> statt <input>: der
   Ersatz fuer die MultiLine-TextBox des Bestands - das Validierungsprotokoll
   des Spotpreis-Imports, das Ganglinienprotokoll, die Freitextfelder. Ein
   zweiter Baustein waere ein zweiter Ort fuer dieselben Regeln (Beschriftung,
   Hoechstlaenge, NurLesen). *@

@* epos-feld--breit meldet dem Formularraster (iU8-E-2 / W14a-E-7), dass dieses
   Feld LANG ist: Es spannt dort ueber beide Spalten, statt neben einem kurzen
   Zahlenfeld zu stehen. Im Vorbild war die Beschreibung 250 x 48 px - zwei
   Zeilen hoch und so breit wie der ganze Block (Form_AdminPV). Ausserhalb
   eines Formularrasters aendert die Klasse nichts. *@
@if (Mehrzeilig)
{
    <label class="epos-feld epos-feld--breit">
        @if (!string.IsNullOrEmpty(Bezeichnung))
        {
            <span class="epos-feld-text">@Bezeichnung</span>
        }
        <textarea class="epos-eingabe epos-eingabe--mehrzeilig @(Festbreite ? "epos-eingabe--festbreite" : "")"
                  rows="@Zeilen" maxlength="@Hoechstlaenge" placeholder="@Platzhalter"
                  readonly="@NurLesen" @oninput="BeiEingabe">@Wert</textarea>
    </label>
}
else
{
    <label class="epos-feld">
        @if (!string.IsNullOrEmpty(Bezeichnung))
        {
            <span class="epos-feld-text">@Bezeichnung</span>
        }
        <span class="epos-feld-zeile">
            <input class="epos-eingabe" type="text" value="@Wert" maxlength="@Hoechstlaenge"
                   placeholder="@Platzhalter" readonly="@NurLesen" @oninput="BeiEingabe" />
        </span>
    </label>
}

@code {
    /// <summary>Beschriftung links bzw. ueber dem Feld.</summary>
    [Parameter] public string Bezeichnung { get; set; } = "";

    /// <summary>Der Text. Bindbar ueber @@bind-Wert.</summary>
    [Parameter] public string Wert { get; set; } = "";

    /// <summary>Meldet jede Aenderung.</summary>
    [Parameter] public EventCallback<string> WertChanged { get; set; }

    /// <summary>Grauer Hinweistext im leeren Feld.</summary>
    [Parameter] public string Platzhalter { get; set; } = "";

    /// <summary>Hoechstzahl der Zeichen; <c>null</c> = unbegrenzt.</summary>
    [Parameter] public int? Hoechstlaenge { get; set; }

    /// <summary>
    /// Mehrzeiliges Feld (<c>textarea</c>) statt einzeiligem Eingabefeld -
    /// Vorbild <c>TextBox.Multiline = true</c> mit Rollbalken
    /// (<c>Form_SpotpreisImport._tbProtokoll</c>, iU9-W3.0).
    /// </summary>
    [Parameter] public bool Mehrzeilig { get; set; }

    /// <summary>Sichtbare Zeilen im mehrzeiligen Feld; ohne Wirkung sonst.</summary>
    [Parameter] public int Zeilen { get; set; } = 6;

    /// <summary>
    /// Feste Zeichenbreite (Schreibmaschinenschrift) im mehrzeiligen Feld -
    /// fuer Protokolle, die ihre Spalten aus Leerzeichen bauen
    /// (<c>Form_SpotpreisImport._tbProtokoll</c> stand in Consolas 9 pt).
    /// Nachgetragen in iU9-W3.2; ohne Wirkung im einzeiligen Feld.
    /// </summary>
    [Parameter] public bool Festbreite { get; set; }

    /// <summary>
    /// Nur lesbar? Das Feld bleibt sichtbar, waehlbar und rollbar, nimmt aber
    /// keine Eingabe an (<c>TextBox.ReadOnly</c> des Bestands). Anders als ein
    /// gesperrtes Feld laesst sich sein Inhalt weiter markieren und kopieren -
    /// genau das braucht ein Protokoll.
    /// </summary>
    [Parameter] public bool NurLesen { get; set; }

    private Task BeiEingabe(ChangeEventArgs e)
    {
        if (NurLesen) return Task.CompletedTask;
        Wert = e.Value?.ToString() ?? "";
        return WertChanged.InvokeAsync(Wert);
    }
}
