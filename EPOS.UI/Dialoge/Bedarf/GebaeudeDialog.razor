    private void BeiKatalogAendern()
    {
        if (KatalogGaben is null) return;
        if (_katalogzeile is null) { Melden(MeldungKeineWahl, WarnStufe.Warnung, amKatalog: true); return; }

        _meldung = "";
        _katalogGaben = KatalogGaben(_katalogzeile.Bezeichner);
    }

    private void BeiKatalogNeu()
    {
        if (KatalogGaben is null) return;
        _meldung = "";
        _katalogGaben = KatalogGaben("");
    }

    /// <summary>
    /// Der Katalogeditor ist zu — <paramref name="gespeichert"/> ist sein Ausgang (<c>true</c>
    /// nach einem Speichern). Kam er aus einem Import, nimmt der Dialog das neue Gebäude jetzt in
    /// die Projektliste auf — derselbe Weg wie „In das Projekt übernehmen", Arbeitsstand bis zum OK
    /// dieses Dialogs; ohne Speichern verfällt der Import samt Herkunft.
    /// </summary>
    private void KatalogeditorFertig(bool gespeichert)
    {
        _katalogGaben = null;
        GebaeudeImportweg? import = _importweg;
        _importweg = null;
        KatalogLaden();   // SetGebaeudeDB() nach dem Schliessen

        if (import is null || !gespeichert) return;
        GebaeudeProjektZeile? neu = import.Aufnehmen();
        if (neu is null) return;

        Zeilen.Add(neu);
        ProjektzeileWaehlen(neu);
        Geaendert?.Invoke();
        Melden(Format(MeldungImportAufgenommen, neu.Name), WarnStufe.Hinweis);
    }

