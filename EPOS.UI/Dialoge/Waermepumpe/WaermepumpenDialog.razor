@* Waermepumpen Verwaltung - der PROJEKTDIALOG der Waermepumpe (iU9-W7.5), EIN Dialog nach dem Muster
   der Nachbarn: oben die Waermepumpen des Projekts, darunter der Katalog, unten die Detailzeile
   "gewaehlter Satz".

   KATALOGAUSWAHL V1, STUFE 3 (Konzept Projektdialoge mit Katalogauswahl 4.2, 4.6, 4.9):
   * Projekt-Kopfleiste: Umstellen (genau eine Projektzeile auf genau einen Katalogsatz), Bearbeiten…
     (Projektkopien), In die Datenbank uebernehmen… (KA-E-9), Entfernen.
   * Katalogfuss: Schloss, Loeschen, Bearbeiten… - ohne Vergleichen und ohne Neu… (beides traegt der
     Katalogeditor). Ein einzelner ungesperrter Satz oeffnet den vollen Katalogeditor (KA-E-13).
   * Detailzeile aufgeklappt: die Kenndaten samt Kennlinie (COP und Leistung), beim Projektsatz die
     Kostenknoepfe (KA-E-12) und "Anlage…".
   * "Anlage…" oeffnet die Anlagenseite WaermepumpeAnlageDialog als Ueberlagerung im selben Fenster
     (KA-E-11). Sie bearbeitet die Zeile an Ort und Stelle; OK prueft und uebernimmt sie ins Modell,
     Abbrechen setzt sie auf den Stand beim Oeffnen zurueck.

   DIE ZEILE IST DER SCHLUESSEL, nicht ihr Index. TASTATUR: Esc schliesst. Enter ist nicht belegt. *@

@namespace EPOS.UI.Dialoge.Waermepumpe
@using EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Kosten
@using WindowsFormsApplication1

<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: eingebettet in der Ueberlagerung "Wärmepumpe" der SimulationErgebnisSeite
       traegt DIE den Titel (TitelText="") - dann bleiben Titel und Kreuz hier aus. Der Kontext steht im
       Dialogkopf (Katalogauswahl V1, 4.1 und 4.8). *@
    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        <span class="epos-dialog-kontext" title="@KopfbandText">@KopfbandText</span>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="Abbrechen" />
        }
    </div>

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }

    <Zweispaltenauswahl Dialogname="Waermepumpe" LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                        KatalogZeile="@((int)Katalogliste.ZEILENHOEHE_ZEILENWAHL)"
                        UebernehmenText="@LabelHinzu"
                        UebernehmenGesperrt="@(KatalogZiele().Count == 0)" Uebernehmen="BeiHinzu"
                        EntfernenText="@LabelEntfernen"
                        EntfernenGesperrt="@(ProjektZiele().Count == 0)" Entfernen="BeiLoeschen"
                        ProjektWahl="@_projektWahl" ProjektSichtbar="@ProjektSchluessel()"
                        KatalogWahl="@_katalogWahl" KatalogSichtbar="@KatalogSichtbar()"
                        WahlGeaendert="BeiWahlGeaendert"
                        KatalogFussName="@_katalogZeile?.Bezeichner"
                        SatzArt="@SatzArt" SatzName="@SatzName" SatzKenndaten="@SatzKenndaten">

        <Leistenzusatz>
            @* UMSTELLEN (4.2, P): die gewaehlte Projektzeile auf den gewaehlten Katalogsatz - Sperrzeit,
               Bivalenz, Heizstab und Kosten der Zeile bleiben. Genau eine Zeile, genau ein Satz. *@
            <button type="button" class="epos-knopf epos-zweispalten-knopf epos-wp-umstellen"
                    title="@(UmstellenMoeglich ? TipUmstellen : TipUmstellenEiner)"
                    disabled="@(!UmstellenMoeglich)" @onclick="BeiUmstellen">@LabelUmstellen</button>
            @if (ProjektsatzWege is not null)
            {
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--bearbeiten-projekt"
                        title="@Resource.AUSWAHL_BTN_BEARBEITEN_PROJEKT_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiProjektBearbeiten">@Resource.AUSWAHL_BTN_BEARBEITEN</button>
            }
            @if (RueckwegWege is not null)
            {
                @* KA-E-9: der Rueckweg in die Datenbank, wirksam auf die Auswahl der Projektliste. *@
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--rueckweg"
                        title="@Resource.KATRUECK_BTN_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiRueckweg">@Resource.KATRUECK_BTN</button>
            }
        </Leistenzusatz>

        <Links>
            <div class="epos-raster-huelle">
                <table class="epos-raster">
                    <thead>
                        <tr>
                            <th class="epos-spalte-kaestchen"><Wahlkaestchen Bereich="Auswahlbereich.Projekt" /></th>
                            <th>@SpalteWahl</th>
                            <th>@SpalteHersteller</th>
                            <th>@SpalteTyp</th>
                            <th>@SpalteLeistung</th>
                            <th>@SpalteVorlauf</th>
                            <th>@SpalteRuecklauf</th>
                            <th>@SpalteBetriebsart</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (WaermepumpeAnlageDaten zeile in Zeilen)
                        {
                            WaermepumpeAnlageDaten z = zeile;
                            <tr class="@(z == _gewaehlt ? "epos-zeile--markiert" : null)">
                                <td class="epos-spalte-kaestchen">
                                    <Wahlkaestchen Bereich="Auswahlbereich.Projekt" Schluessel="@Projektschluessel(z)"
                                                   Kurztext="@z.Bezeichner" />
                                </td>
                                <td>
                                    <Zeilenwahl Gewaehlt="@(z == _gewaehlt)" Kurztext="@SpalteWahl"
                                                Gewaehltwerden="() => ProjektZeileKlick(z)" />
                                </td>
                                <td>@z.Firma</td>
                                <td>@z.Bezeichner</td>
                                <td>@z.Nennleistung</td>
                                <td>@z.Vorlauf</td>
                                <td>@z.Ruecklauf</td>
                                <td>@z.Betriebsart</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </Links>

        <Rechts>
            @* DIE EINE KATALOGLISTE (W14a-E-10) im Kaestchenmodus mit der Spalte "im Projekt verwendet" (Q12). *@
            <Katalogliste @ref="_katalogliste" Profil="@Katalogprofil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_katalogGewaehlt" GewaehltChanged="KatalogZeileWaehlen"
                          Vergleichsparameter="@Vergleichsparameter"
                          ZeileIstWahl="true" Kaestchen="true" Gewaehlte="@_katalogKaestchen"
                          GewaehlteChanged="BeiKatalogKaestchen" />
        </Rechts>

        <KatalogFuss>
            <Katalogschloss @ref="_katalogschloss" Weg="@Schloss" Zeile="@_katalogZeile"
                            JaText="@JaText" NeinText="@NeinText"
                            Geschaltet="BeiSchlossGeschaltet" Abgelehnt="BeiSchlossAbgelehnt" />
            @if (KatalogLoeschen is not null)
            {
                <button type="button" class="epos-knopf epos-knopf--loeschen" disabled="@(KatalogZiele().Count == 0)"
                        @onclick="BeiLoeschenGefragt">@BtnLoeschenText</button>
            }
            @if (EditorGaben is not null || KatalogsatzWege is not null)
            {
                <button type="button" class="epos-knopf epos-knopf--bearbeiten-katalog"
                        title="@(KatalogZiele().Count > 0 && KatalogZiele().All(z => z.Geschuetzt) ? Resource.ADM_SCHLOSS_ERST_AUFHEBEN : Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS)"
                        disabled="@(KatalogZiele().Count == 0)" @onclick="BeiKatalogBearbeiten">@BtnBearbeitenText</button>
            }
        </KatalogFuss>

        <Satz>
        @* DIE KNOPFZEILE DER SATZFLAECHE: beim Projektsatz die Kostenknoepfe (KA-E-12) und "Anlage…"
           (KA-E-11, Ueberlagerung). *@
        @if (_gewaehlt is not null)
        {
            <div class="epos-leiste">
                @if (!Wizard && KostenOeffnen is not null)
                {
                    <KostenKnoepfeLeiste KostenOeffnen="@KostenLeiste" EnergiekostenOeffnen="@EnergieLeiste"
                                         InvestText="@KostenInvestText" BetriebText="@KostenBetriebText"
                                         EnergieText="@KostenEnergieText" />
                }
                <span class="epos-leiste-fueller"></span>
                @if (AnlageGaben is not null)
                {
                    <button type="button" class="epos-knopf epos-knopf--primaer epos-knopf--anlage"
                            title="@TipAnlage" @onclick="AnlageOeffnen">@BtnAnlageText</button>
                }
            </div>
        }

        @if (_gewaehlt is null && _katalogZeile is null)
        {
            <Herleitungszeile Text="@LeerText" />
        }
        else
        {
            @* DIE KENNDATEN DES GEWAEHLTEN SATZES - beim Projektsatz die Projektkopie, beim Katalogsatz der
               Katalog; dieselben Werte und dieselbe Kennlinie wie im Stammblatt. *@
            <div class="epos-wp-satz">
                @if (_satz is not null)
                {
                    <Stammblattwerte Werte="@WaermepumpeStammFelder.Kenndatenwerte(_satz, _felderTexte)" />
                }
                @if (_bilder is not null)
                {
                    <Reiter Bezeichnung="@LabelKennlinien" @bind-Aktiv="_blatt">
                        <KindInhalt>
                            <Reiterblatt Schluessel="COP" Titel="@ReiterCop">
                                <KindInhalt>
                                    <DiagrammSvg Modell="@_bilder.Cop" Kennung="wpv-satz-cop"
                                                 Bezeichnung="@ReiterCop" PlatzhalterText="@PlatzhalterBild" />
                                </KindInhalt>
                            </Reiterblatt>
                            <Reiterblatt Schluessel="LEISTUNG" Titel="@ReiterLeistung">
                                <KindInhalt>
                                    <DiagrammSvg Modell="@_bilder.Leistung" Kennung="wpv-satz-leistung"
                                                 Bezeichnung="@ReiterLeistung" PlatzhalterText="@PlatzhalterBild" />
                                </KindInhalt>
                            </Reiterblatt>
                        </KindInhalt>
                    </Reiter>
                }
            </div>
        }
        </Satz>
    </Zweispaltenauswahl>

    @if (!Wizard)
    {
        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }

    @* --- Ueberlagerung 1: "Anlage…" - die Anlagenseite der gewaehlten Projektzeile (KA-E-11). Sie traegt
           ihren Titel, ihr Kreuz und ihre OK-Leiste selbst. *@
    <Ueberlagerung Offen="@(_anlageGaben is not null)" Schliessbar="false" Titel=""
                   Geschlossen="() => AnlageFertig(false)">
        <KindInhalt>
            @if (_anlageGaben is not null && _gewaehlt is not null)
            {
                <div class="epos-wp-anlage-ueberlagerung" @key="_gewaehlt">
                    <WaermepumpeAnlageDialog @ref="_anlage" @attributes="_anlageGaben"
                                             Eingebettet="false" TitelText="@AnlageTitel" Wizard="@Wizard"
                                             Geschlossen="AnlageFertig" />
                </div>
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 2: der Katalogeditor (ein ungesperrter Katalogsatz, KA-E-13) --- *@
    <Ueberlagerung Offen="@(_editorGaben is not null)" Schliessbar="false"
                   Titel="" Geschlossen="() => EditorFertig(false)">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                <WaermepumpeStammDialog @attributes="_editorGaben" Geschlossen="EditorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 3: Bearbeiten… je Bereich, auch mehrere Saetze (4.6) ---- *@
    <Ueberlagerung Offen="@(_bearbeitung is not null)"
                   Titel="@(_bearbeitung is null ? "" : Satzbearbeitungsregel.Titel(_bearbeitung.Value.Art, _bearbeitung.Value.Saetze))"
                   Kopfzusatz="@(_bearbeitung?.Art == Satzmarke.Projektsatz ? MarkeProjektsatz : MarkeKatalogsatz)"
                   Geschlossen="() => BearbeitungFertig(false)">
        <KindInhalt>
            @if (_bearbeitung is { } b)
            {
                <Satzbearbeitung Art="@b.Art" Saetze="@b.Saetze"
                                 Wege="@(b.Art == Satzmarke.Projektsatz ? ProjektsatzWege : KatalogsatzWege)"
                                 Geschlossen="BearbeitungFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 4: Rueckfrage "In die Datenbank übernehmen…" (5.2, KA-E-9) - immer vor dem Schreiben *@
    <Ueberlagerung Offen="@(_rueckweg is not null)"
                   Titel="@(_rueckweg is null ? "" : Rueckwegregel.Titel(_rueckweg))"
                   Kopfzusatz="@MarkeKatalogsatz" Geschlossen="() => RueckwegFertig(null)">
        <KindInhalt>
            @if (_rueckweg is not null && RueckwegWege is not null)
            {
                <Rueckwegfrage Zeilen="@_rueckweg" Wege="@RueckwegWege" BleibtText="@RueckwegBleibtText"
                               Geschlossen="RueckwegFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Rueckfrage vor dem Loeschen aus dem KATALOG ------------------------- *@
    <Rueckfrage Offen="@_loeschfrage" TitelText="@TitelLoeschen" JaText="@JaText" NeinText="@NeinText"
                Frage="@LoeschfrageText" Beantwortet="BeiLoeschfrage" />
</div>

@code {
    /// <summary>
    /// Die Wärmepumpen des Projekts — die Liste gehört der Hülle und wird AN ORT UND STELLE bearbeitet, wie in den
    /// Erzeugerdialogen der Welle 6.
    /// </summary>
    [Parameter] public List<WaermepumpeAnlageDaten> Zeilen { get; set; } = new();

    /// <summary>Der Katalog — <c>WPStammCtrl.Katalogfilterzeilen()</c> (Stufe S2.2); nach jeder Katalogpflege neu erfragt.</summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalog { get; set; }

    /// <summary>Die Spalten des Katalogs, hier MIT der Spalte „im Projekt verwendet" (Q12).</summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Zeilen des VERGLEICHS (Q3, Stufe S3.3) — gehen an den Katalog weiter.</summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Vergleichsparameter { get; set; }

    /// <summary>Die Beschriftungen der Katalogliste (Suche, Trefferzahl, Filter).</summary>
    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Vorbelegung des Filterstands; ohne = das Register der Anlagenart.</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>
    /// Der Parametersatz der Anlagenseite „Anlage…" zu einer Zeile. Die Hülle baut ihn samt der Delegaten, die dort
    /// hängen (Kennlinien, Kosten, Stammdialog, Trägerkatalog). <c>null</c> = kein Knopf „Anlage…".
    /// </summary>
    [Parameter] public Func<WaermepumpeAnlageDaten, IReadOnlyDictionary<string, object>>? AnlageGaben { get; set; }

    /// <summary>
    /// Legt eine neue Zeile zu einem Katalogbezeichner an — die Hülle legt die Projektkopie an (Vormerkung) und holt
    /// die Gerätefelder. <c>null</c> = nichts angelegt.
    /// </summary>
    [Parameter] public Func<string, WaermepumpeAnlageDaten?>? Anlegen { get; set; }

    /// <summary>Übernimmt den bearbeiteten Stand in das Modell der Hülle.</summary>
    [Parameter] public Action<WaermepumpeAnlageDaten>? Uebernehmen { get; set; }

    /// <summary>Entfernt die Zeile aus der geteilten Liste.</summary>
    [Parameter] public Action<WaermepumpeAnlageDaten>? Entfernen { get; set; }

    /// <summary>
    /// „Umstellen": stellt die Zeile auf den Katalogsatz (Id) um — Gerät, Gerätefelder und Kennlinien; Betriebsdaten
    /// und Kosten der Zeile bleiben. <c>false</c> = nicht umgestellt.
    /// </summary>
    [Parameter] public Func<WaermepumpeAnlageDaten, int, bool>? Umstellen { get; set; }

    /// <summary>Die Kenndaten des Geräts einer Projektzeile (Projektkopie, im Assistenten der Katalog).</summary>
    [Parameter] public Func<WaermepumpeAnlageDaten, WaermepumpeStammDaten?>? ProjektSatz { get; set; }

    /// <summary>Die Kenndaten eines Katalogsatzes nach seiner Id.</summary>
    [Parameter] public Func<int, WaermepumpeStammDaten?>? KatalogSatz { get; set; }

    /// <summary>Die Kennlinienbilder des Geräts einer Projektzeile.</summary>
    [Parameter] public Func<WaermepumpeAnlageDaten, KennlinienBilder>? ProjektBilder { get; set; }

    /// <summary>Die Kennlinienbilder eines Katalogsatzes nach seiner Id.</summary>
    [Parameter] public Func<int, KennlinienBilder>? KatalogBilder { get; set; }

    /// <summary>
    /// Die Gaben des Katalogeditors (<c>WaermepumpeStammDialog</c>) mit dem Satz vorgewählt — „Bearbeiten…" auf einen
    /// einzelnen ungesperrten Katalogsatz (KA-E-13).
    /// </summary>
    [Parameter] public Func<string, IReadOnlyDictionary<string, object>>? EditorGaben { get; set; }

    /// <summary>Löscht einen Katalogsatz (KA-E-16 samt Satzvorlage); leer = gelöscht, sonst der Grund. <c>null</c> = kein Knopf.</summary>
    [Parameter] public Func<int, string>? KatalogLoeschen { get; set; }

    /// <summary>
    /// Die Wege der Satzbearbeitung für die PROJEKTKOPIEN (KA-E-8), benannt über die Geräte-Id der Zeile.
    /// <c>null</c> = kein Knopf „Bearbeiten…" in der Projekt-Kopfleiste (Assistent).
    /// </summary>
    [Parameter] public Satzbearbeitungswege? ProjektsatzWege { get; set; }

    /// <summary>Die Wege der Satzbearbeitung für mehrere oder gesperrte KATALOGsätze.</summary>
    [Parameter] public Satzbearbeitungswege? KatalogsatzWege { get; set; }

    /// <summary>Die Wege des Rückwegs „In die Datenbank übernehmen…" (KA-E-9); <c>null</c> = kein Knopf.</summary>
    [Parameter] public Rueckwegwege? RueckwegWege { get; set; }

    /// <summary>Was im Projekt bleibt - der Hinweis der Rückfrage.</summary>
    [Parameter] public string RueckwegBleibtText { get; set; } = "";

    /// <summary>„Schloss setzen…" / „Schloss aufheben…" am Katalog; ohne ihn steht der Knopf nicht da.</summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    /// <summary>Öffnet Investitions- (<c>false</c>) oder Betriebskosten (<c>true</c>) der gewählten Projektzeile.</summary>
    [Parameter] public Func<WaermepumpeAnlageDaten, bool, Task>? KostenOeffnen { get; set; }

    /// <summary>Öffnet die Energiekosten der gewählten Projektzeile.</summary>
    [Parameter] public Func<WaermepumpeAnlageDaten, Task>? EnergiekostenOeffnen { get; set; }

    /// <summary>Assistentenbetrieb: keine OK/Abbrechen-Leiste, keine Kostenknöpfe.</summary>
    [Parameter] public bool Wizard { get; set; }

    /// <summary><c>true</c> = OK, <c>false</c> = Abbrechen.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    // --- Texte -----------------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Wärmepumpen Verwaltung";
    [Parameter] public string KopfbandText { get; set; } = "Geben Sie die Daten der Wärmepumpe ein";
    [Parameter] public string LabelProjektliste { get; set; } = "ausgewählte Wärmepumpen:";
    [Parameter] public string LabelKatalogliste { get; set; } = "Wärmepumpen aus Datenbank:";

    /// <summary>„Umstellen" (<c>WPV_BTN_UMSTELLEN</c>).</summary>
    [Parameter] public string LabelUmstellen { get; set; } = "Markierte auf diese Wärmepumpe umstellen";

    /// <summary>Werkzeugtipp des Umstellens (<c>WPV_TIP_UMSTELLEN</c>).</summary>
    [Parameter] public string TipUmstellen { get; set; } =
        "Die links markierte Wärmepumpe durch die rechts markierte ersetzen — Betriebsdaten und Kosten der Zeile bleiben.";

    /// <summary>Werkzeugtipp, solange nicht genau eine Zeile und genau ein Satz gewählt sind (<c>WPV_TIP_UMSTELLEN_EINER</c>).</summary>
    [Parameter] public string TipUmstellenEiner { get; set; } = Resource.WPV_TIP_UMSTELLEN_EINER;
    [Parameter] public string LabelHinzu { get; set; } = "In das Projekt übernehmen";
    [Parameter] public string LabelEntfernen { get; set; } = "Aus dem Projekt entfernen";
    [Parameter] public string SpalteWahl { get; set; } = "Wahl";
    [Parameter] public string SpalteHersteller { get; set; } = "Hersteller";
    [Parameter] public string SpalteTyp { get; set; } = "Typ";
    [Parameter] public string SpalteLeistung { get; set; } = "Leistung [kW]";
    [Parameter] public string SpalteVorlauf { get; set; } = "Vorlauf [°C]";
    [Parameter] public string SpalteRuecklauf { get; set; } = "Rücklauf [°C]";
    [Parameter] public string SpalteBetriebsart { get; set; } = "Betriebsart";

    /// <summary>„Anlage…" (<c>WPV_BTN_ANLAGE</c>) und sein Werkzeugtipp.</summary>
    [Parameter] public string BtnAnlageText { get; set; } = Resource.WPV_BTN_ANLAGE;
    [Parameter] public string TipAnlage { get; set; } = Resource.WPV_TIP_ANLAGE;

    /// <summary>Der Titel der Überlagerung „Anlage…": {0} = Typ der Zeile (<c>WPV_TITEL_ANLAGE</c>).</summary>
    [Parameter] public string AnlageTitelFormat { get; set; } = Resource.WPV_TITEL_ANLAGE;

    /// <summary>Der Mangel einer neuen, noch nicht geprüften Zeile beim OK (<c>WPV_MSG_ANLAGE_PRUEFEN</c>).</summary>
    [Parameter] public string TextAnlagePruefen { get; set; } = Resource.WPV_MSG_ANLAGE_PRUEFEN;

    [Parameter] public string LabelKennlinien { get; set; } = "Kenndaten Kennlinien:";
    [Parameter] public string ReiterCop { get; set; } = "COP";
    [Parameter] public string ReiterLeistung { get; set; } = "Leistung";
    [Parameter] public string PlatzhalterBild { get; set; } = "Keine Kennlinien vorhanden";
    [Parameter] public string KostenInvestText { get; set; } = "Investitionskosten…";
    [Parameter] public string KostenBetriebText { get; set; } = "Betriebskosten…";
    [Parameter] public string KostenEnergieText { get; set; } = "Energiekosten…";
    [Parameter] public string BtnBearbeitenText { get; set; } = "Bearbeiten...";
    [Parameter] public string BtnLoeschenText { get; set; } = "Löschen";
    [Parameter] public string JaText { get; set; } = "Ja";
    [Parameter] public string NeinText { get; set; } = "Nein";
    [Parameter] public string FrageLoeschen { get; set; } =
