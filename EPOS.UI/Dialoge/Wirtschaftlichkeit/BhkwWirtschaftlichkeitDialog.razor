    private void BonusEinspP(double? w) => Setze(() => Parameter.KwkgBonusEinspeisung = w ?? 0);
    private void DeckelP(double? w) => Setze(() => Parameter.KwkgVbhJahresdeckel = w ?? 0);
    private void KontingentP(double? w) => Setze(() => Parameter.KwkgVbhKontingent = w ?? 0);
    private void AbschlagP(double? w) => Setze(() => Parameter.KwkgAbschlagNegativ = w ?? 0);
    private void KostenanteilP(double? w) => Setze(() => Parameter.KwkgKostenanteil = w ?? 0);
