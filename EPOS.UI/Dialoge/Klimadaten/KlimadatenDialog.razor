    private KiMaskenanmeldung? _kiMaske;
    private KlimadatenKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten auf die LEBENDEN Felder. Setzen nimmt denselben Weg
    /// wie die Tastatur; die beiden Dateipfade bleiben dem Dateidialog der Plattform
    /// vorbehalten und sind deshalb nur lesbar.
    /// </summary>
    private KlimadatenKiSicht KiSicht()
    {
        return _kiSicht ??= new KlimadatenKiSicht
        {
            QuelleLesen = () => (int)_quelle,
            QuelleSetzen = BeiQuelle,
            QuelleEintraege = () => KiMaskenanmeldung.Eintraege(
                Quelleneintraege, e => e.Id, e => e.Text),

            OrtsnameLesen = () => _ortsname,
            OrtsnameSetzen = KiOrtsnameSetzen,

            BezeichnungLesen = () => _bezeichnung,
            BezeichnungSetzen = t => { _bezeichnung = t ?? ""; _meldung = ""; },

            LaengengradLesen = () => _longitude,
            LaengengradSetzen = w => { _longitude = w; KiStandortGeaendert(); },
            BreitengradLesen = () => _latitude,
            BreitengradSetzen = w => { _latitude = w; KiStandortGeaendert(); },

            JahrLesen = () => _tryJahr,
            JahrSetzen = BeiTryJahr,
            JahrEintraege = () => KiMaskenanmeldung.Eintraege(
                Jahreseintraege, e => e.Id, e => e.Text),

            SzenarioLesen = () => (int)_szenario,
            SzenarioSetzen = BeiSzenario,
            SzenarioEintraege = () => KiMaskenanmeldung.Eintraege(
                Szenarioeintraege, e => e.Id, e => e.Text),

            TryDateiLesen = () => _tryPfad,
            TryPaketLesen = () => _tryPaketPfad
        };
    }

    /// <summary>Der Ortsname — derselbe Weg wie eine Eingabe von Hand.</summary>
    private void KiOrtsnameSetzen(string wert)
    {
        _ortsname = wert ?? "";
        _meldung = "";
        _regionszeile = "";
    }

    /// <summary>Eine geänderte Koordinate verwirft Meldung, Standort und Regionszeile.</summary>
    private void KiStandortGeaendert()
    {
        _meldung = "";
        _tryStandort = "";
        _regionszeile = "";
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg.</b> „Daten einlesen" ist ein LADEVORGANG: Er holt eine
    /// Zeitreihe aus dem Netz oder aus einer Datei, dauert Minuten und lässt sich
    /// abbrechen. Das ist kein Speichern einer Maske, sondern ein rechnender Weg — er
    /// gehört ins Aktionsregister und nicht hierher.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    /// <summary>Lädt die Regionsliste neu (<c>ReadAll</c> + <c>FillListBox</c>).</summary>
    public async Task RegionenLaden()
    {
        if (Regionen is null) return;
        _regionen = await Regionen() ?? Array.Empty<Katalogfilterzeile>();

        if (_regionen.All(z => z.Bezeichner != _gewaehlt))
        {
            // Befund W14c-B22: BEIDE Bilder gehen weg, nicht nur das erste.
            _gewaehlt = "";
            _details = "";
            _modellTemperatur = null;
            _modellSonnenwinkel = null;
        }
    }

    /// <summary>
    /// Eine Zeile der Katalogliste wurde gewählt; sie meldet den SCHLÜSSEL, und der
    /// ist hier der Bezeichner (Auftrag KL-4).
    /// </summary>
    private async Task BeiZeile(string schluessel)
    {
        _gewaehlt = schluessel ?? "";
        _meldung = "";

        // EINE ANDERE REGION HEISST EINE ANDERE REIHE. Den Ausschnitt verwirft
        // der Baustein selbst, sobald ein anderes Modell hereinkommt.
        await AnsichtLaden();
    }

    /// <summary>
    /// Holt Details und die zwei Zeichenmodelle. <b>Ohne Stundenwerte bleibt es
    /// bei einer Meldung</b> statt einer Ausnahme (Befund W14c-B19).
    /// </summary>
    private async Task AnsichtLaden()
    {
        if (_gewaehlt.Length == 0 || Ansicht is null) return;

        Regionsansicht a = await Ansicht(_gewaehlt);

        _details = a.Details ?? "";
        _longitude = a.Longitude;
        _latitude = a.Latitude;
        _modellTemperatur = a.ModellTemperatur;
        _modellSonnenwinkel = a.ModellSonnenwinkel;
        if (!string.IsNullOrEmpty(a.Meldung)) Melden(a.Meldung, WarnStufe.Hinweis);
    }

