    protected override void OnInitialized()
    {
        _vergleichen = EventCallback.Factory.Create(this, BeiVergleichen);
        _duplizieren = EventCallback.Factory.Create(this, BeiDuplizieren);
        _schlossHandlung = EventCallback.Factory.Create(this, BeiSchloss);
        _loeschen = EventCallback.Factory.Create(this, BeiLoeschen);
        _blattOeffnen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = true);
        _blattSchliessen = EventCallback.Factory.Create(this, () => _auswahl.BlattOffen = false);

        _filterstand = Filterstandvorgabe
            ?? Katalogfilterregister.Stand(Katalogprofil?.Schluessel ?? Katalogfilterprofil.SCHLUESSEL_GEBAEUDE);

        _typen = Gebaeudetypen?.Invoke() ?? Array.Empty<string>();
        _arten = Gebaeudearten?.Invoke() ?? Array.Empty<string>();

        // Stufe KP2, Welle U4: die Bearbeitung des Blatts „Konditionierung" am Arbeitsstand des
        // Stammblatts. Eine Fehleingabe in der Matrix und die Maximalraumtemperatur haengen am Blatt
        // (E56 F3 (a)) - die Pruefung oeffnet es.
        _kond = new KonditionierungBearbeitung(_arbeit, () => Konditionierung, () => KonditionierungTexte,
                                               () => KonditionierungFragen)
        {
            Melden = Melden
        };
        _arbeit.IstKonditionierungsfeld = feld => _kond.IstMatrixfeld(feld)
                                                  || feld == GebaeudeArbeitsstand.Feld(Beschriftungen.LabelMaxTemperatur);

        KatalogLaden();

        // #465: eine EIGENE Maske - die Projektdialog-Sicht Form_Gebaeude bleibt beim
        // Projektdialog. Die Feldkarte ist die des Katalogeditors (KiDialoge.GebaeudeVerwaltung),
        // die Sicht dieselbe Klasse auf DEMSELBEN Arbeitsstand.
        // Stufe KP2, Welle U4: die Vorlagefelder der Matrix (kond_<groesse>_vorlage) als Wahl - dieselben
        // Listen wie die Karten des Blatts „Konditionierung" (der Weg der Huelle reicht die Vorlagen).
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.GEBAEUDE_ADMIN, () => KiSicht(), KiHaken(),
                                          KonditionierungKiTafel.Vorlagenlisten(() => _kond));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_fokusNachBlatt && !_kondOffen)
        {
            _fokusNachBlatt = false;
            await _wurzel.FocusAsync(preventScroll: true);
        }
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    // =================================================================================
    // Der Hilfe-Assistent (#465) - die Feldkarte des Katalogeditors auf dem Stammblatt
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private GebaeudeKatalogKiSicht? _kiSicht;

    /// <summary>
    /// <b>Die Sicht des Assistenten</b> — gebaut vom Arbeitsstand selbst
    /// (<see cref="GebaeudeArbeitsstand.KiSicht"/>), wie im Katalogeditor: jedes Feld geht
    /// über den Weg des Bedienelements (die Bauart und die Nutzfläche ziehen die Bauweise
    /// nach, die Randbedingung hält NULL). Dazu die SATZWAHL: Sie wählt die Zeile wie ein
    /// Klick; der Name ist hier nur lesbar.
    /// </summary>
    private GebaeudeKatalogKiSicht KiSicht()
    {
        return _kiSicht ??= _arbeit.KiSicht(new GebaeudeKiWege
        {
            NameLesen = () => _gewaehlt,
            SatzLesen = () => _gewaehlt,
            SatzSetzen = KiSatzWaehlen,
            SatzEintraege = () => KiMaskenanmeldung.Eintraege(
                _katalog, z => z.Schluessel, z => z.Bezeichner),

            TypEintraege = () => KiMaskenanmeldung.Eintraege(Typeintraege, e => e.Text, e => e.Text),
            GebaeudeartEintraege = () => KiMaskenanmeldung.Eintraege(Arteintraege, e => e.Text, e => e.Text),
            BaualtersklasseEintraege = () => KiMaskenanmeldung.Eintraege(Klasseneintraege, e => e.Id, e => e.Text),
            BauartEintraege = () => KiMaskenanmeldung.Eintraege(Bauarteintraege, e => e.Id, e => e.Text),
            VerwendungEintraege = KiVerwendungseintraege,
            RandbedingungEintraege = () => KiMaskenanmeldung.Eintraege(new[]
            {
                HuellTexte.RandErdreich, HuellTexte.RandKeller, HuellTexte.RandAussenluft
            }),
            Ferienname = n => n < Beschriftungen.Ferienzeitraeume.Count ? Beschriftungen.Ferienzeitraeume[n] : "",
            Texte = HuellTexte,
            // Stufe KP2, Welle U4: die Vorgabe-Matrix des Blatts „Konditionierung" als Feldtafel - über
            // dieselbe Bearbeitung wie die Zellen des Blatts, am selben Arbeitsstand.
            Konditionierung = _kond
        });
    }

    /// <summary>Die Verwendungen: Schlüssel ist der STEUERWERT, Text der Eintrag der Maske.</summary>
    private IReadOnlyList<KiWahleintrag> KiVerwendungseintraege()
    {
        var liste = new List<KiWahleintrag>();
        for (int i = 0; i < Verwendungswerte.Count && i < Verwendungen.Count; i++)
            liste.Add(new KiWahleintrag(Verwendungswerte[i], Verwendungen[i]));
        return liste;
    }

    /// <summary>
    /// <b>Der Assistent wählt eine Zeile</b> — derselbe Weg wie ein Klick
    /// (<see cref="BeiZeile"/>). Geänderte Felder halten den Wechsel an; der Assistent
    /// bekommt dann denselben Satz, den das Warnband zeigt.
    /// </summary>
    private string? KiSatzWaehlen(string schluessel)
    {
        string neu = schluessel ?? "";
        if (neu == _gewaehlt) return null;
        if (_katalog.All(z => z.Schluessel != neu)) return null;

        if (Geaendert)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return Resource.ADM_MSG_UNGESPEICHERT;
        }
        BeiZeile(neu);
        return null;
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf.
    /// </summary>
    /// <remarks>
    /// <para><b>Schreibschutz</b> ist ein Auslieferungssatz (AD-Q11/AD-Q15): Solange er steht,
    /// lehnt schon <c>feld_setzen</c> ab, und die Absage nennt die Wege über
    /// „Duplizieren…" und „Schloss aufheben…". Die Wahl des Satzes bleibt frei.</para>
    /// <para><b>Die Prüfung ist DIESELBE, die der Speicherknopf ruft</b>
    /// (<see cref="GebaeudeArbeitsstand.Pruefen"/>), der Speicherweg DERSELBE
    /// (<see cref="Schreiben"/>).</para>
    /// <para><b>Nicht über den Assistenten</b>: Neu…, Duplizieren…, das Schloss, Löschen —
    /// sie legen Sätze an, nehmen sie weg oder heben einen Schutz auf (KI-D-Q11).</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _auslieferung,
        Schreibschutzgrund = () => Schloss is not null ? Resource.ADM_SB_NUR_LESEN : MeldungSpeichernGesperrt,
        Pruefen = () => _arbeit.Pruefen(false, Pruefwortlaut, HuellTexte)?.Meldung ?? "",
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>
    /// <b>„Speichern" über den Assistenten</b> — derselbe Weg wie der Knopf; ein
    /// Auslieferungssatz wird benannt abgelehnt, ebenso ein Aufruf ohne Satz oder ohne
    /// Änderung.
    /// </summary>
    private KiErgebnis KiSpeichern()
    {
        if (Speichern is null)
            return KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText));

        if (_gewaehlt.Length == 0 || _satz is null)
            return KiErgebnis.Abgelehnt(Resource.KI_DLG_ADMIN_OHNE_SATZ.Replace("{0}", TitelText));

        if (_auslieferung) return KiErgebnis.Abgelehnt(Schloss is not null ? Resource.ADM_SB_NUR_LESEN : MeldungSpeichernGesperrt);

        if (!Geaendert)
            return KiErgebnis.Abgelehnt(Resource.KI_DLG_ADMIN_OHNE_AENDERUNG.Replace("{0}", TitelText));

        return Schreiben()
            ? KiErgebnis.Ok(_status, anzahl: 1)
            : KiErgebnis.Abgelehnt(_meldung);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    // =====================================================================
    // Liste und Wahl
    // =====================================================================

    /// <summary>Lädt die Liste neu; die bisherige Wahl bleibt, sonst die erste Zeile.</summary>
    public void KatalogLaden()
    {
        _katalog = Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();
        _sperren.Clear();

        _auswahl.Abgleichen(_katalog.Select(z => z.Schluessel));
        if (_auswahl.Vergleich) VergleichBauen();
        else _vergleichszeilen = null;

        if (_katalog.Count == 0) { Leeren(); return; }
        if (_katalog.All(z => z.Schluessel != _gewaehlt)) Waehlen(_katalog[0].Schluessel);
        else Waehlen(_gewaehlt);
    }

    /// <summary>
    /// Die Liste meldet eine Zeile. <b>Trägt das Stammblatt geänderte Felder, bleibt die
    /// Wahl stehen</b> (Konzept 3.3) — das Warnband sagt „Speichern oder Verwerfen".
    /// </summary>
    private void BeiZeile(string schluessel)
    {
        if (Geaendert && schluessel != _gewaehlt)
        {
            Warnen(Resource.ADM_MSG_UNGESPEICHERT);
            return;
        }
        Waehlen(schluessel);
    }

    private void Waehlen(string schluessel)
    {
        _gewaehlt = schluessel ?? "";
        _meldung = "";
        _fokuszeile = _katalog.FirstOrDefault(z => z.Schluessel == _gewaehlt);
        _satz = _gewaehlt.Length > 0 ? Satz?.Invoke(_gewaehlt) : null;
        _auslieferung = _fokuszeile?.Geschuetzt == true || _satz?.Auslieferung == true;
        _geladen = _satz?.FeldsatzOderKenndaten();
        Zuruecksetzen();
    }

    private void Leeren()
    {
        _gewaehlt = "";
        _fokuszeile = null;
        _satz = null;
        _auslieferung = false;
        _geladen = null;
        Zuruecksetzen();
    }

    /// <summary>
