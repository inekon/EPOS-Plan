        => EnergiekostenOeffnen is null ? null : (Func<Task>)BeiEnergiekosten;

    /// <summary>Reicht die gewählte Projektzeile an die Kostenverwaltung durch.</summary>
    private Task BeiKosten(bool betrieb)
        => KostenOeffnen?.Invoke(_projektZeile, betrieb) ?? Task.CompletedTask;

    /// <summary>Reicht die gewählte Projektzeile an die Energieträgerverwaltung durch.</summary>
    private Task BeiEnergiekosten()
        => EnergiekostenOeffnen?.Invoke(_projektZeile) ?? Task.CompletedTask;

    protected override void OnParametersSet()
    {
        Filtertexte.SpalteWahl = SpalteWahl;
    }

    protected override void OnInitialized()
    {
        _filterstand = Filterstandvorgabe ?? Katalogfilterregister.Stand(Katalogprofil?.Art ?? Anlagenart.Bhkw);

        KatalogNeuLaden();
        SummeNeu();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);

        // Welle KI-F1: die GEWAEHLTE Zeile beim Hilfe-Assistenten anmelden - als
        // Delegat und nicht als Instanz, denn sie wechselt mit jedem Klick in der
        // Projektliste.
        // KI-F1b: Die Brennstoffvariante ist ein WAHLFELD; ihre Einträge kennt nur
        // dieser Dialog, deshalb geht der Lieferant als Quelle mit.
        // Welle #458, Stufe 2: angemeldet ist seither die SICHTKLASSE - sie reicht die
        // gewaehlte Zeile durch und traegt den Aufklapper „Alle Daten" als Feldtafel.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.BHKW_PROJEKT,
                                          () => KiSicht(), KiHaken(),
                                          ("energietraeger", Traegereintraege));
    }

    private ErzeugerProjektKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: die gewählte Projektzeile und der Aufklapper „Alle
    /// Daten" des gewählten Katalogsatzes (Welle #458, Stufe 2).
    /// </summary>
    private ErzeugerProjektKiSicht KiSicht() => _kiSicht ??= new ErzeugerProjektKiSicht
    {
        Zeilenquelle = () => _projektZeile,
        AlleDaten = new AlleDatenTafel
        {
            Felder = () => _parameterOffen ? _felder : null,
            // Der BHKW-Katalog kennt den Auslieferungssatz ZUSAETZLICH ueber seinen
            // eigenen Weg (KatalogfelderGeschuetzt) - derselbe, vor dem der Knopf fragt.
            Sperrgrund = () => AlleDatenTafel.Grund(_parameterOffen ? _felder : null, KatalogfelderSpeichern is not null,
                                                    _katalogZeile?.Geschuetzt == true ||
                                                    (_katalogZeile is not null &&
                                                     KatalogfelderGeschuetzt?.Invoke(_katalogZeile.Bezeichner) == true)),
            Gesetzt = () => _felderGeaendert = true
        }
    };

    /// <summary>Die Brennstoffvarianten der gewählten Zeile für den Assistenten (KI-F1b).</summary>
    private IReadOnlyList<KiWahleintrag> Traegereintraege()
        => KiMaskenanmeldung.Eintraege(_varianten, v => v.Id, v => v.Text);

    // =================================================================================
    // Der Hilfe-Assistent liest und setzt die Zeilenwerte (Welle KI-F1)
    // =================================================================================

    /// <summary>
    /// Die Anmeldung bei der <c>KiMaskenbruecke</c>. Sie hält die Getter auf die
    /// gewählte Projektzeile und fällt mit dem Dialog.
    /// </summary>
    /// <remarks>
    /// <b>Angemeldet heißt nicht übertragen.</b> Ob ein Feldwert hinausgeht,
    /// entscheiden der Schalter „Feldwerte mitsenden" im Chat und die
    /// Einwilligungsstufe „Dialogdaten" (KI‑D‑Q2).
    /// </remarks>
    private KiMaskenanmeldung? _kiMaske;

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3) — dieselben drei
    /// Haken wie in den fünf Schwesterdialogen der Erzeugerkarte.
    /// </summary>
    /// <remarks>
    /// <para><b>„Speichern" heißt hier ÜBERNEHMEN</b>: die gewählte Projektzeile in das
    /// Modell zurück, derselbe Weg, den Grenzleistung, Vorlauf und Rücklauf von Hand
    /// gehen. Ohne gewählte Zeile lehnt die Aktion benannt ab.</para>
    /// <para><b>Keine eigene Prüfung</b> — die drei Zahlenfelder färben sich selbst;
    /// eine Knopfprüfung wie in den Katalogeditoren hat dieser Dialog nicht.</para>
    /// <para><b>Der SCHREIBSCHUTZ hängt am Gerät</b>, auf das die gewählte Zeile
    /// verweist (<c>ErzeugerZeile.NurLesen</c>).</para>
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Schreibgeschuetzt = () => _projektZeile?.NurLesen ?? false,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    /// <summary>
    /// „Speichern" des Assistenten: Trägt der Aufklapper „Alle Daten" Änderungen, geht
    /// er den Weg SEINES Knopfes (<see cref="FelderSpeichern"/>) — sonst wird die
    /// gewählte Projektzeile übernommen wie bisher (Welle #458, Stufe 2).
    /// </summary>
    private KiKern.KiErgebnis KiSpeichern()
    {
        if (!_felderGeaendert) return KiUebernehmen();

        FelderSpeichern();

        // Ein Auslieferungssatz fragt erst nach - die Antwort gibt der Anwender, nicht
        // der Assistent.
        if (_schutzfrage) return KiKern.KiErgebnis.Abgelehnt(Resource.ADM_SPEICHERN_GESPERRT);

        return _felderGeaendert
            ? KiKern.KiErgebnis.Abgelehnt(_meldung.Length > 0 ? _meldung
                  : Resource.KI_AKTION_SPEICHERN_KEIN_WEG.Replace("{0}", TitelText))
            : KiKern.KiErgebnis.Ok(_felderErfolg, anzahl: 1);
    }

    private KiKern.KiErgebnis KiUebernehmen()
    {
        if (_projektZeile is null || Uebernehmen is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", TitelText));

        Uebernehmen(_projektZeile);
        return KiKern.KiErgebnis.Ok(_projektZeile.Bezeichner, anzahl: 1);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    private void SummeNeu() { if (SummePtherm is not null) _summeText = SummePtherm(); }

    // =================================================================================
    // Filter und Listen
    // =================================================================================

    /// <summary>
    /// Liest den Katalog neu — nach einem SCHREIBweg (Editor, Neu…, Löschen). Der
    /// FILTER ruft sie nicht: Er wirkt auf die Anzeige, nie auf die Auswahl.
    /// </summary>
    private void KatalogNeuLaden()
    {
        _katalog = Katalogzeilen?.Invoke() ?? Array.Empty<Katalogfilterzeile>();
        VerwendungStempeln();

        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
    }

    /// <summary>
    /// Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste aus der
    /// LEBENDEN Projektliste; der Dialog schreibt erst beim OK zurück.
    /// </summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    /// <summary>Der Katalogsatz zu einem Bezeichner; <c>null</c>, wenn es ihn nicht gibt.</summary>
    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    /// <summary>
    /// Eine PROJEKTzeile waehlen: Detail aus der Projektkopie (im Assistenten aus dem
    /// Stamm - das entscheidet die Huelle), Grenzleistung, Vorlauf, Ruecklauf und die
    /// Traegerliste der Gruppe (<c>ApplySelectedBHKW</c>).
    /// </summary>
    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _varianten = Varianten is not null ? Varianten(zeile.CarrierId) : Array.Empty<(int, string)>();
        _detail = (ProjektDetail is not null ? ProjektDetail(zeile.Bezeichner) : null) ?? Leer(zeile.Bezeichner);
        FelderNachziehen();
    }

    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _projektZeile = null;
        _varianten = Array.Empty<(int, string)>();
        _detail = (KatalogDetail is not null ? KatalogDetail(_katalogGewaehlt) : null)
                  ?? Leer(_katalogGewaehlt);
        FelderNachziehen();
    }

    private static ErzeugerDetail Leer(string name)
        => new(name, "", Array.Empty<(string, string)>());

    // =================================================================================
    // Hinzufuegen und Entfernen
    // =================================================================================

    private void BeiHinzu()
    {
        if (_katalogZeile is null || Vorbereiten is null || TraegerGaben is null) return;

        TraegerVorbereitung vor = Vorbereiten(_katalogZeile.Id);
        if (!string.IsNullOrEmpty(vor.Meldung)) { Melden(vor.Meldung, true); return; }

        _traegerGaben = TraegerGaben(vor);
    }

    private void TraegerFertig(EnergietraegerVarianteErgebnis? ergebnis)
    {
        var katalog = _katalogZeile;
        _traegerGaben = null;

        if (ergebnis is null || katalog is null || Aufnehmen is null) return;

        AufnahmeErgebnis aufnahme = Aufnehmen(katalog.Id, ergebnis);
        if (!string.IsNullOrEmpty(aufnahme.Meldung)) Melden(aufnahme.Meldung, aufnahme.Fehler);
        if (aufnahme.Zeile is null) return;

        Zeilen.Add(aufnahme.Zeile);
        VerwendungStempeln();                 // Q12
        ProjektZeileWaehlen(aufnahme.Zeile);
        SummeNeu();
    }

    /// <summary>
    /// „▶": Zeile weg, Summe neu. Steht danach keine Zeile mehr da, waehlt der
    /// Vorlaeufer die erste Katalogzeile und setzt die Grenzleistung auf „0"
    /// (<c>btn_BHKW_Löschen_Click</c>, Z. 749-758).
    /// </summary>
    private void BeiEntfernen()
    {
        if (_projektZeile is null) return;

        ErzeugerZeile zeile = _projektZeile;
        Zeilen.Remove(zeile);
        Entfernen?.Invoke(zeile);
        VerwendungStempeln();                 // Q12

        _projektZeile = null;
        _detail = Leer("");
        _varianten = Array.Empty<(int, string)>();
        SummeNeu();

        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
        else if (_katalog.Count > 0) KatalogZeileWaehlen(_katalog[0].Bezeichner);
    }

    // =================================================================================
    // Zeilenwerte
    // =================================================================================

    private void BeiTraegerwechsel(int? neu)
    {
        if (_projektZeile is null || !neu.HasValue) return;
        if (neu.Value == _projektZeile.CarrierId) return;

        TraegerWechseln?.Invoke(_projektZeile, neu.Value);
        _projektZeile.CarrierId = neu.Value;
    }

    private void BeiGrenzleistung(double? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Grenzleistung = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    /// <summary>
    /// Die Herleitungszeile unter dem Grenzleistungsfeld — <c>null</c> = keine Zeile
    /// (Anwenderentscheid <b>W6‑E‑7</b> vom 07.09.2026).
    ///
    /// <para><b>Sie erscheint genau dann, wenn sie etwas zu sagen hat:</b> Das Modulfeld
    /// steht auf 0 (leer oder ausdrücklich 0 — beides heißt „kein eigener Wert"), und
    /// die Hülle hat die <see cref="Projektvorgabe"/> mitgegeben. Steht dort eine Zahl,
    /// ist das der Wert, mit dem gerechnet wird; ist auch die Vorgabe 0, sagt die zweite
    /// Fassung ausdrücklich, dass es dann KEINE Untergrenze gibt — seit W6‑E‑7 rechnet
    /// 0 als 0, und genau das darf nicht unsichtbar bleiben.</para>
    ///
    /// <para>Führt das Modul einen eigenen Wert, überstimmt er die Vorgabe; dann steht
    /// die Zahl im Feld und die Zeile schweigt.</para>
    /// </summary>
    private string? Grenzleistungherleitung
    {
        get
        {
            if (_projektZeile is null) return null;
            if (Projektvorgabe is null) return null;
            if ((_projektZeile.Grenzleistung ?? 0) != 0) return null;

            return Projektvorgabe.Value == 0
                ? HerleitungKeine
                : string.Format(System.Globalization.CultureInfo.CurrentCulture,
                                HerleitungVorgabe, Projektvorgabe.Value);
        }
    }

    private void BeiVorlauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Vorlauf = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    private void BeiRuecklauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Ruecklauf = wert;
        Uebernehmen?.Invoke(_projektZeile);
    }

    // =================================================================================
    // Der Aufklapper "Alle Daten" (Anwenderentscheid 15.09.2026)
    // =================================================================================

    /// <summary>
    /// Auf- und zuklappen - und beim AUFklappen die Felder holen.
    /// </summary>
    /// <remarks>
    /// <b>Der Knopf bleibt, die Vorgabe ist offen.</b> Wer zuklappt und wieder
    /// aufklappt, sieht den Stand von JETZT und nicht den von der Auswahl.
    /// </remarks>
    private void ParameterUmschalten()
    {
        _parameterOffen = !_parameterOffen;
        if (_parameterOffen) FelderHolen();
    }

    /// <summary>Holt die Felder des gewählten Katalogsatzes neu.</summary>
    private void FelderHolen()
    {
        _felder = Katalogfelder is null || _katalogZeile is null
            ? null
            : Katalogfelder(_katalogZeile.Bezeichner);
        _felderGeaendert = false;
        _feldFehler = false;
    }

    /// <summary>
    /// Nach einem SATZWECHSEL: Der offene Aufklapper zeigt die Felder des JETZT
    /// gewählten Satzes, der geschlossene gar keine.
    /// </summary>
    /// <remarks>
    /// <b>Sonst speicherte der Knopf fremde Werte.</b> <see cref="FelderSpeichern"/>
    /// schreibt <c>_felder</c> unter dem Bezeichner der GEWÄHLTEN Zeile zurück — bliebe
    /// der alte Feldsatz stehen, landeten die Werte des vorigen Moduls im neuen.
    /// </remarks>
    private void FelderNachziehen()
    {
        if (_parameterOffen && _katalogZeile is not null) { FelderHolen(); return; }

        _felder = null;
        _felderGeaendert = false;
        _feldFehler = false;
    }

    /// <summary>Ein Zahlenfeld des Aufklappers meldet einen ungültigen Zustand.</summary>
    private void BeiFeldFehler((string Feldname, bool Fehler) meldung)
        => _feldFehler = meldung.Fehler;

    /// <summary>
    /// „Speichern" im Aufklapper. Ein AUSLIEFERUNGSSATZ wird vorher erfragt — genau die
    /// Reihenfolge des Katalogbrowsers (erst die Rückfrage, dann der Schreibvorgang).
    /// </summary>
    private void FelderSpeichern()
    {
        if (KatalogfelderSpeichern is null || _felder is null || _katalogZeile is null) return;

        if (KatalogfelderGeschuetzt?.Invoke(_katalogZeile.Bezeichner) == true)
        {
            _schutztext = string.Format(FrageSchutz, _katalogZeile.Bezeichner);
            _schutzfrage = true;
            return;
        }

        FelderSchreiben(false);
    }

    /// <summary>„Nein" schreibt nichts, „Ja" hebt den Schutz für DIESEN Vorgang auf.</summary>
    private void BeiSchutzAntwort(bool? antwort)
    {
        _schutzfrage = false;
        if (antwort != true) return;
        FelderSchreiben(true);
    }

    /// <summary>
    /// Schreibt die geänderten Felder zurück und lädt die Katalogliste neu.
    /// </summary>
    /// <remarks>
    /// <b>Der Befund des Katalogs zählt, nicht die Absicht.</b> Lehnt der Speicherweg ab
    /// (Prüfmeldung, Schreibschutz), bleibt der geänderte Stand im Aufklapper stehen -
    /// der Anwender soll ihn verbessern können, statt ihn zu verlieren.
    /// </remarks>
    private void FelderSchreiben(bool schutzUebergehen)
    {
        if (KatalogfelderSpeichern is null || _felder is null || _katalogZeile is null) return;

        KatalogSpeicherErgebnis ergebnis =
            KatalogfelderSpeichern(_katalogZeile.Bezeichner, _felder, schutzUebergehen);

        if (!ergebnis.Ok)
        {
            // Das Band oben bleibt fuer den Fehler - dazu der Grund rot am Knopf.
            Melden(ergebnis.Meldung, true);
            _felderVermerk?.Fehler(ergebnis.Meldung);
            return;
        }

        // Der Erfolg steht nur noch am Knopf; ein Band einer frueheren Ablehnung faellt weg.
        _felderGeaendert = false;
        _meldung = "";
        _felderErfolg = ergebnis.Meldung;
        _felderVermerk?.Gespeichert();
        KatalogNeuLaden();
    }

    /// <summary>Eine Eingabe im Aufklapper: Speichern geht wieder, der Vermerk fällt weg.</summary>
    private void FeldGeaendert()
    {
        _felderGeaendert = true;
        _felderVermerk?.Leeren();
    }

    // =================================================================================
    // Katalogpflege
    // =================================================================================

    private void BeiKatalogBearbeiten()
    {
        if (_katalogZeile is null || EditorGaben is null) return;
        _editorGaben = EditorGaben(_katalogZeile.Bezeichner);
    }

    /// <summary>„Neu…": Erst der Name, dann derselbe Editor im Modus „Neu".</summary>
    private void BeiNeuemNamen(string? name)
    {
        _namensfrage = false;
        if (name is null || EditorGabenNeu is null) return;
        _editorGaben = EditorGabenNeu(name);
    }

    private void EditorFertig(string? name)
    {
        _editorGaben = null;
        if (name is null) return;

        KatalogNeuLaden();
        foreach (var z in _katalog)
            if (z.Bezeichner == name) { KatalogZeileWaehlen(z.Bezeichner); return; }
    }

    /// <summary>
    /// „Löschen": Ein Auslieferungssatz wird mit Begruendung abgelehnt, BEVOR die
    /// Rueckfrage kommt - genau die Reihenfolge des Vorlaeufers (IsReadOnly, dann
    /// Ja/Nein).
    /// </summary>
    private void BeiLoeschen()
    {
        _loeschfrage = _katalogZeile is not null;
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        _loeschfrage = false;
        if (antwort != true || _katalogZeile is null || KatalogLoeschen is null) return;

        string grund = KatalogLoeschen(_katalogZeile.Id);
        if (!string.IsNullOrEmpty(grund)) { Melden(grund, true); return; }

        _katalogZeile = null;
        _katalogGewaehlt = "";
        _detail = Leer("");
        KatalogNeuLaden();
    }

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Der Abbrechen-Weg: schliesst ohne zu speichern. Esc und das ✕ im Kopf rufen ihn.</summary>
    private Task Abbrechen() => BeiErgebnis(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_traegerGaben is not null || _editorGaben is not null ||
            _namensfrage || _loeschfrage || _schutzfrage) return Task.CompletedTask;
        return Abbrechen();
    }
}
