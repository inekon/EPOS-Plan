    /// kommen nur Name, Betriebsart und die Einträge der Klapplisten dazu.
    /// </summary>
    private GebaeudeKatalogKiSicht KiSicht()
    {
        return _kiSicht ??= _arbeit.KiSicht(new GebaeudeKiWege
        {
            NameLesen = () => _stand.Name,
            NameSetzen = KiNameSetzen,
            BetriebsartLesen = () => Modus.ToString(),

            TypEintraege = () => KiMaskenanmeldung.Eintraege(
                Typeintraege, e => e.Text, e => e.Text),
            GebaeudeartEintraege = () => KiMaskenanmeldung.Eintraege(
                Arteintraege, e => e.Text, e => e.Text),
            BaualtersklasseEintraege = () => KiMaskenanmeldung.Eintraege(
                Klasseneintraege, e => e.Id, e => e.Text),
            BauartEintraege = () => KiMaskenanmeldung.Eintraege(
                Bauarteintraege, e => e.Id, e => e.Text),
            VerwendungEintraege = KiVerwendungseintraege,

            // Welle #458 Stufe 3b: die Randbedingung des Hüll-Rasters und die Ferien.
            RandbedingungEintraege = () => KiMaskenanmeldung.Eintraege(
                Randeintraege, e => e.Id, e => e.Text),
            Ferienname = Ferienname,
            Texte = Texte
        });
    }

    /// <summary>Die Verwendungen: Schlüssel ist der STEUERWERT, Text der Eintrag der Maske.</summary>
    private IReadOnlyList<KiWahleintrag> KiVerwendungseintraege()
    {
        var liste = new List<KiWahleintrag>();
        for (int i = 0; i < Verwendungswerte.Count && i < Verwendungen.Count; i++)
            liste.Add(new KiWahleintrag(Verwendungswerte[i], Verwendungen[i]));
        return liste;
    }

    /// <summary>In der KATALOGVERWALTUNG WÄHLT der Name den Satz, sonst BENENNT er ihn.</summary>
    private void KiNameSetzen(string wert)
    {
        if (Modus != GebaeudeKatalogModus.Admin) { _stand.Name = wert ?? ""; return; }

        for (int i = 0; i < _namen.Count; i++)
            if (string.Equals(_namen[i], wert, StringComparison.Ordinal)) { NamenWaehlen(i); return; }
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf. <b>„Speichern" ist der OK-Weg
    /// ohne Schließen</b>: dieselben Prüfregeln, derselbe Schreibweg; der Dialog bleibt
    /// stehen. <c>Pruefen</c> ist dieselbe Prüfung wie am OK-Knopf.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => Pruefen(Modus == GebaeudeKatalogModus.Neu) ? "" : _meldung,
        Speichern = () => Task.FromResult(KiSpeichern())
    };

    private KiKern.KiErgebnis KiSpeichern()
    {
        if (Speichern is null)
            return KiKern.KiErgebnis.Abgelehnt(Resource.KI_AKTION_SPEICHERN_KEIN_WEG
                                                       .Replace("{0}", TitelText));

        bool istNeu = Modus == GebaeudeKatalogModus.Neu;
        return Schreiben(istNeu, istNeu ? _stand.Name : _ursprungsname)
                   ? KiKern.KiErgebnis.Ok(_stand.Name, anzahl: 1)
                   : KiKern.KiErgebnis.Abgelehnt(_meldung);
    }

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

