600;2;CHARACTER (256) FUNCTION P22_Heizleistung(TWQ,TVWP,QWP,PWP,COP);
610;1;Integer Function LeseDaten(I700,I730,i,WQvon,WQbis,T,A,B,C);
610;2;Real A(40),B(40),T(40),C(40),X,WQvon(2),WQbis(2);
610;3;Integer I730,I700,I,J;
610;4;Logical B1,B2;
610;5;WQvon(i)=VDIRWERT('700',I700,'730',I730,4);
610;6;WQbis(i)=VDIRWERT('700',I700,'730',I730,5);
610;7;J=0;
610;8;I=6;
610;9;B1=.true.;
610;10;Do While(B1);
610;11;X=VdiRWert('700',I700,'730',I730,I);
610;12;B2=X==-99;
610;13;if(B2)then;
610;14;B1=.false.;
610;15;LeseDaten=J;
610;16;else;
610;17;J=J+1;
610;18;T(J)=X;
610;19;A(J)=VdiRWert('700',I700,'730',I730,I+1);
610;20;B(J)=VdiRWert('700',I700,'730',I730,I+2);
610;21;C(J)=VdiRWert('700',I700,'730',I730,I+3);
610;22;I=I+4;
610;23;endif;
610;24;EndDo;
610;25;end Function Lesedaten;
610;26;Integer Function LeseSteuerdaten(I700,A,B);
610;27;Real A(40),X;
610;28;Integer I,I700,J,B(40);
610;29;Logical B1,B2;
610;30;J=0;
610;31;I=4;
610;32;B1=.true.;
610;33;Do While(B1);
610;34;X=VdiRWert('700',I700,'730',1,I);
610;35;B2=X==-99;
610;36;if(B2)then;
610;37;B1=.false.;
610;38;LeseSteuerDaten=J;
610;39;else;
610;40;J=J+1;
610;41;A(J)=X;
610;42;B(J)=VdiRWert('700',I700,'730',1,I+1);
610;43;I=I+2;
610;44;endif;
610;45;EndDo;
610;46;end Function LeseSteuerDaten;
610;47;CHARACTER (256) FUNCTION P22_Heizleistung(TWQ,TVWP,QWP,PWP,COP);
610;48;REAL TVWP,QWP,TWQ,AQ(40),AP(40),AC(40),BQ(40),BP(40),BC(40),T1,T2,Anteil,COP;
610;49;Real Tv1,Tv2,PWP,aWP,bWP,VTHz(40),WQvon(2),WQbis(2),Tx1(40),Tx2(40);
610;50;Real QWP1,QWP2,PWP1,PWP2,Y,COP1,COP2;
610;51;INTEGER I1,I2,i,J,I700,InDsHz(40),DSHz,DSVT1,DSVT2,InVT,II;
610;52;LOGICAL B1,B2,B3,B4,B5,B6,B7,B8,ERR,Err2,Err4,bExakt;
610;53;character (256) Fehler;
610;54;Fehler='';
610;55;WQvon(1:2)=(/0,0/);
610;56;WQbis(1:2)=(/0,0/);
610;57;I700=VdiIndex('700');
610;58;DsHz=LeseSteuerDaten(I700,VTHz,InDsHz);
610;59;B1=.true.;
610;60;InVT=1;
610;61;I1=0;
610;62;I2=0;
610;63;DO While(B1);
610;64;bExakt=VTHz(InVT)==TvWp;
610;65;if(bExakt)then;
610;66;I1=InDsHz(InVT);
610;67;B1=.false.;
610;68;else;
610;69;B2=TVWp>VTHz(InVT) .and. TvWp<VTHz(InVT+1);
610;70;if(B2)then;
610;71;I1=InDsHz(InVT);
610;72;I2=InDsHz(InVT+1);
610;73;B1=.false.;
610;74;endif;
610;75;endif;
610;76;if(B1)then;
610;77;InVT=InVT+1;
610;78;B1=InVT<DsHz+1;
610;79;endif;
610;80;EndDo;
610;81;B3=I1==0 .and. I2==0;
610;82;if(B3)then;
610;83;Fehler='Keine ‹bereinstimmung mit Vorlauftemperatur der WP';
610;84;else;
610;85;II=1;
610;86;DSVT1=LeseDaten(I700,I1,II,WQvon,WQbis,Tx1,AQ,AP,AC);
610;87;B3=I2>0;
610;88;II=2;
610;89;if(B3)DSVT2=LeseDaten(I700,I2,II,WQvon,WQbis,Tx2,BQ,BP,BC);
610;90;if(bExakt)then;
610;91;T1=WQvon(1);
610;92;T2=WQbis(1);
610;93;Tv1=VTHz(InVT);
610;94;TV2=Tv1;
610;95;else;
610;96;Tv1=VTHz(InVT);
610;97;Tv2=VTHz(InVT+1);
610;98;Anteil=(TVWP-TV1)/(TV2-TV1);
610;99;T1=max(WQvon(1),WQvon(2));
610;100;T2=min(WQbis(1),WQbis(2));
610;101;endif;
610;102;ERR=TVWP<TV1;
610;103;IF(ERR) THEN;
610;104;Fehler='Grenze Vorlauftemperatur unterschritten';
610;105;ELSE;
610;106;ERR2=TVWP>TV2;
610;107;IF(ERR2) THEN;
610;108;Fehler='Grenze Vorlauftemperatur ¸berschritten';
610;109;ELSE;
610;110;B4=TWQ<Tx1(1);
610;111;if(B4)then;
610;112;Fehler='Temperatur der W‰rmequelle zu klein.';
610;113;else;
610;114;Err4=.false.;
610;115;B5=.true.;
610;116;I=0;
610;117;Do While (B5);
610;118;I=I+1;
610;119;B5=.not.(TWQ>=Tx1(I) .and. TWQ<=Tx1(I+1));
610;120;B6=i>DsVT1-1;
610;121;if(B6)then;
610;122;B5=.false.;
610;123;Err4=.true.;
610;124;endif;
610;125;endDo;
610;126;if(Err4)then;
610;127;Fehler='Temperatur der W‰rmequelle zu hoch.';
610;128;else;
610;129;J=I+1;
610;130;aWP=(AQ(J)-AQ(I))/(Tx1(J)-Tx1(I));
610;131;bWP=AQ(I)-aWP*Tx1(I);
610;132;QWP1=aWP*TWQ+bWP;
610;133;aWP=(AP(J)-AP(I))/(Tx1(J)-Tx1(I));
610;134;bWP=AP(I)-aWP*Tx1(I);
610;135;PWP1=aWP*TWQ+bWP;
610;136;aWP=(AC(J)-AC(I))/(Tx1(J)-Tx1(I));
610;137;bWP=AC(I)-aWP*Tx1(I);
610;138;COP1=aWP*TWQ+bWP;
610;139;QWP=QWP1;
610;140;PWP=PWP1;
610;141;COP=COP1;
610;142;B7=I2>0;
610;143;IF(B7)then;
610;144;B8=TWQ<Tx2(1);
610;145;if(B8)then;
610;146;Fehler='Temperatur der W‰rmequelle zu klein. (2. Kurve)';
610;147;else;
610;148;Err4=.false.;
610;149;B8=.true.;
610;150;I=0;
610;151;Do While (B8);
610;152;I=I+1;
610;153;B8=.not.(TWQ>=Tx2(I) .and. TWQ<=Tx2(I+1));
610;154;B6=i>DsVT2-1;
610;155;if(B6)then;
610;156;B8=.false.;
610;157;Err4=.true.;
610;158;endif;
610;159;endDo;
610;160;if(Err4)then;
610;161;Fehler='Temperatur der W‰rmequelle zu hoch. (2.Kurve)';
610;162;else;
610;163;J=I+1;
610;164;aWP=(BQ(J)-BQ(I))/(Tx2(J)-Tx2(I));
610;165;bWP=BQ(I)-aWP*Tx2(I);
610;166;QWP2=aWP*TWQ+bWP;
610;167;aWP=(BP(J)-BP(I))/(Tx2(J)-Tx2(I));
610;168;bWP=BP(I)-aWP*Tx2(I);
610;169;PWP2=aWP*TWQ+bWP;
610;170;aWP=(BC(J)-BC(I))/(Tx2(J)-Tx2(I));
610;171;bWP=BC(I)-aWP*Tx2(I);
610;172;COP2=aWP*TWQ+bWP;
610;173;y=QWP2-QWP1;
610;174;QWP=QWP1+y*Anteil;
610;175;y=PWP2-PWP1;
610;176;PWP=PWP1+y*Anteil;
610;177;y=COP2-COP1;
610;178;COP=COP1+y*Anteil;
610;179;endif;
610;180;endif;
610;181;endif;
610;182;endif;
610;183;endif;
610;184;endif;
610;185;endif;
610;186;endif;
610;187;P22_Heizleistung=Fehler;
610;188;END FUNCTION P22_Heizleistung;
