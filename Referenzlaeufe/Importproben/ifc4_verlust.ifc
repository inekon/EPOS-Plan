ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Importprobe: absichtlich beschaedigt, von Hand geschrieben'),'2;1');
FILE_NAME('ifc4_verlust.ifc','2026-09-25T00:00:00',(''),(''),'von Hand','EPOS-Plan Importprobe','');
FILE_SCHEMA(('IFC4'));
ENDSEC;
DATA;
/* Zwei Verlustkanaele: #40 hat einen unbekannten Typ (nicht angelegt), und #50 zeigt auf #999, das es nicht gibt. */
#1=IFCPROJECT('0000000000000000000V01',$,'Verlustprobe',$,$,$,$,(#8),#2);
#2=IFCUNITASSIGNMENT((#3,#4));
#3=IFCSIUNIT(*,.LENGTHUNIT.,$,.METRE.);
#4=IFCSIUNIT(*,.AREAUNIT.,$,.SQUARE_METRE.);
#8=IFCGEOMETRICREPRESENTATIONCONTEXT($,'Model',3,1.E-05,#9,#11);
#9=IFCAXIS2PLACEMENT3D(#10,$,$);
#10=IFCCARTESIANPOINT((0.,0.,0.));
#11=IFCDIRECTION((0.,1.,0.));
#20=IFCBUILDING('0000000000000000000V02',$,'Probengebaeude',$,$,$,$,$,.ELEMENT.,$,$,$);
#21=IFCRELAGGREGATES('0000000000000000000V03',$,$,$,#1,(#20));
#30=IFCBUILDINGSTOREY('0000000000000000000V04',$,'Erdgeschoss',$,$,$,$,$,.ELEMENT.,0.);
#31=IFCRELAGGREGATES('0000000000000000000V05',$,$,$,#20,(#30));
#32=IFCSPACE('0000000000000000000V06',$,'0.01',$,$,$,$,'Wohnen',.ELEMENT.,.SPACE.,$);
#33=IFCRELAGGREGATES('0000000000000000000V07',$,$,$,#30,(#32));
#34=IFCELEMENTQUANTITY('0000000000000000000V08',$,'BaseQuantities',$,$,(#35));
#35=IFCQUANTITYAREA('NetFloorArea',$,$,50.,$);
#36=IFCRELDEFINESBYPROPERTIES('0000000000000000000V09',$,$,$,(#32),#34);
#40=IFCWALLXYZ('0000000000000000000V10',$,'Wand unbekannten Typs',$,$,$,$,$,$);
#41=IFCWALL('0000000000000000000V11',$,'Wand',$,$,$,$,$,$);
#42=IFCRELCONTAINEDINSPATIALSTRUCTURE('0000000000000000000V12',$,$,$,(#40,#41),#30);
#50=IFCRELDEFINESBYPROPERTIES('0000000000000000000V13',$,$,$,(#41),#999);
ENDSEC;
END-ISO-10303-21;
