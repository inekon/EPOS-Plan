    private readonly HashSet<string> _offeneKarten = new(StringComparer.Ordinal);

    private bool KarteOffen(string karte) => _offeneKarten.Contains(karte);

    private void KarteSetzen(string karte, bool offen)
    {
        if (offen) _offeneKarten.Add(karte);
        else _offeneKarten.Remove(karte);
    }

    /// <summary>Steht die Karte <paramref name="karte"/> offen? Prüfhilfe für die Tests.</summary>
    public bool KarteIstOffen(string karte) => KarteOffen(karte);

    /// <summary>Die Summe im Kopf des Zonenblocks: „5,0 MWh/a Zapfung", „unvollständig" oder der Wert samt Ablehnung.</summary>
    private string ZonenKopfSumme
        => !IstUnvollstaendig(_wahl) && Zonenwertdaten(_wahl) is { Abgelehnt: false } w
            ? Format(Texte.GruppeZonenSumme, Mwh(w.JahresbedarfZapfungKwh)) : Zonenwert(_wahl);

    /// <summary>Der Name der gewählten Stufe (Summe im Kopf der Gruppe „Gebäude und Anlage").</summary>
    private string Stufenname => _stufe switch
    {
        ZapfprofilStufe.Einfach => Texte.StufeEinfach,
        _ => Texte.StufeExperte
    };

    /// <summary>„1 eigener Wert", „n eigene Werte" oder „Vorgaben" — die Zusammenfassung einer Karte mit Fachwerten.</summary>
    private string EigeneWerte(int anzahl)
        => anzahl == 0 ? Texte.SummeVorgaben : anzahl == 1 ? Texte.SummeEigenerWert : Format(Texte.SummeEigeneWerte, anzahl);

    /// <summary>
    /// „Belegung · 24 WE aus der Wohnungstabelle · Speicher · Zirkulation ja": die Wohnungen (Summe der eingetragenen
    /// Anzahlen) oder die Personen je WE, die Topologie und die Zirkulation der Zone — die Eingaben, kein Rechenweg.
    /// </summary>
    private string BelegungZusammenfassung(ZapfprofilZoneDaten zone, ZapfprofilNutzungsartDaten? art, ZapfprofilZonenangabenDaten a)
    {
        var teile = new List<string>();
        if (art?.Wohnen == true && a.Wohnungen.Count > 0)
            teile.Add(Format(Texte.SummeWohnungen, a.Wohnungen.Sum(w => w.Anzahl ?? 0).ToString(CultureInfo.CurrentCulture)));
        else if (a.PersonenJeWe is double p)
            teile.Add(Format(Texte.SummePersonenJeWe, Wert(p)));
        teile.Add(Topologiename(a.Topologie));
        teile.Add(a.Zirkulation ? Texte.SummeZirkJa : Texte.SummeZirkNein);
        return string.Join(" · ", teile.Where(t => t.Length > 0));
    }

    /// <summary>„Messwert · 12.000 kWh/a" oder „Messwert · keiner".</summary>
    private string MesswertZusammenfassung(ZapfprofilZonenangabenDaten a)
        => a.Jahresmesswert is double w ? Zahl(w, "N0") + " " + Messwerteinheit(a) : Texte.SummeKeiner;

    /// <summary>Wie der Wert angesetzt ist: kalibriert, manuell oder auto — die Zahlen sagt die Schätzhilfe des Kerns.</summary>
    private string Ansatzart(ZapfprofilSchaetzhilfeDaten h)
        => h.Kalibriert ? Texte.AngesetztKalibriert : !h.Auto && h.Manuell.HasValue ? Texte.OptionManuell : Texte.OptionAuto;

    /// <summary>
    /// Der angesetzte Wert einer Schätzhilfe für die Kopfzeile („13,7 kWh/d (auto)"); ohne Schätzhilfe der eingetragene
    /// Wert (manuell) oder „auto".
    /// </summary>
    private string Ansatz(ZapfprofilSchaetzhilfeDaten? h, bool auto, double? manuell, string einheit)
        => h is not null ? Format(Texte.SummeAngesetzt, Zahl(h.Angesetzt, "N1"), h.Einheit, Ansatzart(h))
         : !auto && manuell is double m ? Format(Texte.SummeAngesetzt, Zahl(m, "N1"), einheit, Texte.OptionManuell)
         : Texte.OptionAuto;

    private string TagesbedarfZusammenfassung(ZapfprofilZonenangabenDaten a)
        => Ansatz(Tagesbedarfshilfe, a.TagesbedarfAuto, a.TagesbedarfManuellKwh, "kWh/d");

    /// <summary>Die Fachwerte der Zone: wie viele eigene Werte die Zone trägt (der Auslastungsgang zählt einmal).</summary>
    private string FachwerteZusammenfassung(ZapfprofilZonenangabenDaten a)
    {
        int n = new[] { a.BedarfSpezKwhJeEinheitTag, a.ZapftemperaturC, a.KaltwasserMittelC, a.KaltwasserAmplitudeK }.Count(w => w.HasValue)
              + (a.IdTagesgangsatz.HasValue ? 1 : 0)
              + (a.Auslastung?.Any(w => w.HasValue) == true ? 1 : 0);
        return EigeneWerte(n);
    }

    private string Zirkulationsmethodenname
        => Zirkulationsmethoden.FirstOrDefault(e => e.Id == (int)G.ZirkMethode).Text ?? "";

    /// <summary>„Zirkulation · 1,5 kW (auto) · Fläche × Kennwert" — mit manuellem Wert ohne die Methode.</summary>
    private string ZirkulationZusammenfassung
    {
        get
        {
            string ansatz = Ansatz(Zirkulationshilfe, G.ZirkAuto, G.ZirkManuellKw, "kW");
            return G.ZirkAuto ? ansatz + " · " + Zirkulationsmethodenname : ansatz;
        }
    }

    /// <summary>„Ladeleistung und Ladefenster · 12,0 kW (auto) · Ladefenster 10 h ab 22 Uhr".</summary>
    private string LadeZusammenfassung
        => Ansatz(Ladehilfe, G.LadeAuto, G.LadeManuellKw, "kW") + " · "
           + Format(Texte.SummeLadefenster, Wert(G.LadefensterH ?? Daten.Vorgaben.LadefensterH),
                    Wert(G.LadefensterBeginnH ?? Daten.Vorgaben.LadefensterBeginnH));

    private string LeitungsinhaltZusammenfassung
        => G.LeitungsinhaltL is double l ? Zahl(l, "0.##") + " l" : Texte.SummeKeineAngabe;

    private string FachwerteGebaeudeZusammenfassung
        => EigeneWerte(new[] { G.KaltwasserAuslegungC, G.SpeicherC, G.ZirkKennwert, G.ZirkFlaecheM2, G.ZirkLaufzeitH }.Count(w => w.HasValue));

    /// <summary>„Stochastik · Jahresreihe · stochastisch · 10 Jahre · Seed 7 · Typtage".</summary>
    private string JahresreiheZusammenfassung
    {
        get
        {
            var teile = new List<string>
            {
                _eingabe.JahresreiheStochastisch ? Texte.OptionStochastisch : Texte.OptionDeterministisch
            };
            if (_eingabe.JahresreiheStochastisch)
                teile.Add(Ganz(_eingabe.Realisierungen ?? Daten.RealisierungenVorgabe) + " " + Texte.EinheitJahre);
            if (_stufe == ZapfprofilStufe.Experte)
                teile.Add(Format(Texte.SummeSeed, Ganz(_eingabe.Seed ?? Daten.SeedVorgabe)));
            if (_eingabe.TyptageAktiv) teile.Add(Texte.SummeTyptage);
            return string.Join(" · ", teile.Where(t => t.Length > 0));
        }
    }

    /// <summary>Der Hinweis der Zirkulationsfachwerte als <c>title</c> (Formeln und Normbezug nicht in der Grundansicht).</summary>
    private string ZirkExperteHinweis
        => Format(Texte.HinweisZirkExperte, Wert(Daten.Vorgaben.ZirkKennwertLage1), Wert(Daten.Vorgaben.ZirkKennwertLage2),
                  Wert(Daten.Vorgaben.ZirkLaufzeitH));

    // --- ZB4 (b): EIN Feld je Wert mit Vorgabe ---------------------------------------------

    /// <summary>
    /// Ein Wert mit Vorschlag (Tagesbedarf, Ladeleistung, Zirkulation): Beschriftung, Einheit, der eingetragene Wert
    /// (<c>null</c> = auto), die Schätzhilfe des Kerns, Setzen und „Vorschlag übernehmen", ob er der Zone gehört, der
    /// angesetzte Text ohne Schätzhilfe und ein Zusatz für den Aufklapper „Rechenweg".
    /// </summary>
    private sealed record Einwert(string Bezeichnung, string Einheit, double? Wert, ZapfprofilSchaetzhilfeDaten? Hilfe,
                                  Action<double?> Setzen, Action<double?> Uebernehmen, bool Zone, string AngesetztOhne, string Zusatz);

    /// <summary>Der Vorschlag grau im leeren Feld („(13,7)"); ohne Vorschlag leer.</summary>
    private static string Vorschlagsplatzhalter(ZapfprofilSchaetzhilfeDaten? h)
        => h?.Vorschlag is double v ? Vorgabe(Math.Round(v, 1)) : "";

    /// <summary>
    /// DAS Feld eines Werts mit Vorschlag (ZB4 (b)): leer = auto, der Vorschlag steht grau im Feld, ein eingetippter Wert
    /// ist manuell. Daneben „Vorschlag übernehmen" (weich gesperrt ohne Vorschlag), darunter „Angesetzt: …" und der
    /// Aufklapper „Rechenweg" mit dem Satz des Kerns. Der Arbeitsstand bleibt fachlich derselbe (Auto + manueller Wert).
    /// </summary>
    private RenderFragment Einwertfeld(Einwert e) => @<div class="epos-zapfprofil-einwert">
        <div class="epos-zapfprofil-einwert-zeile">
            @* Der Schlüssel wechselt mit jeder Übernahme: Ein geleertes Feld hielte sonst seine leere Anzeige. *@
            <Zahlenfeld @key="_uebernahmen" Bezeichnung="@e.Bezeichnung" Feldname="@e.Bezeichnung" Einheit="@e.Einheit" Min="0"
                        Wert="@e.Wert" Platzhalter="@Vorschlagsplatzhalter(e.Hilfe)" Titel="@Texte.HinweisEinwert"
                        WertChanged="w => e.Setzen(w)"
                        FehlerZustand="f => FeldMelden(f, ZapfprofilStufe.Experte, zone: e.Zone)" />
            <button type="button" class="epos-knopf epos-zapfprofil-einwert-uebernehmen"
                    aria-disabled="@(e.Hilfe?.Vorschlag is null ? "true" : null)"
                    title="@(e.Hilfe is null ? Texte.HinweisOhneVorschlag : e.Hilfe.Vorschlag is null ? Texte.HinweisVorschlagOhne : Vorschlagstext(e.Hilfe))"
                    @onclick="() => VorschlagAmFeld(e)">@Texte.KnopfVorschlag</button>
        </div>
        @if ((e.Hilfe is { } h ? Angesetzt(h) : e.AngesetztOhne) is { Length: > 0 } angesetzt)
        {
            <p class="epos-leisezeile epos-zapfprofil-angesetzt" role="status">@angesetzt</p>
        }
        <details class="epos-zapfprofil-rechenweg">
            <summary>@Texte.InfoRechenweg</summary>
            <p class="epos-leisezeile">@(e.Hilfe is { } r ? Format(Texte.LabelRechenweg, r.Rechenweg) : Texte.HinweisOhneVorschlag)</p>
            @if (e.Zusatz.Length > 0)
            {
                <p class="epos-leisezeile">@e.Zusatz</p>
            }
        </details>
    </div>;

    /// <summary>Zähler der Übernahmen eines Vorschlags — der Schlüssel der Felder, damit sie den übernommenen Wert zeigen.</summary>
    private int _uebernahmen;

    /// <summary>„Vorschlag übernehmen" am Feld — ohne Vorschlag weich gesperrt: Der Versuch nennt den Grund.</summary>
    private void VorschlagAmFeld(Einwert e)
    {
        if (e.Hilfe?.Vorschlag is double v)
        {
            _uebernahmen++;
            e.Uebernehmen(v);
            return;
        }
        _hinweis = e.Hilfe is null ? Texte.HinweisOhneVorschlag : Texte.HinweisVorschlagOhne;
    }

    /// <summary>Das Feld Tagesbedarf: leer = auto (der Vorschlag), ein Wert = manuell.</summary>
    private void TagesbedarfSetzen(ZapfprofilZoneDaten z, double? wert)
        => Angabe(z, x =>
        {
            x.TagesbedarfManuellKwh = wert;
            x.TagesbedarfAuto = wert is null;
        });

    /// <summary>Das Feld Ladeleistung: leer = Vorschlag der Auslegung (auto), ein Wert = manuell.</summary>
    private void LadeleistungSetzen(double? wert)
        => Gebaeudeangabe(x =>
        {
            x.LadeManuellKw = wert;
            x.LadeAuto = wert is null;
        });

    /// <summary>Das Feld Zirkulationsleistung: leer = nach der Methode (auto), ein Wert = manuell.</summary>
    private void ZirkulationSetzen(double? wert)
        => Gebaeudeangabe(x =>
        {
            x.ZirkManuellKw = wert;
            x.ZirkAuto = wert is null;
        });

    // --- ZB9: das Blatt „Katalog der Nutzungsarten" --------------------------------------------

    /// <summary>Steht das Blatt des Katalogs? Dann zeichnet der Dialog seinen Haupt-Inhalt nicht.</summary>
    private bool _katalogOffen;

    /// <summary>Steht das Blatt „Katalog der Nutzungsarten"? Prüfhilfe für die Tests.</summary>
    public bool KatalogOffen => _katalogOffen;

    private void KatalogOeffnen()
    {
        if (Gewaehlte is null) return;
        _katalogOffen = true;
    }

    /// <summary>Rückknopf und Esc des Blattes: zurück ohne Wahl; der Wirt fokussiert seine Wurzel ohne zu rollen.</summary>
    private async Task KatalogZurueck()
    {
        _katalogOffen = false;
        _statusGezeigt = "\u0001";
        _wurzelFokusNoetig = true;
        await Task.CompletedTask;
    }

    /// <summary>Die Zeile des Blattes wählt die Nutzungsart der markierten Zone — derselbe Weg wie die Klappliste — und führt zurück.</summary>
    private async Task KatalogWaehlen(int id)
    {
        NutzungsartSetzen(id);
        await KatalogZurueck();
    }

    /// <summary>Nach dem Rückweg aus dem Blatt die Wurzel fokussieren (ohne zu rollen — den Rollstand stellt das Blatt her).</summary>
    private bool _wurzelFokusNoetig;

    // --- ZB2: unvollständige Zonen ---------------------------------------------------------

    /// <summary>
    /// Die unvollständigen Zonen: Position → der erste Satz, mit dem die Pflichtprüfung des OK
    /// (Delegat <see cref="Pruefen"/>, dieselben Regeln wie beim OK — keine zweite Regelsammlung) sie
    /// ablehnt. Eine solche Zone steht in der Liste als „unvollständig“ statt „0,0 · trägt 0“, ihr
    /// Block nennt den Satz leise als nächsten Schritt, und ihre Meldungen aus der Vorschau stehen
    /// weder am Block noch in den Hinweisen der Bilanz. Eine Zone, die die Prüfung besteht und
    /// trotzdem abgelehnt wird, bleibt eine Warnung. Die Prüfung liest nur den Arbeitsstand und den
    /// beim Öffnen geladenen Katalog — keine Datenbank je Zeichenlauf.
    /// </summary>
    private IReadOnlyDictionary<int, ZapfprofilMeldung> Unvollstaendige
    {
        get
        {
            var d = new Dictionary<int, ZapfprofilMeldung>();
            if (Pruefen is null) return d;
            foreach (ZapfprofilMeldung m in Pruefen(_eingabe))
                if (m.Position is int p && p >= 0 && p < _eingabe.Zonen.Count) d.TryAdd(p, m);
            return d;
        }
    }

    private bool IstUnvollstaendig(int index) => Unvollstaendige.ContainsKey(index);

    // --- ZB6: Wohnungstabelle -------------------------------------------------------------

    /// <summary>Bezugsart „Personen" als Zahl des Kerns (<c>ZapfBezugsart.Personen</c>).</summary>
    private const int BEZUGSART_PERSONEN = 1;

    /// <summary>Bezugsart „Wohneinheiten" als Zahl des Kerns (<c>ZapfBezugsart.Wohneinheiten</c>).</summary>
    private const int BEZUGSART_WOHNEINHEITEN = 2;

    /// <summary>
    /// Steht die Spalte „Ausstattungsklasse"? Nur, wenn der Katalog Klassen führt — oder eine Zeile
    /// schon eine trägt (der gespeicherte Wert bleibt sichtbar). Sonst steht statt der Spalte der
    /// Weg, die Klassen einzuspielen.
    /// </summary>
    private bool AusstattungSichtbar(ZapfprofilZonenangabenDaten a)
        => Daten.Ausstattungen.Count > 0 || a.Wohnungen.Any(w => w.IdAusstattung.HasValue);

    /// <summary>
    /// Die Summenzeile unter der Wohnungstabelle: was der Kern wirksam ansetzt — die wirksame
    /// Bezugsmenge der Vorschau in der Bezugsart der Nutzungsart. Bei Personen kommt die Zahl der
    /// Wohneinheiten aus den eingetragenen Anzahlen dazu; bei Wohneinheiten setzt der Kern keine
    /// Personenzahl an, die Zeile nennt nur die Wohneinheiten. Ohne aktuelle Vorschau leer.
    /// </summary>
    private string Wohnungssumme(ZapfprofilZoneDaten z, ZapfprofilNutzungsartDaten? art)
    {
        if (IstUnvollstaendig(_eingabe.Zonen.IndexOf(z)) || WirksameMenge(z, art) is not double menge) return "";
        if (art!.Bezugsart == BEZUGSART_WOHNEINHEITEN) return Format(Texte.WohnungenSummeWe, Zahl(menge, "0.##"));
        if (art.Bezugsart != BEZUGSART_PERSONEN) return "";
        int wohneinheiten = z.Angaben!.Wohnungen.Sum(w => w.Anzahl ?? 0);
        return Format(Texte.WohnungenSumme, wohneinheiten.ToString(CultureInfo.CurrentCulture), Zahl(menge, "0.#"));
    }

    /// <summary>
    /// Die wirksame Bezugsmenge aus der Wohnungstabelle (Kern, Vorschau) — nur, wenn die Zone eine
    /// Tabelle trägt, die bei ihrer Nutzungsart wirkt; sonst <c>null</c>.
    /// </summary>
    private double? WirksameMenge(ZapfprofilZoneDaten z, ZapfprofilNutzungsartDaten? art)
    {
        if (art is not { Wohnen: true } || z.Angaben is not { Wohnungen.Count: > 0 }) return null;
        return Zonenwertdaten(_eingabe.Zonen.IndexOf(z))?.BezugsmengeWirksam;
    }

    private IReadOnlyList<(int Id, string Text)> Topologien => new[]
    {
        ((int)ZapfprofilTopologie.Speicher, Texte.TopologieSpeicher),
        ((int)ZapfprofilTopologie.Frischwasserstation, Texte.TopologieFrischwasserstation),
        ((int)ZapfprofilTopologie.Durchfluss, Texte.TopologieDurchfluss),
        ((int)ZapfprofilTopologie.Wohnungsstation, Texte.TopologieWohnungsstation)
    };

