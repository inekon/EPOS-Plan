    private IReadOnlyList<string> Spalten => new[]
    {
        Texte.SpalteArt, Texte.SpalteBezeichnung, Texte.SpalteFlaeche, Texte.SpalteU, Texte.SpalteAzimut,
        Texte.SpalteNeigung, Texte.SpalteRand, Texte.SpalteNachbar, Texte.SpalteAufbau, Texte.SpalteAktionen
    };

    /// <summary>
    /// Der Platzhalter eines leeren Feldes: „Vorgabe: Wert" aus der Kaskade — vom Gebäude, anteilig
    /// mit dem Flächenanteil, abgeleitet (Volumen) oder, trägt auch das Gebäude keinen Wert, die
    /// Modellvorgabe <paramref name="modell"/>; ohne Gebäude kein Platzhalter.
    /// </summary>
    private string Vorgabe(Vorgabewert? v, int stellen, double? modell = null)
    {
        if (v is not Vorgabewert w) return "";
        var c = CultureInfo.CurrentCulture;
        return w.Herkunft switch
        {
            Vorgabeherkunft.Gebaeude when w.Wert is double x => string.Format(c, Texte.Vorgabe, Kurz(x, stellen)),
            Vorgabeherkunft.GebaeudeAnteilig when w.Wert is double x
                => string.Format(c, Texte.VorgabeAnteilig, Kurz(x, stellen), Kurz(100.0 * (_vorgaben?.Flaechenanteil ?? 1.0), 0)),
            Vorgabeherkunft.Abgeleitet when w.Wert is double x => string.Format(c, Texte.VorgabeAbgeleitet, Kurz(x, stellen)),
            Vorgabeherkunft.Leer when modell is double m => string.Format(c, Texte.Vorgabe, Kurz(m, stellen)),
            _ => ""
        };
    }

    /// <summary>Die Leistungsgrenze der Heizung: vom Gebäude (ab zwei Zonen anteilig), sonst „unbegrenzt".</summary>
    private string GrenzeVorgabe
        => _vorgaben is null ? ""
           : _vorgaben.HeizleistungMaxKw.Herkunft == Vorgabeherkunft.Leer ? Texte.VorgabeUnbegrenzt
           : Vorgabe(_vorgaben.HeizleistungMaxKw, 1);

    /// <summary>Die Leistungsgrenze der Kühlung (KU3-3): vom Gebäude (ab zwei Zonen anteilig), sonst „unbegrenzt".</summary>
    private string KuehlGrenzeVorgabe
        => _vorgaben is null ? ""
           : _vorgaben.KuehlleistungMaxKw.Herkunft == Vorgabeherkunft.Leer ? Texte.VorgabeUnbegrenzt
           : Vorgabe(_vorgaben.KuehlleistungMaxKw, 1);

    /// <summary>Wird die Zone gekühlt — ihr Schalter, leer der des Gebäudes (KU3-3)?</summary>
    public bool KuehlungAktivWirksam => _stand.KuehlungAktiv ?? Gebaeude?.KuehlungAktiv ?? false;

    /// <summary>Die Einträge des Schalters: 0 = „wie Gebäude (Ja/Nein)", 1 = Ja, 2 = Nein.</summary>
    private IReadOnlyList<(int Id, string Text)> KuehlAktivEintraege => new List<(int, string)>
    {
        (0, string.Format(CultureInfo.CurrentCulture, Texte.UebergabeWieGebaeude,
                          Gebaeude?.KuehlungAktiv == true ? JaText : NeinText)),
        (1, JaText),
        (2, NeinText),
    };

    /// <summary>Der Listenplatz des Schalters: NULL = 0, wahr = 1, falsch = 2.</summary>
    private int KuehlAktivIndex => _stand.KuehlungAktiv switch { null => 0, true => 1, false => 2 };

    private void KuehlAktivWaehlen(int? index)
    {
        if (index is not int i || i < 0 || i > 2) return;
        Setzen(() => _stand.KuehlungAktiv = i == 0 ? null : i == 1);
    }

    /// <summary>Der Luftwechsel der Zone [1/h] und woher er kommt — dieselbe Regel wie im Kern.</summary>
    private string Luftwechselzeile
    {
        get
        {
            if (_vorgaben is null) return "";
            double n = Gebaeudemodellvorgaben.WirksamerLuftwechsel(_vorgaben.Luftwechselrate,
                _vorgaben.LuftwechselInfiltration.Wert, _vorgaben.LuftwechselNutzer.Wert, out Luftwechselherkunft herkunft);
            string quelle = herkunft switch
            {
                Luftwechselherkunft.InfiltrationUndNutzer => Texte.HerkunftInfiltrationNutzer,
                Luftwechselherkunft.Luftwechselrate => Texte.HerkunftLuftwechselrate,
                _ => Texte.HerkunftVorgabe
            };
            return string.Format(CultureInfo.CurrentCulture, Texte.ZeileLuftwechsel, Kurz(n, 2), quelle);
        }
    }

    // ---- Die Uebergabe je Zone (E63, AK1z) ----

    /// <summary>Die Übergabewerte des Gebäudes im Arbeitsstand des Editors; <c>null</c> ohne Gebäude.</summary>
    private GebaeudeKatalogDaten? GebaeudeUebergabe => Gebaeudestand?.Stand;

    /// <summary>Die wirksame Art: die der Zone, sonst die des Gebäudes (Kaskade des Kerns).</summary>
    private string? WirksameArt => _stand.UebergabeArt ?? GebaeudeUebergabe?.UebergabeArt;

    /// <summary>Rechnet die wirksame Art eine Übergabe? Dann stehen die Zahlenfelder.</summary>
    private bool UebergabeRechnet => Waermeuebergabevorgaben.ArtRechnet(WirksameArt);

    /// <summary>Stehen die Zahlenfelder der Übergabe? Beheizt, nicht gesperrt, rechnende Art.</summary>
    private bool UebergabeFelderSichtbar => UebergabeSperre is null && _stand.IstBeheizt && UebergabeRechnet;

    private IEnumerable<string> UebergabeFeldnamen => new[]
    {
        Texte.UebergabeLabelExponent, Texte.UebergabeLabelNennleistung, Texte.UebergabeLabelVorlauf,
        Texte.UebergabeLabelRuecklauf, Texte.UebergabeLabelRaum, Texte.UebergabeLabelBand
    }.Select(Feld);

    private static string Feld(string beschriftung) => GebaeudeArbeitsstand.Feld(beschriftung);

    /// <summary>Die Einträge der Art: 0 = „wie Gebäude (Art des Gebäudes)", dann die vier Arten; eine unbekannte steht als −1.</summary>
    private IReadOnlyList<(int Id, string Text)> UebergabeArteintraege
    {
        get
        {
            var l = new List<(int, string)>();
            if (UebergabeArtindex < 0) l.Add((-1, _stand.UebergabeArt ?? ""));
            l.Add((0, string.Format(CultureInfo.CurrentCulture, Texte.UebergabeWieGebaeude,
                                    Texte.UebergabeArtname(GebaeudeUebergabe?.UebergabeArt))));
            for (int i = 0; i < Waermeuebergabevorgaben.Arten.Count; i++)
                l.Add((i + 1, Texte.UebergabeArtname(Waermeuebergabevorgaben.Arten[i])));
            return l;
        }
    }

    /// <summary>Der Listenplatz der Art: NULL = 0 („wie Gebäude"), sonst 1 bis 4; unbekannt = −1.</summary>
    private int UebergabeArtindex
    {
        get
        {
            if (_stand.UebergabeArt is null) return 0;
            for (int i = 0; i < Waermeuebergabevorgaben.Arten.Count; i++)
                if (Waermeuebergabevorgaben.Arten[i] == _stand.UebergabeArt) return i + 1;
            return -1;
        }
    }

    private void UebergabeArtWaehlen(int? index)
    {
        if (index is not int i || i < 0 || i > Waermeuebergabevorgaben.Arten.Count) return;
        Setzen(() => _stand.UebergabeArt = i == 0 ? null : Waermeuebergabevorgaben.Arten[i - 1]);
    }

    /// <summary>Der Assistent setzt die Art: leer = wie Gebäude, sonst einer der vier Steuerwerte.</summary>
    private void UebergabeArtSetzenKi(string? wert)
    {
        string? w = string.IsNullOrWhiteSpace(wert) ? null : wert.Trim().ToUpperInvariant();
        if (w is not null && !Waermeuebergabevorgaben.Arten.Contains(w))
            throw new InvalidOperationException(string.Format(CultureInfo.CurrentCulture, Texte.MeldungUebergabeArt,
                                                              (_stand.Bezeichner ?? "").Trim(), wert));
        Setzen(() => _stand.UebergabeArt = w);
    }

    /// <summary>
    /// Der Platzhalter eines leeren Übergabefeldes: der Wert des Gebäudes („wie Gebäude: …"), sonst die
    /// Vorgabe („Vorgabe: …"); ohne beide kein Platzhalter.
    /// </summary>
    private string UebergabePlatzhalter(double? gebaeude, double? vorgabe, int stellen)
    {
        var c = CultureInfo.CurrentCulture;
        if (gebaeude is double g) return string.Format(c, Texte.UebergabePlatzhalter, Kurz(g, stellen));
        if (vorgabe is double v) return string.Format(c, Texte.Vorgabe, Kurz(v, stellen));
        return "";
    }

    /// <summary>Die Herleitungszeile: wirksame Art mit Herkunft und den Vorgaben der Art als Zahlen.</summary>
    private string UebergabeArtZeile
    {
        get
        {
            var c = CultureInfo.CurrentCulture;
            string herkunft = _stand.UebergabeArt is null ? Texte.UebergabeHerkunftGebaeude : Texte.UebergabeHerkunftZone;
            string? art = WirksameArt;
            if (!UebergabeRechnet) return string.Format(c, Texte.UebergabeZeileIdeal, herkunft);
            return string.Format(c, Texte.UebergabeZeileArt, Texte.UebergabeArtname(art), herkunft,
                                 Zahl(Waermeuebergabevorgaben.Exponent(art), 2), Zahl(Waermeuebergabevorgaben.Vorlauf(art), 0),
                                 Zahl(Waermeuebergabevorgaben.Ruecklauf(art), 0), Zahl(Waermeuebergabevorgaben.Proportionalband, 1));
        }
    }

    /// <summary>„Ohne Wirkung" samt Grund: Heizkreis des Gebäudes aus, sonst Projekt ohne Kopplungsstufe; leer = wirkt.</summary>
    private string UebergabeOhneWirkung
        => GebaeudeUebergabe is GebaeudeKatalogDaten g && !g.HeizkreisAktiv ? Texte.UebergabeZeileHeizkreisAus
           : ProjektKoppelt == false ? Texte.UebergabeZeileProjektAus
           : "";

    /// <summary>
    /// Die wirksame Übergabe mit Herkunft je Wert — die Lesezeile des Assistenten: an der Zone gesetzt,
    /// sonst der Platzhalter (wie Gebäude bzw. Vorgabe), dazu der Grund, wenn sie nicht wirkt.
    /// </summary>
    private string UebergabeWirksam
    {
        get
        {
            if (UebergabeSperre is not null) return UebergabeSperre;
            if (!_stand.IstBeheizt) return Texte.UebergabeZeileUnbeheizt;
            var teile = new List<string> { UebergabeArtZeile };
            if (UebergabeRechnet)
            {
                string? art = WirksameArt;
                GebaeudeKatalogDaten? g = GebaeudeUebergabe;
                void Wert(string label, double? zone, string leer, int stellen)
                    => teile.Add(Feld(label) + ": " + (zone is double z
                        ? Kurz(z, stellen) + " (" + Texte.UebergabeHerkunftZone + ")"
                        : leer));
                Wert(Texte.UebergabeLabelExponent, _stand.UebergabeExponent,
                     UebergabePlatzhalter(g?.UebergabeExponent, Waermeuebergabevorgaben.Exponent(art), 2), 2);
                Wert(Texte.UebergabeLabelNennleistung, _stand.UebergabeLeistungNennKw, Texte.UebergabePlatzhalterNennleistung, 2);
                Wert(Texte.UebergabeLabelVorlauf, _stand.AuslegungVorlauf,
                     UebergabePlatzhalter(g?.AuslegungVorlauf, Waermeuebergabevorgaben.Vorlauf(art), 0), 1);
                Wert(Texte.UebergabeLabelRuecklauf, _stand.AuslegungRuecklauf,
                     UebergabePlatzhalter(g?.AuslegungRuecklauf, Waermeuebergabevorgaben.Ruecklauf(art), 0), 1);
                Wert(Texte.UebergabeLabelRaum, _stand.AuslegungRaumtemperatur,
                     UebergabePlatzhalter(g?.AuslegungRaumtemperatur, _vorgaben?.SollTag.Wert, 1), 1);
                Wert(Texte.UebergabeLabelBand, _stand.ReglerProportionalband,
                     UebergabePlatzhalter(g?.ReglerProportionalband, Waermeuebergabevorgaben.Proportionalband, 1), 1);
            }
            if (UebergabeOhneWirkung.Length > 0) teile.Add(UebergabeOhneWirkung);
            return string.Join(" | ", teile);
        }
    }

    /// <summary>
    /// Die Bänder der Übergabe — dieselben wie <c>GebaeudeZonenCtrl.UebergabePruefen</c>: Vorlauf, Raum und
    /// Proportionalband, wenn gesetzt; der Rücklauf unter dem Vorlauf, wenn beide gesetzt sind.
    /// </summary>
    private string? UebergabePruefen(string zn)
    {
        var k = CultureInfo.CurrentCulture;
        static bool Ausserhalb(double w, double min, double max) => double.IsNaN(w) || w < min || w > max;
        if (_stand.AuslegungVorlauf is double v
            && Ausserhalb(v, Waermeuebergabevorgaben.VORLAUF_MIN, Waermeuebergabevorgaben.VORLAUF_MAX))
            return string.Format(k, Texte.MeldungUebergabeVorlauf, zn, v,
                                 Waermeuebergabevorgaben.VORLAUF_MIN, Waermeuebergabevorgaben.VORLAUF_MAX);
        if (_stand.AuslegungRuecklauf is double r && (double.IsNaN(r) || double.IsInfinity(r)
                                                      || (_stand.AuslegungVorlauf is double vl && !(r < vl))))
            return string.Format(k, Texte.MeldungUebergabeRuecklauf, zn, r, _stand.AuslegungVorlauf ?? double.NaN);
        if (_stand.AuslegungRaumtemperatur is double t
            && Ausserhalb(t, Waermeuebergabevorgaben.RAUM_MIN, Waermeuebergabevorgaben.RAUM_MAX))
            return string.Format(k, Texte.MeldungUebergabeRaum, zn, t,
                                 Waermeuebergabevorgaben.RAUM_MIN, Waermeuebergabevorgaben.RAUM_MAX);
        if (_stand.ReglerProportionalband is double xp
            && Ausserhalb(xp, Waermeuebergabevorgaben.BAND_MIN, Waermeuebergabevorgaben.BAND_MAX))
            return string.Format(k, Texte.MeldungUebergabeBand, zn, xp,
                                 Waermeuebergabevorgaben.BAND_MIN, Waermeuebergabevorgaben.BAND_MAX);
        return null;
    }

    private static string Kurz(double w, int stellen)
        => w.ToString(stellen <= 0 ? "0" : "0." + new string('#', stellen), CultureInfo.CurrentCulture);

    private string NutzflaechePlatzhalter
        => !NutzflaechePflicht && NutzflaecheGebaeude is double a
            ? string.Format(CultureInfo.CurrentCulture, Texte.PlatzhalterNutzflaeche, Zahl(a, 2))
            : "";

    /// <summary>Die Texte von „Nutzungsprofil übernehmen…" (Bündel des Nutzungsprofilkatalogs, Präfix <c>RNP_</c>).</summary>
    [Parameter] public RaumnutzungTexte RaumnutzungTexte { get; set; } = new();

    /// <summary>
    /// „Nutzungsprofil: Büro" (Stufe NP3b): das zuletzt übernommene Profil der Zone, sonst die Nutzung ihrer Kalender —
    /// eine der vier alten Kennungen übersetzt (NP-F15); leer = keines.
    /// </summary>
    private string Profilzeile
    {
        get
        {
            string? name = !string.IsNullOrWhiteSpace(_stand.Nutzungsprofil) ? _stand.Nutzungsprofil : _stand.Kalendernutzung;
            if (string.IsNullOrWhiteSpace(name)) return "";
            return string.Format(CultureInfo.CurrentCulture, RaumnutzungTexte.Zonenkopf,
                                 KonditionierungTexte.Nutzungsanzeige(name.Trim()));
        }
    }

    private string NutzflaecheZeile
        => string.Format(CultureInfo.CurrentCulture, NutzflaechePflicht ? Texte.ZeileNutzflaechePflicht : Texte.ZeileNutzflaeche,
                         NutzflaecheGebaeude is double a ? Zahl(a, 2) : "—");

    private static string ArtText(string art) => BauteilaufbauCtrl.BauteilartText(art);

    private string UText(BauteilDaten b)
    {
        if (b.UWert is double u) return Zahl(u, 3);
        if (b.UAufbau is double ua) return Zahl(ua, 3) + " (" + Texte.UAusAufbau + ")";
        return "—";
    }

    private static string Winkel(double? w) => w is double x ? Zahl(x, 0) + "°" : "—";

    private static string NeigungText(BauteilDaten b)
        => b.Neigung is double n ? Zahl(n, 0) + "°" : "(" + Zahl(GebaeudeZonenCtrl.NeigungVorgabe(b.Bauteilart), 0) + "°)";

    private string RandText(BauteilDaten b) => b.Randbedingung switch
    {
        null => GebaeudeZonenCtrl.LeerHeisstInnen(b.Bauteilart) ? BauteilTexte.RandVorgabeInnen : BauteilTexte.RandVorgabeAussen,
        DbWerte.RANDBEDINGUNG_AUSSENLUFT => BauteilTexte.RandAussenluft,
        DbWerte.RANDBEDINGUNG_ERDREICH => BauteilTexte.RandErdreich,
        DbWerte.RANDBEDINGUNG_UNBEHEIZT => BauteilTexte.RandUnbeheizt,
        DbWerte.RANDBEDINGUNG_ZONE => BauteilTexte.RandZone,
        _ => b.Randbedingung
    };

    /// <summary>Der Name der Nachbarzone einer Trennfläche; „—" ohne Nachbar.</summary>
    private string NachbarText(BauteilDaten b)
        => b.IdNachbarzone is int id
            ? Nachbarzonen.FirstOrDefault(n => n.Id == id)?.Bezeichner ?? "#" + id.ToString(CultureInfo.InvariantCulture)
            : "—";

    /// <summary>Der Azimut der Gegenseite: gespiegelt (+180°).</summary>
    private static string WinkelGespiegelt(double? w) => w is double x ? Winkel((x + 180.0) % 360.0) : "—";

    /// <summary>Die Neigung der Gegenseite: gespiegelt (180° − Neigung).</summary>
    private static string NeigungGespiegelt(BauteilDaten b)
        => Zahl(180.0 - (b.Neigung ?? GebaeudeZonenCtrl.NeigungVorgabe(b.Bauteilart)), 0) + "°";

    /// <summary>
    /// Der Summenfuß: Σ A je Gruppe der Hülle (gruppiert im Kern, <see cref="Gebaeudehuellbilanz.Zonenzeilen"/>)
    /// und H_T = Σ U·A + Σ ψ·L.
    /// </summary>
    private IReadOnlyList<(string Text, bool Stark)> Summen
    {
        get
        {
            if (_stand.Bauteile.Count == 0) return Array.Empty<(string, bool)>();
            var c = CultureInfo.CurrentCulture;
            IReadOnlyList<Huellzeile> zeilen = Zonensummen.Zeilen(_stand);
            var liste = new List<(string, bool)>();
            foreach (Huellzeile z in zeilen)
                if ((z.Groesse ?? 0.0) > 0.0)
                    liste.Add((string.Format(c, Texte.SummeGruppe, Zonensummen.Gruppentext(z.Bauteil), Zahl(z.Groesse, 2)), false));
            liste.Add((string.Format(c, Texte.SummeHT, Zahl(Zonensummen.HT(_stand), 1)), true));
            return liste;
        }
    }

    private static string Zahl(double? w, int stellen) => GebaeudeArbeitsstand.Zahl(w, stellen);

    // =================================================================================
    // Bauteile: oeffnen, anlegen, entfernen - alles im Arbeitsstand
    // =================================================================================

    private void BauteilOeffnen(int index)
    {
        if (index < 0 || index >= _stand.Bauteile.Count) return;
        _bauteilIndex = index;
        _bauteilNeu = false;
        _bauteil = _stand.Bauteile[index];
    }

    private void BauteilNeu()
    {
        int id = Math.Min(0, _stand.Bauteile.Count == 0 ? 0 : _stand.Bauteile.Min(b => b.Id)) - 1;
        _bauteilIndex = -1;
        _bauteilNeu = true;
        _bauteil = new BauteilDaten { Id = id, Herkunft = DbWerte.HERKUNFT_MANUELL };
    }

    private void BauteilEntfernen(int index)
    {
        if (index < 0 || index >= _stand.Bauteile.Count) return;
        _stand.Bauteile.RemoveAt(index);
        _meldung = "";
    }

    /// <summary>Der Bauteildialog ist zu: mit Ergebnis übernimmt die Zeile (neu angehängt), sonst bleibt alles.</summary>
    private void BauteilFertig(BauteilDaten? ergebnis)
    {
        BauteilDaten? offen = _bauteil;
        _bauteil = null;
        if (ergebnis is null || offen is null) return;
        if (_bauteilIndex >= 0 && _bauteilIndex < _stand.Bauteile.Count) _stand.Bauteile[_bauteilIndex] = ergebnis;
        else _stand.Bauteile.Add(ergebnis);
        _bauteilIndex = -1;
        _meldung = "";
    }

    // =================================================================================
    // Pruefen und Schliessen
    // =================================================================================

    private void FehlerMelden((string Feld, bool Fehlerhaft) e)
    {
        if (e.Fehlerhaft) _fehlerfelder.Add(e.Feld);
        else _fehlerfelder.Remove(e.Feld);
    }

    /// <summary>Die Prüfregeln der Zone — genau einmal, für OK und Assistent. <c>null</c> = gültig.</summary>
    private string? Pruefen()
    {
        if (_fehlerfelder.Count > 0)
            return string.Format(CultureInfo.CurrentCulture, BauteilTexte.MeldungUngueltig, _fehlerfelder.First());
        string name = (_stand.Bezeichner ?? "").Trim();
        if (name.Length == 0) return Texte.MeldungName;
        if (NutzflaechePflicht && _stand.Nutzflaeche is null)
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungNutzflaechePflicht, name);
        if (_stand.Nutzflaeche is double a && (!(a > 0.0) || double.IsInfinity(a)))
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungNutzflaeche, name);
        if (_stand.Raumhoehe is double h && (!(h > 0.0) || double.IsInfinity(h)))
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungRaumhoehe, name);
        if (_stand.Volumen is double v && (!(v > 0.0) || double.IsInfinity(v)))
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungVolumen, name);
        return UebergabePruefen(name);
    }

    private Task BeiErgebnis(bool ok)
    {
        if (!ok) return Abbrechen();
        string? fehler = Pruefen();
        if (fehler is not null)
        {
            _meldung = fehler;
            return Task.CompletedTask;
        }
        _meldung = "";
        _stand.Bezeichner = _stand.Bezeichner.Trim();
        return Geschlossen.InvokeAsync(_stand.Kopie());
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Esc kaskadiert: der offene Bauteildialog und eine Rueckfrage der Zonenmatrix werten ihn selbst aus.
        if (e.Key != "Escape" || _bauteil is not null || _kond.OffeneFrage is not null) return Task.CompletedTask;
        return Abbrechen();
    }

    /// <summary>Abbrechen — von Esc und vom Schliesskreuz gleichermaßen gerufen.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(null);
}
