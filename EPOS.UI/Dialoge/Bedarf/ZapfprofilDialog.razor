        (RASTER_WERKTAG, Texte.TagtypWerktag), (RASTER_SAMSTAG, Texte.TagtypSamstag),
        (RASTER_SONNFEIERTAG, Texte.TagtypSonntag), (RASTER_FERIEN, Texte.TagtypFerien)
    };

    // Die Farbe je Tagtyp im Jahresraster — die Tagesarten des Kalenders im Gebäudedialog (epos-kalb-art-n).
    private const int RASTER_WERKTAG = 0, RASTER_SAMSTAG = 1, RASTER_SONNFEIERTAG = 5, RASTER_FERIEN = 4;

    /// <summary>Das zuletzt gezeichnete Jahresraster je Zone — es bleibt stehen, solange die Vorschau neu rechnet.</summary>
    private (ZapfprofilZoneDaten Zone, int[] Tage)? _jahresraster;

    /// <summary>
    /// Die Tagesarten des Jahresrasters der gewählten Zone: die Tagtypen ihres wirksamen Kalenders aus dem Rechenweg der
    /// Vorschau (<see cref="ZapfprofilAnsichtDaten.Tagtypen"/>) — keine zweite Regel in der Oberfläche. Rechnet die
    /// Vorschau gerade neu, bleibt das letzte Raster derselben Zone stehen; <c>null</c> ohne Vorschau oder für eine
    /// abgelehnte Zone.
    /// </summary>
    private int[]? TagtypenDerZone()
    {
        if (Gewaehlte is not { } z) return null;
        if (_vorschauAktuell && _vorschau is not null)
        {
            ZapfprofilAnsichtDaten? ansicht = _wahl >= 0 && _wahl + 1 < _vorschau.Ansichten.Count ? _vorschau.Ansichten[_wahl + 1] : null;
            if (ansicht is not { Abgelehnt: false, Tagtypen.Length: > 0 })
            {
                _jahresraster = null;
                return null;
            }
            int[] tage = ansicht.Tagtypen!.Select(t => t switch
            {
                2 => RASTER_SAMSTAG,
                3 => RASTER_SONNFEIERTAG,
                4 => RASTER_FERIEN,
                _ => RASTER_WERKTAG
            }).ToArray();
            if (_jahresraster is not { } alt || !ReferenceEquals(alt.Zone, z) || !alt.Tage.SequenceEqual(tage))
                _jahresraster = (z, tage);
        }
        return _jahresraster is { } stand && ReferenceEquals(stand.Zone, z) ? stand.Tage : null;
    }

