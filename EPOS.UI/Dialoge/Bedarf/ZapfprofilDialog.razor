    private bool TyptageDa => Typtagstand.Vorhanden;

    /// <summary>Die Klimazonen des eingespielten Pakets als Wahlliste (Nummer = Id).</summary>
    private IReadOnlyList<(int Id, string Text)> Typtagzonen
    {
