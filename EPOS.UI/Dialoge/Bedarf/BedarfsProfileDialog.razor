    public bool SatzUeberlagerungOffen => _satzGross;

    /// <summary>
    /// Der Stand einer Projektzeile beim Öffnen der Satz-Überlagerung — Abbrechen schreibt ihn
    /// zurück (Muster <c>Anlagenmerker</c>): Jahressumme, Temperaturpaar samt Kennzeichen, Kalender.
    /// </summary>
    private sealed record Satzmerker(BedarfsProfilZeile Zeile, double Summe, double? Vorlauf, double? Ruecklauf,
                                     bool TemperaturGeaendert, int? KalenderId, string KaelteArt)
    {
        public static Satzmerker Von(BedarfsProfilZeile z)
            => new(z, z.Summe, z.Vorlauf, z.Ruecklauf, z.TemperaturGeaendert, z.KalenderId, z.KaelteArt);

        public bool Zurueckschreiben()
        {
            bool anders = Zeile.Summe != Summe || Zeile.Vorlauf != Vorlauf || Zeile.Ruecklauf != Ruecklauf ||
                          Zeile.TemperaturGeaendert != TemperaturGeaendert || Zeile.KalenderId != KalenderId ||
                          Zeile.KaelteArt != KaelteArt;
            Zeile.Summe = Summe; Zeile.Vorlauf = Vorlauf; Zeile.Ruecklauf = Ruecklauf;
            Zeile.TemperaturGeaendert = TemperaturGeaendert; Zeile.KalenderId = KalenderId;
            Zeile.KaelteArt = KaelteArt;
            return anders;
        }
    }

    /// <summary>Ein fester Schlüssel je Projektzeile (die Liste gehört der Hülle, Ids können fehlen).</summary>
    private string Projektschluessel(BedarfsProfilZeile z)
    {
        if (!_schluessel.TryGetValue(z, out string? s))
        {
            s = "z" + (_naechsterSchluessel++).ToString(System.Globalization.CultureInfo.InvariantCulture);
            _schluessel[z] = s;
        }
        return s;
    }

    private IReadOnlyList<string> ProjektSchluessel() => Zeilen.Select(Projektschluessel).ToList();

    private IReadOnlyList<string> KatalogSichtbar()
        => (_katalogliste?.Angezeigt ?? _katalog).Select(z => z.Schluessel).ToList();

    /// <summary>Die Ziele einer Projektaktion: die angekreuzten Zeilen, sonst die gewählte.</summary>
    private List<BedarfsProfilZeile> ProjektZiele()
    {
        if (_projektWahl.Anzahl > 0)
            return _projektWahl.Gewaehlte
                .Select(s => Zeilen.FirstOrDefault(z => Projektschluessel(z) == s))
                .OfType<BedarfsProfilZeile>().ToList();
        return _gewaehlt is null ? new() : new() { _gewaehlt };
    }

    /// <summary>Die Ziele einer Katalogaktion: die angekreuzten Sätze, sonst der gewählte.</summary>
    private List<Katalogfilterzeile> KatalogZiele()
    {
        if (_katalogWahl.Anzahl > 0)
            return _katalogWahl.Gewaehlte
                .Select(s => _katalog.FirstOrDefault(z => z.Schluessel == s))
                .OfType<Katalogfilterzeile>().ToList();
        return _katalogzeile is null ? new() : new() { _katalogzeile };
    }

    /// <summary>
    /// Klick in eine Projektzeile (AW3b, wie Heizkessel): Die Zeile wird der gewählte Satz, die Detailzeile folgt;
    /// die Kästchen der Mehrfachwahl bleiben unberührt — wie in der Katalogliste.
    /// </summary>
    private void ProjektZeileKlick(BedarfsProfilZeile zeile)
    {
        if (_gewaehlt != zeile) ProjektzeileWaehlen(zeile);
    }

    /// <summary>Die Hervorhebung der gewählten Projektzeile — dieselbe Klasse wie in der Katalogliste.</summary>
    private string? ProjektZeilenklasse(BedarfsProfilZeile zeile) => zeile == _gewaehlt ? "epos-zeile--gewaehlt" : null;

    /// <summary>↑ ↓ Pos1 Ende in der Projektliste: die Regel rechnet der Baustein.</summary>
    private Task BeiProjektTaste(KeyboardEventArgs e)
        => _zweispalten is null ? Task.CompletedTask : _zweispalten.ProjektTasteAsync(e.Key);

    /// <summary>Die Tastenführung hat eine andere Projektzeile gewählt.</summary>
    private void BeiProjektTastenwahl(string schluessel)
    {
        BedarfsProfilZeile? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == schluessel);
        if (zeile is not null) ProjektZeileKlick(zeile);
    }

    /// <summary>
    /// Der Grund der weichen Sperre von Schloss… und Löschen (AW3b): Sie wirken nur auf Katalogsätze; steht ein
    /// Projektsatz, nennen sie „Katalogsatz wählen".
    /// </summary>
    private string? KatalogSperrgrund => SatzArt == Satzmarke.Projektsatz ? Resource.AUSWAHL_SPERRE_KATALOGSATZ : null;

    /// <summary>
    /// „Bearbeiten…" am Katalogsatz (AW3b): der erste freie Zielsatz im Katalogeditor, sonst der gesperrte nur
    /// lesend in der Satz-Überlagerung — derselbe Weg wie der Stift der Katalogzeile.
    /// </summary>
    private Task BeiKatalogBearbeiten()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return Task.CompletedTask;
        return BeiKatalogStift(ziele.FirstOrDefault(z => !z.Geschuetzt) ?? ziele[0]);
    }

    private void BeiWahlGeaendert(Auswahlbereich bereich)
    {
        if (bereich != Auswahlbereich.Projekt || _projektWahl.Zuletzt is not string s) return;
        if (!_projektWahl.IstGewaehlt(s)) return;
        BedarfsProfilZeile? zeile = Zeilen.FirstOrDefault(z => Projektschluessel(z) == s);
        if (zeile is not null && zeile != _gewaehlt) ProjektzeileWaehlen(zeile);
    }

    private void BeiKatalogKaestchen(IReadOnlyList<string> gewaehlt)
    {
        _katalogKaestchen = gewaehlt;
        _katalogWahl.Setzen(gewaehlt);
    }

    private void KatalogKaestchenLeeren()
    {
        _katalogWahl.Leeren();
        _katalogKaestchen = new List<string>();
    }

    private string SummeText(double mwh) => _einheit.Formatiere(_einheit.AusMWh(mwh));

    /// <summary>Die Kenndaten der zugeklappten Zeile: Typ und Jahressumme, beim gesperrten Satz der Hinweis.</summary>
    private string? SatzKenndaten
    {
        get
        {
            if (SatzArt == Satzmarke.Keiner) return null;
            var teile = new List<string>();
            if (_infoTyp.Length > 0) teile.Add(_infoTyp);
            teile.Add(Jahresverbrauch);
            if (_katalogzeile?.Geschuetzt == true) teile.Add(Resource.AUSWAHL_SATZ_NUR_LESEN);
            return string.Join(" · ", teile);
        }
    }

    /// <summary>
    /// Die Zusammenfassung der Detailzeile (UeS2): Projektsatz Typ, Jahressumme, Temperaturpaar
    /// (Prozesswärme, Kälte), Kalender, Beschreibung kurz; Katalogsatz Typ, Beschreibung,
    /// Jahressumme, Temperaturpaar.
    /// </summary>
    private IReadOnlyList<Satzangabe> Zusammenfassung()
    {
        var l = new List<Satzangabe>();
        if (SatzArt == Satzmarke.Keiner) return l;
        if (_infoTyp.Length > 0) l.Add(new(Resource.BPF_ZF_TYP, _infoTyp));
        l.Add(new(Resource.BPF_ZF_JAHRESSUMME, Jahresverbrauch));
        if (MitTemperatur && _infoTemperatur.Length > 0 && _infoTemperatur != TextOhneTemperatur)
            l.Add(new(Resource.AUSWAHL_ZF_VORLAUF_RUECKLAUF, _infoTemperatur));
        if (_gewaehlt is not null && Betriebskalender is not null)
            l.Add(new(Resource.BPF_ZF_KALENDER,
                      KalenderWahlEintraege.FirstOrDefault(e => e.Id == (_gewaehlt.KalenderId ?? 0)).Text ?? TextOhneKalender));
        if (DeckungSichtbar)
            l.Add(new(Resource.DECK_GRUPPE, _gewaehlt!.Deckung!.Zusammenfassung()));
        if (_infoBeschreibung.Length > 0)
            l.Add(new(Resource.BPF_ZF_BESCHREIBUNG,
                      _infoBeschreibung.Length > 60 ? _infoBeschreibung[..57].TrimEnd() + "…" : _infoBeschreibung));
        return l;
    }

    /// <summary>Die Überlagerung ist aufgegangen: Eingaben auf den Stand der Zeile, Merker setzen.</summary>
    private void BeiSatzVergroessert()
    {
        _satzGross = true;
        _satzUeberlagerungFehler = null;
        _merker = _gewaehlt is not null ? Satzmerker.Von(_gewaehlt) : null;
        if (_gewaehlt is not null) { _neuVorlauf = _gewaehlt.Vorlauf; _neuRuecklauf = _gewaehlt.Ruecklauf; }
        _deckungArbeit = DeckungSichtbar ? _gewaehlt!.Deckung!.Kopie() : null;
    }

    /// <summary>
    /// OK der Überlagerung: angefangene Eingaben (Jahressumme, Temperaturpaar) gehen in den
    /// Arbeitsstand der Zeile, über den Fangweg <c>Katalogladung.Schreiben</c> (KT‑4). Lehnt eine
    /// Prüfung ab, bleibt die Überlagerung mit dem Grund offen.
    /// </summary>
    private void BeiSatzUebernommen()
    {
        if (_gewaehlt is not null)
        {
            string grund = Katalogladung.Schreiben(SatzAnwenden, TitelText, g => g);
            if (grund.Length > 0)
            {
                _satzUeberlagerungFehler = grund;
                _zweispalten?.SatzOffenHalten();
                return;
            }
        }
        _satzGross = false;
        _satzUeberlagerungFehler = null;
        _merker = null;
        _deckungArbeit = null;
    }

    /// <summary>Die angefangenen Eingaben der Überlagerung; leer = übernommen, sonst der Grund.</summary>
    private string SatzAnwenden()
    {
        BedarfsProfilZeile z = _gewaehlt!;
        if (_neuerWert is double wert)
        {
            if (wert < 0) return string.Format(MeldungWertUngueltig, _einheit.Text);
            double mwh = _einheit.NachMWh(wert);
            if (mwh != z.Summe) { z.Summe = mwh; _jahresverbrauchMWh = mwh; Geaendert?.Invoke(); }
            _neuerWert = null;
        }
        if (MitTemperatur && (_neuVorlauf != z.Vorlauf || _neuRuecklauf != z.Ruecklauf))
        {
            string? g = TemperaturPruefen?.Invoke(_neuVorlauf, _neuRuecklauf);
            if (!string.IsNullOrEmpty(g)) return g;
            z.Vorlauf = _neuVorlauf; z.Ruecklauf = _neuRuecklauf; z.TemperaturGeaendert = true;
            _infoTemperatur = TemperaturText(_neuVorlauf, _neuRuecklauf);
            Geaendert?.Invoke();
        }
        // K5b: die Deckung der Kaeltezeile - „Split ohne EER" haelt die Ueberlagerung mit dem Grund offen.
        if (_deckungArbeit is not null && z.Deckung is not null)
        {
            if (_deckungArbeit.Pruefgrund() is not null) return MeldungDeckungOhneEer;
            if (!DeckungGleich(z.Deckung, _deckungArbeit)) { z.Deckung.Uebernehmen(_deckungArbeit); Geaendert?.Invoke(); }
        }
        return "";
    }

    /// <summary>Abbrechen, ✕, Esc oder Schließen: der Stand beim Öffnen kommt zurück (Merker).</summary>
    private void BeiSatzVerworfen()
    {
        _satzGross = false;
        _satzUeberlagerungFehler = null;
        if (_merker is { } m && m.Zurueckschreiben())
        {
            Geaendert?.Invoke();
            if (_gewaehlt == m.Zeile) ProjektzeileWaehlen(m.Zeile);
        }
        _merker = null;
        _neuerWert = null;
        _deckungArbeit = null;
    }

    /// <summary>„Bearbeiten…" der Projekt-Kopfleiste: EINE Projektzeile in der Satz-Überlagerung.</summary>
    private async Task BeiProjektBearbeiten()
    {
        List<BedarfsProfilZeile> ziele = ProjektZiele();
        if (ziele.Count != 1 || _zweispalten is null) return;
        if (_gewaehlt != ziele[0]) ProjektzeileWaehlen(ziele[0]);
        await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>UeS2: der Stift einer Projektzeile — wählen (Kästchen bleiben) und öffnen.</summary>
    private async Task BeiProjektStift(BedarfsProfilZeile zeile)
    {
        if (_zweispalten is null) return;
        if (_gewaehlt != zeile) ProjektzeileWaehlen(zeile);
        await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// UeS2: der Stift einer Katalogzeile — gesperrt nur lesend in der Satz-Überlagerung,
    /// ungesperrt der Katalogeditor „DB ändern…" mit diesem Satz (KA‑E‑13).
    /// </summary>
    private async Task BeiKatalogStift(Katalogfilterzeile zeile)
    {
        if (_katalogzeile?.Bezeichner != zeile.Bezeichner) KatalogzeileWaehlen(zeile.Bezeichner);
        if (!zeile.Geschuetzt && TypStammGaben is not null)
        {
            BeiDbAendern();
            return;
        }
        if (_zweispalten is not null) await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// „Löschen": ein Satz fragt nach; bei mehreren werden gesperrte und im Projekt zugeordnete
    /// übersprungen und in der EINEN Rückfrage genannt.
    /// </summary>
    private void BeiLoeschenGefragt()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        _loeschGesperrt = new();
        _loeschZugeordnet = new();
        if (ziele.Count == 1)
        {
            _loeschziele = ziele;
        }
        else
        {
            var namen = new HashSet<string>(Zeilen.Select(z => z.Name), StringComparer.Ordinal);
            _loeschGesperrt = ziele.Where(z => z.Geschuetzt).ToList();
            _loeschZugeordnet = ziele.Where(z => !z.Geschuetzt && namen.Contains(z.Bezeichner)).ToList();
            _loeschziele = ziele.Where(z => !z.Geschuetzt && !namen.Contains(z.Bezeichner)).ToList();
            if (_loeschziele.Count == 0)
            {
                Melden(_loeschGesperrt.Count > 0 ? Resource.ADM_SCHLOSS_ERST_AUFHEBEN
                       : string.Format(Resource.Culture, Resource.BPF_MSG_UEBERSPRUNGEN_ZUGEORDNET,
                                       string.Join(", ", _loeschZugeordnet.Select(z => "„" + z.Bezeichner + "“"))),
                       WarnStufe.Warnung);
                return;
            }
        }
        _loeschfrage = true;
    }

    // =================================================================================
    // Uebernehmen und Entfernen
    // =================================================================================

    private void BeiHinzu()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0 || Aufnehmen is null) return;

        // Die Sammeluebernahme (4.5): je gewaehltem Katalogsatz eine Zeile; die Wahl folgt den neuen.
        var neue = new List<BedarfsProfilZeile>();
        bool abgelehnt = false;
        foreach (Katalogfilterzeile k in ziele)
        {
            // KT-5: Wirft das Aufnehmen, nennt die Meldung den Grund; die Projektliste behaelt die schon aufgenommenen.
            string name = k.Bezeichner;
            string grund = "";
            BedarfsProfilZeile? neu = Katalogladung.Schreiben(() => Aufnehmen(name), name,
                                                              g => { grund = g; return (BedarfsProfilZeile?)null; });
            if (grund.Length > 0) { Melden(grund, WarnStufe.Warnung); abgelehnt = true; break; }
            if (neu is null) continue;
            Zeilen.Add(neu);
            neue.Add(neu);
        }
        if (neue.Count == 0) return;

        KatalogKaestchenLeeren();
        if (neue.Count > 1) _projektWahl.Setzen(neue.Select(Projektschluessel).ToList());
        else _projektWahl.Leeren();
        ProjektzeileWaehlen(neue[^1]);
        VerwendungStempeln();
        Geaendert?.Invoke();
        if (!abgelehnt) _meldung = "";
    }

    private void BeiEntfernen()
    {
        List<BedarfsProfilZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;

        foreach (BedarfsProfilZeile z in ziele) { Zeilen.Remove(z); _schluessel.Remove(z); }
        _projektWahl.Leeren();
        VerwendungStempeln();
        _gewaehlt = Zeilen.Count > 0 ? Zeilen[0] : null;

        if (_gewaehlt is not null) ProjektzeileWaehlen(_gewaehlt);
        else if (_katalog.Count > 0) KatalogzeileWaehlen(_katalog[0].Bezeichner);

        Geaendert?.Invoke();
        _meldung = "";
    }

    /// <summary>
    /// „Übernehmen" — Zeile markiert UND Wert ≥ 0 sind Pflicht
    /// (<c>btn_neuerWert_Click</c>). Der 500‑ms-Bildblitz des Vorläufers ist eine Meldung
    /// geworden (A-10).
    /// </summary>
    private void BeiUebernehmen()
    {
        if (_gewaehlt is null || _neuerWert is null)
        {
            Melden(MeldungKeineZeile, WarnStufe.Warnung);
            return;
        }
        if (_neuerWert.Value < 0)
        {
            Melden(string.Format(MeldungWertUngueltig, _einheit.Text), WarnStufe.Warnung);
            return;
        }

        // Der SPEICHERWEG liegt in MWh - bei der Vorgabe MWh ist NachMWh die Identitaet
        // und der Wert wandert bitgleich in die Projektzeile wie im Bestand.
        _gewaehlt.Summe = _einheit.NachMWh(_neuerWert.Value);
        _jahresverbrauchMWh = _gewaehlt.Summe;
        Geaendert?.Invoke();
        Melden(MeldungUebernommen, WarnStufe.Hinweis);
    }

    // =================================================================================
    // Simulation
    // =================================================================================

    /// <summary>
    /// Im ASSISTENTEN gilt der eingegebene Jahresverbrauch mit dem Lauf als übernommen —
    /// <c>SummeFuerSimulationSichern</c> der Prozess- und der Strommaske, und der
    /// eingebettete Zweig der Brauchwassermaske (<c>btn_Simulation_Click</c>:290): Er geht
    /// in die Zeile, mit der die Vorschau rechnet, und — bei gespeichertem Projekt — in die
    /// gespeicherte Projektzeile. Umgerechnet wird aus der gewählten Einheit nach MWh, der
    /// Einheit der Projektzeile.
    ///
    /// <para><b>Die Brauchwassermaske prüft NICHT, ob das Projekt gespeichert ist.</b>
    /// Wörtlich übernommen.</para>
    /// </summary>
    private void SummeVorLaufSichern()
    {
        if (!Wizard || _neuerWert is null || _neuerWert.Value < 0 || _infoName.Length == 0) return;

        double mwh = _einheit.NachMWh(_neuerWert.Value);
        bool zeileGesetzt = false;
        foreach (BedarfsProfilZeile z in Zeilen)
        {
            if (z.Name != _infoName) continue;
            z.Summe = mwh;
            zeileGesetzt = true;
        }
        if (zeileGesetzt)
        {
            if (_gewaehlt is not null && _gewaehlt.Name == _infoName) _jahresverbrauchMWh = mwh;
            Geaendert?.Invoke();
        }

        if (Art == BedarfsArt.Brauchwasser || ProjektGespeichert is null || ProjektGespeichert())
            SummeSichern?.Invoke(_infoName, mwh);
    }

    private void BeiSimulation()
    {
        // Der Vorlaeufer zeigte seine Hinweise als MessageBox - sie waren nach dem
        // Wegklicken weg. Ein Warnbanner bleibt stehen; also raeumt der naechste Lauf auf.
        _meldung = "";

        // Auf dem Zapfprofilweg rechnet die Huelle den Arbeitsstand des Zapfprofils (5.2) -
        // ein gewaehltes Bestandsprofil braucht es dann nicht.
        if (_infoName.Length == 0 && !Zapfprofilweg)
        {
            Melden(MeldungKeineAuswahl, WarnStufe.Warnung);
            return;
        }
        if (Simulieren is null) return;

        SummeVorLaufSichern();

        // Prozess und Strom rechnen ALLE Zuordnungen, Brauchwasser NUR die gewaehlte
        // (btn_Simulation_Click:296-298 legt genau einen Namen in die Liste).
        var namen = new List<string>();
        if (Art == BedarfsArt.Brauchwasser) { if (_infoName.Length > 0) namen.Add(_infoName); }
        else foreach (BedarfsProfilZeile z in Zeilen) namen.Add(z.Name);

        IReadOnlyDictionary<string, object>? gaben = Simulieren(namen);

        // Die Meldung des Laufs (Zapfprofilweg): ein Abbruch mit Grund oder Zonen, die 0
        // tragen - benannt statt still, nach dem Bestandsmuster als Banner.
        string meldung = SimulationMeldung?.Invoke() ?? "";
        if (meldung.Length > 0) Melden(meldung, WarnStufe.Warnung);
        if (gaben is null) return;

        _ergebnisGaben = gaben;
    }

    // =================================================================================
    // Katalog
    // =================================================================================

    /// <summary>
    /// „DB ändern…" (Katalogfuss, 4.9): der eine gewählte Katalogsatz im Katalogeditor; ein
    /// gesperrter nennt den Grund statt zu öffnen (Schreibschutz).
    /// </summary>
    private void BeiDbAendern()
    {
        if (TypStammGaben is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count != 1) { Melden(MeldungKeineAuswahl, WarnStufe.Warnung); return; }
        if (ziele[0].Geschuetzt) { Melden(Resource.ADM_SCHLOSS_ERST_AUFHEBEN, WarnStufe.Hinweis); return; }
        if (_katalogzeile?.Bezeichner != ziele[0].Bezeichner) KatalogzeileWaehlen(ziele[0].Bezeichner);

        _meldung = "";
        _typStammNeu = false;
        _typStammGaben = TypStammGaben(_infoName, _infoBeschreibung, _infoTyp, false);
    }

    private void NamensfrageFertig(string? name)
    {
        _namensfrage = false;
        if (string.IsNullOrEmpty(name) || TypStammGaben is null) return;

        _typStammNeu = true;
        _typStammGaben = TypStammGaben(name, "", "", true);
    }

    /// <summary>
    /// Nach dem Stammkopf laden alle drei Vorläufer Projektliste UND Katalog neu
    /// (<c>SetControls</c> + <c>SetDBList</c>).
    /// </summary>
    private void TypStammFertig()
    {
        _typStammGaben = null;
        KatalogLaden();
        if (_infoName.Length > 0) InfoSetzen(_infoName);
    }

    private void LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || KatalogLoeschen is null || ziele.Count == 0) return;

        int geloescht = 0;
        foreach (Katalogfilterzeile z in ziele)
        {
            string loeschName = z.Bezeichner;
            if (!Katalogladung.Loeschen(() => KatalogLoeschen(loeschName), loeschName, out string loeschGrund))
            {
                // KT-4: Warf der Löschweg, nennt die Meldung den Grund.
                if (loeschGrund.Length > 0) Melden(loeschGrund, WarnStufe.Warnung);
                continue;
            }
            geloescht++;
            if (z.Bezeichner == _katalogGewaehlt) { _katalogzeile = null; _katalogGewaehlt = ""; }
        }
        if (geloescht == 0) return;

        KatalogKaestchenLeeren();
        KatalogLaden();
        if (MeldungGeloescht.Length > 0) Melden(MeldungGeloescht, WarnStufe.Hinweis);
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    // =================================================================================
    // Zapfprofil (5.2)
    // =================================================================================

    /// <summary>Rechnet die Leiste „Simulation" den Zapfprofilweg?</summary>
    private bool Zapfprofilweg => MitRechenweg && _rechenweg == ZapfprofilWeg.Generator;

    /// <summary>Die Optionsgruppe steht nur bei Brauchwasser und nur mit Rückruf der Hülle.</summary>
    private bool MitRechenweg => Art == BedarfsArt.Brauchwasser && RechenwegGesetzt is not null;

    private IReadOnlyList<(int Id, string Text)> Rechenwege => new[]
    {
        ((int)ZapfprofilWeg.Bestand, ZapfprofilEinstiegTexte.OptionBestand),
        ((int)ZapfprofilWeg.Generator, ZapfprofilEinstiegTexte.OptionZapfprofil)
    };

    /// <summary>Ohne Zone gibt es nichts zu rechnen: „Zapfprofil" ist dann weich gesperrt, mit Grund.</summary>
    private IReadOnlyDictionary<int, string>? RechenwegGesperrt
        => _zapfprofilZonen == 0 && _rechenweg != ZapfprofilWeg.Generator
            ? new Dictionary<int, string> { [(int)ZapfprofilWeg.Generator] = ZapfprofilEinstiegTexte.HinweisOhneZonen }
            : null;

    /// <summary>Gibt es den Knopf — aktiv mit Delegat, weich gesperrt mit Grund, sonst nicht (A11)?</summary>
    private bool MitZapfprofilKnopf
        => Art == BedarfsArt.Brauchwasser && (ZapfprofilGaben is not null || ZapfprofilSperrgrund.Length > 0);

    /// <summary>Der Aktionsschlitz der Fußleiste (ZU6); ohne Knopf bleibt er leer.</summary>
    private RenderFragment? ZapfprofilAktionen => MitZapfprofilKnopf ? ZapfprofilKnopf : null;

    private RenderFragment ZapfprofilKnopf => @<text>
        @if (ZapfprofilGaben is not null)
        {
            <button type="button" class="epos-knopf epos-zapfprofil-knopf"
                    @onclick="ZapfprofilOeffnen">@ZapfprofilEinstiegTexte.Knopf</button>
        }
        else
        {
            <button type="button" class="epos-knopf epos-zapfprofil-knopf" aria-disabled="true"
                    title="@ZapfprofilSperrgrund"
                    @onclick="ZapfprofilVerweigert">@ZapfprofilEinstiegTexte.Knopf</button>
        }
    </text>;

    private void ZapfprofilOeffnen()
    {
        if (ZapfprofilGaben is null) return;
        _meldung = "";
        _zapfprofilGaben = ZapfprofilGaben();
    }

    /// <summary>Der Versuch am weich gesperrten Knopf meldet den Grund (ZU10, A11).</summary>
    private void ZapfprofilVerweigert() => Melden(ZapfprofilSperrgrund, WarnStufe.Hinweis);

    /// <summary>
    /// Das Ergebnis des Zapfprofils: bei OK in den Arbeitsstand der Hülle, und die
    /// Optionsgruppe steht auf Zapfprofil (ZU4). Abbrechen (<c>null</c>) lässt alles stehen.
    /// </summary>
    private void ZapfprofilGeschlossen(ZapfprofilErgebnisDaten? ergebnis)
    {
        _zapfprofilGaben = null;
        _fokusZurueckNoetig = true;
        if (ergebnis is null) return;

        ZapfprofilUebernommen?.Invoke(ergebnis);
        _rechenweg = ZapfprofilWeg.Generator;
        _zapfprofilZonen = ergebnis.Eingabe.Zonen.Count;
    }

    /// <summary>
    /// N35: Rückknopf „‹ {Wirtstitel}" und Esc des Blattes — wie das Kreuz der abgelösten
    /// Ueberlagerung führen beide zurück, ohne den eingebetteten Dialog zu fragen (Hausregel
    /// „der Wirt schließt dafür selbst"): kein Übernehmen, kein Rechenweg-Wechsel.
    /// </summary>
    private void ZapfprofilZurueck() => ZapfprofilGeschlossen(null);

    /// <summary>Die Optionsgruppe: stellt nur den Weg um, die Zonen bleiben (ZU4).</summary>
    private void RechenwegWaehlen(int? id)
    {
        if (id is not int n || !Enum.IsDefined(typeof(ZapfprofilWeg), n)) return;
        var weg = (ZapfprofilWeg)n;
        if (weg == _rechenweg) return;

        _rechenweg = weg;
        RechenwegGesetzt?.Invoke(weg);
    }

    /// <summary>
    /// OK schreibt über <see cref="Speichern"/>, bevor der Dialog schließt; lehnt der
    /// Schreibweg ab, steht sein Grund als Banner da und der Dialog bleibt offen.
    /// </summary>
    private Task BeiErgebnis(bool ok)
    {
        // K5b (Konzept Kaeltebedarf 3.4): eine Kaeltezeile „Split ohne EER" lehnt OK benannt ab - Banner mit dem
        // Bezeichner, die Zeile wird gewaehlt, der Dialog bleibt offen (Regel des Kerns, Kaeltedeckungsregel).
        if (ok && UnzulaessigeDeckung() is BedarfsProfilZeile falsch)
        {
            if (_gewaehlt != falsch) ProjektzeileWaehlen(falsch);
            Melden(MeldungDeckungOhneEer + " (" + falsch.Name + ")", WarnStufe.Fehler);
            return Task.CompletedTask;
        }
        if (ok && Speichern is not null)
        {
            // KT-4: Wirft der Schreibweg, bleibt der Dialog offen und die Meldung nennt den Grund.
            string grund = Katalogladung.Schreiben(() => Speichern() ?? "", TitelText, g => g);
            if (grund.Length > 0)
            {
                Melden(grund, WarnStufe.Fehler);
                return Task.CompletedTask;
            }
        }
        return Geschlossen.InvokeAsync(ok);
    }

    /// <summary>Abbrechen — von Esc (nach den Wächtern) und vom Schliesskreuz gleichermaßen gerufen.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(false);

    // =================================================================================
    // K5b: die Feldgruppe „Deckung" einer Kaeltezeile (Konzept Kaeltebedarf 3.4)
    // =================================================================================

    /// <summary>Die Arbeitskopie der Deckung, solange die Bearbeiten-Überlagerung einer Kältezeile offen steht.</summary>
    private DeckungsartDaten? _deckungArbeit;

    /// <summary>Steht die Feldgruppe „Deckung“ an der gewählten Zeile? Nur bei einer Projektzeile der Art Kälte.</summary>
    public bool DeckungSichtbar => Art == BedarfsArt.Kaelte && _gewaehlt?.Deckung is not null;

    /// <summary>Die Arbeitskopie der offenen Bearbeiten-Überlagerung — Prüfhilfe für die Tests.</summary>
    public DeckungsartDaten? DeckungArbeitsstand => _deckungArbeit;

    private static bool DeckungGleich(DeckungsartDaten a, DeckungsartDaten b)
        => a.Deckungsart == b.Deckungsart && a.EerWeg == b.EerWeg && a.Eer1 == b.Eer1 && a.Taussen1 == b.Taussen1 &&
           a.Eer2 == b.Eer2 && a.Taussen2 == b.Taussen2 && a.KuehlIdCarrier == b.KuehlIdCarrier &&
           a.KuehlEigenerZaehler == b.KuehlEigenerZaehler;

    /// <summary>
    /// Die erste Kältezeile, deren Deckung die Regel des Kerns verwirft (Split ohne rechnenden EER); <c>null</c> = alle
    /// zulässig. Nur bei der Art Kälte.
    /// </summary>
    public BedarfsProfilZeile? UnzulaessigeDeckung()
        => Art != BedarfsArt.Kaelte ? null : Zeilen.FirstOrDefault(z => z.Deckung?.Pruefgrund() is not null);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        if (e.Key != "Escape" || _ergebnisGaben is not null || _typStammGaben is not null ||
            _typProfilOffen || _namensfrage || _loeschfrage || _zapfprofilGaben is not null || _satzGross)
            return Task.CompletedTask;
        return Abbrechen();
    }

    // =================================================================================
    // Schloss setzen / aufheben (AD-Q15) - derselbe Baustein wie in den Verwaltungen
    // =================================================================================

    /// <summary>
    /// „Schloss setzen…" / „Schloss aufheben…" an der Katalogliste
    /// (<c>Schlosswege.Aus(…SchlossSetzen)</c>). Ohne ihn steht der Knopf nicht da.
    /// Die Verwendung im Projekt sperrt nichts: Das Projekt führt eine eigene Kopie.
    /// </summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    private Katalogschloss? _katalogschloss;

    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe für Tests.)</summary>
    public bool Schlossfrage => _katalogschloss?.FrageOffen == true;

    /// <summary>Nach dem Schalten: Liste neu lesen, Status melden.</summary>
    private void BeiSchlossGeschaltet(string status)
    {
        KatalogLaden();
        Melden(status ?? "", WarnStufe.Hinweis);
    }

    /// <summary>Warum nicht geschaltet wurde.</summary>
    private void BeiSchlossAbgelehnt(string grund) => Melden(grund ?? "", WarnStufe.Warnung);
}
