<?xml version="1.0" encoding="UTF-8"?>
<ids xmlns="http://standards.buildingsmart.org/IDS" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://standards.buildingsmart.org/IDS http://standards.buildingsmart.org/IDS/1.0/ids.xsd">
  <info>
    <title>EPOS-Plan: Exportzusage des semantischen IFC-Exports (Stufe S1)</title>
    <copyright>INEKON</copyright>
    <version>1.0</version>
    <description>Was eine IFC-Datei aus EPOS-Plan (IFC4, Stufe S1: semantisch, ohne Geometrie, ohne MVD) je Entität sicher trägt: Attribute, Eigenschaften und Mengen samt Datentyp. „required“ steht an jeder Instanz; „optional“ steht, wenn die Quelle den Wert trägt, und hat dann den genannten Datentyp. Geometrie ist nicht Teil der Zusage. Energiewerte stehen in kWh mit ausdrücklicher Einheit KILOWATTHOUR, Leistungen in W, Temperaturen in K, Winkel in Grad.</description>
    <purpose>Prüfgrundlage für Empfänger der Datei: Mit einem IDS-fähigen Prüfwerkzeug lässt sich jede exportierte Datei gegen diese Zusage halten.</purpose>
  </info>
  <specifications>
    <specification name="Projekt" ifcVersion="IFC4" description="Das Projekt mit Namen, Beschreibung (Stufe des Exports) und der vollständigen Einheitenzuweisung (Meter, Quadratmeter, Kubikmeter, Joule, Watt, Kelvin, Radiant; dazu kWh und Grad als umgerechnete Einheiten).">
      <applicability minOccurs="1" maxOccurs="1">
        <entity>
          <name>
            <simpleValue>IFCPROJECT</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name>
            <simpleValue>GlobalId</simpleValue>
          </name>
        </attribute>
        <attribute cardinality="required">
          <name>
            <simpleValue>Name</simpleValue>
          </name>
        </attribute>
        <attribute cardinality="required">
          <name>
            <simpleValue>Description</simpleValue>
          </name>
        </attribute>
      </requirements>
    </specification>
    <specification name="Grundstück" ifcVersion="IFC4" description="Das Grundstück; mit gepflegtem Klimaort trägt es RefLatitude und RefLongitude, mit Postleitzahl die Anschrift.">
      <applicability minOccurs="1" maxOccurs="1">
        <entity>
          <name>
            <simpleValue>IFCSITE</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
          <name>
            <simpleValue>GlobalId</simpleValue>
          </name>
        </attribute>
        <attribute cardinality="required">
          <name>
            <simpleValue>CompositionType</simpleValue>
          </name>
          <value>
            <simpleValue>ELEMENT</simpleValue>
          </value>
        </attribute>
      </requirements>
    </specification>
    <specification name="Gebäude" ifcVersion="IFC4" description="Das exportierte Gebäude mit seiner EPOS-Kennung und der Angabe des Rechenlaufs. EPOS_Ergebnis steht nur nach einem gespeicherten Rechenlauf; der Kältebedarf ist sensibel, ohne Entfeuchtung.">
      <applicability minOccurs="1" maxOccurs="1">
        <entity>
          <name>
            <simpleValue>IFCBUILDING</simpleValue>
          </name>
        </entity>
      </applicability>
      <requirements>
        <attribute cardinality="required">
