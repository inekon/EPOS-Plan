    private Editor _ebene2 = Editor.Keine;

    private IReadOnlyDictionary<string, object>? _gaben1;
    private IReadOnlyDictionary<string, object>? _gaben2;

    /// <summary>Die Zeile, um deren Anlage es gerade geht; <c>null</c> = keine.</summary>
    private ErzeugerZeile? _zeile;

    private IReadOnlyList<Quellentyp> _quellentypen = Array.Empty<Quellentyp>();
    private string _quelleTypJetzt = "";

    /// <summary>Der Steuerwert, den die Quellenwahl gerade festlegt.</summary>
    private string _quelleTypNeu = "";

    private string _wertFrage = "";
    private double? _wertVorgabe;
    private string _csvFrage = "";

    /// <summary>Der offene Editor der ersten Ebene (Pruefhilfe).</summary>
    public string OffenerEditor => _ebene1.ToString();

    /// <summary>Der offene Editor der zweiten Ebene (Pruefhilfe).</summary>
    public string OffenerUntereditor => _ebene2.ToString();

    // ---- Die Konfiguration einer Komponente (Anwenderwunsch 16.09.2026) ----

    /// <summary>Die Art, deren Konfiguration offen steht.</summary>
