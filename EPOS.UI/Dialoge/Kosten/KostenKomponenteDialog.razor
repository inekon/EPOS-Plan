    private void Feld(KostenPositionZeile zeile, Action aendern)
    {
        // Eine Eingabe: Der Vermerk „gespeichert …" stimmt nicht mehr.
        if (_vermerkGespeichert) StatusSetzen("");
        aendern();
        Nachziehen?.Invoke(zeile);
        SummenNachziehen();
    }

    /// <summary>
    /// ANWENDERENTSCHEID 19.09.2026: „übernehmen" an der Vorlagen-Hinweiszeile.
    ///
    /// <para>Zwei Schritte, beide auf dem Bestandsweg: Die Bemessung wechselt wie
    /// jede andere Feldänderung (<see cref="Feld"/> zieht Bezugsgröße, Betrag und
    /// Herleitung nach), und danach schreibt derselbe Weg, den „Speichern" ruft.
    /// SATZ UND BETRAG bleiben, wie sie sind — übernommen wird die Bemessung, nicht
    /// die Vorlage. Nach dem Neuladen stimmen Zeile und Vorlage überein, und der
    /// Hinweis ist fort.</para>
    ///
    /// <para>Ohne wählbaren Vorlagenwert geschieht nichts: Die Zeile zeigt dann den
    /// Hinweis, aber keinen Schalter.</para>
    /// </summary>
    private void VorlageUebernehmen(KostenPositionZeile zeile)
    {
        if (zeile.VorlagenBemessungId is not int id) return;
        Feld(zeile, () => zeile.BemessungId = id);
        BeiSpeichern();
    }

    /// <summary>
    /// Die Summen fallen aus denselben Zeilen — der Vorläufer zog sie über
    /// <c>PositionGeaendert</c> nach (<c>SummenAnzeigen</c>). Gerechnet wird in
    /// der Hülle, und zwar aus dem STAND, nicht aus der Datenbank: Bis
    /// „Speichern" lebt die Änderung nur im Objekt (Ä12/Ä19).
    /// </summary>
    private void SummenNachziehen()
    {
        if (Summen is not null) _stand.Summen = Summen();
    }

