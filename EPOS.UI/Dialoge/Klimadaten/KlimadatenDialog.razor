    /// <summary>
    /// Bietet dieser Dialog den Farbwähler an? Nur, wenn die Hülle ihn auch
    /// speichern kann — kein Delegat, kein Wähler.
    /// </summary>
    private bool FarbwahlMoeglich => FarbeSetzen is not null;

    /// <summary>
    /// Der Anwender hat am Bild eine Farbe gewählt. <b>Die Modelle bleiben, wie
    /// sie sind</b> — sie tragen Rollen, keine Zahlen; neu gezeichnet wird mit
    /// <c>Farbpalette.Aktuell</c>, und die hat die Hülle inzwischen gesetzt.
    /// </summary>
    private async Task FarbeUebernehmen((Farbrolle Rolle, Farbe Farbe) wahl)
    {
        if (FarbeSetzen is null) return;
        await FarbeSetzen(wahl.Rolle, wahl.Farbe);
        StateHasChanged();
    }

    /// <summary>„Hausfarbe" — dieselbe Runde, nur ohne Farbe.</summary>
    private async Task FarbeVerwerfen(Farbrolle rolle)
    {
        if (FarbeZuruecksetzen is null) return;
        await FarbeZuruecksetzen(rolle);
        StateHasChanged();
    }

    private void BeiOrtsname(ChangeEventArgs e)
    {
        _ortsname = e.Value?.ToString() ?? "";
        _meldung = "";
        _regionszeile = "";
    }

    private void BeiFehler((string Feld, bool Fehlerhaft) f)
    {
        if (f.Fehlerhaft) _fehlerFelder.Add(f.Feld); else _fehlerFelder.Remove(f.Feld);
    }

    // =====================================================================
    // Klimaquelle (Auftrag KL1-B)
    // =====================================================================

    private void BeiQuelle(int? id)
    {
        _quelle = id switch
        {
            (int)KlimaQuelle.TryDatei => KlimaQuelle.TryDatei,
            (int)KlimaQuelle.TryRegional => KlimaQuelle.TryRegional,
            _ => KlimaQuelle.PvgisTmy
        };
        _meldung = "";
        _regionszeile = "";
    }

    private void BeiTryPfad(string pfad)
    {
        _tryPfad = pfad ?? "";
        _meldung = "";
        _tryStandort = "";
        StandortAusDatei();
    }

    /// <summary>
    /// Belegt den STANDORT aus dem Kopf der gewählten TRY-Datei vor (Auftrag KL-2).
    ///
    /// <para>Der Kern liest den Kopf — nur bis zur Trennzeile, ohne Netz und ohne
    /// Datenbank — und rechnet Rechts-/Hochwert über
    /// <c>LambertKoordinaten</c> in Länge und Breite um. Der Dialog SETZT beides, füllt
    /// eine leere Bezeichnung aus dem Dateinamen und schreibt darunter, woher die
    /// Zahlen kommen. <b>Alles bleibt änderbar</b>: Der Anwender kann jedes Feld
    /// überschreiben, und der Import nimmt dann seine Eingabe.</para>
    ///
    /// <para><b>Nicht lesbar ist kein Fehler:</b> Fehlt die Datei oder nennt ihr Kopf
    /// keinen plausiblen Punkt, bleibt es bei einem Hinweis — die Felder bleiben
    /// stehen, und ob eingelesen werden darf, entscheidet wie bisher
    /// <see cref="ImportErlaubt"/>.</para>
    /// </summary>
    private void StandortAusDatei()
    {
        string pfad = _tryPfad.Trim();
        if (pfad.Length == 0) return;

        if (!DwdTryLeser.KopfLesen(pfad, out TryKopf kopf) || !kopf.StandortBekannt)
        {
            Melden(string.Format(CultureInfo.CurrentCulture, StandortUnlesbarText,
                                 Dateiname(pfad)), WarnStufe.Hinweis);
            return;
        }

        _longitude = kopf.Laenge;
        _latitude = kopf.Breite;
        _fehlerFelder.Remove(FeldLongitudeText);   // die gesetzten Werte sind gueltig
        _fehlerFelder.Remove(FeldLatitudeText);

        if (_bezeichnung.Trim().Length == 0) _bezeichnung = Dateiname(pfad);

        _tryStandort = string.Format(CultureInfo.CurrentCulture, StandortHinweisText,
                                     kopf.Rechtswert, kopf.Hochwert);
    }

    /// <summary>Der Dateiname ohne Endung — die Vorgabe der Bezeichnung.</summary>
    private static string Dateiname(string pfad)
    {
        try { return System.IO.Path.GetFileNameWithoutExtension(pfad) ?? ""; }
        catch (ArgumentException) { return ""; }
    }

    private void BeiTryPaket(string pfad)
    {
        _tryPaketPfad = pfad ?? "";
        _meldung = "";
        _regionszeile = "";
    }

    private void BeiTryJahr(int? jahr)
    {
        _tryJahr = jahr ?? KlimaImportAuftrag.TRY_JAHR_VORGABE;
        _meldung = "";
        _regionszeile = "";
    }

    // =====================================================================
    // Regionsvorschau (Auftrag KL-3)
    // =====================================================================

    /// <summary>
    /// Ermittelt die TRY-Region zum eingetragenen Standort und schreibt das Ergebnis
    /// als Herleitungszeile unter die Auswahl.
    ///
    /// <para><b>Ein Fehlschlag ist kein Absturz und keine Sperre</b>: Er steht als
    /// Zeile da (kein Bereichsabruf, außerhalb 300 km, Ort unbekannt), und einlesen
    /// darf der Anwender weiterhin — die Vorschau ist eine Auskunft, keine
    /// Bedingung.</para>
    /// </summary>
    private async Task BeiRegion()
    {
        if (!RegionErlaubt) return;

        var auftrag = _ortsname.Trim().Length > 0
            ? new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusOrtsname,
                  Ortsname = _ortsname.Trim()
              }
            : new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusKoordinaten,
                  Bezeichnung = _bezeichnung.Trim(),
                  Longitude = _longitude ?? 0,
                  Latitude = _latitude ?? 0
              };

        auftrag.Quelle = KlimaQuelle.TryRegional;
        auftrag.TryPaketPfad = _tryPaketPfad.Trim();
        auftrag.TryJahr = _tryJahr ?? KlimaImportAuftrag.TRY_JAHR_VORGABE;
        auftrag.Szenario = _szenario;

        _regionLaeuft = true;
        _regionszeile = RegionLaeuftText;
        _meldung = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            KlimaVorschauErgebnis erg = await RegionErmitteln!(auftrag);
            _regionszeile = erg.Meldung ?? "";
            if (!erg.Erfolgreich && _regionszeile.Length == 0)
                _regionszeile = EingabenPruefenText;
        }
        finally
        {
            _regionLaeuft = false;
        }
    }

    private void BeiSzenario(int? id)
    {
        _szenario = id switch
        {
            (int)TrySzenario.Sommerwarm => TrySzenario.Sommerwarm,
            (int)TrySzenario.Winterkalt => TrySzenario.Winterkalt,
            _ => TrySzenario.MittleresJahr
        };
        _meldung = "";
    }

    // =====================================================================
    // Import (btn_Import_Click)
    // =====================================================================

    private async Task BeiImport()
    {
        if (!ImportErlaubt) return;

        var auftrag = _ortsname.Trim().Length > 0
            ? new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusOrtsname,
                  Ortsname = _ortsname.Trim()
              }
            : new KlimaImportAuftrag
              {
                  Art = KlimaImportArt.AusKoordinaten,
                  Bezeichnung = _bezeichnung.Trim(),
                  Longitude = _longitude ?? 0,
                  Latitude = _latitude ?? 0
              };

        // Die Quelle und ihre Angaben (Auftrag KL1-B). Bei PVGIS bleiben die
        // Vorgaben stehen - der Auftrag sieht dann aus wie vor KL1-B.
        auftrag.Quelle = _quelle;
        if (_quelle == KlimaQuelle.TryDatei)
        {
            auftrag.TryPfad = _tryPfad.Trim();
        }
        else if (_quelle == KlimaQuelle.TryRegional)
        {
            auftrag.TryPaketPfad = _tryPaketPfad.Trim();
            auftrag.TryJahr = _tryJahr ?? KlimaImportAuftrag.TRY_JAHR_VORGABE;
            auftrag.Szenario = _szenario;
        }

        _laeuft = true;
        _anteil = null;
        _fortschrittText = "";
        _meldung = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            var melder = new Progress<ImportFortschritt>(f =>
            {
                _anteil = f.Anteil;
                _fortschrittText = Fortschrittstext(f.Schluessel);
                InvokeAsync(StateHasChanged);
            });

            KlimaImportErgebnis erg = await Importieren!(auftrag, melder);

            if (erg.Meldung.Length > 0)
                Melden(erg.Meldung, erg.Erfolgreich ? WarnStufe.Erfolg
                                  : erg.Ausgang == KlimaImportAusgang.Abgebrochen ? WarnStufe.Hinweis
                                  : WarnStufe.Fehler);

            if (erg.Erfolgreich)
            {
                await RegionenLaden();
                _gewaehlt = erg.Bezeichner;
                await AnsichtLaden();

                // ANWENDERWUNSCH 19.09.2026, Punkt 2: "'Daten Einlesen' verschwindet
                // nach dem Einlesen." Der Knopf war NIE weg - er war GESPERRT. Hier
                // standen bis dahin zwei Zuweisungen, die _ortsname und _bezeichnung
                // leerten; ImportErlaubt verlangt aber einen STANDORT (Ortsname ODER
                // Longitude+Latitude+Bezeichnung), und mit den geleerten Feldern hatte
                // er keinen mehr. Aus Sicht des Anwenders verschwand der Knopf.
                //
                // Die Felder BLEIBEN deshalb stehen. Vor einem Doppelimport schuetzt
                // nicht das Leeren, sondern der Dublettenschutz des Ablaufs
                // (KlimaImportAblauf: GetStammId(...) > 0 -> KlimaImportAusgang.Dublette
                // mit KLIMA_MSG_SCHON_VORHANDEN) - und der ist der richtige Ort dafuer:
                // Er kennt den Katalog, das Formular kennt nur seine Felder.
                //
                // Die Regionszeile der Vorschau geht weg: Sie gehoerte zum Lauf, der
                // gerade zu Ende ist, und ihre Aussage steht jetzt im Herkunftsvermerk.
                _regionszeile = "";
            }
        }
        finally
        {
            // Der Vorlaeufer hatte KEIN finally: Brach der Ablauf zwischen
            // "Balken sichtbar" und einem der acht return ab, blieb er stehen
            // (Befund W14c-B32).
            _laeuft = false;
            _anteil = null;
            _fortschrittText = "";
        }
    }

    private void BeiAbbrechen()
    {
        Abbrechen?.Invoke();
    }

    /// <summary>
    /// Der Begleittext eines Schritts. Der Ablauf meldet SCHLÜSSEL, keine Texte — die
    /// Übersetzung gehört zur Anzeige.
    /// </summary>
    private string Fortschrittstext(string schluessel)
    {
        if (string.IsNullOrEmpty(schluessel)) return "";
        try { return Resource.ResourceManager.GetString(schluessel) ?? schluessel; }
        catch { return schluessel; }
    }

    // =====================================================================
    // Loeschen (btn_Delete_Click) - A-7 mit Rueckfrage, A-8 mit Kaskade
    // =====================================================================

    private void BeiLoeschen()
    {
        if (_laeuft) return;
        if (_gewaehlt.Length == 0) { Melden(AuswaehlenText, WarnStufe.Hinweis); return; }

        Katalogfilterzeile? zeile = _regionen.FirstOrDefault(z => z.Bezeichner == _gewaehlt);
        if (zeile is null) return;

        if (zeile.Geschuetzt) { Melden(ReadOnlyText, WarnStufe.Warnung); return; }

        _loeschfrage = string.Format(VorlageLoeschfrage, _gewaehlt);
        _loeschfrageOffen = true;
    }

    private async Task LoeschfrageBeantwortet(bool? antwort)
    {
        _loeschfrageOffen = false;
        if (antwort != true || Loeschen is null) return;

        bool weg = await Loeschen(_gewaehlt);
        if (!weg) { Melden(ReadOnlyText, WarnStufe.Warnung); return; }

        _gewaehlt = "";
        await RegionenLaden();

        // Der Vorlaeufer waehlte danach die erste Region und zeichnete neu.
        if (_regionen.Count > 0) { _gewaehlt = _regionen[0].Bezeichner; await AnsichtLaden(); }
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    private Task BeiSchliessen() => Geschlossen.InvokeAsync(true);

    /// <summary>Der Abbrechen-Weg: schliesst ohne Uebernahme. Esc und das ✕ im Kopf rufen ihn.</summary>
    private Task Schliessen() => Geschlossen.InvokeAsync(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_loeschfrageOffen || _laeuft) return Task.CompletedTask;
        return Schliessen();
    }
}
