    /// <summary>Ein gesperrter Versuch (Übergabe): der Grund als leise Zeile.</summary>
    private void UebergabeGesperrt() => _hinweis = Texte.GrundUebergeben;

    private void KonstruktorOeffnen()
    {
        _hinweis = "";
        _konstruktorOffen = true;
    }

    /// <summary>Der Konstruktor ist zu: mit Tag wird er der Bedarfstag der Auslegung (Quelle Konstruktor).</summary>
    private void KonstruktorFertig(ZapfprofilBedarfstagDaten? tag)
    {
        _konstruktorOffen = false;
        if (tag is null) return;
        _eingabe.Entwurf = tag.Kopie();
        _eingabe.Quelle = ZapfprofilBedarfstagquelle.Konstruktor;
        _eingabe.IdBedarfstag = null;
        Geaendert();
    }

    /// <summary>Eine Eingabe hat die Auslegung geändert: das Ergebnis ist überholt und wird entprellt neu gerechnet.</summary>
    private void Geaendert()
    {
        _hinweis = "";
        _aktuell = false;
        EntprellungAbbrechen();
        if (Rechnen is null) return;
        if (EntprellungMs <= 0)
        {
            Neurechnen();
            return;
        }
        var quelle = new CancellationTokenSource();
        _entprellung = quelle;
        _ = EntprellungAbwarten(quelle);
    }

    private async Task EntprellungAbwarten(CancellationTokenSource quelle)
    {
        try
        {
            await Task.Delay(EntprellungMs, quelle.Token);
            if (quelle.IsCancellationRequested) return;
            await InvokeAsync(() =>
            {
                if (quelle.IsCancellationRequested) return;
                Neurechnen();
                StateHasChanged();
            });
        }
        catch (OperationCanceledException) { /* eine neue Eingabe war schneller */ }
        catch (ObjectDisposedException) { /* die Überlagerung ist gegangen */ }
    }

    private void EntprellungAbbrechen()
    {
        CancellationTokenSource? offen = _entprellung;
        _entprellung = null;
        if (offen is null) return;
        try { offen.Cancel(); } catch (ObjectDisposedException) { }
        offen.Dispose();
    }

    /// <summary>Rechnet über den Delegaten neu; führt das Ergebnis den Fall „ohne Tag" neu herbei, öffnet der Konstruktor.</summary>
    private void Neurechnen(bool konstruktorFolgen = true)
    {
        if (Rechnen is null) return;
        ZapfprofilAuslegungDaten? vorher = _ergebnis;
        _ergebnis = Rechnen(_eingabe.Kopie());
        _aktuell = _ergebnis is not null;
        if (konstruktorFolgen && KonstruktorFaellig(vorher, _ergebnis)) _konstruktorOffen = true;
    }

    /// <summary>
    /// Regel 4.5: Ohne konstruierten Tag öffnet die Auslegung den Konstruktor, statt still das
    /// Stundenprofil zu nehmen — wenn der Fall NEU eintritt (beim Öffnen oder nach einer
    /// Neuberechnung, die ihn herbeiführt), nicht nach jedem Abbrechen erneut. Ohne
    /// Konstruktor-Delegat bleibt es beim Eintrag der Warnliste.
    /// </summary>
    private bool KonstruktorFaellig(ZapfprofilAuslegungDaten? vorher, ZapfprofilAuslegungDaten? neu)
        => Konstruieren is not null && OhneTag(neu) && !OhneTag(vorher);

    private static bool OhneTag(ZapfprofilAuslegungDaten? d) => d is not null && d.Gruppen.Any(g => g.KonstruktorOeffnen);

    // =================================================================================
    // Ergebnis
    // =================================================================================

    /// <summary>
    /// OK rechnet ein überholtes Ergebnis sofort nach, übernimmt den EINEN Punkt (erste
    /// rechenbare Speichergruppe, sonst die erste rechenbare) in die Eingaben und gibt sie
    /// zurück. Stammt der Bedarfstag aus dem Stundenprofil, fragt vorher die Rückfrage.
    /// </summary>
    private async Task BeiErgebnis(bool ok)
    {
        if (!ok)
        {
            await Abbrechen();
            return;
        }
        EntprellungAbbrechen();
        if (!_aktuell) Neurechnen(konstruktorFolgen: false);
        if (_eingabe.Quelle == ZapfprofilBedarfstagquelle.Stundenprofil && _ergebnis?.Punktgruppe is not null)
        {
            _rueckfrage = true;
            return;
        }
        await Uebernehmen();
    }

    private async Task RueckfrageBeantwortet(bool? ja)
    {
        _rueckfrage = false;
        if (ja == true) await Uebernehmen();
    }

    private Task Uebernehmen()
    {
        ZapfprofilAuslegungEingabeDaten e = _eingabe.Kopie();
        ZapfprofilAuslegungsgruppeDaten? g = _ergebnis?.Punktgruppe;
        e.PunktVolumenL = g?.Empfehlung.Speicher == true ? g.Empfehlung.VolumenL : null;
        e.PunktLeistungKw = g?.Empfehlung.LeistungKw;
        return Geschlossen.InvokeAsync(e);
    }

    /// <summary>Abbrechen — von Esc, vom Schliesskreuz und vom Knopf gleichermaßen gerufen; verwirft.</summary>
    private Task Abbrechen()
    {
        EntprellungAbbrechen();
        return Geschlossen.InvokeAsync(null);
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _konstruktorOffen || _rueckfrage) return Task.CompletedTask;
        return Abbrechen();
    }
}
