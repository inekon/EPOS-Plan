    /// <summary>
    /// DL-2 (Nr. 7, Entscheid DL-Q5): Bezeichnung und Gruppe des Stammkopfs gehen
    /// im Speichern- und im OK-Weg mit — der eigene Knopf „Bezeichnung speichern"
    /// ist entfallen.
    ///
    /// <para>Nur im Katalogkontext, denn nur dort ist der Stammkopf überhaupt da.
    /// Ohne Schreibweg (Hülle ohne <see cref="StammSchreiben"/>) bleibt der Schritt
    /// aus; „nichts zu tun" ist kein Fehler und hält das Speichern nicht auf.</para>
    /// </summary>
    private bool StammMitschreiben()
    {
        if (!Katalogkontext || StammSchreiben is null || _ansicht.Stand is null) return true;

        if (!StammSchreiben(_stammName, _stammGruppe))
        {
            Melden(MeldungStammLeer, WarnStufe.Warnung);
            return false;
        }
        // ET-5: Die Bezeichnung steht in der Liste — ohne Nachziehen trüge der Eintrag
        // weiter den alten Namen, während der Kartenkopf schon den neuen zeigte.
        ListeNachziehen();
        return true;
    }

    private void NeuFragen()
    {
        if (NamensGaben is null) return;
        _namensGaben = NamensGaben();
    }

    private void NeuFertig(string? name)
    {
        _namensGaben = null;
        if (name is null || TraegerNeu is null) return;
        int id = TraegerNeu(name);
        if (id <= 0) return;
        // ET-5: erst die Liste, dann die Markierung — der neue Träger steht sonst nicht
        // darin, und ListeNachziehen nähme die Markierung gleich wieder weg.
        ListeNachziehen();
        _traegerId = id;
        Laden(id);
    }

    private void VarianteAnlegen()
    {
        if (TraegerVariante is null) return;
        int id = TraegerVariante();
        if (id <= 0) return;
        ListeNachziehen();
        _traegerId = id;
        Laden(id);
    }

    private void LoeschenFragen()
    {
        if (!_traegerId.HasValue) return;
        _frage = string.Format(VorlageLoeschen, TraegerName(_traegerId.Value));
        _frageJa = () =>
        {
            if (TraegerLoeschen is null) return Task.CompletedTask;
            (bool erfolg, string grund) = TraegerLoeschen();
            if (!erfolg)
            {
                Melden(string.Format(VorlageGesperrt, grund), WarnStufe.Warnung);
                return Task.CompletedTask;
            }
            // ET-5: Der gelöschte Träger verschwindet aus der Liste; Markierung und
            // Karte bleiben leer (so war es schon, und so bleibt es).
            ListeNachziehen();
            _traegerId = null;
            _ansicht = new EnergietraegerAnsicht();
            Melden("");
            return Task.CompletedTask;
        };
    }

    // =====================================================================
    // Projektkontext (Ä10)
    // =====================================================================

    private void UebernahmeOeffnen()
    {
        _freie = FreieLaden is not null ? FreieLaden() : Freie;
        if (_freie.Count == 0)
        {
            Melden(UebernahmeLeer, WarnStufe.Hinweis);
            return;
        }
        _uebernahmeWahl = Array.Empty<int>();
        _uebernahmeOffen = true;
    }

    private void UebernahmeAusfuehren()
    {
        _uebernahmeOffen = false;
        if (InsProjekt is null) return;
        int letzter = InsProjekt(_uebernahmeWahl);
        if (letzter <= 0) return;
        // ET-5: Bis hierher setzte dieser Weg _traegerId auf einen Träger, der in der
        // Liste GAR NICHT stand — Liste ohne Markierung, Karte mit neuem Träger.
        ListeNachziehen();
        _traegerId = letzter;
        Laden(letzter);
    }

    private void EntfernenFragen()
    {
        if (!_traegerId.HasValue) return;
        _frage = string.Format(VorlageEntfernen, TraegerName(_traegerId.Value));
        _frageJa = () =>
        {
            if (AusProjekt is null) return Task.CompletedTask;
            (bool erfolg, string grund) = AusProjekt();
            if (!erfolg)
            {
                Melden(string.Format(VorlageGesperrt, grund), WarnStufe.Warnung);
                return Task.CompletedTask;
            }
            // ET-5: Der entfernte Träger verschwindet aus der Liste.
            ListeNachziehen();
            _traegerId = null;
            _ansicht = new EnergietraegerAnsicht();

            // ET-6: Hat das Projekt seinen Stromträger im selben Atemzug WIEDER bekommen
            // (elektrische Anlage im Projekt, Anwenderentscheid ET-2), wird das GESAGT —
            // sonst sieht der Anwender einen Träger, den er gerade loswerden wollte, und
            // hält ihn für den Fehler.
            string strom = StromZugeordnet is null ? "" : StromZugeordnet();
            Melden(string.IsNullOrEmpty(strom)
                       ? "" : string.Format(VorlageStromZugeordnet, strom), WarnStufe.Hinweis);
            return Task.CompletedTask;
        };
    }

    private async Task FrageBeantwortet(bool? antwort)
    {
        Func<Task>? ja = _frageJa;
        _frage = "";
        _frageJa = null;
        if (antwort == true && ja is not null) await ja();
    }

    private string TraegerName(int id)
    {
        foreach (EnergietraegerListe e in _liste)
        {
            if (e.Traeger == id) return e.Text.Trim();
        }
        return "";
    }

