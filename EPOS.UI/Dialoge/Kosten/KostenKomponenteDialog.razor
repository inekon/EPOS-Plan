    /// (der Regelfall) und im Stammkontext, wo es noch kein Projekt gibt.
    /// </summary>
    public string OhneBasisText
    {
        get
        {
            var teile = new List<string>();
            foreach (KostenPositionZeile z in _stand.Zeilen)
            {
                if (!z.OhneBasis) continue;
                string grund = z.BetragKurztext ?? "";
                if (grund.Length == 0) continue;
                teile.Add(string.Format(VorlageOhneBasis, z.Bezeichnung, grund));
            }
            return string.Join(" · ", teile);
        }
    }

