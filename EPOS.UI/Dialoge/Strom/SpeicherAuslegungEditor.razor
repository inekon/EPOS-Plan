@* DER EDITOR FUER QUELLEN, KOSTEN UND PROFILE der Stromspeicher-Auslegung.

   BIS #206 TRUG ER AUCH DEN SUCHRAUM des Einzelspeicher-Optimierers — Groessenachse,
   Von/Bis/Schritt, Stuetzstellen, C-Rate, Berechnungsart, Feinraster, Verschleiss —,
   sichtbar gemacht ueber den Schalter NurQuellenKostenProfile. Mit dem
   Anwenderentscheid SD-E-8 vom 11.09.2026 kennt die Ansicht nur noch EINEN Weg, die
   Flotte, und die fuehrt ihren Suchbereich je Einheit in der Flottenachse
   (FlottenAuslegungsAchse im SpeicherFlottenEditor) statt hier. Der Block ist deshalb
   gefallen, und mit ihm der Schalter: Dieser Editor zeigt IMMER Quellen, Kosten und
   Profile.

   DIE FELDER SELBST SIND NICHT WEG — Groessenachse, Stuetzstellen, Strategie und
   Feinraster stehen weiter in SpeicherOptimierungEingaben und speisen den
   Einzelspeicher-Optimierer, den der Bericht (SpeicherBetriebsbild) und die KI-Aktion
   „speicher_optimieren" weiter fahren. Sie werden nur nicht mehr in dieser Ansicht
   eingegeben. *@

@namespace EPOS.UI.Dialoge.Strom
@using SpeicherEngine
@using WindowsFormsApplication1

<div class="epos-speicherauslegung epos-speicheropt-suchraum">
    <Formularraster>
        <KindInhalt>
            <Formulargruppe Titel="@Texte.Zeitreihen">
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@Texte.Lastquelle" Eintraege="@LastQuellen" Auswahl="@((int)Auslegung.Lastquelle)"
                                 Aktiv="@Aktiv" AuswahlChanged="@(v => QuelleSetzen(v, x => Auslegung.Lastquelle = x))" />
                    <Auswahlfeld Bezeichnung="@Texte.PvQuelle" Eintraege="@PvQuellen" Auswahl="@((int)Auslegung.PvQuelle)"
                                 Aktiv="@Aktiv" AuswahlChanged="@(v => QuelleSetzen(v, x => Auslegung.PvQuelle = x))" />
                    <Auswahlfeld Bezeichnung="@Texte.Preisquelle" Eintraege="@PreisQuellen" Auswahl="@((int)Auslegung.Preisquelle)"
                                 Aktiv="@Aktiv" AuswahlChanged="@(v => QuelleSetzen(v, x => Auslegung.Preisquelle = x))" />
                    @if (Auslegung.Preisquelle == SpeicherAuslegungQuelle.Preisprofil && Strompreisprofile.Count > 0)
                    {
                        <Auswahlfeld Bezeichnung="@Texte.Preisprofil" Eintraege="@Preisprofile" Auswahl="@PreisprofilIndex"
                                     Aktiv="@Aktiv" AuswahlChanged="PreisprofilSetzen" />
                    }
                    @if (GemischteZeitbasis)
                    {
                        <Schalter Bezeichnung="@Texte.EposModelljahrZuordnen" Wert="@EposModelljahrZuordnen"
                                  Aktiv="@Aktiv" WertChanged="EposModelljahrSetzen" />
                    }
                </KindInhalt>
            </Formulargruppe>
        </KindInhalt>
    </Formularraster>

    <div class="epos-leiste">
        @if (Auslegung.Lastquelle == SpeicherAuslegungQuelle.Datei)
        { <button type="button" class="epos-knopf" disabled="@(!Aktiv || DateiWaehlen is null)" @onclick="@(() => DateiOeffnen(SpeicherZeitreihenRolle.Last))">@DateiText(Texte.LastDatei, Auslegung.LastDatei)</button> }
        @if (Auslegung.PvQuelle == SpeicherAuslegungQuelle.Datei)
        { <button type="button" class="epos-knopf" disabled="@(!Aktiv || DateiWaehlen is null)" @onclick="@(() => DateiOeffnen(SpeicherZeitreihenRolle.Pv))">@DateiText(Texte.PvDatei, Auslegung.PvDatei)</button> }
        @if (Auslegung.Preisquelle == SpeicherAuslegungQuelle.Datei)
        { <button type="button" class="epos-knopf" disabled="@(!Aktiv || DateiWaehlen is null)" @onclick="@(() => DateiOeffnen(SpeicherZeitreihenRolle.Bezug))">@DateiText(Texte.PreisDatei, Auslegung.PreisDatei)</button> }
        @if (Auslegung.Preisquelle == SpeicherAuslegungQuelle.Preisprofil)
        { <button type="button" class="epos-knopf" disabled="@(!Aktiv)" @onclick="PreisprofilOeffnen">@(Auslegung.Strompreisprofil is null ? Texte.PreisprofilAnlegen : Texte.PreisprofilBearbeiten)</button> }
    </div>

    <Formularraster>
        <KindInhalt>
            <Formulargruppe Titel="@Texte.Kosten">
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@Texte.Investitionsquelle" Eintraege="@KostenQuellen"
                                 Auswahl="@((int)Auslegung.Investitionsquelle)" Aktiv="@Aktiv"
                                 AuswahlChanged="@(v => KostenQuelleSetzen(v, x => Auslegung.Investitionsquelle = x))" />
                    <Auswahlfeld Bezeichnung="@Texte.Betriebsquelle" Eintraege="@KostenQuellen"
                                 Auswahl="@((int)Auslegung.Betriebsquelle)" Aktiv="@Aktiv"
                                 AuswahlChanged="@(v => KostenQuelleSetzen(v, x => Auslegung.Betriebsquelle = x))" />
                    <Zahlenfeld Bezeichnung="@Texte.InvestKw" Einheit="€/kW" Wert="@InvestAnzeige.InvestEurProKw"
                                Min="0" Aktiv="@(Aktiv && Auslegung.Investitionsquelle == SpeicherKostenQuelle.Dialog)"
                                WertChanged="@(v => InvestitionSetzen(v, x => Auslegung.DirekteKosten.InvestEurProKw = x))" />
                    <Zahlenfeld Bezeichnung="@Texte.InvestKwh" Einheit="€/kWh" Wert="@InvestAnzeige.InvestEurProKwh"
                                Min="0" Aktiv="@(Aktiv && Auslegung.Investitionsquelle == SpeicherKostenQuelle.Dialog)"
                                WertChanged="@(v => InvestitionSetzen(v, x => Auslegung.DirekteKosten.InvestEurProKwh = x))" />
                    <Zahlenfeld Bezeichnung="@Texte.BetriebKw" Einheit="€/(kW·a)" Wert="@BetriebAnzeige.BetriebEurProKwJahr"
                                Min="0" Aktiv="@(Aktiv && Auslegung.Betriebsquelle == SpeicherKostenQuelle.Dialog)"
                                WertChanged="@(v => BetriebSetzen(v, x => Auslegung.DirekteKosten.BetriebEurProKwJahr = x))" />
                    <Zahlenfeld Bezeichnung="@Texte.BetriebKwh" Einheit="€/(kWh·a)" Wert="@BetriebAnzeige.BetriebEurProKwhJahr"
                                Min="0" Aktiv="@(Aktiv && Auslegung.Betriebsquelle == SpeicherKostenQuelle.Dialog)"
                                WertChanged="@(v => BetriebSetzen(v, x => Auslegung.DirekteKosten.BetriebEurProKwhJahr = x))" />
                    <Zahlenfeld Bezeichnung="@Texte.BetriebEntladen" Einheit="€/kWh" Wert="@BetriebAnzeige.BetriebEurProKwhEntladen"
                                Min="0" Aktiv="@(Aktiv && Auslegung.Betriebsquelle == SpeicherKostenQuelle.Dialog)"
                                WertChanged="@(v => BetriebSetzen(v, x => Auslegung.DirekteKosten.BetriebEurProKwhEntladen = x))" />
                </KindInhalt>
            </Formulargruppe>
        </KindInhalt>
    </Formularraster>

    @if (!InvestAnzeige.InvestVorhanden || !BetriebAnzeige.BetriebVorhanden)
    {
        <p>Fehlende Kostensätze werden nicht als kostenlose Anlage bewertet. Bitte Kostensätze eingeben oder die angezeigten Nullkosten ausdrücklich bestätigen.</p>
        @if (!InvestAnzeige.InvestVorhanden && Auslegung.Investitionsquelle == SpeicherKostenQuelle.Dialog)
        { <Schalter Bezeichnung="Investitionskosten mit 0 € ansetzen" Wert="false" Aktiv="@Aktiv" WertChanged="@(async v => { Auslegung.DirekteKosten.InvestVorhanden = v; await Geaendert(); })" /> }
        @if (!BetriebAnzeige.BetriebVorhanden && Auslegung.Betriebsquelle == SpeicherKostenQuelle.Dialog)
        { <Schalter Bezeichnung="Betriebskosten mit 0 € ansetzen" Wert="false" Aktiv="@Aktiv" WertChanged="@(async v => { Auslegung.DirekteKosten.BetriebVorhanden = v; await Geaendert(); })" /> }
    }
    @if (KostenmodulSichtbar)
    {
        <Herleitungszeile Text="@KostenmodulText" />
        @if (Modulkosten.AusgelassenePositionen.Count > 0)
        {
            <ul>@foreach (string position in Modulkosten.AusgelassenePositionen) { <li>@position</li> }</ul>
        }
    }
    @if (GemischteZeitbasis)
    {
        <Herleitungszeile Text="@Texte.EposModelljahrHinweis" />
    }

    <Formularraster>
        <KindInhalt>
            <Formulargruppe Titel="@Texte.Profile">
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@Texte.ProfilLaden" Eintraege="@Profile" Auswahl="@_profilIndex"
                                 Platzhalter="@Texte.ProfilWaehlen" Aktiv="@(Aktiv && Auslegungsprofile.Count > 0)"
                                 AuswahlChanged="ProfilLaden" />
                    <Textfeld Bezeichnung="@Texte.Profilname" Wert="@_profilname"
                              WertChanged="@(v => _profilname = v)" />
                </KindInhalt>
            </Formulargruppe>
        </KindInhalt>
    </Formularraster>
    <div class="epos-leiste">
        <button type="button" class="epos-knopf" disabled="@(!Aktiv || EinstellungenSpeichern is null)" @onclick="EinstellungenSichern">@Texte.EinstellungenSpeichern</button>
        <button type="button" class="epos-knopf" disabled="@(!Aktiv || ProfilSpeichern is null || string.IsNullOrWhiteSpace(_profilname))" @onclick="ProfilSichern">@Texte.ProfilSpeichern</button>
        <button type="button" class="epos-knopf" disabled="@(!Aktiv || !_profilIndex.HasValue)" @onclick="Duplizieren">@Texte.Duplizieren</button>
    </div>
    @if (!string.IsNullOrEmpty(_fehler)) { <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" /> }
    @if (!string.IsNullOrEmpty(_erfolg)) { <Warnbanner Stufe="WarnStufe.Erfolg" Text="@_erfolg" /> }
</div>

@if (_importDatei is not null)
{
    <Ueberlagerung Offen="true" Titel="@_importDatei.Dateiname" Zusatzklasse="epos-ueberlagerung--breit" Geschlossen="@(() => _importDatei = null)">
        <KindInhalt><SpeicherZeitreihenDialog Datei="@_importDatei" Rolle="@_importRolle" Uebernommen="ImportUebernehmen" Geschlossen="@(() => _importDatei = null)" /></KindInhalt>
    </Ueberlagerung>
}

@if (_kostenprofilOffen && Auslegung.Strompreisprofil is not null)
{
    <Ueberlagerung Offen="true" Titel="@Texte.PreisprofilBearbeiten" Zusatzklasse="epos-ueberlagerung--breit" Geschlossen="@(() => _kostenprofilOffen = false)">
        <KindInhalt><EPOS.UI.Dialoge.Kosten.KostenprofilDialog Bezeichner="@Auslegung.Strompreisprofil.Bezeichner"
            Monatswerte="@Zahlen(Auslegung.Strompreisprofil.Monatswerte)" Wochenwerte="@Zahlen(Auslegung.Strompreisprofil.Wochenwerte)"
            Speichern="KostenprofilSpeichern" Geschlossen="KostenprofilGeschlossen" /></KindInhalt>
    </Ueberlagerung>
}

@code {
    [Parameter] public SpeicherOptimierungEingaben Wert { get; set; } = new();
    [Parameter] public EventCallback<SpeicherOptimierungEingaben> WertChanged { get; set; }
    [Parameter] public bool Aktiv { get; set; } = true;
    [Parameter] public IReadOnlyList<SpeicherAuslegungProfil> Auslegungsprofile { get; set; } = Array.Empty<SpeicherAuslegungProfil>();
    [Parameter] public IReadOnlyList<KostenprofilModel> Strompreisprofile { get; set; } = Array.Empty<KostenprofilModel>();
    [Parameter] public SpeicherKostensaetze Modulkosten { get; set; } = new();
    [Parameter] public Func<SpeicherOptimierungEingaben, Task<string>>? EinstellungenSpeichern { get; set; }
    [Parameter] public Func<SpeicherOptimierungEingaben, string, Task<SpeicherOptimierungVorgaben>>? ProfilSpeichern { get; set; }
    [Parameter] public Func<Task<SpeicherImportDatei>>? DateiWaehlen { get; set; }
    [Parameter] public SpeicherAuslegungTexte Texte { get; set; } = new();

    private SpeicherOptimierungEingaben _wert = new();
    private int? _profilIndex;
    private string _profilname = "";
    private string _fehler = "";
    private string _erfolg = "";
    private SpeicherImportDatei? _importDatei;
    private SpeicherZeitreihenRolle _importRolle;
    private bool _kostenprofilOffen;

    private SpeicherAuslegungKonfiguration Auslegung => _wert.Auslegung ??= new();
    private static readonly IReadOnlyList<(int Id, string Text)> LastQuellen = new[] { (0,"EPOS: Strombedarf / Stromlastgang"), (1,"Separate CSV-Datei") };
    private static readonly IReadOnlyList<(int Id, string Text)> PvQuellen = new[] { (0,"EPOS: PV-Simulation"), (1,"Separate CSV-Datei"), (2,"Keine PV") };
    private static readonly IReadOnlyList<(int Id, string Text)> PreisQuellen = new[] { (0,"EPOS: Stromtarif"), (1,"Separate CSV-Datei"), (3,"Editierbares Strompreisprofil") };
    private static readonly IReadOnlyList<(int Id, string Text)> KostenQuellen = new[] { (0,"Im Dialog"), (1,"Kostenmodul") };
    private IReadOnlyList<(int Id,string Text)> Profile => Auslegungsprofile.Select((x,i)=>(i,x.Name)).ToArray();
    private IReadOnlyList<(int Id,string Text)> Preisprofile => Strompreisprofile.Select((x,i)=>(i,x.Bezeichner)).ToArray();
    private int? PreisprofilIndex { get { int i=Strompreisprofile.ToList().FindIndex(x => Auslegung.Strompreisprofil is not null && x.ID == Auslegung.Strompreisprofil.ID); return i < 0 ? null : i; } }
    private bool KostenmodulSichtbar => Auslegung.Investitionsquelle == SpeicherKostenQuelle.Kostenmodul || Auslegung.Betriebsquelle == SpeicherKostenQuelle.Kostenmodul;
    private SpeicherKostensaetze InvestAnzeige => Auslegung.Investitionsquelle == SpeicherKostenQuelle.Kostenmodul ? Modulkosten : Auslegung.DirekteKosten;
    private SpeicherKostensaetze BetriebAnzeige => Auslegung.Betriebsquelle == SpeicherKostenQuelle.Kostenmodul ? Modulkosten : Auslegung.DirekteKosten;
    private bool GemischteZeitbasis =>
        (Auslegung.Lastquelle == SpeicherAuslegungQuelle.Datei || Auslegung.PvQuelle == SpeicherAuslegungQuelle.Datei || Auslegung.Preisquelle == SpeicherAuslegungQuelle.Datei) &&
        (Auslegung.Lastquelle == SpeicherAuslegungQuelle.Epos || Auslegung.PvQuelle == SpeicherAuslegungQuelle.Epos ||
         Auslegung.Preisquelle == SpeicherAuslegungQuelle.Epos || Auslegung.Preisquelle == SpeicherAuslegungQuelle.Preisprofil);
    private bool EposModelljahrZuordnen => Auslegung.EposModelljahrZuordnen;
    private string KostenmodulText => $"{Texte.KostenmodulHerkunft}: {Modulkosten.Herkunft}; {Modulkosten.InvestEurProKw:g} €/kW, {Modulkosten.InvestEurProKwh:g} €/kWh, {Modulkosten.BetriebEurProKwJahr:g} €/(kW·a), {Modulkosten.BetriebEurProKwhJahr:g} €/(kWh·a), {Modulkosten.BetriebEurProKwhEntladen:g} €/kWh";

    protected override void OnParametersSet() { if (!ReferenceEquals(Wert, _wert)) _wert = Wert.Kopie(); }
    private async Task Geaendert() { _fehler=""; _erfolg=""; await WertChanged.InvokeAsync(_wert.Kopie()); }
    private async Task QuelleSetzen(int? v, Action<SpeicherAuslegungQuelle> set) { set((SpeicherAuslegungQuelle)(v??0)); await Geaendert(); }
    private async Task KostenQuelleSetzen(int? v, Action<SpeicherKostenQuelle> set) { set((SpeicherKostenQuelle)(v??0)); await Geaendert(); }
    private async Task EposModelljahrSetzen(bool v) { Auslegung.EposModelljahrZuordnen = v; await Geaendert(); }
    private async Task InvestitionSetzen(double? v, Action<double> set) {if(v.HasValue){set(v.Value);Auslegung.DirekteKosten.InvestVorhanden=true;}await Geaendert();}
    private async Task BetriebSetzen(double? v, Action<double> set) {if(v.HasValue){set(v.Value);Auslegung.DirekteKosten.BetriebVorhanden=true;}await Geaendert();}
    private async Task PreisprofilSetzen(int? v) { if(v is >=0 && v<Strompreisprofile.Count) Auslegung.Strompreisprofil=SpeicherAuslegungKopie.Von(Strompreisprofile[v.Value]); await Geaendert(); }
    private async Task ProfilLaden(int? v) { _profilIndex=v; if(v is >=0 && v<Auslegungsprofile.Count){_wert=Auslegungsprofile[v.Value].Eingaben.Kopie();_profilname=Auslegungsprofile[v.Value].Name;await Geaendert();} }
    private void Duplizieren(){ _profilIndex=null; _profilname=string.IsNullOrWhiteSpace(_profilname)?Texte.Kopie:$"{_profilname} ({Texte.Kopie})"; }
    private async Task EinstellungenSichern(){if(EinstellungenSpeichern is null)return;try{_fehler=await EinstellungenSpeichern(_wert.Kopie())??"";_erfolg=_fehler.Length==0?Texte.Gespeichert:"";}catch(Exception ex){_erfolg="";_fehler=ex.Message;}}
    private async Task ProfilSichern(){if(ProfilSpeichern is null)return;try{var gespeichert=_wert.Kopie();var v=await ProfilSpeichern(gespeichert.Kopie(),_profilname.Trim());if(v is not null){Auslegungsprofile=v.Auslegungsprofile;Strompreisprofile=v.Strompreisprofile;Modulkosten=v.Modulkosten;_wert=gespeichert;await WertChanged.InvokeAsync(_wert.Kopie());_fehler="";_erfolg=Texte.ProfilGespeichert;}}catch(Exception ex){_erfolg="";_fehler=ex.Message;}}
    private async Task DateiOeffnen(SpeicherZeitreihenRolle rolle){if(DateiWaehlen is null)return;try{_importRolle=rolle;_importDatei=await DateiWaehlen();if(_importDatei is null||_importDatei.Inhalt.Length==0)_importDatei=null;_fehler="";}catch(Exception ex){_importDatei=null;_fehler=ex.Message;}}
    private async Task ImportUebernehmen(SpeicherZeitreihe reihe){if(reihe.Rolle==SpeicherZeitreihenRolle.Last)Auslegung.LastDatei=reihe;else if(reihe.Rolle==SpeicherZeitreihenRolle.Pv)Auslegung.PvDatei=reihe;else Auslegung.PreisDatei=reihe;_importDatei=null;await Geaendert();}
    private void PreisprofilOeffnen(){Auslegung.Strompreisprofil??=new KostenprofilModel{Bezeichner=Texte.NeuesPreisprofil};_kostenprofilOffen=true;}
    private static string DateiText(string text, SpeicherZeitreihe? reihe)=>reihe is null?text:$"{text}: {reihe.QuelleName} · {reihe.Werte.Length:N0} Intervalle · {(reihe.ZeitstempelUtc.Length > 0 ? reihe.ZeitstempelUtc[0].ToString("u") : "ohne Zeitachse")}";
    private static IReadOnlyList<double> Zahlen(string text)=>text.Split(';',StringSplitOptions.RemoveEmptyEntries).Select(x=>double.TryParse(x,System.Globalization.NumberStyles.Float,System.Globalization.CultureInfo.InvariantCulture,out var v)?v:0).ToArray();
    private bool KostenprofilSpeichern(string name,IReadOnlyList<double> monate,IReadOnlyList<double> woche){var p=Auslegung.Strompreisprofil??new();p.Bezeichner=name;p.Monatswerte=string.Join(";",monate.Select(x=>x.ToString(System.Globalization.CultureInfo.InvariantCulture)));p.Wochenwerte=string.Join(";",woche.Select(x=>x.ToString(System.Globalization.CultureInfo.InvariantCulture)));Auslegung.Strompreisprofil=p;_kostenprofilOffen=false;_ = Geaendert();return true;}
    private void KostenprofilGeschlossen(bool gespeichert){_kostenprofilOffen=false;}
}

@code {
    public sealed class SpeicherAuslegungTexte {
        public string Zeitreihen{get;set;}=Resource.FLOTTE_AUS_ZEITREIHEN; public string Lastquelle{get;set;}=Resource.FLOTTE_AUS_LASTQUELLE; public string PvQuelle{get;set;}=Resource.FLOTTE_AUS_PVQUELLE; public string Preisquelle{get;set;}=Resource.FLOTTE_AUS_PREISQUELLE; public string Preisprofil{get;set;}=Resource.FLOTTE_AUS_PREISPROFIL; public string LastDatei{get;set;}=Resource.FLOTTE_AUS_LASTDATEI; public string PvDatei{get;set;}=Resource.FLOTTE_AUS_PVDATEI; public string PreisDatei{get;set;}=Resource.FLOTTE_AUS_PREISDATEI; public string PreisprofilBearbeiten{get;set;}=Resource.FLOTTE_AUS_PROFIL_BEARBEITEN; public string PreisprofilAnlegen{get;set;}=Resource.FLOTTE_AUS_PROFIL_ANLEGEN; public string NeuesPreisprofil{get;set;}=Resource.FLOTTE_AUS_PROFIL_NEU;
        public string EposModelljahrZuordnen{get;set;}=Resource.FLOTTE_AUS_MODELLJAHR; public string EposModelljahrHinweis{get;set;}=Resource.FLOTTE_AUS_MODELLJAHR_HINWEIS;
        public string Kosten{get;set;}=Resource.FLOTTE_AUS_KOSTEN; public string Investitionsquelle{get;set;}=Resource.FLOTTE_AUS_INVESTQUELLE; public string Betriebsquelle{get;set;}=Resource.FLOTTE_AUS_BETRIEBSQUELLE; public string InvestKw{get;set;}=Resource.FLOTTE_AUS_INVEST_KW; public string InvestKwh{get;set;}=Resource.FLOTTE_AUS_INVEST_KWH; public string BetriebKw{get;set;}=Resource.FLOTTE_AUS_BETRIEB_KW; public string BetriebKwh{get;set;}=Resource.FLOTTE_AUS_BETRIEB_KWH; public string BetriebEntladen{get;set;}=Resource.FLOTTE_AUS_BETRIEB_ENTLADEN; public string KostenmodulHerkunft{get;set;}=Resource.FLOTTE_AUS_KOSTENMODUL;
        public string Profile{get;set;}=Resource.FLOTTE_AUS_PROFILE; public string ProfilLaden{get;set;}=Resource.FLOTTE_AUS_PROFIL_LADEN; public string ProfilWaehlen{get;set;}=Resource.FLOTTE_AUS_PROFIL_WAEHLEN; public string Profilname{get;set;}=Resource.FLOTTE_AUS_PROFILNAME; public string EinstellungenSpeichern{get;set;}=Resource.FLOTTE_AUS_EINSTELLUNGEN_SPEICHERN; public string ProfilSpeichern{get;set;}=Resource.FLOTTE_AUS_PROFIL_SPEICHERN; public string Duplizieren{get;set;}=Resource.FLOTTE_AUS_DUPLIZIEREN; public string Kopie{get;set;}=Resource.FLOTTE_AUS_KOPIE; public string Gespeichert{get;set;}=Resource.FLOTTE_AUS_GESPEICHERT; public string ProfilGespeichert{get;set;}=Resource.FLOTTE_AUS_PROFIL_GESPEICHERT;
    }
}
