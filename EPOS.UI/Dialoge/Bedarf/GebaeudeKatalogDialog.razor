    }

    /// <summary>
    /// Die Bauartwahl — und mit ihr die BAUWEISE (Entscheid W9‑O‑2 zu Befund W9‑B6,
    /// Anwender 04.09.2026). Der Vorläufer nahm dafür den Index der
    /// <b>Gebäudeart</b>-Klappliste; seither ist die Bauart die Eingabe.
    /// </summary>
    private void BauartWaehlen(int? i)
    {
        Daten.Bauart = i ?? 1;
        BauweiseNachfuehren();
    }

    /// <summary>
    /// <c>Bauweise = Wohnfläche × 20 / 50 / 100</c> aus der BAUART-Auswahl
    /// (<c>Gebaeudebauweise.BauweiseAusBauart</c>).
    ///
    /// <para>Wird auch unmittelbar vor jedem Schreiben gerufen: Die Wohnfläche kann
    /// nach der Bauartwahl noch geändert worden sein, und sie geht in die Größe
    /// ein.</para>
    /// </summary>
    private void BauweiseNachfuehren()
        => Daten.Bauweise = Gebaeudebauweise.BauweiseAusBauart(
               Daten.Bauart, Daten.WohnflaecheGesamt ?? 0);

    private void VerwendungWaehlen(int? i)
    {
        if (i is null || i.Value < 0 || i.Value >= Verwendungswerte.Count) return;
        Daten.Verwendung = Verwendungswerte[i.Value];
    }

    /// <summary>
    /// Der Klapplistenwechsel im Modus Admin lädt den gewählten Satz —
    /// <c>comboBox_Name_SelectedIndexChanged</c>:237 rief dafür <c>SetControls()</c>.
    /// </summary>
    private void NamenWaehlen(int? i)
    {
        _namensindex = i;
        if (i is null || i.Value < 0 || i.Value >= _namen.Count) return;
        SatzLaden(_namen[i.Value]);
        ZweitenReiterFuellen();
    }

    private void SatzLaden(string name)
    {
        GebaeudeKatalogDaten? satz = Lies?.Invoke(name);
        if (satz is null) return;
        Daten = satz;

        // Der Rundweg zu W9-O-2: Die BAUART kommt aus der gespeicherten Bauweise
        // (SetControls:107-110). Geschrieben wird sie danach wieder aus der Bauart.
        Daten.Bauart = Gebaeudebauweise.BauartAusBauweise(
            Daten.Bauweise, Daten.WohnflaecheGesamt ?? 0);

        _ursprungsname = satz.Name ?? "";
        _meldung = "";
    }

    private string Ferienname(int n)
        => (Ferienzeitraeume is not null && Ferienzeitraeume.Count > n) ? Ferienzeitraeume[n] : "";

