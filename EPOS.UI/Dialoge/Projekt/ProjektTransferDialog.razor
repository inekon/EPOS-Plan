@* „Projekt exportieren / importieren" - der Projekttransfer zwischen Rechnern
   (iU9-W15a.5, Konzept_Projekttransfer_EPOS-Plan.md, Etappen T1-T6).

   SIE LOEST Form_ProjektExportImport AB (320 Z., KEIN Designer, 7 MessageBox) -
   die groesste Maske der Welle und die einzige, die im Vollstaendigkeitsnetz gar
   nicht auftauchte: keine Feldkarte, keine Zeile im Stapellauf, keine im
   Erreichbarkeitsbefund (Befund W15a-B24). Ihre Feldkarte ist von Hand aus
   BaueUi():46-126 geschrieben, 23 Steuerelemente.

   ZWEI BLAETTER UND EINE FUSSZEILE: "Exportieren" (Projekt, Variantenhaken,
   Zieldatei), "Importieren" (Paketdatei, Vorschau aus dem manifest.json, Zielname,
   drei Konfliktmodi, Sicherungshaken) und darunter Fortschritt, Statuszeile und
   "Schliessen". Der Wellenplan zaehlt "3 TabPage" - es sind zwei, die dritte Zeile
   der Inventarliste ist die Fusszeile (Befund W15a-B26).

   A-8: DIE MASKE IST JETZT UEBERSETZT. Ihre 27 sichtbaren Texte waren deutsche
   Literale im Quelltext - kein MyResource, keine Satelliten-.resx; ein englischer
   Anwender sah eine vollstaendig deutsche Maske (Befund W15a-B36/B51).

   A-10/A-11: SICHERUNGSKOPIE UND IMPORTBERICHT BEKOMMEN EINEN ZIELPFAD. Der
   Vorlaeufer legte die Sicherung fest neben die Datenbank (77 MB je Import, ohne
   Aufraeumen - B28) und den Bericht fest neben die Paketdatei (auf iOS ein
   Fremdpfad aus dem Dokumentenwaehler, in den die App nicht schreiben darf - B29).
   Beide sind jetzt Delegaten; unter Windows verhalten sie sich wie bisher.

   KEIN DELEGAT IST KEIN KNOPF (Hausregel A-18): Ohne SicherungAnlegen erscheint
   der Schalter "Sicherungskopie" gar nicht erst.

   KEINE DATENBANK (Hausregel EPOS.UI): Projektliste, Varianten, Vorschau, Export
   und Import kommen als ProjektTransferDaten herein.

   ZWEI LAEUFE IM HINTERGRUND, BEIDE IN DER KULTURVORRICHTUNG (Auftrag #240,
   Vorrichtung aus #232). Export und Import lesen und schreiben die ganze
   Datenbank; auf dem Bedienfaden staende die WebView fuer Minuten. Sie laufen
   deshalb ueber SpeicherEngine.Kulturweitergabe.Starten statt ueber ein nacktes
   Task.Run - ein Faden ohne eigene Kultur liest den VERAENDERLICHEN
   prozessweiten Vorgabewert, und ein Sprachwechsel mitten im Lauf brachte
   Etikett und Zahlenbild auseinander (Befund #231). Der Waechter
   EPOS.Kern.Tests/ParallelitaetWacheTests liest seit #240 auch dieses Projekt
   - samt .razor.

   PI-1 (Anwenderentscheid PI-Q1, 19.09.2026): BEIDE BLAETTER NEHMEN MEHRERE.
   Export: statt EINER Klappliste die Katalogliste in Mehrfachbetrieb - mit
   Suche, Sortierung und Trichtern. Eine gewaehlte VARIANTE zieht ihren Stamm
   sichtbar nach (Spalte "mitgenommen" und Hinweisbanner), und je Stammgruppe
   entsteht GENAU EIN Paket - der Anwenderauftrag sagt "nicht mehrfach".
   Import: mehrere Paketdateien in einem Lauf, mit Vorschau je Paket,
   Reihenfolge Stamm vor Variante und einer Bilanz danach.

   DIE WAHLREGEL STEHT NICHT HIER, sondern im Kern (Projektgruppierung): Der
   Dialog fragt sie, um zu zeigen, was die Wahl nach sich zieht, und der Kern
   fragt dieselbe, um daraus Pakete zu machen. Zwei Fassungen waeren zwei
   Wahrheiten darueber, was mitreist. *@

@namespace EPOS.UI.Dialoge.Projekt

@using EPOS.UI.Bausteine
@using EPOS.UI.Dienste
@using SpeicherEngine
@using WindowsFormsApplication1

<div class="epos-dialog epos-projekttransfer" tabindex="-1" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        @if (!string.IsNullOrEmpty(HilfeSchluessel))
        {
            <InfoKnopf Schluessel="@HilfeSchluessel" />
        }
        @* Waehrend eines Laufs schliesst auch Esc nicht (BeiTaste/Schliessen,
           Wache _laeuft) - das Kreuz gilt derselben Wache. *@
        @if (!_laeuft)
        {
            <Schliesskreuz Geschlossen="Schliessen" />
        }
    </div>

    <Reiter @bind-Aktiv="_reiter" Bezeichnung="@TitelText">
        <KindInhalt>

            @* ================================================== Exportieren *@
            <Reiterblatt Schluessel="EXPORT" Titel="@ReiterExport">
                <KindInhalt>

                    @* PI-1: DIE PROJEKTLISTE, nicht die Klappliste. Sie traegt
                       Kontrollkaestchen (Katalogliste.Mehrfach, Stufe S3.4) und
                       damit auch Suche, Sortierpfeil und Spaltentrichter - bei
                       vierundzwanzig und mehr Projekten der Unterschied zwischen
                       Waehlen und Suchen. *@
                    <p class="epos-untergruppe">@Texte.LabelProjekte</p>

                    <div class="epos-transfer-liste">
                        <Katalogliste Profil="@Listenprofil" Zeilen="@_zeilen"
                                      Filterstand="@_filterstand"
                                      Mehrfach="true" IstGewaehlt="@IstGewaehlt"
                                      Mehrfachwahl="BeiMehrfachwahl" Allewahl="BeiMehrfachalle"
                                      Gefiltert="BeiGefiltert" VirtualisierenAb="120" />
                    </div>

                    @* Die stille Mitnahme sichtbar machen: Wer eine Variante waehlt,
                       nimmt ihren Stamm mit - sonst entstuende am Ziel eine Variante
                       ohne Stamm. Die Spalte "mitgenommen" zeigt WELCHE, das Banner
                       WIE VIELE. *@
                    @if (_nachgezogen.Count > 0)
                    {
                        <Warnbanner Stufe="WarnStufe.Hinweis" Text="@StammzugText" />
                    }

                    @* Je Stammgruppe ein Haekchenblock (TF1: alle an). Das Haekchen
                       einer in der LISTE gewaehlten Variante ist weich gesperrt - sie
                       ist der Grund, warum es dieses Paket gibt. *@
                    @if (_gruppen.Count > 0)
                    {
                        <div class="epos-transfer-gruppen">
                            @foreach (Transfergruppe gruppe in _gruppen)
                            {
                                IReadOnlyList<(int Id, string Text)> eintraege = VariantenEintraege(gruppe);
                                @if (eintraege.Count > 0)
                                {
                                    <Mehrfachauswahl Bezeichnung="@string.Format(Texte.GruppeVarianten, gruppe.Stamm)"
                                                     Eintraege="@eintraege"
                                                     Gewaehlt="@gruppe.VariantenIds"
                                                     GewaehltChanged="@(w => GruppeGeaendert(eintraege, w))"
                                                     Sperrgrund="@Sperrgrund"
                                                     Aktiv="@(!_laeuft)" LeerText="@LeerVarianten" />
                                }
                            }
                        </div>
                    }

                    @* Der Zielordner - er gilt nur, wo MEHRERE Pakete entstehen; bei
                       einer Gruppe bleibt es beim Speichern-Dialog mit Namensvorschlag
                       (der Anwender soll den Namen weiter selbst bestimmen duerfen). *@
                    @if (Daten?.ZielordnerWaehlen is not null && _gruppen.Count > 1)
                    {
                        <div class="epos-transfer-ordner">
                            <span class="epos-feld-text">@Texte.LabelZielordner</span>
                            <span class="epos-transfer-ordner-pfad" title="@_zielordner">@_zielordner</span>
                            <button type="button" class="epos-knopf epos-transfer-ordner-knopf"
                                    disabled="@_laeuft" @onclick="ZielordnerWaehlen">@Texte.BtnOrdner</button>
                        </div>
                    }

                    <div class="epos-leiste">
                        <button type="button" class="epos-knopf epos-knopf--primaer epos-transfer-export"
                                disabled="@(_laeuft || Daten is null)" @onclick="Exportieren">@BtnExport</button>
                    </div>
                </KindInhalt>
            </Reiterblatt>

            @* ================================================== Importieren *@
            <Reiterblatt Schluessel="IMPORT" Titel="@ReiterImport">
                <KindInhalt>

                    @* PI-1: Die MEHRFACHWAHL zuerst - ein Lauf ueber mehrere Pakete
                       ist der Regelfall, sobald jemand Stamm und Varianten einzeln
                       bekommen hat. Ohne den Delegaten bleibt es bei der Einzelwahl
                       (kein Delegat, kein Knopf). *@
                    @if (Daten?.PaketeLesen is not null)
                    {
                        <div class="epos-leiste">
                            <button type="button" class="epos-knopf epos-transfer-dateien"
                                    disabled="@_laeuft" @onclick="PaketeWaehlen">@Texte.BtnDateien</button>
                        </div>
                    }

                    @* Formularraster (iU8-E-2, Paket P3), EINSPALTIG: ein Pfadfeld -
                       es braucht die Breite. *@
                    @if (Daten?.PaketeLesen is null)
                    {
                        <Formularraster Einspaltig="true">
                            <KindInhalt>
                                <Dateiwahl Bezeichnung="@LabelDatei" Pfad="@_paketpfad" PfadChanged="PaketGewaehlt"
                                           Filter="@Dateifilter" KnopfText="@BtnDatei" Aktiv="@(!_laeuft)"
                                           Waehlen="@PaketWaehlen" />
                            </KindInhalt>
                        </Formularraster>
                    }

                    @* EIN Paket: der gewohnte Satz. MEHRERE: die Vorschauliste, in
                       der Reihenfolge, in der der Lauf sie einspielen wird - Stamm
                       vor Variante. Wer sie nicht sieht, versteht spaeter den
                       Bericht nicht. *@
                    @if (_pakete.Count > 1)
                    {
                        <div class="epos-transfer-pakete">
                            <Raster TZeile="Paketzeile" Zeilen="@_pakete.AsQueryable()">
                                <KindInhalt>
                                    <PropertyColumn TGridItem="Paketzeile" TProp="string"
                                                    Property="@(z => z.Datei)" Title="@Texte.SpPaketDatei" />
                                    <PropertyColumn TGridItem="Paketzeile" TProp="string"
                                                    Property="@(z => z.Hauptprojekt)" Title="@Texte.SpPaketProjekt" />
                                    <PropertyColumn TGridItem="Paketzeile" TProp="string"
                                                    Property="@(z => z.Varianten)" Title="@Texte.SpPaketVarianten" />
                                    <PropertyColumn TGridItem="Paketzeile" TProp="string"
                                                    Property="@(z => z.Schema)" Title="@Texte.SpPaketSchema" />
                                    <PropertyColumn TGridItem="Paketzeile" TProp="string"
                                                    Property="@(z => z.Hinweis)" Title="@Texte.SpPaketHinweis" />
                                </KindInhalt>
                            </Raster>
                        </div>
                    }
                    else if (_vorschau is not null)
                    {
                        <Warnbanner Stufe="@(string.IsNullOrEmpty(_vorschau.Fehler) ? WarnStufe.Hinweis : WarnStufe.Warnung)"
                                    Text="@Vorschautext" />
                    }

                    @* Formularraster (iU8-E-2, Paket P3), EINSPALTIG: Zielname, Umgang
                       mit dem Konflikt, Sicherung - der Weg des Imports von oben nach
                       unten. *@
                    @* Der Zielname gilt EINEM Projekt. Bei mehreren Paketen waere er
                       eine Behauptung: Welches der fuenf sollte er treffen? Statt ihn
                       zu sperren (ein gesperrtes Feld erklaert sich nicht), steht dort
                       die leise Zeile mit dem Grund. *@
                    @if (_pakete.Count > 1)
                    {
                        <Herleitungszeile Text="@Texte.MeldungZielnameMehrere" />
                    }

                    <Formularraster Einspaltig="true">
                        <KindInhalt>
                    @if (_pakete.Count <= 1)
                    {
                        <Textfeld Bezeichnung="@LabelZielname" Wert="@_zielname"
                                  WertChanged="@(w => _zielname = w)" NurLesen="@_laeuft" />
                    }

                    <Optionsgruppe Bezeichnung="@LabelKonflikt" Eintraege="@Konfliktmodi"
                                   Auswahl="@((int)_modus)" AuswahlChanged="ModusGewaehlt"
                                   Aktiv="@(!_laeuft)" />

                    @if (Daten?.SicherungAnlegen is not null)
                    {
                        <Schalter Bezeichnung="@LabelSicherung" Wert="@_sicherung"
                                  WertChanged="@(w => _sicherung = w)" Aktiv="@(!_laeuft)" />
                    }
                        </KindInhalt>
                    </Formularraster>

                    <div class="epos-leiste">
                        <button type="button" class="epos-knopf epos-knopf--primaer epos-transfer-import"
                                disabled="@(_laeuft || (string.IsNullOrEmpty(_paketpfad) && _pakete.Count == 0))"
                                @onclick="Importieren">@BtnImport</button>
                    </div>
                </KindInhalt>
            </Reiterblatt>
        </KindInhalt>
    </Reiter>

    @if (_laeuft)
    {
        <Fortschritt Anteil="@_anteil" Text="@_status" />
    }
    else if (!string.IsNullOrEmpty(_status))
    {
        <Warnbanner Stufe="@_statusStufe" Text="@_status" />
    }

    @if (_bericht.Count > 0)
    {
        <Textfeld Bezeichnung="@TitelImportFertig" Wert="@string.Join("\n", _bericht)"
                  Mehrzeilig="true" Zeilen="6" NurLesen="true" Festbreite="true" />
    }

    <SpeichernLeiste OkText="@BtnSchliessen" MitAbbrechen="false" Ergebnis="BeiErgebnis" />

    <Rueckfrage Offen="@(_frage != Frageart.Keine)" TitelText="@FrageTitel" Frage="@Fragetext"
                VorgabeNein="true" JaText="@JaText" NeinText="@NeinText"
                Beantwortet="BeiFrage" />
</div>

@code {
    /// <summary>Welche Rückfrage gerade steht.</summary>
    private enum Frageart { Keine = 0, Ueberschreiben, Sicherung }

    /// <summary>Alles, was der Dialog an Daten und Wegen braucht; <c>null</c> = Prüfstand.</summary>
    [Parameter] public ProjektTransferDaten? Daten { get; set; }

    /// <summary>Der Dialog ist zu; <c>true</c>, wenn ein Import gelungen ist.</summary>
    [Parameter] public EventCallback<bool> Geschlossen { get; set; }

    [Parameter] public string TitelText { get; set; } = "Projekt exportieren / importieren";
    [Parameter] public string ReiterExport { get; set; } = "Exportieren";
    [Parameter] public string ReiterImport { get; set; } = "Importieren";
    [Parameter] public string LabelProjekt { get; set; } = "Projekt:";
    [Parameter] public string LabelVarianten { get; set; } = "Varianten mitexportieren:";
    [Parameter] public string LeerVarianten { get; set; } = "Keine Einträge zur Auswahl.";
    [Parameter] public string BtnExport { get; set; } = "Exportieren…";
    [Parameter] public string BtnDatei { get; set; } = "Datei wählen…";
    [Parameter] public string LabelDatei { get; set; } = "Datei:";
    [Parameter] public string LabelZielname { get; set; } = "Zielname (leer = aus Datei):";
    [Parameter] public string LabelKonflikt { get; set; } = "Falls dieser Name bereits existiert:";
    [Parameter] public string OptNeuerName { get; set; } = "Unter neuem Namen importieren";
    [Parameter] public string OptUeberschreiben { get; set; } = "Vorhandenes Projekt überschreiben";
    [Parameter] public string OptAbbrechen { get; set; } = "Abbrechen";
    [Parameter] public string LabelSicherung { get; set; } = "Sicherungskopie der Datenbank vor dem Import anlegen";
    [Parameter] public string BtnImport { get; set; } = "Importieren…";
    [Parameter] public string BtnSchliessen { get; set; } = "Schließen";
    [Parameter] public string Dateifilter { get; set; } = "WP-Projekt (*.wpx)|*.wpx";

    [Parameter] public string MeldungProjektWaehlen { get; set; } = "Bitte ein Projekt auswählen.";
    [Parameter] public string MeldungDateiWaehlen { get; set; } = "Bitte zuerst eine Datei wählen.";
    [Parameter] public string StatusExportOk { get; set; } = "Export abgeschlossen.";
    [Parameter] public string StatusExportFehler { get; set; } = "Export fehlgeschlagen.";
    [Parameter] public string MeldungExportOk { get; set; } = "Projekt exportiert{0}:\r\n{1}";
    [Parameter] public string MeldungExportVarianten { get; set; } = " (mit {0} Variante(n))";
    [Parameter] public string InfoPaket { get; set; } = "Quellprojekt: {0} · Exportdatum: {1} · Schema-Version: {2}";
    [Parameter] public string InfoVarianten { get; set; } = "Varianten ({0}): {1}";
    [Parameter] public string FrageUeberschreiben { get; set; } =
        "Ein evtl. vorhandenes Projekt gleichen Namens wird unwiderruflich überschrieben. Fortfahren?";
    [Parameter] public string FrageUeberschreibenTitel { get; set; } = "Überschreiben";
    [Parameter] public string StatusSicherung { get; set; } = "Sicherung: {0}";
    [Parameter] public string FrageSicherung { get; set; } =
        "Die Sicherungskopie konnte nicht angelegt werden:\n{0}\n\nTrotzdem importieren?";
    [Parameter] public string FrageSicherungTitel { get; set; } = "Sicherung";
    [Parameter] public string StatusImportOk { get; set; } = "Import abgeschlossen.";
    [Parameter] public string TitelImportFertig { get; set; } = "Import abgeschlossen";
    [Parameter] public string MeldungImportFehler { get; set; } = "Import fehlgeschlagen:\n{0}";
    [Parameter] public string MeldungUnbekannt { get; set; } = "unbekannter Fehler";
    [Parameter] public string StatusTabelle { get; set; } = "… {0}";
    [Parameter] public string StatusBericht { get; set; } = "Bericht: {0}";
    [Parameter] public string JaText { get; set; } = "Ja";
    [Parameter] public string NeinText { get; set; } = "Nein";

    /// <summary>Schlüssel des Hilfeknopfes; leer = kein Knopf.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "";

    /// <summary>
    /// Die Texte des MEHRFACHTRANSFERS als Bündel (PI-1). Die vierzig
    /// Bestandsparameter darüber bleiben einzeln — sie umzubauen wäre eine
    /// Änderung an achtzig Stellen ohne Bezug zum Auftrag.
    /// </summary>
    [Parameter] public ProjektTransferTexte Texte { get; set; } = new();

    /// <summary>
    /// Der Übersetzer der Listenspalten; <c>null</c> nimmt den Ressourcentext mit
    /// deutschem Rückfall. Er liegt beim Wirt, weil der Kern keine Anzeigetexte
    /// kennt (dasselbe Muster wie <c>Katalogfilterprofil.Finde</c>).
    /// </summary>
    [Parameter] public Func<string, string>? Spaltentext { get; set; }

    private string _reiter = "EXPORT";

    // ---- Exportblatt: die Wahl -------------------------------------------
    //
    // Die WAHRHEIT ist die Menge der Projekt-Ids: Sie ueberlebt jeden
    // Filterwechsel, denn sie haengt nicht an Zeilennummern. Die
    // Zeilenmarkierung daneben traegt nur die KLICKREGEL (Klick schaltet um,
    // Umschalt nimmt den Bereich dazu - W6-E-5) und rechnet auf ANZEIGEindizes;
    // nach jedem Klick werden beide zusammengefuehrt.
    private readonly HashSet<int> _wahl = new();
    private readonly HashSet<int> _abgewaehlt = new();
    private readonly Zeilenmarkierung _markierung = new();
    private readonly Katalogfilterstand _filterstand = new();

    private IReadOnlyList<Katalogfilterzeile> _zeilen = Array.Empty<Katalogfilterzeile>();
    private IReadOnlyList<Transfergruppe> _gruppen = Array.Empty<Transfergruppe>();
    private IReadOnlyList<int> _nachgezogen = Array.Empty<int>();
    private Katalogfilterprofil? _listenprofil;
    private string _zielordner = "";

    private string _paketpfad = "";
    private readonly List<Paketzeile> _pakete = new();
    private string _zielname = "";
    private PaketVorschau? _vorschau;
    private ProjektExportImportCtrl.BeiVorhandenem _modus = ProjektExportImportCtrl.BeiVorhandenem.NeuerName;
    private bool _sicherung = true;

    private bool _laeuft;
    private double? _anteil;
    private string _status = "";
    private WarnStufe _statusStufe = WarnStufe.Hinweis;
    private List<string> _bericht = new();

    private Frageart _frage = Frageart.Keine;
    private string _fragegrund = "";
    private bool _importErfolgreich;

    /// <summary>Das Hauptprojekt der ERSTEN Gruppe (Prüfhilfe für Tests).</summary>
    public string Projekt => _gruppen.Count > 0 ? _gruppen[0].Stamm : "";

    /// <summary>Die Variantennamen der ERSTEN Gruppe (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<string> GewaehlteVarianten
        => _gruppen.Count > 0 ? _gruppen[0].Varianten : Array.Empty<string>();

    /// <summary>Die Stammgruppen der laufenden Wahl (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<Transfergruppe> Gruppen => _gruppen;

    /// <summary>Die Projekt-Ids, die der Anwender angehakt hat (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<int> Gewaehlt => _wahl.OrderBy(i => i).ToList();

    /// <summary>Der gewählte Zielordner (Prüfhilfe für Tests).</summary>
    public string Zielordner => _zielordner;

    /// <summary>Die Vorschauzeilen des Importblatts (Prüfhilfe für Tests).</summary>
    public IReadOnlyList<Paketzeile> Pakete => _pakete;

    /// <summary>Das Spaltenprofil der Transferliste — einmal gebaut, nicht je Zeichenlauf.</summary>
    private Katalogfilterprofil Listenprofil
        => _listenprofil ??= Projekttransferprofil.Profil(Spaltentext);

    private IReadOnlyList<(int Id, string Text)> Konfliktmodi => new (int, string)[]
    {
        ((int)ProjektExportImportCtrl.BeiVorhandenem.NeuerName,      OptNeuerName),
        ((int)ProjektExportImportCtrl.BeiVorhandenem.Ueberschreiben, OptUeberschreiben),
        ((int)ProjektExportImportCtrl.BeiVorhandenem.Abbrechen,      OptAbbrechen)
    };

    private string Fragetext => _frage switch
    {
        Frageart.Ueberschreiben => FrageUeberschreiben,
        Frageart.Sicherung => string.Format(FrageSicherung, _fragegrund),
        _ => ""
    };

    private string FrageTitel => _frage == Frageart.Sicherung ? FrageSicherungTitel : FrageUeberschreibenTitel;

    private string Vorschautext
    {
        get
        {
            if (_vorschau is null) return "";
            if (!string.IsNullOrEmpty(_vorschau.Fehler)) return _vorschau.Fehler;

            string satz = string.Format(InfoPaket, _vorschau.Quellprojekt,
                                        _vorschau.Exportdatum, _vorschau.Schemastand);
            if (_vorschau.Varianten.Count > 0)
                satz += "\n" + string.Format(InfoVarianten, _vorschau.Varianten.Count,
                                             string.Join(", ", _vorschau.Varianten));
            return satz;
        }
    }

    private IReadOnlyList<ProjektKopfZeile> Bestand
        => Daten?.Projekte ?? (IReadOnlyList<ProjektKopfZeile>)Array.Empty<ProjektKopfZeile>();

    /// <summary>Der Bestand, aus dem die Listenzeilen zuletzt entstanden sind.</summary>
    private object? _zeilenAbzug;

    protected override void OnParametersSet()
    {
        // PI-1: KEINE Vorbelegung. Eine Mehrfachliste mit einer vorgehakten Zeile
        // behauptet eine Wahl, die der Anwender nicht getroffen hat - und der
        // Export schriebe sie. Der Vorlaeufer belegte vor, weil er GENAU EINES
        // nehmen konnte und ohne Wahl gar nichts ging.
        if (!ReferenceEquals(Daten?.Projekte, _zeilenAbzug))
        {
            _zeilenAbzug = Daten?.Projekte;
            _zeilen = Projekttransferprofil.Zeilen(Bestand, _nachgezogen);
        }
        WahlGeaendert();
    }

    private void ModusGewaehlt(int? wert)
        => _modus = (ProjektExportImportCtrl.BeiVorhandenem)(wert ?? 0);

    // =============================================================================
    //  Exportblatt: Liste, Wahl, Gruppen
    // =============================================================================

    /// <summary>
    /// Nach jeder Änderung an der Wahl: Gruppen und nachgezogene Stämme neu
    /// bestimmen (BEIDES aus <c>Projektgruppierung</c>, nicht aus einer zweiten
    /// Regel hier) und die Spalte „mitgenommen" nachziehen.
    ///
    /// <para><b>Die ZEILENOBJEKTE bleiben dieselben</b>, und das ist kein
    /// Sparzwang, sondern Bedingung: Die <c>Katalogliste</c> bestimmt den
    /// Anzeigeindex eines Klicks über <c>ReferenceEquals</c> gegen ihre gefilterte
    /// Liste. Wer die Zeilen bei jedem Klick neu baut, gibt ihr ein Objekt, das sie
    /// nicht kennt — sie meldet Index −1, und der zweite Klick auf dieselbe Zeile
    /// bleibt wirkungslos. Der Wert der einen Spalte wird deshalb IN der Zeile
    /// gesetzt; neu gebaut wird nur, wenn ein anderer Bestand hereinkommt.</para>
    /// </summary>
    private void WahlGeaendert()
    {
        _nachgezogen = Projektgruppierung.Nachgezogen(Bestand, _wahl);
        _gruppen = Projektgruppierung.Gruppieren(Bestand, _wahl, _abgewaehlt);

        var nach = new HashSet<int>(_nachgezogen);
        foreach (Katalogfilterzeile z in _zeilen)
            z.MitKennzeichen(Projekttransferprofil.SpMitgenommen, nach.Contains(z.Id));
    }

    /// <summary>Die Anzeigeliste in derselben Ordnung, die die Katalogliste zeichnet.</summary>
    private IReadOnlyList<Katalogfilterzeile> Anzeige()
        => Katalogfilter.Anwenden(Listenprofil, _zeilen, _filterstand);

    /// <summary>Ist diese Zeile gewählt? Wird je GEZEICHNETER Zeile gefragt — O(1).</summary>
    private bool IstGewaehlt(Katalogfilterzeile zeile) => _wahl.Contains(zeile.Id);

    /// <summary>
    /// Ein Klick in der Mehrfachwahl. Die REGEL (Klick schaltet um, Umschalt nimmt
    /// den Bereich dazu) liegt in <c>Zeilenmarkierung</c> und gilt damit für alle
    /// Mehrfachlisten des Hauses gleich.
    /// </summary>
    private void BeiMehrfachwahl(Katalogliste.Mehrfachklick klick)
    {
        _markierung.Anklicken(klick.Index, klick.Strg, klick.Umschalt);
        WahlAusMarkierung(Anzeige());
    }

    /// <summary>„Alle"/„Keine" gilt den SICHTBAREN Zeilen (W13-B-5).</summary>
    private void BeiMehrfachalle(Katalogliste.Mehrfachalle alle)
    {
        IReadOnlyList<Katalogfilterzeile> anzeige = alle.Zeilen ?? Anzeige();

        if (alle.Waehlen) _markierung.AlleWaehlen(anzeige.Count); else _markierung.Leeren();
        WahlAusMarkierung(anzeige);
    }

    /// <summary>
    /// <b>Der Filter oder die Sortierung haben sich geändert</b> — die Markierung
    /// zählt ANZEIGEindizes, und die zeigen jetzt auf andere Zeilen. Sie wird
    /// deshalb aus der WAHL neu aufgebaut; der Anker der Bereichswahl fällt dabei
    /// weg (dieselbe Zusage wie <c>Zeilenmarkierung.AufAnzahlBegrenzen</c>: eine
    /// veraltete Markierung bleibt ohne Wirkung, statt die falsche Zeile zu
    /// treffen).
    ///
    /// <para><b>Nur hier</b>, nicht bei jedem Klick: Die Markierung IST der
    /// laufende Zustand der Klickregel. Wer sie vor jedem Klick aus der Wahl neu
    /// aufbaut, verliert den Anker — und ein <c>Hinzufügen</c>, das ihn setzen
    /// soll, wählt die Zeile gleich mit.</para>
    /// </summary>
    private void BeiGefiltert()
    {
        IReadOnlyList<Katalogfilterzeile> anzeige = Anzeige();
        _markierung.Leeren();
        for (int i = 0; i < anzeige.Count; i++)
            if (_wahl.Contains(anzeige[i].Id)) _markierung.Hinzufuegen(i);
        _markierung.AnkerLoesen();
    }

    /// <summary>
    /// Die Wahl aus der Markierung zurückschreiben — und dabei alles STEHEN LASSEN,
    /// was gerade nicht sichtbar ist. Ein Trichter darf keine Wahl wegnehmen.
    /// </summary>
    private void WahlAusMarkierung(IReadOnlyList<Katalogfilterzeile> anzeige)
    {
        foreach (Katalogfilterzeile z in anzeige) _wahl.Remove(z.Id);
        foreach (int i in _markierung.Gewaehlt)
            if (i >= 0 && i < anzeige.Count) _wahl.Add(anzeige[i].Id);

        WahlGeaendert();
    }

    /// <summary>„Zu {0} gewählten Varianten kommen {1} Stammprojekte hinzu."</summary>
    private string StammzugText
        => string.Format(Texte.HinweisStammzug,
                         _wahl.Count(id => Bestand.Any(z => z.Id == id && z.StammId > 0)),
                         _nachgezogen.Count);

    /// <summary>
    /// ALLE Varianten dieser Stammgruppe als Häkchenliste — auch die abgewählten:
    /// Sonst verschwände ein Eintrag beim Abwählen und wäre nicht zurückzuholen.
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> VariantenEintraege(Transfergruppe gruppe)
        => Bestand.Where(z => z.StammId == gruppe.StammId && z.Id != gruppe.StammId)
                  .OrderBy(z => z.Name, StringComparer.CurrentCultureIgnoreCase)
                  .ThenBy(z => z.Id)
                  .Select(z => (z.Id, z.Name))
                  .ToList();

    /// <summary>
    /// Das Häkchen einer in der LISTE gewählten Variante ist gesperrt — sie ist der
    /// Grund, warum es dieses Paket überhaupt gibt. Die Sperre ist WEICH und nennt
    /// ihren Grund; ein Häkchen, das sich wortlos nicht bewegt, ist eine Sackgasse.
    /// </summary>
    private string Sperrgrund(int id) => _wahl.Contains(id) ? Texte.GesperrtGewaehlt : "";

    private void GruppeGeaendert(IReadOnlyList<(int Id, string Text)> eintraege,
                                 IReadOnlyList<int> gewaehlt)
    {
        foreach ((int id, _) in eintraege)
        {
            if (gewaehlt.Contains(id)) _abgewaehlt.Remove(id);
            else if (!_wahl.Contains(id)) _abgewaehlt.Add(id);
        }
        WahlGeaendert();
    }

    private async Task ZielordnerWaehlen()
    {
        if (Daten?.ZielordnerWaehlen is null) return;

        // Ein Delegat, der Oberflaeche der Plattform oeffnet, wird AWAITET
        // (Hausregel EPOS.UI) - synchron stuerzt die WebView2 ab.
        string? ordner = await Daten.ZielordnerWaehlen();
        if (!string.IsNullOrEmpty(ordner)) _zielordner = ordner!;
    }

    private Func<string, Task<string?>>? PaketWaehlen
        => Daten?.PaketLesen is null
            ? null
            : _ => Task.FromResult(Daten!.PaketLesen!());

    private void PaketGewaehlt(string pfad)
    {
        _paketpfad = pfad ?? "";
        _bericht.Clear();
        _vorschau = null;
        if (string.IsNullOrEmpty(_paketpfad) || Daten is null) return;

        _vorschau = Daten.Vorschau(_paketpfad);

        // Der Vorlaeufer belegte den Zielnamen mit dem Quellprojekt vor, wenn das
        // Feld noch leer war.
        if (string.IsNullOrWhiteSpace(_zielname) && string.IsNullOrEmpty(_vorschau.Fehler))
            _zielname = _vorschau.Quellprojekt ?? "";
    }

    // =============================================================================
    //  Export
    // =============================================================================
    private async Task Exportieren()
    {
        if (Daten is null) return;

        if (_gruppen.Count == 0) { Melden(Texte.MeldungKeineWahl, WarnStufe.Warnung); return; }

        // MEHRERE Gruppen: ein Paket je Gruppe in den Zielordner.
        if (_gruppen.Count > 1)
        {
            if (Daten.ExportierenMehrere is null)
            { Melden(Texte.MeldungKeineWahl, WarnStufe.Warnung); return; }
            if (string.IsNullOrEmpty(_zielordner))
            { Melden(Texte.MeldungKeinOrdner, WarnStufe.Warnung); return; }

            await SammelExport();
            return;
        }

        // EINE Gruppe: der gewohnte Speichern-Dialog mit Namensvorschlag.
        Transfergruppe einzeln = _gruppen[0];
        if (Daten.PaketSchreiben is null) return;

        string? ziel = Daten.PaketSchreiben(einzeln.Stamm + ".wpx");
        if (string.IsNullOrEmpty(ziel)) return;      // abgebrochen

        string _projekt = einzeln.Stamm;
        IReadOnlyList<string> varianten = einzeln.Varianten;

        _laeuft = true;
        _anteil = null;
        _status = "";
        _bericht.Clear();
        StateHasChanged();

        // Progress<T> stellt jede Meldung in den Synchronisationskontext EIN und
        // liefert sie spaeter aus. Eine Meldung, die der Kern unmittelbar vor seinem
        // Ende absetzt, kann deshalb NACH der Fortsetzung hinter dem await ankommen
        // und die Abschlussmeldung ueberschreiben - dann stuende bis zum naechsten
        // Zeichnen ein Fortschrittstext in der Statuszeile (Kern-Lauf 33883408900,
        // ProjektTransferDialogTests: "... Tab_Projekt" statt "Export abgeschlossen.").
        // Nach dem Lauf werden Fortschrittsmeldungen deshalb verworfen.
        var melder = new Progress<string>(t => { if (!_laeuft) return; _status = t; StateHasChanged(); });
        bool ok = await Kulturweitergabe.Starten(() => Daten.Exportieren(_projekt, varianten, ziel!, melder));

        _laeuft = false;
        if (!ok) { Melden(StatusExportFehler, WarnStufe.Fehler); return; }

        string zusatz = varianten.Count > 0 ? string.Format(MeldungExportVarianten, varianten.Count) : "";
        Melden(StatusExportOk + " " + string.Format(MeldungExportOk, zusatz, ziel), WarnStufe.Hinweis);
    }

    /// <summary>
    /// <b>Ein Paket je Stammgruppe</b> — der Lauf haelt an keinem Fehler an, die
    /// Bilanz nennt sie am Ende. Fuenf Gruppen und eine kaputte ergaeben sonst nichts.
    /// </summary>
    private async Task SammelExport()
    {
        if (Daten?.ExportierenMehrere is null) return;

        IReadOnlyList<Transfergruppe> gruppen = _gruppen;
        string ordner = _zielordner;

        _laeuft = true;
        _anteil = null;
        _status = "";
        _bericht.Clear();
        StateHasChanged();

        var melder = new Progress<ImportFortschritt>(BeiLauf);
        ExportBilanz bilanz = await Kulturweitergabe.Starten(
            () => Daten.ExportierenMehrere(gruppen, ordner, melder));

        _laeuft = false;
        _anteil = null;

        _bericht = bilanz.Zeilen
            .Select(z => z.Erfolg
                ? z.Gruppe + " \u2192 " + z.Datei
                : z.Gruppe + ": " + z.Grund)
            .ToList();

        Melden(string.Format(Texte.BilanzExport, bilanz.Geschrieben, bilanz.Pakete, bilanz.Fehler),
               bilanz.Fehler > 0 ? WarnStufe.Warnung : WarnStufe.Hinweis);
    }

    /// <summary>
    /// Der Fortschritt eines Sammellaufs. Der Kern meldet einen SPRACHNEUTRALEN
    /// Schluessel samt Werten; den Satz bildet die Oberflaeche — sie hat die
    /// Sprache, der Kern hat sie nicht.
    /// </summary>
    private void BeiLauf(ImportFortschritt f)
    {
        if (!_laeuft) return;                        // nach dem Lauf verwerfen (Befund #231)
        _anteil = f.Anteil;
        _status = f.Werte.Length >= 3
            ? string.Format(Texte.LaufPaket, f.Werte[0], f.Werte[1], f.Werte[2])
            : _status;
        _statusStufe = WarnStufe.Hinweis;
        StateHasChanged();
    }

    // =============================================================================
    //  Import
    // =============================================================================

    /// <summary>Eine Zeile der Paketvorschau (PI-1).</summary>
    /// <param name="Pfad">Der volle Pfad — der Lauf braucht ihn.</param>
    /// <param name="Datei">Der Dateiname, wie ihn der Anwender kennt.</param>
    /// <param name="Hauptprojekt">Das Hauptprojekt des Pakets.</param>
    /// <param name="Varianten">Die mitgereisten Varianten, durch Komma getrennt.</param>
    /// <param name="Schema">Der Schemastand samt Hinweis, wenn er abweicht.</param>
    /// <param name="Hinweis">Variantenherkunft und Dublettenbefund.</param>
    public sealed record Paketzeile(string Pfad, string Datei, string Hauptprojekt,
                                    string Varianten, string Schema, string Hinweis);

    /// <summary>
    /// <b>Mehrere Pakete waehlen und in der LAUFREIHENFOLGE zeigen</b> — Stamm vor
    /// Variante. Der Dateiwaehler sortiert nach dem Namen; das hat mit der
    /// Verwandtschaft der Projekte nichts zu tun, und wer die Liste nicht in der
    /// Reihenfolge des Laufs sieht, versteht spaeter den Bericht nicht.
    /// </summary>
    private async Task PaketeWaehlen()
    {
        if (Daten?.PaketeLesen is null) return;

        IReadOnlyList<string> pfade = await Daten.PaketeLesen();
        if (pfade is null || pfade.Count == 0) return;

        _bericht.Clear();
        _status = "";
        _pakete.Clear();
        _vorschau = null;
        _paketpfad = "";

        // Die Koepfe lesen - OHNE die Datenbank. Ohne den Delegaten bleibt nur die
        // Vorschau des Einzelweges; dann steht die Reihenfolge der Wahl.
        var koepfe = new List<Paketkopf>();
        foreach (string pfad in pfade)
            koepfe.Add(Daten.Paketkopf is not null
                ? Daten.Paketkopf(pfad)
                : AusVorschau(pfad, Daten.Vorschau(pfad)));

        IReadOnlyList<Paketkopf> folge = ProjektExportImportCtrl.Reihenfolge(koepfe);

        var gesehen = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);
        for (int i = 0; i < folge.Count; i++)
        {
            Paketkopf k = folge[i];
            var hinweise = new List<string>();

            if (!string.IsNullOrEmpty(k.Fehler)) hinweise.Add(k.Fehler);
            if (!string.IsNullOrEmpty(k.StammQuelle))
                hinweise.Add(string.Format(Texte.PaketStammAus, k.StammQuelle));

            // Derselbe Stamm wie ein FRUEHERES Paket des Laufs: Er entsteht einmal.
            if (!string.IsNullOrEmpty(k.Quellprojekt)
                && gesehen.TryGetValue(k.Quellprojekt, out int vorher))
                hinweise.Add(string.Format(Texte.PaketDublette, vorher + 1));
            else if (!string.IsNullOrEmpty(k.Quellprojekt))
                gesehen[k.Quellprojekt] = i;

            bool schemaPasst = k.Schemastand == 0 || k.Schemastand == SchemaStand.Zielversion;

            _pakete.Add(new Paketzeile(
                k.Datei,
                Dateiname(k.Datei),
                k.Quellprojekt,
                string.Join(", ", k.Varianten),
                string.Format(schemaPasst ? Texte.PaketSchemaOk : Texte.PaketSchemaAlt, k.Schemastand),
                string.Join(" \u00b7 ", hinweise)));
        }

        // EIN Paket: der Einzelweg samt Zielnamensvorschlag bleibt, wie er war.
        if (_pakete.Count == 1) PaketGewaehlt(_pakete[0].Pfad);
    }

    /// <summary>Aus einer Vorschau einen Kopf machen — der Rückfall ohne Kopfdelegat.</summary>
    private static Paketkopf AusVorschau(string pfad, PaketVorschau v)
        => new Paketkopf(pfad, v.Quellprojekt, v.Exportdatum, v.Schemastand, 0,
                         v.Varianten, v.StammQuelle, v.Fehler);

    private static string Dateiname(string pfad)
    {
        if (string.IsNullOrEmpty(pfad)) return "";
        int i = pfad.LastIndexOfAny(new[] { '/', '\\' });
        return i >= 0 && i < pfad.Length - 1 ? pfad.Substring(i + 1) : pfad;
    }

    private Task Importieren()
    {
        if (Daten is null) return Task.CompletedTask;

        if (string.IsNullOrEmpty(_paketpfad) && _pakete.Count == 0)
        { Melden(MeldungDateiWaehlen, WarnStufe.Warnung); return Task.CompletedTask; }

        // Die Ueberschreiben-Rueckfrage kommt VOR der Sicherung - dieselbe
        // Reihenfolge wie im Vorlaeufer.
        if (_modus == ProjektExportImportCtrl.BeiVorhandenem.Ueberschreiben)
        {
            _frage = Frageart.Ueberschreiben;
            return Task.CompletedTask;
        }
        return SicherungUndImport();
    }

    private async Task BeiFrage(bool? antwort)
    {
        Frageart war = _frage;
        _frage = Frageart.Keine;

        if (antwort != true) return;                       // "Nein" bricht ab

        if (war == Frageart.Ueberschreiben) await SicherungUndImport();
        else if (war == Frageart.Sicherung) await Lauf();
    }

    private async Task SicherungUndImport()
    {
        if (Daten?.SicherungAnlegen is not null && _sicherung)
        {
            try
            {
                string pfad = Daten.SicherungAnlegen();
                Melden(string.Format(StatusSicherung, pfad), WarnStufe.Hinweis);
            }
            catch (Exception ex)
            {
                _fragegrund = ex.Message;
                _frage = Frageart.Sicherung;               // "Trotzdem importieren?"
                return;
            }
        }
        await Lauf();
    }

    /// <summary>
    /// Ein Paket oder mehrere? MEHRERE laufen in EINEM Zug mit einer
    /// Namensabbildung ueber den ganzen Lauf — das ist der Grund des Auftrags.
    /// </summary>
    private Task Lauf()
        => _pakete.Count > 1 && Daten?.ImportierenMehrere is not null
           ? SammelImport()
           : ImportLauf();

    /// <summary>
    /// <b>Mehrere Pakete in EINEM Lauf.</b> Die Sicherungskopie ist vorher genau
    /// einmal gefallen (<see cref="SicherungUndImport"/>), nicht je Paket — sie
    /// sichert den Stand VOR dem Lauf, und den gibt es nur einmal.
    /// </summary>
    private async Task SammelImport()
    {
        if (Daten?.ImportierenMehrere is null) return;

        IReadOnlyList<string> pfade = _pakete.Select(z => z.Pfad).ToList();
        ProjektExportImportCtrl.BeiVorhandenem modus = _modus;

        _laeuft = true;
        _anteil = null;
        _bericht.Clear();
        StateHasChanged();

        var melder = new Progress<ImportFortschritt>(BeiLauf);
        SammelImportBilanz bilanz = await Kulturweitergabe.Starten(
            () => Daten.ImportierenMehrere(pfade, modus, melder));

        _laeuft = false;
        _anteil = null;

        var zeilen = new List<string>();
        foreach (SammelImportZeile z in bilanz.Zeilen)
        {
            zeilen.Add(Dateiname(z.Datei) + (string.IsNullOrEmpty(z.Grund) ? "" : ": " + z.Grund));
            foreach (string b in z.Bericht) zeilen.Add("    " + b);
        }
        _bericht = zeilen;
        _importErfolgreich = bilanz.EtwasGeschrieben;

        Melden(string.Format(Texte.BilanzImport, bilanz.Importiert, bilanz.Pakete,
                             bilanz.Uebersprungen, bilanz.Umbenannt, bilanz.Fehler),
               bilanz.Fehler > 0 ? WarnStufe.Warnung : WarnStufe.Hinweis);

        // T4/TF5: EIN Sammelbericht, neben dem ERSTEN Paket - nicht je Paket.
        if (Daten.BerichtSchreiben is not null && _bericht.Count > 0 && _pakete.Count > 0)
        {
            string? abgelegt = Daten.BerichtSchreiben(_pakete[0].Pfad,
                                                      string.Join(Environment.NewLine, _bericht));
            if (!string.IsNullOrEmpty(abgelegt))
                _status += "  " + string.Format(StatusBericht, abgelegt);
        }
    }

    private async Task ImportLauf()
    {
        if (Daten is null) return;

        string? name = string.IsNullOrWhiteSpace(_zielname) ? null : _zielname.Trim();

        _laeuft = true;
        _anteil = null;
        _bericht.Clear();
        StateHasChanged();

        // Progress<T> stellt jede Meldung in den Synchronisationskontext EIN und
        // liefert sie spaeter aus. Eine Meldung, die der Kern unmittelbar vor seinem
        // Ende absetzt, kann deshalb NACH der Fortsetzung hinter dem await ankommen
        // und die Abschlussmeldung ueberschreiben - dann stuende bis zum naechsten
        // Zeichnen ein Fortschrittstext in der Statuszeile (Kern-Lauf 33883408900,
        // ProjektTransferDialogTests: "... Tab_Projekt" statt "Export abgeschlossen.").
        // Nach dem Lauf werden Fortschrittsmeldungen deshalb verworfen.
        var melder = new Progress<string>(t => { if (!_laeuft) return; _status = t; StateHasChanged(); });
        ImportErgebnis e = await Kulturweitergabe.Starten(() => Daten.Importieren(_paketpfad, name ?? "", _modus, melder));

        _laeuft = false;

        if (e.Id <= 0)
        {
            Melden(string.Format(MeldungImportFehler,
                       string.IsNullOrEmpty(e.Fehler) ? MeldungUnbekannt : e.Fehler), WarnStufe.Fehler);
            return;
        }

        _importErfolgreich = true;
        _bericht = new List<string>(e.Bericht);
        _status = StatusImportOk;
        _statusStufe = WarnStufe.Hinweis;

        // T4/TF5: den Bericht ablegen - WOHIN, entscheidet die Huelle (A-11).
        if (Daten.BerichtSchreiben is not null && _bericht.Count > 0)
        {
            string? abgelegt = Daten.BerichtSchreiben(_paketpfad, string.Join(Environment.NewLine, _bericht));
            if (!string.IsNullOrEmpty(abgelegt))
                _status += "  " + string.Format(StatusBericht, abgelegt);
        }
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _status = text;
        _statusStufe = stufe;
    }

    private Task BeiErgebnis(bool ok) => Schliessen();

    private Task Schliessen()
    {
        if (_laeuft) return Task.CompletedTask;
        return Geschlossen.InvokeAsync(_importErfolgreich);
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (_frage != Frageart.Keine || _laeuft) return Task.CompletedTask;
        return e.Key == "Escape" ? Schliessen() : Task.CompletedTask;
    }
}
