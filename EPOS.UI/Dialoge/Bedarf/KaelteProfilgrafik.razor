@* KBP-3b (Konzept Kaeltebedarfsprofile 5): die Grafik der markierten Kaeltezeile in der Bearbeiten-Ueberlagerung des
   BedarfsProfileDialog - die Kennzahlenzeile (Jahressumme, Spitze, Vollbenutzungsstunden, Grundlast-Anteil) ueber den
   vier Blaettern Jahresgang, Monate, Woche und Dauerlinie. NUR ANZEIGE: Kennzahlen und Zeichenmodelle rechnet der Kern
   (Kaelteprofilgrafik), der Wirt reicht sie herein; jedes Bild steht in DiagrammSvg und wird dort nach der
   Oberflaechenregel gezeigt (Jahresgang mit Tagesband und der Wahl „Datum | Stunde im Jahr“, Monate als Stapel je Zeile,
   Dauerlinie ohne Zeitachse). Die Modelle bleiben je Rechenstand dieselben Referenzen (Zwischenspeicher des Wirts). *@
@using System.Globalization
@using WindowsFormsApplication1

<div class="epos-kbp-grafik" data-kbp="grafik">
    @if (Bilder is null)
    {
        <p class="epos-leisezeile">@Resource.KBP_GRAFIK_OHNE</p>
    }
    else
    {
        <div class="epos-kbp-kennzahlen" role="group" aria-label="@Resource.KBP_GRAFIK_GRUPPE">
            <Kennzahlkachel Titel="@Resource.KBP_KZ_SUMME" Wert="@Zahl(Bilder.Kennzahlen.JahressummeMwh, "N2", "MWh/a")" />
            <Kennzahlkachel Titel="@Resource.KBP_KZ_SPITZE" Wert="@Zahl(Bilder.Kennzahlen.SpitzeKw, "N1", "kW")" />
            <Kennzahlkachel Titel="@Resource.KBP_KZ_VBH" Wert="@Zahl(Bilder.Kennzahlen.VollbenutzungsstundenH, "N0", "h/a")" />
            <Kennzahlkachel Titel="@Resource.KBP_KZ_GRUNDLAST" Wert="@Zahl(Bilder.Kennzahlen.GrundlastAnteilProzent, "N1", "%")" />
        </div>

        <Reiter Aktiv="@_reiter" AktivChanged="r => _reiter = r" Bezeichnung="@Resource.KBP_GRAFIK_GRUPPE" Kennung="kbp-grafik">
            <KindInhalt>
                <Reiterblatt Schluessel="@REITER_JAHR" Titel="@Resource.KBP_REITER_JAHRESGANG">
                    <KindInhalt>
                        <DiagrammSvg Modell="@Bilder.Jahresgang" Kennung="kbp-jahresgang" Bezeichnung="@Resource.KBP_TITEL_JAHRESGANG" />
                    </KindInhalt>
                </Reiterblatt>
                <Reiterblatt Schluessel="@REITER_MONATE" Titel="@Resource.KBP_REITER_MONATE">
                    <KindInhalt>
                        <DiagrammSvg Modell="@Bilder.Monate" Kennung="kbp-monate" Bezeichnung="@Resource.KBP_TITEL_MONATE" />
                    </KindInhalt>
                </Reiterblatt>
                <Reiterblatt Schluessel="@REITER_WOCHE" Titel="@Resource.KBP_REITER_WOCHE">
                    <KindInhalt>
                        <DiagrammSvg Modell="@Bilder.Woche" Kennung="kbp-woche" Bezeichnung="@Resource.KBP_TITEL_WOCHE" />
                    </KindInhalt>
                </Reiterblatt>
                <Reiterblatt Schluessel="@REITER_DAUER" Titel="@Resource.KBP_REITER_DAUERLINIE">
                    <KindInhalt>
                        <DiagrammSvg Modell="@Bilder.Dauerlinie" Kennung="kbp-dauerlinie" Bezeichnung="@Resource.KBP_TITEL_DAUERLINIE" />
                    </KindInhalt>
                </Reiterblatt>
            </KindInhalt>
        </Reiter>
        <Herleitungszeile Text="@Resource.KBP_GRAFIK_HERLEITUNG" />
    }
</div>

@code {
    /// <summary>Schlüssel des Blatts Jahresgang.</summary>
    public const string REITER_JAHR = "jahresgang";

    /// <summary>Schlüssel des Blatts Monate.</summary>
    public const string REITER_MONATE = "monate";

    /// <summary>Schlüssel des Blatts Woche.</summary>
    public const string REITER_WOCHE = "woche";

    /// <summary>Schlüssel des Blatts Dauerlinie.</summary>
    public const string REITER_DAUER = "dauerlinie";

    /// <summary>Kennzahlen und Bilder der markierten Zeile aus dem Kern; <c>null</c> = kein Profil.</summary>
    [Parameter] public Kaelteprofilbilder? Bilder { get; set; }

    private string _reiter = REITER_JAHR;

    /// <summary>Das gewählte Blatt — Prüfhilfe für die Tests.</summary>
    public string AktivesBlatt => _reiter;

    private static string Zahl(double wert, string format, string einheit)
        => wert.ToString(format, CultureInfo.CurrentCulture) + " " + einheit;
}
