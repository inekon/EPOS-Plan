    /// <summary>Liest den Katalog neu — nach einem Schreibweg. Der Filter ruft sie nicht.</summary>
    private void KatalogNeuLaden()
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, TitelText, out _listeFehler);
        VerwendungStempeln();
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
    }

    /// <summary>Die Spalte „im Projekt verwendet" (Q12) — EINMAL für die ganze Liste.</summary>
    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _detail = Katalogladung.Satz(() => ProjektDetail is not null ? ProjektDetail(zeile) : null,
                                     zeile.Bezeichner, out _satzFehler) ?? Leer(zeile.Bezeichner);
        KostenNachziehen();
        FelderNachziehen();
    }

    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _projektZeile = null;
        _detail = Katalogladung.Satz(() => KatalogDetail is not null ? KatalogDetail(_katalogGewaehlt) : null,
                                     _katalogGewaehlt, out _satzFehler) ?? Leer(_katalogGewaehlt);
        FelderNachziehen();
    }

    private static ErzeugerDetail Leer(string name)
        => new(name, "", Array.Empty<(string, string)>());

    // =================================================================================
    // Hinzufuegen und Entfernen - je Klick und je angekreuztem Satz eine EIGENE Zeile (AP2b)
    // =================================================================================

    private void BeiHinzu()
    {
        if (Aufnehmen is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        foreach (Katalogfilterzeile z in ziele)
        {
            AufnahmeErgebnis aufnahme = Aufnehmen(z.Id);
            if (!string.IsNullOrEmpty(aufnahme.Meldung)) Melden(aufnahme.Meldung, aufnahme.Fehler);
            if (aufnahme.Zeile is null) continue;
            Zeilen.Add(aufnahme.Zeile);
            ProjektZeileWaehlen(aufnahme.Zeile);
        }
        VerwendungStempeln();                 // Q12
        SummeNachziehen();
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
    }

    /// <summary>„▶": Die GEWÄHLTEN Zeilen gehen. Bleibt nichts übrig, wandert die Auswahl in den Katalog.</summary>
    private void BeiEntfernen()
    {
        List<ErzeugerZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;
        foreach (ErzeugerZeile zeile in ziele)
        {
            Zeilen.Remove(zeile);
            Entfernen?.Invoke(zeile);
        }
        VerwendungStempeln();                 // Q12
        _projektWahl.Leeren();
        _projektZeile = null;
        _detail = Leer("");
        SummeNachziehen();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
        else if (_katalog.Count > 0) KatalogZeileWaehlen(_katalog[0].Bezeichner);
    }

    /// <summary>ET‑5: Trägerwechsel der markierten Anlage — an die Hülle, dann in die Zeile.</summary>
    private void BeiTraegerwechsel(int? neu)
    {
        if (_projektZeile is null || !neu.HasValue) return;
        if (neu.Value == _projektZeile.CarrierId) return;   // programmatische Vorwahl
        TraegerWechseln?.Invoke(_projektZeile, neu.Value);
        _projektZeile.CarrierId = neu.Value;
    }

