    /// <summary>
    /// „▲ In das Projekt übernehmen" (auch Doppelklick und Enter, KA‑E‑6): für jeden gewählten
    /// Katalogsatz erst die Trägerwahl, dann die Aufnahme. Die Trägerwahl fragt je Brennstoffgruppe
    /// EINMAL (4.5) — weitere Sätze derselben Gruppe nehmen dieselbe Antwort.
    /// </summary>
    private void BeiHinzu()
    {
        if (Vorbereiten is null || TraegerGaben is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        _aufnahmen.Clear();
        _traegerJeGruppe.Clear();
        foreach (Katalogfilterzeile z in ziele) _aufnahmen.Enqueue(z.Id);
        NaechsteAufnahme();
    }

    private readonly Queue<int> _aufnahmen = new();
    private readonly Dictionary<string, EnergietraegerVarianteErgebnis> _traegerJeGruppe = new(StringComparer.Ordinal);
    private int _aufnahmeId;
    private string _aufnahmeGruppe = "";

    private void NaechsteAufnahme()
    {
        while (_aufnahmen.Count > 0)
        {
            int id = _aufnahmen.Dequeue();
            TraegerVorbereitung vor = Vorbereiten!(id);
            if (!string.IsNullOrEmpty(vor.Meldung))
            {
                Melden(vor.Meldung, true);
                continue;
            }
            string gruppe = string.Join(",", vor.Energietraeger.Select(e => e.Id));
            if (_traegerJeGruppe.TryGetValue(gruppe, out EnergietraegerVarianteErgebnis? bekannt))
            {
                Aufnahme(id, bekannt);
                continue;
            }
            _aufnahmeId = id;
            _aufnahmeGruppe = gruppe;
            _traegerGaben = TraegerGaben!(vor);
            return;
        }
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
    }

    /// <summary>
    /// Der Traegerdialog ist zu. <c>null</c> = abgebrochen, und dann wird KEIN Kessel
    /// aufgenommen - kein verwaister Eintrag mit ID_Carrier = 0; die uebrigen Saetze der
    /// Sammeluebernahme entfallen mit.
    /// </summary>
    private void TraegerFertig(EnergietraegerVarianteErgebnis? ergebnis)
    {
        _traegerGaben = null;
        if (ergebnis is null || Aufnehmen is null)
        {
            _aufnahmen.Clear();
            return;
        }
        _traegerJeGruppe[_aufnahmeGruppe] = ergebnis;
        Aufnahme(_aufnahmeId, ergebnis);
        NaechsteAufnahme();
    }

    private void Aufnahme(int stammId, EnergietraegerVarianteErgebnis ergebnis)
    {
        if (Aufnehmen is null) return;
        AufnahmeErgebnis aufnahme = Aufnehmen(stammId, ergebnis);
        if (!string.IsNullOrEmpty(aufnahme.Meldung)) Melden(aufnahme.Meldung, aufnahme.Fehler);
        if (aufnahme.Zeile is null) return;
        Zeilen.Add(aufnahme.Zeile);
        VerwendungStempeln();                 // Q12: die neue Zeile steht jetzt auf "Ja"
        ProjektZeileWaehlen(aufnahme.Zeile);
        SummeNachziehen();
    }

    /// <summary>
    /// „▼ Aus dem Projekt entfernen" (auch Entf): die gewaehlten Zeilen verschwinden. Ob die
    /// Projektkopie mit einer Zeile geht, entscheidet die Huelle - nur wenn keine zweite Zeile
    /// mehr darauf verweist.
    /// </summary>
    private void BeiEntfernen()
    {
        List<ErzeugerZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;
        foreach (ErzeugerZeile zeile in ziele)
        {
            Zeilen.Remove(zeile);
            Entfernen?.Invoke(zeile);
        }
        VerwendungStempeln();                 // Q12: die Zeilen stehen jetzt auf "Nein"
        _projektWahl.Leeren();
        _projektZeile = null;
        _detail = Leer("");
        _varianten = Array.Empty<(int, string)>();
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
        SummeNachziehen();
    }

