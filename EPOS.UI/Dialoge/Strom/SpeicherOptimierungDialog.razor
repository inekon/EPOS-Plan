@* Die AUSLEGUNGSOPTIMIERUNG des Stromspeichers (W11b‑B‑5, Windows-Abnahme V2
   vom 07.09.2026).

   VORBILD UND ABLOESUNG. WindowsFormsApplication1/Views/Stromspeicher/
   Form_SpeicherOptimierung.cs (1 325 Zeilen) — die LETZTE WinForms-Fachmaske
   des Programms. Der Anwender hat sie mit zwei Befunden zurueckgegeben:
   „Texte ueberschneiden sich" und „Dialog stuerzt nach kurzer Zeit ab". Nach
   der Arbeitsregel iZ5 wird ein anzufassender Dialog eine Razor-Komponente und
   seine WinForms-Fassung faellt im selben Schritt.

   BEFUND 1 — DIE UEBERSCHNEIDUNG. In der abgeloesten Maske lagen zwei Labels
   derselben Zeile uebereinander: lbl_Aktuell auf x = 14…414 und der Erklaertext
   zur Zielfunktion (hinweisZiel) auf x = 310…1140, beide bei y = 108
   (Form_SpeicherOptimierung.cs:247-259). Der Erklaertext ragte zudem 8
   Bildpunkte ueber die GroupBox hinaus (Hoehe 132) und war unten abgeschnitten.
   Hier steht er als HERLEITUNGSZEILE unter der Gruppe — ueber die volle Breite,
   umbrechend, und damit weder ueber noch unter einem anderen Text.

   BEFUND 2 — DER ABSTURZ. Die Maske zeichnete Heatmap und Schnittkurve mit
   ScottPlot.WinForms und haengte dabei bei JEDEM Lauf ueber Plot.Add.ColorBar
   eine weitere Farbskala an denselben Plot (:851). Plot.Clear() raeumt
   Plottables, aber KEINE Panels; die Zeichenflaeche schrumpfte deshalb je Lauf
   um rund 78 Bildpunkte und war ab dem achten Lauf null. Dazu kam, dass ein
   nicht endlicher Rasterwert ScottPlot erst beim RENDERN zu Fall bringt
   („min must be a real number") — also im Anstrich des Steuerelements und damit
   unfangbar. Beides ist hier strukturell weg: Die Bilder kommen als fertige PNG
   aus dem Kern (ChartRenderer), es gibt keinen Zeichenzustand, der sich
   ansammeln koennte, und SpeicherOptimierungCtrl.Rechnen wirft nicht, sondern
   meldet.

   DER FORTSCHRITT IST GEDROSSELT. Die Engine meldet je Rasterpunkt aus ihrem
   Parallel.For heraus — 120 Punkte in 0,3 s sind 400 Meldungen je Sekunde.
   SpeicherOptimierungCtrl leitet hoechstens jede zehnte und hoechstens alle
   100 ms weiter; hier kommt also schon wenig an, und was ankommt, laeuft ueber
   InvokeAsync in den Bedienfaden.

   WAS ER NICHT TUT. Er rechnet die Simulation nicht neu, wenn der Bestpunkt
   uebernommen wird — das entscheidet der Anwender (woertlich wie im
   Vorlaeufer). Die Rueckfrage sagt es. *@

@namespace EPOS.UI.Dialoge.Strom
@using WindowsFormsApplication1
@using SpeicherEngine

<div class="epos-speicheropt">

    <div class="epos-simerg-kopf">
        <span class="epos-simerg-titel">@Resource.OPT_TITEL</span>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
    </div>

    @* ---------------------------------------------------------- Suchraum

       KOMPAKTER (Befund W11b-B-25, Windows-Abnahme 09.09.2026: „Dialog
       uebersichtlicher"). Der Formularraster stand auf der Hausvorgabe
       auto-fill und ergab auf breitem Schirm zwei Spalten mit einer leeren
       dritten Spaltenbreite dahinter; .epos-speicheropt-suchraum stellt ihn auf
       DREI Spalten und engere Zeilen. Die Feldbausteine bleiben unveraendert -
       die Enge kommt aus dem Stilblatt, nicht aus neuen Feldern. *@
    <div class="epos-speicheropt-suchraum">
    <Formularraster>
        <KindInhalt>
            <Formulargruppe Titel="@Resource.OPT_GRP_SUCHRAUM">
                <KindInhalt>
                    <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_CMIN" Wert="@_eingaben.CMinKwh"
                                Aktiv="@(!_laeuft)" Min="0"
                                WertChanged="@(w => Setzen(v => _eingaben.CMinKwh = v, w))" />

                    <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_CMAX" Wert="@_eingaben.CMaxKwh"
                                Aktiv="@(!_laeuft)" Min="0"
                                WertChanged="@(w => Setzen(v => _eingaben.CMaxKwh = v, w))" />

                    <Ganzzahlfeld Bezeichnung="@Resource.OPT_LBL_STUETZSTELLEN"
                                  Wert="@_eingaben.Stuetzstellen" Aktiv="@(!_laeuft)"
                                  Min="@SpeicherOptimierungCtrl.STUETZSTELLEN_MIN"
                                  Max="@SpeicherOptimierungCtrl.STUETZSTELLEN_MAX"
                                  WertChanged="@(w => SetzenGanz(v => _eingaben.Stuetzstellen = v, w))" />

                    <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_RMIN" Wert="@_eingaben.RMin"
                                Aktiv="@(!_laeuft)" Min="0"
                                WertChanged="@(w => Setzen(v => _eingaben.RMin = v, w))" />

                    <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_RMAX" Wert="@_eingaben.RMax"
                                Aktiv="@(!_laeuft)" Min="0"
                                WertChanged="@(w => Setzen(v => _eingaben.RMax = v, w))" />

                    <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_RSCHRITT" Wert="@_eingaben.RSchritt"
                                Aktiv="@(!_laeuft)" Min="0"
                                WertChanged="@(w => Setzen(v => _eingaben.RSchritt = v, w))" />

                    <Auswahlfeld Bezeichnung="@Resource.OPT_LBL_STRATEGIE"
                                 Eintraege="@STRATEGIEN" Auswahl="@((int)_eingaben.Strategie)"
                                 Aktiv="@(!_laeuft)" AuswahlChanged="StrategieGewaehlt" />

                    <Schalter Bezeichnung="@Resource.OPT_CHK_FEINRASTER" Wert="@_eingaben.Feinraster"
                              Aktiv="@(!_laeuft)"
                              WertChanged="@(w => { _eingaben.Feinraster = w; Nachrechnen(); })" />

                    <Schalter Bezeichnung="@Resource.OPT_CHK_KVER" Wert="@_eingaben.KVerInZielfunktion"
                              Aktiv="@(!_laeuft)"
                              WertChanged="@(w => { _eingaben.KVerInZielfunktion = w; Nachrechnen(); })" />
                </KindInhalt>
            </Formulargruppe>
        </KindInhalt>
    </Formularraster>
    </div>

    @* DER LEISTUNGSPREIS - nur bei der Lastspitzenkappung (Anwenderentscheid
       W11b-E-3, 10.09.2026: „Lastspitzenkappung — Leistungspreis in Maske und
       alternativ aus Leistungspreis Tarifstruktur/Energietraeger Strom
       (Uebernahme in die Maske als Auswahl)").

       Er steht in einer EIGENEN Zeile und nicht zwischen den Achsen: Er gehoert
       nicht zum Suchraum, sondern zur Bewertung - und er erscheint nur, wo er
       etwas bewirkt. Bei Dauer- und Nachtnutzung waere er ein Feld ohne Wirkung.

       Das Feld schreibt SOFORT in L_P der aktiven Variante (Muster
       ParameterReiter) - dieselbe Pflegestelle wie der Reiter „Parameter" und
       die Peak-Shaving-Maske. Ohne Schreibdelegat bleibt es Anzeige: „Kein
       Delegat ist kein Knopf".

       Die Klappliste bietet NUR gepflegte Quellen an; eine Liste mit Nullen
       waere keine Auswahl, sondern eine Falle. *@
    @if (Kappung)
    {
        <div class="epos-speicheropt-suchraum">
        <Formularraster>
            <KindInhalt>
                <Formulargruppe Titel="@Resource.SP_BERECHNUNG_ANZEIGE_LASTSPITZENKAPPUNG">
                    <KindInhalt>
                        <Zahlenfeld Bezeichnung="@Resource.OPT_LBL_LEISTUNGSPREIS"
                                    Einheit="€/(kW·a)" Min="0"
                                    Wert="@_eingaben.LeistungspreisEurProKwA"
                                    Aktiv="@(!_laeuft && LeistungspreisSchreiben.HasDelegate)"
                                    WertChanged="LeistungspreisGesetzt" />

                        @if (_quellen.Count > 0)
                        {
                            <Auswahlfeld Bezeichnung="@Resource.OPT_LBL_LP_QUELLE"
                                         Eintraege="@Quellenliste" Auswahl="@_quelle"
                                         Platzhalter="@Resource.OPT_LBL_LP_QUELLE"
                                         Aktiv="@(!_laeuft && LeistungspreisSchreiben.HasDelegate)"
                                         AuswahlChanged="QuelleGewaehlt" />
                        }
                    </KindInhalt>
                </Formulargruppe>
            </KindInhalt>
        </Formularraster>
        </div>
    }

    @* DIE ERKLAERUNG STEHT UNTER DER GRUPPE, nicht neben der Klappliste — genau
       das war Befund 1 der Abnahme V2. Seit W11b-B-25 ist es EINE Zeile statt
       zweier: Suchraumregel und Zielfunktion sind ein Gedanke, und zwei
       untereinander stehende Erklaerbaender waren genau der Leerraum, den der
       Anwender beanstandet hat. Die Zielfunktion wechselt mit der
       Berechnungsart. *@
    <Herleitungszeile Text="@Herleitung" />

    @if (_eingaben.KVerInZielfunktion)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@Resource.OPT_HINWEIS_KVER" />
    }

    <p class="epos-speicheropt-zeile">
        @if (!string.IsNullOrEmpty(_aktuelleAuslegung))
        {
            <span class="epos-speicheropt-aktuell">@_aktuelleAuslegung</span>
        }
        <span class="epos-speicheropt-punkte">@Punktetext</span>
    </p>

    @* ---------------------------------------------------------- Aktionen *@
    <div class="epos-speicheropt-leiste">
        <button type="button" class="epos-simerg-knopf" @onclick="Starten"
                disabled="@(_laeuft || !LaufMoeglich)">@Resource.OPT_BTN_START</button>

        <Fortschritt Sichtbar="@_laeuft" Anteil="@_anteil" Text="@_fortschrittText"
                     Abbrechen="@(Abbrechen.HasDelegate ? Abbrechen : (EventCallback?)null)"
                     AbbrechenText="@Resource.OPT_BTN_ABBRUCH" />
    </div>

    @if (!string.IsNullOrEmpty(_fehler))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" />
    }

    @* Die Meldung der Huelle - „Die Auslegung wurde uebernommen" ist ein ERFOLG und
       gehoert nicht in ein rotes Band; „konnte nicht geschrieben werden" schon. *@
    @if (!string.IsNullOrEmpty(Meldung))
    {
        <Warnbanner Stufe="@(MeldungErfolg ? WarnStufe.Erfolg : WarnStufe.Fehler)" Text="@Meldung" />
    }

    @if (_ergebnis is not null && _ergebnis.Erfolg)
    {
        <p class="epos-simerg-status">@_ergebnis.Statuszeile</p>

        @foreach (string hinweis in _ergebnis.Hinweise)
        {
            <Warnbanner Stufe="WarnStufe.Warnung" Text="@hinweis" />
        }

        @* HEATMAP UND SCHNITTKURVE NEBENEINANDER, mit gedeckelter Hoehe
           (Befund W11b-B-25: „Grafik zu gross", „Dialog uebersichtlicher").
           Die Kurve ist der SCHNITT DURCH die Karte - untereinander schob die
           Karte sie aus dem sichtbaren Bereich, und der Anwender sah nie beide
           zugleich. Gedeckelt ist die ANZEIGE (max. 320 px hoch), nicht das
           PNG: Die Zeichenmasse bleiben 860 x 560 und 720 x 460, sonst waere
           auch das Gezoomte grob. Den Zoom bringt ChartBild mit (Hausregel
           A-1). *@
        <div class="epos-speicheropt-diagramme">
            <ChartBild Png="@_ergebnis.RasterBild" Alt="@Resource.OPT_CHART_HEATMAP_TITEL" />
            <ChartBild Png="@_ergebnis.SchnittBild" Alt="@_ergebnis.SchnittTitel" />
        </div>

        @* DAS EINE BILD „LASTGANG UND SPEICHERBETRIEB" (Befund W11b-B-25,
           Windows-Abnahme 09.09.2026: „Lastgang und Speicherung in einer
           Grafik").

           Es zeigt, was der BESTPUNKT tatsaechlich tut: Netzbezug ohne und mit
           Speicher, bei der Lastspitzenkappung die erreichte Schwelle, dazu die
           Speicherleistung mit Vorzeichen. Alles in kW und auf EINER Achse -
           die Frage „um wie viel senkt der Speicher die Spitze" ist nur so zu
           lesen.

           Vorgabe ist die Woche um die Jahresspitze; ein Jahr im
           Viertelstundenraster legte 40 Werte auf einen Bildpunkt und zeigte
           keinen einzigen Zyklus. Umschalter, Reihenwahl und Datenzoom
           erscheinen nur MIT Neuzeichnen-Delegat („Kein Delegat ist kein
           Knopf"); ohne ihn bleibt das Bild des Laufs stehen. *@
        @if (_betriebBild is { Length: > 0 })
        {
            <section class="epos-simerg-block epos-speicheropt-betrieb">
                @if (Betrieb is null)
                {
                    <ChartBild Png="@_betriebBild" Alt="@_betriebTitel" />
                }
                else
                {
                    @* DIE SCHALTER STEHEN UEBER DEM BILD - Hausregel der Ergebnisseite
                       (Doku_Simulationsergebnis_Darstellung.md, 5): erst die
                       Darstellungsart, dann je Reihe ein Schalter, dann das Bild. *@
                    <div class="epos-simerg-schalter">
                        <Schalter Bezeichnung="@Resource.OPT_BETRIEB_CHK_JAHR" Wert="@_betriebJahr"
                                  WertChanged="BetriebJahrGesetzt" />
                    </div>

                    <div class="epos-simerg-schalter">
                        @foreach (var reihe in Betriebsreihen)
                        {
                            string schluessel = reihe.Schluessel;
                            <Schalter Bezeichnung="@reihe.Text" Wert="@ReiheAn(schluessel)"
                                      WertChanged="@(w => BetriebsreiheGesetzt(schluessel, w))" />
                        }
                    </div>

                    <ChartBild Png="@_betriebBild" Alt="@_betriebTitel"
                               BereichGewaehlt="BetriebBereich" Zurueckgesetzt="BetriebBereichZurueck" />
                }
            </section>
        }

        @* DIE KENNZAHLEN ALS WERTELISTEN (dl.epos-simerg-werte) statt als eine
           lange Tabelle - dieselbe Sprache wie auf allen Reitern der
           Ergebnisseite. Die Tabelle trug drei Spaltenkoepfe und je Gruppe eine
           eigene Kopfzeile; die Wertelisten stehen NEBENEINANDER und brauchen
           damit ein Drittel der Hoehe. Eine Gruppe ohne Zeilen entfaellt ganz -
           die Gruppe „Lastspitzenkappung" gibt es nur bei dieser
           Berechnungsart. *@
        <div class="epos-simerg-spalten">
            @foreach (string gruppe in GRUPPEN)
            {
                string g = gruppe;
                if (!Zeilen(g).Any()) { continue; }

                <section class="epos-simerg-block">
                    <Gruppenkopf Titel="@Gruppentitel(g)" />
                    <dl class="epos-simerg-werte">
                        @foreach (SpeicherOptimierungKennzahl z in Zeilen(g))
                        {
                            <dt>@z.Bezeichnung</dt>
                            <dd class="@(z.Negativ ? "epos-simerg-warn" : null)">@z.Wert</dd>
                            <dd class="epos-simerg-einheit">@z.Einheit</dd>
                        }
                    </dl>
                </section>
            }
        </div>
    }

    <div class="epos-simerg-fuss">
        <button type="button" @onclick="UebernehmenFragen"
                disabled="@(_laeuft || !ErgebnisDa || !Uebernehmen.HasDelegate)">
            @Resource.OPT_BTN_UEBERNEHMEN
        </button>

        @if (Csv.HasDelegate)
        {
            <button type="button" @onclick="CsvSchreiben" disabled="@(_laeuft || !ErgebnisDa)">
                @Resource.OPT_BTN_CSV
            </button>
        }

        <button type="button" @onclick="Geschlossen" disabled="@_laeuft">
            @Resource.OPT_BTN_SCHLIESSEN
        </button>
    </div>

    <Rueckfrage Offen="@_frage" TitelText="@Resource.OPT_TITEL" Frage="@_frageText"
                Beantwortet="FrageBeantwortet" />

</div>

@code {
    /// <summary>
    /// Die zwei Betriebsstrategien als Eintraege der Klappliste. Die Id ist der
    /// Zahlenwert von <see cref="OptimiererStrategie"/> — Anzeigetext und Steuerwert
    /// bleiben getrennt (dieselbe Trennung, die der StrategieEintrag der abgeloesten
    /// Maske von Hand baute).
    /// </summary>
    private static readonly IReadOnlyList<(int Id, string Text)> STRATEGIEN =
        SpeicherOptimierungCtrl.Strategien()
            .Select((text, i) => (Id: i, Text: text))
            .ToList();

    private static readonly string[] GRUPPEN =
    {
        SpeicherOptimierungCtrl.GRUPPE_AUSLEGUNG,
        SpeicherOptimierungCtrl.GRUPPE_WIRTSCHAFT,
        SpeicherOptimierungCtrl.GRUPPE_SPEICHER,
        SpeicherOptimierungCtrl.GRUPPE_KAPPUNG
    };

    // =====================================================================
    // Parameter
    // =====================================================================

    /// <summary>
    /// Die Vorbelegung des Suchraums samt der aktuellen Auslegung. Ohne Delegat
    /// steht der Vorschlag des Fachkonzepts da (500 … 5.000 kWh).
    /// </summary>
    [Parameter] public Func<SpeicherOptimierungVorgaben>? Vorgaben { get; set; }

    /// <summary>
    /// Rechnet die Rastersuche im Hintergrund. <c>melder</c> bekommt Anteil und Text;
    /// OHNE Delegat bleibt der Startknopf gesperrt — die Rastersuche braucht Lastgang
    /// und Erzeugungsreihen eines gelaufenen Durchgangs.
    /// </summary>
    [Parameter]
    public Func<SpeicherOptimierungEingaben, Action<double?, string>,
                Task<SpeicherOptimierungErgebnis>>? Rechnen { get; set; }

    /// <summary>Bricht einen laufenden Suchlauf ab; ohne Rueckruf kein Knopf.</summary>
    [Parameter] public EventCallback Abbrechen { get; set; }

    /// <summary>
    /// Uebernimmt Kapazitaet und Leistung des Bestpunkts in die Geraetedaten
    /// (kWh, kW). Ohne Rueckruf ist der Knopf gesperrt.
    /// </summary>
    [Parameter] public EventCallback<(double Kwh, double Kw)> Uebernehmen { get; set; }

    /// <summary>Schreibt das Raster als CSV; ohne Rueckruf kein Knopf.</summary>
    [Parameter] public EventCallback<string> Csv { get; set; }

    /// <summary>
    /// Schreibt den Leistungspreis L_P [€/(kW·a)] SOFORT in die aktive
    /// Speichervariante (Anwenderentscheid W11b‑E‑3, 10.09.2026).
    /// </summary>
    /// <remarks>
    /// Es ist dasselbe Feld <c>Tab_StromspeicherVariante.L_P</c>, das der Reiter
    /// „Parameter" und die Peak-Shaving-Maske pflegen — EINE Pflegestelle. OHNE
    /// Rueckruf bleibt das Feld Anzeige („Kein Delegat ist kein Knopf"); der Suchlauf
    /// rechnet dann mit dem vorbelegten Wert.
    /// </remarks>
    [Parameter] public EventCallback<double> LeistungspreisSchreiben { get; set; }

    /// <summary>
    /// Zeichnet das Bild „Lastgang und Speicherbetrieb" NEU — anderer Ausschnitt,
    /// andere Reihenwahl, anderer Datenzoom (Befund W11b‑B‑25, 09.09.2026).
    /// </summary>
    /// <remarks>
    /// Gerechnet wird dabei EIN Jahreslauf des Bestpunkts, nicht die Rastersuche.
    /// OHNE Delegat bleibt das Bild des Laufs stehen und es gibt keine Umschalter.
    /// </remarks>
    [Parameter]
    public Func<bool, IReadOnlyList<string>, Diagrammbereich?,
                SpeicherOptimierungBetriebsbild>? Betrieb { get; set; }

    /// <summary>Die Ueberlagerung moechte geschlossen werden.</summary>
    [Parameter] public EventCallback Geschlossen { get; set; }

    /// <summary>
    /// Meldung der Huelle — der Ausgang von „Bestpunkt uebernehmen" oder des
    /// CSV-Schreibens. Leer = keine.
    /// </summary>
    [Parameter] public string Meldung { get; set; } = "";

    /// <summary>Ist <see cref="Meldung"/> eine ERFOLGSmeldung? Sonst steht sie rot.</summary>
    [Parameter] public bool MeldungErfolg { get; set; }

    [Parameter] public string HilfeSchluessel { get; set; } = "Form_SpeicherOptimierung.btn_Help";

    // =====================================================================
    // Zustand
    // =====================================================================

    private SpeicherOptimierungEingaben _eingaben = new SpeicherOptimierungEingaben();
    private string _aktuelleAuslegung = "";

    /// <summary>Die angebotenen Leistungspreis-Quellen; leer = keine gepflegt.</summary>
    private IReadOnlyList<SpeicherOptimierungLeistungspreisQuelle> _quellen =
        new List<SpeicherOptimierungLeistungspreisQuelle>();

    /// <summary>Die zuletzt gewaehlte Quelle (Index) — <c>null</c> = keine.</summary>
    private int? _quelle;

    /// <summary>Das Bild „Lastgang und Speicherbetrieb"; leer = keines.</summary>
    private byte[]? _betriebBild;

    /// <summary>Die Ueberschrift dazu — sie nennt den gezeigten Ausschnitt.</summary>
    private string _betriebTitel = "";

    /// <summary><c>true</c> = ganzes Jahr statt der Woche um die Jahresspitze.</summary>
    private bool _betriebJahr;

    /// <summary>Der aufgezogene Datenzoom; <c>null</c> = volle Ansicht.</summary>
    private Diagrammbereich? _betriebBereich;

    /// <summary>
    /// Die gewaehlten Reihen. Sie startet mit ALLEN; waehlt der Anwender alles ab,
    /// bleibt sie LEER und das Bild zeigt den Leerhinweis des Zeichners — die
    /// Hausregel der Ergebnisseite (Doku_Simulationsergebnis_Darstellung.md, § 5),
    /// ohne Rueckfall auf „alle".
    /// </summary>
    private readonly List<string> _betriebReihen = new List<string>
    {
        SpeicherOptimierungCtrl.REIHE_OHNE,
        SpeicherOptimierungCtrl.REIHE_MIT,
        SpeicherOptimierungCtrl.REIHE_SCHWELLE,
        SpeicherOptimierungCtrl.REIHE_SPEICHER
    };

    /// <summary>Die Berechnungsart des zuletzt gerechneten Laufs.</summary>
    private OptimiererStrategie _gelaufen = OptimiererStrategie.Dauernutzung;

    private bool _laeuft;
    private double? _anteil;
    private string _fortschrittText = "";
    private string _fehler = "";

    private SpeicherOptimierungErgebnis? _ergebnis;

    private bool _frage;
    private string _frageText = "";

    /// <summary>Der Suchraum (Pruefhilfe).</summary>
    public SpeicherOptimierungEingaben Eingaben => _eingaben;

    /// <summary>Laeuft die Rastersuche gerade? (Pruefhilfe)</summary>
    public bool Laeuft => _laeuft;

    /// <summary>Das Ergebnis des letzten Laufs (Pruefhilfe); <c>null</c> = keines.</summary>
    public SpeicherOptimierungErgebnis? Ergebnis => _ergebnis;

    /// <summary>Das gezeigte Betriebsbild (Pruefhilfe); <c>null</c> = keines.</summary>
    public byte[]? Betriebsbild => _betriebBild;

    /// <summary>Zeigt das Betriebsbild das ganze Jahr? (Pruefhilfe)</summary>
    public bool BetriebGanzesJahr => _betriebJahr;

    private bool LaufMoeglich => Rechnen is not null;

    private bool ErgebnisDa => _ergebnis is not null && _ergebnis.Erfolg;

    private string Punktetext => string.Format(
        System.Globalization.CultureInfo.CurrentCulture, Resource.OPT_LBL_PUNKTE,
        SpeicherOptimierungCtrl.Punktzahl(_eingaben));

    // =====================================================================
    // Laden
    // =====================================================================

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        SpeicherOptimierungVorgaben? vorgaben = Vorgaben?.Invoke();
        if (vorgaben is null) return;

        _eingaben = vorgaben.Eingaben.Kopie();
        _aktuelleAuslegung = vorgaben.AktuelleAuslegung;
        _quellen = vorgaben.Leistungspreisquellen
                   ?? (IReadOnlyList<SpeicherOptimierungLeistungspreisQuelle>)
                      new List<SpeicherOptimierungLeistungspreisQuelle>();
    }

    // =====================================================================
    // Der Leistungspreis (W11b‑E‑3)
    // =====================================================================

    /// <summary>Steht die Klappliste auf der Lastspitzenkappung?</summary>
    private bool Kappung => _eingaben.Strategie == OptimiererStrategie.Lastspitzenkappung;

    /// <summary>Die Quellen als Eintraege der Klappliste; die Id ist der Listenindex.</summary>
    private IReadOnlyList<(int Id, string Text)> Quellenliste =>
        _quellen.Select((q, i) => (Id: i, Text: q.Bezeichnung)).ToList();

    /// <summary>
    /// Das Feld hat geschrieben: erst in den Suchraum, dann SOFORT in die Variante.
    /// </summary>
    private async Task LeistungspreisGesetzt(double? wert)
    {
        if (!wert.HasValue) return;

        _eingaben.LeistungspreisEurProKwA = wert.Value;
        _quelle = null;                    // von Hand geaendert - keine Quelle mehr
        Nachrechnen();

        if (LeistungspreisSchreiben.HasDelegate)
            await LeistungspreisSchreiben.InvokeAsync(wert.Value);
    }

    /// <summary>
    /// Eine Quelle wurde gewaehlt: Ihr Wert geht ins Feld UND in die Variante — die
    /// Uebernahme ist ein Schreibvorgang, kein Vorschlag (Anwenderentscheid W11b‑E‑3).
    /// </summary>
    private async Task QuelleGewaehlt(int? index)
    {
        _quelle = index;
        if (!index.HasValue || index.Value < 0 || index.Value >= _quellen.Count) return;

        double wert = _quellen[index.Value].WertEurProKwA;
        _eingaben.LeistungspreisEurProKwA = wert;
        Nachrechnen();

        if (LeistungspreisSchreiben.HasDelegate)
            await LeistungspreisSchreiben.InvokeAsync(wert);
    }

    /// <summary>
    /// Suchraumregel und Zielfunktion in EINER Zeile — die Zielfunktion wechselt mit
    /// der Berechnungsart (W11b‑B‑25 / W11b‑E‑3).
    /// </summary>
    private string Herleitung => Resource.OPT_HINWEIS_SUCHRAUM + " " +
        (Kappung ? Resource.OPT_HINWEIS_ZIEL_LASTSPITZE : Resource.OPT_HINWEIS_ZIELFUNKTION);

    // =====================================================================
    // Eingaben
    // =====================================================================

    /// <summary>
    /// Ein Zahlenfeld hat geschrieben. Ein LEERES Feld (<c>null</c>) laesst den
    /// bisherigen Wert stehen; gepruefte Grenzen gibt es erst beim Start — waehrend
    /// des Tippens ist „Kapazität von" zwischenzeitlich immer groesser als „bis".
    /// </summary>
    private void Setzen(Action<double> schreiben, double? wert)
    {
        if (wert.HasValue) schreiben(wert.Value);
        Nachrechnen();
    }

    private void SetzenGanz(Action<int> schreiben, int? wert)
    {
        if (wert.HasValue) schreiben(wert.Value);
        Nachrechnen();
    }

    private void StrategieGewaehlt(int? index)
    {
        // Der Zahlenwert der Klappliste IST der der Aufzaehlung (W11b‑E‑3): 0 = Dauer-,
        // 1 = Nachtnutzung, 2 = Lastspitzenkappung. Ein unbekannter Index faellt auf
        // die Dauernutzung zurueck.
        _eingaben.Strategie = index switch
        {
            1 => OptimiererStrategie.Nachtnutzung,
            2 => OptimiererStrategie.Lastspitzenkappung,
            _ => OptimiererStrategie.Dauernutzung
        };
        Nachrechnen();
    }

    /// <summary>Ein geaenderter Suchraum entwertet den Fehlertext und die Punktzahl.</summary>
    private void Nachrechnen() => _fehler = "";

    // =====================================================================
    // Der Lauf
    // =====================================================================

    private async Task Starten()
    {
        if (_laeuft || Rechnen is null) return;

        IReadOnlyList<string> maengel = SpeicherOptimierungCtrl.Pruefe(_eingaben);
        if (maengel.Count > 0)
        {
            // Eingabefehler SPERREN den Lauf - er beginnt gar nicht erst.
            _fehler = string.Join(Environment.NewLine, maengel);
            _ergebnis = null;
            return;
        }

        _laeuft = true;
        _fehler = "";
        _ergebnis = null;
        _anteil = 0.0;
        _fortschrittText = string.Format(System.Globalization.CultureInfo.CurrentCulture,
            Resource.OPT_STATUS_PUNKT, 0, SpeicherOptimierungCtrl.Punktzahl(_eingaben));
        StateHasChanged();

        SpeicherOptimierungErgebnis antwort;
        try
        {
            antwort = await Rechnen(_eingaben.Kopie(), Melden);
        }
        finally
        {
            _laeuft = false;
        }

        if (antwort is null || !antwort.Erfolg)
        {
            _ergebnis = null;
            _fehler = antwort?.Meldung ?? Resource.OPT_MSG_KEIN_ERGEBNIS;
            _betriebBild = null;
            _betriebTitel = "";
        }
        else
        {
            _ergebnis = antwort;

            // Ein neuer Lauf setzt die Schalterstellungen des Betriebsbildes zurueck:
            // Der Ausschnitt eines FRUEHEREN Bestpunkts hat mit diesem nichts zu tun.
            _gelaufen = _eingaben.Strategie;
            _betriebJahr = false;
            _betriebBereich = null;
            _betriebBild = antwort.BetriebBild;
            _betriebTitel = antwort.BetriebTitel;
        }

        StateHasChanged();
    }

    // =====================================================================
    // Das Bild „Lastgang und Speicherbetrieb" (W11b‑B‑25)
    // =====================================================================

    /// <summary>
    /// Die waehlbaren Reihen des Betriebsbildes. Die SCHWELLE gibt es nur bei der
    /// Lastspitzenkappung — bei den anderen Berechnungsarten waere sie eine Linie
    /// ohne Bedeutung.
    /// </summary>
    private IEnumerable<(string Schluessel, string Text)> Betriebsreihen
    {
        get
        {
            yield return (SpeicherOptimierungCtrl.REIHE_OHNE, Resource.OPT_BETRIEB_R_OHNE);
            yield return (SpeicherOptimierungCtrl.REIHE_MIT, Resource.OPT_BETRIEB_R_MIT);
            if (_gelaufen == OptimiererStrategie.Lastspitzenkappung)
                yield return (SpeicherOptimierungCtrl.REIHE_SCHWELLE, Resource.OPT_BETRIEB_R_SCHWELLE);
            yield return (SpeicherOptimierungCtrl.REIHE_SPEICHER, Resource.OPT_BETRIEB_R_LEISTUNG);
        }
    }

    private bool ReiheAn(string schluessel) => _betriebReihen.Contains(schluessel);

    private void BetriebJahrGesetzt(bool wert)
    {
        _betriebJahr = wert;
        // Ein anderer Ausschnitt entwertet den aufgezogenen Bereich - er war in
        // Anteilen des ALTEN Bildes gemessen.
        _betriebBereich = null;
        BetriebZeichnen();
    }

    private void BetriebsreiheGesetzt(string schluessel, bool an)
    {
        if (an)
        {
            if (!_betriebReihen.Contains(schluessel)) _betriebReihen.Add(schluessel);
        }
        else
        {
            _betriebReihen.Remove(schluessel);
        }

        BetriebZeichnen();
    }

    private void BetriebBereich(Diagrammbereich bereich)
    {
        _betriebBereich = bereich;
        BetriebZeichnen();
    }

    private void BetriebBereichZurueck()
    {
        _betriebBereich = null;
        BetriebZeichnen();
    }

    /// <summary>Holt das Bild neu — EIN Jahreslauf des Bestpunkts, kein Raster.</summary>
    private void BetriebZeichnen()
    {
        if (Betrieb is null) return;

        SpeicherOptimierungBetriebsbild neu = Betrieb(_betriebJahr, _betriebReihen, _betriebBereich);
        if (neu is null) return;

        _betriebBild = neu.Png;
        _betriebTitel = neu.Titel;
    }

    /// <summary>
    /// Die gedrosselte Fortschrittsmeldung. Sie kommt aus dem Hintergrundfaden;
    /// <c>InvokeAsync</c> setzt den Zeichenlauf auf den Bedienfaden.
    /// </summary>
    private void Melden(double? anteil, string text)
    {
        _anteil = anteil;
        _fortschrittText = text ?? "";
        _ = InvokeAsync(StateHasChanged);
    }

    // =====================================================================
    // Uebernehmen und CSV
    // =====================================================================

    private void UebernehmenFragen()
    {
        if (!ErgebnisDa || !Uebernehmen.HasDelegate) return;

        System.Globalization.CultureInfo k = System.Globalization.CultureInfo.CurrentCulture;
        _frageText = string.Format(k, Resource.OPT_MSG_UEBERNAHME_FRAGE,
            _ergebnis!.KapazitaetKwh.ToString("0.#", k),
            _ergebnis!.LeistungKw.ToString("0.#", k));
        _frage = true;
    }

    private async Task FrageBeantwortet(bool? antwort)
    {
        _frage = false;
        if (antwort != true || _ergebnis is null) return;

        await Uebernehmen.InvokeAsync((_ergebnis.KapazitaetKwh, _ergebnis.LeistungKw));
    }

    private async Task CsvSchreiben()
    {
        if (!ErgebnisDa || !Csv.HasDelegate) return;
        await Csv.InvokeAsync(_ergebnis!.RasterCsv);
    }

    // =====================================================================
    // Kennzahlen
    // =====================================================================

    private IEnumerable<SpeicherOptimierungKennzahl> Zeilen(string gruppe)
    {
        if (_ergebnis is null) yield break;

        foreach (SpeicherOptimierungKennzahl z in _ergebnis.Kennzahlen)
            if (string.Equals(z.Gruppe, gruppe, StringComparison.Ordinal)) yield return z;
    }

    private static string Gruppentitel(string gruppe) => gruppe switch
    {
        SpeicherOptimierungCtrl.GRUPPE_AUSLEGUNG => Resource.OPT_KZ_GRUPPE_AUSLEGUNG,
        SpeicherOptimierungCtrl.GRUPPE_WIRTSCHAFT => Resource.OPT_KZ_GRUPPE_WIRTSCHAFT,
        SpeicherOptimierungCtrl.GRUPPE_SPEICHER => Resource.OPT_KZ_GRUPPE_SPEICHER,
        _ => gruppe
    };
}
