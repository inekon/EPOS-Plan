@* Die SEITE "Uebersicht" des Reiters "Berichte & Kosten" (iU9-W5.5).

   Vorbild: Views/BerichteKosten/UcBkUebersicht.cs (1 552 Z., K4).

   AUFBAU. Oben die Verwaltung der Vergleichsgruppe: Stammprojekt-Auswahl und
   Filter "nur Stammprojekte", darunter in EINER Zeile die Variantenwahl,
   das Bezeichnerfeld und die drei Knoepfe (Variante anlegen, loeschen,
   Simulation starten), darunter die leise Statuszeile des Simulationsstands.
   Und dann der Komponentenbereich - auf der Stammzeile die GEGENUEBERSTELLUNG
   aller Versionen, auf einer Variante deren UNTERSCHIEDE zum Stamm samt
   Aktionsspalte.

   DIE VERSIONSWAHL IST EIN AUSWAHLFELD, KEINE TABELLE (Anwenderwunsch
   05.09.2026, W5-E-1: "Variantenprojekte-Auswahl als Dropdown, damit weniger
   Platz verwendet wird"). Die Tabelle mit Wahlknopf, Art, Bezeichner,
   Projektname und Simulationsspalte brauchte vier bis fuenf Zeilen Hoehe fuer
   eine Angabe, die in EINE passt - und nahm sie dem, worum es auf der Seite
   geht: der Unterschiedstabelle. Was die Tabelle sonst noch sagte, bleibt:
   die Reihenfolge (Stamm zuerst) durch die Reihenfolge der Eintraege, der
   Bezeichner und der Projektname im Eintragstext, und der Simulationsstand
   samt "⚠" in der Statuszeile darunter (aria-live, weil er beim Wechsel der
   Version wechselt, ohne dass der Anwender dorthin sieht).

   DIE SEITE VERGLEICHT NICHT SELBST. Beide Ansichten kommen als fertige
   Zeilen aus der Huelle (ProjektDetails + AbweichungsErmittler - dieselbe
   Diff-Welt, die auch der Bericht verwendet). Es gibt bewusst keine zweite
   Vergleichslogik.

   DIE AKTIONSSPALTE traegt einen Knopf, wo die Uebernahme greift, und einen
   grauen Strich mit Begruendung, wo nicht - wortgleich zum Vorlaeufer: "Ein
   Knopf, der beim Druecken nur erklaert, warum er nichts tut, waere die
   schlechtere Auskunft."

   DER UEBERNAHMEDIALOG STEHT IN EINER UEBERLAGERUNG (iU9-W5.1 baute ihn als
   BkUebernahmeDialog; die Huelle zeigte ihn bis hierher in einem eigenen
   Fenster). Ein zweites Fenster waere aus einer Blazor-SEITE heraus eine
   zweite WebView (Risiko R2).

   DIE ZWEI MESSAGEBOX-RUECKFRAGEN (Variante loeschen, Simulationsprotokoll)
   werden zu einer Rueckfrage und einer Meldung im Fenster. *@

@namespace EPOS.UI.Seiten.Berichte
@using EPOS.UI.Dialoge.Berichte

<div class="epos-seite" tabindex="-1" @ref="_wurzel">

    <div class="epos-seite-kopf">
        <span class="epos-seite-titel">@TitelText</span>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="WarnStufe.Hinweis" Text="@_meldung" />
    }

    @* ------------------------------------------------ Stamm und Filter *@
    <div class="epos-seite-zeile epos-stammzeile">
        <Auswahlfeld Bezeichnung="@LabelStamm" Eintraege="@_stand.Staemme"
                     Auswahl="@_stand.StammId" AuswahlChanged="BeiStamm" />
        <Schalter Bezeichnung="@LabelNurStaemme" Wert="@_stand.NurStaemme"
                  WertChanged="BeiFilter" />
    </div>

    @* ------------------------- Die Version, der Bezeichner, die Knoepfe *@
    <div class="epos-seite-zeile epos-variantenzeile">
        <Auswahlfeld Bezeichnung="@LabelVariante" Kurzname="@WahlKurztext"
                     Eintraege="@Versionen" Auswahl="@Markierung"
                     AuswahlChanged="BeiVersion" />
        <Textfeld Bezeichnung="@LabelBezeichner" Wert="@_bezeichner"
                  WertChanged="@(w => _bezeichner = w)" />
        <button type="button" class="epos-knopf" disabled="@(!_stand.AnlegenMoeglich)"
                @onclick="Anlegen">@AnlegenText</button>
        <button type="button" class="epos-knopf" disabled="@(!_stand.Loeschbar)"
                @onclick="LoeschenFragen">@LoeschenText</button>
        <button type="button" class="epos-knopf epos-knopf--primaer"
                disabled="@(!_stand.SimulierenMoeglich || _laeuft)"
                @onclick="Simulieren">@SimulierenText</button>
    </div>

    @* Der Simulationsstand der gewaehlten Version - das, was die
       Simulationsspalte der Tabelle sagte. aria-live, weil er sich beim
       Wechsel der Version aendert, ohne dass der Anwender hinsieht. *@
    <p class="epos-simstand" aria-live="polite">
        @if (_stand.MarkierteId > 0)
        {
            <span>@Simulationszeile</span>
            @if (Markierte is not null && Markierte.Auffaellig)
            {
                <span class="epos-veraltet" title="@Simulationsgrund">@WarnZeichen</span>
            }
        }
    </p>

    @* --------------------------------------------- Komponentenbereich *@
    <p class="epos-untergruppe">@_stand.KomponentenTitel</p>

    @if (_stand.Vergleich.Count > 0)
    {
        @* Die Unterschiedstabelle bekommt die Hoehe, die die Variantentabelle
           frei gemacht hat: dieselbe Hausregel W9-B-2 (fester Rahmen, innerer
           Rollbalken, stehender Spaltenkopf), nur mit einer groesseren
           Hoechsthoehe - sie ist das, worum es auf dieser Seite geht. *@
        <div class="epos-raster-huelle epos-raster-huelle--vergleich">
            <table class="epos-raster epos-vergleichstabelle">
                <thead>
                    <tr>
                        @foreach (string kopf in _stand.Spalten)
                        {
                            <th scope="col">@kopf</th>
                        }
                        @if (_mitAktionsspalte)
                        {
                            <th scope="col">@SpalteAktion</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (VergleichZeile v in _stand.Vergleich)
                    {
                        VergleichZeile zeile = v;
                        <tr>
                            <th scope="row" class="epos-vergleich-gewerk">@zeile.Gewerk</th>
                            <td>@zeile.Merkmal</td>
                            @for (int i = 0; i < zeile.Zellen.Count; i++)
                            {
                                int spalte = i;
                                <td class="epos-zahl" title="@Kurztext(zeile, spalte)">@zeile.Zellen[spalte]</td>
                            }
                            @if (_mitAktionsspalte)
                            {
                                <td class="epos-zellenaktionen">
                                    @if (zeile.MitAktion && string.IsNullOrEmpty(zeile.Sperrgrund)
                                         && UebernahmeGaben is not null)
                                    {
                                        <button type="button" class="epos-knopf"
                                                title="@zeile.AktionKurztext"
                                                @onclick="@(() => UebernahmeOeffnen(zeile))">@UebernehmenText</button>
                                    }
                                    else if (zeile.MitAktion)
                                    {
                                        <span class="epos-gesperrt" title="@zeile.Sperrgrund">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(_status))
    {
        <p class="epos-status">@_status</p>
    }

    @* ---------------------------------------------------- Unterdialoge *@
    <Ueberlagerung Offen="@(_gaben is not null)" Schliessbar="false"
                   Titel="@UebernehmenText" Geschlossen="() => UebernahmeFertig(null)">
        <KindInhalt>
            @if (_gaben is not null)
            {
                <BkUebernahmeDialog @attributes="_gaben" Geschlossen="UebernahmeFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Rueckfrage Offen="@_loeschfrageOffen" Frage="@_loeschfrage"
                TitelText="@LoeschenText" Beantwortet="LoeschenBeantwortet"
                JaText="@JaText" NeinText="@NeinText" />

    @* Entscheid O-4: erst NACH der unveraenderten Loeschfrage und nur, wenn der
       Projektname mehrere Projekte trifft. Ebenfalls Vorgabe "Nein". *@
    <Rueckfrage Offen="@_mehrdeutigOffen" Frage="@MehrdeutigFrage"
                TitelText="@MehrdeutigTitel" Beantwortet="MehrdeutigBeantwortet"
                VorgabeNein="true" JaText="@JaText" NeinText="@NeinText" />
</div>

@code {
    // =====================================================================
    // Datenseite
    // =====================================================================

    /// <summary>Liefert den Anzeigestand (Vorbild <c>LadeProjekte</c>/<c>LadeAuswahl</c>).</summary>
    [Parameter] public Func<UebersichtStand>? Laden { get; set; }

    /// <summary>Das Stammprojekt hat gewechselt — die Hülle merkt es sich und meldet es weiter.</summary>
    [Parameter] public Action<int>? StammGewechselt { get; set; }

    /// <summary>Der Filter „nur Stammprojekte" hat gewechselt.</summary>
    [Parameter] public Action<bool>? FilterGewechselt { get; set; }

    /// <summary>Eine andere Version wurde gewählt (Projekt-Id).</summary>
    [Parameter] public Action<int>? ZeileMarkiert { get; set; }

    /// <summary>Legt eine Variante an und liefert die Meldung.</summary>
    [Parameter] public Func<string, string>? VarianteAnlegen { get; set; }

    /// <summary>Die Frage vor dem Löschen; leer = nicht möglich.</summary>
    [Parameter] public Func<string>? LoeschFrage { get; set; }

    /// <summary>
    /// Löscht die markierte Variante und liefert die Meldung. Der Parameter ist die
    /// Antwort auf die Mehrdeutigkeits-Rückfrage (iU9-W15a, Entscheid O-4 vom
    /// 04.09.2026): <c>true</c> = der Anwender hat dem Löschen ALLER Projekte dieses
    /// Namens ausdrücklich zugestimmt. Regulär <c>false</c>.
    /// </summary>
    [Parameter] public Func<bool, string>? VarianteLoeschen { get; set; }

    /// <summary>
    /// Wie viele Projekte tragen diesen Projektnamen? Der Löschweg fragt damit nach,
    /// bevor er einen mehrdeutigen Namen löscht (iU9-W15a, Entscheid O-4 vom
    /// 04.09.2026 — dieselbe Vorprüfung wie beim Projektlöschen, O-3).
    ///
    /// <para><b>Warum ein Rückruf und keine Abfrage.</b> EPOS.UI rührt keine Datenbank an
    /// (Hausregel). Die Hülle reicht <c>ProjektCtrl.AnzahlGleicherNamen</c> herein —
    /// DIESELBE Zählung, mit der <c>VariantenCtrl.LoescheVariante</c> im Kern abbricht.
    /// So können die beiden nicht auseinanderlaufen. <c>null</c> = nicht gesetzt, dann
    /// wird nicht gefragt (der Kern hält die Sperre trotzdem).</para>
    /// </summary>
    [Parameter] public Func<string, int>? NamensAnzahl { get; set; }

    /// <summary>
    /// Simuliert Stamm und markierte Variante. Der Parameter ist der
    /// Fortschrittsmelder; das Protokoll steht danach in
    /// <see cref="LaufErgebnis.Meldung"/>.
    /// </summary>
    [Parameter] public Func<Action<Laufschritt>, Task<LaufErgebnis>>? Simulation { get; set; }

    /// <summary>Der Parametersatz des Übernahmedialogs zu einer Zeile.</summary>
    [Parameter] public Func<VergleichZeile, IReadOnlyDictionary<string, object>?>? UebernahmeGaben { get; set; }

    /// <summary>Führt die Übernahme aus und liefert die Meldung.</summary>
    [Parameter] public Func<VergleichZeile, int, string>? Uebernehmen { get; set; }

    /// <summary>Hilfeschlüssel — der der alten Maske.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "UcBkUebersicht.btn_Help";

    // ---- Texte ----------------------------------------------------------

    [Parameter] public string TitelText { get; set; } = "Übersicht";
    [Parameter] public string LabelStamm { get; set; } = "Stammprojekt:";
    [Parameter] public string LabelNurStaemme { get; set; } = "nur Stammprojekte";

    /// <summary>Beschriftung der Versionswahl (Anwenderwunsch 05.09.2026, W5‑E‑1).</summary>
    [Parameter] public string LabelVariante { get; set; } = "Variante:";

    [Parameter] public string LabelBezeichner { get; set; } = "Bezeichner:";

    /// <summary>
    /// Das Wort vor dem Simulationszeitpunkt in der Statuszeile — bis W5‑E‑1 der
    /// Kopf der Simulationsspalte der Variantentabelle. Dieselbe Ressource, dieselbe
    /// Aussage, nur eine Zeile statt einer Spalte.
    /// </summary>
    [Parameter] public string SpalteSimulation { get; set; } = "Simulation";

    [Parameter] public string SpalteAktion { get; set; } = "Aktion";
    [Parameter] public string AnlegenText { get; set; } = "Variante anlegen";
    [Parameter] public string LoeschenText { get; set; } = "Variante löschen";
    [Parameter] public string SimulierenText { get; set; } = "Simulation starten";
    [Parameter] public string UebernehmenText { get; set; } = "Übernehmen";

    /// <summary>Name der Versionswahl für die Sprachausgabe (<c>aria-label</c>).</summary>
    [Parameter] public string WahlKurztext { get; set; } = "Version wählen";

    /// <summary>Statuszeile, wenn die gewählte Version nie gerechnet wurde.</summary>
    [Parameter] public string SimNieText { get; set; } = "noch nicht simuliert";

    /// <summary>Kurztext am „⚠", wenn kein Ergebnis vorliegt.</summary>
    [Parameter] public string SimGrundFehlt { get; set; }
        = "Für diese Version liegt kein Simulationsergebnis vor.";

    /// <summary>
    /// Kurztext am „⚠", wenn das Ergebnis älter ist als die letzte Änderung am
    /// Projekt — genau das, was <c>BerichtsDatenSammler.ErmittleStatus</c> als
    /// „veraltet" meldet (Zeitstempel des Ergebnisses &lt; <c>Aenderungsdatum</c>).
    /// </summary>
    [Parameter] public string SimGrundVeraltet { get; set; }
        = "Das Simulationsergebnis ist älter als die letzte Änderung am Projekt.";

    [Parameter] public string JaText { get; set; } = "Ja";
    [Parameter] public string NeinText { get; set; } = "Nein";

    /// <summary>Der Titel der Mehrdeutigkeits-Rückfrage (Schlüssel <c>PROJ_MSG_NAME_MEHRDEUTIG_TITEL</c>).</summary>
    [Parameter] public string MehrdeutigTitel { get; set; } = "";

    /// <summary>
    /// Die Mehrdeutigkeits-Rückfrage (Schlüssel <c>PROJ_MSG_NAME_MEHRDEUTIG</c>);
    /// <c>{0}</c> = Projektname, <c>{1}</c> = Anzahl. Leer = die Rückfrage unterbleibt.
    /// </summary>
    [Parameter] public string MehrdeutigFormat { get; set; } = "";

    /// <summary>Meldung „abgebrochen".</summary>
    [Parameter] public string StatusAbgebrochen { get; set; } = "Vorgang abgebrochen.";

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private UebersichtStand _stand = new();
    private string _bezeichner = "";
    private string _status = "";
    private string _meldung = "";
    private bool _laeuft;

    private IReadOnlyDictionary<string, object>? _gaben;
    private VergleichZeile? _uebernahmezeile;

    private bool _loeschfrageOffen;
    private string _loeschfrage = "";

    private bool _mehrdeutigOffen;
    private int _anzahlGleicher;

    /// <summary>Statuszeile (Prüfhilfe).</summary>
    public string Status => _status;

    /// <summary>Die markierte Version (Prüfhilfe).</summary>
    public int MarkierteId => _stand.MarkierteId;

    /// <summary>Steht der Übernahmedialog? (Prüfhilfe)</summary>
    public bool UebernahmeOffen => _gaben is not null;

    /// <summary>Steht die Mehrdeutigkeits-Rückfrage? (Prüfhilfe)</summary>
    public bool MehrdeutigOffen => _mehrdeutigOffen;

    /// <summary>Trägt der Komponentenbereich die Aktionsspalte? (Prüfhilfe)</summary>
    public bool MitAktionsspalte => _mitAktionsspalte;

    private bool _mitAktionsspalte;

    protected override void OnInitialized() => Auffrischen();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <summary>Liest Auswahl, Liste und Komponentenbereich neu ein.</summary>
    public void Auffrischen()
    {
        _stand = Laden?.Invoke() ?? new UebersichtStand();
        _bezeichner = _stand.Bezeichnervorschlag ?? "";
        _status = _stand.Statuszeile ?? "";

        // Die Aktionsspalte gehoert zur UNTERSCHIEDSansicht - erkennbar
        // daran, dass wenigstens eine Zeile sie traegt.
        _mitAktionsspalte = false;
        foreach (VergleichZeile v in _stand.Vergleich)
            if (v.MitAktion) { _mitAktionsspalte = true; break; }

        StateHasChanged();
    }

    private static string Kurztext(VergleichZeile z, int spalte)
        => spalte < z.Kurztexte.Count ? z.Kurztexte[spalte] : "";

    // =====================================================================
    // Die Versionswahl (Anwenderwunsch 05.09.2026, W5-E-1)
    // =====================================================================

    /// <summary>Das Warnzeichen der auffälligen Stände — dasselbe wie im Bestand.</summary>
    private const string WarnZeichen = "⚠";

    /// <summary>
    /// Die Einträge der Versionswahl in der Reihenfolge der Gruppe: der Stamm
    /// zuerst, dann die Varianten. Der Text ist „Bezeichner — Projektname" — die
    /// zwei Spalten, die die Tabelle bis W5‑E‑1 nebeneinander führte; die Spalte
    /// „Art" braucht es nicht mehr, weil der Stamm seinen Bezeichner
    /// („(Stammprojekt)") schon trägt und immer oben steht.
    ///
    /// <para>Die Ids sind die Projekt-Ids und damit über einen Neuaufbau stabil —
    /// die Bedingung, die die Hausregel dem Wirt eines <c>Auswahlfeld</c>
    /// auferlegt. Dubletten kann es nicht geben: <c>Tab_Projekt.ID</c> ist der
    /// Schlüssel.</para>
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Versionen
    {
        get
        {
            var liste = new List<(int, string)>(_stand.Zeilen.Count);
            foreach (VarianteZeile z in _stand.Zeilen)
                liste.Add((z.IdProjekt, Eintragstext(z)));
            return liste;
        }
    }

    private static string Eintragstext(VarianteZeile z)
    {
        string bezeichner = z.Bezeichner ?? "";
        string projekt = z.Projektname ?? "";

        if (bezeichner.Length == 0) return projekt;
        if (projekt.Length == 0) return bezeichner;
        return bezeichner + " — " + projekt;
    }

    /// <summary>Die gewählte Version für das <c>Auswahlfeld</c>; <c>null</c> = keine.</summary>
    private int? Markierung => _stand.MarkierteId > 0 ? _stand.MarkierteId : null;

    /// <summary>Die Zeile der gewählten Version; <c>null</c> = keine.</summary>
    private VarianteZeile? Markierte
    {
        get
        {
            foreach (VarianteZeile z in _stand.Zeilen)
                if (z.IdProjekt == _stand.MarkierteId) return z;
            return null;
        }
    }

    /// <summary>
    /// Der Simulationsstand der gewählten Version als Satz: „Simulation:
    /// 05.09.26 16:23" bzw. „noch nicht simuliert". Das Warnzeichen steht daneben
    /// als eigenes Element, damit es einen Kurztext tragen kann.
    /// </summary>
    private string Simulationszeile
    {
        get
        {
            VarianteZeile? z = Markierte;
            if (z is null || string.IsNullOrEmpty(z.SimZeitpunkt)) return SimNieText;
            return SpalteSimulation + ": " + z.SimZeitpunkt;
        }
    }

    /// <summary>Warum der Stand auffällig ist: kein Ergebnis oder ein veraltetes.</summary>
    private string Simulationsgrund
    {
        get
        {
            VarianteZeile? z = Markierte;
            return z is null || string.IsNullOrEmpty(z.SimZeitpunkt)
                ? SimGrundFehlt : SimGrundVeraltet;
        }
    }

    // =====================================================================
    // Auswahl
    // =====================================================================

    private void BeiStamm(int? id)
    {
        if (id is null) return;
        StammGewechselt?.Invoke(id.Value);
        Auffrischen();
    }

    private void BeiFilter(bool an)
    {
        FilterGewechselt?.Invoke(an);
        Auffrischen();
    }

    /// <summary>
    /// Die Wahl im Auswahlfeld treibt genau das, was bis W5‑E‑1 die Zeilenwahl der
    /// Tabelle trieb: dieselbe Meldung an die Hülle, danach dasselbe Auffrischen —
    /// Unterschiedstabelle, Knopfzustände und Statuszeile kommen aus dem neuen
    /// Stand.
    /// </summary>
    private void BeiVersion(int? id)
    {
        if (id is null) return;
        ZeileMarkiert?.Invoke(id.Value);
        Auffrischen();
    }

    // =====================================================================
    // Variante anlegen und löschen
    // =====================================================================

    private void Anlegen()
    {
        if (VarianteAnlegen is null) return;

        string meldung = VarianteAnlegen(_bezeichner ?? "");
        Auffrischen();
        if (!string.IsNullOrEmpty(meldung)) _status = meldung;
    }

    private void LoeschenFragen()
    {
        if (LoeschFrage is null) return;
        string frage = LoeschFrage();
        if (string.IsNullOrEmpty(frage)) return;
        _loeschfrage = frage;
        _loeschfrageOffen = true;
    }

    /// <summary>
    /// Die Antwort auf die unveränderte Löschfrage — und die Stelle, an der der
    /// Löschweg nach einem MEHRDEUTIGEN Projektnamen fragt (Entscheid O-4 vom
    /// 04.09.2026, dieselbe Rückfrage wie im <c>ProjektWahlDialog</c>).
    ///
    /// <para>Regulär trägt ein Name genau ein Projekt: <c>Tab_Projekt</c> hat den
    /// eindeutigen Index <c>Projektname</c>. Ein Altbestand ohne ihn kann den Fall
    /// führen, und weil der letzte Schritt der Variantenlöschung über den NAMEN läuft,
    /// träfe er dann beide Projekte. Deshalb: nachfragen. „Nein" lässt die Seite
    /// stehen, wie bei der Löschfrage selbst.</para>
    /// </summary>
    private void LoeschenBeantwortet(bool? antwort)
    {
        _loeschfrageOffen = false;
        if (antwort != true || VarianteLoeschen is null) return;

        if (NamensAnzahl is not null && !string.IsNullOrEmpty(MehrdeutigFormat))
        {
            _anzahlGleicher = NamensAnzahl(MarkierterProjektname);
            if (_anzahlGleicher > 1)
            {
                _mehrdeutigOffen = true;
                return;
            }
        }

        Loeschen(false);
    }

    private void MehrdeutigBeantwortet(bool? antwort)
    {
        _mehrdeutigOffen = false;
        if (antwort != true) return;          // "Nein" laesst die Seite stehen
        Loeschen(true);
    }

    private void Loeschen(bool alleGleichenNamens)
    {
        if (VarianteLoeschen is null) return;

        string meldung = VarianteLoeschen(alleGleichenNamens);
        Auffrischen();
        if (!string.IsNullOrEmpty(meldung)) _status = meldung;
    }

    /// <summary>Der Projektname der gewählten Version (leer, wenn keine gewählt ist).</summary>
    private string MarkierterProjektname => Markierte?.Projektname ?? "";

    private string MehrdeutigFrage
        => string.Format(MehrdeutigFormat ?? "", MarkierterProjektname, _anzahlGleicher);

    // =====================================================================
    // Simulation
    // =====================================================================

    private async Task Simulieren()
    {
        if (_laeuft || Simulation is null) return;

        _laeuft = true;
        _meldung = "";
        StateHasChanged();
        try
        {
            LaufErgebnis erg = await Simulation(Melden);

            if (erg.Abgebrochen) { _status = StatusAbgebrochen; return; }

            Auffrischen();

            // Der Vorlaeufer zeigte das Protokoll als MessageBox; hier steht
            // es als Meldung im Fenster.
            _meldung = erg.Meldung ?? "";
            if (!string.IsNullOrEmpty(erg.Statuszeile)) _status = erg.Statuszeile;
        }
        finally
        {
            _laeuft = false;
            StateHasChanged();
        }
    }

    private void Melden(Laufschritt s)
    {
        _ = InvokeAsync(() =>
        {
            _status = s.Gesamt > 0 ? $"({s.Aktuell}/{s.Gesamt}) {s.Text}" : s.Text;
            StateHasChanged();
        });
    }

    // =====================================================================
    // Übernahme
    // =====================================================================

    private void UebernahmeOeffnen(VergleichZeile z)
    {
        if (UebernahmeGaben is null) return;

        IReadOnlyDictionary<string, object>? gaben = UebernahmeGaben(z);
        if (gaben is null) return;

        _uebernahmezeile = z;
        _gaben = gaben;
    }

    private void UebernahmeFertig(BkUebernahmeErgebnis? ergebnis)
    {
        VergleichZeile? zeile = _uebernahmezeile;
        _uebernahmezeile = null;
        _gaben = null;

        if (ergebnis is null || zeile is null || Uebernehmen is null) return;

        string meldung = Uebernehmen(zeile, ergebnis.QuelleId);
        Auffrischen();
        if (!string.IsNullOrEmpty(meldung)) _status = meldung;
    }
}
