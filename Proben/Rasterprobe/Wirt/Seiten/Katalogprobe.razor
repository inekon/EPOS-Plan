    {
        Id = id, Name = name, Bezugsart = wohnen ? 1 : 6,
        Bezugsgroesse = wohnen ? "Personen" : "Beschäftigte", Einheit = wohnen ? "P" : "B",
        BedarfJeNiveauKwhJeEinheitTag = new[] { 1.0, 2.0, 3.0 }, Herkunft = "fiktiv · Probequelle",
        Status = "eigen", Katalogversion = "PROBE-1", Kalenderart = wohnen ? 1 : 2,
        Kalender = wohnen ? "Wohnen" : "Arbeitstage", Wohnen = wohnen, Bilanzgrenze = 1,
        ZapftemperaturC = 50, Monatsfaktoren = Enumerable.Repeat(1.0, 12).ToArray(), IdTagesgangsatz = 1
    };

