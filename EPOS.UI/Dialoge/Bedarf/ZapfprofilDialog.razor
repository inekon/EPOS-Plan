    {
        ((int)ZapfprofilBilanzgrenze.Zapfstelle, Texte.GrenzeZapfstelle),
        ((int)ZapfprofilBilanzgrenze.MitVerteilung, Texte.GrenzeVerteilung),
        ((int)ZapfprofilBilanzgrenze.MitSpeicher, Texte.GrenzeSpeicher)
    };

    private IReadOnlyList<(int Id, string Text)> Zirkulationsmethoden => new[]
    {
        ((int)ZapfprofilZirkulationsmethode.Leitungslaenge, Texte.ZirkMethodeLaenge),
        ((int)ZapfprofilZirkulationsmethode.Anteil, Texte.ZirkMethodeAnteil),
        ((int)ZapfprofilZirkulationsmethode.Flaechenkennwert, Texte.ZirkMethodeFlaeche)
    };

    private IReadOnlyList<(int Id, string Text)> Lagen => new[]
    {
        ((int)ZapfprofilLeitungslage.InnerhalbHuelle, Texte.LageInnen),
        ((int)ZapfprofilLeitungslage.AusserhalbHuelle, Texte.LageAussen)
    };

    private string Lagename(int? lage) => lage is int l ? Lagen.FirstOrDefault(e => e.Id == l).Text ?? "" : "–";

    /// <summary>Der Kennwert der Zirkulation, der ohne Eingabe gilt — nach der gewählten Lage, sonst der Vorgabelage.</summary>
    private double? Kennwertvorgabe
        => ((int?)G.ZirkLage ?? Daten.Vorgaben.ZirkLage) == (int)ZapfprofilLeitungslage.AusserhalbHuelle
            ? Daten.Vorgaben.ZirkKennwertLage2 : Daten.Vorgaben.ZirkKennwertLage1;

    /// <summary>
    /// Die Kalenderwahl (5.3, A8): der Kalender der Nutzungsart oder die Ferien eines Gebäudes des
    /// Projekts; ein gebundenes Gebäude, das die Liste nicht (mehr) führt, bleibt als Eintrag.
    /// </summary>
    private IReadOnlyList<(int Id, string Text)> Kalenderwahl(ZapfprofilNutzungsartDaten? art, ZapfprofilZonenangabenDaten a)
    {
        var liste = new List<(int Id, string Text)> { (KALENDER_NUTZUNGSART, Format(Texte.KalenderNutzungsart, art?.Kalender ?? "")) };
        liste.AddRange(Daten.Gebaeude.Select(g => (g.Id, Format(Texte.KalenderGebaeude, g.Name))));
        if (a.IdGebaeude is int id && liste.All(e => e.Id != id))
            liste.Add((id, Format(Texte.KalenderGebaeude, "#" + id.ToString(CultureInfo.InvariantCulture))));
        return liste;
    }

    // --- Die Karte „Kalender" der Zone (ZB5) ----------------------------------------------------

    /// <summary>Der Name eines Gebäudes des Projekts; ein unbekanntes trägt seine Id („#7").</summary>
    private string Gebaeudename(int id)
        => Daten.Gebaeude.FirstOrDefault(g => g.Id == id)?.Name is { Length: > 0 } name
            ? name : "#" + id.ToString(CultureInfo.InvariantCulture);

    /// <summary>Der Kalender eines Gebäudes, wie die Hülle ihn beim Öffnen gelesen hat; <c>null</c> = unbekannt.</summary>
    private ZapfprofilGebaeudekalenderDaten? Gebaeudekalender(int id)
        => Daten.Gebaeudekalender.FirstOrDefault(g => g.Id == id);

    /// <summary>Die eigenen Ferienzeiträume der Zone, die wirken — jeder mit einem Ende („bis").</summary>
    private static int EigeneFerien(ZapfprofilZonenangabenDaten a)
        => (a.Ferien ?? new List<ZapfprofilFerienDaten>()).Count(f => f?.Bis is not null);

    /// <summary>Der Name eines eigenen Ferienzeitraums; ohne Namen „Ferien n".</summary>
    private string Ferienname(ZapfprofilFerienDaten f, int n)
        => string.IsNullOrWhiteSpace(f.Name) ? Format(Texte.LabelFerien, n + 1) : f.Name!;

    /// <summary>
    /// Die Zusammenfassung der zugeklappten Karte: die Quelle, die Ferien, die wirken (eigene gehen vor), und mit
    /// gebundenem Gebäude dessen Feiertagsland — „wie Gebäude „Haus A“ · 3 Ferienzeiträume · Feiertage Baden-Württemberg“.
    /// </summary>
    private string KalenderZusammenfassung(ZapfprofilNutzungsartDaten? art, ZapfprofilZonenangabenDaten a)
    {
        int eigene = EigeneFerien(a);
        string eigeneText = eigene == 0 ? "" : eigene == 1 ? Texte.SummeEigeneEins : Format(Texte.SummeEigene, eigene);
        if (a.IdGebaeude is not int id)
            return Texte.SummeNutzungsart + " · " + (eigene == 0 ? Texte.SummeKeineEigenen : eigeneText);

        ZapfprofilGebaeudekalenderDaten? gk = Gebaeudekalender(id);
        int geerbt = gk?.Ferien.Count ?? 0;
        string ferien = eigene > 0 ? eigeneText
                      : geerbt == 0 ? Texte.SummeKeineFerien
                      : geerbt == 1 ? Texte.SummeFerienEins : Format(Texte.SummeFerien, geerbt);
        string feiertage = string.IsNullOrEmpty(gk?.Feiertagsland)
            ? Texte.SummeBundeseinheitlich : Format(Texte.SummeFeiertage, gk!.Feiertagsland);
        return Format(Texte.SummeGebaeude, Gebaeudename(id)) + " · " + ferien + " · " + feiertage;
    }

