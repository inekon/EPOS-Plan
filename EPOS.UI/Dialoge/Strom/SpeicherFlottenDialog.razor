@namespace EPOS.UI.Dialoge.Strom
@using WindowsFormsApplication1
@using SpeicherEngine

<div class="epos-flotten-dialog">
    @if (_projektAktiv) { <p role="status"><strong>Eine Speicherflotte ist für die Projektsimulation aktiviert.</strong> Bis zum nächsten erfolgreichen Projektlauf bleibt die zuletzt erfolgreich berechnete Flotte wirksam. <button type="button" class="epos-knopf" disabled="@(_laeuft || ProjektDeaktivieren is null)" @onclick="ProjektflotteDeaktivieren">Projektflotte deaktivieren</button></p> }
    <p class="epos-herleitung">Aktuelle Flotteneinstellungen gelten nach dem Speichern und dem nächsten erfolgreichen Projektlauf.</p>
    <p class="epos-herleitung">Mehrere Speicher werden gemeinsam am Netzanschluss simuliert. Jeder Speicher behält seinen eigenen Ladezustand. Verglichen wird mit demselben Standort ohne zusätzliche Speicher.</p>
    <Reiter Bezeichnung="Mehrspeicher-Auslegung" @bind-Aktiv="_reiter">
        <KindInhalt>
            <Reiterblatt Schluessel="FLOTTE" Titel="Speicher & Betriebsführung">
                <KindInhalt>
                    <SpeicherFlottenEditor Wert="@Flotte" WertChanged="FlotteGeaendert" Aktiv="@(!_laeuft)" />
                </KindInhalt>
            </Reiterblatt>
            <Reiterblatt Schluessel="QUELLEN" Titel="Daten, Kosten & Profile">
                <KindInhalt>
                    <p class="epos-herleitung">Die folgenden spezifischen Kostensätze gelten für alle Speicher ohne eigene Kostenvorgabe. Ein Auslegungsprofil speichert die gesamte Flotte einschließlich Betriebsführung und Datenquellen.</p>
                    <SpeicherAuslegungEditor Wert="@_eingaben" WertChanged="EingabenGeaendert" Aktiv="@(!_laeuft)"
                        NurQuellenKostenProfile="true" Auslegungsprofile="@_vorgaben.Auslegungsprofile"
                        Strompreisprofile="@_vorgaben.Strompreisprofile" Modulkosten="@_vorgaben.Modulkosten"
                        EinstellungenSpeichern="EinstellungenSichern" ProfilSpeichern="ProfilSichern" DateiWaehlen="DateiWaehlen" />
                </KindInhalt>
            </Reiterblatt>
            <Reiterblatt Schluessel="PROGNOSEN" Titel="Prognosen & Jahresdaten">
                <KindInhalt>
                    <p>PV-Planung, Preisarbitrage und Multi Use benötigen Prognosen. Im Modus „Idealwissen“ verwendet die Planung die zukünftigen Werte der importierten Standortreihe; das Ergebnis ist eine optimistische Vergleichsgrenze.</p>
                    <p>Archivierte Prognosen werden aus CSV-Zeilen mit Snapshot-ID, Entscheidungszeitpunkt, Bekanntheitszeitpunkt und Intervallwerten importiert. Es werden nur Daten verwendet, die zum Entscheidungszeitpunkt bekannt waren.</p>
                    <button type="button" class="epos-knopf" @onclick="@(() => FlottenCsvOeffnen(true))" disabled="@(_laeuft || DateiWaehlen is null)">Prognose-CSV importieren …</button>
                    <p>@Auslegung.FlottenPrognoseDatei · @Auslegung.FlottenPrognosen.Count Snapshots gespeichert</p>
                    <p>Für unterschiedliche Projektjahre können vollständige Jahresreihen aus CSV importiert werden. Das Kalenderjahr folgt aus dem Zeitstempel; jede Speicherlösung wird für jedes vollständige Jahr neu simuliert.</p>
                    <button type="button" class="epos-knopf" @onclick="@(() => FlottenCsvOeffnen(false))" disabled="@(_laeuft || DateiWaehlen is null)">Projektjahre-CSV importieren …</button>
                    <p>@Auslegung.FlottenJahresdatenDatei · @Auslegung.FlottenProjektjahre.Count Jahresreihen gespeichert</p>
                    @if (Auslegung.FlottenPrognosen.Count > 0)
                    {
                        <table class="epos-tabelle"><thead><tr><th>Snapshot</th><th>Bekannt seit</th><th>Entscheidung</th><th>Intervalle</th></tr></thead><tbody>
                            @foreach (var p in Auslegung.FlottenPrognosen.Take(20))
                            { <tr><td>@p.Id</td><td>@p.BekanntSeit.ToString("u")</td><td>@p.Entscheidungszeitpunkt.ToString("u")</td><td>@p.Intervalle.Count</td></tr> }
                        </tbody></table>
                    }
                </KindInhalt>
            </Reiterblatt>
            <Reiterblatt Schluessel="ERGEBNIS" Titel="Vergleich & Ergebnisse">
                <KindInhalt>
                    @if (_ergebnis is null) { <p>Noch kein Vergleich berechnet. Die Berechnung verwendet die gespeicherten Einstellungen und denselben Eingang für alle Varianten.</p> }
                    else
                    {
                        <SpeicherFlottenErgebnisAnsicht Ergebnis="_ergebnis" Veraltet="_veraltet" Csv="Csv" />
                        @if (ProjektUebernehmen is not null && _ergebnis.Studie?.Variante.Zulaessig == true && _ergebnis.Konfiguration.Einheiten.Count > 0)
                        { <button type="button" class="epos-knopf" disabled="@(_veraltet || _laeuft)" @onclick="ProjektflotteUebernehmen">Diese Flotte für die Projektsimulation aktivieren</button> }
                        @if (_ergebnis.Auslegung?.BesteKonfiguration is not null && !_ergebnis.Auslegung.NullvarianteGewonnen)
                        { <button type="button" class="epos-knopf" disabled="@(_veraltet || _laeuft)" @onclick="BesteFlotteUebernehmen">Beste Flotte in die Auslegung übernehmen</button> }
                    }
                </KindInhalt>
            </Reiterblatt>
        </KindInhalt>
    </Reiter>
    <div class="epos-flotten-aktionen">
        <Schalter Bezeichnung="Speicheranzahl und Größenbereiche optimieren" Wert="@Auslegung.FlottenGroessenOptimieren"
            Aktiv="@(!_laeuft)" WertChanged="SuchlaufSetzen" />
        <button type="button" class="epos-knopf" disabled="@(_laeuft || Rechnen is null || Eingabefehler.Length > 0)" @onclick="Starten">@(_laeuft ? "Berechnung läuft …" : "Speichervergleich berechnen")</button>
        <button type="button" class="epos-knopf" disabled="@_laeuft" @onclick="Geschlossen">Schließen</button>
    </div>
    @if (Eingabefehler.Length > 0) { <Warnbanner Stufe="WarnStufe.Warnung" Text="@Eingabefehler" /> }
    <Fortschritt Sichtbar="_laeuft" Anteil="_anteil" Text="@_fortschritt" Abbrechen="@(Abbrechen.HasDelegate ? Abbrechen : (EventCallback?)null)" AbbrechenText="Abbrechen" />
    @if (_fehler.Length > 0) { <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" /> }
    @if (_projektMeldung.Length > 0) { <p role="status">@_projektMeldung</p> }
    @if (!string.IsNullOrWhiteSpace(Meldung)) { <p>@Meldung</p> }
</div>

@if (_flottenCsvDatei is not null)
{
    <Ueberlagerung Offen="true" Titel="@_flottenCsvDatei.Dateiname" Zusatzklasse="epos-ueberlagerung--breit" Geschlossen="FlottenCsvSchliessen">
        <KindInhalt>
            <SpeicherFlottenCsvDialog Datei="@_flottenCsvDatei" Prognosen="@_flottenCsvPrognosen"
                Optionen="@(_flottenCsvPrognosen ? Auslegung.FlottenPrognoseCsvOptionen : Auslegung.FlottenJahresCsvOptionen)"
                PrognosenUebernommen="PrognosenUebernehmen" JahresdatenUebernommen="JahresdatenUebernehmen"
                Geschlossen="FlottenCsvSchliessen" />
        </KindInhalt>
    </Ueberlagerung>
}

@code {
    [Parameter] public Func<SpeicherOptimierungVorgaben>? Vorgaben { get; set; }
    [Parameter] public Func<SpeicherOptimierungEingaben, Action<double?, string>, Task<SpeicherFlottenErgebnis>>? Rechnen { get; set; }
    [Parameter] public EventCallback Abbrechen { get; set; }
    [Parameter] public Func<SpeicherOptimierungEingaben, Task<string>>? EinstellungenSpeichern { get; set; }
    [Parameter] public Func<SpeicherOptimierungEingaben, string, Task<SpeicherOptimierungVorgaben>>? ProfilSpeichern { get; set; }
    [Parameter] public Func<Task<SpeicherImportDatei>>? DateiWaehlen { get; set; }
    [Parameter] public EventCallback<string> Csv { get; set; }
    [Parameter] public EventCallback Geschlossen { get; set; }
    [Parameter] public string Meldung { get; set; } = "";
    [Parameter] public Func<bool>? ProjektAktiv { get; set; }
    [Parameter] public Func<SpeicherFlottenErgebnis, Task<string>>? ProjektUebernehmen { get; set; }
    [Parameter] public Func<Task<string>>? ProjektDeaktivieren { get; set; }
    private SpeicherOptimierungVorgaben _vorgaben = new();
    private SpeicherOptimierungEingaben _eingaben = new();
    private SpeicherFlottenErgebnis? _ergebnis;
    private string _reiter = "FLOTTE", _fehler = "", _fortschritt = "";
    private bool _laeuft, _veraltet, _projektAktiv;
    private string _projektMeldung = "";
    private double? _anteil;
    private SpeicherImportDatei? _flottenCsvDatei;
    private bool _flottenCsvPrognosen;
    private string Eingabefehler => EingabenPruefen();
    private SpeicherAuslegungKonfiguration Auslegung => _eingaben.Auslegung ??= new();
    private FlottenStudieKonfiguration Flotte => Auslegung.Flotte ??= new();
    protected override void OnInitialized()
    {
        try { _vorgaben = Vorgaben?.Invoke() ?? new(); _eingaben = _vorgaben.Eingaben.Kopie(); _projektAktiv = ProjektAktiv?.Invoke() == true; }
        catch (Exception ex) { _fehler = ex.Message; }
    }
    private void Geaendert() { _fehler = ""; _veraltet = _ergebnis is not null; }
    private void FlotteGeaendert(FlottenStudieKonfiguration f) { Auslegung.Flotte = SpeicherAuslegungKopie.Von(f); Geaendert(); }
    private void EingabenGeaendert(SpeicherOptimierungEingaben e) { _eingaben = e.Kopie(); Geaendert(); }
    private void SuchlaufSetzen(bool wert) { Auslegung.FlottenGroessenOptimieren = wert; Geaendert(); }
    private async Task<SpeicherOptimierungVorgaben> ProfilSichern(SpeicherOptimierungEingaben e, string name)
    {
        if (ProfilSpeichern is null) throw new InvalidOperationException("Die Profilspeicherung ist nicht verfügbar.");
        _fehler = "";
        await InvokeAsync(StateHasChanged);
        _vorgaben = await ProfilSpeichern(e.Kopie(), name);
        return _vorgaben;
    }
    private async Task<string> EinstellungenSichern(SpeicherOptimierungEingaben e)
    {
        if (EinstellungenSpeichern is null) throw new InvalidOperationException("Die Speicherung der Einstellungen ist nicht verfügbar.");
        _fehler = "";
        await InvokeAsync(StateHasChanged);
        return await EinstellungenSpeichern(e.Kopie()) ?? "";
    }
    private async Task FlottenCsvOeffnen(bool prognosen)
    {
        if (DateiWaehlen is null) return;
        try
        {
            var datei = await DateiWaehlen();
            if (datei is null || datei.Inhalt.Length == 0) return;
            _flottenCsvPrognosen = prognosen;
            _flottenCsvDatei = datei;
            _fehler = "";
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }
    private void FlottenCsvSchliessen() => _flottenCsvDatei = null;
    private Task PrognosenUebernehmen(List<FlottenPrognoseSnapshot> snapshots, SpeicherFlottenCsvOptionen optionen)
    {
        Auslegung.FlottenPrognosen = snapshots;
        Auslegung.FlottenPrognoseDatei = _flottenCsvDatei?.Dateiname ?? "";
        Auslegung.FlottenPrognoseCsvOptionen = SpeicherAuslegungKopie.Von(optionen);
        _flottenCsvDatei = null;
        Geaendert();
        return Task.CompletedTask;
    }
    private Task JahresdatenUebernehmen(List<FlottenProjektjahr> jahre, SpeicherFlottenCsvOptionen optionen)
    {
        Auslegung.FlottenProjektjahre = jahre;
        Auslegung.FlottenJahresdatenDatei = _flottenCsvDatei?.Dateiname ?? "";
        Auslegung.FlottenJahresCsvOptionen = SpeicherAuslegungKopie.Von(optionen);
        _flottenCsvDatei = null;
        Geaendert();
        return Task.CompletedTask;
    }
    private async Task Starten()
    {
        if (_laeuft || Rechnen is null) return;
        string eingabefehler = Eingabefehler;
        if (eingabefehler.Length > 0) { _fehler = eingabefehler; return; }
        _laeuft = true; _fehler = ""; _anteil = null; _fortschritt = "Zeitreihen und Kosten prüfen …";
        try
        {
            var stand = _eingaben.Kopie();
            var e = await Rechnen(stand, (anteil, text) => { _ = InvokeAsync(() => { _anteil = anteil; _fortschritt = text; StateHasChanged(); }); });
            if (!e.Erfolg) _fehler = e.Abgebrochen ? "Berechnung abgebrochen." : e.Meldung;
            else { _ergebnis = e; _veraltet = false; _reiter = "ERGEBNIS"; }
        }
        catch (Exception ex) { _fehler = ex.Message; }
        finally { _laeuft = false; }
    }
    private string EingabenPruefen()
    {
        var fehler = new List<string>();
        if (Flotte.Wirtschaftlichkeit.ProjektjahreBeiWiederholung <= 0)
            fehler.Add("Projektlaufzeit: Bitte mindestens 1 Jahr eingeben.");
        if (Flotte.Einheiten.Count > 0 && Flotte.Optionen.Endbedingung == FlottenEndbedingung.KeineVorgabe &&
            Flotte.Optionen.EnergieAusgleichEuroProKWh is null)
            fehler.Add("Energie-Ausgleichswert: Ohne gleiche Endenergie ist ein Wert erforderlich.");
        foreach (FlottenEinheit einheit in Flotte.Einheiten)
        {
            if (!double.IsFinite(einheit.SocMin) || !double.IsFinite(einheit.SocStart) || !double.IsFinite(einheit.SocMax) ||
                einheit.SocMin < 0 || einheit.SocMin > einheit.SocStart || einheit.SocStart > einheit.SocMax || einheit.SocMax > 1)
                fehler.Add($"Speicher '{(string.IsNullOrWhiteSpace(einheit.Name) ? einheit.Id : einheit.Name)}': SoC-Minimum, Start-SoC und SoC-Maximum müssen in dieser Reihenfolge zwischen 0 und 100 % liegen.");
        }
        if (Auslegung.FlottenGroessenOptimieren)
        {
            foreach (FlottenAuslegungsAchse achse in Flotte.Auslegung.Achsen.Where(x => x.Aktiv))
            {
                string name = string.IsNullOrWhiteSpace(achse.Vorlage.Name) ? achse.Vorlage.Id : achse.Vorlage.Name;
                if (achse.AnzahlVon < 0 || achse.AnzahlBis < achse.AnzahlVon)
                    fehler.Add($"Größenbereich '{name}' – Anzahl: Von muss mindestens 0 und Bis mindestens Von sein.");
                if (achse.Modus != FlottenAuslegungsmodus.LeistungUndCRate && UngueltigerBereich(achse.KapazitaetVonKWh, achse.KapazitaetBisKWh, achse.KapazitaetSchrittKWh))
                    fehler.Add($"Größenbereich '{name}' – Kapazität [kWh]: Von muss positiv, Bis mindestens Von und der Schritt bei einem Bereich positiv sein.");
                if (achse.Modus != FlottenAuslegungsmodus.KapazitaetUndCRate && UngueltigerBereich(achse.LeistungVonKw, achse.LeistungBisKw, achse.LeistungSchrittKw))
                    fehler.Add($"Größenbereich '{name}' – Leistung [kW]: Von muss positiv, Bis mindestens Von und der Schritt bei einem Bereich positiv sein.");
                if (achse.Modus != FlottenAuslegungsmodus.KapazitaetUndLeistung && UngueltigerBereich(achse.CRateVon, achse.CRateBis, achse.CRateSchritt))
                    fehler.Add($"Größenbereich '{name}' – C-Rate [1/h]: Von muss positiv, Bis mindestens Von und der Schritt bei einem Bereich positiv sein.");
            }
        }
        return string.Join(" ", fehler);
    }
    private static bool UngueltigerBereich(double von, double bis, double schritt) =>
        !double.IsFinite(von) || !double.IsFinite(bis) || von <= 0 || bis < von ||
        (bis > von && (!double.IsFinite(schritt) || schritt <= 0));
    private async Task ProjektflotteUebernehmen()
    {
        if (_veraltet || _ergebnis is null || ProjektUebernehmen is null) return;
        try
        {
            _fehler = await ProjektUebernehmen(_ergebnis);
            if (_fehler.Length > 0) return;
            _projektAktiv = true;
            _projektMeldung = "Flotte aktiviert. Bitte die Projektsimulation neu berechnen; die bisherigen Projektergebnisse gehören noch zum alten Stand. Die Kostenbewertung der Flottenstudie bleibt im Variantenvergleich.";
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }
    private async Task ProjektflotteDeaktivieren()
    {
        if (ProjektDeaktivieren is null) return;
        try
        {
            _fehler = await ProjektDeaktivieren();
            if (_fehler.Length > 0) return;
            _projektAktiv = false;
            _projektMeldung = "Projektflotte deaktiviert. Die Projektsimulation verwendet die Einzelvariante, bis Flotteneinstellungen erneut gespeichert und das Projekt neu berechnet werden.";
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }
    private async Task BesteFlotteUebernehmen()
    {
        if (_veraltet || _ergebnis?.Auslegung?.BesteKonfiguration is null) return;
        Auslegung.Flotte = SpeicherAuslegungKopie.Von(_ergebnis.Auslegung.BesteKonfiguration);
        Auslegung.Flotte.Auslegung.Achsen.Clear();
        Auslegung.FlottenGroessenOptimieren = false;
        Geaendert();
        try
        {
            if (EinstellungenSpeichern is not null)
            {
                _fehler = await EinstellungenSpeichern(_eingaben.Kopie());
                if (!string.IsNullOrEmpty(_fehler)) return;
            }
            _reiter = "FLOTTE"; Geaendert();
        }
        catch (Exception ex) { _fehler = ex.Message; }
    }
}
