@* Eingabe der Solarkollektoren - der PROJEKTDIALOG (iU9-W7.7).

   VORBILD. Views/Solarthermie/Form_SolarKollektoren (513 Z.). Dasselbe Muster wie Heizkessel,
   BHKW und Stromspeicher: oben die Kollektoren im Projekt, darunter der Katalog, unten die
   Detailzeile „gewaehlter Satz".

   KATALOGAUSWAHL V1, STUFE 3 (Konzept Projektdialoge mit Katalogauswahl 4.2, 4.6, 4.9):
   Summe Module in der Projekt-Kopfleiste, Bearbeiten… und „In die Datenbank übernehmen…" im
   Projekt, Vergleichen…, Schloss…, Loeschen, Bearbeiten… im Katalogfuss, Neu… rechts (erst der
   Name, dann der Katalogeditor), Kostenknoepfe und die Felder der Anlage (Modulanzahl, Neigung,
   Azimut, Albedo, Solarkreis, Senken) nur beim Projektsatz, Alle Daten auch fuer die Projektkopie.

   DIE FELDER DER ANLAGE schreibt weiter erst der Knopf „Übernehmen" in die Zeile (Hausregel
   „Geschrieben wird im OK-Weg"); den Arbeitsstand fuehrt SolarkollektorenEingaben, den auch der
   Hilfe-Assistent liest und setzt. Vor- und Ruecklauf fuehrt der Kollektor nicht - sie haben
   keinen Rechenweg.

   ZWEI KOLLEKTOREN GLEICHEN NAMENS teilen sich die Projektkopie; die Projektzeile liest ihr
   Detail deshalb ueber die Geraete-ID (ProjektDetail), nicht ueber den Namen.

   TASTATUR: Esc schliesst, aber erst, wenn keine Ueberlagerung und keine Rueckfrage offen ist.
   Enter ist nicht belegt.

   ENTSCHEID #76 (05.09.2026). Die zwei Listen stehen im Baustein Zweispaltenauswahl - EIN
   Aufbau fuer alle Projekt/Datenbank-Dialoge des Hauses. *@
@namespace EPOS.UI.Dialoge.Solarthermie
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Kosten
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable


<div class="epos-dialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* KONTEXT IM DIALOGKOPF (Katalogauswahl V1, 4.1 und 4.8). *@
    <div class="epos-dialog-kopf">
        <h1 class="epos-dialog-titel">@TitelText</h1>
        <span class="epos-dialog-kontext" title="@KopfbandText">@KopfbandText</span>
        <InfoKnopf Schluessel="@HilfeSchluessel" />
        <Schliesskreuz Geschlossen="Abbrechen" />
    </div>

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }
    @* KT-3: Wirft das Lesen der Katalogliste, nennt dieser Banner den Grund (Katalogladung). *@
    @if (!string.IsNullOrEmpty(_listeFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_listeFehler" />
    }

    @* P = Kopfleiste „Im Projekt" (Summe Module, Bearbeiten…, In die Datenbank übernehmen…,
       Entfernen), K = Kopf- und Fussleiste des Katalogs, S = Detailzeile „gewaehlter Satz",
       D = Kopf und Fuss des Dialogs. Beide Listen fuehren eine Mehrfachwahl. *@
    <Zweispaltenauswahl Dialogname="Solarkollektoren" LinksTitel="@LabelProjektliste" RechtsTitel="@LabelKatalogliste"
                        KatalogZeile="@((int)Katalogliste.ZEILENHOEHE_ZEILENWAHL)"
                        UebernehmenText="@LabelHinzu"
                        UebernehmenGesperrt="@(KatalogZiele().Count == 0)" Uebernehmen="BeiHinzu"
                        EntfernenText="@LabelEntfernen"
                        EntfernenGesperrt="@(ProjektZiele().Count == 0)" Entfernen="BeiEntfernen"
                        ProjektWahl="@_projektWahl" ProjektSichtbar="@ProjektSchluessel()"
                        KatalogWahl="@_katalogWahl" KatalogSichtbar="@KatalogSichtbar()"
                        WahlGeaendert="BeiWahlGeaendert"
                        KatalogFussName="@_katalogZeile?.Bezeichner"
                        SatzArt="@SatzArt" SatzName="@SatzName" SatzKenndaten="@SatzKenndaten">

        <ProjektKopf>
            <span class="epos-zweispalten-summe">@LabelSumme <b>@Summe</b></span>
        </ProjektKopf>

        <Leistenzusatz>
            @if (ProjektsatzWege is not null)
            {
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--bearbeiten-projekt"
                        title="@Resource.AUSWAHL_BTN_BEARBEITEN_PROJEKT_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiProjektBearbeiten">@Resource.AUSWAHL_BTN_BEARBEITEN</button>
            }
            @if (RueckwegWege is not null)
            {
                @* KA-E-9: der Rueckweg in die Datenbank, wirksam auf die Auswahl der Projektliste. *@
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-knopf--rueckweg"
                        title="@Resource.KATRUECK_BTN_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiRueckweg">@Resource.KATRUECK_BTN</button>
            }
        </Leistenzusatz>

        <Links>
            <Raster TZeile="ErzeugerZeile" Zeilen="@Zeilen.AsQueryable()">
                <KindInhalt>
                    <TemplateColumn TGridItem="ErzeugerZeile" Class="epos-spalte-kaestchen">
                        <HeaderTemplate>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" />
                        </HeaderTemplate>
                        <ChildContent>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" Schluessel="@Projektschluessel(context)"
                                           Kurztext="@context.Bezeichner" />
                        </ChildContent>
                    </TemplateColumn>
                    <TemplateColumn TGridItem="ErzeugerZeile" Title="@SpalteWahl">
                        <Zeilenwahl Gewaehlt="@(_projektZeile == context)" Kurztext="@SpalteWahl"
                                    Gewaehltwerden="() => ProjektZeileKlick(context)" />
                    </TemplateColumn>
                    <PropertyColumn TGridItem="ErzeugerZeile" TProp="string"
                                    Property="@(z => z.Bezeichner)" Title="@SpalteName" />
                </KindInhalt>
            </Raster>
        </Links>

        <Rechts>
            @* DIE EINE KATALOGLISTE (W14a-E-10) im Kaestchenmodus: Die Zeile ist die Wahl
               (Detailzeile), das Kaestchen waehlt mehrere fuer die Bereichsaktionen. *@
            <Katalogliste @ref="_katalogliste" Profil="@Katalogprofil" Zeilen="@_katalog"
                          Filterstand="@_filterstand" Texte="@Filtertexte"
                          Gewaehlt="@_katalogGewaehlt" GewaehltChanged="KatalogZeileWaehlen"
                          Vergleichsparameter="@Vergleichsparameter"
                          ZeileIstWahl="true" Kaestchen="true" Gewaehlte="@_katalogKaestchen"
                          GewaehlteChanged="BeiKatalogKaestchen" Gefiltert="BeiGefiltert" />
        </Rechts>

        <KatalogFuss>
            <button type="button" class="epos-knopf epos-knopf--vergleichen"
                    title="@Resource.AUSWAHL_BTN_VERGLEICHEN_HINWEIS"
                    disabled="@(KatalogZiele().Count < 2)" @onclick="BeiVergleichen">@Resource.AUSWAHL_BTN_VERGLEICHEN</button>
            <Katalogschloss @ref="_katalogschloss" Weg="@Schloss" Zeile="@_katalogZeile"
                            Ungespeichert="@_felderGeaendert" JaText="@JaText" NeinText="@NeinText"
                            Geschaltet="BeiSchlossGeschaltet" Abgelehnt="BeiSchlossAbgelehnt" />
            @if (KatalogLoeschen is not null)
            {
                <button type="button" class="epos-knopf epos-knopf--loeschen" disabled="@(KatalogZiele().Count == 0)"
                        @onclick="BeiLoeschenGefragt">@BtnLoeschenText</button>
            }
            <button type="button" class="epos-knopf epos-knopf--bearbeiten-katalog"
                    title="@(KatalogZiele().Count > 0 && KatalogZiele().All(z => z.Geschuetzt) ? Resource.ADM_SCHLOSS_ERST_AUFHEBEN : Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS)"
                    disabled="@(KatalogZiele().Count == 0)" @onclick="BeiKatalogBearbeiten">@BtnBearbeitenText</button>
        </KatalogFuss>

        <KatalogFussRechts>
            @if (EditorGaben is not null)
            {
                <button type="button" class="epos-knopf epos-knopf--neu" @onclick="() => _namensfrage = true">@BtnNeuText</button>
            }
        </KatalogFussRechts>

        <Satz>
        @* DIE KNOPFZEILE DER SATZFLAECHE: beim Projektsatz die Kostenknoepfe (KA-E-12, nur
           Investition und Betrieb - die Sonne ist kein gekaufter Traeger), rechts der Weg in die
           Wikirubriken Grundlagen und Berechnung. *@
        <div class="epos-leiste">
            @if (!Wizard && _projektZeile is not null)
            {
                <KostenKnoepfeLeiste KostenOeffnen="@KostenLeiste"
                                     InvestText="@KostenInvestText" BetriebText="@KostenBetriebText" />
            }
            <span class="epos-leiste-fueller"></span>
            <span class="epos-berechnungshilfe">
                <InfoKnopf Schluessel="Form_SolarKollektoren.Grundlagen"
                           StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
                <InfoKnopf Schluessel="Form_SolarKollektoren.Berechnung"
                           StandardKurztext="Berechnungsweg Solarthermie" MitAssistent="false" />
            </span>
        </div>

        @if (_projektZeile is null && _katalogZeile is null)
        {
            <p class="epos-zweispalten-satzleer">@Resource.AUSWAHL_SATZ_LEER</p>
        }
        else
        {
            <Formularraster>
                <KindInhalt>
                <Textfeld Bezeichnung="@LabelName" Wert="@_detail.Bezeichner" NurLesen="true" />
                @foreach (var feld in _detail.Felder)
                {
                    <Textfeld Bezeichnung="@feld.Feld" Wert="@feld.Wert" NurLesen="true"
                              Kurz="@ErzeugerDetail.IstZahl(feld.Wert)" />
                }
                </KindInhalt>
            </Formularraster>

            @* DIE FELDER DER ANLAGE stehen NUR beim Projektsatz (4.2: S aufgeklappt) - ein
               Katalogsatz hat keine Ausrichtung und keinen Solarkreis. *@
            @if (_projektZeile is not null)
            {
                <Gruppenkopf Titel="@GruppeKollektor">
                    <KindInhalt>
                        <Formularraster>
                            <KindInhalt>
                        <Ganzzahlfeld Bezeichnung="@LabelAnzahl" Feldname="@LabelAnzahl"
                                      Wert="@_eingaben.Anzahl" WertChanged="w => { _eingaben.Anzahl = w; }" />
                        <Textfeld Bezeichnung="@LabelAperturflaeche" Wert="@Gesamtflaeche" NurLesen="true"
                                  Kurz="true" />
                        <Ganzzahlfeld Bezeichnung="@LabelNeigung" Feldname="@LabelNeigung"
                                      Wert="@_eingaben.Neigung" WertChanged="w => { _eingaben.Neigung = w; }" />
                        <Ganzzahlfeld Bezeichnung="@LabelAzimut" Feldname="@LabelAzimut"
                                      Wert="@_eingaben.Azimut" WertChanged="w => { _eingaben.Azimut = w; }" />
                        @* Die BODENALBEDO vor dem Kollektorfeld (Entscheidungsvorlage Modellgrenzen, PV4):
                           leer = 0,2; die Auswahlhilfe steht als Hinweis darunter. *@
                        <Zahlenfeld Bezeichnung="@LabelAlbedo" Feldname="@LabelAlbedo"
                                    Wert="@_eingaben.Albedo" Min="0" Max="1" Nachkommastellen="2"
                                    WertChanged="w => { _eingaben.Albedo = w; }" />
                        <Herleitungszeile Text="@HinweisAlbedo" />
                        @* SOLARKREIS (Welle M2 der Entscheidungsvorlage Modellgrenzen, ST1 bis ST4):
                           Pumpe, Verluste, Arbeitstemperatur mit Graedigkeit und Spreizung. Leer
                           heisst Vorgabe - der Platzhalter nennt sie. *@
                        <Zahlenfeld Bezeichnung="@Resource.SKV_LBL_PUMPENLEISTUNG" Feldname="@Resource.SKV_LBL_PUMPENLEISTUNG"
                                    Wert="@_eingaben.PumpenleistungW" Min="0" Max="10000" Platzhalter="0"
                                    WertChanged="w => { _eingaben.PumpenleistungW = w; }" />
                        <Zahlenfeld Bezeichnung="@Resource.SKV_LBL_VERLUSTE" Feldname="@Resource.SKV_LBL_VERLUSTE"
                                    Wert="@_eingaben.VerlusteProzent" Min="0" Max="50" Platzhalter="8"
                                    WertChanged="w => { _eingaben.VerlusteProzent = w; }" />
                        <Auswahlfeld Bezeichnung="@Resource.SKV_LBL_ARBEITSTEMPERATUR" Eintraege="@ArbeitstemperaturWege"
                                     Auswahl="@(_eingaben.ArbeitstemperaturAusSpeicher ? 1 : 0)"
                                     AuswahlChanged="w => { _eingaben.ArbeitstemperaturAusSpeicher = w == 1; }" />
                        <Zahlenfeld Bezeichnung="@Resource.SKV_LBL_GRAEDIGKEIT" Feldname="@Resource.SKV_LBL_GRAEDIGKEIT"
                                    Wert="@_eingaben.GraedigkeitK" Min="0" Max="30" Platzhalter="5"
                                    Aktiv="@_eingaben.ArbeitstemperaturAusSpeicher"
                                    WertChanged="w => { _eingaben.GraedigkeitK = w; }" />
                        <Zahlenfeld Bezeichnung="@Resource.SKV_LBL_SPREIZUNG" Feldname="@Resource.SKV_LBL_SPREIZUNG"
                                    Wert="@_eingaben.SpreizungK" Min="0" Max="30" Platzhalter="10"
                                    Aktiv="@_eingaben.ArbeitstemperaturAusSpeicher"
                                    WertChanged="w => { _eingaben.SpreizungK = w; }" />
                        <Herleitungszeile Text="@(_eingaben.ArbeitstemperaturAusSpeicher
                                                  ? Resource.SKV_HINT_ARBEITSTEMPERATUR_SPEICHER
                                                  : Resource.SKV_HINT_ARBEITSTEMPERATUR_FEST)" />
                        @if (_eingaben.ArbeitstemperaturAusSpeicher)
                        {
                            <Herleitungszeile Text="@Resource.SKV_HINT_GRAEDIGKEIT" />
                        }
                        <Herleitungszeile Text="@Resource.SKV_HINT_PUMPE" />
                        @* DIE SENKEN DER ANLAGE (Anwenderentscheid 23.09.2026): Ohne Senke fuer ihren
                           Bedarf findet das Kollektorfeld keinen Abnehmer. *@
                        @if (!string.IsNullOrEmpty(_projektZeile.Senken))
                        {
                            <Herleitungszeile Text="@_projektZeile.Senken" />
                        }
                            </KindInhalt>
                        </Formularraster>
                        <div class="epos-leiste">
                            <button type="button" class="epos-knopf epos-knopf--uebernehmen-anlage"
                                    @onclick="BeiUebernehmen">@BtnUebernehmenText</button>
                        </div>
                    </KindInhalt>
                </Gruppenkopf>
            }

            @* ALLE DATEN DES GEWAEHLTEN SATZES, aufklappbar und BEARBEITBAR: beim Katalogsatz der
               Katalog (gesperrt nur lesen), beim Projektsatz die Projektkopie - dieselben Felder
               samt den Investitionskosten. *@
            @if (AlleDatenDa)
            {
                <div class="epos-modulparameter">
                    <button type="button" class="epos-modulparameter-knopf"
                            aria-expanded="@(_parameterOffen ? "true" : "false")"
                            @onclick="ParameterUmschalten">
                        <span class="epos-modulparameter-pfeil" aria-hidden="true">@(_parameterOffen ? "▾" : "▸")</span>
                        <span>@LabelAlleParameter</span>
                    </button>

                    @if (_parameterOffen && _felder is not null)
                    {
                        @if (KatalogsatzGesperrt)
                        {
                            <p class="epos-satzbearbeitung-hinweis" role="note">@Resource.SATZBEARB_NUR_LESEN @Resource.ADM_SCHLOSS_ERST_AUFHEBEN</p>
                        }
                        <Katalogfelder Felder="@_felder" NurLesen="@(!FelderSpeicherbar)"
                                       Geaendert="FeldGeaendert"
                                       FehlerZustand="BeiFeldFehler" />

                        @if (FelderSpeicherbar)
                        {
                            <div class="epos-leiste">
                                <Speichervermerk @ref="_felderVermerk" Text="@BtnFelderSpeichernText"
                                                 Geaendert="@_felderGeaendert" Gesperrt="@_feldFehler"
                                                 Satz="@SatzName" Speichern="FelderSpeichern" />
                            </div>
                        }
                    }
                </div>
            }
        }
        </Satz>
    </Zweispaltenauswahl>

    @if (!Wizard)
    {
        <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />
    }

    @* --- Ueberlagerung 1: der Katalogeditor (ein ungesperrter Katalogsatz, KA-E-13, oder Neu…) *@
    <Ueberlagerung Offen="@(_editorGaben is not null)"
                   Titel="@(_editorNeu ? BtnKatalogNeuText : BtnKatalogAendernText)"
                   Kopfzusatz="@MarkeKatalogsatz" Geschlossen="() => EditorFertig(false)">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                @* Ein Titel, eine Stelle: die Ueberlagerung traegt Titel UND Kreuz,
                   also zeigt der Editor keinen eigenen Kopf. *@
                <SolarkollektorKatalogDialog @attributes="_editorGaben" TitelText=""
                                             Geschlossen="EditorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- „Neu…": erst der Name, dann der Editor ------------------------------- *@
    <Ueberlagerung Offen="@_namensfrage" Titel="@BtnKatalogNeuText"
                   Geschlossen="() => NameFertig(null)">
        <KindInhalt>
            <NamensDialog TitelText="" FrageText="@LabelName"
                          OkText="@OkText" AbbrechenText="@AbbrechenText"
                          Geschlossen="NameFertig" />
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 2: Bearbeiten… je Bereich, auch mehrere Saetze (4.6) ---- *@
    <Ueberlagerung Offen="@(_bearbeitung is not null)"
                   Titel="@(_bearbeitung is null ? "" : Satzbearbeitungsregel.Titel(_bearbeitung.Value.Art, _bearbeitung.Value.Saetze))"
                   Kopfzusatz="@(_bearbeitung?.Art == Satzmarke.Projektsatz ? MarkeProjektsatz : MarkeKatalogsatz)"
                   Geschlossen="() => BearbeitungFertig(false)">
        <KindInhalt>
            @if (_bearbeitung is { } b)
            {
                <Satzbearbeitung Art="@b.Art" Saetze="@b.Saetze"
                                 Wege="@(b.Art == Satzmarke.Projektsatz ? ProjektsatzWege : KatalogsatzWege)"
                                 Geschlossen="BearbeitungFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Ueberlagerung 3: Rueckfrage „In die Datenbank übernehmen…" (5.2, KA-E-9) - immer vor dem Schreiben *@
    <Ueberlagerung Offen="@(_rueckweg is not null)"
                   Titel="@(_rueckweg is null ? "" : Rueckwegregel.Titel(_rueckweg))"
                   Kopfzusatz="@MarkeKatalogsatz" Geschlossen="() => RueckwegFertig(null)">
        <KindInhalt>
            @if (_rueckweg is not null && RueckwegWege is not null)
            {
                <Rueckwegfrage Zeilen="@_rueckweg" Wege="@RueckwegWege" BleibtText="@RueckwegBleibtText"
                               Geschlossen="RueckwegFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    @* --- Rueckfrage vor dem Loeschen aus dem KATALOG ------------------------- *@
    <Rueckfrage Offen="@_loeschfrage" TitelText="@TitelLoeschen" JaText="@JaText" NeinText="@NeinText"
                Frage="@LoeschfrageText" Beantwortet="BeiLoeschfrage" />
</div>

@code {
    // =================================================================================
    // Daten
    // =================================================================================

    /// <summary>Die Kollektoren im Projekt (Projektliste) — sie gehört der Hülle und wird in place bearbeitet.</summary>
    [Parameter] public List<ErzeugerZeile> Zeilen { get; set; } = new();

    /// <summary>Das Profil der Katalogliste (<c>Katalogfilterprofil.MitVerwendung(Anlagenart.Solarkollektoren, …)</c>).</summary>
    [Parameter] public Katalogfilterprofil? Katalogprofil { get; set; }

    /// <summary>Die Zeilen des Vergleichs je Satzname (W14a-E-10, S3.3).</summary>
    [Parameter] public Func<string, IReadOnlyList<Parameterwert>>? Vergleichsparameter { get; set; }

    /// <summary>Die Zeilen der Katalogliste, ungefiltert; nach jeder Katalogpflege neu erfragt.</summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalogzeilen { get; set; }

    [Parameter] public Katalogfiltertexte Filtertexte { get; set; } = new();

    /// <summary>Der Filterstand des Katalogs für die Sitzung (S2.5); leer = Register.</summary>
    [Parameter] public Katalogfilterstand? Filterstandvorgabe { get; set; }

    /// <summary>Der Detailblock eines KATALOGsatzes nach Namen.</summary>
    [Parameter] public Func<string, ErzeugerDetail?>? Detail { get; set; }

    /// <summary>
    /// Der Detailblock einer PROJEKTzeile — aus der Projektkopie über die Geräte-ID (im Assistenten aus dem
    /// Katalog). Ohne Delegat gilt <see cref="Detail"/> mit dem Namen der Zeile.
    /// </summary>
    [Parameter] public Func<ErzeugerZeile, ErzeugerDetail?>? ProjektDetail { get; set; }

    /// <summary>Die Fläche EINES Moduls eines Katalogsatzes nach Namen (für die Aperturfläche des Felds).</summary>
    [Parameter] public Func<string, double>? Modulflaeche { get; set; }

    /// <summary>Die Fläche eines Moduls der Projektkopie einer Zeile; ohne Delegat gilt <see cref="Modulflaeche"/>.</summary>
    [Parameter] public Func<ErzeugerZeile, double>? ProjektModulflaeche { get; set; }

    /// <summary>Nimmt den Kollektor auf (Stamm-ID) — die Projektkopie entsteht sofort (Projektkopievormerkung).</summary>
    [Parameter] public Func<int, AufnahmeErgebnis>? Aufnehmen { get; set; }

    /// <summary>Entfernt die Zeile aus der geteilten Liste.</summary>
    [Parameter] public Action<ErzeugerZeile>? Entfernen { get; set; }

    /// <summary>Schreibt die Felder der Anlage (Modulanzahl, Neigung, Azimut, Albedo, Solarkreis) in das Modell.</summary>
    [Parameter] public Action<ErzeugerZeile>? Uebernehmen { get; set; }

    /// <summary>Die Gaben des Katalogeditors (Name, neu?) — „Bearbeiten…" auf einen ungesperrten Satz und „Neu…".</summary>
    [Parameter] public Func<string, bool, IReadOnlyDictionary<string, object>>? EditorGaben { get; set; }

    /// <summary>Löscht einen Katalogsatz nach ID (KA-E-16 samt Satzvorlage); leer = gelöscht, sonst der Grund. <c>null</c> = kein Knopf.</summary>
    [Parameter] public Func<int, string>? KatalogLoeschen { get; set; }

    /// <summary>Die Felder des Aufklappers „Alle Daten" eines Katalogsatzes (dieselben wie im Katalogbrowser).</summary>
    [Parameter] public Func<string, IReadOnlyList<BrowserFeldwert>?>? Katalogfelder { get; set; }

    /// <summary>Schreibt die Felder des Aufklappers in den Katalogsatz; ein gesperrter Satz wird nie geschrieben.</summary>
    [Parameter]
    public Func<string, IReadOnlyList<BrowserFeldwert>, KatalogSpeicherErgebnis>?
        KatalogfelderSpeichern { get; set; }

    /// <summary>
    /// Die Wege der Satzbearbeitung für die PROJEKTKOPIEN (KA-E-8): Lesen nach Geräte-ID, Speichern aller Sätze in
    /// einer Transaktion. <c>null</c> = kein Knopf „Bearbeiten…" in der Projekt-Kopfleiste (Assistent).
    /// </summary>
