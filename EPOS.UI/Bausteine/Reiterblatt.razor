@* Ein Blatt der Reiterleiste (iU9-W5.0) - das Gegenstueck zur TabPage.

   Es meldet sich beim umgebenden <Reiter> an und zeichnet seinen Inhalt nur,
   wenn es das gewaehlte ist. Ein nicht gewaehltes Blatt gibt GAR NICHTS aus:
   Ein verstecktes, aber gezeichnetes Blatt haette seine Felder weiter im
   Tabulatorzyklus und seine Rueckrufe weiter am Leben - genau der Fehler, den
   ein TabControl nicht macht.

   VERZOEGERTER AUFBAU. Weil ein ungewaehltes Blatt nicht existiert, entsteht
   sein Inhalt erst beim ersten Betreten - dieselbe Zurueckhaltung, mit der
   UcBerichteKosten seine vier Seiten "lazy" erzeugte, nur ohne eigenen Code
   dafuer. Wer beim Betreten etwas nachladen will, nimmt Betreten.

   STATUSZEILE (Konzept Navigation Berichte & Kosten, Etappe A2). Ein Blatt darf
   unter seinem Titel einen KURZSTAND tragen - Status, Kurzform fuer schmale
   Fenster, Stufe Normal oder Warnung. Gezeichnet wird er vom Reiter im Knopf,
   denn er gehoert zur Leiste, nicht zum Blatt. Alle drei Werte sind freiwillig:
   Ohne Status bleibt der Knopf genau der alte, nur der Titel. *@

@namespace EPOS.UI.Bausteine
@implements IDisposable

@if (Sichtbar)
{
    <div class="epos-reiter-blatt" role="tabpanel" tabindex="0"
         id="@BlattId" aria-labelledby="@KnopfId">
        @KindInhalt
    </div>
}

@code {
    private string _titel = "";
    private bool _bedienbar = true;
    private string _sperrgrund = "";
    private string _status = "";
    private string _statusKurz = "";
    private Statusstufe _statusstufe = Statusstufe.Normal;

    /// <summary>Der umgebende Reiter (von <see cref="Reiter"/> herabgereicht).</summary>
    [CascadingParameter] public Reiter? Eltern { get; set; }

    /// <summary>Sprachneutraler Schluessel des Blattes - nie ein Anzeigetext.</summary>
    [Parameter] public string Schluessel { get; set; } = "";

    /// <summary>Beschriftung des Reiterknopfes.</summary>
    [Parameter] public string Titel { get; set; } = "";

    /// <summary>Bedienbar? <c>false</c> sperrt den Knopf, laesst ihn aber sichtbar.</summary>
    [Parameter] public bool Bedienbar { get; set; } = true;

    /// <summary>
    /// WARUM ist dieses Blatt gesperrt? Leer (Vorgabe) = die HARTE Sperre wie
    /// bisher: <c>&lt;button disabled&gt;</c>, kein Klick, kein Ereignis.
    ///
    /// <para>Steht hier ein Satz, wird daraus eine WEICHE Sperre
    /// (Anwenderwunsch <b>W16b-E-6</b>, 05.09.2026): Der Knopf bleibt ein
    /// Knopf, traegt <c>aria-disabled</c> und den Satz als <c>title</c> — und
    /// der Versuch, ihn zu betreten, meldet sich beim Wirt als
    /// <see cref="Reiter.Verweigert"/>. Ein <c>disabled</c>-Knopf kann das
    /// nicht: Er nimmt weder Zeigerereignisse an noch zeigt der Browser
    /// seinen <c>title</c> an, und die Sprachausgabe hoert nur „nicht
    /// verfuegbar" ohne den Grund.</para>
    /// </summary>
    [Parameter] public string Sperrgrund { get; set; } = "";

    /// <summary>
    /// Die STATUSZEILE unter dem Titel im Reiterknopf; leer (Vorgabe) = keine, der Knopf
    /// traegt dann nur den Titel.
    /// </summary>
    [Parameter] public string Status { get; set; } = "";

    /// <summary>
    /// Die Kurzform der Statuszeile unter 900 px Fensterbreite; leer (Vorgabe) = derselbe
    /// Text wie <see cref="Status"/>.
    /// </summary>
    [Parameter] public string StatusKurz { get; set; } = "";

    /// <summary>
    /// Normal (leise) oder Warnung (Warnfarbe mit dem Zeichen ▲); ohne
    /// <see cref="Status"/> ohne Wirkung.
    /// </summary>
    [Parameter] public Statusstufe Statusstufe { get; set; } = Statusstufe.Normal;

    /// <summary>Traegt das Blatt eine Statuszeile?</summary>
    public bool HatStatus => !string.IsNullOrEmpty(Status);

    /// <summary>Die Kurzform, die unter 900 px steht (Rueckfall: der Status selbst).</summary>
    public string Kurzform => string.IsNullOrEmpty(StatusKurz) ? Status : StatusKurz;

    /// <summary>Die Kennung des Reiterknopfs dieses Blattes (mit der Kennung des Reiters).</summary>
    public string KnopfId => Eltern?.KnopfId(Schluessel) ?? "reiter-" + Schluessel;

    /// <summary>Die Kennung dieses Blattes (mit der Kennung des Reiters).</summary>
    public string BlattId => Eltern?.BlattId(Schluessel) ?? "blatt-" + Schluessel;

    /// <summary>Der Inhalt des Blattes.</summary>
    [Parameter] public RenderFragment? KindInhalt { get; set; }

    /// <summary>Das Blatt wurde soeben sichtbar - Gelegenheit zum Nachladen.</summary>
    [Parameter] public EventCallback Betreten { get; set; }

    /// <summary>Ist dieses Blatt das gewaehlte?</summary>
    public bool Sichtbar => Eltern is not null && Eltern.IstAktiv(Schluessel);

    protected override void OnInitialized()
    {
        Eltern?.Anmelden(this);
        _titel = Titel;
        _bedienbar = Bedienbar;
        _sperrgrund = Sperrgrund;
        _status = Status;
        _statusKurz = StatusKurz;
        _statusstufe = Statusstufe;
    }

    protected override void OnParametersSet()
    {
        // Titel, Sperre, Sperrgrund und Statuszeile stehen in der LEISTE, die der
        // Reiter zeichnet - aendert sich eines davon, muss er neu zeichnen.
        if (!string.Equals(_titel, Titel, StringComparison.Ordinal)
            || _bedienbar != Bedienbar
            || !string.Equals(_sperrgrund, Sperrgrund, StringComparison.Ordinal)
            || !string.Equals(_status, Status, StringComparison.Ordinal)
            || !string.Equals(_statusKurz, StatusKurz, StringComparison.Ordinal)
            || _statusstufe != Statusstufe)
        {
            _titel = Titel;
            _bedienbar = Bedienbar;
            _sperrgrund = Sperrgrund;
            _status = Status;
            _statusKurz = StatusKurz;
            _statusstufe = Statusstufe;
            Eltern?.Aufgefrischt();
        }
    }

    /// <summary>
    /// Der Reiter meldet, dass dieses Blatt jetzt vorn steht (gerufen aus
    /// <see cref="Reiter"/>). Warum von dort und nicht aus einem eigenen
    /// <c>OnAfterRender</c>: siehe Begruendung dort.
    /// </summary>
    internal Task Betretend() => Betreten.InvokeAsync();

    /// <inheritdoc />
    public void Dispose() => Eltern?.Abmelden(this);
}
