@* Abschlusszeile eines Dialogs: Statustext links, dann - optional - der
   nicht schliessende Speichern-Knopf, dann Abbrechen und OK.

   Vorbild: Allgemein/SpeichernLeiste.cs. Von dort stammen
   - die Regel, wann Speichern aktiv ist (markierter Satz UND Aenderung),
   - die drei Kurztexte, die den gesperrten Knopf erklaeren,
   - die Rueckmeldung als Statuszeile statt als MessageBox (mehrfaches
     Speichern soll keine Meldungskette ausloesen),
   - und die Ressourcenschluessel ADM_*.

   Neu gegenueber dem Vorbild sind OK und Abbrechen: In WinForms lagen sie im
   Designer der jeweiligen Maske, hier gehoeren sie in denselben Baustein. Der
   Dialog erfaehrt das Ergebnis ueber Ergebnis (true = OK, false = Abbrechen);
   geschlossen wird er von der Huelle, nicht von der Komponente. *@

<div class="epos-leiste">
    @* Der linke Aktionsschlitz (DL-2, Schritt 0). Nach der Leseregel der Fussleiste
       stehen LINKS vom Fueller die Knoepfe, die auf den Eingabeblock oder eine
       Ansicht wirken (Standardwerte, Grafik..., Simulation..., Aendern...), RECHTS
       die Knoepfe, die schliessen. Der Fueller ist hier die Statusspanne: sie traegt
       flex: 1 1 auto und schiebt alles Nachfolgende nach rechts.

       Ohne <Aktionen> aendert sich am Markup NICHTS - ein null-RenderFragment
       zeichnet nichts, kein Platzhalter, kein leeres Element. Die bestehenden
       Aufrufer bleiben deshalb unveraendert. *@
    @Aktionen

    <span class="epos-status @(_statusFehler ? "epos-status--fehler" : "")" role="status">@_statusText</span>

    @* Speichern ist WEICH gesperrt (Hausregel: ein gesperrtes Bedienelement, das seinen
       Grund erklaeren soll, darf nicht disabled sein): aria-disabled und der Grund als
       title; ein Klick schreibt nicht, er setzt den Grund in die Statusspanne. *@
    @if (MitSpeichern)
    {
        <button type="button" class="epos-knopf" title="@SpeichernKurztext"
                aria-disabled="@(SpeichernErlaubt ? null : "true")"
                @onclick="BeimSpeichern">@SpeichernText</button>
    }

    @if (MitAbbrechen)
    {
        <button type="button" class="epos-knopf" title="@AbbrechenKurztext"
                @onclick="() => Ergebnis.InvokeAsync(false)">@AbbrechenText</button>
    }

    @* Die WEICHE Sperre (OkSperrgrund): aria-disabled und der Grund als title, der Knopf
       bleibt anklickbar - der Dialog meldet den Versuch. Ohne Grund stehen beide Attribute
       nicht im Markup, die Leiste zeichnet wie zuvor. *@
    <button type="button" class="epos-knopf epos-knopf--primaer"
            disabled="@(!OkErlaubt)" aria-disabled="@(OkSperrgrund is null ? null : "true")"
            title="@OkSperrgrund" @onclick="() => Ergebnis.InvokeAsync(true)">@OkText</button>
</div>

@code {
    /// <summary>
    /// Der linke Aktionsschlitz: Knoepfe, die auf den Eingabeblock oder eine
    /// Ansicht wirken, VOR dem Statustext und damit links vom Fueller.
    ///
    /// <para>Die Fussleiste des Hauses laeuft
    /// <b>Aktionen · Fueller · [Speichern] · Abbrechen · OK</b>; ohne diesen Schlitz
    /// brauchte ein Dialog mit Aktionsknoepfen eine ZWEITE Leiste ueber der
    /// Fussleiste - und genau das verbietet die Hausregel „Jeder Dialog traegt genau
    /// eine Fussleiste" (Konzept Knopfleisten der Administrationsdialoge, DL-2).</para>
    ///
    /// <para>Der Schlitz ist optional: Bleibt er leer, zeichnet die Leiste dasselbe
    /// Markup wie zuvor.</para>
    /// </summary>
    [Parameter] public RenderFragment? Aktionen { get; set; }

    /// <summary>Beschriftung des OK-Knopfes.</summary>
    [Parameter] public string OkText { get; set; } = "OK";

    /// <summary>Beschriftung des Abbrechen-Knopfes.</summary>
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Beschriftung des nicht schliessenden Speichern-Knopfes.</summary>
    [Parameter] public string SpeichernText { get; set; } = Resource.ADM_BTN_SPEICHERN;

    /// <summary>OK anklickbar? Der Dialog entscheidet, was eine gueltige Eingabe ist.</summary>
    [Parameter] public bool OkErlaubt { get; set; } = true;

    /// <summary>
    /// Der Grund einer WEICHEN Sperre des OK-Knopfs; <c>null</c> = keine (Vorgabe). Gesetzt,
    /// trägt der Knopf <c>aria-disabled="true"</c> und den Grund als <c>title</c>, bleibt aber
    /// anklickbar und meldet <see cref="Ergebnis"/> mit <c>true</c> — der Dialog meldet den
    /// Versuch (Hausregel: ein gesperrtes Bedienelement, das seinen Grund erklären soll, darf
    /// nicht <c>disabled</c> sein). <see cref="OkErlaubt"/> bleibt die HARTE Sperre.
    /// </summary>
    [Parameter] public string? OkSperrgrund { get; set; }

    /// <summary>Zeigt den Speichern-Knopf. Ohne ihn bleibt die Leiste OK/Abbrechen.</summary>
    [Parameter] public bool MitSpeichern { get; set; }

    /// <summary>
    /// Zeigt den Abbrechen-Knopf.
    ///
    /// <para><b>Jede Maske des Hauses traegt ihn.</b> Das Muster ist ueberall
    /// dasselbe: sammeln und erst im OK-Weg schreiben. Wer vorher schreibt, darf
    /// kein Abbrechen anbieten - es naehme nichts zurueck -, und deshalb schreibt
    /// keine Maske mehr vorher. Ein Dialog, der eine LISTE fuehrt, zeigt zusaetzlich
    /// den nicht schliessenden Knopf (<see cref="MitSpeichern"/>); der uebernimmt
    /// in den Arbeitsstand und heisst deshalb "Anlegen"/"Uebernehmen", nicht
    /// "Speichern".</para>
    /// </summary>
    [Parameter] public bool MitAbbrechen { get; set; } = true;

    /// <summary>
    /// Kurztext des Abbrechen-Knopfes (DL-2, Entscheid DL-Q3 a).
    ///
    /// <para>Ein Dialog, der einen TEIL seiner Arbeit schon geschrieben hat - weil
    /// eine Zeilenaktion eine Id braucht (Position anlegen, Traeger anlegen) -,
    /// sagt am Knopf selbst, was Abbrechen wirklich verwirft. Ohne Kurztext
    /// zeichnet der Knopf kein <c>title</c>-Attribut.</para>
    /// </summary>
    [Parameter] public string? AbbrechenKurztext { get; set; }

    /// <summary>Ist links ein Datensatz markiert? (Vorbild: Zustand, erster Parameter.)</summary>
    [Parameter] public bool SatzMarkiert { get; set; }

    /// <summary>Wurde seit dem letzten Speichern etwas geaendert? (zweiter Parameter.)</summary>
    [Parameter] public bool Geaendert { get; set; }

    /// <summary>true = OK, false = Abbrechen. Das Schliessen erledigt die Huelle.</summary>
    [Parameter] public EventCallback<bool> Ergebnis { get; set; }

    /// <summary>Klick auf Speichern. Der Dialog bleibt dabei offen.</summary>
    [Parameter] public EventCallback Gespeichertwerden { get; set; }

    private string _statusText = "";
    private bool _statusFehler;

    /// <summary>
    /// Der Speichern-Knopf ist nur aktiv, wenn es etwas zu speichern gibt:
    /// ein markierter Satz UND mindestens eine Aenderung.
    /// </summary>
    public bool SpeichernErlaubt => SatzMarkiert && Geaendert;

    /// <summary>Der angezeigte Statustext (Pruefhilfe fuer Tests).</summary>
    public string StatusText => _statusText;

    /// <summary>Ist der Statustext eine Fehlermeldung? (Pruefhilfe fuer Tests.)</summary>
    public bool StatusIstFehler => _statusFehler;

    /// <summary>Der Kurztext nennt den Grund, damit der gesperrte Knopf nicht raetselhaft bleibt.</summary>
    private string SpeichernKurztext =>
        !SatzMarkiert ? Resource.ADM_TIP_SPEICHERN_LEER
        : !Geaendert ? Resource.ADM_TIP_SPEICHERN_UNVERAENDERT
        : Resource.ADM_TIP_SPEICHERN;

    /// <summary>Erfolgsmeldung mit Uhrzeit in der Statuszeile.</summary>
    public void Gespeichert()
    {
        Melden(string.Format(Resource.ADM_STATUS_GESPEICHERT, DateTime.Now.ToString("T")), false);
    }

    /// <summary>
    /// Kurzhinweis, dass NICHT geschrieben wurde. Die Begruendung steht bereits
    /// im Warnbanner, das der Dialog davor gezeigt hat.
    /// </summary>
    public void Fehler()
    {
        Melden(Resource.ADM_STATUS_FEHLER, true);
    }

    /// <summary>Loescht die Statuszeile (neue Eingabe, neuer Satz).</summary>
    public void Leeren()
    {
        Melden("", false);
    }

    /// <summary>
    /// Ein eigener Statustext des Wirts - fuer Dialoge, die mehr zu melden haben
    /// als „gespeichert" und „nicht gespeichert" (etwa „{0} Nutzungsdauern aus der
    /// AfA-Tabelle vorbelegt"). Der Wirt haelt den Wortlaut, die Leiste zeigt ihn.
    /// </summary>
    public void Zeigen(string szText, bool bFehler = false)
    {
        Melden(szText, bFehler);
    }

    private void Melden(string szText, bool bFehler)
    {
        _statusText = szText;
        _statusFehler = bFehler;
        StateHasChanged();
    }

    /// <summary>
    /// Klick auf Speichern: Ist nichts zu speichern (weiche Sperre), meldet die Leiste den
    /// Grund in der Statusspanne und ruft den Dialog nicht.
    /// </summary>
    private Task BeimSpeichern()
    {
        if (!SpeichernErlaubt)
        {
            Melden(SpeichernKurztext, false);
            return Task.CompletedTask;
        }
        return Gespeichertwerden.InvokeAsync();
    }
}
