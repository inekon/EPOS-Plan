    /// dieser Seite zeigen (Auftrag #221).
    /// </summary>
    /// <remarks>
    /// Wer hineinschreibt, ändert damit auch die Anzeige; genau so setzt der
    /// Assistent einen Laufparameter, und <see cref="Auffrischen"/> zeichnet danach.
    /// </remarks>
    public ParameterDaten Laufparameter => _parameter;

    /// <summary>
    /// Lädt den gezeigten Stand neu und zeichnet — der Weg, den ein Wirt geht,
    /// nachdem von aussen geschrieben wurde (Auftrag #221).
    /// </summary>
    public void Auffrischen()
    {
        Neuladen();
        StateHasChanged();
    }

    /// <summary>
    /// Hebt die Karte EINER Anlage hervor und blendet dafür die verfügbaren Karten ein
    /// — der Landeplatz für den Knopf an der Meldung „Erzeuger ohne Kaskadenplatz"
    /// (Anwenderentscheid vom 16.09.2026).
    /// </summary>
    /// <remarks>
    /// <para><b>Sie nimmt nichts auf.</b> Aufgenommen wird mit „+ aufnehmen" an der
    /// Karte; dieser Weg führt nur hin. So bleibt es bei EINEM Aufnahmeweg — und damit
    /// bei EINER Stelle, die die Kaskade als GEPFLEGTE merkt.</para>
    /// <para><b>Die verfügbaren Karten müssen dabei offen sein</b>: Eine Anlage ohne
    /// Platz steht genau dort, und der Schalter am Spaltenende kann sie eben
    /// zugeklappt haben. Ohne diese Zeile zeigte der Knopf auf eine Karte, die der
    /// Anwender nicht sieht.</para>
    /// </remarks>
    public void KarteHervorheben(int idAnlage)
    {
        if (idAnlage <= 0) return;

        KarteMarkieren(idAnlage);
        StateHasChanged();
    }

    /// <summary>
    /// Der Kern von <see cref="KarteHervorheben"/> ohne das Zeichnen — der Assistent
    /// ruft ihn und lässt über den Verteiler zeichnen (Welle #458).
    /// </summary>
    private void KarteMarkieren(int idAnlage)
    {
        _auswahl = PRAEFIX_ERZEUGER + idAnlage;
        _verfuegbareZeigen = true;
        AnsichtszustandAnwenden();
    }

    // =====================================================================
    // Laden
    // =====================================================================

    protected override void OnInitialized()
    {
        if (Zustand is not null) Zustand.Geaendert += BeiZustand;
        Neuladen();
    }

    /// <inheritdoc />
    public void Dispose()
    {
        if (Zustand is not null) Zustand.Geaendert -= BeiZustand;
    }

    private void BeiZustand()
    {
        // Der Zustand kommt vom Oberflaechenfaden der Huelle; gezeichnet wird
        // ausschliesslich auf dem Renderfaden (Muster BerichteKostenSeite).
        _ = InvokeAsync(() =>
        {
            _status = "";

            // Ein PROJEKTWECHSEL wirft den Arbeitsstand weg - die Huelle legt ihre
            // Kaskade neu an, und was hier offen war, gehoerte dem alten Projekt.
            UngespeichertSetzen(false);

            Neuladen();
            StateHasChanged();
        });
    }

    /// <summary>
    /// DER EINE Auffrischungsweg — er ersetzt die NEUN Aufrufstellen von
    /// <c>AktualisiereErzeugerUebersicht</c> (Befund W10-B40).
    /// </summary>
    private void Neuladen()
    {
        _parameter = Parameter?.Laden?.Invoke() ?? new ParameterDaten();
        KachelnNeuladen();
    }

    /// <summary>
    /// Nur die KACHELN neu laden — ohne die Laufparameter.
    /// </summary>
    /// <remarks>
    /// Der Weg nach dem OK des Konfigurationsdialogs: Dort ist der eben
    /// geschriebene Stand schon der gezeigte (die Arbeitskopie wird zu
    /// <see cref="_parameter"/>), ein zweites Lesen über <c>Laden</c> wäre nur die
    /// Gelegenheit, ihn wieder zu verlieren. Die KACHELN müssen dagegen neu kommen:
    /// Die Wärmepumpen-Konfiguration ändert Betriebsart und Sperrzeit der Anlage,
    /// und beide stehen als Chip auf der Karte.
    /// </remarks>
    private void KachelnNeuladen()
    {
        _daten = Dienste?.Laden?.Invoke(IdProjekt) ?? new SimulationKonfigDaten();
        AnsichtszustandAnwenden();
        SchemaAuffrischen();
    }

    // =====================================================================
    // Die Laufparameter (#216) — die Netzverluste schreiben sofort, die drei
    // Erzeugerwerte seit dem Anwenderwunsch vom 16.09.2026 im OK-Weg des
    // Konfigurationsdialogs (siehe KonfigurationOeffnen / KonfigFertig)
    // =====================================================================

    private void NetzverlusteGesetzt(double? wert)
    {
        _parameter.Netzverluste = wert ?? 0.0;
        Parameter?.NetzverlusteSchreiben?.Invoke(_parameter.Netzverluste,
                                                 _parameter.NetzverlusteEinheit);
    }

    /// <summary>@key des Kühlschalters — ein Neuaufbau nach gescheitertem Schreiben.</summary>
    private int _kuehlbetriebSchluessel;

    /// <summary>
    /// Der Schalter „Kühlung rechnen" (Stufe KU1, Kühlkonzept 8.3) — schreibt sofort über
    /// die Naht der Hülle. Steht danach nicht der gewünschte Wert, zeigt der Schalter wieder
    /// den gespeicherten Stand, und die Fußzeile meldet es (kein stilles Zurückspringen).
    /// </summary>
    private void KuehlbetriebGesetzt(bool wert)
    {
        if (Parameter?.KuehlbetriebSchreiben is null) return;

        if (Parameter.KuehlbetriebSchreiben(wert))
        {
            _parameter.Kuehlbetrieb = wert;
            return;
        }

        _kuehlbetriebSchluessel++;
        Melden(Resource.SIMKONF_MSG_KUEHLBETRIEB_FEHLER, WarnStufe.Warnung);
    }

    // =====================================================================
    //  Die Projekteinstellung „Anlagenkopplung" (Konzept Anlagenkopplung 9.4)
    // =====================================================================

    /// <summary>@key der Kopplungswahl — ein Neuaufbau nach gescheitertem Schreiben.</summary>
    private int _anlagenkopplungSchluessel;

    /// <summary>
    /// Die vier Stufen der Liste (Id = Platz in <see cref="WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen"/>) —
    /// ihre Namen aus den Ressourcen; die nicht gebauten tragen „(noch nicht verfügbar)".
    /// </summary>
    private static IReadOnlyList<(int Id, string Text)> Kopplungseintraege
    {
        get
        {
            var liste = new List<(int, string)>();
            for (int i = 0; i < WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen.Count; i++)
            {
                string stufe = WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen[i];
                string text = Kopplungsname(stufe);
                if (!WindowsFormsApplication1.Waermeuebergabevorgaben.StufeGebaut(stufe))
                    text += " — " + Resource.SIMKONF_ANLAGENKOPPLUNG_NICHT_VERFUEGBAR;
                liste.Add((i, text));
            }
            return liste;
        }
    }

    /// <summary>Die gesperrten Einträge: jede Stufe, deren Rechenweg nicht gebaut ist.</summary>
    private static IReadOnlyCollection<int> KopplungGesperrt
    {
        get
        {
            var gesperrt = new List<int>();
            for (int i = 0; i < WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen.Count; i++)
                if (!WindowsFormsApplication1.Waermeuebergabevorgaben.StufeGebaut(WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen[i])) gesperrt.Add(i);
            return gesperrt;
        }
    }

    /// <summary>Der Anzeigename einer Stufe (Steuerwert → Ressource).</summary>
    internal static string Kopplungsname(string? stufe) => stufe switch
    {
        WindowsFormsApplication1.DbWerte.ANLAGENKOPPLUNG_AK1 => Resource.SIMKONF_ANLAGENKOPPLUNG_AK1,
        WindowsFormsApplication1.DbWerte.ANLAGENKOPPLUNG_AK2 => Resource.SIMKONF_ANLAGENKOPPLUNG_AK2,
        WindowsFormsApplication1.DbWerte.ANLAGENKOPPLUNG_AK3 => Resource.SIMKONF_ANLAGENKOPPLUNG_AK3,
        _ => Resource.SIMKONF_ANLAGENKOPPLUNG_AUS
    };

    /// <summary>Der Listenplatz des gespeicherten Werts; NULL und „AUS" sind „aus".</summary>
    private static int Kopplungsindex(string? stufe)
    {
        for (int i = 0; i < WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen.Count; i++)
            if (string.Equals(WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen[i], stufe, StringComparison.Ordinal)) return i;
        return 0;
    }

    /// <summary>
    /// Die Herleitungszeile unter der Wahl: was die gewählte Stufe rechnet — bei einer nicht
    /// gebauten Stufe, dass der Lauf den Heizkreis (AK1) rechnet.
    /// </summary>
    private string Kopplungszeile
    {
        get
        {
            string? stufe = _parameter.Anlagenkopplung;
            if (!WindowsFormsApplication1.Waermeuebergabevorgaben.StufeGebaut(stufe))
                return string.Format(Resource.SIMKONF_HRL_ANLAGENKOPPLUNG_NICHT_GEBAUT, Kopplungsname(stufe));
            return stufe == WindowsFormsApplication1.DbWerte.ANLAGENKOPPLUNG_AK1
                ? Resource.SIMKONF_HRL_ANLAGENKOPPLUNG_AK1
                : Resource.SIMKONF_HRL_ANLAGENKOPPLUNG_AUS;
        }
    }

    /// <summary>
    /// Die Wahl „Anlagenkopplung" — schreibt sofort über die Naht der Hülle. Eine nicht gebaute
    /// Stufe lässt das Feld gar nicht erst zu; steht danach nicht die gewünschte Stufe, zeigt die
    /// Wahl wieder den gespeicherten Stand, und die Fußzeile meldet es.
    /// </summary>
    private void AnlagenkopplungGewaehlt(int? index)
    {
        if (Parameter?.AnlagenkopplungSchreiben is null || index is null) return;
        if (index.Value < 0 || index.Value >= WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen.Count) return;

        string stufe = WindowsFormsApplication1.Waermeuebergabevorgaben.Stufen[index.Value];
        if (!WindowsFormsApplication1.Waermeuebergabevorgaben.StufeGebaut(stufe)) return;
        string? wert = stufe == WindowsFormsApplication1.DbWerte.ANLAGENKOPPLUNG_AUS ? null : stufe;

        if (Parameter.AnlagenkopplungSchreiben(wert))
        {
            _parameter.Anlagenkopplung = wert;
            return;
        }

        _anlagenkopplungSchluessel++;
        Melden(Resource.SIMKONF_MSG_ANLAGENKOPPLUNG_FEHLER, WarnStufe.Warnung);
    }

    /// <summary>
    /// Der Parameterbereich EINER Erzeugerkarte — seit dem Anwenderwunsch vom
    /// 16.09.2026 der KNOPF in die Konfiguration; <c>null</c> = diese Erzeugerart
    /// hat keine Parameter (dann steht der Bereich gar nicht da).
    /// </summary>
    /// <remarks>
    /// <para><b>Anwenderwunsch 16.09.2026</b> (Screenshots „Simulation →
    /// Konfiguration"): „Erstelle dort einen Knopf anstelle des blauen Balkens
    /// ‚Parameter für die Simulation' mit dem Konfigurationsdialog. Dies soll für
    /// alle Komponenten so erfolgen." Bis hierher stand an der Karte ein Gruppenkopf
    /// (<c>SIMKONF_GRP_LAUFPARAMETER</c>) mit den Feldern darunter; beides ist in
    /// den <c>KomponentenKonfigurationDialog</c> gewandert.</para>
    ///
    /// <para><b>An JEDER Karte ihrer Art, nicht nur an der ersten.</b> Bis hierher
    /// stand der Block nur an der ersten Karte je Art — die Werte gelten ja
    /// projektweit, und an jeder Karte stünden dieselben Felder so oft da, wie es
    /// Module gibt. Ein KNOPF ist etwas anderes als ein Feld: Er verdoppelt keine
    /// Eingabe, und wer die Konfiguration des zweiten BHKW-Moduls sucht, soll sie an
    /// dessen Karte finden. Dass der Inhalt dem Projekt gehört, sagt der Dialog an
    /// jedem Wert (Herleitungszeile „Projekteinstellung …").</para>
    ///
    /// <para><b>Vier Arten tragen keinen Knopf</b> — Solarthermie, Photovoltaik,
    /// Stromspeicher und Pufferspeicher haben keinen Laufparameter, und ein Knopf,
    /// der einen leeren Dialog öffnet, ist keiner.</para>
    /// </remarks>
    private RenderFragment? Erzeugerparameter(ErzeugerZeile zeile)
    {
        if (Parameter?.Laden is null) return null;
        if (ArtZu(zeile.DbWert) == Komponentenart.Keine) return null;

        return KonfigurationsKnopf(zeile);
    }

    /// <summary>
    /// Die Komponentenart einer Kartenzeile — die EINE Zuordnung von
    /// <c>DbWerte.ERZEUGER_*</c> auf die Aufzählung des Dialogs.
    /// </summary>
    private static Komponentenart ArtZu(string dbWert) => dbWert switch
    {
        WindowsFormsApplication1.DbWerte.ERZEUGER_BHKW => Komponentenart.Bhkw,
        WindowsFormsApplication1.DbWerte.ERZEUGER_WAERMEPUMPE => Komponentenart.Waermepumpe,
        WindowsFormsApplication1.DbWerte.ERZEUGER_HEIZKESSEL => Komponentenart.Heizkessel,
        _ => Komponentenart.Keine
    };

    // KEINE eigene Stilklasse: Der Knopf ist der Hausknopf (epos-knopf) im
    // vorhandenen Platzhalter der Kachel (epos-erzeugerkachel-parameter) - das
    // Stilblatt bleibt unberuehrt.
    private RenderFragment<ErzeugerZeile> KonfigurationsKnopf => zeile =>
        @<button type="button" class="epos-knopf" disabled="@_daten.Gesperrt"
                 @onclick="() => KonfigurationOeffnen(zeile)">@BtnKonfigurationText</button>;

    /// <summary>
    /// Traegt Auswahl und Aufklappzustand in die frisch geladenen Kacheln nach.
    /// Der Vorlaeufer tat das in <c>AuswahlInKartenZeigen</c> — aus demselben
    /// Grund: Die Karten sind neu, die Anzeigevorlieben nicht.
    /// </summary>
    private void AnsichtszustandAnwenden()
    {
        // #190: Beim ERSTEN Blick auf ein Projekt entscheidet die Luecke, ob die
        // verfuegbaren Karten offen stehen. Danach gehoert der Schalter dem Anwender.
        if (_lueckeGeprueft != IdProjekt)
        {
            _lueckeGeprueft = IdProjekt;
            if (LueckeAnzahl > 0) _verfuegbareZeigen = true;
        }

        int idAnlage = IdAusSchluessel(_auswahl, PRAEFIX_ERZEUGER);
        if (idAnlage == 0) idAnlage = IdAusSchluessel(_auswahl, PRAEFIX_QUELLE);
        int idPuffer = IdAusSchluessel(_auswahl, PRAEFIX_SPEICHER);

        foreach (KachelGruppe g in _daten.Gruppen)
            foreach (ErzeugerZeile z in g.Zeilen)
            {
                z.Kachel.Hervorgehoben = z.IdAnlage > 0 && z.IdAnlage == idAnlage;
                z.Kachel.Aufgeklappt = z.IstStrom && z.IdType == _offeneStromgruppe;
            }

        foreach (Bausteine.SpeicherKachelDaten s in _daten.Speicher)
            s.Hervorgehoben = idPuffer > 0 && s.IdPuffer == idPuffer;
    }

    /// <summary>
    /// Das Schema rechnet NUR, wenn es auch sichtbar ist — woertlich wie
    /// <c>AktualisiereSchema</c>:204-213. Das Modell holt je Aufbau eine Anlagen-,
    /// eine Puffer- und je beteiligtem Speicher eine Ladeordnungsabfrage.
    /// </summary>
    private void SchemaAuffrischen()
    {
        _schema = _ansicht == ANSICHT_SCHEMA
            ? Dienste?.SchemaLaden?.Invoke(IdProjekt)
            : null;
    }

    // =====================================================================
    // Umschalter
    // =====================================================================

    private string Ansichtklasse(string wert)
        => wert == _ansicht
            ? "epos-simkonfig-schalter--aktiv epos-simkonfig-ansichtknopf"
            : "epos-simkonfig-ansichtknopf";

    private void AnsichtWaehlen(string wunsch)
    {
        if (wunsch == _ansicht) return;

        _ansicht = wunsch;
        SchemaAuffrischen();
    }

    // =====================================================================
    // Die Erzeugerspalte
    // =====================================================================

    /// <summary>
    /// Die sichtbaren Zeilen einer Gruppe: die aufgenommenen immer, die
    /// verfuegbaren nur, wenn der Schalter am Spaltenende sie eingeblendet hat.
    /// </summary>
    private IEnumerable<ErzeugerZeile> Sichtbare(KachelGruppe gruppe)
    {
        foreach (ErzeugerZeile z in gruppe.Zeilen)
            if (_verfuegbareZeigen || !z.Verfuegbar) yield return z;
    }

    /// <summary>Wie viele Platzhalter der Schalter gerade verbirgt.</summary>
    private int VerfuegbarVersteckt
    {
        get
        {
            if (_verfuegbareZeigen) return 0;

            int n = 0;
            foreach (KachelGruppe g in _daten.Gruppen)
                foreach (ErzeugerZeile z in g.Zeilen)
                    if (z.Verfuegbar) n++;
            return n;
        }
    }

    private void VerfuegbareUmschalten()
    {
        _verfuegbareZeigen = !_verfuegbareZeigen;
    }

    /// <summary>
    /// Wie viele ANGELEGTE Erzeuger auf keinem Platz stehen (#190) — die Zahl der
    /// Hinweisleiste. Gezaehlt werden nur verfuegbare Zeilen MIT Anlage; die reinen
    /// Katalog-Platzhalter bleiben aussen vor.
    /// </summary>
    private int LueckeAnzahl
    {
        get
        {
            int n = 0;
            foreach (KachelGruppe g in _daten.Gruppen)
                foreach (ErzeugerZeile z in g.Zeilen)
                    if (z.Verfuegbar && z.HatAnlage) n++;
            return n;
        }
    }

    /// <summary>Der Text der Hinweisleiste — Einzahl und Mehrzahl (#190).</summary>
    private string LueckeText
    {
        get
        {
            int n = LueckeAnzahl;
            return n == 1 ? NichtAufgenommenEiner : string.Format(NichtAufgenommenMehrere, n);
        }
    }

    /// <summary>
    /// <b>Die Kaskade der Automatik zurueckgeben</b> (#307). Er setzt die Merkspalte
    /// auf 0 — im Modell UND in der Datenbank, an derselben EINEN Stelle, die sie
    /// setzt (<c>SimulationKonfigHuelle</c>), damit es bei EINER Wahrheit bleibt.
    /// <para><b>Die Kaskade selbst bleibt unberuehrt</b>, und deshalb ist hier auch
    /// nichts "geaendert": Es entsteht kein ungespeicherter Kaskadenstand. Beim
    /// naechsten Lesen der Konfiguration greifen Nachziehen und Vorwahl wieder, und
    /// was dann hineinkommt, sieht der Anwender an Ort und Stelle.</para>
    /// </summary>
    private void AutomatikUebernehmen()
    {
        Dienste?.AutomatikUebernehmen?.Invoke();
        KachelnNeuladen();
    }

    private void Verschieben(ErzeugerZeile z, int richtung)
    {
        Dienste?.Verschieben?.Invoke(z.DbWert, richtung);
        Geaendert();
        Neuladen();
    }

    private void Aufnehmen(ErzeugerZeile z)
    {
        if (z.IstStrom) Dienste?.StromAuswahl?.Invoke(z.StromPlatz, z.DbWert);
        else Dienste?.Aufnehmen?.Invoke(z.DbWert);

        Geaendert();
        Neuladen();
    }

    private void Entfernen(ErzeugerZeile z)
    {
        if (z.IstStrom) Dienste?.StromAuswahl?.Invoke(z.StromPlatz, "");
        else Dienste?.Entfernen?.Invoke(z.DbWert);

        Geaendert();
        Neuladen();
    }

    /// <summary>
    /// GENAU DIESE DREI WEGE sind ungespeichert (Auftrag #207): Kaskadenplatz,
    /// Aufnehmen, Entfernen. Alles Uebrige dieser Seite — Betriebsmodus,
    /// Prioritaet, Waermequelle, Pufferzuordnung, Lesepunkt — schreibt SOFORT in
    /// die Datenbank und hat nichts Offenes. Der Kaskadenstand dagegen lebt bis
    /// „Konfiguration speichern" im Arbeitsspeicher der Huelle
    /// (<c>KonfigurationCtrl.Delete</c> + <c>Insert</c>), und ein Simulationslauf
    /// laese ohne ihn den alten Stand.
    /// </summary>
    private void Geaendert() => UngespeichertSetzen(true);

    private void UngespeichertSetzen(bool wert)
    {
        if (_ungespeichert == wert) return;
        _ungespeichert = wert;
        UngespeichertGeaendert.InvokeAsync(wert);
    }

    /// <summary>
    /// Umschalten des Detailbereichs einer STROMKACHEL. Hoechstens eine ist offen
    /// (Konzept 3a); die Kachel kennt ihre Nachbarn nicht, die Regel gilt hier.
    /// </summary>
    private void StromUmschalten(ErzeugerZeile z)
    {
        if (!z.IstStrom) return;

        _offeneStromgruppe = z.Kachel.Aufgeklappt ? 0 : z.IdType;
        AnsichtszustandAnwenden();
    }

    /// <summary>Klick auf eine Erzeugerkachel — die Auswahl wandert ins Schema.</summary>
    private void KarteAusgewaehlt(ErzeugerZeile z)
    {
        _auswahl = z.IdAnlage > 0 ? PRAEFIX_ERZEUGER + z.IdAnlage : "";
        AnsichtszustandAnwenden();
    }

    // =====================================================================
    // Die Speicherspalte
    // =====================================================================

    /// <summary>
    /// W10b‑B‑2: die AUFGENOMMENEN Stromspeicher des Projekts (Typ 4 = <c>WizardItemClass.SP_TYP</c>)
    /// für die Spalte „Speicher im Projekt".
    /// </summary>
    private IEnumerable<ErzeugerZeile> Stromspeicher
        => _daten.Gruppen.SelectMany(g => g.Zeilen)
                 .Where(z => z.IdType == 4 && z.Kachel.Zustand == Bausteine.Kachelzustand.Aufgenommen);

    private void SpeicherUmschalten(int idPuffer)
    {
        _offenerSpeicher = _offenerSpeicher == idPuffer ? 0 : idPuffer;
    }

    private void SpeicherAusgewaehlt(int idPuffer)
    {
        _auswahl = idPuffer > 0 ? PRAEFIX_SPEICHER + idPuffer : "";
        AnsichtszustandAnwenden();
    }

    /// <summary>
    /// Wechselt auf die Ansicht „Stromspeicher-Auslegung" (Auftrag <b>#274</b>).
    /// </summary>
    /// <remarks>
    /// <b>Kein Editor, kein Zustand hier.</b> Die Seite ruft nur den Weg der Hülle; was
    /// dort geschieht (Arbeitsgang anmelden, Ansicht wechseln), steht in
    /// <c>SimulationKonfigHuelle</c>. Der Rückweg führt über den Rückwegstapel der
    /// <c>AppWurzel</c> hierher zurück — die Ansicht wird dabei neu aufgebaut und
    /// liest ihre Speicherspalte samt Flottenstand frisch.
    /// </remarks>
    private void StromspeicherAuslegungOeffnen()
    {
        if (IdProjekt <= 0) return;
        Dienste?.AuslegungOeffnen?.Invoke();
    }

    // =====================================================================
    // Fusszeile
    // =====================================================================

    private void LesepunktGesetzt(bool davor)
    {
        if (IdProjekt <= 0) return;

        if (Dienste?.LesepunktSchreiben?.Invoke(davor) == true)
        {
            _daten.BoosterDavor = davor;
            Melden(davor ? StatusLesepunktDavor : StatusLesepunktDanach, WarnStufe.Erfolg);
            return;
        }

        Melden(StatusEinstellungFehler, WarnStufe.Fehler);
    }

    /// <summary>
    /// Schreibt den Kaskadenstand; <c>true</c> = gelungen. <b>Oeffentlich seit
    /// Auftrag #207</b>: Die Rueckfrage beim Verlassen (62b‑E‑1) geht denselben
    /// Weg wie der Knopf.
    /// </summary>
    public bool Speichern()
    {
        if (Dienste?.Speichern?.Invoke() != true) return false;

        UngespeichertSetzen(false);
        Melden(StatusGespeichert, WarnStufe.Erfolg);
        return true;
    }

    private void SpeichernGeklickt() => Speichern();

    /// <summary>
    /// Die Statuszeile. Der Vorlaeufer blendete sie nach DREI SEKUNDEN aus
    /// (statusTimer:91-95); hier bleibt sie bis zur naechsten Aktion stehen —
    /// eine Meldung, die von selbst verschwindet, ist keine.
    /// </summary>
    private void Melden(string text, WarnStufe stufe)
    {
        _status = text;
        _statusStufe = stufe;
    }

    // =====================================================================
    // Schluessel (dieselben Praefixe wie SchemaModell im Kern)
    // =====================================================================

    private const string PRAEFIX_QUELLE = "QUELLE_";
    private const string PRAEFIX_ERZEUGER = "ERZEUGER_";
    private const string PRAEFIX_SPEICHER = "SPEICHER_";

    private static int IdAusSchluessel(string schluessel, string praefix)
    {
        if (string.IsNullOrEmpty(schluessel) ||
            !schluessel.StartsWith(praefix, StringComparison.Ordinal)) return 0;

        return int.TryParse(schluessel.Substring(praefix.Length), out int id) ? id : 0;
    }

    // =====================================================================
    // Das Schema
    // =====================================================================

    /// <summary>Klick im Schema — die zugehoerige Kachel wird hervorgehoben.</summary>
    private void SchemaAuswahl(string schluessel)
    {
        _auswahl = schluessel ?? "";

        // Ein Speicher im Schema klappt seine Kachel auf (Konzept 3a).
        int idPuffer = IdAusSchluessel(_auswahl, PRAEFIX_SPEICHER);
        if (idPuffer > 0) _offenerSpeicher = idPuffer;

        AnsichtszustandAnwenden();
    }

    /// <summary>
    /// Doppelklick im Schema — DERSELBE Editor wie an der Kachel
    /// (woertlich <c>SchemaBearbeiten</c>:302-342).
    /// </summary>
    private void SchemaBearbeiten(string schluessel)
    {
        if (string.IsNullOrEmpty(schluessel) || IdProjekt <= 0) return;

        _auswahl = schluessel;

        int idPuffer = IdAusSchluessel(schluessel, PRAEFIX_SPEICHER);
        if (idPuffer > 0)
        {
            _offenerSpeicher = idPuffer;
            PufferVerwaltungOeffnen(idPuffer);
            return;
        }

        int idAnlage = IdAusSchluessel(schluessel, PRAEFIX_ERZEUGER);
        if (idAnlage > 0)
        {
            // Der Senkendialog ist der Standard-Editor einer Erzeugerkachel.
            ErzeugerZeile? erz = ZeileZuAnlage(idAnlage);
            if (erz is not null) WaermesenkeBearbeiten(erz);
            return;
        }

        int idQuelle = IdAusSchluessel(schluessel, PRAEFIX_QUELLE);
        if (idQuelle > 0)
        {
            // Wie der Quellen-Chip der Kachel: nur Arten mit Quellenwahl bekommen
            // den Editor, die uebrigen bleiben stumm (Etappe D5b).
            ErzeugerZeile? q = ZeileZuAnlage(idQuelle);
            if (q is not null && q.QuellenwahlMoeglich) WaermequelleBearbeiten(q);
        }
    }

    private ErzeugerZeile? ZeileZuAnlage(int idAnlage)
    {
        foreach (KachelGruppe g in _daten.Gruppen)
            foreach (ErzeugerZeile z in g.Zeilen)
                if (z.IdAnlage == idAnlage) return z;

        return null;
    }

