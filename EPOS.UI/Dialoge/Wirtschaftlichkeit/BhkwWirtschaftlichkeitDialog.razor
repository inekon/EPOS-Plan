    private BhkwAnlagenstand Stand(KwkgAnlagenAngabe a)
    {
        int i = Anlagen.IndexOf(a);
        return i >= 0 && i < _staende.Count ? _staende[i] : new BhkwAnlagenstand();
    }

    /// <summary>
    /// K6 - der Hilfsenergieanteil ist nur bei BHKW-Anlagen pflegbar.
    ///
    /// <para>Die Spalte <c>Hilfsenergie_Anteil</c> gilt formal fuer jede Komponente
    /// (Konzept § 5.2), gelesen wird sie in B3 aber nur fuer BHKW und Heizkessel.
    /// Der Kessel bekommt in Gruppe 5 einen Hinweis statt eines Feldes - sein
    /// Hilfsstrom ist reiner Ausweis ohne Strommengenwirkung (B3b) -, die
    /// Waermepumpe bleibt einer spaeteren Etappe vorbehalten.</para>
    /// </summary>
    public static bool AnteilPflegbar(int idType) => idType == WizardItemClass.BHKW_TYP;

    /// <summary>Zeigt den Hinweis fuer Kessel bzw. blendet ihn aus; die Waermepumpe
    /// bekommt weder Feld noch Hinweis.</summary>
    public static bool AnteilHinweis(int idType) => idType == WizardItemClass.KESSEL_TYP;

    /// <summary>Der Dialog fuehrt ausschliesslich BHKW-Anlagenzeilen (<c>LadeGruppe</c>
    /// filtert auf <c>ID_Type = BHKW_TYP</c>) - das Feld ist deshalb sichtbar, sobald
    /// eine Zeile gewaehlt ist.</summary>
    public bool AnteilSichtbar => Aktuelle is not null && AnteilPflegbar(WizardItemClass.BHKW_TYP);

    /// <summary>Der Kessel-Hinweis der Gruppe 5.</summary>
    public bool Kesselhinweis => HatHeizkessel && AnteilHinweis(WizardItemClass.KESSEL_TYP);

