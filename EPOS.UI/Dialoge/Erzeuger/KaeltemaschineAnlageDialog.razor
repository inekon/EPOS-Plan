@* Der ERZEUGERDIALOG der Kaeltemaschine (KU3-4c; Kuehlkonzept 5.3, 5.5, 7.3) - die Kaeltemaschinen
   eines Projekts als Anlagen (Tab_Energieanlagen, Typ 13).

   KATALOGAUSWAHL V1, STUFE 5 (Konzept Projektdialoge mit Katalogauswahl 4.1-4.10, 5.10): derselbe Aufbau
   wie die uebrigen Erzeuger (Vorbild BHKW). Oben IM PROJEKT die Anlagenzeilen (Bezeichner, Nennkaelte-
   leistung, EER/SEER, Rueckkuehlart, Anzahl, Kuehltraeger, eigener Zaehler; Kopfleiste mit der Summe kW
   Kaelte, Bearbeiten… und „Aus dem Projekt entfernen"), darunter der KATALOG (Tab_Kaeltemaschine_STAMM)
   in der Katalogliste mit Spaltenwahl, Verwendungsmarke, Suchfeld und Trefferzahl; Fuss „Vergleichen…",
   Schloss, „Loeschen", „Bearbeiten…" (der Katalogeditor KaeltemaschineKatalogDialog fuer den Satz), Neu…;
   „Typkennfelder laden…" und „Katalogverwaltung…" stehen in der Kopfzeile des Katalogs (KA-E-27, KM-L1). Die DETAILZEILE ist die Zusammenfassung des gewaehlten
   Satzes; „Bearbeiten" oeffnet die Satz-Ueberlagerung mit den Anlagenfeldern (dieselbe Komponente wie im
   Bereich „Kaelte" der Simulationskonfiguration), den Kostenknoepfen und den Kenndaten als Bild.

   SCHREIBWEG. „In das Projekt übernehmen" legt Projektkopie und Anlagenzeile SOFORT an (Kernweg
   KaeltemaschineAnlageCtrl.Anlegen) - die Zeile ist damit sofort bearbeitbar, auch ihre Kosten. Der Dialog
   merkt sich die in der Sitzung angelegten Anlagen (Projektkopievormerkung wie bei BHKW und Waermepumpe):
   Abbrechen, Esc und das Kreuz loeschen sie wieder. Das OK der Satz-Ueberlagerung prueft die Anlage mit den
   Regeln des Kerns und schreibt sie ueber den Fangweg (Katalogladung.Schreiben); ihr Abbrechen stellt die
   Anlagenfelder wieder her (Anlagenmerker-Muster), das Abbrechen des Dialogs den Stand beim Oeffnen.
   „Aus dem Projekt entfernen" merkt eine gespeicherte Anlage vor, geloescht wird beim OK.

   WAERMEPUMPEN MIT KUEHLFUNKTION (KA-E-26, KM-K1; Konzept 5.10a): Katalog und „Im Projekt" fuehren Kaeltemaschinen
   und Waermepumpen mit Kuehlkennlinie in je einer Liste mit Spalte „Art"; „Im Projekt" dazu den Rang in der
   Kaeltefolge. „In das Projekt übernehmen" einer Waermepumpe legt Projektkopie und Anlage sofort an (Kernweg
   KuehlerzeugerKatalogCtrl.WaermepumpeUebernehmen ueber die Huelle), schaltet den Kuehlbetrieb ein und haengt den
   Rang an; eine Ablehnung des Kerns steht im Banner. „Aus dem Projekt entfernen" schaltet bei einer Waermepumpe nur
   den Kuehlbetrieb aus (beim OK, Rang weg, Folge geschlossen); Abbrechen nimmt Uebernahmen, Schalter und Raenge
   zurueck. Vergleichen… nur innerhalb einer Art, Rueckkuehlwerk und Bearbeiten… nur bei der Kaeltemaschine.

   KEINE DATENBANK (Hausregel EPOS.UI): Die Datenseite liegt in der Huelle (EPOS.UI.Daten,
   KaeltemaschineAnlageHuelle; Windows-Wege KaeltemaschineAnlageFensterHuelle). *@

@namespace EPOS.UI.Dialoge.Erzeuger
@using EPOS.UI.Dialoge.Allgemein
@using EPOS.UI.Dialoge.Kosten
@using System.Globalization
@using WindowsFormsApplication1
@using EPOS.UI.Seiten.Start
@implements IDisposable

<div class="epos-dialog epos-kaeltemaschine-anlage" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
            <span class="epos-dialog-kontext" title="@Texte.Kopfband">@Texte.Kopfband</span>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@Texte.Titel" />
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="Verwerfen" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_meldung))
    {
        <Warnbanner Stufe="@_meldungStufe" Text="@_meldung" />
    }
    @* KT-3: Wirft das Lesen der Katalogliste, nennt dieser Banner den Grund (Katalogladung). *@
    @if (!string.IsNullOrEmpty(_listeFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_listeFehler" />
    }
    @* KT-4: Wirft das Lesen des gewaehlten Satzes, nennt dieser Banner den Grund (Katalogladung.Satz). *@
    @if (!string.IsNullOrEmpty(_satzFehler))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_satzFehler" />
    }

    @* KATALOGAUSWAHL V1 (Konzept Projektdialoge mit Katalogauswahl 4.2, 4.4a): jede Funktion an genau einem
       Ort. P = Kopfleiste „Im Projekt" (Summe, Aus dem Projekt entfernen), K = Kopfleiste des Katalogs (Suche,
       In das Projekt übernehmen), S = Zeile „gewählter Satz" (Marke, Kenndaten, Infoknöpfe und -
       KnopfleisteAmSatz, AW1 - Vergleichen…, Schloss setzen…, Löschen, Bearbeiten…, Neu…, dazu Typkennfelder und
       Verwaltung; Schloss und Löschen nur beim Katalogsatz), D = Kopf und Fussleiste des Dialogs. Der Stift je
       Listenzeile ist Bearbeiten… dieser Zeile. Der Klick auf die Zeile wählt (auch ↑ ↓ Pos1 Ende), die gewählte
       Projektzeile ist farbig hervorgehoben; die Kästchen markieren nur für die Sammelaktionen, die auf die
       angekreuzten Zeilen wirken, sonst auf die gewählte. *@
    <Zweispaltenauswahl Dialogname="Kaeltemaschine" LinksTitel="@Texte.ListeProjekt" RechtsTitel="@Texte.ListeKatalog"
                        KatalogZeile="@((int)Katalogliste.ZEILENHOEHE_ZEILENWAHL)"
                        UebernehmenText="@Texte.KnopfInsProjekt"
                        UebernehmenGesperrt="@(KatalogZiele().Count == 0 || (Anlegen is null && WaermepumpeUebernehmen is null))" Uebernehmen="BeiInsProjekt"
                        EntfernenText="@Texte.KnopfEntfernen"
                        EntfernenGesperrt="@(ProjektZiele().Count == 0 && WpZiele().Count == 0)" Entfernen="BeiEntfernen"
                        ProjektWahl="@_projektWahl" ProjektSichtbar="@ProjektSchluessel()"
                        KatalogWahl="@_katalogWahl" KatalogSichtbar="@KatalogSichtbar()"
                        WahlGeaendert="BeiWahlGeaendert"
                        KatalogFussName="@_katalogZeile?.Bezeichner"
                        SatzArt="@SatzArt" SatzName="@SatzName" SatzKenndaten="@SatzKenndaten"
                        SatzNurLesen="@(KatalogsatzGesperrt || SatzIstWaermepumpe)" SatzNurAnsicht="@(_katalogZeile is not null && !KatalogsatzGesperrt)"
                        SatzFehler="@_satzUeberlagerungFehler" SatzVergroessert="BeiSatzVergroessert"
                        SatzUebernommen="BeiSatzUebernommen" SatzVerworfen="BeiSatzVerworfen"
                        SatzZusammenfassung="@Zusammenfassung()"
                        KnopfleisteAmSatz="true"
                        VergleichProjekt="@VergleichProjektGabe" VergleichKatalog="@VergleichKatalogGabe"
                        KatalogGewaehlt="@_katalogZeile?.Schluessel" VergleichAbgelehnt="BeiSchlossAbgelehnt"
                        ProjektGewaehlt="@(Aktuell is null && AktuellWp is null ? null : _gewaehlt)"
                        ProjektGewaehltChanged="BeiProjektTastenwahl"
                        @ref="_zweispalten">

        <ProjektKopf>
            <span class="epos-zweispalten-summe">@Texte.Summe <b>@Summentext</b></span>
        </ProjektKopf>

        <KatalogKopf>
            @* KATALOGFUNKTIONEN OHNE SATZBEZUG (KA-E-27, KM-L1): in der Kopfzeile des Katalogs neben „Spalten…" -
               die Knopfleiste am Satz traegt nur Satzaktionen. *@
            @if (TypkennfelderLaden is not null)
            {
                <button type="button" class="epos-knopf epos-zweispalten-knopf epos-kaeltemaschine-typkennfelder"
                        title="@Texte.KnopfTypkennfelder" @onclick="TypkennfelderEinspielen">@Texte.KnopfTypkennfelder</button>
            }
            <button type="button" class="epos-knopf epos-zweispalten-knopf epos-kaeltemaschine-verwaltung"
                    title="@Texte.KnopfVerwaltung" @onclick="VerwaltungOeffnen">@Texte.KnopfVerwaltung</button>
        </KatalogKopf>

        @* AW3b: „Bearbeiten…" steht nur noch EINMAL, in der Knopfleiste am gewaehlten Satz. *@

        <Links>
            @* DIE ZEILE IST DIE WAHL (AW3b wie Heizkessel): kein Wahlknopf - ein Klick in die Namenszelle
               waehlt die Zeile (Hervorhebung wie in der Katalogliste), ↑ ↓ Pos1 Ende bewegen die Wahl, die
               Liste ist ein Tabulatorhalt; das Kaestchen bleibt die Mehrfachwahl. *@
            <Raster TZeile="Listenzeile" Zeilen="@Projektzeilen().AsQueryable()"
                    Zeilenklasse="@ProjektZeilenklasse" Tastenfuehrung="BeiProjektTaste"
                    Tastenbeschriftung="@Texte.ListeProjekt">
                <KindInhalt>
                    <TemplateColumn TGridItem="Listenzeile" Class="epos-spalte-kaestchen">
                        <HeaderTemplate>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" />
                        </HeaderTemplate>
                        <ChildContent>
                            <Wahlkaestchen Bereich="Auswahlbereich.Projekt" Schluessel="@context.Schluessel"
                                           Kurztext="@context.Name" />
                        </ChildContent>
                    </TemplateColumn>
                    <TemplateColumn TGridItem="Listenzeile" Title="@Texte.SpalteName" Class="epos-spalte-zeilenzelle">
                        <span class="epos-zeilenzelle epos-projektzeile" title="@context.Name"
                              aria-current="@(context.Schluessel == _gewaehlt ? "true" : null)"
                              @onclick="() => ProjektZeileKlick(context.Schluessel)">@context.Name</span>
                    </TemplateColumn>
                    @* KM-K1: die Art und der Rang in der Kaeltefolge je Zeile (KA-E-26, Anwenderentscheid 12.10.2026). *@
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Art)" Title="@Resource.KMA_SP_ART"
                                    Class="epos-kaeltemaschine-spalte-art" />
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Leistung)" Title="@Texte.SpalteLeistung" />
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Eer)" Title="@Texte.SpalteEer" />
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Rueckkuehlart)" Title="@Texte.SpalteRueckkuehlart" />
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Anzahl)" Title="@Texte.SpalteAnzahl" />
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Traeger)" Title="@Texte.SpalteTraeger" />
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Zaehler)" Title="@Texte.SpalteZaehler" />
                    <PropertyColumn TGridItem="Listenzeile" TProp="string" Property="@(z => z.Rang)" Title="@Resource.KMA_SP_RANG"
                                    Class="epos-kaeltemaschine-spalte-rang" />
                    @* UeS2: der Stift je Projektzeile - die Anlage in der Satz-Ueberlagerung. *@
                    <TemplateColumn TGridItem="Listenzeile" Class="epos-spalte-stift">
                        <HeaderTemplate>
                            <Zeilenstift Kopf="true" />
                        </HeaderTemplate>
                        <ChildContent>
                            <Zeilenstift Hinweis="@(context.Wp is null ? Resource.AUSWAHL_BTN_BEARBEITEN_PROJEKT_HINWEIS : Resource.KMA_WP_BEARBEITEN_GESPERRT)"
                                         Geklickt="@(() => BeiProjektStift(context.Schluessel))" />
                        </ChildContent>
                    </TemplateColumn>
                </KindInhalt>
            </Raster>
        </Links>

        <Rechts>
            <Katalogliste @ref="_katalogliste" Profil="@Profil" Zeilen="@_katalog"
                          Filterstand="@_filterstand"
                          Gewaehlt="@_katalogGewaehlt" GewaehltChanged="KatalogZeileWaehlen"
                          Vergleichsparameter="@Vergleichsparameter"
                          ZeileIstWahl="true" Kaestchen="true" Gewaehlte="@_katalogKaestchen"
                          GewaehlteChanged="BeiKatalogKaestchen"
                          Bearbeiten="BeiKatalogStift" BearbeitenHinweis="@Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS" />
        </Rechts>

        <KatalogFuss>
            @* DIE KNOPFLEISTE AM GEWAEHLTEN SATZ (AW3b, Schema AW1/AW2): Vergleichen… und Bearbeiten… wirken im
               Bereich des gewaehlten Satzes, Schloss… und Loeschen nur auf Katalogsaetze - beim Projektsatz weich
               gesperrt mit dem Grund „Katalogsatz waehlen"; rechts Neu… (Katalogeditor im Modus Neu). *@
            @if (VergleichGemischt)
            {
                @* KM-K1: Vergleichen… nur innerhalb einer Art (Anwenderentscheid 12.10.2026) - weich gesperrt mit Grund;
                   der Baustein fuehrt seinen Knopf wieder, sobald die Auswahl einer Art angehoert. *@
                <button type="button" class="epos-knopf epos-knopf--vergleichen" aria-disabled="true"
                        title="@Resource.KMA_VERGLEICH_EINE_ART"
                        @onclick="() => BeiSchlossAbgelehnt(Resource.KMA_VERGLEICH_EINE_ART)">@Resource.AUSWAHL_BTN_VERGLEICHEN</button>
            }
            <Katalogschloss @ref="_katalogschloss" Weg="@(KatalogsatzIstWaermepumpe ? SchlossWaermepumpe : Schloss)" Zeile="@_katalogZeile"
                            Sperrgrund="@KatalogSperrgrund"
                            JaText="@Texte.Ja" NeinText="@Texte.Nein"
                            Geschaltet="BeiSchlossGeschaltet" Abgelehnt="BeiSchlossAbgelehnt" />
            @if (KatalogLoeschen is not null || WpKatalogLoeschen is not null)
            {
                @if (KatalogSperrgrund is string grund)
                {
                    <button type="button" class="epos-knopf epos-knopf--loeschen" aria-disabled="true" title="@grund"
                            @onclick="() => BeiSchlossAbgelehnt(grund)">@Texte.KnopfLoeschen</button>
                }
                else
                {
                    <button type="button" class="epos-knopf epos-knopf--loeschen" disabled="@(KatalogZiele().Count == 0)"
                            @onclick="BeiLoeschenGefragt">@Texte.KnopfLoeschen</button>
                }
            }
            @if (SatzIstWaermepumpe)
            {
                @* KM-K1: Waermepumpen bearbeitet der Waermepumpendialog (Anlagenfelder, Kuehlbetriebsgruppe, Steckbrief). *@
                <button type="button" class="epos-knopf epos-knopf--bearbeiten-wp" aria-disabled="true"
                        title="@Resource.KMA_WP_BEARBEITEN_GESPERRT"
                        @onclick="() => BeiSchlossAbgelehnt(Resource.KMA_WP_BEARBEITEN_GESPERRT)">@Resource.AUSWAHL_BTN_BEARBEITEN</button>
            }
            else if (SatzArt == Satzmarke.Projektsatz)
            {
                <button type="button" class="epos-knopf epos-knopf--bearbeiten-projekt"
                        title="@Resource.AUSWAHL_BTN_BEARBEITEN_PROJEKT_HINWEIS"
                        disabled="@(ProjektZiele().Count == 0)" @onclick="BeiProjektBearbeiten">@Resource.AUSWAHL_BTN_BEARBEITEN</button>
            }
            else
            {
                <button type="button" class="epos-knopf epos-knopf--bearbeiten-katalog"
                        title="@(KatalogZiele().Count > 0 && KatalogZiele().All(z => z.Geschuetzt) ? Resource.ADM_SCHLOSS_ERST_AUFHEBEN : Resource.AUSWAHL_BTN_BEARBEITEN_KATALOG_HINWEIS)"
                        disabled="@(KatalogZiele().Count == 0)" @onclick="BeiKatalogBearbeiten">@Resource.AUSWAHL_BTN_BEARBEITEN</button>
            }
        </KatalogFuss>

        <KatalogFussRechts>
            @if (KatalogGaben is not null)
            {
                <button type="button" class="epos-knopf epos-knopf--neu" title="@Resource.KMA_HINWEIS_NEU_ART"
                        @onclick="BeiNeu">@Resource.AUSWAHL_BTN_NEU</button>
            }
        </KatalogFussRechts>

        <SatzKopfKnoepfe>
            @* DIE INFOKNOEPFE IM KOPF DER DETAILZEILE (UeS2b); in der Ueberlagerung stehen sie in der
               Knopfzeile des Fragments (der Baustein zeigt je Ansicht eine Stelle). *@
            <span class="epos-berechnungshilfe">
                <InfoKnopf Schluessel="Form_Kaeltemaschine.Grundlagen"
                           StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
                <InfoKnopf Schluessel="Form_Kaeltemaschine.Berechnung"
                           StandardKurztext="Berechnung: Kühlung" MitAssistent="false" />
            </span>
        </SatzKopfKnoepfe>

        <Satz>
            <div class="epos-leiste">
                @if (Aktuell is Zeile k && KostenOeffnen is not null)
                {
                    <KostenKnoepfeLeiste KostenOeffnen="@(b => BeiKosten(k, b))"
                                         InvestText="@Texte.KostenInvest" BetriebText="@Texte.KostenBetrieb" />
                }
                <span class="epos-leiste-fueller"></span>
                <span class="epos-berechnungshilfe">
                    <InfoKnopf Schluessel="Form_Kaeltemaschine.Grundlagen"
                               StandardKurztext="@Resource.HILFE_GRUNDLAGEN_KNOPF" MitAssistent="false" />
                    <InfoKnopf Schluessel="Form_Kaeltemaschine.Berechnung"
                               StandardKurztext="Berechnung: Kühlung" MitAssistent="false" />
                </span>
            </div>

            @if (SatzGeraet is not KaeltemaschineGeraetwerte g)
            {
                <p class="epos-zweispalten-satzleer">@Resource.AUSWAHL_SATZ_LEER</p>
            }
            else
            {
                @* Die Marke des Fragments (Rollbereichprobe): genau einmal, nur in der Satz-Ueberlagerung. *@
                <div class="epos-kaeltemaschine-satz epos-kaeltemaschine-satz--steckbrief">
                @* DER GERAETESTECKBRIEF (KA-E-25, KM-K1): links die wichtigsten Daten des gewaehlten Satzes, lesend aus
                   denselben Geraetewerten wie die Felder rechts. *@
                <aside class="epos-kaeltemaschine-steckbriefspalte">
                    <Gruppenkopf Titel="@Resource.KMA_GRUPPE_STECKBRIEF">
                        <KindInhalt>
                            <Geraetesteckbrief Titel="@Resource.KMA_GRUPPE_STECKBRIEF" TitelAnzeigen="false"
                                               Klasse="epos-kaeltemaschine-steckbrief"
                                               Zeilen="@KaeltemaschineSteckbrief.Zeilen(g, Aktuell?.Arbeit, _kosten, Texte)" />
                        </KindInhalt>
                    </Gruppenkopf>
                </aside>
                <div class="epos-kaeltemaschine-satzfelder">
                @if (Aktuell is Zeile a)
                {
                    @* Die Betriebseingaben: dieselbe Komponente wie im Bereich „Kälte" der Simulations-
                       konfiguration; sie schreibt in den Arbeitsstand der gewaehlten Anlage. *@
                    <KaeltemaschineKonfiguration @key="a.Schluessel" Daten="@a.Arbeit" Texte="@Texte" Stromtraeger="@Stromtraeger"
                                                 ProjektStromtraeger="@ProjektStromtraeger" Geaendert="Nachziehen" />
                }
                else if (KatalogsatzGesperrt)
                {
                    <p class="epos-satzbearbeitung-hinweis" role="note">@Resource.SATZBEARB_NUR_LESEN @Resource.ADM_SCHLOSS_ERST_AUFHEBEN</p>
                }
                <Formulargruppe Titel="@Texte.GruppeGeraet">
                    <KindInhalt>
                        <Formularraster>
                            <KindInhalt>
                                <Textfeld Bezeichnung="@Texte.LabelBezeichner" Wert="@g.Bezeichner" NurLesen="true" />
                                <Textfeld Bezeichnung="@Texte.LabelFirma" Wert="@g.Firma" NurLesen="true" />
                                <Textfeld Bezeichnung="@Texte.LabelTyp" Wert="@g.Typ" NurLesen="true" />
                                <Textfeld Bezeichnung="@Texte.LabelNennkaelteleistung" Einheit="@Texte.EinheitKw"
                                          Wert="@Zahl(g.Nennkaelteleistung, 1)" NurLesen="true" Kurz="true" />
                                <Textfeld Bezeichnung="@Texte.LabelNennEer" Wert="@Zahl(g.NennEer, 2)" NurLesen="true" Kurz="true" />
                                <Textfeld Bezeichnung="@Texte.LabelRueckkuehlart" Wert="@g.Rueckkuehlart" NurLesen="true" />
                                <Textfeld Bezeichnung="@Texte.LabelMindestteillast" Einheit="@Texte.EinheitProzent"
                                          Wert="@Zahl(g.Mindestteillast, 0)" NurLesen="true" Kurz="true" />
                                <Textfeld Bezeichnung="@Texte.LabelKaltwasserMin" Einheit="@Texte.EinheitGradC"
                                          Wert="@Zahl(g.KaltwasserMin, 1)" NurLesen="true" Kurz="true" />
                                @* KM3-E3-b: die Lesewerte der Teillastrechnung - gepflegt im Katalogeditor. *@
                                <Textfeld Bezeichnung="@Texte.LabelTeillastWeg" Wert="@g.TeillastWeg" NurLesen="true" />
                                <Textfeld Bezeichnung="@Texte.LabelVerdichterregelung" Wert="@g.Verdichterregelung" NurLesen="true" />
                                <Textfeld Bezeichnung="@Texte.LabelTaktverlust" Wert="@g.Taktverlustfaktor" NurLesen="true" Kurz="true" />
                                <Textfeld Bezeichnung="@Texte.LabelKennfeldrand" Wert="@g.Kennfeldrand" NurLesen="true" />
                            </KindInhalt>
                        </Formularraster>
                        <Herleitungszeile Text="@Texte.HinweisKatalog" />
                    </KindInhalt>
                </Formulargruppe>
                @if (Kennlinienbilder is not null || Teillastbild is not null)
                {
                    <Formulargruppe Titel="@Texte.GruppeKenndaten">
                        <KindInhalt>
                            @Kenndatenbilder()
                        </KindInhalt>
                    </Formulargruppe>
                }
                </div>
                </div>
            }
        </Satz>
    </Zweispaltenauswahl>

    <SpeichernLeiste OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen" Ergebnis="BeiErgebnis" />

    @* --- Der Katalogeditor: „Bearbeiten…" eines Katalogsatzes und „Katalogverwaltung…" --- *@
    <Ueberlagerung Offen="@(_editorGaben is not null)" Titel="@Texte.TitelEditor"
                   Kopfzusatz="@MarkeKatalogsatz" Geschlossen="() => EditorFertig(false)">
        <KindInhalt>
            @if (_editorGaben is not null)
            {
                <KaeltemaschineKatalogDialog @attributes="_editorGaben" TitelText="" Vorwahl="@_editorVorwahl"
                                             NeuBeimStart="@_editorNeu" Geschlossen="EditorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Rueckfrage Offen="@_loeschfrage" TitelText="@Texte.KnopfLoeschen" Frage="@_loeschfrageText"
                JaText="@Texte.Ja" NeinText="@Texte.Nein" Beantwortet="BeiLoeschfrage" />
</div>

@code {
    // =====================================================================
    // Gaben — die Datenseite liegt in der Hülle (KaeltemaschineAnlageHuelle)
    // =====================================================================

