@* ZONENDIALOG - EINE Zone eines Projektgebaeudes in der Grundform (Gebaeudesimulation G3, Welle D2;
   Mehrzonenkonzept 5.1, Softwarearchitektur 3.2: Ueberlagerung der Ebene 3 im Gebaeudeeditor).

   GRUNDFORM (G3): Bezeichnung und Nutzflaeche der Zone (leer = Nutzflaeche des Gebaeudes, eine
   Herleitungszeile nennt den Wert und den Flaechenschluessel), darunter die Bauteile als
   Zeilenraster (Art, Bezeichnung, A, U, Azimut, Neigung, Randbedingung, Aufbau) mit je zwei
   IMMER sichtbaren Zeilenknoepfen (oeffnen, entfernen), der Abschlusszeile "+ Neues Bauteil ..."
   und dem Summenfuss (Sigma A je Gruppe, H_T).

   STUFE G6b (W2): die Werte der Zone (Raumhoehe, Volumen, beheizt, Sollwerte, Lueftung, Gewinne,
   Bewohner, Heizung) - ein leeres Feld zeigt "Vorgabe: <Wert>" aus der Vorgabenkaskade des Kerns
   (Zonenvorgaben), ein anteiliger Wert mit seinem Flaechenanteil; Kuehlung, Nachtzeit und Ferien
   kommen vom Gebaeude (A4 a). Im Bauteilraster die Spalte "Nachbar" und die Trennflaechen, die
   eine andere Zone mit dieser fuehrt, gespiegelt und nur zum Lesen ("gefuehrt von ...").

   DIE ZEILE IST NUR ANZEIGE. Bearbeitet wird ein Bauteil im Bauteildialog (Ueberlagerung der
   Ebene 4); dessen OK uebernimmt die Zeile in DIESEN Arbeitsstand, geschrieben wird erst mit
   dem OK des Gebaeudeeditors (Softwarearchitektur 3.3). Eine neue Zeile traegt eine negative Id.

   PRUEFREGELN (Mehrzonenkonzept 5.3, Ebene Zone) genau einmal im Rueckruf der Leiste: Name,
   Nutzflaeche groesser null; mit NutzflaechePflicht (ab zwei Zonen, G6a) ist die Nutzflaeche Pflicht -
   ohne Platzhalter "Nutzflaeche des Gebaeudes", denn leer zaehlte sie doppelt. OK gibt den Arbeitsstand zurueck, Abbrechen, Esc und das Kreuz
   geben null. Esc kaskadiert: Solange der Bauteildialog steht, wertet er Esc selbst aus. *@

@namespace EPOS.UI.Dialoge.Bedarf
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-zonendialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@Texte.Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@Texte.Titel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Abbrechen" />
        }
    </div>

    @if (_meldung.Length > 0)
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@_meldung" />
    }

    <Formularraster>
        <KindInhalt>
            <Textfeld Bezeichnung="@Texte.LabelBezeichner" Wert="@_stand.Bezeichner" Hoechstlaenge="80"
                      WertChanged="w => _stand.Bezeichner = w" />
            <Zahlenfeld Bezeichnung="@Texte.LabelNutzflaeche" Einheit="m²" Min="0"
                        Platzhalter="@NutzflaechePlatzhalter"
                        Feldname="@Texte.LabelNutzflaeche" FehlerZustand="FehlerMelden"
                        Wert="@_stand.Nutzflaeche" WertChanged="w => Setzen(() => _stand.Nutzflaeche = w)" />
        </KindInhalt>
    </Formularraster>
    <Herleitungszeile Text="@NutzflaecheZeile" />

    @* Stufe G6b (W2): die Werte der Zone - ein leeres Feld uebernimmt den Wert des Gebaeudes und
       zeigt ihn als Platzhalter "Vorgabe: ..." aus der Vorgabenkaskade des Kerns (Zonenvorgaben),
       ein anteiliger Wert mit dem Flaechenanteil. Eine unbeheizte Zone schwingt frei: Sollwerte und
       Heizung stehen dann nicht da (ihre Werte bleiben im Arbeitsstand). *@
    <Gruppenkopf Titel="@Texte.GruppeWerte">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                    <Zahlenfeld Bezeichnung="@Texte.LabelRaumhoehe" Einheit="m" Min="0"
                                Platzhalter="@Vorgabe(_vorgaben?.Raumhoehe, 2)"
                                Feldname="@Texte.LabelRaumhoehe" FehlerZustand="FehlerMelden"
                                Wert="@_stand.Raumhoehe" WertChanged="w => Setzen(() => _stand.Raumhoehe = w)" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelVolumen" Einheit="m³" Min="0"
                                Platzhalter="@Vorgabe(_vorgaben?.Volumen, 0)"
                                Feldname="@Texte.LabelVolumen" FehlerZustand="FehlerMelden"
                                Wert="@_stand.Volumen" WertChanged="w => Setzen(() => _stand.Volumen = w)" />
                    <Schalter Bezeichnung="@Texte.LabelBeheizt" Wert="@_stand.IstBeheizt"
                              WertChanged="w => Setzen(() => _stand.IstBeheizt = w)" />
                    @if (_stand.IstBeheizt)
                    {
                        <Zahlenfeld Bezeichnung="@Texte.LabelSollTag" Einheit="°C"
                                    Platzhalter="@Vorgabe(_vorgaben?.SollTag, 1)"
                                    Feldname="@Texte.LabelSollTag" FehlerZustand="FehlerMelden"
                                    Wert="@_stand.SollTag" WertChanged="w => Setzen(() => _stand.SollTag = w)" />
                        <Zahlenfeld Bezeichnung="@Texte.LabelSollNacht" Einheit="°C"
                                    Platzhalter="@Vorgabe(_vorgaben?.SollNacht, 1)"
                                    Feldname="@Texte.LabelSollNacht" FehlerZustand="FehlerMelden"
                                    Wert="@_stand.SollNacht" WertChanged="w => Setzen(() => _stand.SollNacht = w)" />
                        <Zahlenfeld Bezeichnung="@Texte.LabelSollWochenende" Einheit="°C"
                                    Platzhalter="@Vorgabe(_vorgaben?.SollWochenende, 1)"
                                    Feldname="@Texte.LabelSollWochenende" FehlerZustand="FehlerMelden"
                                    Wert="@_stand.SollWochenende" WertChanged="w => Setzen(() => _stand.SollWochenende = w)" />
                        <Zahlenfeld Bezeichnung="@Texte.LabelSollFerien" Einheit="°C"
                                    Platzhalter="@Vorgabe(_vorgaben?.SollFerien, 1)"
                                    Feldname="@Texte.LabelSollFerien" FehlerZustand="FehlerMelden"
                                    Wert="@_stand.SollFerien" WertChanged="w => Setzen(() => _stand.SollFerien = w)" />
                        <Zahlenfeld Bezeichnung="@Texte.LabelMaxTemperatur" Einheit="°C"
                                    Platzhalter="@Vorgabe(_vorgaben?.Maximaleraumtemperatur, 1)"
                                    Feldname="@Texte.LabelMaxTemperatur" FehlerZustand="FehlerMelden"
                                    Wert="@_stand.Maximaleraumtemperatur"
                                    WertChanged="w => Setzen(() => _stand.Maximaleraumtemperatur = w)" />
                    }
                    <Zahlenfeld Bezeichnung="@Texte.LabelInfiltration" Einheit="1/h" Min="0.01" Max="10"
                                Platzhalter="@LuftwechselVorgabe(_vorgaben?.LuftwechselInfiltration, Gebaeudemodellvorgaben.LuftwechselInfiltration)"
                                Feldname="@Texte.LabelInfiltration" FehlerZustand="FehlerMelden"
                                Wert="@_stand.LuftwechselInfiltration"
                                WertChanged="w => Setzen(() => _stand.LuftwechselInfiltration = w)" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelNutzerlueftung" Einheit="1/h" Min="0" Max="10"
                                Platzhalter="@LuftwechselVorgabe(_vorgaben?.LuftwechselNutzer, Gebaeudemodellvorgaben.LuftwechselNutzer)"
                                Feldname="@Texte.LabelNutzerlueftung" FehlerZustand="FehlerMelden"
                                Wert="@_stand.LuftwechselNutzer"
                                WertChanged="w => Setzen(() => _stand.LuftwechselNutzer = w)" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelGewinne" Einheit="W" Min="0"
                                Platzhalter="@Vorgabe(_vorgaben?.InterneWaermegewinne, 0)"
                                Feldname="@Texte.LabelGewinne" FehlerZustand="FehlerMelden"
                                Wert="@_stand.InterneWaermegewinne"
                                WertChanged="w => Setzen(() => _stand.InterneWaermegewinne = w)" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelBewohner" Min="0"
                                Platzhalter="@Vorgabe(_vorgaben?.Bewohner, 1)"
                                Feldname="@Texte.LabelBewohner" FehlerZustand="FehlerMelden"
                                Wert="@_stand.Bewohner" WertChanged="w => Setzen(() => _stand.Bewohner = w)" />
                    @if (_stand.IstBeheizt)
                    {
                        <Zahlenfeld Bezeichnung="@Texte.LabelStrahlungsanteil" Min="0" Max="1"
                                    Platzhalter="@Vorgabe(_vorgaben?.HeizungStrahlungsanteil, 2, Gebaeudemodellvorgaben.HeizungStrahlungsanteil)"
                                    Feldname="@Texte.LabelStrahlungsanteil" FehlerZustand="FehlerMelden"
                                    Wert="@_stand.HeizungStrahlungsanteil"
                                    WertChanged="w => Setzen(() => _stand.HeizungStrahlungsanteil = w)" />
                        <Zahlenfeld Bezeichnung="@Texte.LabelHeizleistungMax" Einheit="kW" Min="0.01"
                                    Platzhalter="@GrenzeVorgabe"
                                    Feldname="@Texte.LabelHeizleistungMax" FehlerZustand="FehlerMelden"
                                    Wert="@_stand.HeizleistungMaxKw" WertChanged="w => Setzen(() => _stand.HeizleistungMaxKw = w)" />
                    }
                </KindInhalt>
            </Formularraster>
            <Herleitungszeile Text="@Texte.ZeileVorgaben" />
            @if (!_stand.IstBeheizt)
            {
                <Herleitungszeile Text="@Texte.ZeileUnbeheizt" />
            }
            @if (Luftwechselzeile.Length > 0)
            {
                <Herleitungszeile Text="@Luftwechselzeile" />
            }
        </KindInhalt>
    </Gruppenkopf>

    <Gruppenkopf Titel="@Texte.GruppeBauteile">
        <KindInhalt>
            <Zeilenraster Bezeichnung="@Texte.GruppeBauteile" Spalten="@Spalten" Spaltenmass="@SPALTENMASS"
                          Summen="@Summen">
                <KindInhalt>
                    @for (int i = 0; i < _stand.Bauteile.Count; i++)
                    {
                        int index = i;
                        BauteilDaten b = _stand.Bauteile[index];
                        <div class="epos-zr-zeile epos-zonenbauteil" role="row" @key="b.Id">
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@ArtText(b.Bauteilart)</span></div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@b.Bezeichner</span></div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@Zahl(b.Flaeche, 2)</div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@UText(b)</div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@Winkel(b.Azimut)</div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@NeigungText(b)</div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@RandText(b)</span></div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@NachbarText(b)</span></div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@(b.AufbauText.Length > 0 ? b.AufbauText : "—")</span></div>
                            <div class="epos-zr-zelle" role="cell">
                                <span class="epos-zr-aktionen">
                                    <button type="button" class="epos-knopf epos-zr-knopf" title="@Texte.KnopfOeffnen"
                                            aria-label="@(b.Bezeichner + " – " + Texte.KnopfOeffnen)"
                                            @onclick="() => BauteilOeffnen(index)"><span aria-hidden="true">✎</span></button>
                                    <button type="button" class="epos-knopf epos-zr-knopf" title="@Texte.KnopfEntfernen"
                                            aria-label="@(b.Bezeichner + " – " + Texte.KnopfEntfernen)"
                                            @onclick="() => BauteilEntfernen(index)"><span aria-hidden="true">✕</span></button>
                                </span>
                            </div>
                        </div>
                    }
                    @* Stufe G6b: die Trennflaechen, die eine andere Zone mit dieser fuehrt - gespiegelt
                       (Azimut + 180 Grad, Neigung 180 Grad minus) und nur zum Lesen. *@
                    @foreach (GegenseiteDaten g in Gegenseiten)
                    {
                        BauteilDaten b = g.Bauteil;
                        string gefuehrt = string.Format(CultureInfo.CurrentCulture, Texte.GefuehrtVon, g.Zone);
                        <div class="epos-zr-zeile epos-zonengegenseite" role="row" @key="@("g" + g.IdZone + "_" + b.Id)">
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@ArtText(b.Bauteilart)</span></div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@b.Bezeichner</span></div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@Zahl(b.Flaeche, 2)</div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@UText(b)</div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@WinkelGespiegelt(b.Azimut)</div>
                            <div class="epos-zr-zelle epos-zahl" role="cell">@NeigungGespiegelt(b)</div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@BauteilTexte.RandZone</span></div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@g.Zone</span></div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text">@(b.AufbauText.Length > 0 ? b.AufbauText : "—")</span></div>
                            <div class="epos-zr-zelle" role="cell"><span class="epos-zr-text epos-leisezeile">@gefuehrt</span></div>
                        </div>
                    }
                </KindInhalt>
                <AbschlussZeile>
                    <div class="epos-zr-neuzeile" role="row">
                        @if (_stand.Bauteile.Count == 0)
                        {
                            <p class="epos-leisezeile">@Texte.Leer</p>
                        }
                        <button type="button" class="epos-textknopf" @onclick="BauteilNeu">@Texte.NeuesBauteil</button>
                    </div>
                </AbschlussZeile>
            </Zeilenraster>
            @if (Gegenseiten.Count > 0)
            {
                <Herleitungszeile Text="@Texte.ZeileGegenseite" />
            }
        </KindInhalt>
    </Gruppenkopf>

    <SpeichernLeiste OkText="@Texte.Ok" AbbrechenText="@Texte.Abbrechen" Ergebnis="BeiErgebnis" />

    @* --- Ueberlagerung: der Bauteildialog (Ebene 4) ------------------------ *@
    <Ueberlagerung Offen="@(_bauteil is not null)" Titel="@(_bauteilNeu ? BauteilTexte.TitelNeu : BauteilTexte.Titel)"
                   Geschlossen="() => BauteilFertig(null)">
        <KindInhalt>
            @if (_bauteil is not null)
            {
                <BauteilDialog Bauteil="@_bauteil" Neu="@_bauteilNeu" TitelAnzeigen="false"
                               Projektaufbauten="@Projektaufbauten" Katalogaufbauten="@Katalogaufbauten"
                               Nachbarzonen="@Nachbarzonen" KopplungSperre="@KopplungSperre"
                               Aufbau="@Aufbau" Texte="@BauteilTexte" Geschlossen="BauteilFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    /// <summary>Die Spuren des Bauteilrasters: neun Spalten und die Aktionsspalte.</summary>
    private const string SPALTENMASS =
        "minmax(0, 1.2fr) minmax(0, 2fr) minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 0.7fr) minmax(0, 0.7fr) minmax(0, 1.3fr) minmax(0, 1.2fr) minmax(0, 1.5fr) auto";

    /// <summary>Die Zone beim Öffnen — sie bleibt UNBERÜHRT; der Dialog arbeitet auf einer Kopie.</summary>
    [Parameter] public ZoneDaten Zone { get; set; } = new();

    /// <summary>Die Nutzfläche des Gebäudes [m²] — Platzhalter und Herleitung der leeren Zonenfläche.</summary>
    [Parameter] public double? NutzflaecheGebaeude { get; set; }

    /// <summary>
    /// Die Werte des Gebäudes, aus denen die Zone erbt (Stufe G6b) — Quelle der Platzhalter
    /// „Vorgabe: …"; <c>null</c> = keine Vorgaben (die Felder bleiben ohne Platzhalter).
    /// </summary>
    [Parameter] public Gebaeudevorgaben? Gebaeude { get; set; }

    /// <summary>
    /// Die Zahl der Zonen des Gebäudes samt dieser (Stufe G6b) — ab zwei gilt die Leistungsgrenze des
    /// Gebäudes anteilig (Festlegung 5).
    /// </summary>
    [Parameter] public int Zonenzahl { get; set; } = 1;

    /// <summary>
    /// Die übrigen Zonen des Gebäudes im Arbeitsstand — die Wahl der Nachbarzone einer Trennfläche
    /// im Bauteildialog (Stufe G6b), auch mit vorläufigen, negativen Ids; leer = keine Wahl.
    /// </summary>
    [Parameter] public IReadOnlyList<NachbarzoneWahl> Nachbarzonen { get; set; } = Array.Empty<NachbarzoneWahl>();

    /// <summary>
    /// Die Trennflächen, die eine ANDERE Zone mit dieser führt (Stufe G6b) — sie stehen hier gespiegelt
    /// und nur zum Lesen („geführt von …"); bearbeitet werden sie in der führenden Zone.
    /// </summary>
    [Parameter] public IReadOnlyList<GegenseiteDaten> Gegenseiten { get; set; } = Array.Empty<GegenseiteDaten>();

    /// <summary>
    /// Warum die Datenbank keine Trennflächen zu Nachbarzonen kennt (Schemaschritt S-G fehlt);
    /// <c>null</c> = sie kennt sie. Dann bietet der Bauteildialog die Nachbarzone nicht an.
    /// </summary>
    [Parameter] public string? KopplungSperre { get; set; }

    /// <summary>
    /// Ist die Nutzfläche Pflicht (G6a: ab zwei Zonen)? Dann steht kein Platzhalter „Nutzfläche des
    /// Gebäudes" im Feld — leer hieße sie und zählte doppelt —, und die Prüfung fordert die Fläche.
    /// </summary>
    [Parameter] public bool NutzflaechePflicht { get; set; }

    /// <summary>Die Aufbauten des Projekts zur Wahl im Bauteildialog.</summary>
    [Parameter] public IReadOnlyList<AufbauWahl> Projektaufbauten { get; set; } = Array.Empty<AufbauWahl>();

    /// <summary>Die Aufbauten des Stammkatalogs zur Wahl im Bauteildialog.</summary>
    [Parameter] public IReadOnlyList<AufbauWahl> Katalogaufbauten { get; set; } = Array.Empty<AufbauWahl>();

    /// <summary>Die Schichten eines Aufbaus zum Ansehen; <c>null</c> = keine Ansicht.</summary>
    [Parameter] public Func<AufbauWahl, AufbauAnsichtDaten?>? Aufbau { get; set; }

    /// <summary>Das Ergebnis: der Arbeitsstand nach OK; <c>null</c> bei Abbrechen, Esc und dem Kreuz.</summary>
    [Parameter] public EventCallback<ZoneDaten?> Geschlossen { get; set; }

    /// <summary>Die Anzeigetexte (ein Bündel).</summary>
    [Parameter] public ZonenDialogTexte Texte { get; set; } = new();

    /// <summary>Die Anzeigetexte des Bauteildialogs (ein Bündel).</summary>
    [Parameter] public BauteilDialogTexte BauteilTexte { get; set; } = new();

    /// <summary>Zeigt der Dialog seinen eigenen Kopf — Titel UND Schließkreuz?</summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

    /// <summary>Schlüssel des Hilfeknopfes — die Zeile in help_mapping.txt.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Zone.btn_Help";

    // --- Stand -----------------------------------------------------------------

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private ZoneDaten _stand = new();
    private string _meldung = "";
    private readonly HashSet<string> _fehlerfelder = new();

    private BauteilDaten? _bauteil;
    private bool _bauteilNeu;
    private int _bauteilIndex = -1;

    /// <summary>Der Arbeitsstand. Prüfhilfe für die Tests.</summary>
    public ZoneDaten Arbeitsstand => _stand;

    /// <summary>Die stehende Meldung. Prüfhilfe für die Tests.</summary>
    public string Meldung => _meldung;

    /// <summary>Steht der Bauteildialog? Prüfhilfe für die Tests.</summary>
    public bool BauteilOffen => _bauteil is not null;

    /// <summary>Die Vorgabenkaskade des Arbeitsstands (<see cref="Zonenvorgaben"/>); <c>null</c> ohne Gebäude.</summary>
    private Zonenvorgaben? _vorgaben;

    protected override void OnInitialized()
    {
        _stand = (Zone ?? new ZoneDaten()).Kopie();
        VorgabenNachziehen();
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.ZONE, () => KiSicht(), KiHaken());
    }

    /// <summary>Setzt einen Wert der Zone und zieht die Vorgaben nach — Tastatur und Assistent gehen diesen Weg.</summary>
    private void Setzen(Action setzen)
    {
        setzen();
        VorgabenNachziehen();
    }

    private void VorgabenNachziehen()
        => _vorgaben = Gebaeude is null ? null : Zonenvorgaben.Bilden(_stand.Eingaben(), Gebaeude, Math.Max(1, Zonenzahl));

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =================================================================================
    // Der Hilfe-Assistent liest und setzt den Arbeitsstand
    // =================================================================================

    private KiMaskenanmeldung? _kiMaske;
    private ZonenKiSicht? _kiSicht;

    private ZonenKiSicht KiSicht()
    {
        return _kiSicht ??= new ZonenKiSicht
        {
            BezeichnungLesen = () => _stand.Bezeichner,
            BezeichnungSetzen = w => _stand.Bezeichner = w ?? "",
            NutzflaecheLesen = () => _stand.Nutzflaeche,
            NutzflaecheSetzen = w => Setzen(() => _stand.Nutzflaeche = w),
            // Stufe G6b (W2): die Werte der Zone - Setzen nimmt denselben Weg wie die Tastatur.
            RaumhoeheLesen = () => _stand.Raumhoehe,
            RaumhoeheSetzen = w => Setzen(() => _stand.Raumhoehe = w),
            VolumenLesen = () => _stand.Volumen,
            VolumenSetzen = w => Setzen(() => _stand.Volumen = w),
            BeheiztLesen = () => _stand.IstBeheizt,
            BeheiztSetzen = w => Setzen(() => _stand.IstBeheizt = w),
            SollTagLesen = () => _stand.SollTag,
            SollTagSetzen = w => Setzen(() => _stand.SollTag = w),
            SollNachtLesen = () => _stand.SollNacht,
            SollNachtSetzen = w => Setzen(() => _stand.SollNacht = w),
            SollWochenendeLesen = () => _stand.SollWochenende,
            SollWochenendeSetzen = w => Setzen(() => _stand.SollWochenende = w),
            SollFerienLesen = () => _stand.SollFerien,
            SollFerienSetzen = w => Setzen(() => _stand.SollFerien = w),
            MaxTemperaturLesen = () => _stand.Maximaleraumtemperatur,
            MaxTemperaturSetzen = w => Setzen(() => _stand.Maximaleraumtemperatur = w),
            InfiltrationLesen = () => _stand.LuftwechselInfiltration,
            InfiltrationSetzen = w => Setzen(() => _stand.LuftwechselInfiltration = w),
            NutzerlueftungLesen = () => _stand.LuftwechselNutzer,
            NutzerlueftungSetzen = w => Setzen(() => _stand.LuftwechselNutzer = w),
            GewinneLesen = () => _stand.InterneWaermegewinne,
            GewinneSetzen = w => Setzen(() => _stand.InterneWaermegewinne = w),
            BewohnerLesen = () => _stand.Bewohner,
            BewohnerSetzen = w => Setzen(() => _stand.Bewohner = w),
            StrahlungsanteilLesen = () => _stand.HeizungStrahlungsanteil,
            StrahlungsanteilSetzen = w => Setzen(() => _stand.HeizungStrahlungsanteil = w),
            HeizleistungMaxLesen = () => _stand.HeizleistungMaxKw,
            HeizleistungMaxSetzen = w => Setzen(() => _stand.HeizleistungMaxKw = w),
            BauteileLesen = () => _stand.Bauteile,
            ArtText = ArtText,
            RandText = RandText,
            NachbarText = NachbarText
        };
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf: <c>Pruefen</c> ist dieselbe Prüfung wie am
    /// OK-Knopf. Bauteile anlegen, öffnen und entfernen bleiben Klicks des Anwenders; einen Speicherweg
    /// hat die Maske nicht — das OK des Gebäudeeditors schreibt.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = () => Pruefen() ?? ""
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();

    // =================================================================================
    // Anzeige
    // =================================================================================

    private IReadOnlyList<string> Spalten => new[]
    {
        Texte.SpalteArt, Texte.SpalteBezeichnung, Texte.SpalteFlaeche, Texte.SpalteU, Texte.SpalteAzimut,
        Texte.SpalteNeigung, Texte.SpalteRand, Texte.SpalteNachbar, Texte.SpalteAufbau, Texte.SpalteAktionen
    };

    /// <summary>
    /// Der Platzhalter eines leeren Feldes: „Vorgabe: Wert" aus der Kaskade — vom Gebäude, anteilig
    /// mit dem Flächenanteil, abgeleitet (Volumen) oder, trägt auch das Gebäude keinen Wert, die
    /// Modellvorgabe <paramref name="modell"/>; ohne Gebäude kein Platzhalter.
    /// </summary>
    private string Vorgabe(Vorgabewert? v, int stellen, double? modell = null)
    {
        if (v is not Vorgabewert w) return "";
        var c = CultureInfo.CurrentCulture;
        return w.Herkunft switch
        {
            Vorgabeherkunft.Gebaeude when w.Wert is double x => string.Format(c, Texte.Vorgabe, Kurz(x, stellen)),
            Vorgabeherkunft.GebaeudeAnteilig when w.Wert is double x
                => string.Format(c, Texte.VorgabeAnteilig, Kurz(x, stellen), Kurz(100.0 * (_vorgaben?.Flaechenanteil ?? 1.0), 0)),
            Vorgabeherkunft.Abgeleitet when w.Wert is double x => string.Format(c, Texte.VorgabeAbgeleitet, Kurz(x, stellen)),
            Vorgabeherkunft.Leer when modell is double m => string.Format(c, Texte.Vorgabe, Kurz(m, stellen)),
            _ => ""
        };
    }

    /// <summary>Die Leistungsgrenze der Heizung: vom Gebäude (ab zwei Zonen anteilig), sonst „unbegrenzt".</summary>
    private string GrenzeVorgabe
        => _vorgaben is null ? ""
           : _vorgaben.HeizleistungMaxKw.Herkunft == Vorgabeherkunft.Leer ? Texte.VorgabeUnbegrenzt
           : Vorgabe(_vorgaben.HeizleistungMaxKw, 1);

    /// <summary>
    /// Infiltration und Nutzerlüftung: tragen weder Zone noch Gebäude einen Wert und hat das Gebäude
    /// eine Luftwechselrate, gilt sie (dann kein Platzhalter, die Zeile nennt sie); sonst die Vorgabe.
    /// </summary>
    private string LuftwechselVorgabe(Vorgabewert? v, double modell)
    {
        if (_vorgaben is null || v is not Vorgabewert w) return "";
        if (w.Herkunft != Vorgabeherkunft.Leer) return Vorgabe(w, 2);
        bool beideLeer = !_vorgaben.LuftwechselInfiltration.Wert.HasValue && !_vorgaben.LuftwechselNutzer.Wert.HasValue;
        return beideLeer && _vorgaben.Luftwechselrate > 0.0 ? "" : Vorgabe(w, 2, modell);
    }

    /// <summary>Der Luftwechsel der Zone [1/h] und woher er kommt — dieselbe Regel wie im Kern.</summary>
    private string Luftwechselzeile
    {
        get
        {
            if (_vorgaben is null) return "";
            double n = Gebaeudemodellvorgaben.WirksamerLuftwechsel(_vorgaben.Luftwechselrate,
                _vorgaben.LuftwechselInfiltration.Wert, _vorgaben.LuftwechselNutzer.Wert, out Luftwechselherkunft herkunft);
            string quelle = herkunft switch
            {
                Luftwechselherkunft.InfiltrationUndNutzer => Texte.HerkunftInfiltrationNutzer,
                Luftwechselherkunft.Luftwechselrate => Texte.HerkunftLuftwechselrate,
                _ => Texte.HerkunftVorgabe
            };
            return string.Format(CultureInfo.CurrentCulture, Texte.ZeileLuftwechsel, Kurz(n, 2), quelle);
        }
    }

    private static string Kurz(double w, int stellen)
        => w.ToString(stellen <= 0 ? "0" : "0." + new string('#', stellen), CultureInfo.CurrentCulture);

    private string NutzflaechePlatzhalter
        => !NutzflaechePflicht && NutzflaecheGebaeude is double a
            ? string.Format(CultureInfo.CurrentCulture, Texte.PlatzhalterNutzflaeche, Zahl(a, 2))
            : "";

    private string NutzflaecheZeile
        => string.Format(CultureInfo.CurrentCulture, NutzflaechePflicht ? Texte.ZeileNutzflaechePflicht : Texte.ZeileNutzflaeche,
                         NutzflaecheGebaeude is double a ? Zahl(a, 2) : "—");

    private static string ArtText(string art) => BauteilaufbauCtrl.BauteilartText(art);

    private string UText(BauteilDaten b)
    {
        if (b.UWert is double u) return Zahl(u, 3);
        if (b.UAufbau is double ua) return Zahl(ua, 3) + " (" + Texte.UAusAufbau + ")";
        return "—";
    }

    private static string Winkel(double? w) => w is double x ? Zahl(x, 0) + "°" : "—";

    private static string NeigungText(BauteilDaten b)
        => b.Neigung is double n ? Zahl(n, 0) + "°" : "(" + Zahl(GebaeudeZonenCtrl.NeigungVorgabe(b.Bauteilart), 0) + "°)";

    private string RandText(BauteilDaten b) => b.Randbedingung switch
    {
        null => GebaeudeZonenCtrl.LeerHeisstInnen(b.Bauteilart) ? BauteilTexte.RandVorgabeInnen : BauteilTexte.RandVorgabeAussen,
        DbWerte.RANDBEDINGUNG_AUSSENLUFT => BauteilTexte.RandAussenluft,
        DbWerte.RANDBEDINGUNG_ERDREICH => BauteilTexte.RandErdreich,
        DbWerte.RANDBEDINGUNG_UNBEHEIZT => BauteilTexte.RandUnbeheizt,
        DbWerte.RANDBEDINGUNG_ZONE => BauteilTexte.RandZone,
        _ => b.Randbedingung
    };

    /// <summary>Der Name der Nachbarzone einer Trennfläche; „—" ohne Nachbar.</summary>
    private string NachbarText(BauteilDaten b)
        => b.IdNachbarzone is int id
            ? Nachbarzonen.FirstOrDefault(n => n.Id == id)?.Bezeichner ?? "#" + id.ToString(CultureInfo.InvariantCulture)
            : "—";

    /// <summary>Der Azimut der Gegenseite: gespiegelt (+180°).</summary>
    private static string WinkelGespiegelt(double? w) => w is double x ? Winkel((x + 180.0) % 360.0) : "—";

    /// <summary>Die Neigung der Gegenseite: gespiegelt (180° − Neigung).</summary>
    private static string NeigungGespiegelt(BauteilDaten b)
        => Zahl(180.0 - (b.Neigung ?? GebaeudeZonenCtrl.NeigungVorgabe(b.Bauteilart)), 0) + "°";

    /// <summary>
    /// Der Summenfuß: Σ A je Gruppe der Hülle (gruppiert im Kern, <see cref="Gebaeudehuellbilanz.Zonenzeilen"/>)
    /// und H_T = Σ U·A + Σ ψ·L.
    /// </summary>
    private IReadOnlyList<(string Text, bool Stark)> Summen
    {
        get
        {
            if (_stand.Bauteile.Count == 0) return Array.Empty<(string, bool)>();
            var c = CultureInfo.CurrentCulture;
            IReadOnlyList<Huellzeile> zeilen = Zonensummen.Zeilen(_stand);
            var liste = new List<(string, bool)>();
            foreach (Huellzeile z in zeilen)
                if ((z.Groesse ?? 0.0) > 0.0)
                    liste.Add((string.Format(c, Texte.SummeGruppe, Zonensummen.Gruppentext(z.Bauteil), Zahl(z.Groesse, 2)), false));
            liste.Add((string.Format(c, Texte.SummeHT, Zahl(Zonensummen.HT(_stand), 1)), true));
            return liste;
        }
    }

    private static string Zahl(double? w, int stellen) => GebaeudeArbeitsstand.Zahl(w, stellen);

    // =================================================================================
    // Bauteile: oeffnen, anlegen, entfernen - alles im Arbeitsstand
    // =================================================================================

    private void BauteilOeffnen(int index)
    {
        if (index < 0 || index >= _stand.Bauteile.Count) return;
        _bauteilIndex = index;
        _bauteilNeu = false;
        _bauteil = _stand.Bauteile[index];
    }

    private void BauteilNeu()
    {
        int id = Math.Min(0, _stand.Bauteile.Count == 0 ? 0 : _stand.Bauteile.Min(b => b.Id)) - 1;
        _bauteilIndex = -1;
        _bauteilNeu = true;
        _bauteil = new BauteilDaten { Id = id, Herkunft = DbWerte.HERKUNFT_MANUELL };
    }

    private void BauteilEntfernen(int index)
    {
        if (index < 0 || index >= _stand.Bauteile.Count) return;
        _stand.Bauteile.RemoveAt(index);
        _meldung = "";
    }

    /// <summary>Der Bauteildialog ist zu: mit Ergebnis übernimmt die Zeile (neu angehängt), sonst bleibt alles.</summary>
    private void BauteilFertig(BauteilDaten? ergebnis)
    {
        BauteilDaten? offen = _bauteil;
        _bauteil = null;
        if (ergebnis is null || offen is null) return;
        if (_bauteilIndex >= 0 && _bauteilIndex < _stand.Bauteile.Count) _stand.Bauteile[_bauteilIndex] = ergebnis;
        else _stand.Bauteile.Add(ergebnis);
        _bauteilIndex = -1;
        _meldung = "";
    }

    // =================================================================================
    // Pruefen und Schliessen
    // =================================================================================

    private void FehlerMelden((string Feld, bool Fehlerhaft) e)
    {
        if (e.Fehlerhaft) _fehlerfelder.Add(e.Feld);
        else _fehlerfelder.Remove(e.Feld);
    }

    /// <summary>Die Prüfregeln der Zone — genau einmal, für OK und Assistent. <c>null</c> = gültig.</summary>
    private string? Pruefen()
    {
        if (_fehlerfelder.Count > 0)
            return string.Format(CultureInfo.CurrentCulture, BauteilTexte.MeldungUngueltig, _fehlerfelder.First());
        string name = (_stand.Bezeichner ?? "").Trim();
        if (name.Length == 0) return Texte.MeldungName;
        if (NutzflaechePflicht && _stand.Nutzflaeche is null)
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungNutzflaechePflicht, name);
        if (_stand.Nutzflaeche is double a && (!(a > 0.0) || double.IsInfinity(a)))
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungNutzflaeche, name);
        if (_stand.Raumhoehe is double h && (!(h > 0.0) || double.IsInfinity(h)))
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungRaumhoehe, name);
        if (_stand.Volumen is double v && (!(v > 0.0) || double.IsInfinity(v)))
            return string.Format(CultureInfo.CurrentCulture, Texte.MeldungVolumen, name);
        return null;
    }

    private Task BeiErgebnis(bool ok)
    {
        if (!ok) return Abbrechen();
        string? fehler = Pruefen();
        if (fehler is not null)
        {
            _meldung = fehler;
            return Task.CompletedTask;
        }
        _meldung = "";
        _stand.Bezeichner = _stand.Bezeichner.Trim();
        return Geschlossen.InvokeAsync(_stand.Kopie());
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Esc kaskadiert: der offene Bauteildialog wertet ihn selbst aus.
        if (e.Key != "Escape" || _bauteil is not null) return Task.CompletedTask;
        return Abbrechen();
    }

    /// <summary>Abbrechen — von Esc und vom Schliesskreuz gleichermaßen gerufen.</summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(null);
}
