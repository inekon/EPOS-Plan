    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        _varianten = Varianten is not null ? Varianten(zeile.CarrierId) : Array.Empty<(int, string)>();
        _detail = Katalogladung.Satz(() => ProjektDetail is not null ? ProjektDetail(zeile.GeraetId) : null,
