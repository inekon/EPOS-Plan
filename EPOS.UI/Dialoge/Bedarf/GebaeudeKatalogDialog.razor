    // =================================================================================
    // Der EINE Schreibweg: Pruefen, Ableiten, Speichern (Konzept 4.8; E27/U1)
    // =================================================================================

    /// <summary>
    /// Die Prüfregeln — genau einmal, für OK, „Speichern unter" und den Assistenten.
    /// Meldet die erste verletzte Regel und springt auf ihren Reiter.
    /// </summary>
    private bool Pruefen(bool mitName)
    {
        if (mitName && string.IsNullOrWhiteSpace(_stand.Name))
            return Verletzt(MeldungNameFehlt, REITER_HUELLE);

        foreach (string feld in _fehlerfelder)
            return Verletzt(Texte.MeldungUngueltig.Replace("{0}", feld), REITER_HUELLE);

        (double? wert, string name)[] pflicht =
        {
            (_stand.WohnflaecheGesamt, FeldWohnflaeche),
            (_stand.FlaecheNutzer, FeldFlaecheNutzer),
            (_stand.Waermegewinne, FeldWaermegewinne),
            (_stand.Fensterdurchlassgrad, FeldFensterdurchlassgrad),
            (_stand.Raumhoehe, FeldRaumhoehe),
            (_stand.Luftwechselrate, Feld(LabelLuftwechsel)),
            (_stand.UWertAussenwand, FeldUAussenwand),
            (_stand.FlaecheAussenwand, FeldFlaecheAussenwand),
            (_stand.UWertFenster, FeldUFenster),
            (_stand.UWertDachflaeche, FeldUDachflaeche),
            (_stand.Dachflaeche, FeldDachflaeche),
            (_stand.UWertGrundflaeche, FeldUGrundflaeche),
            (_stand.Grundflaeche, FeldGrundflaeche),
            (_stand.UWertSonstiges, FeldUSonstiges),
            (_stand.SonstigeFlaechen, FeldSonstigeFlaechen),
            (_stand.FensterflaecheNord, FeldFFNord),
            (_stand.FensterflaecheSued, FeldFFSued)
        };
        foreach ((double? wert, string name) in pflicht)
            if (wert is null) return Verletzt(string.Format(MeldungZahlFehlt, name), REITER_HUELLE);

        if (!(_stand.WohnflaecheGesamt > 0)) return Verletzt(Texte.MeldungNutzflaeche, REITER_HUELLE);
        if (!(_stand.FlaecheNutzer > 0)) return Verletzt(Texte.MeldungFlaecheNutzer, REITER_HUELLE);
        if (!(_stand.Raumhoehe > 0)) return Verletzt(Texte.MeldungRaumhoehe, REITER_HUELLE);
        if (!(_stand.Luftwechselrate > 0)) return Verletzt(Texte.MeldungLuftwechsel, REITER_HUELLE);
        if (!(_stand.Fensterdurchlassgrad > 0 && _stand.Fensterdurchlassgrad <= 1))
            return Verletzt(Texte.MeldungGWert, REITER_HUELLE);

        // U-Werte nur fuer Bauteile, die eine Flaeche haben - ein Bauteil ohne Flaeche
        // traegt keinen Waermestrom.
        foreach (Huellzeile z in Huellzeilen)
        {
            if (z.IstWaermebruecke || !((z.Groesse ?? 0) > 0)) continue;
            double u = z.Kennwert ?? 0;
            if (u < Gebaeudehuellbilanz.U_MIN || u > Gebaeudehuellbilanz.U_MAX)
                return Verletzt(Texte.MeldungUBereich.Replace("{0}", Zeilentext(z.Bauteil)), REITER_HUELLE);
        }

        if (Gebaeudehuellbilanz.MittleresUOpak(Huellzeilen) is double uMittel
            && uMittel >= Gebaeudehuellbilanz.U_OPAK_MITTEL_MAX)
            return Verletzt(Texte.MeldungRRest, REITER_HUELLE);

        if (SummeOstWest is null) return Verletzt(Texte.MeldungOstWest, REITER_HUELLE);

        double bauweise = _bauweiseNachfuehren
            ? Gebaeudebauweise.BauweiseAusBauart(_stand.Bauart, _stand.WohnflaecheGesamt ?? 0)
            : _stand.Bauweise;
        double spezifisch = bauweise / (_stand.WohnflaecheGesamt ?? 1);
        if (spezifisch < Gebaeudehuellbilanz.BAUWEISE_JE_M2_MIN || spezifisch > Gebaeudehuellbilanz.BAUWEISE_JE_M2_MAX)
            return Verletzt(Texte.MeldungBauweise, REITER_HUELLE);

        // Stufe KU1 (Kuehlkonzept 8.1): die Regeln der Gruppe „Kuehlung" - nur mit Haken. Der
        // Abstand zum hoechsten Heizsollwert ist DIESELBE Zahl, mit der der Loeser abbricht
        // (Gebaeudemodellvorgaben.KuehlsollwertAbstand); ein leerer Sollwert heisst „Kuehlung
        // aus" und ist erlaubt.
        if (_stand.KuehlungAktiv)
        {
            if (_stand.KuehlSollwert is double soll)
            {
                if (soll < Gebaeudemodellvorgaben.KUEHLSOLLWERT_MIN || soll > Gebaeudemodellvorgaben.KUEHLSOLLWERT_MAX)
                    return Verletzt(string.Format(Texte.MeldungKuehlsollwertBereich,
                                                  Zahl(Gebaeudemodellvorgaben.KUEHLSOLLWERT_MIN, 0),
                                                  Zahl(Gebaeudemodellvorgaben.KUEHLSOLLWERT_MAX, 0)), REITER_HUELLE);
                double heizMax = HoechsterHeizsollwert;
                if (soll < heizMax + Gebaeudemodellvorgaben.KuehlsollwertAbstand)
                    return Verletzt(string.Format(Texte.MeldungKuehlsollwertHeizung, Zahl(soll, 1), Zahl(heizMax, 1),
                                                  Zahl(Gebaeudemodellvorgaben.KuehlsollwertAbstand, 0)), REITER_HUELLE);
            }
            if (_stand.KuehlleistungMax is double grenze && !(grenze > 0))
                return Verletzt(Texte.MeldungKuehlleistung, REITER_HUELLE);
        }

        string? regel = Ferienzeit.Pruefen(Ferienbeginne(), Ferienenden());
        if (regel is not null) return Verletzt(FerienMeldung(regel), REITER_TEMPERATUREN);

        return true;
    }

    private bool Verletzt(string meldung, string reiter)
    {
        Melden(meldung, WarnStufe.Warnung);
        _reiter = reiter;
        return false;
    }

    private int[] Ferienbeginne()
    {
        var b = new int[4];
        for (int n = 0; n < 4; n++) b[n] = Ferienzeit.Jahrestag(_beginnMonat[n], _beginnTag[n]);
        return b;
    }

    private int[] Ferienenden()
    {
        var e = new int[4];
        for (int n = 0; n < 4; n++) e[n] = Ferienzeit.Jahrestag(_endeMonat[n], _endeTag[n]);
        return e;
    }

    /// <summary>
    /// Die Ableitungen des Vorläufers (<c>btn_Speichern_Click</c> der zweiten Maske) und
    /// der Hülle — jetzt im OK-Weg: leere Felder des zweiten Reiters gelten als 0,
    /// Maximaltemperatur &lt; 1 → 24, die Flags Wochenende und Ferien, WW_Bedarf 0,
    /// Winterferienbeginn 0 → 366; dazu die Summe Ost + West und die Bauweise.
    /// </summary>
    private void Ableiten()
    {
        if (_bauweiseNachfuehren) BauweiseNachfuehren();

        _stand.FensterflaecheOstWest = SummeOstWest ?? 0;

        _stand.SollTag ??= 0;
        _stand.NachtAbsenkung ??= 0;
        double max = _stand.MaxTemperatur ?? 0;
        _stand.MaxTemperatur = max < 1 ? 24 : max;
        _stand.WochenendAbsenkung ??= 0;
        _stand.Wochenende = (_stand.WochenendAbsenkung ?? 0) > 0 ? 1 : 0;
        _stand.SollFerien ??= 0;
        _stand.Ferien = (_stand.SollFerien ?? 0) > 0 ? 1 : 0;

        _stand.WbvkFensterWand ??= 0;
        _stand.WbvkAussenwandKeller ??= 0;
        _stand.WbvkWandDach ??= 0;
        _stand.AnschlussFensterWand ??= 0;
        _stand.AnschlussWandDach ??= 0;
        _stand.AnschlussAussenwandKeller ??= 0;

        int[] beginn = Ferienbeginne();
        beginn[0] = Ferienzeit.WinterbeginnGehoben(beginn[0]);
        _stand.Ferienbeginn = beginn;
        _stand.Ferienende = Ferienenden();

        _stand.WwBedarf = 0;
    }

    /// <summary>
    /// Prüft, leitet ab und schreibt — der eine Schreibweg. <c>false</c> = eine Regel
    /// ist verletzt oder die Hülle hat abgelehnt; die Meldung steht dann.
    /// </summary>
    private bool Schreiben(bool istNeu, string bezeichner)
    {
        if (!Pruefen(istNeu)) return false;
        if (Speichern is null) return true;

        Ableiten();
        GebaeudeKatalogErgebnis ergebnis = Speichern(_stand, istNeu, bezeichner);
        if (!ergebnis.Erfolg)
        {
            Melden(ergebnis.Meldung, WarnStufe.Warnung);
            return false;
        }

        _geschrieben = true;
        _ursprungsname = bezeichner;
        _modellBeimLaden = _stand.Modell;
        _randBeimLaden = _stand.GrundflaecheRandbedingung;
        _meldung = "";
        return true;
    }

    /// <summary>
    /// Die Leiste: OK prüft, speichert und schließt — im Modus Neu wird angelegt, sonst
    /// der Satz unter seinem Ursprungsnamen überschrieben. Abbrechen schließt ohne zu
    /// schreiben.
    /// </summary>
    private async Task BeiErgebnis(bool ok)
    {
        if (!ok) { await Abbrechen(); return; }

        bool istNeu = Modus == GebaeudeKatalogModus.Neu;
        if (!Schreiben(istNeu, istNeu ? _stand.Name : _ursprungsname)) return;
        await Geschlossen.InvokeAsync(true);
    }

    /// <summary>„Speichern unter" — derselbe OK-Weg, angelegt unter dem eingegebenen Namen.</summary>
    private async Task BeiSpeichernUnter()
    {
        if (!Schreiben(istNeu: true, bezeichner: _stand.Name)) return;
        await Geschlossen.InvokeAsync(true);
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Die Ueberlagerung wertet Esc zuerst fuer sich aus.
        if (e.Key != "Escape" || _brauchwasserGaben is not null) return Task.CompletedTask;
        return Abbrechen();
    }

    /// <summary>
    /// Abbrechen, Esc und das Kreuz: schließen ohne zu schreiben. Hat der Assistent
    /// zwischendurch gespeichert, meldet der Rückweg das mit <c>true</c>.
    /// </summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(_geschrieben);
}
