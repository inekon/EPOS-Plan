@* Die Ueberlagerung "AUSLEGUNG" des Zapfprofils (Umsetzungskonzept Zapfprofilgenerator
   4.5, 4.7, 5.1; Stufe Z2, Gruppe 2).

   WO SIE STEHT. Im Dialog "Brauchwasser-Zapfprofil" ueber den Knopf "Auslegung..." der
   Fussleiste, als Ueberlagerung (die vierte im Assistenten); eingebettet traegt die
   Ueberlagerung Titel und Kreuz, der Wirt setzt TitelAnzeigen="false".

   WAS SIE TUT. Oben die Eingaben der Summenlinie (Bedarfstag mit Quelle, "Bedarfstag
   konstruieren..." als weitere Ueberlagerung, Speichertemperatur, Erzeuger- und
   Uebertragerleistung, Speicherart, Sensorhoehe, Erzeugerart und Werkstoff - beide mit dem
   Projekt gespeichert, die Erzeugerart mit dem Vorschlag des Projekts als Knopf), dann die
   Eingaben des Verfahrensvergleichs als Felder (Ladeleistung auto/manuell mit Vorschlag,
   Ladezeitfenster, Personen auto/manuell, nutzbarer Anteil, Zuschlag, Bezug des Fuellstands;
   N11 (d), Z4), darunter je Topologiegruppe die drei Karten der Dreiergruppe NEBENEINANDER (schmal
   untereinander), der EINE empfohlene Punkt, getrennt davon der Verfahrensvergleich der
   Speicherauslegung als nachrichtlicher Vorschlag mit Wochenbild und die Warnliste. Sie
   RECHNET NICHTS: Ergebnis, Bilder und Saetze kommen aus der Huelle (Delegat "Rechnen").

   WAS SIE NICHT TUT. Sie schreibt nicht. OK uebernimmt die Eingaben samt Punkt in den
   Arbeitsstand des Zapfprofils (geschrieben wird mit dem OK des Bedarfsprofil-Dialogs);
   stammt der Bedarfstag aus dem Stundenprofil, fragt eine Rueckfrage vorher. Abbrechen,
   Esc und das Kreuz verwerfen (null).

   VORGABEREGEL (4.5). Ohne konstruierten Tag oeffnet die Auslegung den Konstruktor, statt
   still das Stundenprofil zu nehmen: beim Oeffnen und wenn eine Neuberechnung den Fall neu
   herbeifuehrt (KonstruktorOeffnen einer Gruppe), nicht nach jedem Abbrechen erneut. Ein Tag
   aus dem Stundenprofil traegt das Warnbanner "Spitzen unterschaetzt" (SpitzenUnterschaetzt).

   STOCHASTIK (Stufe Z3, 4.5 b). Der Schalter "Stochastisch rechnen" (eine Laufangabe) zieht
   je Topologiegruppe das Ensemble des Bedarfstags NEBENLAEUFIG (Delegat "StochastischRechnen":
   Arbeitsfaden der Huelle, Abbruchmarke bis in den Kern; Fortschritt mit Abbrechen, Karte (b)
   "rechnet ..." bis zum Ergebnis, das per InvokeAsync kommt; ein Abbruch schaltet ihn aus und
   rechnet deterministisch nach; der Delegat "Rechnen" rechnet stets ohne Ensemble). Mit ihm
   stehen das Auslegungsperzentil
   (P95 | P99) und die Realisierungen des Bedarfstags (leer = Vorgabe des Kerns) in den
   Eingaben. Die Karte (b) zeigt dann den Perzentilwert der Auslegungsgroesse (Speicher:
   Volumen beim Phi_N des Summenlinienpunkts; sonst Minutenspitze), das Streuband P50 ... P99
   samt Spannweite als Tabellenzeilen, die Gleichzeitigkeit als Ergebnis (GLF_V bzw. GLF_P mit
   Bezug), den Vermerk "nicht belastbar" bei R < 1/(1 - p); die Speichergruppe traegt den
   Konsistenzhinweis als Kohaerenzzeile. Ohne Schalter bleibt das Perzentil "noch nicht
   gerechnet"; der Wirt oeffnet die Ueberlagerung mit eingeschaltetem Schalter ueber die
   Eingaben (Knopf "Stochastisch rechnen" des Zapfprofils) - dann ohne Ergebnis, und genau ein
   Lauf rechnet gleich nebenlaeufig mit Ensemble. Kein neues Bild.

   BENANNT GESPERRT. Der Konsistenzhinweis vor dem Lauf (braucht das Perzentil), der
   Rohrnetz-Spitzendurchfluss nach DIN 1988-300 (die Summe der Entnahmearmaturen fehlt im
   Datenmodell), die Quellen A100-Referenzprofil und Ecodesign-Zapfprofil (solange der Katalog
   keine Zeile ihrer Art traegt) sowie "An Speicherauslegung uebergeben..." stehen da,
   gesperrt mit Grund.

   ENTPRELLT. Jede Eingabe rechnet neu, erst EntprellungMs nach der letzten (0 = sofort,
   bunit).

   HILFE-ASSISTENT (Welle #458, Stufe 3a). Die Ueberlagerung meldet sich als EIGENE Maske an
   (KiMaskennamen.ZAPFPROFIL_AUSLEGUNG), solange sie offen steht - angemeldet sind ihre
   Eingaben ueber ZapfprofilAuslegungKiSicht, gesetzt auf den Wegen der Eingabefelder (jede
   Setzung rechnet neu), dazu der empfohlene Punkt nur lesbar. Pruefen ist der Befund des OK;
   kein Speicherweg - OK bleibt beim Anwender. *@

@namespace EPOS.UI.Dialoge.Bedarf
@using System.Globalization
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-dialog epos-zapfausl" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    <div class="epos-dialog-kopf @(TitelAnzeigen ? "" : "epos-dialog-kopf--ohnetitel")">
        @if (TitelAnzeigen)
        {
            <h1 class="epos-dialog-titel">@Texte.Titel</h1>
        }
        <InfoKnopf Schluessel="@HilfeSchluessel" StandardKurztext="@Texte.InfoBedienung" Dialogname="@Texte.Titel" />
        <InfoKnopf Schluessel="@HilfeRechenweg" StandardKurztext="@Texte.InfoRechenweg" Dialogname="@Texte.Titel" />
        @if (TitelAnzeigen)
        {
            <Schliesskreuz Geschlossen="Abbrechen" />
        }
    </div>

    <p class="epos-kontextzeile">@Daten.Kontext</p>

    @if (!Daten.Verfuegbar && Daten.Sperrgrund.Length > 0)
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@Daten.Sperrgrund" />
    }

    @if (_hinweis.Length > 0)
    {
        <p class="epos-leisezeile epos-zapfausl-hinweis" role="status">@_hinweis</p>
    }

    @* ------------------------------------------------ Eingaben der Summenlinie --- *@
    <Gruppenkopf Titel="@Texte.GruppeEingaben">
        <KindInhalt>
            <Formularraster>
                <KindInhalt>
                    <Auswahlfeld Bezeichnung="@Texte.LabelBedarfstag" Eintraege="@Bedarfstagwahl"
                                 Auswahl="@BedarfstagAuswahl" AuswahlChanged="BedarfstagWaehlen"
                                 GesperrteEintraege="@GesperrteTage" GesperrtHinweise="@Sperrgruende" />
                    <Herleitungszeile Text="@BedarfstagHerleitung" />
                    @if (Konstruieren is not null)
                    {
                        <div class="epos-zapfausl-konstruktorknopf">
                            <button type="button" class="epos-knopf" @onclick="KonstruktorOeffnen">@Texte.KnopfKonstruieren</button>
                        </div>
                        <Herleitungszeile Text="@Texte.HinweisKonstruktor" />
                    }
                    <Zahlenfeld Bezeichnung="@Texte.LabelSpeichertemperatur" Feldname="@Texte.LabelSpeichertemperatur"
                                Einheit="°C" Wert="@_eingabe.SpeicherC" WertChanged="SpeicherCSetzen" />
                    <Herleitungszeile Text="@SpeicherCHerleitung" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelErzeugerleistung" Feldname="@Texte.LabelErzeugerleistung"
                                Einheit="kW" Min="0" Wert="@_eingabe.ErzeugerKw" WertChanged="ErzeugerSetzen" />
                    <Herleitungszeile Text="@Texte.HerleitungErzeuger" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelUebertragerleistung" Feldname="@Texte.LabelUebertragerleistung"
                                Einheit="kW" Min="0" Wert="@_eingabe.UebertragerKw" WertChanged="UebertragerSetzen" />
                    <Herleitungszeile Text="@Texte.HerleitungUebertrager" />
                    <Optionsgruppe Bezeichnung="@Texte.LabelSpeicherart" Eintraege="@Speicherarten"
                                   Auswahl="@((int)_eingabe.Speicherart)" AuswahlChanged="SpeicherartSetzen" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelSensorhoehe" Feldname="@Texte.LabelSensorhoehe"
                                Min="0" Max="1" Wert="@_eingabe.SensorhoeheAnteil" WertChanged="SensorSetzen" />
                    <Herleitungszeile Text="@Texte.HerleitungSensorhoehe" />
                    <Auswahlfeld Bezeichnung="@Texte.LabelErzeugerart" Eintraege="@Erzeugerarten"
                                 Auswahl="@((int)_eingabe.Erzeugerart)" AuswahlChanged="ErzeugerartSetzen" />
                    @* N10 (i), Schritt 124: Die Wahl wird mit dem Projekt gespeichert; der Vorschlag des
                       Projekts (eindeutiger Anlagenbestand) ist eine Wahl, die der Anwender übernimmt. *@
                    @if (ErzeugerVorschlag is { } vorschlag)
                    {
                        <Vorschlagszeile Text="@Format(Texte.LabelErzeugerVorschlag, Erzeugerartname(vorschlag))"
                                         Knopftext="@Texte.KnopfErzeugerVorschlag"
                                         Uebernommen="() => ErzeugerartSetzen((int)vorschlag)" />
                    }
                    <Herleitungszeile Text="@Format(Texte.HerleitungGespeichert, _ergebnis?.ErzeugerartHerkunft ?? "")" />
                    <Auswahlfeld Bezeichnung="@Texte.LabelWerkstoff" Eintraege="@Werkstoffe"
                                 Auswahl="@((int)_eingabe.Werkstoff)" AuswahlChanged="WerkstoffSetzen" />
                    <Herleitungszeile Text="@Format(Texte.HerleitungGespeichert, Texte.HerleitungWerkstoff)" />
                    <Schalter Bezeichnung="@Texte.LabelStochastisch" Wert="@_eingabe.Stochastisch" WertChanged="StochastischSetzen" />
                    <Herleitungszeile Text="@Texte.HerleitungStochastisch" />
                    @if (_eingabe.Stochastisch)
                    {
                        if (Daten.Perzentile.Count > 0)
                        {
                            <Optionsgruppe Bezeichnung="@Texte.LabelPerzentil" Eintraege="@Perzentilwahl"
                                           Auswahl="@PerzentilAuswahl" AuswahlChanged="PerzentilSetzen" />
                            <Herleitungszeile Text="@Format(Texte.HerleitungPerzentil, Ganz(Daten.PerzentilVorgabe))" />
                        }
                        <Ganzzahlfeld Bezeichnung="@Texte.LabelRealisierungen" Feldname="@Texte.LabelRealisierungen"
                                      Einheit="@Texte.EinheitTage" Min="@Daten.RealisierungenMindestens"
                                      Max="@Daten.RealisierungenHoechstens"
                                      Wert="@_eingabe.RealisierungenAuslegung" WertChanged="RealisierungenSetzen"
                                      Platzhalter="@Klammer(RealisierungenVorgabe)" FehlerZustand="FehlerZustandMelden" />
                        <Herleitungszeile Text="@RealisierungenHerleitung" />
                    }
                </KindInhalt>
            </Formularraster>
        </KindInhalt>
    </Gruppenkopf>

    @* ------------------------------------ Eingaben des Verfahrensvergleichs (4.7, N11 (d)) --- *@
    <Gruppenkopf Titel="@Texte.GruppeVergleichEingaben" Summe="@Texte.Nachrichtlich">
        <KindInhalt>
            <p class="epos-leisezeile">@Texte.HinweisVergleichEingaben</p>
            <Formularraster>
                <KindInhalt>
                    <Formulargruppe Titel="@Texte.LabelLadeleistung">
                        <KindInhalt>
                            <Optionsgruppe Bezeichnung="@Texte.LabelLadeleistung" Eintraege="@AutoManuell"
                                           Auswahl="@(_eingabe.LadeAuto ? AUTO : MANUELL)" AuswahlChanged="LadeModusSetzen" />
                            @if (ErsterVergleich?.Ladeleistung is { } lade)
                            {
                                <Vorschlagszeile Text="@Vorschlagstext(lade.Vorschlag, lade.Einheit)" Knopftext="@Texte.KnopfVorschlag"
                                                 Erlaubt="@lade.Vorschlag.HasValue" Sperrgrund="@Texte.HerleitungLadeOhne"
                                                 Uebernommen="() => LadeVorschlagUebernehmen(lade.Vorschlag)" />
                            }
                            else
                            {
                                <Herleitungszeile Text="@Texte.HerleitungLadeOhne" />
                            }
                            <Zahlenfeld Bezeichnung="@Texte.LabelLadeManuell" Feldname="@Texte.LabelLadeManuell"
                                        Einheit="kW" Min="0" Wert="@_eingabe.LadeManuellKw" WertChanged="LadeManuellSetzen"
                                        FehlerZustand="FehlerZustandMelden" />
                            @if (ErsterVergleich is { } lv)
                            {
                                <Herleitungszeile Text="@Format(Texte.HerleitungLade, Zahl(lv.LadeleistungKw, "N1"), lv.LadeManuell ? Texte.Manuell : Texte.Auto, lv.LadeRechenweg)" />
                            }
                            <Zahlenfeld Bezeichnung="@Texte.LabelLadefenster" Feldname="@Texte.LabelLadefenster"
                                        Einheit="h/d" Min="0" Max="24" Wert="@_eingabe.LadefensterH" WertChanged="LadefensterSetzen"
                                        FehlerZustand="FehlerZustandMelden" />
                            <Zahlenfeld Bezeichnung="@Texte.LabelLadefensterBeginn" Feldname="@Texte.LabelLadefensterBeginn"
                                        Einheit="h" Min="0" Max="24" Wert="@_eingabe.LadefensterBeginnH" WertChanged="LadefensterBeginnSetzen"
                                        FehlerZustand="FehlerZustandMelden" />
                            <Herleitungszeile Text="@Texte.HerleitungLadefenster" />
                        </KindInhalt>
                    </Formulargruppe>
                    <Formulargruppe Titel="@Texte.LabelPersonen">
                        <KindInhalt>
                            <Optionsgruppe Bezeichnung="@Texte.LabelPersonen" Eintraege="@AutoManuell"
                                           Auswahl="@(_eingabe.PersonenAuto ? AUTO : MANUELL)" AuswahlChanged="PersonenModusSetzen" />
                            <Zahlenfeld Bezeichnung="@Texte.LabelPersonenManuell" Feldname="@Texte.LabelPersonenManuell"
                                        Min="0" Wert="@_eingabe.PersonenManuell" WertChanged="PersonenManuellSetzen"
                                        FehlerZustand="FehlerZustandMelden" />
                            @if (ErsterVergleich is { } pv)
                            {
                                <Herleitungszeile Text="@Format(Texte.HerleitungPersonen, Zahl(pv.PersonenVorschlag, "N1"), Zahl(pv.Personen, "N1"))" />
                            }
                        </KindInhalt>
                    </Formulargruppe>
                    <Zahlenfeld Bezeichnung="@Texte.LabelNutzanteil" Feldname="@Texte.LabelNutzanteil"
                                Min="0" Max="1" Wert="@_eingabe.Nutzanteil" WertChanged="NutzanteilSetzen"
                                FehlerZustand="FehlerZustandMelden" />
                    <Herleitungszeile Text="@Format(Texte.HerleitungAngesetzt, ErsterVergleich is { } nv ? Zahl(nv.Nutzanteil, "0.###") : "–")" />
                    <Zahlenfeld Bezeichnung="@Texte.LabelZuschlag" Feldname="@Texte.LabelZuschlag"
                                Min="0" Wert="@_eingabe.Zuschlag" WertChanged="ZuschlagSetzen"
                                FehlerZustand="FehlerZustandMelden" />
                    <Herleitungszeile Text="@Format(Texte.HerleitungAngesetzt, ErsterVergleich is { } zv ? Prozent(zv.Zuschlag) : "–")" />
                    <Auswahlfeld Bezeichnung="@Texte.LabelFuellstandBezug" Eintraege="@Fuellstandbezuege"
                                 Auswahl="@((int)_eingabe.FuellstandBezug)" AuswahlChanged="FuellstandSetzen" />
                    <Herleitungszeile Text="@Format(Texte.HerleitungFuellstand, ErsterVergleich is { } fv && fv.FuellstandBezug.Length > 0 ? fv.FuellstandBezug + (fv.FuellstandBezugL is double fl ? " " + Zahl(fl, "N0") + " l" : "") : "–")" />
                </KindInhalt>
            </Formularraster>
        </KindInhalt>
    </Gruppenkopf>

    @* Der nebenläufige Lauf des Ensembles (5.1): Status und Abbruch, nie im Zeichenfaden. *@
    <Fortschritt Sichtbar="@EnsembleLaeuft" Text="@Texte.StatusEnsembleLaeuft"
                 Abbrechen="@(EventCallback.Factory.Create(this, EnsembleAbbrechen))" />

    @* ------------------------------------------------ je Topologiegruppe ---------- *@
    @if (_ergebnis is null || _ergebnis.Zustand != ZapfprofilAuslegungZustand.Gerechnet)
    {
        <p class="epos-leisezeile epos-zapfausl-ohne" role="status">@(EnsembleLaeuft && _ergebnis is null ? Texte.StatusEnsembleLaeuft : OhneGrund)</p>
    }
    else
    {
        for (int gi = 0; gi < _ergebnis.Gruppen.Count; gi++)
        {
            int gruppe = gi;
            ZapfprofilAuslegungsgruppeDaten g = _ergebnis.Gruppen[gi];
            <Gruppenkopf Titel="@Format(Texte.GruppeTopologie, g.Topologie, string.Join(", ", g.Zonen))"
                         Summe="@(g.Bedarfstag.Length > 0 ? Format(Texte.BedarfstagGruppe, g.Bedarfstag) : "")">
                <KindInhalt>
                    @if (g.BedarfstagWahl.Length > 0)
                    {
                        <p class="epos-leisezeile epos-zapfausl-wahl">@g.BedarfstagWahl</p>
                    }
                    @if (g.SpitzenUnterschaetzt)
                    {
                        <Warnbanner Stufe="WarnStufe.Warnung" Text="@Texte.BannerSpitzen" />
                    }
                    <div class="epos-zapfausl-karten">

                        @* (a) Summenlinie bzw. Minutenspitze *@
                        <section class="epos-zapfausl-karte epos-zapfausl-karte--haupt"
                                 aria-label="@(g.Speicher ? Texte.KarteSummenlinie : Texte.KarteMinutenspitze)">
                            <h4>@(g.Speicher ? Texte.KarteSummenlinie : Texte.KarteMinutenspitze)</h4>
                            <p class="epos-leisezeile">@(g.Speicher ? Texte.KarteSummenlinieUnter : Texte.KarteMinutenspitzeUnter)</p>
                            @if (g.Hauptwert.Stand == ZapfprofilKartenstand.Gerechnet)
                            {
                                if (g.SummenlinieModell is not null)
                                {
                                    <DiagrammSvg Modell="@g.SummenlinieModell" Kennung="@("zapfausl-summenlinie-" + gruppe)"
                                                 Bezeichnung="@Texte.KarteSummenlinie" />
                                }
                                if (g.WertepaarModell is not null)
                                {
                                    <DiagrammSvg Modell="@g.WertepaarModell" Kennung="@("zapfausl-wertepaare-" + gruppe)"
                                                 Bezeichnung="@Texte.KarteSummenlinie" />
                                }
                                else if (g.Speicher)
                                {
                                    <p class="epos-leisezeile">@Texte.WertepaareOhne</p>
                                }
                                <div class="epos-zapfausl-wert"><span>@Texte.GewaehlterPunkt</span><b>@Punkttext(g)</b></div>
                                if (g.LadezeitH is double ladezeit)
                                {
                                    <div class="epos-zapfausl-wert"><span>@Texte.Ladezeit</span><b>@(Zahl(ladezeit, "N1") + " h/d")</b></div>
                                }
                                if (g.ZeitkonstanteMin is double tau)
                                {
                                    <div class="epos-zapfausl-wert"><span>@Texte.Zeitkonstante</span><b>@(Zahl(tau, "N0") + " min")</b></div>
                                }
                            }
                            else
                            {
                                <p class="epos-leisezeile epos-zapfausl-grund">@Standtext(g.Hauptwert)</p>
                            }
                        </section>

                        @* (b) Perzentil aus dem Ensemble des Bedarfstags (4.5 b) *@
                        <section class="epos-zapfausl-karte epos-zapfausl-karte--perzentil" aria-label="@Texte.KartePerzentil">
                            <h4>@Texte.KartePerzentil</h4>
                            <p class="epos-leisezeile">@Texte.KartePerzentilUnter</p>
                            @if (EnsembleLaeuft)
                            {
                                <p class="epos-leisezeile epos-zapfausl-perzentil-laeuft" role="status">@Texte.PerzentilLaeuft</p>
                            }
                            else if (g.PerzentilErgebnis is { } pz)
                            {
                                <p class="epos-leisezeile epos-zapfausl-perzentil-lauf">@Format(Texte.PerzentilLauf, pz.Seed, pz.Realisierungen, pz.Datum.Length > 0 ? pz.Datum : Ganz(pz.Tag))</p>
                                @* P_p = ∞ (ohne Nachweis beim Φ_N): der Satz des Kerns und ein eigener „entfällt". *@
                                if (g.Perzentil.Stand == ZapfprofilKartenstand.NichtRechenbar)
                                {
                                    <p class="epos-leisezeile epos-zapfausl-grund epos-zapfausl-perzentil-grund">@Standtext(g.Perzentil)</p>
                                }
                                if (PerzentilEntfaellt(pz))
                                {
                                    <p class="epos-leisezeile epos-zapfausl-grund epos-zapfausl-perzentil-entfaellt">@Format(Texte.PerzentilEntfaellt, Zahl(pz.LeistungKw, "N1"), Ganz(pz.OhneNachweis), Ganz(pz.Realisierungen))</p>
                                }
                                <div class="epos-zapfausl-wert epos-zapfausl-perzentil-wert">
                                    <span>@Format(pz.Volumen ? Texte.PerzentilVolumen : Texte.PerzentilMinutenspitze, pz.Perzentil)</span>
                                    <b>@Perzentilhaupttext(pz)</b>
                                    @if (!pz.Belastbar)
                                    {
                                        <span class="epos-zapfausl-marke epos-zapfausl-marke--warnung epos-zapfausl-nichtbelastbar"
                                              title="@NichtBelastbarGrund(pz)">@Texte.NichtBelastbar</span>
                                    }
                                </div>
                                if (!pz.Belastbar)
                                {
                                    <p class="epos-leisezeile epos-zapfausl-grund epos-zapfausl-nichtbelastbar-grund">@NichtBelastbarGrund(pz)</p>
                                }
                                @* Wohnungsstation (4.5, N10 (d)): die Auslegungsgröße je Einheit samt Zone. *@
                                if (pz.SpitzeJeEinheitKw is double jeEinheit)
                                {
                                    <div class="epos-zapfausl-wert epos-zapfausl-je-einheit">
                                        <span>@Format(Texte.SpitzeJeEinheit, pz.Perzentil)</span><b>@(Zahl(jeEinheit, "N1") + " kW")</b>
                                    </div>
                                    <p class="epos-leisezeile epos-zapfausl-je-einheit-zone">@Format(Texte.SpitzeJeEinheitZone, pz.SpitzeJeEinheitZone)</p>
                                }
                                <p class="epos-leisezeile">@Format(Texte.Streuband, pz.Realisierungen)</p>
                                <table class="epos-raster epos-kennzahlen epos-zapfausl-streuband">
                                    <thead>
                                        <tr>
                                            <th scope="col">@Texte.SpaltePerzentil</th>
                                            <th scope="col">@Texte.SpalteWert</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ZapfprofilPerzentilZeileDaten z in pz.Streuband)
                                        {
                                            <tr class="@(z.Perzentil == pz.Perzentil ? "epos-zeile--markiert" : null)">
                                                <th scope="row">P@(z.Perzentil)</th>
                                                <td class="epos-zahl">@Perzentilwerttext(pz, z.Wert)</td>
                                            </tr>
                                        }
                                        <tr class="epos-zapfausl-spannweite">
                                            <th scope="row">@Texte.Spannweite</th>
                                            <td class="epos-zahl">@(Perzentilwerttext(pz, pz.Minimum) + " – " + Perzentilwerttext(pz, pz.Maximum))</td>
                                        </tr>
                                    </tbody>
                                </table>
                                if (pz.OhneNachweis > 0)
                                {
                                    <p class="epos-leisezeile epos-zapfausl-ohnenachweis">@Format(Texte.OhneNachweis, pz.OhneNachweis, pz.Realisierungen)</p>
                                }
                                <div class="epos-zapfausl-wert epos-zapfausl-glf">
                                    <span>@(pz.Volumen ? Texte.GlfV : Texte.GlfP)</span><b>@(pz.Gleichzeitigkeit is double glf ? Zahl(glf, "N2") : Texte.Entfaellt)</b>
                                </div>
                                <p class="epos-leisezeile epos-zapfausl-glf-bezug">@Format(pz.Volumen ? Texte.GlfVBezug : Texte.GlfPBezug, pz.Perzentil, pz.Einheiten)</p>
                                <p class="epos-leisezeile epos-zapfausl-perzentil-info">@Format(Texte.PerzentilNachrichtlich, pz.Perzentil, Zahl(pz.MinutenspitzeKw, "N1"), Zahl(pz.StundenspitzeKw, "N1"))</p>
                                if (pz.WurzelNKw is double wurzelN)
                                {
                                    <p class="epos-leisezeile epos-zapfausl-perzentil-info">@Format(Texte.WurzelN, Zahl(wurzelN, "N1"))</p>
                                }
                            }
                            else if (g.Perzentil.Stand == ZapfprofilKartenstand.NichtRechenbar)
                            {
                                <p class="epos-leisezeile epos-zapfausl-grund">@Standtext(g.Perzentil)</p>
                            }
                            else
                            {
                                <p class="epos-leisezeile epos-zapfausl-perzentil">@Texte.PerzentilOffen</p>
                            }
                        </section>

                        @* (c) Normvergleich *@
                        <section class="epos-zapfausl-karte epos-zapfausl-karte--norm" aria-label="@Texte.KarteNorm">
                            <h4>@Texte.KarteNorm</h4>
                            <p class="epos-leisezeile">@Texte.KarteNormUnter</p>
                            @if (g.Normvergleich.Stand == ZapfprofilKartenstand.Gerechnet)
                            {
                                <div class="epos-zapfausl-wert"><span>@Texte.Bedarfskennzahl</span><b>@Zahl(g.KennzahlN, "N1")</b></div>
                                <div class="epos-zapfausl-wert"><span>@Texte.Vergleichspunkt</span><b>@Liter(g.Normvergleich.VolumenL)</b></div>
                            }
                            else
                            {
                                <p class="epos-leisezeile epos-zapfausl-grund">@Standtext(g.Normvergleich)</p>
                            }
                            @if (g.HinweisWaermepumpe)
                            {
                                <p class="epos-leisezeile">@Texte.HinweisWaermepumpe</p>
                            }
                            @if (g.ZonenAusserhalb.Count > 0)
                            {
                                <p class="epos-leisezeile">@Format(Texte.ZonenAusserhalb, string.Join(", ", g.ZonenAusserhalb))</p>
                            }
                            <p class="epos-leisezeile epos-zapfausl-rohrnetz" aria-disabled="true" title="@Texte.GrundRohrnetz">@Texte.Rohrnetz — @Texte.GrundRohrnetz</p>
                        </section>
                    </div>

                    @* Der EINE empfohlene Punkt der Gruppe *@
                    <div class="epos-zapfausl-empfehlung" role="status">
                        @if (g.Empfehlung.Rechenbar)
                        {
                            <b>@Format(Texte.Empfehlung, Punkttext(g))</b>
                            if (g.Empfehlung.NenninhaltL is double nenn)
                            {
                                <span> · @Format(Texte.PunktNenninhalt, Zahl(nenn, "N0"))</span>
                            }
                            if (g.Empfehlung.Schnellauslegung)
                            {
                                <span class="epos-zapfausl-marke epos-zapfausl-marke--schnell">@Texte.Schnellauslegung</span>
                            }
                            if (g.Speicher)
                            {
                                <span class="epos-leisezeile epos-zapfausl-entwurf"> @Texte.Entwurfsstand</span>
                            }
                        }
                        else
                        {
                            <span>@Format(Texte.EmpfehlungKeine, g.Empfehlung.Grund)</span>
                        }
                    </div>

                    @* Der Verfahrensvergleich der Speicherauslegung - nachrichtlich *@
                    @if (g.Vergleich is { } v)
                    {
                        <section class="epos-zapfausl-vergleich" aria-label="@Texte.Vergleich">
                            <h4><span class="epos-zapfausl-marke">@Texte.VergleichMarke</span>@Texte.Vergleich · @Texte.Nachrichtlich</h4>
                            <p class="epos-leisezeile">@Texte.VergleichUnter</p>
                            <p class="epos-leisezeile epos-zapfausl-vergleichseingaben">@Vergleichseingaben(v)</p>
                            <div class="epos-raster-huelle">
                                <table class="epos-raster epos-zapfausl-verfahren">
                                    <thead>
                                        <tr>
                                            <th>@Texte.SpalteVerfahren</th>
                                            <th>@Texte.SpalteVolumen</th>
                                            <th>@Texte.SpalteKennwert</th>
                                            <th>@Texte.SpalteRechenweg</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (ZapfprofilVerfahrenDaten z in v.Verfahren)
                                        {
                                            <tr class="@(z.Nachrichtlich ? "epos-zapfausl-nachrichtlich" : z.Groesster ? "epos-zeile--markiert" : null)">
                                                <th scope="row">
                                                    @z.Verfahren
                                                    @if (z.Groesster)
                                                    {
                                                        <span class="epos-zapfausl-marke">@Texte.GroessterWert</span>
                                                    }
                                                    @if (z.Nachrichtlich)
                                                    {
                                                        <span class="epos-zapfausl-marke">@Texte.NurNachrichtlich</span>
                                                    }
                                                </th>
                                                <td class="epos-zahl">@(z.VolumenL is double vol ? Zahl(vol, "N0") + " l" : "–")</td>
                                                <td>@z.Kennwert</td>
                                                <td>@z.Rechenweg</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="epos-zapfausl-kacheln">
                                <div><span>@Texte.KachelGroesster</span> <b>@Groesstertext(v)</b></div>
                                <div><span>@Texte.KachelListe</span> <b>@Listentext(v)</b></div>
                                <div><span>@Texte.KachelKriterium</span> <b>@(v.KennzahlN is double n ? Format(Texte.KriteriumNl, Zahl(n, "N1")) : Texte.KriteriumOhne)</b></div>
                                <div><span>@Texte.KachelFuellstand</span> <b>@Fuellstandtext(v)</b></div>
                            </div>
                            @if (v.Zeitpunkt.Length > 0)
                            {
                                <p class="epos-leisezeile epos-zapfausl-zeitpunkt">@v.Zeitpunkt</p>
                            }
                            @if (!v.ProfilbasiertVorhanden)
                            {
                                <p class="epos-leisezeile epos-zapfausl-dmax">@Texte.DmaxNull</p>
                            }
                            @if (v.WochenModell is not null)
                            {
                                <DiagrammSvg Modell="@v.WochenModell" Kennung="@("zapfausl-woche-" + gruppe)" Bezeichnung="@Texte.Wochenbild" />
                                <p class="epos-leisezeile">@Texte.Wochenbild</p>
                            }
                            <p class="epos-leisezeile">@Texte.PunktBleibt</p>
                            <div class="epos-zapfausl-uebergabe">
                                <button type="button" class="epos-knopf" aria-disabled="true" title="@Texte.GrundUebergeben"
                                        @onclick="UebergabeGesperrt">@Texte.KnopfUebergeben</button>
                            </div>
                        </section>
                    }

                    @* Die Warnliste der Gruppe - nie blockierend *@
                    <section class="epos-zapfausl-warnungen" aria-label="@Texte.Warnliste">
                        <h4>@Texte.Warnliste</h4>
                        <p class="epos-leisezeile">@Texte.WarnlisteUnter</p>
                        @if (g.Warnliste.Count == 0)
                        {
                            <p class="epos-leisezeile">@Texte.WarnlisteLeer</p>
                        }
                        else
                        {
                            <ul class="epos-zapfausl-warnliste">
                                @foreach (ZapfprofilWarnDaten w in g.Warnliste)
                                {
                                    <li data-kennung="@w.Kennung">
                                        <span class="epos-zapfausl-stufe @(w.Stufe == ZapfprofilWarnstufe.Warnung ? "epos-zapfausl-stufe--warnung" : "")">@(w.Stufe == ZapfprofilWarnstufe.Warnung ? Texte.StufeWarnung : Texte.StufeHinweis)</span>
                                        <span><b>@w.Titel:</b> @w.Text</span>
                                    </li>
                                }
                            </ul>
                        }
                        @if (g.Speicher)
                        {
                            if (g.PerzentilErgebnis is { } kz)
                            {
                                if (!kz.KonsistenzGeprueft)
                                {
                                    <p class="epos-leisezeile epos-zapfausl-konsistenz">@Texte.KonsistenzOhneSchwelle</p>
                                }
                                else
                                {
                                    <div class="epos-zapfausl-konsistenz">
                                        <Kohaerenzzeile Text="@Konsistenzsatz(kz)"
                                                        Zustand="@(kz.KonsistenzAuffaellig ? KohaerenzZustand.Abweichend : KohaerenzZustand.Ok)" />
                                    </div>
                                }
                            }
                            else if (EnsembleLaeuft)
                            {
                                <p class="epos-leisezeile epos-zapfausl-konsistenz" role="status">@Texte.KonsistenzLaeuft</p>
                            }
                            else if (_eingabe.Stochastisch)
                            {
                                @* Der Schalter steht schon — kein Rat, ihn einzuschalten; das Perzentil fehlt aus seinem Grund (Karte (b)). *@
                                <p class="epos-leisezeile epos-zapfausl-konsistenz">@Texte.KonsistenzOhnePerzentil</p>
                            }
                            else
                            {
                                <p class="epos-leisezeile epos-zapfausl-konsistenz" aria-disabled="true" title="@Texte.GrundKonsistenz">@Texte.Konsistenz — @Texte.GrundKonsistenz</p>
                            }
                        }
                    </section>
                </KindInhalt>
            </Gruppenkopf>
        }
    }

    @* Die Karte „Herkunft" (Herkunftsprotokoll des Kerns, N19): je Wert der Auslegung eine Zeile
       in der Reihenfolge des Rechenwegs - eingeklappt unter den Gruppen. Die Ueberlagerung fuehrt
       keine eigene Stufe, deshalb entscheidet die Huelle, ob die Karte steht
       (ZapfprofilAuslegungDaten.HerkunftSichtbar: ab Erweitert ja). Leer heisst benannt "nichts zu
       vermerken". *@
    @if (_ergebnis is { Zustand: ZapfprofilAuslegungZustand.Gerechnet, HerkunftSichtbar: true } herkunft)
    {
        <details class="epos-zapfprofil-herkunft epos-zapfausl-herkunft">
            <summary>@Texte.GruppeHerkunft</summary>
            <p class="epos-leisezeile">@Texte.HerkunftUnter</p>
            @if (herkunft.Herkunft.Count == 0)
            {
                <p class="epos-leisezeile epos-zapfprofil-herkunft-leer">@Texte.HerkunftLeer</p>
            }
            else
            {
                <table class="epos-raster epos-zapfprofil-herkunftliste">
                    <thead>
                        <tr>
                            <th scope="col">@Texte.HerkunftSpalteGroesse</th>
                            <th scope="col">@Texte.HerkunftSpalteWert</th>
                            <th scope="col">@Texte.HerkunftSpalteZone</th>
                            <th scope="col">@Texte.HerkunftSpalteStand</th>
                            <th scope="col">@Texte.HerkunftSpalteQuelle</th>
                            <th scope="col">@Texte.HerkunftSpalteVermerk</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ZapfprofilHerkunftZeile h in herkunft.Herkunft)
                        {
                            <tr class="epos-zapfprofil-herkunftzeile" data-groesse="@h.Groesse">
                                <th scope="row">@h.Groesse</th>
                                <td class="epos-zahl">@h.Wert</td>
                                <td>@h.Zone</td>
                                <td>@h.Stand</td>
                                <td>@h.Quelle</td>
                                <td>@h.Vermerk</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </details>
    }

    @foreach (ZapfprofilMeldung m in _ergebnis?.Meldungen ?? new List<ZapfprofilMeldung>())
    {
        if (m.Art == ZapfprofilMeldungsart.Hinweis)
        {
            <p class="epos-leisezeile epos-zapfausl-meldung" data-kennung="@m.Kennung">@m.Text</p>
        }
        else
        {
            <Warnbanner Stufe="WarnStufe.Warnung" Text="@m.Text" Kennung="@m.Kennung" />
        }
    }

    <SpeichernLeiste @ref="_leiste" OkText="@OkText" AbbrechenText="@AbbrechenText" Ergebnis="BeiErgebnis" />

    @* ---------------- Unterueberlagerung: der Konstruktor (A100, NA.5.2.3) ---------- *@
    <Ueberlagerung Offen="@_konstruktorOffen" Titel="@Texte.KonstruktorTitel" Zusatzklasse="epos-ueberlagerung--breit"
                   Geschlossen="() => _konstruktorOffen = false">
        <KindInhalt>
            @if (_konstruktorOffen)
            {
                <BedarfstagKonstruktor Texte="@Texte" Regeln="@Daten.Regeln" RegelnGrund="@Daten.RegelnGrund"
                                       Name="@KonstruktorName" Startzeilen="@_eingabe.Konstruktorzeilen"
                                       Bezugsarten="@Daten.Bezugsarten" Bezugsart="@KonstruktorBezugsart"
                                       Bezugsmenge="@KonstruktorBezugsmenge"
                                       BezugHinweis="@(_eingabe.Entwurf is null && _eingabe.Quelle == ZapfprofilBedarfstagquelle.Konstruktor ? _eingabe.KonstruktorBezugHinweis : "")"
                                       Konstruieren="@Konstruieren"
                                       OkText="@OkText" AbbrechenText="@AbbrechenText"
                                       TitelAnzeigen="false" Geschlossen="KonstruktorFertig" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Rueckfrage Offen="@_rueckfrage" TitelText="@Texte.RueckfrageTitel" Frage="@Texte.RueckfrageStundenprofil"
                Beantwortet="RueckfrageBeantwortet" JaText="@Texte.Ja" NeinText="@Texte.Nein" />
</div>

@code {
    /// <summary>Die Auswahl „Vorgaberegel".</summary>
    private const int WAHL_VORGABE = 0;

    /// <summary>Die Auswahl „Stundenprofil".</summary>
    private const int WAHL_STUNDENPROFIL = -1;

    /// <summary>Die Auswahl „A100-Referenzprofil" — benannt gesperrt, solange der Katalog keine Zeile dieser Art trägt.</summary>
    private const int WAHL_A100 = -2;

    /// <summary>Die Auswahl „Ecodesign-Zapfprofil" — benannt gesperrt, solange der Katalog keine Zeile dieser Art trägt.</summary>
    private const int WAHL_ECODESIGN = -5;

    /// <summary>Die Auswahl „DIN-4708-Profil".</summary>
    private const int WAHL_DIN4708 = -3;

    /// <summary>Die Auswahl „konstruierter Entwurf".</summary>
    private const int WAHL_ENTWURF = -4;

    /// <summary>Die Einträge der Umschalter auto/manuell (Verfahrensvergleich, Z4).</summary>
    private const int AUTO = 0;
    private const int MANUELL = 1;

    // --- Parameter (Schluessel wie ZapfprofilHuelle.AuslegungGaben) --------------------

    /// <summary>Der Stand beim Öffnen: Eingaben, Bedarfstage, Regeln, erstes Ergebnis.</summary>
    [Parameter] public ZapfprofilAuslegungStartDaten Daten { get; set; } = new();

    /// <summary>Die Beschriftungen (Textbündel).</summary>
    [Parameter] public ZapfprofilAuslegungTexte Texte { get; set; } = new();

    /// <summary>
    /// Die Auslegung zu den Eingaben — der Delegat der Hülle, im Zeichenlauf und darum stets
    /// deterministisch (der Dialog reicht die Eingaben ohne „Stochastisch rechnen"). Kein Delegat =
    /// das Ergebnis bleibt beim Öffnen.
    /// </summary>
    [Parameter] public Func<ZapfprofilAuslegungEingabeDaten, ZapfprofilAuslegungDaten>? Rechnen { get; set; }

    /// <summary>
    /// Die Auslegung MIT dem Ensemble des Bedarfstags (4.5 b) — der Delegat der Hülle, der den Lauf
    /// auf einen Arbeitsfaden legt und die Abbruchmarke an den Kern reicht (5.1). Kein Delegat =
    /// „Stochastisch rechnen" zieht kein Ensemble, das Perzentil bleibt offen.
    /// </summary>
    [Parameter] public Func<ZapfprofilAuslegungEingabeDaten, CancellationToken, Task<ZapfprofilAuslegungDaten>>? StochastischRechnen { get; set; }

    /// <summary>
    /// Der Konstruktor der Hülle — Zeilen, Name, Bezugsmenge und Bezugsart (beide leer = ohne
    /// Bezug); kein Delegat = kein Knopf „Bedarfstag konstruieren…".
    /// </summary>
    [Parameter] public Func<IReadOnlyList<ZapfprofilKonstruktorZeileDaten>, string, double?, int?, ZapfprofilKonstruktorErgebnis>? Konstruieren { get; set; }

    /// <summary>Hilfeschlüssel der Bedienung.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_Zapfprofil.btn_Help";

    /// <summary>Hilfeschlüssel des Rechenwegs der Auslegung.</summary>
    [Parameter] public string HilfeRechenweg { get; set; } = "Form_Zapfprofil.grp_Auslegung";

    /// <summary>Eigener Titel samt Kreuz; eingebettet setzt der Wirt <c>false</c>.</summary>
    [Parameter] public bool TitelAnzeigen { get; set; } = true;

    /// <summary>Wartezeit der Neuberechnung nach der letzten Eingabe [ms]; 0 = sofort (bunit).</summary>
    [Parameter] public int EntprellungMs { get; set; } = 400;

    [Parameter] public string OkText { get; set; } = Resource.ALLG_BTN_OK;
    [Parameter] public string AbbrechenText { get; set; } = Resource.ALLG_BTN_ABBRECHEN;

    /// <summary>Das Ergebnis: die Eingaben samt Punkt bei OK, <c>null</c> bei Abbruch.</summary>
    [Parameter] public EventCallback<ZapfprofilAuslegungEingabeDaten?> Geschlossen { get; set; }

    // --- Stand -----------------------------------------------------------------------

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;
    private SpeichernLeiste? _leiste;
    private string _statusGezeigt = "\u0001";

    private ZapfprofilAuslegungEingabeDaten _eingabe = new();
    private ZapfprofilAuslegungDaten? _ergebnis;
    private bool _aktuell;
    private bool _konstruktorOffen;
    private bool _rueckfrage;
    private string _hinweis = "";
    private CancellationTokenSource? _entprellung;

    /// <summary>Die Abbruchmarke des laufenden Ensembles; <c>null</c>, solange keines läuft.</summary>
    private CancellationTokenSource? _lauf;

    /// <summary>Die Felder, deren Text gerade keine gültige Zahl ist (Feldname) — sie halten das OK an.</summary>
    private readonly SortedSet<string> _fehlfelder = new(StringComparer.Ordinal);

    /// <summary>Die Eingaben — Prüfhilfe für die Tests.</summary>
    public ZapfprofilAuslegungEingabeDaten Eingabe => _eingabe;

    /// <summary>Läuft das Ensemble des Bedarfstags gerade? Prüfhilfe für die Tests.</summary>
    public bool EnsembleLaeuft => _lauf is not null;

    /// <summary>Das angezeigte Ergebnis — Prüfhilfe für die Tests.</summary>
    public ZapfprofilAuslegungDaten? AktuellesErgebnis => _ergebnis;

    /// <summary>Die leise Zeile nach einem gesperrten Versuch — Prüfhilfe für die Tests.</summary>
    public string Hinweis => _hinweis;

    /// <summary>Steht der Konstruktor? Prüfhilfe für die Tests.</summary>
    public bool KonstruktorOffen => _konstruktorOffen;

    /// <summary>Steht die Rückfrage? Prüfhilfe für die Tests.</summary>
    public bool RueckfrageOffen => _rueckfrage;

    protected override void OnInitialized()
    {
        _eingabe = (Daten.Eingabe ?? new ZapfprofilAuslegungEingabeDaten()).Kopie();
        _ergebnis = Daten.Ergebnis;
        _aktuell = _ergebnis is not null;
        _konstruktorOffen = KonstruktorFaellig(null, _ergebnis);
        // „Stochastisch rechnen" des Zapfprofils: Der Schalter kommt mit den Eingaben, und ohne
        // Ergebnis rechnet genau EIN Lauf — gleich nebenläufig mit Ensemble, kein
        // deterministischer Vorlauf. Sein erstes Ergebnis darf den Konstruktor öffnen (4.5).
        if (_ergebnis is null && _eingabe.Stochastisch) Neurechnen(konstruktorFolgen: true);

        // Welle #458, Stufe 3a: die Ueberlagerung als EIGENE Maske - solange sie offen
        // steht; ihr Dispose meldet sie ab.
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.ZAPFPROFIL_AUSLEGUNG, () => KiSicht(), KiHaken());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        StatusNachziehen();
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        // Steht der Konstruktor schon beim Öffnen, behält seine Überlagerung den Fokus.
        if (!_konstruktorOffen) await _wurzel.FocusAsync();
    }

    /// <inheritdoc/>
    public void Dispose()
    {
        _kiMaske?.Dispose();
        EntprellungAbbrechen();
        LaufVerwerfen();
    }

    // =================================================================================
    // Anzeige
    // =================================================================================

    private IReadOnlyList<(int Id, string Text)> Bedarfstagwahl
    {
        get
        {
            var liste = new List<(int Id, string Text)>
            {
                (WAHL_VORGABE, Texte.OptionVorgaberegel),
                (WAHL_STUNDENPROFIL, Texte.OptionStundenprofil)
            };
            if (A100Gesperrt) liste.Add((WAHL_A100, Texte.OptionA100));
            liste.Add((WAHL_DIN4708, Texte.OptionDin4708));
            if (_eingabe.Entwurf is { } entwurf)
                liste.Add((WAHL_ENTWURF, Format(Texte.OptionEntwurf, entwurf.Bezeichner)));
            if (EcodesignGesperrt) liste.Add((WAHL_ECODESIGN, Texte.OptionEcodesign));
            foreach (ZapfprofilBedarfstagDaten t in Daten.Bedarfstage)
                liste.Add((t.Id, Format(Texte.OptionKatalogtag, t.Bezeichner, t.Herkunft)));
            // Ein gespeicherter Tag, den der Katalog nicht (mehr) führt, bleibt als Eintrag stehen.
            if (_eingabe.IdBedarfstag is int id && id > 0 && liste.All(e => e.Id != id))
                liste.Add((id, "#" + id.ToString(CultureInfo.InvariantCulture)));
            return liste;
        }
    }

    /// <summary>Die Quelle A100-Referenzprofil steht gesperrt, solange der Katalog keine Zeile dieser Art führt.</summary>
    private bool A100Gesperrt => Daten.Bedarfstage.All(t => t.Quelle != ZapfprofilBedarfstagquelle.A100Referenz);

