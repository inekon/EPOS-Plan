    /// dieser Ansicht beim Hilfe-Assistenten an und liest die Kaskade aus GENAU DEM
    /// Stand, den der Anwender vor sich hat — nicht aus einem zweiten Ladevorgang, der
    /// etwas anderes zeigen könnte.
    /// </remarks>
    public SimulationKonfigDaten Stand => _daten;

    /// <summary>
