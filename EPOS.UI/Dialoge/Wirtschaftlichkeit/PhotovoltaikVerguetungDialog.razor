    private async Task MarktwerteKlick()
    {
        _hinweis = ""; _fehler = "";
        if (MarktwerteImportieren is null) return;

        MarktwertImport? ergebnis = await MarktwerteImportieren();
        if (ergebnis is null) return;   // Dateiauswahl abgebrochen

        if (ergebnis.Ok) _hinweis = _t.ImportOk + ergebnis.Bericht;
        else _fehler = _t.ImportFehler + ergebnis.Bericht;
    }

    /// <summary>
    /// ETAPPE E2 (ANWENDERENTSCHEID Q12 der Mockup-Prüfung) — der Sprung in den
    /// Tarifdialog nimmt den <b>OK-Weg</b>: Er prüft, schreibt und springt, genau wie
    /// der Sprungknopf des BHKW-Dialogs.
    ///
    /// <para>Bis hierher sprang er wie „Abbrechen": Der Dialog schloss, die Eingaben
    /// waren weg, und die Zeile darunter kündigte das an. Das ist die Bauart, die
    /// <c>EPOS.UI/CLAUDE.md</c> ausschließt — stillschweigend verlorene Eingaben gibt
    /// es nicht; ein Knopf, der den Dialog auf einem anderen Weg verlässt, nimmt
    /// entweder den OK-Weg oder verwirft ausdrücklich.</para>
    ///
    /// <para><b>Nur bei Änderung</b>, aus demselben Grund wie im BHKW-Dialog: Wer nur
    /// nachschlagen will, soll keinen Schreibzugriff auslösen; ein Schreiben ohne
    /// Änderung überschriebe in einer Mehrbenutzerlage fremde Änderungen mit dem
    /// eigenen geladenen Stand. Gemessen wird am WERT des ganzen Modells
    /// (<see cref="Abzug"/>), nicht an einem Merkflag — ein Flag kippt schon bei einem
    /// Fokuswechsel, und ein Feld, das jemand vergisst mitzuzählen, gäbe es hier
    /// nicht.</para>
    ///
    /// <para>Scheitert die Prüfung oder das Schreiben, findet der Sprung NICHT statt
    /// und der Dialog bleibt mit seinem Grund offen.</para>
    /// </summary>
    private async Task TarifKlick()
    {
        _fehler = "";

        if (Abzug() != _abzugBeimLaden)
        {
            // Dieselbe Pflichtprüfung wie am OK-Knopf — die Regel steht genau einmal.
            if (Modell.Aktiv && Modell.Inbetriebnahme == DateTime.MinValue)
            {
                _fehler = _t.IbnPflicht;
                return;
            }

            if (Speichern is null || !Speichern())
            {
                _fehler = _t.MsgSpeicherfehler;
                return;
            }

            _gespeichert = true;
            _abzugBeimLaden = Abzug();
        }

        await Schliessen(PvSprung.Tarif);
    }

    /// <summary>
    /// Der Wertabzug des gepflegten Modells — die Grundlage der Änderungsprüfung des
    /// Sprungknopfs. Er entsteht über die Feldliste des Modells selbst; eine von Hand
    /// gepflegte Liste der „wichtigen" Felder wäre die Stelle, an der ein neues Feld
    /// vergessen wird.
    /// </summary>
    private string Abzug()
        => System.Text.Json.JsonSerializer.Serialize(Modell);

    /// <summary>
    /// „Eigene Werte" (Konzept § 2.16, VV‑Q6): Die Hülle kopiert die Stammwerte in die
    /// Zeile dieses Stands; danach schließt der Dialog, damit der Aufrufer ihn mit den
    /// nun EIGENEN Werten neu öffnet. Ohne das Schließen stünden die alten Gaben noch
    /// im Speicher, und „Übernehmen" schriebe sie zurück.
    /// </summary>
    private async Task EigeneWerteKlick()
    {
        await EigeneWerte.InvokeAsync();
        await Schliessen(PvSprung.Keiner);
    }

    private async Task BeiErgebnis(bool ok)
    {
        if (!ok) { await Schliessen(PvSprung.Keiner); return; }

        _fehler = "";

        // Pflichtangabe Inbetriebnahme. In WinForms war das eine tote Pruefung -
        // ein DateTimePicker kann nicht leer sein; ein Datumsfeld schon.
        if (Modell.Aktiv && Modell.Inbetriebnahme == DateTime.MinValue)
        {
            _fehler = _t.IbnPflicht;
            return;
        }

        if (Speichern is null || !Speichern())
        {
            _fehler = _t.MsgSpeicherfehler;
            return;
        }

        _gespeichert = true;
        await Schliessen(PvSprung.Keiner);
    }

    private Task Schliessen(PvSprung sprung) =>
        Geschlossen.InvokeAsync(new PvVerguetungErgebnis(_gespeichert, sprung));

    /// <summary>Esc schließt. ETAPPE E9b: Steht ein Szenariopaar obenauf, gehört die Geste ihm.</summary>
    private Task BeiTaste(KeyboardEventArgs e) =>
        e.Key == "Escape" && !SzenarioOffen ? Schliessen(PvSprung.Keiner) : Task.CompletedTask;
    // =============================================================================
    // Der Hilfe-Assistent (Welle KI-F4)
    // =============================================================================

    private KiMaskenanmeldung? _kiMaske;
    private PhotovoltaikVerguetungKiSicht? _kiSicht;

    /// <summary>
    /// Die Sicht des Assistenten: das Vergütungsmodell des Projekts, gesetzt über die
    /// Wege der Maske.
    /// </summary>
    /// <remarks>
    /// Leistung, Inbetriebnahme, Degradation, Einspeiseart und Vermarktungsform
    /// laufen über eigene Wege, die die ZULÄSSIGKEIT neu prüfen und eine 0 als „nicht
    /// gepflegt" führen. An ihnen vorbei zu schreiben zeigte eine Leistung von 0
    /// statt „keine" und die Warnungen von vorhin.
    /// </remarks>
    private PhotovoltaikVerguetungKiSicht KiSicht()
    {
        return _kiSicht ??= new PhotovoltaikVerguetungKiSicht
        {
            ModellLesen = () => Modell,

            LeistungSetzen = LeistungGeaendert,
            DegradationSetzen = DegradationGeaendert,
            IbnSetzen = wert => IbnGeaendert(KiTag(wert)),
            EinspeiseartSetzen = wert => EinspeiseartGewaehlt(
                string.Equals(wert, DbWerte.PV_EINSPEISEART_VOLL, StringComparison.Ordinal) ? 1 : 0),
            VermarktungSetzen = KiVermarktung,

            EinspeiseartEintraege = () => KiMaskenanmeldung.Eintraege(new[]
            {
                new KiWahleintrag(DbWerte.PV_EINSPEISEART_UEBERSCHUSS, _t.Ueberschuss),
                new KiWahleintrag(DbWerte.PV_EINSPEISEART_VOLL, _t.Voll)
            }, z => z.Schluessel, z => z.Text),

            VermarktungEintraege = () => KiMaskenanmeldung.Eintraege(new[]
            {
                new KiWahleintrag(DbWerte.PV_VERMARKTUNG_EV, _t.Ev),
                new KiWahleintrag(DbWerte.PV_VERMARKTUNG_MARKTPRAEMIE, _t.Marktpraemie),
                new KiWahleintrag(DbWerte.PV_VERMARKTUNG_SONSTIGE_DV, _t.Ppa),
                new KiWahleintrag(DbWerte.PV_VERMARKTUNG_KEINE, _t.Keine)
            }, z => z.Schluessel, z => z.Text),

            SchalterEintraege = () => KiMaskenanmeldung.Eintraege(
                _schalter, z => z.Wert, z => z.Text),

            Nachziehen = () => _ = InvokeAsync(StateHasChanged)
        };
    }

    /// <summary>Ein ISO-Datum als <c>DateOnly</c>; leer bleibt leer.</summary>
    private static DateOnly? KiTag(string? wert)
    {
        if (string.IsNullOrWhiteSpace(wert)) return null;
        return DateOnly.TryParse(wert, CultureInfo.InvariantCulture, out DateOnly d)
            || DateOnly.TryParse(wert, CultureInfo.CurrentCulture, out d) ? d : null;
    }

    /// <summary>Die Vermarktungsform über ihren Steuerwert setzen.</summary>
    private void KiVermarktung(string wert)
    {
        int nummer = wert switch
        {
            _ when string.Equals(wert, DbWerte.PV_VERMARKTUNG_MARKTPRAEMIE, StringComparison.Ordinal) => 1,
            _ when string.Equals(wert, DbWerte.PV_VERMARKTUNG_SONSTIGE_DV, StringComparison.Ordinal) => 2,
            _ when string.Equals(wert, DbWerte.PV_VERMARKTUNG_KEINE, StringComparison.Ordinal) => 3,
            _ => 0
        };
        VermarktungGewaehlt(nummer);
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf (Stufe S3).
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg — mit Absicht.</b> „Übernehmen" schreibt das Vergütungsmodell
    /// in die Datenbank und schließt den Dialog; Schreiben und Schließen sind EIN Knopf,
    /// wie bei den Überlagerungen mit eigenem Arbeitsstand (Konzept Dialogintegration,
    /// Abschnitt 4). Der Assistent füllt die Felder, „Übernehmen" klickt der Anwender;
    /// <c>dialog_speichern</c> lehnt hier benannt ab (<c>KI_AKTION_SPEICHERN_KEIN_WEG</c>).
    /// KI‑D‑Q4 erlaubt das Speichern über den Speicherweg einer Maske — diese hat keinen.
    /// Der Marktwertimport ist ein LADEVORGANG und gehört ins Aktionsregister.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    /// <inheritdoc/>
    public void Dispose() => _kiMaske?.Dispose();
}
