    private static string Zahl(double? wert, string format, string einheit)
        => wert.HasValue ? (wert.Value.ToString(format, CultureInfo.CurrentCulture) + " " + einheit).Trim() : "";

    /// <summary>Ein Lesewert: der gepflegte Wert, sonst die Vorgabe.</summary>
    private string Lesewert(double? wert, double? vorgabe, string format, string einheit)
        => wert.HasValue ? Zahl(wert, format, einheit)
         : vorgabe.HasValue ? VorgabeZahl(vorgabe.Value, format, einheit)
         : "–";

