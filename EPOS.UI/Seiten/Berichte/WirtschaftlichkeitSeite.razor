@* Die SEITE "Wirtschaftlichkeit" des Reiters "Berichte & Kosten"
   (iU9-W5.3).

   Vorbild: Views/Wirtschaftlichkeit/UcWirtschaftlichkeit.cs (831 Z.) und
   .Designer.cs (11 Kartenzeilen) - Konzept_Wirtschaftlichkeit.md, Kap. 6
   (Kapitalwertmethode DIN EN 17463).

   AUFBAU. Vier Kennzahl-Karten (KD6a), darunter die Vergleichsgruppe mit
   Haken und die Szenariowahl, dann der Parameternachweis (L12/L13) und die
   Vergleichstabelle. Die Fussleiste traegt die Sichten und "Berechnen".

   DIE FUENF UNTERDIALOGE STEHEN IN EINER UEBERLAGERUNG - nicht in einem
   zweiten Fenster. Bis Welle 4 oeffnete diese Maske sie ueber vier
   WinForms-Huellen (TarifstrukturHuelle, PhotovoltaikVerguetungHuelle,
   WirtschaftlichkeitParameterHuelle, KapitalwertVerlaufHuelle,
   BhkwWirtschaftlichkeitHuelle), also je ein eigenes Fenster mit eigener
   WebView. Seit die Seite selbst Blazor ist, waere das eine zweite WebView
   ueber der ersten (Risiko R2); der Baustein Ueberlagerung loest das im
   selben Fenster (W4-O3 erledigt).

   DIE TABELLE IST EINE MATRIX, KEIN RASTER. Ihre Spalten entstehen zur
   Laufzeit - eine je Version der Gruppe -, und ein QuickGrid braucht
   Spalten, die zur Uebersetzungszeit feststehen. Begruendung in
   ErgebnisMatrix.

   DER SAMMEL-EINSTIEG "Tarifstruktur..." BLEIBT WEG (Ä16): Die
   Tarifstruktur wird komponentenbezogen gepflegt - "BHKW-Wirtschaftlichkeit"
   fuer die Differenzmethode, "Strombezug" fuer die Einkaufsseite, der
   PV-Anteil im PV-Vergueungsdialog. Der Vorlaeufer trug den Knopf noch im
   Designer und setzte ihn unsichtbar; hier gibt es ihn gar nicht mehr. *@

@namespace EPOS.UI.Seiten.Berichte
@using EPOS.UI.Dialoge.Wirtschaftlichkeit

<div class="epos-seite" tabindex="-1" @ref="_wurzel">

    @* KEIN EIGENER KOPF (08.09.2026): Titel und Hilfeknopf traegt der Rahmen
       BerichteKostenSeite - hier standen beide ein zweites Mal. *@

    @if (!string.IsNullOrEmpty(_fehler))
    {
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@_fehler" />
    }

    @* ------------------------------------------- Warnband (Auftrag #267)

       NIE EIN STUMMES "—". Anwenderbefund 14.09.2026: "die Energiekosten sind
       0 auch nach berechnung. Kosten sind angegeben." Der Grund stand da - als
       letzte Zeile "Hinweis" GANZ UNTEN in einer Tabelle mit zwanzig
       Kennzahlzeilen. Gelesen wurde er nicht; gelesen wurde "—".

       Der Grund kommt aus dem KERN (WirtschaftlichkeitErgebnis.Fehlgrund /
       .Hinweis, seit #267 mit Ausweg im Text), die Seite zeigt ihn nur - ganz
       oben, vor den Kacheln, deren "—" er erklaert. Die Tabellenzeile bleibt,
       wo sie ist: Sie sagt, WELCHE Spalte betroffen ist.

       DER RECHENWEG STEHT DANEBEN. Zweiter Befund derselben Abnahme: Die
       Fusszeile verlangte "bitte neu berechnen", und der Knopf "Berechnen" lag
       unterhalb der langen Tabelle ausser Sicht. Ein Weg, den man nicht findet,
       ist keiner - deshalb derselbe Aufruf hier oben, wo die Meldung steht.
       Gerechnet wird weiterhin NUR auf Zuruf (Vorbild UcWirtschaftlichkeit:
       btn_Berechnen); eine Rechnung beim Oeffnen wuerde jeden Seitenwechsel zu
       einem Simulationslauf machen. *@
    @if (_warnungen.Count > 0 || _nachrechnen)
    {
        <div class="epos-wirt-warnband">
            @if (_nachrechnen)
            {
                <Warnbanner Stufe="WarnStufe.Warnung" Text="@NachrechnenText" />
            }
            @foreach (string w in _warnungen)
            {
                <Warnbanner Stufe="WarnStufe.Warnung" Text="@w" />
            }
            @if (Berechnen is not null)
            {
                <div class="epos-leiste">
                    <button type="button" class="epos-knopf epos-knopf--primaer" disabled="@_laeuft"
                            @onclick="BerechnenLaufen">@NeuBerechnenText</button>
                </div>
            }
        </div>
    }

    @* ------------------------------------------------- Kennzahl-Karten *@
    <Kachelraster Mindestbreite="240">
        <KindInhalt>
            @foreach (KachelZeile k in _stand.Ansicht.Kacheln)
            {
                <Kennzahlkachel Titel="@k.Titel" Wert="@k.Wert" Quelle="@k.Quelle" />
            }
        </KindInhalt>
    </Kachelraster>

    @* ------------------------------------------------ Vergleichsgruppe *@
    <p class="epos-untergruppe">@LabelVarianten</p>

    <Raster TZeile="VarianteZeile" Zeilen="@_stand.Varianten.AsQueryable()" Bearbeitbar="true">
        <KindInhalt>
            <TemplateColumn TGridItem="VarianteZeile" Title="">
                <Schalter Bezeichnung="" Wert="@Gewaehlt(context.IdProjekt)"
                          Aktiv="@(!context.IstStamm && !_laeuft)"
                          WertChanged="@(w => VarianteUmschalten(context, w))" />
            </TemplateColumn>
            <PropertyColumn TGridItem="VarianteZeile" TProp="string"
                            Property="@(z => z.Art)" Title="@SpalteArt" />
            <PropertyColumn TGridItem="VarianteZeile" TProp="string"
                            Property="@(z => z.Bezeichner)" Title="@SpalteBezeichner" />
            <PropertyColumn TGridItem="VarianteZeile" TProp="string"
                            Property="@(z => z.Projektname)" Title="@SpalteProjektname" />
            @* VF-1: Womit rechnet DIESE Version ihren Stromspeicher? Die Spalte steht
               neben dem Projektnamen, weil sie zur Version gehoert und nicht zum
               Ergebnis - Stamm und Varianten duerfen verschiedene Flotten fuehren. *@
            <PropertyColumn TGridItem="VarianteZeile" TProp="string"
                            Property="@(z => z.Speicher)" Title="@SpalteSpeicher" />
            <TemplateColumn TGridItem="VarianteZeile" Title="@SpalteSimulation">
                <span class="@(context.Auffaellig ? "epos-veraltet" : "")">@context.SimStand</span>
            </TemplateColumn>
        </KindInhalt>
    </Raster>

    @* AUFTRAG #325 (Anwenderwunsch 17.09.2026): "button parameter nach oben …
       auf Ebene Szenario". Der Einstieg in die Wirtschaftlichkeits-Parameter
       stand bis hierher in der Fussleiste UNTER der langen Vergleichstabelle und
       war auf dem Bildschirm des Anwenders nicht zu sehen - derselbe Befund, den
       schon der Rechenknopf des Warnbandes hatte (#267). Er steht jetzt dort, wo
       die Groessen gewaehlt werden, mit denen er rechnet.

       KEINE EIGENE STILREGEL. Die Zeile ist eine .epos-seite-zeile, und die
       richtet ihre Kinder an der UNTERKANTE aus (align-items: flex-end): Das
       beschriftete Auswahlfeld und der unbeschriftete Knopf sitzen damit auf einer
       Grundlinie, nicht versetzt. Dieselbe Bauform traegt die Variantenzeile der
       Simulationsseite (Auswahlfeld + Knoepfe in einer Zeile). *@
    <div class="epos-seite-zeile">
        <Auswahlfeld Bezeichnung="@LabelSzenario" Eintraege="@_stand.Szenarien"
                     Auswahl="@_stand.SzenarioId" Aktiv="@(!_laeuft)"
                     AuswahlChanged="BeiSzenario" />
        @if (Gaben is not null)
        {
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="() => Oeffne(Unterdialog.Parameter)">@ParameterText</button>
        }
    </div>

    @* W5-B-9: Erst der Satz DIESES Szenarios, dann der Projekt-Parameternachweis.
       Eine leere Szenariozeile wird gar nicht erst gezeichnet - eine leere
       Herleitungszeile ist kein Hinweis, sondern eine Luecke. *@
    @if (!string.IsNullOrEmpty(_stand.Ansicht.Szenariozeile))
    {
        <Herleitungszeile Text="@_stand.Ansicht.Szenariozeile" />
    }
    <Herleitungszeile Text="@_stand.Parameterzeile" />

    @* W5-B-11 (VALERI G7 / G10 / G1,G3,G5): Der Nachweisblock sagt zusaetzlich,
       wie der Betrachtungszeitraum zu den Nutzungsdauern steht, woher
       Eigenverbrauchsquote und Einspeiseanteil kommen und welche Vereinfachungen
       gelten. Leere Zeilen werden - wie die Szenariozeile - nicht gezeichnet. *@
    @if (!string.IsNullOrEmpty(_stand.Zeitraumzeile))
    {
        <Herleitungszeile Text="@_stand.Zeitraumzeile" />
    }
    @if (!string.IsNullOrEmpty(_stand.Vereinfachungszeile))
    {
        <Herleitungszeile Text="@_stand.Vereinfachungszeile" />
    }

    @* W5-B-12 (VALERI G6): die nicht monetaeren Wirkungen - was sich nicht in
       Euro fassen laesst, steht neben der Zahl (DIN EN 17463). Gepflegt wird der
       Text im Parameterdialog; ohne ihn entfaellt die Zeile wie jede andere im
       Nachweisblock. *@
    @if (!string.IsNullOrEmpty(_stand.Wirkungszeile))
    {
        <Herleitungszeile Text="@_stand.Wirkungszeile" />
    }

    @* --------------------------------------------- Vergleichstabelle *@
    @if (_stand.Ansicht.Matrix.Zeilen.Count > 0)
    {
        <div class="epos-raster-huelle">
            <table class="epos-raster epos-matrix">
                <thead>
                    <tr>
                        @foreach (string kopf in _stand.Ansicht.Matrix.Spalten)
                        {
                            <th scope="col">@kopf</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (MatrixZeile z in _stand.Ansicht.Matrix.Zeilen)
                    {
                        <tr>
                            <th scope="row" class="epos-matrix-titel">@z.Titel</th>
                            @foreach (string zelle in z.Zellen)
                            {
                                <td class="epos-matrix-zelle">@zelle</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @* W5-B-11 (VALERI G9): der Vorschlag zur Entscheidung - unmittelbar unter der
       Vergleichstabelle, aus der er sich ergibt. Ohne Variante mit Erwartet-Ergebnis
       bleibt der Text leer, und die Zeile entfaellt ganz. *@
    @if (!string.IsNullOrEmpty(_stand.Ansicht.Empfehlungszeile))
    {
        <Herleitungszeile Text="@_stand.Ansicht.Empfehlungszeile" />
    }

    @* ------------------------------------ Bewertung nach DIN EN 17463 (#325) *@
    @* AUFTRAG #325 (Anwenderentscheid 17.09.2026): "heraus nehmen aus Parameter
       Dialog: 1. Bewertung nach DIN EN 17463". Der Text steht jetzt DA, WO AUCH
       DER KAPITALWERT STEHT - die Norm will beides nebeneinander; in einem
       Unterdialog stand er neben Rechengroessen, die ihn nichts angehen.

       AUFKLAPPBAR ueber den Hausknopf .epos-modulparameter-knopf (W6-E-1, dieselbe
       Form fuer denselben Zweck): Der Offen-Zustand gehoert der Seite und ueberlebt
       jeden Auffrischlauf; aria-expanded sagt ihn an. Keine neue Stilregel.

       DIESELBE WAHRHEIT, andere Eingabestelle: Es ist unveraendert
       WirtschaftlichkeitParameter.NichtMonetaer. Die Zeile im Nachweisblock oben
       (Wirkungszeile) bleibt der AUSWEIS - sie zeigt denselben Wert fertig
       formuliert und entfaellt, solange nichts erfasst ist.

       EINE SEITE HAT KEIN OK. Geschrieben wird deshalb auf Zuruf ueber den Knopf
       daneben - nicht bei jedem Tastendruck (das Textfeld meldet jede Eingabe) und
       nicht still beim Verlassen der Seite. Danach frischt die Seite auf, damit der
       Ausweis oben dem folgt, was gerade geschrieben wurde. *@
    @if (WirkungSpeichern is not null)
    {
        <button type="button" class="epos-modulparameter-knopf"
                aria-expanded="@(_bewertungOffen ? "true" : "false")"
                @onclick="BewertungUmschalten">
            <span class="epos-modulparameter-pfeil" aria-hidden="true">@(_bewertungOffen ? "▾" : "▸")</span>
            <span>@BewertungTitel</span>
        </button>

        @if (_bewertungOffen)
        {
            <Formularraster>
                <KindInhalt>
                    <Textfeld Bezeichnung="@NichtMonetaerText" Mehrzeilig="true" Zeilen="5"
                              Platzhalter="@NichtMonetaerPlatz" NurLesen="@_laeuft"
                              Wert="@_nichtMonetaer"
                              WertChanged="@(w => _nichtMonetaer = w)" />
                </KindInhalt>
            </Formularraster>
            <Herleitungszeile Text="@NichtMonetaerHinweis" />
            @* KEIN .epos-leiste um diesen einen Knopf: Die Fussleiste der Seite ist
               genau eine, und eine zweite Leiste unmittelbar im Seitenwirt waere
               keine Leiste mehr, sondern eine zweite Fussleiste mitten im Text.
               Ein einzelner Knopf steht ohne Wirt - wie "Vorgaben" im
               Parameterdialog. *@
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="WirkungSchreiben">@BewertungSpeichernText</button>
        }
    }

    @if (_laeuft)
    {
        <div class="epos-fortschritt">
            <progress class="epos-fortschritt-balken" max="@_gesamt" value="@_aktuell"
                      aria-label="@LabelFortschritt"></progress>
            <span class="epos-status">@_status</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_status))
    {
        <p class="epos-status">@_status</p>
    }

    @* ------------------------------------------------------ Fussleiste *@
    <div class="epos-leiste">
        @if (_stand.MitPhotovoltaik && Gaben is not null)
        {
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="() => Oeffne(Unterdialog.Photovoltaik)">@PhotovoltaikText</button>
        }
        @if (_stand.MitBhkw && Gaben is not null)
        {
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="() => Oeffne(Unterdialog.Bhkw)">@BhkwText</button>
        }
        @if (_stand.MitStrombezug && Gaben is not null)
        {
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="() => Oeffne(Unterdialog.Strombezug)">@StrombezugText</button>
        }
        @* AUFTRAG #325: "Parameter…" steht nicht mehr hier, sondern oben in der
           Zeile der Szenariowahl. Die uebrigen Einstiege bleiben, wo sie sind. *@
        @if (Gaben is not null)
        {
            <button type="button" class="epos-knopf" disabled="@_laeuft"
                    @onclick="() => Oeffne(Unterdialog.Verlauf)">@VerlaufText</button>
        }
        <button type="button" class="epos-knopf epos-knopf--primaer" disabled="@_laeuft"
                @onclick="BerechnenLaufen">@BerechnenText</button>
        @if (_laeuft)
        {
            <button type="button" class="epos-knopf" @onclick="LaufAbbrechen">@AbbrechenText</button>
        }
    </div>

    @* ---------------------------------------------------- Unterdialoge *@
    <Ueberlagerung Offen="@(_offen == Unterdialog.Photovoltaik)"
                   Titel="@PhotovoltaikText" Geschlossen="() => Fertig(false)">
        <KindInhalt>
            @if (_gaben is not null)
            {
                @* Ein Titel, eine Stelle: Die Ueberlagerung traegt Titel UND Kreuz,
                   also zeigt der Dialog seinen eigenen Kopf hier nicht.
                   TitelAnzeigen="false" steht RECHTS vom Satz und gilt deshalb auch
                   dann, wenn er den Schluessel mitbraechte. *@
                <PhotovoltaikVerguetungDialog @attributes="_gaben" TitelAnzeigen="false"
                    Geschlossen="@((PvVerguetungErgebnis e) => Fertig(e is not null))" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_offen == Unterdialog.Bhkw)"
                   Titel="@BhkwText" Geschlossen="() => Fertig(false)">
        <KindInhalt>
            @if (_gaben is not null)
            {
                @* Ein Titel, eine Stelle: Die Ueberlagerung traegt Titel UND Kreuz,
                   also zeigt der Dialog seinen eigenen Kopf hier nicht.
                   TitelAnzeigen="false" steht RECHTS vom Satz. *@
                <BhkwWirtschaftlichkeitDialog @attributes="_gaben" TitelAnzeigen="false"
                    Geschlossen="@((BhkwWirtschaftlichkeitErgebnis e) => Fertig(e is { Gespeichert: true }))" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_offen == Unterdialog.Strombezug)"
                   Titel="@StrombezugText" Geschlossen="() => Fertig(false)">
        <KindInhalt>
            @if (_gaben is not null)
            {
                @* Ein Titel, eine Stelle: Die Ueberlagerung traegt Titel UND Kreuz,
                   also zeigt der Dialog seinen eigenen Kopf hier nicht.
                   TitelAnzeigen="false" steht RECHTS vom Satz. *@
                <TarifstrukturDialog @attributes="_gaben" TitelAnzeigen="false"
                    Geschlossen="@((bool ok) => Fertig(ok))" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_offen == Unterdialog.Parameter)"
                   Titel="@ParameterText" Geschlossen="() => Fertig(false)">
        <KindInhalt>
            @if (_gaben is not null)
            {
                @* Ein Titel, eine Stelle: Die Ueberlagerung traegt Titel UND Kreuz,
                   also zeigt der Dialog seinen eigenen Kopf hier nicht.
                   TitelAnzeigen="false" steht RECHTS vom Satz. *@
                <WirtschaftlichkeitParameterDialog @attributes="_gaben" TitelAnzeigen="false"
                    Geschlossen="@((WirtParameterErgebnis e) => Fertig(e is not null))" />
            }
        </KindInhalt>
    </Ueberlagerung>

    <Ueberlagerung Offen="@(_offen == Unterdialog.Verlauf)"
                   Titel="@VerlaufText" Geschlossen="() => Fertig(false)">
        <KindInhalt>
            @if (_gaben is not null)
            {
                @* Ein Titel, eine Stelle: Die Ueberlagerung traegt Titel UND Kreuz,
                   also zeigt der Dialog seinen eigenen Kopf hier nicht.
                   TitelAnzeigen="false" steht RECHTS vom Satz. *@
                <KapitalwertVerlaufDialog @attributes="_gaben" TitelAnzeigen="false"
                    Geschlossen="@(() => Fertig(true))" />
            }
        </KindInhalt>
    </Ueberlagerung>
</div>

@code {
    /// <summary>Die fünf Unterdialoge der Seite — Schlüssel für die Hülle.</summary>
    public enum Unterdialog
    {
        /// <summary>Kein Bereich offen.</summary>
        Keins,
        /// <summary>PV-Vergütung (<c>PhotovoltaikVerguetungDialog</c>).</summary>
        Photovoltaik,
        /// <summary>BHKW-Wirtschaftlichkeit (<c>BhkwWirtschaftlichkeitDialog</c>).</summary>
        Bhkw,
        /// <summary>Tarifstruktur, Sicht Strombezug (<c>TarifstrukturDialog</c>).</summary>
        Strombezug,
        /// <summary>Wirtschaftlichkeitsparameter (<c>WirtschaftlichkeitParameterDialog</c>).</summary>
        Parameter,
        /// <summary>Kapitalwertverlauf (<c>KapitalwertVerlaufDialog</c>).</summary>
        Verlauf
    }

    // =====================================================================
    // Datenseite
    // =====================================================================

    /// <summary>Liefert den Anzeigestand (Vorbild <c>LadeDaten</c>).</summary>
    [Parameter] public Func<WirtschaftlichkeitStand>? Laden { get; set; }

    /// <summary>
    /// Zeigt ein anderes Szenario. Gerechnet wird dabei nichts — die Hülle
    /// liest den Lauf, der schon im Speicher liegt (Vorbild
    /// <c>ZeigeErgebnisse</c>).
    /// </summary>
    [Parameter] public Func<int, ErgebnisAnsicht>? Anzeigen { get; set; }

    /// <summary>
    /// Rechnet die Gruppe neu (Simulation nachziehen, Kapitalwerte, Speichern).
    /// Der zweite Parameter ist der Fortschrittsmelder.
    /// </summary>
    [Parameter] public Func<IReadOnlyList<int>, Action<Laufschritt>, Task<LaufErgebnis>>? Berechnen { get; set; }

    /// <summary>Bricht einen laufenden Rechenlauf ab.</summary>
    [Parameter] public Action? Abbrechen { get; set; }

    /// <summary>
    /// Die Vergleichswahl hat gewechselt (Ids der Versionen im Vergleich, Stamm
    /// eingeschlossen) — die Hülle merkt sie sich für alle drei Seiten (W5‑B‑5), und
    /// die Tabelle folgt ihr sofort über <see cref="Anzeigen"/>.
    /// </summary>
    [Parameter] public Action<IReadOnlyList<int>>? VergleichGewaehlt { get; set; }

    /// <summary>
    /// Der Parametersatz eines Unterdialogs. <c>null</c> heißt „geht gerade
    /// nicht" — dann bleibt der Bereich zu und die Hülle hat ihren Grund in
    /// die Statuszeile geschrieben.
    /// </summary>
    [Parameter] public Func<Unterdialog, IReadOnlyDictionary<string, object>?>? Gaben { get; set; }

    /// <summary>
    /// Nachlauf eines Unterdialogs: Was ist zu melden? Leer = nichts. Der
    /// Vorläufer schrieb hier „… gespeichert — bitte neu berechnen."
    /// </summary>
    [Parameter] public Func<Unterdialog, bool, string>? Nachlauf { get; set; }

    /// <summary>
    /// AUFTRAG #325 (Anwenderentscheid 17.09.2026): Schreibt die nicht monetären
    /// Wirkungen fort (<c>WirtschaftlichkeitCtrl.SpeichereParameter</c> über die
    /// Hülle); <c>true</c> = geschrieben. <b>Kein Delegat, kein Knopf</b> — ohne ihn
    /// erscheint der Bewertungsblock gar nicht.
    ///
    /// <para>Es ist derselbe Speicherweg auf dieselbe Modelleigenschaft
    /// (<c>Parameter.NichtMonetaer</c>), den bis zu diesem Auftrag der
    /// Parameterdialog nahm — nur die Eingabestelle ist eine andere.</para>
    /// </summary>
    [Parameter] public Func<string, bool>? WirkungSpeichern { get; set; }

    /// <summary>Hilfeschlüssel — der der alten Maske.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "UcWirtschaftlichkeit.btn_Help";

    // ---- Texte ----------------------------------------------------------

    /// <summary>Überschrift der Seite. ETAPPE B6 (K11): Der Rückfall ist der
    /// Ressourcenwert, nicht ein deutscher Text — dieselbe Bauart wie bei
    /// <see cref="NeuBerechnenText"/>. Die Hülle darf ihn weiter überschreiben; wo
    /// sie es nicht tut, steht der Text trotzdem in der Oberflächensprache.</summary>
    [Parameter] public string TitelText { get; set; } = Resource.WIRT_TITEL;

    /// <inheritdoc cref="TitelText" path="/summary/text()[last()]"/>
    [Parameter] public string LabelVarianten { get; set; } = Resource.WIRT_LBL_GRUPPE;
    [Parameter] public string LabelSzenario { get; set; } = "Szenario:";
    [Parameter] public string LabelFortschritt { get; set; } = "Fortschritt";

    [Parameter] public string SpalteArt { get; set; } = "Art";
    [Parameter] public string SpalteBezeichner { get; set; } = "Bezeichner";
    [Parameter] public string SpalteProjektname { get; set; } = "Projektname";

    /// <summary>Kopf der Speicherkontextspalte (VF-1).</summary>
    [Parameter] public string SpalteSpeicher { get; set; } = "Stromspeicher";
    [Parameter] public string SpalteSimulation { get; set; } = "Simulation";

    [Parameter] public string PhotovoltaikText { get; set; } = "Photovoltaik…";
    [Parameter] public string BhkwText { get; set; } = "BHKW-Wirtschaftlichkeit…";
    [Parameter] public string StrombezugText { get; set; } = "Strombezug…";
    [Parameter] public string ParameterText { get; set; } = "Parameter…";
    [Parameter] public string VerlaufText { get; set; } = "Verlauf…";
    [Parameter] public string BerechnenText { get; set; } = "Berechnen";
    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Beschriftung des Rechenknopfs IM WARNBAND (Auftrag #267) — derselbe
    /// Lauf wie „Berechnen", nur oben, wo die Meldung steht. Der Text kommt aus
    /// MyResource (beide Sprachen), damit er auch ohne Zutun der Hülle in der
    /// Oberflächensprache steht.</summary>
    [Parameter] public string NeuBerechnenText { get; set; } = Resource.WIRT_BTN_NEU_BERECHNEN;

    /// <summary>Der Satz des Warnbandes, wenn die gespeicherten Ergebnisse nicht mehr
    /// zum Stand passen — der Grund, warum der Knopf daneben steht.</summary>
    [Parameter] public string NachrechnenText { get; set; } = Resource.WIRT_BAND_NACHRECHNEN;

    // ---- Bewertung nach DIN EN 17463 (AUFTRAG #325) ----------------------
    //
    // DIE VIER SCHLUESSEL ZIEHEN UNVERAENDERT MIT aus dem Parameterdialog:
    // WPAR_G_BEWERTUNG, WPAR_NICHT_MONETAER, WPAR_NICHT_MONETAER_PLATZ und
    // WPAR_NICHT_MONETAER_HINWEIS. Kein neuer, kein umbenannter Schluessel - es ist
    // derselbe Abschnitt an einem anderen Ort. Der Speichernknopf nimmt
    // WPAR_BTN_SPEICHERN, den es ebenfalls schon gibt.

    /// <summary>Überschrift des Bewertungsblocks (Schlüssel <c>WPAR_G_BEWERTUNG</c>).</summary>
    [Parameter] public string BewertungTitel { get; set; }
        = BhwTexte.T("WPAR_G_BEWERTUNG", "Bewertung nach DIN EN 17463");

    /// <summary>Beschriftung des Freitextfeldes (<c>WPAR_NICHT_MONETAER</c>).</summary>
    [Parameter] public string NichtMonetaerText { get; set; }
        = BhwTexte.T("WPAR_NICHT_MONETAER", "Nicht monetäre Wirkungen:");

    /// <summary>Platzhalter im leeren Feld (<c>WPAR_NICHT_MONETAER_PLATZ</c>).</summary>
    [Parameter] public string NichtMonetaerPlatz { get; set; }
        = BhwTexte.T("WPAR_NICHT_MONETAER_PLATZ",
            "z. B. Versorgungssicherheit, Arbeitssicherheit, Komfort, Außenwirkung, "
            + "Erfüllung einer Auflage");

    /// <summary>Herleitungszeile unter dem Feld (<c>WPAR_NICHT_MONETAER_HINWEIS</c>).</summary>
    [Parameter] public string NichtMonetaerHinweis { get; set; }
        = BhwTexte.T("WPAR_NICHT_MONETAER_HINWEIS", "");

    /// <summary>Beschriftung des Schreibknopfs (<c>WPAR_BTN_SPEICHERN</c>).</summary>
    [Parameter] public string BewertungSpeichernText { get; set; }
        = BhwTexte.T("WPAR_BTN_SPEICHERN", "Speichern");

    /// <summary>Meldung nach dem Schreiben (<c>WIRT_NM_GESPEICHERT</c>).</summary>
    [Parameter] public string BewertungGespeichertText { get; set; }
        = BhwTexte.T("WIRT_NM_GESPEICHERT", "Nicht monetäre Wirkungen gespeichert.");

    /// <summary>Meldung, wenn das Schreiben scheitert (<c>WPAR_MSG_SPEICHERFEHLER</c>).</summary>
    [Parameter] public string BewertungFehlerText { get; set; }
        = BhwTexte.T("WPAR_MSG_SPEICHERFEHLER", "Der Parametersatz konnte nicht gespeichert werden.");

    /// <summary>Meldung beim Versuch, die Stammzeile abzuwählen.
    /// <inheritdoc cref="TitelText" path="/summary/text()[last()]"/></summary>
    [Parameter] public string MeldungStammReferenz { get; set; }
        = Resource.BK_BER_MSG_STAMM_REFERENZ;

    /// <summary>Meldung „abgebrochen".
    /// <inheritdoc cref="TitelText" path="/summary/text()[last()]"/></summary>
    [Parameter] public string StatusAbgebrochen { get; set; } = Resource.BK_BER_STATUS_ABGEBROCHEN;

    // =====================================================================
    // Zustand
    // =====================================================================

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private WirtschaftlichkeitStand _stand = new();
    private readonly List<int> _gewaehlt = new();

    private Unterdialog _offen = Unterdialog.Keins;
    private IReadOnlyDictionary<string, object>? _gaben;

    private bool _laeuft;
    private int _aktuell, _gesamt = 1;
    private string _status = "";
    private string _fehler = "";

    /// <summary>Die Warnungen der Vergleichstabelle, jede einmal (Auftrag #267).</summary>
    private IReadOnlyList<string> _warnungen = Array.Empty<string>();

    /// <summary>Die gespeicherten Ergebnisse passen nicht mehr zum Stand — dann steht
    /// der Rechenknopf oben im Warnband (Auftrag #267).</summary>
    private bool _nachrechnen;

    /// <summary>Steht der Bewertungsblock offen? (AUFTRAG #325) Der Zustand gehört der
    /// Seite und überlebt jeden Auffrischlauf — das ist der Grund für den Knopf statt
    /// eines <c>&lt;details&gt;</c>.</summary>
    private bool _bewertungOffen;

    /// <summary>Der Arbeitsstand des Freitextes (AUFTRAG #325). Geschrieben wird er
    /// erst auf Zuruf; bis dahin bleibt der geladene Stand unangetastet.</summary>
    private string _nichtMonetaer = "";

    /// <summary>Steht der Bewertungsblock offen? (Prüfhilfe)</summary>
    public bool BewertungOffen => _bewertungOffen;

    /// <summary>Der Arbeitsstand des Freitextes (Prüfhilfe).</summary>
    public string NichtMonetaer => _nichtMonetaer;

    /// <summary>Die Warnungen des Bandes (Prüfhilfe).</summary>
    public IReadOnlyList<string> Warnungen => _warnungen;

    /// <summary>Läuft gerade eine Berechnung? (Prüfhilfe; der Wirt darf dann nicht schließen.)</summary>
    public bool Beschaeftigt => _laeuft;

    /// <summary>Statuszeile (Prüfhilfe).</summary>
    public string Status => _status;

    /// <summary>Der offene Unterdialog (Prüfhilfe).</summary>
    public Unterdialog OffenerUnterdialog => _offen;

    /// <summary>Die angehakten Versionen inklusive Stamm (Prüfhilfe).</summary>
    public IReadOnlyList<int> Gewaehlte => _gewaehlt;

    protected override void OnInitialized() => Auffrischen();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    /// <summary>Liest Liste, Parameterzeile und Ergebnisse neu ein.</summary>
    public void Auffrischen()
    {
        _stand = Laden?.Invoke() ?? new WirtschaftlichkeitStand();

        _gewaehlt.Clear();
        foreach (int id in _stand.GewaehlteVarianten) _gewaehlt.Add(id);
        foreach (VarianteZeile z in _stand.Varianten)
            if (z.IstStamm && !_gewaehlt.Contains(z.IdProjekt)) _gewaehlt.Add(z.IdProjekt);

        _status = _stand.Statuszeile ?? "";

        // AUFTRAG #325: Der Freitext folgt dem frisch gelesenen Stand — er hängt am
        // Projekt und nicht an Szenario oder Vergleichswahl. Ein OFFENER Block mit
        // ungeschriebener Eingabe behält sie: Auffrischen läuft auch nach jedem
        // Unterdialog, und der Anwender soll seinen halben Satz nicht dabei verlieren.
        if (!_bewertungOffen) _nichtMonetaer = _stand.NichtMonetaer ?? "";

        // AUFTRAG #267: Warnband und Rechenweg folgen dem frisch gelesenen Stand.
        // Das Warnzeichen der Statuszeile ist die EINE Marke, mit der die Hülle
        // „passt nicht mehr zum Simulationsstand" kennzeichnet — dieselbe, die auch
        // die Warnzellen der Tabelle tragen.
        WarnbandAuffrischen();
        _nachrechnen = _status.Contains(ErgebnisMatrix.WARN_PRAEFIX.Trim());
        StateHasChanged();
    }

    /// <summary>Die Warnungen der Tabelle einsammeln (Auftrag #267).</summary>
    private void WarnbandAuffrischen()
    {
        _warnungen = _stand.Ansicht?.Matrix?.Warnungen() ?? Array.Empty<string>();
    }

    // =====================================================================
    // Auswahl
    // =====================================================================

    private bool Gewaehlt(int id) => _gewaehlt.Contains(id);

    private void VarianteUmschalten(VarianteZeile z, bool an)
    {
        if (z.IstStamm) { _status = MeldungStammReferenz; return; }

        if (an) { if (!_gewaehlt.Contains(z.IdProjekt)) _gewaehlt.Add(z.IdProjekt); }
        else _gewaehlt.Remove(z.IdProjekt);

        // W5-B-5 (08.09.2026): Der Haken wirkt SOFORT auf die Tabelle und gilt
        // auch fuer Uebersicht und Kosten - bis hierher wirkte er erst beim
        // naechsten Rechenlauf, und die Spalten folgten den gespeicherten
        // Ergebnissen statt der Wahl.
        VergleichGewaehlt?.Invoke(new List<int>(_gewaehlt));
        if (Anzeigen is not null) _stand.Ansicht = Anzeigen(_stand.SzenarioId);
        WarnbandAuffrischen();          // #267: die Spalten wechseln, die Warnungen mit
    }

    private void BeiSzenario(int? id)
    {
        _stand.SzenarioId = id ?? 0;
        if (Anzeigen is not null) _stand.Ansicht = Anzeigen(_stand.SzenarioId);
        WarnbandAuffrischen();          // #267: jedes Szenario hat seine eigenen Gründe
    }

    // =====================================================================
    // Bewertung nach DIN EN 17463 (AUFTRAG #325)
    // =====================================================================

    /// <summary>
    /// Auf- und zuklappen. Beim ÖFFNEN wird der geladene Stand geholt — wer den
    /// Block aufmacht, soll sehen, was gespeichert ist, und nicht einen Rest von
    /// vorhin. Beim Schließen bleibt nichts liegen: Was nicht geschrieben wurde,
    /// ist nicht geschrieben, und der nächste Auffrischlauf setzt den Stand zurück.
    /// </summary>
    private void BewertungUmschalten()
    {
        _bewertungOffen = !_bewertungOffen;
        if (_bewertungOffen) _nichtMonetaer = _stand.NichtMonetaer ?? "";
    }

    /// <summary>
    /// Schreibt den Freitext fort — derselbe Weg, den bis zu diesem Auftrag der
    /// Parameterdialog nahm. Danach frischt die Seite auf, damit der Ausweis im
    /// Nachweisblock dem folgt, was gerade geschrieben wurde.
    ///
    /// <para>Scheitert das Schreiben, SAGT die Seite es und behält die Eingabe —
    /// ein stiller Fehlschlag wäre die Behauptung, der Text stünde in der
    /// Datenbank.</para>
    /// </summary>
    private void WirkungSchreiben()
    {
        if (_laeuft || WirkungSpeichern is null) return;

        string text = _nichtMonetaer;
        if (!WirkungSpeichern(text)) { _fehler = BewertungFehlerText; return; }

        _fehler = "";
        _stand.NichtMonetaer = text;
        Auffrischen();
        _nichtMonetaer = text;
        _status = BewertungGespeichertText;
    }

    // =====================================================================
    // Unterdialoge
    // =====================================================================

    private void Oeffne(Unterdialog art)
    {
        if (_laeuft || Gaben is null) return;

        IReadOnlyDictionary<string, object>? gaben = Gaben(art);
        if (gaben is null)
        {
            // Die Huelle konnte den Satz nicht bauen (kein Stammprojekt, keine
            // Anlagen) - dann bleibt der Bereich zu. Denselben Ausgang hatte
            // der Vorlaeufer, wenn seine Huelle false lieferte.
            _status = Nachlauf?.Invoke(art, false) ?? "";
            return;
        }

        _gaben = gaben;
        _offen = art;
    }

    private void Fertig(bool gespeichert)
    {
        Unterdialog war = _offen;
        _offen = Unterdialog.Keins;
        _gaben = null;

        string meldung = Nachlauf?.Invoke(war, gespeichert) ?? "";

        // Der Vorlaeufer frischte nach jedem Unterdialog die Parameterzeile
        // auf (ZeigeParameterzeile) und beim Verlauf zusaetzlich Liste und
        // Ergebnisse. Auffrischen tut beides in einem.
        Auffrischen();
        if (!string.IsNullOrEmpty(meldung)) _status = meldung;

        // AUFTRAG #267: „… gespeichert — bitte neu berechnen." war bis hierher eine
        // Aufforderung OHNE Weg: Der Knopf „Berechnen" liegt unter der langen
        // Vergleichstabelle und war auf dem Bildschirm des Anwenders nicht zu sehen.
        // Jetzt stellt dasselbe Speichern das Warnband mit dem Rechenknopf nach oben.
        if (gespeichert) _nachrechnen = true;
    }

    // =====================================================================
    // Berechnen
    // =====================================================================

    private async Task BerechnenLaufen()
    {
        if (_laeuft || Berechnen is null) return;

        var varianten = new List<int>();
        foreach (VarianteZeile z in _stand.Varianten)
            if (!z.IstStamm && _gewaehlt.Contains(z.IdProjekt)) varianten.Add(z.IdProjekt);

        _laeuft = true;
        _aktuell = 0;
        _gesamt = 1;
        _fehler = "";
        StateHasChanged();

        try
        {
            LaufErgebnis erg = await Berechnen(varianten, Melden);

            if (erg.Abgebrochen) { _status = StatusAbgebrochen; return; }

            Auffrischen();                       // Liste, Parameterzeile, Ergebnisse
            _fehler = erg.Fehler ?? "";
            if (!string.IsNullOrEmpty(erg.Statuszeile)) _status = erg.Statuszeile;
        }
        finally
        {
            _laeuft = false;
            StateHasChanged();
        }
    }

    private void Melden(Laufschritt s)
    {
        _ = InvokeAsync(() =>
        {
            if (s.Gesamt > 0) { _gesamt = s.Gesamt; _aktuell = Math.Min(s.Aktuell, s.Gesamt); }
            _status = s.Gesamt > 0 ? $"({s.Aktuell}/{s.Gesamt}) {s.Text}" : s.Text;
            StateHasChanged();
        });
    }

    private void LaufAbbrechen() => Abbrechen?.Invoke();
}
