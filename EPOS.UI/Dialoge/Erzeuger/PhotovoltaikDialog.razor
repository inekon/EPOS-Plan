    /// <summary>
    /// Auf- und zuklappen - und beim AUFklappen die Felder holen.
    /// </summary>
    /// <remarks>
    /// <b>Der Knopf bleibt, die Vorgabe ist offen.</b> Wer zuklappt und wieder
    /// aufklappt, sieht den Stand von JETZT und nicht den von der Auswahl.
    /// </remarks>
    private void ParameterUmschalten()
    {
        _parameterOffen = !_parameterOffen;
        if (_parameterOffen) FelderHolen();
    }

    /// <summary>Holt die Felder des gewählten Katalogsatzes neu.</summary>
    private void FelderHolen()
    {
        _felder = Katalogfelder is null || _katalogZeile is null
            ? null
            : Katalogfelder(_katalogZeile.Bezeichner);
        _felderGeaendert = false;
        _feldFehler = false;
    }

    /// <summary>Ein Zahlenfeld des Aufklappers meldet einen ungültigen Zustand.</summary>
    private void BeiFeldFehler((string Feldname, bool Fehler) meldung)
        => _feldFehler = meldung.Fehler;

    /// <summary>Eine Eingabe im Aufklapper: Speichern geht wieder, der Vermerk fällt weg.</summary>
    private void FeldGeaendert()
    {
        _felderGeaendert = true;
        _felderVermerk?.Leeren();
    }

    /// <summary>
    /// Schreibt die geänderten Felder zurück und lädt die Katalogliste neu.
    /// </summary>
    /// <remarks>
    /// <b>Der Befund des Katalogs zählt, nicht die Absicht.</b> Lehnt der Speicherweg ab
    /// (Schreibschutz der Auslieferung, Prüfmeldung), bleibt der geänderte Stand im
    /// Aufklapper stehen - der Anwender soll ihn verbessern können, statt ihn zu
    /// verlieren.
    /// </remarks>
    private void FelderSpeichern()
    {
        if (KatalogfelderSpeichern is null || _felder is null || _katalogZeile is null) return;

        KatalogSpeicherErgebnis ergebnis = KatalogfelderSpeichern(_katalogZeile.Bezeichner, _felder);
        if (!ergebnis.Ok)
        {
            // Das Band oben bleibt fuer den Fehler - dazu der Grund rot am Knopf.
            Melden(ergebnis.Meldung, true);
            _felderVermerk?.Fehler(ergebnis.Meldung);
            return;
        }

        // Der Erfolg steht nur noch am Knopf; ein Band einer frueheren Ablehnung faellt weg.
        _felderGeaendert = false;
        _meldung = "";
        _felderErfolg = ergebnis.Meldung;
        _felderVermerk?.Gespeichert();
        KatalogNeuLaden();

        // Der Detailblock oben liest dieselben Spalten - er muss den neuen Stand zeigen.
        if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
        GesamtNeu();
    }

