    // =====================================================================

    private void DateiOeffnen()
    {
        _meldung = "";
        _pfad = "";
        _dateiOffen = true;
    }

    private void DateiSchliessen()
    {
        if (_laeuft) return;                   // waehrend der Kette schliesst nichts
        _dateiOffen = false;
    }

    private async Task BeiDatei(string pfad)
    {
        _pfad = pfad;
        if (string.IsNullOrEmpty(pfad) || Einlesen is null) return;

        _laeuft = true;
        _fortschritt = TextRechnet;
        _meldung = "";
        try
        {
            GanglinienImportErgebnis erg = await Einlesen(pfad, new GanglinienImportRueckrufe
            {
                Optionen = OptionenFragen,
                Protokoll = ProtokollFragen
            });

            if (!string.IsNullOrEmpty(erg.Meldung)) Melden(erg.Meldung, Stufe(erg.MeldungStufe));

            if (erg.Ausgang == ImportAusgang.Erfolg && erg.Werte is not null && erg.Werte.Length > 0)
            {
                // Schritt 6 lautet hier "KEINE Ablage": die Reihe bleibt im Speicher und
                // erscheint als Zeile mit der Quelle "Datei".
                string schluessel = DATEI + (_dateizeilen.Count + 1).ToString(CultureInfo.InvariantCulture);
                string name = string.IsNullOrEmpty(erg.Bezeichner) ? System.IO.Path.GetFileName(pfad) : erg.Bezeichner;
                _dateiwerte[schluessel] = erg.Werte;
                _dateizeilen.Add(new Katalogfilterzeile(0, name) { Schluessel = schluessel }
                    .MitText(Katalogfilterprofil.SpBezeichner, name)
                    .MitText(Katalogfilterprofil.SpQuelle, Resource.PEAK_QUELLE_DATEI)
                    .MitZahl(Katalogfilterprofil.SpIntervallMin,
                             erg.Werte.Length >= RasterAdapter.ViertelstundenJahr ? 15 : 60, 0)
                    .MitZahl(Katalogfilterprofil.SpJahresmaximumKw, Maximum(erg.Werte), 1));
                ZeilenBauen();

                _laeuft = false;
                _dateiOffen = false;
                _gewaehlt = schluessel;
                await LastgangLaden();
                _status = string.Format(CultureInfo.CurrentCulture, Resource.PEAK_MSG_EINGELESEN, name);
            }
        }
        finally
        {
            _laeuft = false;
            _pfad = "";
        }
    }

    private async Task<GanglinienImportOptionen?> OptionenFragen(string pfad, GanglinienVorschau vorschau)
    {
        _optionenPfad = pfad;
        _optionenErkennung = vorschau;
        _optionenOffen = true;
        _optionenWartet = new TaskCompletionSource<GanglinienImportOptionen?>();
        await InvokeAsync(StateHasChanged);
        return await _optionenWartet.Task;
    }

    private void OptionenFertig(GanglinienImportOptionen? optionen)
    {
        _optionenOffen = false;
        _optionenWartet?.TrySetResult(optionen);
    }

    private async Task<bool> ProtokollFragen(IList<PruefMeldung> meldungen, bool moeglich, bool bestaetigen)
    {
        _protokollMeldungen = meldungen as IReadOnlyList<PruefMeldung> ?? meldungen.ToList();
        _protokollMoeglich = moeglich;
        _protokollBestaetigen = bestaetigen;
        _protokollOffen = true;
        _protokollWartet = new TaskCompletionSource<bool>();
        await InvokeAsync(StateHasChanged);
        return await _protokollWartet.Task;
    }

    private void ProtokollFertig(bool weiter)
    {
        _protokollOffen = false;
        _protokollWartet?.TrySetResult(weiter);
    }

    // =====================================================================
    // Parameter
    // =====================================================================

    private void AdaptivGeaendert(bool adaptiv) => _adaptiv = adaptiv;

    private void BeiFehlerZustand((string Feld, bool Fehlerhaft) meldung)
    {
        if (meldung.Fehlerhaft)
        {
            if (!_fehlerhaft.Contains(meldung.Feld)) _fehlerhaft.Add(meldung.Feld);
        }
        else
        {
            _fehlerhaft.Remove(meldung.Feld);
        }
    }

    /// <summary>
    /// Die 13 Zahlenprüfungen und die vier Fachregeln des Vorläufers (<c>ParameterLesen</c>);
    /// die Fachregeln stehen im Kern (<see cref="PeakShavingEingaben.Pruefe"/>). Leer
    /// bleiben dürfen Leistungspreis, Bezugspreis, die drei Investitionsanteile und der Zins.
    /// </summary>
    /// <param name="zielNoetig"><c>false</c> für die Schwellensuche: sie bestimmt P_ziel erst.</param>
    private PeakShavingEingaben? EingabenLesen(bool zielNoetig = true)
    {
        if (_fehlerhaft.Count > 0)
        {
            Melden(string.Format(MeldungZahlUngueltig, _fehlerhaft[0]), WarnStufe.Warnung);
            return null;
        }

        string? fehlt = Pflicht(_pKw, LabelP) ?? Pflicht(_kapazitaet, LabelKapazitaet)
                     ?? Pflicht(_socMin, LabelSoCMin) ?? Pflicht(_socMax, LabelSoCMax)
                     ?? Pflicht(_startSoC, LabelStartSoC) ?? Pflicht(_eta, LabelEta)
                     ?? Pflicht(_nutzungsdauer, LabelNutzungsdauer);

        if (fehlt is null && zielNoetig && !_adaptiv) fehlt = Pflicht(_ziel, LabelZiel);

        if (fehlt is not null)
        {
            Melden(string.Format(MeldungZahlUngueltig, fehlt), WarnStufe.Warnung);
            return null;
        }

        PeakShavingEingaben e = new PeakShavingEingaben
        {
            PKw = _pKw ?? 0.0,
            KapazitaetKwh = _kapazitaet ?? 0.0,
            SoCMinProzent = _socMin ?? 0.0,
            SoCMaxProzent = _socMax ?? 0.0,
            StartSoCProzent = _startSoC ?? 0.0,
            WirkungsgradRt = _eta ?? 0.0,
            ZielschwelleKw = _ziel ?? 0.0,
            LeistungspreisEurProKwA = _lp ?? 0.0,
            BezugspreisMittelCtKwh = _bezugspreis ?? 0.0,
            CCapEurProKwh = _cCap ?? 0.0,
            CPowEurProKw = _cPow ?? 0.0,
            IFixEur = _iFix ?? 0.0,
            KapitalzinsProzent = _zins ?? 0.0,
            NutzungsdauerA = _nutzungsdauer ?? 0.0,
            Adaptiv = _adaptiv,
            Kompatibilitaetsmodus = _kompatibel
        };

        string regel = e.Pruefe(out PeakShavingEingaben.Feld _);
        if (regel.Length > 0) { Melden(regel, WarnStufe.Warnung); return null; }

        return e;
    }

    private static string? Pflicht(double? wert, string name) => wert is null ? name : null;

    private bool ReiheVorhanden()
    {
        if (_lastgang is not null && _lastgang.Length > 0) return true;
        Melden(TextKeineReiheMeldung, WarnStufe.Hinweis);
        return false;
    }

    // =====================================================================
    // Rechnen - beide Laeufe nebenher (Befund W12-B22)
    // =====================================================================

    private async Task BeiMinimal()
    {
        _meldung = "";
        if (!ReiheVorhanden() || MinimaleSchwelle is null) return;

        PeakShavingEingaben? e = EingabenLesen(false);
        if (e is null) return;

        _laeuft = true;
        _fortschritt = TextSucht;
        try
        {
            double minimal = await MinimaleSchwelle(_lastgang!, e);

            // Woertlich: das Ergebnis steht im Schwellenfeld, und die adaptive Suche
            // wird ausgeschaltet - sonst ueberschriebe der naechste Lauf sie wieder.
            _adaptiv = false;
            _ziel = minimal;
            Melden(string.Format(CultureInfo.CurrentCulture, VorlageMinimal,
                                 minimal.ToString("0.##", CultureInfo.CurrentCulture)),
                   WarnStufe.Hinweis);
        }
        catch (ArgumentException ex)
        {
            Melden(ex.Message, WarnStufe.Warnung);
        }
        finally { _laeuft = false; }
    }

    private async Task BeiRechnen()
    {
        _meldung = "";
        if (!ReiheVorhanden() || Rechnen is null) return;

        PeakShavingEingaben? e = EingabenLesen();
        if (e is null) return;

        _laeuft = true;
        _fortschritt = TextRechnet;
        try
        {
            _ergebnis = await Rechnen(_lastgang!, e);
        }
        catch (ArgumentException ex)
        {
            // Der Engine-Text geht ungefiltert in die Meldung - woertlich (:533-538).
            Melden(ex.Message, WarnStufe.Warnung);
            _ergebnis = null;
            _laeuft = false;
            return;
        }
        finally { _laeuft = false; }

        _kennzahlen = PeakShavingKennzahlenBlock.Zeilen(_ergebnis);
        _monate = PeakShavingKennzahlenBlock.Monatszeilen(_ergebnis);
        ModellHolen();

        if (_ergebnis is not null && _ergebnis.SchwelleGerissen)
            Melden(string.Format(CultureInfo.CurrentCulture, VorlageGerissen,
                                 _ergebnis.PNeuMaxKw.ToString("0.#", CultureInfo.CurrentCulture)),
                   WarnStufe.Warnung);
    }

    private void ErgebnisLeeren()
    {
        _ergebnis = null;
        _kennzahlen = new List<PeakShavingKennzahlenBlock.Zeile>();
        _monate = new List<PeakShavingKennzahlenBlock.Monatszeile>();
        _modell = null;
    }

    private void SoCGeaendert(bool an)
    {
        _socZeigen = an;
        ModellHolen();
    }

    /// <summary>Holt das Zeichenmodell — nach einem Lauf und beim Schalter „Ladezustand".</summary>
    private void ModellHolen()
    {
        _modell = _ergebnis is null || Modell is null ? null : Modell(_ergebnis, _socZeigen);
    }

    // =====================================================================
    // CSV
    // =====================================================================

    private async Task BeiCsv()
    {
        if (_ergebnis is null) { Melden(TextKeinErgebnis, WarnStufe.Hinweis); return; }
        if (CsvSpeichern is null) return;
        await CsvSpeichern(_ergebnis);
    }

    // =====================================================================
    // Der Ausgang in die Speichervariante (LS-E-1 (a))
    // =====================================================================

    /// <summary>
    /// „In Variante übernehmen". GERECHNET MUSS SEIN: Übernommen wird die ERREICHTE
    /// Schwelle des Laufs, nicht die Eingabe.
    /// </summary>
    private async Task BeiVarianteUebernehmen()
    {
        if (_ergebnis is null) { Melden(TextKeinErgebnis, WarnStufe.Hinweis); return; }
        if (VarianteUebernehmen is null) return;

        string? art = VariantenBerechnungsart is null ? null : await VariantenBerechnungsart();
        if (art is null) { Melden(TextVarianteKeine, WarnStufe.Warnung); return; }

        if (!string.Equals(art, Resource.SP_BERECHNUNG_ANZEIGE_PEAKSHAVING, StringComparison.Ordinal))
        {
            _varianteFrage = string.Format(CultureInfo.CurrentCulture, VorlageVarianteFrage, art);
            _varianteFrageOffen = true;
            return;
        }

        await VarianteSchreiben();
    }

    private async Task VarianteBeantwortet(bool? antwort)
    {
        _varianteFrageOffen = false;
        if (antwort == true) await VarianteSchreiben();
    }

    private async Task VarianteSchreiben()
    {
        if (_ergebnis is null || VarianteUebernehmen is null) return;

        double ziel = _ergebnis.ErreichteSchwelleKw;
        bool ok = await VarianteUebernehmen(ziel, _adaptiv);

        Melden(ok
            ? string.Format(CultureInfo.CurrentCulture, VorlageVarianteOk,
                            ziel.ToString("0.#", CultureInfo.CurrentCulture))
            : TextVarianteFehler,
            ok ? WarnStufe.Hinweis : WarnStufe.Warnung);
    }

    // =====================================================================
    // Schluss
    // =====================================================================

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text;
        _meldungStufe = stufe;
    }

    private static WarnStufe Stufe(PruefStufe stufe) => stufe switch
    {
        PruefStufe.Fehler => WarnStufe.Fehler,
        PruefStufe.Warnung => WarnStufe.Warnung,
        _ => WarnStufe.Hinweis
    };

    /// <summary><b>Befund W12-B24, wörtlich:</b> Der Schlussknopf meldet <c>false</c>.</summary>
    private Task BeiSchliessen() => Geschlossen.InvokeAsync(false);

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_optionenOffen || _protokollOffen || _varianteFrageOffen) return Task.CompletedTask;
        if (_dateiOffen) { DateiSchliessen(); return Task.CompletedTask; }

        // Im schmalen Fenster schliesst Esc zuerst das Blatt (Konzept 3.3).
        if (_blattOffen)
        {
            _blattOffen = false;
            return Task.CompletedTask;
        }
        return Geschlossen.InvokeAsync(false);
    }
}
