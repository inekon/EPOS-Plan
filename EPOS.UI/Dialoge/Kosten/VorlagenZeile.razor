@* EINE Zeile des Positionsrasters der Kostenverwaltung (iU9-W4.1).

   Vorbild: Views/Kosten/ucVorlagenZeile.cs (377 Z.) und .Designer.cs — die
   Zeile aus Etappe KD2, Konzept Kostendialoge Rev. 1.2 § 5.2:
   Aktionen · Position · Bemessung · Satz 🔗 Betrag · Nutzungsdauer · Worst/Best.

   WARUM EINE KOMPONENTE UND KEINE RASTERSPALTEN. Die sieben Felder bedingen
   einander: Die Bemessung entscheidet, ob Satz und Betrag EIN Wert sind
   (Kopplungsregel KL4 / § 5.4), der Kontext entscheidet, ob im Betragsfeld ein
   Strich, ein Spiegel oder ein gerechneter Wert steht. In sieben
   QuickGrid-Spaltenvorlagen zerlegt waere dieser Zusammenhang auf sieben
   Stellen verteilt. Der Baustein Zeilenraster (iU9-W4.0) traegt dafuer die
   gemeinsamen Spalten; diese Zeile setzt ihre Zellen hinein (display:contents).

   DIE ZEILE RECHNET UND SCHREIBT NICHT. Sie zeigt an und meldet. Was ein
   geaenderter Satz fuer den Betrag bedeutet, entscheidet der Wirt
   (KostenKomponenteDialog) — genau wie im Bestand, wo KopplungAnwenden zwar
   hier stand, seine Wahrheit (die Bemessung) aber vom Wirt kam.

   NEU-MODUS (FK2): die gestrichelte Abschlusszeile der Mockups. Der Vorlaeufer
   legte an, sobald man das Namensfeld mit gefuelltem Namen VERLIESS. Hier
   steht dafuer ein Knopf (A-1 des Protokolls): In einer WebView gibt es kein
   „Leave" mit derselben Bedeutung, und ein Anlegen, das beim Weiterklicken
   nebenbei passiert, ist schwer vorherzusehen. *@

@namespace EPOS.UI.Dialoge.Kosten

<div class="epos-zr-zeile">

    <div class="epos-zr-zelle epos-zr-aktionen">
        @if (Neuzeile)
        {
            <button type="button" class="epos-knopf epos-zr-knopf" title="@AnlegenKurztext"
                    disabled="@(!Schreibbar || string.IsNullOrWhiteSpace(Bezeichnung))"
                    @onclick="() => AnlegenAngefordert.InvokeAsync()">＋</button>
        }
        else
        {
            <button type="button" class="epos-knopf epos-zr-knopf" title="@EditorKurztext"
                    disabled="@(!Schreibbar)"
                    @onclick="() => EditorAngefordert.InvokeAsync()">✏️</button>
            @* U31: EIN SCHLOSS STATT DES PAPIERKORBS an einer Pflichtzeile
               (Schritt 59). Der Papierkorb versprach etwas, was die Zeile nie
               einloest - der Anwender klickte und bekam eine Absage. Das Schloss
               sagt es vorher; der Werkzeugtipp nennt den Grund.

               WARUM ES TROTZDEM EIN KNOPF IST. Der Loeschweg bleibt genau wie
               heute abgewiesen: Wer es dennoch versucht - mit der Maus, mit der
               Tastatur oder ueber den Zeileneditor -, bekommt vom Wirt die
               Meldung mit dem Ausweg („Satz bzw. Betrag auf 0 setzen"). Ein
               stummes Zeichen haette diese Antwort verschluckt. *@
            @if (IstPflicht)
            {
                <button type="button" class="epos-knopf epos-zr-knopf epos-zr-schloss"
                        title="@PflichtKurztext" disabled="@(!Schreibbar)"
                        @onclick="() => LoeschenAngefordert.InvokeAsync()">🔒</button>
            }
            else
            {
                <button type="button" class="epos-knopf epos-zr-knopf" title="@LoeschenKurztext"
                        disabled="@(!Schreibbar)"
                        @onclick="() => LoeschenAngefordert.InvokeAsync()">🗑️</button>
            }
        }
    </div>

    <div class="epos-zr-zelle">
        <Textfeld Wert="@Bezeichnung" WertChanged="@BezeichnungChanged"
                  Platzhalter="@(Neuzeile ? Platzhalter : "")" NurLesen="@(!Schreibbar)" />
    </div>

    <div class="epos-zr-zelle">
        @* ETAPPE E2 (Mockup-Pruefung 03/#10): In der ABSCHLUSSZEILE ist die
           Klappliste gesperrt wie Satz und Nutzungsdauer daneben. Der Wirt reicht
           dort weder BemessungId noch BemessungIdChanged durch - die Auswahl war
           bedienbar und ging ins Leere. Die Bemessung der neuen Position wird
           gepflegt, sobald die Zeile steht. *@
        <Auswahlfeld Eintraege="@Bemessungen" Auswahl="@BemessungId"
                     AuswahlChanged="@BemessungIdChanged" Aktiv="@(Schreibbar && !Neuzeile)" />
    </div>

    <div class="epos-zr-zelle" title="@EmpfehlungKurztext">
        <Zahlenfeld Wert="@Satz" WertChanged="@SatzChanged" Einheit="@Einheit"
                    Aktiv="@(Schreibbar && !Neuzeile)" />
        @* U31: Der EMPFEHLUNGSBEREICH steht sichtbar unter dem Satzfeld - bis
           dahin nur im Werkzeugtipp, den niemand sieht, der nicht mit der Maus
           stehen bleibt. Dieselbe leise Zeile wie die Herleitung unter dem
           Betrag; der Werkzeugtipp bleibt zusaetzlich. Der Text kommt fertig
           aus dem Kern (KostenHerleitung), leer heisst keine Zeile. *@
        @if (!string.IsNullOrEmpty(EmpfehlungZeile))
        {
            <span class="epos-herleitung epos-zr-herleitung epos-zr-empfehlung">@EmpfehlungZeile</span>
        }
        @* ETAPPE E10 (Stufe S3): WOHER der Satz kommt, wenn ihn die Nutzungsdauertabelle
           stellt - "2 % . Satz aus Nutzungsdauertabelle: Heizkessel . Waermeerzeuger".
           Die Zeile steht auch bei LEEREM Feld: Dann rechnet genau dieser Satz. Der Text
           kommt fertig aus dem Kern (NutzungsdauerSatzCtrl), leer heisst keine Zeile. *@
        @if (!string.IsNullOrEmpty(SatzHerleitung))
        {
            <span class="epos-herleitung epos-zr-herleitung epos-zr-satzherkunft">@SatzHerleitung</span>
        }
    </div>

    <div class="epos-zr-zelle epos-zr-text" title="@BetragTitel">
        @if (Kette)
        {
            <span class="epos-zr-kette" title="@KetteKurztext">🔗</span>
        }
        @* ANWENDERBEFUND 14.09.2026: KEIN STILLES 0. Ohne Bezugsgroesse stand hier
           bisher nur die 0 des Anwenderentscheids I-2 - der Grund lag im
           Werkzeugtipp und blieb damit unsichtbar. Das Zeichen macht ihn im
           Raster sichtbar; den Satz dazu sammelt der Wirt unter dem Raster. *@
        @if (OhneBasis)
        {
            <span class="epos-zr-ohnebasis" role="img"
                  aria-label="@BetragKurztext" title="@BetragTitel">⚠</span>
        }
        <span class="epos-zr-betrag">@BetragText</span>
        @* U28: WOHER der Betrag kommt, steht jetzt SICHTBAR unter ihm - bis dahin
           nur im Werkzeugtipp, den niemand sieht, der nicht mit der Maus stehen
           bleibt. Der Text kommt fertig aus dem Kern (KostenHerleitung); die Zeile
           formatiert nichts. Der Werkzeugtipp bleibt zusaetzlich - er nennt
           dieselbe Rechnung vollstaendig, auch wo die Zelle abschneidet. *@
        @if (!string.IsNullOrEmpty(Herleitung))
        {
            <span class="epos-herleitung epos-zr-herleitung">@Herleitung</span>
        }
        @* ANWENDERENTSCHEID 19.09.2026: DIE VORLAGE SAGT ETWAS ANDERES. Eine
           Projektposition, deren Bemessung von der der Standardvorlage abweicht,
           nennt den Vorlagenwert - und bietet ihn zur Uebernahme an. Muster U23:
           eine leise Textzeile mit Handgriff, kein Warnbanner und keine Spalte -
           eine eigene Bemessung ist kein Fehler, nur eine Auskunft wert. Im
           Lesemodus bleibt der Text ohne Knopf. Der Satz kommt fertig aus dem Kern
           (KostenHerleitung); leer heisst keine Zeile. *@
        @if (!string.IsNullOrEmpty(VorlagenHinweis))
        {
            <span class="epos-herleitung epos-zr-herleitung epos-zr-vorlage">
                @VorlagenHinweis
                @if (Schreibbar && VorlagenUebernahme.HasDelegate)
                {
                    <button type="button" class="epos-zr-vorlageknopf"
                            title="@VorlagenUebernehmenKurztext"
                            @onclick="() => VorlagenUebernahme.InvokeAsync()">@VorlagenUebernehmenText</button>
                }
            </span>
        }
    </div>

    <div class="epos-zr-zelle">
        @if (MitNutzungsdauer)
        {
            <Zahlenfeld Wert="@Nutzungsdauer" WertChanged="@NutzungsdauerChanged"
                        Aktiv="@(Schreibbar && !Neuzeile)" />
            @* U8 (Stufe S2): WOHER die Nutzungsdauer kommt, steht sichtbar unter
               ihr - "15 a . Vorgabe der Technik". Bis dahin stand im Feld eine
               Zahl ohne Herkunft, und niemand konnte sehen, ob sie aus der
               AfA-Tabelle stammt oder von Hand gesetzt ist. Der Text kommt fertig
               aus dem Kern (NutzungsdauerCtrl.Herleitungszeile); leer heisst
               keine Zeile. *@
            @if (!string.IsNullOrEmpty(NutzungsdauerHerleitung))
            {
                <span class="epos-herleitung epos-zr-herleitung">@NutzungsdauerHerleitung</span>
            }
        }
    </div>

    <div class="epos-zr-zelle">
        @if (!Neuzeile && MitWorstBest)
        {
            <button type="button" class="epos-knopf epos-zr-knopf" title="@WorstBestKurztext"
                    disabled="@(!Schreibbar)"
                    @onclick="() => WorstBestAngefordert.InvokeAsync()">±</button>
        }
    </div>
</div>

@code {
    // ---- Werte ----------------------------------------------------------

    /// <summary>Bezeichnung der Position (<c>txtBezeichnung</c>).</summary>
    [Parameter] public string Bezeichnung { get; set; } = "";

    /// <summary>Meldet die getippte Bezeichnung.</summary>
    [Parameter] public EventCallback<string> BezeichnungChanged { get; set; }

    /// <summary>Die waehlbaren Bemessungen (<c>cmbBemessung</c>) — der Wirt
    /// filtert sie nach Invest/Betrieb, wie <c>BemessungenFuellen</c>.</summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Bemessungen { get; set; }
        = Array.Empty<(int, string)>();

    /// <summary>Id der gewaehlten Bemessung; <c>null</c> = keine.</summary>
    [Parameter] public int? BemessungId { get; set; }

    /// <summary>Meldet die neue Bemessung.</summary>
    [Parameter] public EventCallback<int?> BemessungIdChanged { get; set; }

    /// <summary>Der Satz (<c>txtSatz</c>).</summary>
    [Parameter] public double? Satz { get; set; }

    /// <summary>Meldet den neuen Satz.</summary>
    [Parameter] public EventCallback<double?> SatzChanged { get; set; }

    /// <summary>Einheit der Bemessung, rechts am Satzfeld (<c>lblEinheit</c>).</summary>
    [Parameter] public string Einheit { get; set; } = "";

    /// <summary>
    /// Der Betrag als fertiger Text (<c>txtBetrag</c>) — im Bestand nie
    /// eingebbar: absolut spiegelt er den Satz, im Projekt steht der gerechnete
    /// Wert, im Katalog ein Strich.
    /// </summary>
    [Parameter] public string BetragText { get; set; } = "";

    /// <summary>Zeigt das Kettensymbol (<c>lblKette</c>) — Satz und Betrag sind EIN Wert.</summary>
    [Parameter] public bool Kette { get; set; }

    /// <summary>Nutzungsdauer (<c>txtNutzung</c>); nur bei Investitionskosten sichtbar.</summary>
    [Parameter] public double? Nutzungsdauer { get; set; }

    /// <summary>Meldet die neue Nutzungsdauer.</summary>
    [Parameter] public EventCallback<double?> NutzungsdauerChanged { get; set; }

    /// <summary>Zeigt die Spalte Nutzungsdauer (<c>txtNutzung.Visible = istInvest</c>).</summary>
    [Parameter] public bool MitNutzungsdauer { get; set; }

    /// <summary>
    /// U8 (Stufe S2): Die HERLEITUNGSZEILE unter der Nutzungsdauer - "15 a .
    /// Vorgabe der Technik", ". AfA-Tabelle: <Positionsart>" oder ". eigener
    /// Wert". Sie kommt fertig aus dem Kern
    /// (<c>NutzungsdauerCtrl.Herleitungszeile</c>); leer heisst keine Zeile.
    /// </summary>
    [Parameter] public string NutzungsdauerHerleitung { get; set; } = "";

    /// <summary>
    /// ETAPPE E10 (Stufe S3): Die HERKUNFTSZEILE unter dem Satzfeld - "2 % . Satz aus
    /// Nutzungsdauertabelle: Heizkessel . Waermeerzeuger (Instandsetzung)". Sie kommt
    /// fertig aus dem Kern (<c>NutzungsdauerSatzCtrl.Herleitungszeile</c>); leer heisst
    /// keine Zeile.
    /// </summary>
    [Parameter] public string SatzHerleitung { get; set; } = "";

    // ---- Zustand --------------------------------------------------------

    /// <summary>Darf die Zeile bearbeitet werden? (<c>!nurLesen</c>)</summary>
    [Parameter] public bool Schreibbar { get; set; } = true;

    /// <summary>Die Abschlusszeile „+ Neue Position hinzufuegen…" (FK2).</summary>
    [Parameter] public bool Neuzeile { get; set; }

    /// <summary>Zeigt den ±-Knopf (<c>btnWorstBest</c>, nur im Projektmodus).</summary>
    [Parameter] public bool MitWorstBest { get; set; }

    /// <summary>
    /// U31: Eine PFLICHTZEILE (Schritt 59, <c>KostenProjektPositionenCtrl.IstPflicht</c>)
    /// — sie trägt in der Aktionsspalte ein Schloss statt des Papierkorbs. Der
    /// Wirt weist den Löschversuch weiterhin ab; die Zeile entscheidet nichts,
    /// sie zeigt nur an, dass hier nichts zu löschen ist.
    /// </summary>
    [Parameter] public bool IstPflicht { get; set; }

    // ---- Meldungen ------------------------------------------------------

    /// <summary>Der Stift (<c>btnEditor</c>) — der Wirt oeffnet den Zeileneditor.</summary>
    [Parameter] public EventCallback EditorAngefordert { get; set; }

    /// <summary>Der Papierkorb (<c>btnLoeschen</c>) — der Wirt fragt nach und loescht.</summary>
    [Parameter] public EventCallback LoeschenAngefordert { get; set; }

    /// <summary>Das ± (<c>btnWorstBest</c>) — der Wirt oeffnet die Worst/Best-Eingabe.</summary>
    [Parameter] public EventCallback WorstBestAngefordert { get; set; }

    /// <summary>Der ＋-Knopf der Abschlusszeile — der Wirt legt an.</summary>
    [Parameter] public EventCallback AnlegenAngefordert { get; set; }

    // ---- Texte ----------------------------------------------------------

    /// <summary>Platzhalter der Abschlusszeile („+ Neue Position…").</summary>
    [Parameter] public string Platzhalter { get; set; } = "+ Neue Position…";

    [Parameter] public string EditorKurztext { get; set; } = "Position bearbeiten";
    [Parameter] public string LoeschenKurztext { get; set; } = "Position löschen";
    [Parameter] public string AnlegenKurztext { get; set; } = "Position anlegen";

    /// <summary>U31: Kurztext des Schlosses an einer Pflichtzeile.</summary>
    [Parameter] public string PflichtKurztext { get; set; }
        = "Pflichtposition, kann nicht gelöscht werden";

    /// <summary>Kurztext des ±-Knopfes (im Bestand ein Tooltip).</summary>
    [Parameter] public string WorstBestKurztext { get; set; }
        = "Worst/Best wird je Projektposition gepflegt, nicht in der Stammvorlage.";

    /// <summary>Kurztext des Kettensymbols.</summary>
    [Parameter] public string KetteKurztext { get; set; }
        = "Satz und Betrag netto sind verknüpft und werden bei Eingabe umgerechnet.";

    /// <summary>Kurztext des Betragsfeldes — je Kontext ein anderer.</summary>
    [Parameter] public string BetragKurztext { get; set; } = "";

    /// <summary>
    /// 14.09.2026: Die Zeile rechnet OHNE Bezugsgroesse - sie traegt dann ein
    /// sichtbares Zeichen, und <see cref="BetragKurztext"/> nennt den Grund.
    /// </summary>
    [Parameter] public bool OhneBasis { get; set; }

    /// <summary>
    /// 14.09.2026: Die Herleitung einer GERECHNETEN Bezugsgroesse, fertig aus dem
    /// Kern - sie steht im Werkzeugtipp des Betragsfeldes unter dem Kurztext.
    /// Leer, wo die Groesse unmittelbar am Geraet steht.
    /// </summary>
    [Parameter] public string BasisHerleitung { get; set; } = "";

    /// <summary>
    /// U28: Die HERLEITUNGSZEILE unter dem Betrag - Bezugsgroesse, Herkunft und
    /// Kaskadenrunde („x 300,00 kW · P_el der Anlage · Runde 1"), bei einer
    /// absoluten Zeile „Satz = Betrag". Sie kommt fertig aus dem Kern
    /// (<c>KostenHerleitung</c>); leer heisst keine Zeile - im Stammkontext und
    /// ueberall dort, wo eine Bezugsgroesse fehlt (dort steht das ⚠).
    /// </summary>
    [Parameter] public string Herleitung { get; set; } = "";

    /// <summary>Der Werkzeugtipp des Betragsfeldes: Kurztext, und darunter die
    /// Herleitung, wenn es eine gibt. Zwei Zeilen statt zweier Tipps - der
    /// Anwender fragt an EINER Stelle, woher der Betrag kommt.</summary>
    private string BetragTitel
        => string.IsNullOrEmpty(BasisHerleitung)
            ? BetragKurztext
            : (string.IsNullOrEmpty(BetragKurztext)
                ? BasisHerleitung
                : BetragKurztext + "\n" + BasisHerleitung);

    /// <summary>Kurztext des Satzfeldes: der Empfehlungsbereich, wenn es einen gibt.</summary>
    [Parameter] public string EmpfehlungKurztext { get; set; } = "";

    /// <summary>
    /// U31: Derselbe Empfehlungsbereich als SICHTBARE Zeile unter dem Satzfeld
    /// („Empfehlung 0,02 bis 0,04 €/kWh"). Sie kommt fertig aus dem Kern
    /// (<c>KostenHerleitung</c>); leer heißt keine Zeile.
    /// </summary>
    [Parameter] public string EmpfehlungZeile { get; set; } = "";

    /// <summary>
    /// ANWENDERENTSCHEID 19.09.2026: Die Hinweiszeile unter der Herleitung —
    /// „Vorlage ‚Standard': % des Endenergiebedarfs". Sie kommt fertig aus dem Kern
    /// (<c>KostenHerleitung</c>); leer heisst keine Zeile.
    /// </summary>
    [Parameter] public string VorlagenHinweis { get; set; } = "";

    /// <summary>Der Klick auf „übernehmen"; ohne Rückruf kein Knopf.</summary>
    [Parameter] public EventCallback VorlagenUebernahme { get; set; }

    /// <summary>Beschriftung des Übernahmeknopfes.</summary>
    [Parameter] public string VorlagenUebernehmenText { get; set; } = "übernehmen";

    /// <summary>Werkzeugtipp des Übernahmeknopfes.</summary>
    [Parameter] public string VorlagenUebernehmenKurztext { get; set; } = "";
}
