    /// <summary>Steht die Überlagerung des Szenariopaars? (Prüfhilfe für Tests)</summary>
    public bool SzenarioOffen => _szenarioGaben is not null;

    /// <summary>ETAPPE E9b: Trägt die Einspeisevergütung KWK ein gepflegtes Paar — gemessen
    /// am Arbeitsstand (1e−9-Regel gegen den Erwartet-Wert im Feld daneben)?</summary>
    public bool EinspeisungKwkSzenarioGepflegt =>
        Szenariopaar.Gepflegt(_vorgaben.EinspeiseverguetungKwkBest, _vorgaben.EinspeiseverguetungKwkWorst,
                              _vorgaben.EinspeiseverguetungKwk ?? 0.0);

    private string EinspeisungKwkSzenarioKurztext =>
        Szenariopaar.Kurztext(_vorgaben.EinspeiseverguetungKwkBest, _vorgaben.EinspeiseverguetungKwkWorst,
                              _vorgaben.EinspeiseverguetungKwk ?? 0.0, "€/kWh", 4);

    /// <summary>
    /// ETAPPE E9b: „±" an der Einspeisevergütung KWK — der <c>CaseEingabeDialog</c> als
    /// Szenariopaar gegen den Wert des Feldes daneben (€/kWh, vier Stellen, bis 2 wie das
    /// Feld). Keine Warnung ohne Erwartet-Wert: „nicht gepflegt" ist hier keine
    /// Datenlücke, sondern „keine Vergütung".
    /// </summary>
    private void EinspeisungKwkSzenarioOeffnen()
    {
        _szenarioTitel = Szenariopaar.Titel(_t.SzEinspKwk);
        _szenarioGaben = Szenariopaar.Gaben(_t.SzEinspKwk, _t.SzEinspKwk, "€/kWh",
            _vorgaben.EinspeiseverguetungKwk, _vorgaben.EinspeiseverguetungKwkBest,
            _vorgaben.EinspeiseverguetungKwkWorst, 4, 2, EinspeisungKwkSzenarioHinweise,
            warnenOhneErwartet: false);
        _meldung = "";
    }

    /// <summary>ETAPPE E9b: das Ergebnis auf den Arbeitsstand der Projektvorgaben — 0 heißt
    /// „wie Erwartet". Geschrieben wird erst im OK-Weg (<see cref="BhkwVorgabenstand.Anwenden"/>).</summary>
    private void EinspeisungKwkSzenarioFertig(CaseEingabeErgebnis? ergebnis)
    {
        _szenarioGaben = null;
        if (ergebnis is null) return;
        _vorgaben.EinspeiseverguetungKwkBest = Szenariopaar.Wert(ergebnis.BestCase);
        _vorgaben.EinspeiseverguetungKwkWorst = Szenariopaar.Wert(ergebnis.WorstCase);
        _geaendert = true;
    }

