@* DER EINHEITENEDITOR DER SPEICHERFLOTTE.

   SEIT AUFTRAG #224 TRAEGT ER NUR NOCH DIE EINHEITEN (Anwenderentscheid SD-E-9,
   Option A; Konzept „Stromspeicher-Dialoge" 7.4). Drei Bloecke sind
   ausgezogen, weil sie nicht die EINHEIT beschreiben:

     * „Groessenbereich dieser Einheit" beschreibt die SUCHE und steht seither
       als Tabelle in Station 4 („Optimierung", OptimierungBlock);
     * „Netz und Planung" gehoert zur BETRIEBSFUEHRUNG und steht in Schritt 3
       (SpeicherFlottenNetzBlock);
     * „Wirtschaftliche Jahresprojektion" gehoert zu „Daten & Kosten" und steht
       in Schritt 2 (SpeicherFlottenWirtschaftBlock) — dorthin ordnet sie auch
       die Wiki-Seite, Programm und Doku widersprachen sich (Konzept 7.2).

   DIE ACHSEN BLEIBEN TROTZDEM SEINE SACHE: Normalisieren() haelt je Einheit
   genau eine FlottenAuslegungsAchse und zieht ihre Vorlage nach, wann immer
   eine Einheit angelegt, kopiert, entfernt oder geaendert wird. Die Station 4
   bearbeitet die Bereiche DIESER Achsen; entstuende die Achse dort, gaebe es
   zwei Stellen, an denen eine Einheit ihren Suchraum bekaeme.

   ZWEI KOSTENBLOECKE STATT EINEM (Konzept 7.2): Die sieben Kostenfelder standen
   unter der Ueberschrift „Ersatz und Restwert", weil der Schalter „Eigene
   Kosten" dort eingehaengt war. Sie heissen seither „Kosten dieser Einheit";
   „Ersatz & Restwert" traegt nur noch Ersatzkosten, Intervall und Restwert.

   DER KARTENKOPF NENNT DEN NAMEN (Konzept 7.8): Der Kurztext „[100kW,
   129.0kWh]" stand mit Punkt als Dezimaltrenner und ohne Leerzeichen daneben —
   dieselben Zahlen stehen aufgeklappt in Hauskultur im Technikblock. *@

@namespace EPOS.UI.Dialoge.Strom
@using System.Globalization
@using SpeicherEngine

<section class="epos-flotte-editor" aria-label="@Texte.Titel">
    <div class="epos-flotte-editor__kopf">
        <div>
            <h2>@Texte.Titel</h2>
            @* Der Erklaersatz ist eine HERLEITUNGSZEILE (Konzept 7.8): Er sagt, wofuer
               die Studie da ist, und soll den Kopf nicht als zweite Ueberschrift
               beschweren. *@
            <Herleitungszeile Text="@Texte.Erlaeuterung" />
        </div>
        @* Die Pille zeigt die Einheitenzahl NEUTRAL — kein Rot ohne Fehler (7.8). *@
        <span class="epos-flotte-editor__zaehler">@EinheitenText</span>
    </div>

    @* Der Betriebseditor steht hier NUR, solange der Wirt ihn nicht selbst fuehrt.
       Die Ansicht STROMSPEICHER_AUSLEGUNG (P3, #192) hat fuer ihn einen EIGENEN
       Schritt der Ablaufleiste („3 Betriebsfuehrung") — stuende er hier ein
       zweites Mal, saehe der Anwender dieselben sechs Felder zweimal, und genau
       diese Doppelung hat Konzept 2.2 fuer das Ergebnisblatt bereits beseitigt. *@
    @if (BetriebZeigen)
    {
        <SpeicherFlottenBetriebEditor Wert="@_wert.Optionen" WertChanged="BetriebsoptionenSetzen" Aktiv="@Aktiv"
                                       PlanerVerfuegbar="@PlanerVerfuegbar" />
    }

    <section class="epos-flotte-abschnitt" aria-labelledby="flotte-einheiten-titel">
        <div class="epos-flotte-abschnitt__kopf">
            <div>
                <h3 id="flotte-einheiten-titel">@Texte.PhysischeEinheiten</h3>
                <p>@Texte.EinheitenHinweis</p>
            </div>
            <button type="button" class="epos-knopf epos-flotte-aktion" disabled="@(!Aktiv)"
                    @onclick="EinheitHinzufuegen">@Texte.Hinzufuegen</button>
        </div>

        @if (_wert.Einheiten.Count == 0)
        {
            <p class="epos-flotte-leer">@Texte.KeineEinheit</p>
        }
        else
        {
            <div class="epos-flotte-einheiten">
                @foreach (FlottenEinheit einheit in _wert.Einheiten)
                {
                    bool offen = _offeneEinheiten.Contains(einheit.Id);
                    <article class="epos-flotte-einheit" @key="einheit.Id" data-einheit-id="@einheit.Id">
                        <div class="epos-flotte-einheit__kopf">
                            <button type="button" class="epos-flotte-einheit__umschalter"
                                    aria-expanded="@offen" aria-controls="@InhaltId(einheit)"
                                    @onclick="@(() => OffenUmschalten(einheit))">
                                <span aria-hidden="true">@(offen ? "▾" : "▸")</span>
                                <span class="epos-flotte-einheit__name">@EinheitName(einheit)</span>
                            </button>
                            <div class="epos-flotte-einheit__aktionen" aria-label="@Texte.EinheitAktionen">
                                <button type="button" class="epos-knopf epos-flotte-aktion" disabled="@(!Aktiv)"
                                        aria-label="@string.Format(Texte.KopierenAria, EinheitName(einheit))"
                                        @onclick="@(() => EinheitKopieren(einheit))">@Texte.Kopieren</button>
                                <button type="button" class="epos-knopf epos-flotte-aktion" disabled="@(!Aktiv)"
                                        aria-label="@string.Format(Texte.EntfernenAria, EinheitName(einheit))"
                                        @onclick="@(() => EinheitEntfernen(einheit))">@Texte.Entfernen</button>
                            </div>
                        </div>

                        @if (offen)
                        {
                            <div id="@InhaltId(einheit)" class="epos-flotte-einheit__inhalt">
                                <div class="epos-flotte-untergruppe">
                                    <h4>@Texte.Technik</h4>
                                    <div class="epos-flotte-feldraster">
                                        <Textfeld Bezeichnung="@Texte.Name" Wert="@einheit.Name" NurLesen="@(!Aktiv)"
                                                  WertChanged="@(v => EinheitNameSetzen(einheit, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.Kapazitaet" Einheit="kWh" Wert="@einheit.KapazitaetKWh" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.KapazitaetKWh = x, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.Ladeleistung" Einheit="kW" Wert="@einheit.LadeleistungKw" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.LadeleistungKw = x, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.Entladeleistung" Einheit="kW" Wert="@einheit.EntladeleistungKw" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.EntladeleistungKw = x, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.Ladewirkungsgrad" Einheit="%" Wert="@(einheit.Ladewirkungsgrad * 100.0)" Min="0.01" Max="100" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.Ladewirkungsgrad = x / 100.0, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.Entladewirkungsgrad" Einheit="%" Wert="@(einheit.Entladewirkungsgrad * 100.0)" Min="0.01" Max="100" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.Entladewirkungsgrad = x / 100.0, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.SocMin" Einheit="%" Wert="@(einheit.SocMin * 100.0)" Min="0" Max="100" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.SocMin = x / 100.0, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.SocMax" Einheit="%" Wert="@(einheit.SocMax * 100.0)" Min="0" Max="100" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.SocMax = x / 100.0, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.SocStart" Einheit="%" Wert="@(einheit.SocStart * 100.0)" Min="0" Max="100" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.SocStart = x / 100.0, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.PeakReserve" Einheit="kWh" Wert="@einheit.PeakReserveKWh" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.PeakReserveKWh = x, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.Hilfsverbrauch" Einheit="kW" Wert="@einheit.HilfsverbrauchKw" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.HilfsverbrauchKw = x, v))" />
                                    </div>
                                </div>

                                <div class="epos-flotte-untergruppe">
                                    <h4>@Texte.AlterungUndGrenzkosten</h4>
                                    <div class="epos-flotte-feldraster">
                                        <Zahlenfeld Bezeichnung="@Texte.Grenzverschleiss" Einheit="€/kWh" Wert="@einheit.GrenzverschleissEuroProKWhEntladung" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.GrenzverschleissEuroProKWhEntladung = x, v))" />
                                    </div>
                                    <p class="epos-flotte-hinweis">@Texte.RainflowHinweis</p>
                                    @if (einheit.RainflowKurve.Count == 0)
                                    {
                                        <p class="epos-flotte-leer">@Texte.KeineRainflowKennlinie</p>
                                    }
                                    @for (int rainIndex = 0; rainIndex < einheit.RainflowKurve.Count; rainIndex++)
                                    {
                                        int index = rainIndex;
                                        FlottenRainflowPunkt punkt = einheit.RainflowKurve[index];
                                        <div class="epos-flotte-feldraster" @key="punkt">
                                            <Zahlenfeld Bezeichnung="@string.Format(Texte.Entladetiefe, index + 1)" Einheit="%" Wert="@(punkt.Entladetiefe * 100.0)" Min="0" Max="100" Aktiv="@Aktiv"
                                                        WertChanged="@(v => RainflowZahlSetzen(einheit, punkt, x => punkt.Entladetiefe = x / 100.0, v))" />
                                            <Zahlenfeld Bezeichnung="@string.Format(Texte.ZyklenBisEol, index + 1)" Einheit="Zyklen" Wert="@punkt.ZyklenBisEol" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => RainflowZahlSetzen(einheit, punkt, x => punkt.ZyklenBisEol = x, v))" />
                                            <button type="button" class="epos-knopf epos-flotte-aktion" disabled="@(!Aktiv)"
                                                    aria-label="@string.Format(Texte.RainflowPunktEntfernenAria, index + 1)"
                                                    @onclick="@(() => RainflowPunktEntfernen(einheit, punkt))">@Texte.PunktEntfernen</button>
                                        </div>
                                    }
                                    <button type="button" class="epos-knopf epos-flotte-aktion" disabled="@(!Aktiv)"
                                            @onclick="@(() => RainflowPunktHinzufuegen(einheit))">@Texte.PunktHinzufuegen</button>
                                </div>

                                <div class="epos-flotte-untergruppe">
                                    <h4>@Texte.KostenDieserEinheit</h4>
                                    <div class="epos-flotte-feldraster">
                                        <Schalter Bezeichnung="@Texte.EigeneKosten" Wert="@einheit.EigeneKosten" Aktiv="@Aktiv"
                                                   WertChanged="@(v => EinheitBoolSetzen(einheit, x => einheit.EigeneKosten = x, v))" />
                                        @if (einheit.EigeneKosten)
                                        {
                                            <Zahlenfeld Bezeichnung="@Texte.InvestitionFix" Einheit="€" Wert="@einheit.InvestitionEuro" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.InvestitionEuro = x, v))" />
                                            <Zahlenfeld Bezeichnung="@Texte.InvestitionKapazitaet" Einheit="€/kWh" Wert="@einheit.InvestitionEuroProKWh" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.InvestitionEuroProKWh = x, v))" />
                                            <Zahlenfeld Bezeichnung="@Texte.InvestitionLeistung" Einheit="€/kW" Wert="@einheit.InvestitionEuroProKw" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.InvestitionEuroProKw = x, v))" />
                                            <Zahlenfeld Bezeichnung="@Texte.OpexFix" Einheit="€/a" Wert="@einheit.JaehrlicheFixeOpexEuro" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.JaehrlicheFixeOpexEuro = x, v))" />
                                            <Zahlenfeld Bezeichnung="@Texte.OpexKapazitaet" Einheit="€/(kWh·a)" Wert="@einheit.JaehrlicheOpexEuroProKWhKapazitaet" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.JaehrlicheOpexEuroProKWhKapazitaet = x, v))" />
                                            <Zahlenfeld Bezeichnung="@Texte.OpexLeistung" Einheit="€/(kW·a)" Wert="@einheit.JaehrlicheOpexEuroProKw" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.JaehrlicheOpexEuroProKw = x, v))" />
                                            <Zahlenfeld Bezeichnung="@Texte.Durchsatzkosten" Einheit="€/kWh" Wert="@einheit.DurchsatzkostenEuroProKWhEntladung" Min="0" Aktiv="@Aktiv"
                                                        WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.DurchsatzkostenEuroProKWhEntladung = x, v))" />
                                        }
                                    </div>
                                </div>

                                <div class="epos-flotte-untergruppe">
                                    <h4>@Texte.ErsatzUndRestwert</h4>
                                    <div class="epos-flotte-feldraster">
                                        <Zahlenfeld Bezeichnung="@Texte.Ersatzkosten" Einheit="€" Wert="@einheit.ErsatzkostenEuro" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.ErsatzkostenEuro = x, v))" />
                                        <Ganzzahlfeld Bezeichnung="@Texte.Ersatzintervall" Einheit="Jahre" Wert="@einheit.ErsatzintervallJahre" Min="0" Aktiv="@Aktiv"
                                                       WertChanged="@(v => EinheitGanzSetzen(einheit, x => einheit.ErsatzintervallJahre = x, v))" />
                                        <Zahlenfeld Bezeichnung="@Texte.RestwertEinheit" Einheit="€" Wert="@einheit.RestwertEuro" Min="0" Aktiv="@Aktiv"
                                                    WertChanged="@(v => EinheitZahlSetzen(einheit, x => einheit.RestwertEuro = x, v))" />
                                    </div>
                                </div>
                            </div>
                        }
                    </article>
                }
            </div>
        }
    </section>

</section>

@code {
    [Parameter] public FlottenStudieKonfiguration Wert { get; set; } = new();
    [Parameter] public EventCallback<FlottenStudieKonfiguration> WertChanged { get; set; }
    [Parameter] public bool Aktiv { get; set; } = true;
    [Parameter] public Beschriftungen Texte { get; set; } = new();

    /// <summary>
    /// Durchreiche an <see cref="SpeicherFlottenBetriebEditor.PlanerVerfuegbar"/>:
    /// <c>null</c> = die Auskunft des Kerns fragen (Betriebsfall, Auftrag #170c).
    /// </summary>
    [Parameter] public bool? PlanerVerfuegbar { get; set; }

    /// <summary>
    /// Steht der Betriebseditor IN diesem Baustein? Vorgabe <c>true</c> — so trug ihn
    /// der Flottendialog, und so trägt ihn der Reiter „Stromspeicher".
    /// </summary>
    /// <remarks>
    /// <c>false</c> setzt die Ansicht STROMSPEICHER_AUSLEGUNG (P3, #192): Dort ist die
    /// Betriebsführung ein EIGENER Schritt der Ablaufleiste, und zweimal dieselben sechs
    /// Felder wären genau die Doppelung, die Konzept 2.2 für das Ergebnisblatt schon
    /// beseitigt hat.
    /// </remarks>
    [Parameter] public bool BetriebZeigen { get; set; } = true;

    private FlottenStudieKonfiguration _wert = new();
    private FlottenStudieKonfiguration? _eingangReferenz;
    private readonly HashSet<string> _offeneEinheiten = new(StringComparer.Ordinal);

    public FlottenStudieKonfiguration AktuellerSnapshot => Kopie(_wert);
    public int EinheitenAnzahl => _wert.Einheiten.Count;

    private string EinheitenText => string.Format(CultureInfo.CurrentCulture, Texte.EinheitenAnzahl, _wert.Einheiten.Count);

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_eingangReferenz, Wert)) return;
        _eingangReferenz = Wert;
        _wert = Kopie(Wert ?? new FlottenStudieKonfiguration());
        Normalisieren();
        if (_wert.Einheiten.Count > 0 && _offeneEinheiten.Count == 0)
            _offeneEinheiten.Add(_wert.Einheiten[0].Id);
    }

    private void Normalisieren()
    {
        _wert.Einheiten ??= new();
        _wert.Optionen ??= new();
        _wert.Wirtschaftlichkeit ??= new();
        _wert.Auslegung ??= new();
        _wert.Auslegung.Achsen ??= new();
        _wert.Auslegung.Betriebsziele ??= new();
        for (int i = 0; i < _wert.Einheiten.Count; i++)
        {
            FlottenEinheit e = _wert.Einheiten[i];
            if (string.IsNullOrWhiteSpace(e.Id)) e.Id = NeueId();
            if (string.IsNullOrWhiteSpace(e.Name)) e.Name = string.Format(CultureInfo.CurrentCulture, Texte.StandardEinheit, i + 1);
            FlottenAuslegungsAchse? a = _wert.Auslegung.Achsen.FirstOrDefault(x => x.Vorlage?.Id == e.Id);
            if (a is null && i < _wert.Auslegung.Achsen.Count &&
                string.IsNullOrWhiteSpace(_wert.Auslegung.Achsen[i].Vorlage?.Id))
                a = _wert.Auslegung.Achsen[i];
            if (a is null)
            {
                a = NeueAchse(e);
                _wert.Auslegung.Achsen.Add(a);
            }
            else a.Vorlage = Kopie(e);
        }
        _wert.Auslegung.Achsen.RemoveAll(a => a.Vorlage is null || !_wert.Einheiten.Any(e => e.Id == a.Vorlage.Id));
        SpiegelEinheiten();
        EndzieleAnpassen();
    }

    private async Task Melden()
    {
        SpiegelEinheiten();
        foreach (FlottenEinheit e in _wert.Einheiten) AchseZu(e).Vorlage = Kopie(e);
        EndzieleAnpassen();
        await WertChanged.InvokeAsync(Kopie(_wert));
    }

    private void SpiegelEinheiten() => _wert.Wirtschaftlichkeit.Einheiten = _wert.Einheiten.Select(Kopie).ToList();

    private void EndzieleAnpassen()
    {
        _wert.Optionen.EndenergieZielKWh ??= new();
        while (_wert.Optionen.EndenergieZielKWh.Count < _wert.Einheiten.Count)
            _wert.Optionen.EndenergieZielKWh.Add(_wert.Einheiten[_wert.Optionen.EndenergieZielKWh.Count].KapazitaetKWh * _wert.Einheiten[_wert.Optionen.EndenergieZielKWh.Count].SocStart);
        if (_wert.Optionen.EndenergieZielKWh.Count > _wert.Einheiten.Count)
            _wert.Optionen.EndenergieZielKWh.RemoveRange(_wert.Einheiten.Count, _wert.Optionen.EndenergieZielKWh.Count - _wert.Einheiten.Count);
    }

    private async Task EinheitHinzufuegen()
    {
        var e = NeueEinheit(_wert.Einheiten.Count + 1);
        _wert.Einheiten.Add(e);
        _wert.Auslegung.Achsen.Add(NeueAchse(e));
        _offeneEinheiten.Add(e.Id);
        await Melden();
    }

    private async Task EinheitKopieren(FlottenEinheit quelle)
    {
        FlottenEinheit e = Kopie(quelle);
        e.Id = NeueId();
        e.AnlageId = null;
        e.Name = EinheitName(quelle) + " – Kopie";
        int index = _wert.Einheiten.IndexOf(quelle) + 1;
        _wert.Einheiten.Insert(index, e);
        FlottenAuslegungsAchse a = Kopie(AchseZu(quelle));
        a.Vorlage = Kopie(e);
        _wert.Auslegung.Achsen.Insert(Math.Min(index, _wert.Auslegung.Achsen.Count), a);
        _offeneEinheiten.Add(e.Id);
        await Melden();
    }

    private async Task EinheitEntfernen(FlottenEinheit einheit)
    {
        _wert.Einheiten.Remove(einheit);
        _wert.Auslegung.Achsen.RemoveAll(x => x.Vorlage?.Id == einheit.Id);
        _offeneEinheiten.Remove(einheit.Id);
        await Melden();
    }

    private void OffenUmschalten(FlottenEinheit einheit)
    {
        if (!_offeneEinheiten.Add(einheit.Id)) _offeneEinheiten.Remove(einheit.Id);
    }

    private async Task EinheitNameSetzen(FlottenEinheit e, string wert) { e.Name = wert; await Melden(); }
    private async Task EinheitBoolSetzen(FlottenEinheit e, Action<bool> setzen, bool wert) { setzen(wert); await Melden(); }
    private async Task EinheitZahlSetzen(FlottenEinheit e, Action<double> setzen, double? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task EinheitGanzSetzen(FlottenEinheit e, Action<int> setzen, int? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task RainflowZahlSetzen(FlottenEinheit e, FlottenRainflowPunkt p, Action<double> setzen, double? wert) { if (wert.HasValue) setzen(wert.Value); await Melden(); }
    private async Task RainflowPunktHinzufuegen(FlottenEinheit e) { e.RainflowKurve ??= new(); e.RainflowKurve.Add(new FlottenRainflowPunkt()); await Melden(); }
    private async Task RainflowPunktEntfernen(FlottenEinheit e, FlottenRainflowPunkt p) { e.RainflowKurve.Remove(p); await Melden(); }
    private async Task BetriebsoptionenSetzen(FlottenSimulationOptionen wert) { _wert.Optionen = Kopie(wert ?? new()); await Melden(); }

    private FlottenAuslegungsAchse AchseZu(FlottenEinheit e) =>
        _wert.Auslegung.Achsen.First(x => x.Vorlage?.Id == e.Id);

    private FlottenEinheit NeueEinheit(int nummer) => new()
    {
        Id = NeueId(), Name = string.Format(CultureInfo.CurrentCulture, Texte.StandardEinheit, nummer),
        KapazitaetKWh = 100, LadeleistungKw = 50, EntladeleistungKw = 50,
        Ladewirkungsgrad = 0.95, Entladewirkungsgrad = 0.95,
        SocMin = 0.10, SocMax = 0.90, SocStart = 0.50
    };

    private static FlottenAuslegungsAchse NeueAchse(FlottenEinheit e) => new()
    {
        Aktiv = true, Modus = FlottenAuslegungsmodus.KapazitaetUndLeistung,
        AnzahlVon = 1, AnzahlBis = 1,
        KapazitaetVonKWh = e.KapazitaetKWh, KapazitaetBisKWh = e.KapazitaetKWh, KapazitaetSchrittKWh = 1,
        LeistungVonKw = e.LadeleistungKw, LeistungBisKw = e.LadeleistungKw, LeistungSchrittKw = 1,
        CRateVon = 0.5, CRateBis = 2.0, CRateSchritt = 0.5, Vorlage = Kopie(e)
    };

    private static string NeueId() => "sp-" + Guid.NewGuid().ToString("N");
