    /// <summary>
    /// Die Sicht des Assistenten auf die LEBENDEN Felder. Quelle und Ganglinie sind seit
    /// Stufe 5 Zeilen der Liste: „Datei" wählt die zuletzt eingelesene Datei, eine
    /// Ganglinie ihre Zeile — derselbe Weg wie ein Klick.
    /// </summary>
    private PeakShavingKiSicht KiSicht()
    {
        return _kiSicht ??= new PeakShavingKiSicht
        {
            QuelleLesen = () => _gewaehlt.Length == 0 ? null
                              : _gewaehlt.StartsWith(DATEI, StringComparison.Ordinal) ? QuelleDatei : QuelleGanglinie,
            QuelleSetzen = KiQuelleSetzen,
            QuelleEintraege = () => KiMaskenanmeldung.Eintraege(Quellen, z => z.Id, z => z.Text),

            GanglinieLesen = () => GanglinienPlatz,
            GanglinieSetzen = g => { if (g is int i) _ = BeiZeile(GANGLINIE + i); },
            GanglinieEintraege = () => KiMaskenanmeldung.Eintraege(GanglinienEintraege, z => z.Id, z => z.Text),

            ReiheLesen = () => _reiheText,
            HerkunftLesen = () => _herkunft,
            ReiterLesen = () => _reiter,

            ZahlLesen = KiZahl,
            ZahlSetzen = KiZahlSetzen,
            SchalterLesen = KiSchalter,
            SchalterSetzen = KiSchalterSetzen
        };
    }

    /// <summary>Die Ganglinien der Datenbank als Einträge (Platz, Name).</summary>
    private IReadOnlyList<(int Id, string Text)> GanglinienEintraege
        => Ganglinien.Count > 0
            ? Ganglinien
            : _zeilen.Where(z => z.Schluessel.StartsWith(GANGLINIE, StringComparison.Ordinal))
                     .Select(z => (Platz(z.Schluessel) ?? 0, z.Bezeichner)).ToList();

    private static int? Platz(string schluessel)
        => schluessel.StartsWith(GANGLINIE, StringComparison.Ordinal)
           && int.TryParse(schluessel.AsSpan(GANGLINIE.Length), NumberStyles.Integer, CultureInfo.InvariantCulture, out int p)
            ? p : null;

    private int? GanglinienPlatz => Platz(_gewaehlt);

    /// <summary>
    /// Die Quelle als Wahl des Assistenten: Ganglinie = erste Zeile der Datenbank, Datei =
    /// letzte eingelesene Datei — gewählt wie mit einem Klick. Gibt es keine solche Zeile,
    /// nennt die Rückgabe den Grund (Welle #458: benannt statt still).
    /// </summary>
    private string? KiQuelleSetzen(int? quelle)
    {
        string? ziel = quelle == QuelleDatei
            ? _dateizeilen.LastOrDefault()?.Schluessel
            : _zeilen.FirstOrDefault(z => z.Schluessel.StartsWith(GANGLINIE, StringComparison.Ordinal))?.Schluessel;
        if (ziel is null)
            return quelle == QuelleDatei ? Resource.KI_PEAK_KEINE_DATEI : Resource.KI_PEAK_KEINE_GANGLINIE;

        _ = BeiZeile(ziel);
        return null;
    }

    private double? KiZahl(string feld) => feld switch
    {
        PeakShavingKiSicht.F_LEISTUNG       => _pKw,
        PeakShavingKiSicht.F_KAPAZITAET     => _kapazitaet,
        PeakShavingKiSicht.F_WIRKUNGSGRAD   => _eta,
        PeakShavingKiSicht.F_SOC_MIN        => _socMin,
        PeakShavingKiSicht.F_SOC_MAX        => _socMax,
        PeakShavingKiSicht.F_START_SOC      => _startSoC,
        PeakShavingKiSicht.F_ZIEL           => _ziel,
        PeakShavingKiSicht.F_LEISTUNGSPREIS => _lp,
        PeakShavingKiSicht.F_BEZUGSPREIS    => _bezugspreis,
        PeakShavingKiSicht.F_C_CAP          => _cCap,
        PeakShavingKiSicht.F_C_POW          => _cPow,
        PeakShavingKiSicht.F_I_FIX          => _iFix,
        PeakShavingKiSicht.F_ZINS           => _zins,
        PeakShavingKiSicht.F_NUTZUNGSDAUER  => _nutzungsdauer,
        _                                   => null
    };

    /// <summary>Setzt eine Zahl — und verwirft dabei das Ergebnis, genau wie ein Tastendruck.</summary>
    private void KiZahlSetzen(string feld, double? wert)
    {
        switch (feld)
        {
            case PeakShavingKiSicht.F_LEISTUNG:       _pKw = wert; break;
            case PeakShavingKiSicht.F_KAPAZITAET:     _kapazitaet = wert; break;
            case PeakShavingKiSicht.F_WIRKUNGSGRAD:   _eta = wert; break;
            case PeakShavingKiSicht.F_SOC_MIN:        _socMin = wert; break;
            case PeakShavingKiSicht.F_SOC_MAX:        _socMax = wert; break;
            case PeakShavingKiSicht.F_START_SOC:      _startSoC = wert; break;
            case PeakShavingKiSicht.F_ZIEL:           _ziel = wert; break;
            case PeakShavingKiSicht.F_LEISTUNGSPREIS: _lp = wert; break;
            case PeakShavingKiSicht.F_BEZUGSPREIS:    _bezugspreis = wert; break;
            case PeakShavingKiSicht.F_C_CAP:          _cCap = wert; break;
            case PeakShavingKiSicht.F_C_POW:          _cPow = wert; break;
            case PeakShavingKiSicht.F_I_FIX:          _iFix = wert; break;
            case PeakShavingKiSicht.F_ZINS:           _zins = wert; break;
            case PeakShavingKiSicht.F_NUTZUNGSDAUER:  _nutzungsdauer = wert; break;
            default: return;
        }
        ErgebnisLeeren();
    }

    private bool KiSchalter(string feld) => feld switch
    {
        PeakShavingKiSicht.S_ADAPTIV     => _adaptiv,
        PeakShavingKiSicht.S_KOMPATIBEL  => _kompatibel,
        PeakShavingKiSicht.S_LADEZUSTAND => _socZeigen,
        _                                => false
    };

    private void KiSchalterSetzen(string feld, bool wert)
    {
        switch (feld)
        {
            case PeakShavingKiSicht.S_ADAPTIV:     AdaptivGeaendert(wert); break;
            case PeakShavingKiSicht.S_KOMPATIBEL:  _kompatibel = wert; ErgebnisLeeren(); break;
            case PeakShavingKiSicht.S_LADEZUSTAND: SoCGeaendert(wert); break;
        }
    }

    /// <summary>
    /// Kein Speicherweg — die Maske legt nichts ab. Geprüft wird mit DENSELBEN Regeln wie
    /// am Rechenknopf.
    /// </summary>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = KiPruefung
    };

    private string KiPruefung()
    {
        string? fehlt = Pflicht(_pKw, LabelP) ?? Pflicht(_kapazitaet, LabelKapazitaet)
                     ?? Pflicht(_socMin, LabelSoCMin) ?? Pflicht(_socMax, LabelSoCMax)
                     ?? Pflicht(_startSoC, LabelStartSoC) ?? Pflicht(_eta, LabelEta)
                     ?? Pflicht(_nutzungsdauer, LabelNutzungsdauer);

        if (fehlt is null && !_adaptiv) fehlt = Pflicht(_ziel, LabelZiel);
        if (fehlt is not null)
            return string.Format(CultureInfo.CurrentCulture, MeldungZahlUngueltig, fehlt);

        PeakShavingEingaben e = new PeakShavingEingaben
        {
            PKw = _pKw ?? 0.0,
            KapazitaetKwh = _kapazitaet ?? 0.0,
            SoCMinProzent = _socMin ?? 0.0,
            SoCMaxProzent = _socMax ?? 0.0,
            StartSoCProzent = _startSoC ?? 0.0,
            WirkungsgradRt = _eta ?? 0.0,
            ZielschwelleKw = _ziel ?? 0.0,
            NutzungsdauerA = _nutzungsdauer ?? 0.0,
            Adaptiv = _adaptiv,
            Kompatibilitaetsmodus = _kompatibel
        };

        return e.Pruefe(out PeakShavingEingaben.Feld _) ?? "";
    }

