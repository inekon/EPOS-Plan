@* DIE KLAPP-BAUFORM DES HAUSES fuer eine Hinweisliste: eine Kopfzeile mit dem Zeichen der
   Schwere, der ZAHL als Abzeichen, „n Hinweise" und rechts „anzeigen ▾" bzw. „ausblenden ▴";
   aufgeklappt steht darunter die Liste in einem Rollbereich begrenzter Hoehe
   (.epos-hinweisklappe-inhalt, hoechstens 40 % der Fensterhoehe; er rollt innen).

   EIN Baustein fuer jede Hinweisliste - Simulation, Bericht, Wirtschaftlichkeit UND die
   Hinweise des Warnbanners: dieselbe Bedienung und dasselbe Bild an jeder Stelle.

   INHALT: entweder die Hinweise als Texte (Parameter Hinweise, ein <li> je Hinweis, die
   Zahl folgt der Liste) oder beliebiger Inhalt (ChildContent, die Zahl kommt als Anzahl).

   ZWEI STELLUNGEN IM BILD:
   - frei stehend (Vorgabe): ein Band im Farbklang der Stufe (dieselben Toene wie der
     Warnbanner, auch im Kontrastmodus);
   - eingebettet (Eingebettet=true): die Zeile im Warnbanner - ohne eigenen Grund, Rahmen
     und Zeichen, sie erbt den Farbklang des Banners.

   ZWEI ARTEN:
   - an Ort und Stelle (Vorgabe): der Klick klappt die Liste auf und zu;
   - mit Oeffnen: der Klick ruft den Rueckruf (die Simulationsseite zeigt den
     Volltext im Dialog); die Zeile bleibt dann immer „anzeigen ▾".

   ANFANGSSTELLUNG: Offen, wenn gesetzt; sonst eingeklappt, sobald mehr als ein Hinweis
   vorliegt, ein einzelner Hinweis steht offen (abschaltbar mit EinzelnOffen=false).

   STELLUNG IN DER SITZUNG: Ohne Schluessel lebt sie so lange wie die Komponente. Mit
   Schluessel steht sie im Sitzungsgedaechtnis (Vorgabe: prozessweit, keine Datenbank)
   und uebersteht Neuzeichnen und Seitenwechsel; vor dem ersten Klick gilt die
   Anfangsregel. *@

@if (Zahl > 0)
{
    @* Ein echter Knopf: Enter und Leertaste bedient der Browser, aria-expanded und
       aria-controls sagen der Sprachausgabe, was er tut. *@
    <button type="button" class="@KnopfKlassen"
            aria-expanded="@(IstOffen ? "true" : "false")" aria-controls="@_inhaltId"
            @onclick="Klicken">
        @if (!Eingebettet && Stufe is { } stufe)
        {
            <span class="epos-hinweisklappe-symbol" aria-hidden="true">@Zeichen(stufe)</span>
        }
        <span class="epos-simerg-laufband-zahl">@Zahl</span>
        <span class="epos-simerg-laufband-text">@Beschriftung</span>
        <span class="epos-simerg-laufband-pfeil">@(IstOffen ? AusblendenText : AnzeigenText) <span aria-hidden="true">@(IstOffen ? "▴" : "▾")</span></span>
    </button>
    @if (IstOffen)
    {
        @if (Hinweise is { Count: > 0 })
        {
            <ul class="@InhaltKlassen("epos-hinweisklappe-liste")" id="@_inhaltId">
                @for (int i = 0; i < Hinweise.Count; i++)
                {
                    <li @key="i">@Hinweise[i]</li>
                }
            </ul>
        }
        else if (ChildContent is not null)
        {
            <div class="@InhaltKlassen("")" id="@_inhaltId">@ChildContent</div>
        }
    }
}

@code {
    /// <summary>Das prozessweite Sitzungsgedaechtnis (Schluessel der Seite → offen).</summary>
    public static readonly Dictionary<string, bool> Sitzung = new(StringComparer.Ordinal);

    /// <summary>Zahl der Hinweise bei beliebigem Inhalt; mit <see cref="Hinweise"/> zaehlt die
    /// Liste. Bei 0 zeichnet der Baustein nichts.</summary>
    [Parameter] public int Anzahl { get; set; }

    /// <summary>
    /// Die Hinweise als Texte, ein Listeneintrag je Hinweis; leer oder <c>null</c> = der
    /// Inhalt kommt aus <see cref="ChildContent"/>.
    /// </summary>
    /// <remarks>
    /// <b>Die Liste kommt ausdruecklich, nicht als verketteter Absatz:</b> Die Huelle kennt
    /// die Grenzen der Hinweise, der Baustein muesste sie aus einem Fliesstext raten.
    /// </remarks>
    [Parameter] public IReadOnlyList<string>? Hinweise { get; set; }

    /// <summary>Text bei genau einem Hinweis.</summary>
    [Parameter] public string TextEiner { get; set; } = "";

    /// <summary>Text bei mehreren Hinweisen; {0} ist die Zahl.</summary>
    [Parameter] public string TextMehrere { get; set; } = "";

    /// <summary>Schwere der Liste: Farbklang des frei stehenden Bandes und Zeichen vor der
    /// Zahl; ohne Angabe kein Zeichen und der Klang der Warnung.</summary>
    [Parameter] public WarnStufe? Stufe { get; set; }

    /// <summary>Die Zeile steht in einem Warnbanner: ohne eigenen Grund, Rahmen und Zeichen,
    /// der Farbklang ist der des Banners.</summary>
    [Parameter] public bool Eingebettet { get; set; }

    /// <summary>Zusaetzliche Klasse am Band (seitenbezogener Pruefanker).</summary>
    [Parameter] public string Klasse { get; set; } = "";

    /// <summary>Zusaetzliche Klasse am Rollbereich (Pruefanker des Wirts).</summary>
    [Parameter] public string ListenKlasse { get; set; } = "";

    /// <summary>Beschriftung rechts im eingeklappten Zustand.</summary>
    [Parameter] public string AnzeigenText { get; set; } = Resource.BK_BER_ERG_ANZEIGEN;

    /// <summary>Beschriftung rechts im aufgeklappten Zustand.</summary>
    [Parameter] public string AusblendenText { get; set; } = Resource.BK_BER_ERG_AUSBLENDEN;

    /// <summary>Anfangsstellung; <c>null</c> = nach der Zahl (siehe <see cref="EinzelnOffen"/>).</summary>
    [Parameter] public bool? Offen { get; set; }

    /// <summary>Ein einzelner Hinweis steht anfangs offen (Vorgabe ja).</summary>
    [Parameter] public bool EinzelnOffen { get; set; } = true;

    /// <summary>Schluessel der Seite im Sitzungsgedaechtnis; ohne ihn lebt die Stellung
    /// so lange wie die Komponente.</summary>
    [Parameter] public string? Schluessel { get; set; }

    /// <summary>Das Sitzungsgedaechtnis; ohne Angabe <see cref="Sitzung"/>.</summary>
    [Parameter] public IDictionary<string, bool>? Gedaechtnis { get; set; }

    /// <summary>Statt Aufklappen: der Klick ruft diesen Rueckruf (Dialogweg).</summary>
    [Parameter] public EventCallback Oeffnen { get; set; }

    /// <summary>Beliebiger Inhalt, gezeigt im aufgeklappten Zustand.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Steht die Liste offen? (Pruefhilfe)</summary>
    public bool IstOffen => !Oeffnen.HasDelegate && (GemerkteStellung() ?? _eigeneStellung ?? Anfangsstellung);

    /// <summary>Die gezeigte Zahl: die Laenge der Hinweisliste, sonst <see cref="Anzahl"/>.</summary>
    public int Zahl => Hinweise is { Count: > 0 } liste ? liste.Count : Anzahl;

    private bool? _eigeneStellung;

    private readonly string _inhaltId = "epos-hinweisklappe-" + Guid.NewGuid().ToString("N")[..8];

    private IDictionary<string, bool> Speicher => Gedaechtnis ?? Sitzung;

    private bool Anfangsstellung => Offen ?? (EinzelnOffen && Zahl == 1);

    private string Beschriftung => Zahl == 1
        ? TextEiner
        : string.Format(System.Globalization.CultureInfo.CurrentCulture, TextMehrere, Zahl);

    private string KnopfKlassen => "epos-simerg-laufband epos-hinweisklappe "
        + (Eingebettet ? "epos-hinweisklappe--eingebettet"
                       : "epos-hinweisklappe--" + StufenKlasse(Stufe ?? WarnStufe.Warnung))
        + (string.IsNullOrEmpty(Klasse) ? "" : " " + Klasse);

    private string InhaltKlassen(string eigene) => "epos-hinweisklappe-inhalt"
        + (eigene.Length == 0 ? "" : " " + eigene)
        + (string.IsNullOrEmpty(ListenKlasse) ? "" : " " + ListenKlasse);

    private bool? GemerkteStellung()
    {
        if (string.IsNullOrEmpty(Schluessel)) return null;
        lock (Speicher)
            return Speicher.TryGetValue(Schluessel, out bool offen) ? offen : null;
    }

    private async Task Klicken()
    {
        if (Oeffnen.HasDelegate)
        {
            await Oeffnen.InvokeAsync();
            return;
        }
        bool neu = !IstOffen;
        _eigeneStellung = neu;
        if (!string.IsNullOrEmpty(Schluessel))
            lock (Speicher)
                Speicher[Schluessel] = neu;
    }

    private static string StufenKlasse(WarnStufe stufe) => stufe switch
    {
        WarnStufe.Hinweis => "hinweis",
        WarnStufe.Fehler => "fehler",
        WarnStufe.Erfolg => "erfolg",
        _ => "warnung"
    };

    /// <summary>Dieselben Zeichen wie der Warnbanner.</summary>
    private static string Zeichen(WarnStufe stufe) => stufe switch
    {
        WarnStufe.Hinweis => "i",
        WarnStufe.Fehler => "✕",
        WarnStufe.Erfolg => "✔",
        _ => "!"
    };
}
