    private bool Gewaehlt(KwkgAnlagenAngabe a) => ReferenceEquals(a, Aktuelle);

    private string Wahlklasse(KwkgAnlagenAngabe a) =>
        Gewaehlt(a) ? "epos-knopf epos-anlagenwahl epos-knopf--primaer"
                    : "epos-knopf epos-anlagenwahl";

    private void Waehle(KwkgAnlagenAngabe a)
    {
        _aktuell = Anlagen.IndexOf(a);
        _meldung = "";
    }

    /// <summary>Ein Feld hat sich geaendert: den ARBEITSSTAND fortschreiben und
    /// merken. In die Datenbank geht davon nichts - das tut allein
    /// <see cref="Schreiben"/> im OK-Weg.</summary>
    private void Setze(Action aenderung)
    {
        aenderung();
        _geaendert = true;
        _meldung = "";
        _leiste?.Leeren();
    }

    private void StichtagA(DateOnly? d) => Setze(() => AktuellerStand!.Stichtag = Zeit(d));
    private void IbnA(DateOnly? d) => Setze(() => AktuellerStand!.Inbetriebnahme = Zeit(d));
    private void ArtA(int? n) => Setze(() => AktuellerStand!.Anlagenart = BhkwWahlen.WertZu(_artA, n));
    private void FallA(int? n) => Setze(() => AktuellerStand!.Eigenfall = BhkwWahlen.WertZu(_fallA, n));

    // 0 heisst "kein eigener Wert": Ein Zuschlagssatz von null waere fachlich kein
    // Satz und ein Kontingent von null keine Laufzeit - sonst kaeme niemand mehr zum
    // Projektwert zurueck (E6-Muster).
    private void SatzEinspA(double? w) => Setze(() => AktuellerStand!.SatzEinspCt = Positiv(w));
    private void SatzEigenA(double? w) => Setze(() => AktuellerStand!.SatzEigenCt = Positiv(w));
    private void KontingentA(double? w) => Setze(() => AktuellerStand!.VbhKontingent = Positiv(w));
    private void DeckelA(double? w) => Setze(() => AktuellerStand!.VbhDeckel = Positiv(w));

    // BK1: 0 heisst auch hier "nicht gepflegt" - dann waehlt § 8 keine Stufe und der
    // Kontingentvorschlag nennt den Grund statt einer Zahl.
    private void KostenanteilA(double? w) => Setze(() => AktuellerStand!.Kostenanteil = Positiv(w));
    private void EnergiesteuerA(int? n) => Setze(() => AktuellerStand!.EnergiesteuerWahl = BhkwWahlen.WertZu(_esA, n));
    private void AufteilungA(int? n) => Setze(() => AktuellerStand!.AufteilungMethode = BhkwWahlen.WertZu(_aufA, n));

    // Beim Anteil ist 0 ein GUELTIGER Wert ("keine Hilfsenergie", BF4) - er wird
    // deshalb als 0 geschrieben und nicht auf null abgebildet.
    private void HilfsAnteilA(double? w) => Setze(() => AktuellerStand!.HilfsenergieAnteil = w ?? 0);

    // AUFTRAG #325: 0 heisst "nicht gepflegt" - dieselbe Nullsemantik, die der Satz
    // im Parameterdialog hatte, und dieselbe, mit der StromPreisCtrl ihn liest.
    private void EinspeisungKwkP(double? w) => Setze(() => _vorgaben.EinspeiseverguetungKwk = Positiv(w));

    // ETAPPE BK1: Satz, Deckel, Kontingent, Tatbestand und Anlagenart des PROJEKTS
    // haben keinen Schreibweg mehr - sie stehen an der Anlage. Die Spalten bleiben in
    // der Datenbank stehen (Aufraeumkandidaten) und werden mit dem Arbeitsstand
    // WERTGLEICH zurueckgeschrieben; der Dialog aendert sie nicht mehr.
    private void AbschlagP(double? w) => Setze(() => _vorgaben.KwkgAbschlagNegativ = w ?? 0);
    private void PauschalP(bool b) => Setze(() => _vorgaben.KwkgPauschalmodus = b);
    private void StichtagP(DateOnly? d) => Setze(() => _vorgaben.KwkgStichtag = Zeit(d));
    private void IbnP(DateOnly? d) => Setze(() => _vorgaben.KwkgInbetriebnahme = Zeit(d));

    private void EnergiesteuerP(int? n) => Setze(() => _vorgaben.EnergiesteuerWahl =
        WertMitVorgabe(_esP, n, DbWerte.ENERGIESTEUER_WAHL_KEINE));
    private void AufteilungP(int? n) => Setze(() => _vorgaben.AufteilungMethode =
        WertMitVorgabe(_aufP, n, DbWerte.AUFTEILUNG_VOLLER_BRENNSTOFF));
    private void UnternehmensartP(int? n) => Setze(() => _vorgaben.Unternehmensart =
        WertMitVorgabe(_uaP, n, DbWerte.UNTERNEHMENSART_KEIN_PROD_GEWERBE));

    private void RaeumlichP(bool b) => Setze(() => _vorgaben.RaeumlicherZusammenhang = b);
    private void HocheffizienzP(bool b) => Setze(() => _vorgaben.HocheffizienzNachweis = b);

    // ETAPPE B6: Der Modus des § 9 Abs. 1 Nr. 3 StromStG. Die Vorgabe AUSWEIS steht
    // auch dann, wenn die Liste nichts hergibt - sie ist der Rechenstand, nicht eine
    // Leerstelle.
    private void BefreiungsmodusP(int? n) => Setze(() => _vorgaben.StromsteuerBefreiungModus =
        WertMitVorgabe(_modus, n, DbWerte.STROMST_BEFREIUNG_MODUS_AUSWEIS));

    // 0 % Jahresnutzungsgrad heisst "nicht erfasst": Ein Nutzungsgrad von null ist
    // fachlich kein Wert, und die Begruendung soll "nicht erfasst" von "erfasst und
    // zu niedrig" unterscheiden koennen (E4-Muster).
    private void NutzungsgradP(double? w) => Setze(() => _vorgaben.Jahresnutzungsgrad = Positiv(w));

    /// <summary>Wie <c>GewaehltMitVorgabe</c> der WinForms-Fassung: Diese drei Listen
    /// haben keinen Leereintrag, ein unbekannter Index faellt auf die Vorgabe.</summary>
    private static string WertMitVorgabe(IReadOnlyList<Steuerwahl> liste, int? n, string vorgabe)
    {
        string w = BhkwWahlen.WertZu(liste, n);
        return string.IsNullOrEmpty(w) ? vorgabe : w;
    }

    private static DateOnly? Tag(DateTime? d) => d.HasValue ? DateOnly.FromDateTime(d.Value) : null;

    private static DateTime? Zeit(DateOnly? d) => d.HasValue ? d.Value.ToDateTime(TimeOnly.MinValue) : null;

    /// <summary>0 und leer bedeuten dasselbe: kein eigener Wert.</summary>
    private static double? Positiv(double? w) => w.HasValue && w.Value > 0 ? w : null;

    // =====================================================================
    // Herleitung und Warnzeilen (reine Anzeige, Quellen des Bestands)
    // =====================================================================

    // =====================================================================
    // ETAPPE BK1 — die drei Vorschlaege AM FELD
    //
    // Je Feld eine Grundlage, ein Erlaubt und ein Uebernehmen. Gerechnet wird
    // NICHTS: Saetze und Herleitung kommen aus KwkgSatzRechner, das Kontingent aus
    // KwkgKontingentRechner - dieselben reinen Funktionen, die auch der Rechenkern
    // ruft (BW8, Leitentscheidung L9). Uebernommen wird in den ARBEITSSTAND;
    // geschrieben wird wie jede andere Eingabe erst beim OK.
    // =====================================================================

    /// <summary>
    /// Grundlage des Einspeisesatzes: Tranchen, Norm, Jahr — und AUFTRAG #351 (U23)
    /// der Vermerk zur Herkunft des Feldes: „Vorschlag", wenn das Feld dem Vorschlag
    /// entspricht, sonst „eigener Wert {0} — Vorschlag {1}". Der Vergleich laeuft auf
    /// den vier Stellen des Feldes (<c>KwkgSatzHerkunft</c>), nicht auf der Anzeige.
    /// </summary>
    private string GrundlageEinsp()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return "";
        KwkgSatzVorschlag v = Vorschlag(a);
        return MitHerkunft(string.Format(_t.HerleitungEinsp,
                                         KwkgSatzHerkunft.Satz(v.SatzEinspeisungCt, BhwTexte.Kultur),
                                         v.HerleitungEinspeisung),
                           AktuellerStand?.SatzEinspCt ?? 0, v.SatzEinspeisungCt);
    }

    /// <summary>Grundlage des Eigenstromsatzes: Tranchen, Norm des gewaehlten
    /// Tatbestands, Jahr — mit demselben Herkunftsvermerk wie die Einspeisung.</summary>
    private string GrundlageEigen()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return "";
        KwkgSatzVorschlag v = Vorschlag(a);
        return MitHerkunft(string.Format(_t.HerleitungEigen,
                                         KwkgSatzHerkunft.Satz(v.SatzEigenCt, BhwTexte.Kultur),
                                         v.HerleitungEigen),
                           AktuellerStand?.SatzEigenCt ?? 0, v.SatzEigenCt);
    }

    /// <summary>
    /// AUFTRAG #351 (U23) — haengt den Herkunftsvermerk an eine Grundlagenzeile. Der
    /// Text entsteht im Kern, damit Dialog, Erloesrubrik, Bericht und Vorschau
    /// denselben Satz fuehren; der Dialog vergleicht den ARBEITSSTAND (was beim
    /// Speichern gerechnet wuerde), nicht den gebuchten Lauf.
    /// </summary>
    private static string MitHerkunft(string grundlage, double angesetztCt, double vorschlagCt)
    {
        string vermerk = KwkgSatzHerkunft.Vermerk(angesetztCt, vorschlagCt, BhwTexte.Kultur);
        return vermerk.Length == 0 ? grundlage : grundlage + " · " + vermerk;
    }

    /// <summary>Grundlage des Kontingents: Stufe des § 8 aus Anlagenart und
    /// Kostenanteil DIESER Anlage.</summary>
    private string GrundlageKontingent()
    {
        if (AktuellerStand is null) return "";
        KwkgKontingentVorschlag v = Kontingentvorschlag();
        return string.Format(_t.HerleitungKontingent,
                             v.KontingentH.ToString("N0", BhwTexte.Kultur), v.Herleitung);
    }

    /// <summary>Ohne elektrische Nennleistung gibt es keine Leistungsstaffel — und
    /// damit keinen Satz (§ 7 Abs. 1/2).</summary>
    private bool VorschlagEinspErlaubt => Aktuelle is not null && Aktuelle.PelKW > 0;

    /// <summary>Zusaetzlich zur Leistung braucht der Eigenstromsatz den Tatbestand des
    /// § 6 Abs. 3; ohne ihn gibt es den Zuschlag nach § 7 Abs. 2 nicht.</summary>
    private bool VorschlagEigenErlaubt =>
        VorschlagEinspErlaubt && AktuellerStand is not null &&
        !string.IsNullOrEmpty(AktuellerStand.Eigenfall) &&
        !string.Equals(AktuellerStand.Eigenfall, DbWerte.KWKG_EIGENFALL_KEINER, StringComparison.Ordinal);

    /// <summary>Der Sperrgrund des Eigenstromsatzes nennt den ERSTEN fehlenden
    /// Baustein — die Leistung vor dem Tatbestand, weil ohne sie auch der Tatbestand
    /// nichts nuetzt.</summary>
    private string SperrgrundEigen => VorschlagEinspErlaubt ? _t.SperrOhneEigenfall : _t.SperrOhnePel;

    /// <summary>Ohne Anlagenart waehlt § 8 keine Kontingentstufe.</summary>
    private bool VorschlagKontingentErlaubt =>
        AktuellerStand is not null && !string.IsNullOrEmpty(AktuellerStand.Anlagenart) &&
        !Kontingentvorschlag().Unvollstaendig;

    private void VorschlagEinspUebernehmen()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        BhkwAnlagenstand? st = AktuellerStand;
        if (a is null || st is null || !VorschlagEinspErlaubt) return;
        KwkgSatzVorschlag v = Vorschlag(a);
        Setze(() => st.SatzEinspCt = Positiv(v.SatzEinspeisungCt));
    }

    private void VorschlagEigenUebernehmen()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        BhkwAnlagenstand? st = AktuellerStand;
        if (a is null || st is null || !VorschlagEigenErlaubt) return;
        KwkgSatzVorschlag v = Vorschlag(a);
        Setze(() => st.SatzEigenCt = Positiv(v.SatzEigenCt));
    }

    private void VorschlagKontingentUebernehmen()
    {
        BhkwAnlagenstand? st = AktuellerStand;
        if (st is null || !VorschlagKontingentErlaubt) return;
        KwkgKontingentVorschlag v = Kontingentvorschlag();
        Setze(() => st.VbhKontingent = Positiv(v.KontingentH));
    }

    /// <summary>Der Kontingentvorschlag der gewaehlten Anlage — aus IHRER Anlagenart
    /// und IHREM Kostenanteil, mit dem Jahr, das auch der Satzvorschlag nimmt.</summary>
    private KwkgKontingentVorschlag Kontingentvorschlag()
    {
        BhkwAnlagenstand? st = AktuellerStand;
        if (st is null)
            return new KwkgKontingentVorschlag { Unvollstaendig = true };
        return Kontingentvorschlag(st);
    }

    /// <summary>ETAPPE E7c2: derselbe Vorschlag zu einem beliebigen Stand — die
    /// Überlagerung fragt ihn für ihren Zwischenstand.</summary>
    private KwkgKontingentVorschlag Kontingentvorschlag(BhkwAnlagenstand st)
        => KwkgKontingentRechner.Ableiten(st.Anlagenart, st.Kostenanteil ?? 0,
                                          Vorschlagsjahr(), Katalog, BhwTexte.Kultur);

    /// <summary>Der Vorschlag fuer eine Anlage - mit dem Inbetriebnahmejahr DIESER
    /// Anlage, ersatzweise dem der Projektvorgabe (Muster der abgeloesten
    /// Modulmaske aus E6).</summary>
    private KwkgSatzVorschlag Vorschlag(KwkgAnlagenAngabe a) => Vorschlag(a, Stand(a));

    /// <summary>ETAPPE E7c2: derselbe Vorschlag mit Anlagenart und Tatbestand eines
    /// beliebigen Stands — die Überlagerung fragt ihn für ihren Zwischenstand.</summary>
    private KwkgSatzVorschlag Vorschlag(KwkgAnlagenAngabe a, BhkwAnlagenstand s)
        => KwkgSatzRechner.Vorschlag(a.PelKW, Vorschlagsjahr(), s.Anlagenart, s.Eigenfall,
                                     Katalog, BhwTexte.Kultur);

    /// <summary>Das Stichtagsjahr aller Katalogvorschlaege der gewaehlten Anlage: ihr
    /// Inbetriebnahmejahr, ersatzweise der Foerderbeginn des Projekts, sonst das
    /// naechste Jahr (Planungsfall) — Muster der abgeloesten Modulmaske aus E6.</summary>
    private int Vorschlagsjahr()
    {
        DateTime? ibn = AktuellerStand?.Inbetriebnahme;
        if (ibn.HasValue) return ibn.Value.Year;
        return _vorgaben.KwkgInbetriebnahme.HasValue
             ? _vorgaben.KwkgInbetriebnahme.Value.Year
             : DateTime.Now.Year + 1;
    }

    /// <summary>
    /// Die drei Warnzeilen der Gruppe 1 (Konzept § 6.1). <b>Reine Anzeige</b> - die
    /// Grenzwerte kommen aus demselben Gesetzeskatalog, den auch der Rechenweg liest
    /// (<c>KWKG_AUSSCHREIBUNG_GRENZE_KW</c>, <c>STROMST_GRENZE_BEFREIUNG_9_1_3_KW</c>),
    /// mit demselben Rueckfall. Ueber den Ausschluss entscheidet der Rechenweg, nicht
    /// diese Zeile.
    /// </summary>
    private IReadOnlyList<string> Anlagenwarnungen()
    {
        int jahr = _vorgaben.KwkgInbetriebnahme.HasValue
                 ? _vorgaben.KwkgInbetriebnahme.Value.Year : DateTime.Now.Year;
        double grenzeAusschreibung = Katalogwert(DbWerte.GESETZ_KWKG_AUSSCHREIBUNG_GRENZE, jahr,
                                                 GrenzeAusschreibungRueckfall);
        double grenzeStromsteuer = Katalogwert(DbWerte.GESETZ_STROMST_GRENZE_BEFREIUNG, jahr,
                                               GrenzeStromsteuerRueckfall);

        var ausschreibung = new List<string>();
        var ueberStromsteuer = new List<string>();
        var heizoel = new List<string>();
        foreach (KwkgAnlagenAngabe a in Anlagen)
        {
            if (a.PelKW > grenzeAusschreibung) ausschreibung.Add(a.Bezeichner);
            if (a.PelKW > grenzeStromsteuer) ueberStromsteuer.Add(a.Bezeichner);
            DateTime? ibnStand = Stand(a).Inbetriebnahme;
            int ibn = ibnStand.HasValue ? ibnStand.Value.Year : jahr;
            if (a.Heizoel && ibn >= 2025) heizoel.Add(a.Bezeichner);
        }

        var zeilen = new List<string>();
        var k = BhwTexte.Kultur;
        if (ausschreibung.Count > 0)
            zeilen.Add(string.Format(_t.WAusschreibung, string.Join(", ", ausschreibung),
                                     grenzeAusschreibung.ToString("N0", k)));
        if (ueberStromsteuer.Count > 0)
            zeilen.Add(string.Format(_t.WStromsteuer, string.Join(", ", ueberStromsteuer),
                                     grenzeStromsteuer.ToString("N0", k)));
        if (heizoel.Count > 0)
            zeilen.Add(string.Format(_t.WHeizoel, string.Join(", ", heizoel)));
        return zeilen;
    }

    // =====================================================================
    // ETAPPE E7c — die Überlagerung „Sätze und Herkunft" (Befund K‑1, U22)
    //
    // Gerechnet wird NICHTS: Vorschlag und geltende Kennzahl kommen aus
    // KwkStromRechner, derselben reinen Funktion, die der Rechenkern in
    // ReiheJeAnlage ruft (BW8, Leitentscheidung L9). Die Überlagerung führt einen
    // eigenen Zwischenstand; „Übernehmen" legt ihn auf den Arbeitsstand der gewählten
    // Anlage — geschrieben wird wie jede andere Eingabe erst im OK-Weg.
    // =====================================================================

    private bool _uebOffen;

    /// <summary>
    /// ETAPPE E7c2 — der Zwischenstand der Überlagerung: je eine KOPIE des Arbeitsstands
    /// der gewählten Anlage und der Projektvorgaben. Die Wahlfelder (Anlagenart,
    /// Tatbestand, Fall, σ, Energie- und Stromsteuer) arbeiten unmittelbar auf ihnen;
    /// „Übernehmen" legt sie auf den Arbeitsstand, Abbrechen verwirft sie.
    /// </summary>
    private BhkwAnlagenstand? _uebA;
    private BhkwVorgabenstand? _uebP;

    /// <summary>
    /// Die eigenen Werte der Satztafel — <c>null</c> heißt „der Vorschlag gilt" (U22).
    /// Beim Öffnen erscheint ein Satz, der dem Vorschlag entspricht, als leeres Feld; ein
    /// Satzfeld ohne Wert ist im Formular die 0 „kein Zuschlag" und erscheint als eigener
    /// Wert 0 — sonst schriebe ein unberührtes „Übernehmen" still den Vorschlag hinein.
    /// Kontingent und Deckel übernehmen das Formularfeld unverändert: Dort heißt leer
    /// schon „nach § 8 abgeleitet" bzw. „Staffel".
    /// </summary>
    private double? _uebEinsp, _uebEigen, _uebKontingent, _uebDeckel;

    /// <summary>Energiesteuer: true = „nur diese Anlage", false = Projektvorgabe für alle.</summary>
    private bool _uebNurAnlage;

    /// <summary>Steht die Überlagerung „Sätze und Herkunft"? (Prüfhilfe für Tests)</summary>
    public bool UeberlagerungOffen => _uebOffen;

    private string UebTitel => string.Format(_t.UebTitel, Aktuelle?.Bezeichner ?? "");

    /// <summary>Öffnet die Überlagerung mit dem Arbeitsstand der gewählten Anlage —
    /// aus beiden Knöpfen („Sätze und Herkunft…", „Wahl und Herkunft…").</summary>
    private void UebOeffnen()
    {
        BhkwAnlagenstand? st = AktuellerStand;
        KwkgAnlagenAngabe? a = Aktuelle;
        if (st is null || a is null) return;
        _uebA = st.Kopie();
        _uebP = _vorgaben.Kopie();
        KwkgSatzVorschlag v = Vorschlag(a, _uebA);
        _uebEinsp = SatzBeimOeffnen(st.SatzEinspCt, v.SatzEinspeisungCt);
        _uebEigen = SatzBeimOeffnen(st.SatzEigenCt, v.SatzEigenCt);
        _uebKontingent = Positiv(st.VbhKontingent);
        _uebDeckel = Positiv(st.VbhDeckel);
        _uebNurAnlage = !string.IsNullOrEmpty(st.EnergiesteuerWahl) ||
                        !string.IsNullOrEmpty(st.AufteilungMethode);
        _uebOffen = true;
        _meldung = "";
    }

    /// <summary>Leer (= Vorschlag), wenn das Formularfeld dem Vorschlag auf vier Stellen
    /// entspricht; sonst der Formularwert, ein leeres Feld als 0 („kein Zuschlag").</summary>
    private double? SatzBeimOeffnen(double? formular, double vorschlag)
    {
        double wert = formular ?? 0;
        if (SatzVorschlagErlaubt && !KwkgSatzHerkunft.Abweichend(wert, vorschlag)) return null;
        return wert;
    }

    /// <summary>Was „Übernehmen" in ein Satzfeld des Formulars schreibt: leer → der
    /// Vorschlag, ein eigener Wert → er selbst; 0 bleibt „kein Zuschlag".</summary>
    private double? SatzZumFormular(double? eigen, double vorschlag)
    {
        if (eigen.HasValue) return Positiv(eigen);
        return SatzVorschlagErlaubt ? Positiv(vorschlag) : null;
    }

    /// <summary>Abbrechen, Kreuz und Esc: nichts übernehmen.</summary>
    private void UebAbbrechen()
    {
        _uebOffen = false;
        _uebA = null;
        _uebP = null;
    }

    /// <summary>
    /// „Übernehmen": Sätze, Kontingent, Deckel, Kennzeichen, Kennzahl und die Wahlen gehen
    /// in den Arbeitsstand der Anlage, Energie- und Stromsteuer des Projekts in die
    /// Projektvorgaben — und nur, wenn sich etwas geändert hat, zählt es als Änderung
    /// (derselbe Grund wie bei <see cref="BhkwAnlagenstand.Gleicht"/>). Bei der
    /// Projektvorgabe der Energiesteuer folgt die Anlage dem Projekt (ihre zwei Felder
    /// werden leer).
    /// </summary>
    private void UebUebernehmen()
    {
        BhkwAnlagenstand? st = AktuellerStand;
        KwkgAnlagenAngabe? a = Aktuelle;
        if (st is not null && a is not null && _uebA is not null && _uebP is not null)
        {
            BhkwAnlagenstand neuA = _uebA.Kopie();
            KwkgSatzVorschlag v = Vorschlag(a, neuA);
            neuA.SatzEinspCt = SatzZumFormular(_uebEinsp, v.SatzEinspeisungCt);
            neuA.SatzEigenCt = SatzZumFormular(_uebEigen, v.SatzEigenCt);
            neuA.VbhKontingent = Positiv(_uebKontingent);
            neuA.VbhDeckel = Positiv(_uebDeckel);
            neuA.Stromkennzahl = Positiv(neuA.Stromkennzahl);
            if (!_uebNurAnlage)
            {
                neuA.EnergiesteuerWahl = "";
                neuA.AufteilungMethode = "";
            }
            BhkwVorgabenstand neuP = _uebP.Kopie();
            bool anlageAnders = UebAnders(st, neuA);
            bool projektAnders = UebAnders(_vorgaben, neuP);
            int index = _aktuell;
            if (anlageAnders || projektAnders)
                Setze(() =>
                {
                    if (anlageAnders) _staende[index] = neuA;
                    if (projektAnders) _vorgaben = neuP;
                });
        }
        UebAbbrechen();
    }

    /// <summary>Die Felder, die die Überlagerung an der Anlage führt.</summary>
    private static bool UebAnders(BhkwAnlagenstand x, BhkwAnlagenstand y)
        => x.Anlagenart != y.Anlagenart || x.Eigenfall != y.Eigenfall
        || x.Abwaermeabfuhr != y.Abwaermeabfuhr || x.Stromkennzahl != y.Stromkennzahl
        || x.SatzEinspCt != y.SatzEinspCt || x.SatzEigenCt != y.SatzEigenCt
        || x.VbhKontingent != y.VbhKontingent || x.VbhDeckel != y.VbhDeckel
        || x.EnergiesteuerWahl != y.EnergiesteuerWahl || x.AufteilungMethode != y.AufteilungMethode;

    /// <summary>Die Felder, die die Überlagerung an den Projektvorgaben führt.</summary>
    private static bool UebAnders(BhkwVorgabenstand x, BhkwVorgabenstand y)
        => x.EnergiesteuerWahl != y.EnergiesteuerWahl || x.AufteilungMethode != y.AufteilungMethode
        || x.Unternehmensart != y.Unternehmensart || x.HocheffizienzNachweis != y.HocheffizienzNachweis
        || x.RaeumlicherZusammenhang != y.RaeumlicherZusammenhang
        || x.StromsteuerBefreiungModus != y.StromsteuerBefreiungModus;

    // ------------------------------------------------ Wahlen der KWK-Gruppe

    /// <summary>Die Anlagenart ohne „(bitte wählen)" — der leere Stand ist KEINE Wahl,
    /// dann ist in der Gruppe nichts markiert.</summary>
    private IReadOnlyList<(int Id, string Text)> ArtEintraege()
        => BhkwWahlen.Eintraege(_artA.Where(w => w.Wert.Length > 0).ToList());

    private int? ArtAuswahl()
        => _uebA is null || string.IsNullOrEmpty(_uebA.Anlagenart)
            ? null : BhkwWahlen.NummerZu(_artA, _uebA.Anlagenart);

    private void UebArt(int? n)
    {
        if (_uebA is not null) _uebA.Anlagenart = BhkwWahlen.WertZu(_artA, n);
    }

    /// <summary>Die Wirkung je Anlagenart: das Kontingent nach § 8 mit dem Kostenanteil
    /// dieser Anlage — aus KwkgKontingentRechner, wie der Lauf es ableitet.</summary>
    private IReadOnlyDictionary<int, string> ArtWirkungen()
    {
        var d = new Dictionary<int, string>();
        if (_uebA is null) return d;
        foreach (Steuerwahl w in _artA)
        {
            if (w.Wert.Length == 0) continue;
            KwkgKontingentVorschlag v = KwkgKontingentRechner.Ableiten(
                w.Wert, _uebA.Kostenanteil ?? 0, Vorschlagsjahr(), Katalog, BhwTexte.Kultur);
            d[w.Nummer] = string.Format(_t.UebWirkung, v.Unvollstaendig
                ? v.Herleitung
                : string.Format(_t.UebVbh, v.KontingentH.ToString("N0", BhwTexte.Kultur)));
        }
        return d;
    }

    private int? EigenfallAuswahl()
        => _uebA is null || string.IsNullOrEmpty(_uebA.Eigenfall)
            ? null : BhkwWahlen.NummerZu(_fallA, _uebA.Eigenfall);

    private void UebEigenfall(int? n)
    {
        if (_uebA is not null) _uebA.Eigenfall = BhkwWahlen.WertZu(_fallA, n);
    }

    /// <summary>Die Wirkung je Tatbestand: der Eigenstromsatz nach § 7 Abs. 2 aus
    /// KwkgSatzRechner — ohne Satz (Nr. 1 über 100 kW, kein Katalog) der Grund.</summary>
    private IReadOnlyDictionary<int, string> EigenfallWirkungen()
    {
        var d = new Dictionary<int, string>();
        KwkgAnlagenAngabe? a = Aktuelle;
        if (_uebA is null || a is null) return d;
        foreach (Steuerwahl w in _fallA)
        {
            KwkgSatzVorschlag v = KwkgSatzRechner.Vorschlag(a.PelKW, Vorschlagsjahr(), _uebA.Anlagenart,
                                                           w.Wert, Katalog, BhwTexte.Kultur);
            bool keiner = string.Equals(w.Wert, DbWerte.KWKG_EIGENFALL_KEINER, StringComparison.Ordinal);
            string wirkung = v.SatzEigenCt > 0 || keiner || string.IsNullOrEmpty(v.HerleitungEigen)
                ? string.Format(_t.UebCtKwh, KwkgSatzHerkunft.Satz(v.SatzEigenCt, BhwTexte.Kultur))
                : v.HerleitungEigen;
            d[w.Nummer] = string.Format(_t.UebWirkung, wirkung);
        }
        return d;
    }

    private void UebFall(int? n)
    {
        if (_uebA is not null) _uebA.Abwaermeabfuhr = n == 1;
    }

    private void UebSigma(double? w)
    {
        if (_uebA is not null) _uebA.Stromkennzahl = w;
    }

    /// <summary>„Vorschlag übernehmen" leert das Feld — der Weg zurück zum Vorschlag.
    /// Ohne Vorschlag (Gerätezeile ohne P_el oder P_th) ist der Knopf weich gesperrt.</summary>
    private void UebSigmaVorschlag()
    {
        if (SigmaVorschlagErlaubt && _uebA is not null) _uebA.Stromkennzahl = null;
    }

    private IReadOnlyList<(int Id, string Text)> FallEintraege()
        => new List<(int, string)> { (0, _t.UebFall1), (1, _t.UebFall2) };

    /// <summary>Die Wirkung je Fall: bei Fall 1 die Nettostromerzeugung des gebuchten
    /// Laufs (aus dem Modulnachweis), bei Fall 2 die Formel.</summary>
    private IReadOnlyDictionary<int, string> FallWirkungen()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        KwkgModulNachweis? n = a is null ? null : ModulNachweis(a);
        string fall1 = n is null
            ? _t.UebFall1OhneLauf
            : string.Format(_t.UebFall1Menge, n.StromNettoMWh.ToString("N1", BhwTexte.Kultur));
        return new Dictionary<int, string> { [0] = fall1, [1] = _t.UebFall2Formel };
    }

    /// <summary>Gibt die Gerätezeile einen Vorschlag P_el ÷ P_th her?</summary>
    private bool SigmaVorschlagErlaubt =>
        Aktuelle is not null && KwkStromRechner.Vorschlag(Aktuelle.PelKW, Aktuelle.PthKW).HasValue;

    private string SigmaVorschlagText()
    {
        double? v = Aktuelle is null ? null : KwkStromRechner.Vorschlag(Aktuelle.PelKW, Aktuelle.PthKW);
        return v.HasValue ? v.Value.ToString(KwkStromRechner.FORMAT_KENNZAHL, BhwTexte.Kultur) : "—";
    }

    private string SigmaHerkunft()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null || !SigmaVorschlagErlaubt) return _t.UebHerkunftSigmaOhne;
        var k = BhwTexte.Kultur;
        return string.Format(_t.UebHerkunftSigma, a.PelKW.ToString("N1", k), a.PthKW!.Value.ToString("N1", k));
    }

    /// <summary>Spalte „gilt": die Kennzahl, mit der gerechnet würde — Vorschlag,
    /// eigener Wert samt Vorschlag, oder keine (kein Ersatz, keine Vorgabe).</summary>
    private string SigmaGilt()
    {
        if (_uebA is null || !_uebA.Abwaermeabfuhr) return _t.UebGiltFall1;
        KwkgAnlagenAngabe? a = Aktuelle;
        KwkStromkennzahl s = KwkStromRechner.Stromkennzahl(_uebA.Stromkennzahl, a?.PelKW, a?.PthKW, BhwTexte.Kultur);
        if (!s.Bestimmbar) return _t.UebGiltKeine;
        var k = BhwTexte.Kultur;
        string wert = s.Wert!.Value.ToString(KwkStromRechner.FORMAT_KENNZAHL, k);
        if (s.Herkunft == KwkStromRechner.HERKUNFT_BERECHNET) return string.Format(_t.UebGiltVorschlag, wert);
        return s.VorschlagWert.HasValue
            ? string.Format(_t.UebGiltEigen, wert, s.VorschlagWert.Value.ToString(KwkStromRechner.FORMAT_KENNZAHL, k))
            : string.Format(_t.UebGiltEigenOhne, wert);
    }

    // ------------------------------------------------ Satztafel

    /// <summary>Der Satzvorschlag mit Anlagenart und Tatbestand des ZWISCHENSTANDS — die
    /// Tafel folgt der Wahl darüber sofort.</summary>
    private KwkgSatzVorschlag UebSatzvorschlag()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        return a is null || _uebA is null ? new KwkgSatzVorschlag() : Vorschlag(a, _uebA);
    }

    /// <summary>Ohne elektrische Nennleistung keine Leistungsstaffel — kein Satz.</summary>
    private bool SatzVorschlagErlaubt => VorschlagEinspErlaubt;

    private string SatzVorschlagText(double satzCt)
        => SatzVorschlagErlaubt
            ? string.Format(_t.UebCtKwh, KwkgSatzHerkunft.Satz(satzCt, BhwTexte.Kultur))
            : "—";

    /// <summary>Spalte „gilt" eines Satzes: Vorschlag, eigener Wert samt Vorschlag, oder
    /// ohne Vorschlag der eigene Wert bzw. keiner.</summary>
    private string SatzGilt(double? eigen, double vorschlag)
    {
        var k = BhwTexte.Kultur;
        if (!eigen.HasValue)
            return SatzVorschlagErlaubt
                ? string.Format(_t.UebGiltVorschlag, KwkgSatzHerkunft.Satz(vorschlag, k))
                : _t.UebGiltOhne;
        string w = KwkgSatzHerkunft.Satz(eigen.Value, k);
        return SatzVorschlagErlaubt
            ? string.Format(_t.UebGiltEigen, w, KwkgSatzHerkunft.Satz(vorschlag, k))
            : string.Format(_t.UebGiltEigenOhne, w);
    }

    private void UebEinsp(double? w) => _uebEinsp = w;
    private void UebEigen(double? w) => _uebEigen = w;
    private void UebKontingent(double? w) => _uebKontingent = w;
    private void UebDeckel(double? w) => _uebDeckel = w;

    private void UebEinspVorschlag()
    {
        if (SatzVorschlagErlaubt) _uebEinsp = null;
    }

    private void UebEigenVorschlag()
    {
        if (SatzVorschlagErlaubt) _uebEigen = null;
    }

    private void UebKontingentVorschlag()
    {
        if (KontingentVorschlagErlaubt) _uebKontingent = null;
    }

    /// <summary>Beim Deckel gibt es immer einen Vorschlag: die Staffel des § 8 Abs. 4.</summary>
    private void UebDeckelVorschlag() => _uebDeckel = null;

    /// <summary>Der Kontingentvorschlag aus Anlagenart und Kostenanteil des Zwischenstands.</summary>
    private KwkgKontingentVorschlag UebKontingentvorschlag()
        => _uebA is null ? new KwkgKontingentVorschlag { Unvollstaendig = true } : Kontingentvorschlag(_uebA);

    private bool KontingentVorschlagErlaubt => !UebKontingentvorschlag().Unvollstaendig;

    private string KontingentVorschlagText()
    {
        KwkgKontingentVorschlag v = UebKontingentvorschlag();
        return v.Unvollstaendig ? "—" : string.Format(_t.UebVbh, v.KontingentH.ToString("N0", BhwTexte.Kultur));
    }

    private string KontingentGilt()
    {
        var k = BhwTexte.Kultur;
        KwkgKontingentVorschlag v = UebKontingentvorschlag();
        string vorschlag = v.KontingentH.ToString("N0", k);
        if (!_uebKontingent.HasValue)
            return v.Unvollstaendig ? _t.UebGiltOhne : string.Format(_t.UebGiltVorschlag, vorschlag);
        string w = _uebKontingent.Value.ToString("N0", k);
        return v.Unvollstaendig ? string.Format(_t.UebGiltEigenOhne, w)
                                : string.Format(_t.UebGiltEigen, w, vorschlag);
    }

    private string DeckelHerkunft()
    {
