<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>

    <RootNamespace>WindowsFormsApplication1</RootNamespace>
    <AssemblyName>WindowsFormsApplication1</AssemblyName>

    <!-- DPI-Awareness wird ausschließlich über app.manifest gesetzt
         (dpiAwareness=PerMonitorV2). Nicht zusätzlich ApplicationHighDpiMode,
         sonst gibt es WFAC010. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- AssemblyInfo.cs liefert die Attribute selbst -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- WICHTIG: x86, weil Microsoft.ACE.OLEDB.12.0 bitness-gebunden ist -->
    <PlatformTarget>x86</PlatformTarget>
    <Platforms>x86;x64;AnyCPU</Platforms>

    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>

    <!-- Tolerant gegenüber Legacy-Warnungen:
         CA1416  - WinForms-APIs nur unter Windows (wir TARGETEN net8.0-windows, also irrelevant)
         MSB3568 - doppelte Ressourcennamen aus historischem WinForms-Designer (ignoriert, harmlos)
         CS1701/1702/NU1701 - Mixed-Framework-Hinweise
         NETSDK1206 - RID-Hinweise -->
    <NoWarn>$(NoWarn);CA1416;MSB3568;CS1701;CS1702;NU1701;MSB3277;NETSDK1206;WFAC010</NoWarn>

    <!-- Satellitenkulturen (de-DE/en-US) wie zuvor -->
    <SatelliteResourceLanguages>de-DE;en-US</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Plattform-spezifische Konfigurationen -->
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'AnyCPU'">
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <!-- Dateien auf der Platte, die nie ins alte Projekt aufgenommen waren -->
  <ItemGroup>
    <Compile Remove="Allgemein\GrafikTools\ChartManagerNeu.cs" />
    <Compile Remove="Controller\WPTestCtrl.cs" />
    <Compile Remove="Views\Simulation\Form_Simulation_Detail - Kopie.cs" />
    <Compile Remove="Views\Simulation\Form_Simulation_Detail.Designer - Kopie.cs" />
    <Compile Remove="Views\Simulation\Form_Simulation_Kurz.cs" />
    <Compile Remove="Views\Simulation\Form_Simulation_Kurz.Designer.cs" />
    <EmbeddedResource Remove="Views\Simulation\Form_Simulation_Detail - Kopie.resx" />
    <EmbeddedResource Remove="Views\Simulation\Form_Simulation_Detail.de-DE - Kopie.resx" />
    <EmbeddedResource Remove="Views\Simulation\Form_Simulation_Detail.en-US - Kopie.resx" />
    <EmbeddedResource Remove="Views\Simulation\Form_Simulation_Kurz.de-DE.resx" />
    <EmbeddedResource Remove="Views\Simulation\Form_Simulation_Kurz.en-US.resx" />
    <EmbeddedResource Remove="Views\Simulation\Form_Simulation_Kurz.resx" />
  </ItemGroup>

  <!-- NuGet-Pakete -->
  <ItemGroup>
    <!-- Chart-Ersatz: Port mit identischem Namespace System.Windows.Forms.DataVisualization.Charting -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="WinForms.DataVisualization" Version="1.10.2" />

    <!-- Berichtsmodul Phase 4: Excel-Ausgabe ohne Office (MIT-Lizenz).
         SixLabors.Fonts bewusst auf 1.0.x gepinnt — ab 2.x gilt die Six Labors
         Split License (Release-Checkliste: dotnet list package - -include-transitive). -->
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />

    <!-- Datenzugriff (Access via ACE OLEDB / ODBC) -->
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <PackageReference Include="System.Data.Odbc" Version="8.0.1" />

    <!-- Konfiguration / Settings -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageReference Include="System.Management" Version="8.0.0" />

    <!-- Lizenzverwaltung: Ed25519-Signaturprüfung + DPAPI-Ablage -->
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <!-- Originalbestand -->
    <PackageReference Include="Humanizer.Core" Version="2.14.1" />
    <PackageReference Include="JsonSchema.Net" Version="7.3.4" />
    <PackageReference Include="JsonSchema.Net.Generation" Version="5.0.4" />
    <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
    <PackageReference Include="Mscc.GenerativeAI" Version="3.1.0" />
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.57" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.HarfBuzz" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.Views.WindowsForms" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="8.3.1.1" />

    <!-- Microsoft.Extensions.* (Mscc.GenerativeAI 3.1 fordert >= 10.0.3) -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3" />
  </ItemGroup>

  <!-- COM-Interop-Server (sibling .NET-Framework EXE) -->

  <!-- COM-Referenzen (Office Excel Interop, VBIDE) -->
  <ItemGroup>
    <COMReference Include="Microsoft.Office.Interop.Excel">
      <Guid>{00020813-0000-0000-C000-000000000046}</Guid>
      <VersionMajor>1</VersionMajor>
      <VersionMinor>7</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>primary</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
    <COMReference Include="VBIDE">
      <Guid>{0002E157-0000-0000-C000-000000000046}</Guid>
      <VersionMajor>5</VersionMajor>
      <VersionMinor>3</VersionMinor>
      <Lcid>0</Lcid>
      <WrapperTool>primary</WrapperTool>
      <Isolated>False</Isolated>
      <EmbedInteropTypes>True</EmbedInteropTypes>
    </COMReference>
  </ItemGroup>

  <!-- Settings (klassisches Properties\Settings.settings) -->
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <Compile Update="Properties\Settings.Designer.cs">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>

  <!-- Resources-Generator-Verknüpfungen -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <!-- Nur die NEUTRALE Datei trägt den Code-Generator. Er läuft ausschließlich zur
         Entwurfszeit in Visual Studio, nicht im Build; MyResource\Resource.Designer.cs ist
         daher eingecheckter Quelltext und muss beim Ergänzen von Schlüsseln mitgepflegt werden
         (Paket 9 / L2). Satellitendateien dürfen KEINEN Generator haben — die frühere
         Verknüpfung auf die 0-Byte-Datei Resource.en-US.Designer.cs war ein Altbestand und
         wurde mit Paket 9 / L1 entfernt. -->
    <EmbeddedResource Update="MyResource\Resource.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>Resource.Designer.cs</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <!-- ClickOnce-Signaturdatei nicht kompilieren -->
  <ItemGroup>
    <None Include="WindowsFormsApplication1_TemporaryKey.pfx" />
  </ItemGroup>

  <!-- Berichtsmodul: Word-Rahmenvorlage in den Ausgabeordner kopieren
       (WordBerichtGenerator.FindeVorlage sucht unter Vorlagen\Berichtsvorlage.docx) -->
  <ItemGroup>
    <None Update="Allgemein\Bericht\Vorlagen\Berichtsvorlage.docx">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Vorlagen\Berichtsvorlage.docx</Link>
      <TargetPath>Vorlagen\Berichtsvorlage.docx</TargetPath>
    </None>
  </ItemGroup>

</Project>
