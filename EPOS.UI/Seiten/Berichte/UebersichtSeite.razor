    /// <summary>Die Gewerke, die die Tabelle zeigt — mit „nur Unterschiede" allein die abweichenden.</summary>
    private IReadOnlyList<GewerkVergleichZeile> SichtbareGewerke
    {
        get
        {
            if (!NurUnterschiede) return _stand.Gewerke;
            var liste = new List<GewerkVergleichZeile>();
            foreach (GewerkVergleichZeile g in _stand.Gewerke)
                if (g.WeichtAb) liste.Add(g);
            return liste;
        }
    }

    private void BeiNurUnterschiede(bool an)
    {
        _nurUnterschiede = an;
        NurUnterschiedeGewechselt?.Invoke(an);
    }

