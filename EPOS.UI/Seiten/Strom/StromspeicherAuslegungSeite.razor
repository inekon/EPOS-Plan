    /// <summary>
    /// Etwas wurde geschrieben. <b>Der Zeichenlauf steht hier ausdrücklich</b>: Die
    /// Blätter melden über gewöhnliche <c>Func</c>-Delegaten zurück, nicht über
    /// <c>EventCallback</c> — und dann zeichnet Blazor den Wirt NICHT von selbst neu.
    /// Ohne ihn bliebe ein alter Fehlertext stehen, und der Auslegungseditor bekäme
    /// seinen aufgefrischten Stand nie zu sehen.
    /// </summary>
    private void Geaendert()
    {
        _fehler = "";
        _meldung = "";
        _ungespeichert = true;
        if (ErgebnisDa) _veraltet = true;
        Vorpruefen();
        StateHasChanged();
    }

    private void FlotteGeaendert(FlottenStudieKonfiguration f)
    {
        Auslegung.Flotte = SpeicherAuslegungKopie.Von(f);
        Geaendert();
    }

    private void EingabenGeaendert(SpeicherOptimierungEingaben e)
    {
        _eingaben = e.Kopie();
        Geaendert();
    }

    /// <summary>
    /// Der Betriebseditor hat geschrieben. <b>Wechselt das BETRIEBSZIEL, wechselt die
    /// Vorgabe „Netzladung erlaubt" mit</b> (Anwenderentscheid SD‑Q5): Die
    /// Lastspitzenkappung braucht sie (Spezifikation 5.1: „Die Wiederaufladung nutzt
    /// freie Anschlussleistung unter H"), der PV-Eigenverbrauch ausdrücklich nicht.
    /// Der Schalter bleibt änderbar, und ein GESPEICHERTER Stand wird nicht angefasst —
    /// die Vorgabe greift nur bei einer Änderung im Feld.
    /// </summary>
    private void BetriebsoptionenGeaendert(FlottenSimulationOptionen optionen)
    {
        FlottenBetriebsziel vorher = Flotte.Optionen.Betriebsziel;
        bool ratscheVorher = Flotte.Optionen.PeakZielAdaptiv;
        Flotte.Optionen = SpeicherAuslegungKopie.Von(optionen);
        if (Flotte.Optionen.Betriebsziel != vorher)
        {
            Flotte.Optionen.NetzladungErlaubt = FlottenVorgaben.NetzladungFuer(Flotte.Optionen.Betriebsziel);
            // Dieselbe Vorgabe wie beim Anlegen (PS-Q1, #215): Die Ratsche ist die
            // Vorgabe der zwei Ziele MIT Peak-Ziel. Die Erklaerzeile des Editors sagt,
            // was der Wechsel bedeutet — still ist er nicht.
            Flotte.Optionen.PeakZielAdaptiv = FlottenVorgaben.PeakZielAdaptivFuer(Flotte.Optionen.Betriebsziel);
        }
        // WIRD DIE RATSCHE EINGESCHALTET, ist die Zahl im Feld nicht mehr das Ziel des
        // Zeitraums, sondern der STARTWERT — und der ist die Grundlast
        // (Spezifikation 5.1.1). Nur beim Einschalten, nie beim Ausschalten und nie an
        // einem Stand, den niemand angefasst hat.
        if (!ratscheVorher && Flotte.Optionen.PeakZielAdaptiv && _peakVorschlag is { AusReihe: true })
            Flotte.Optionen.WirtschaftlicherPeakZielwertKw = _peakVorschlag.TagesminimumMaxKw;
        Geaendert();
        PeakVorschlagHolen();
    }

    private void SuchlaufSetzen(bool wert)
    {
        Auslegung.FlottenGroessenOptimieren = wert;
        Geaendert();
    }

