@* "Variante anlegen" - der kleine Dialog der Gruppe "Variante verwalten" auf der Seite
   "Uebersicht" des Reiters "Berichte & Kosten" (Anwenderauftrag 13.10.2026).

   ZWEI FELDER. Die QUELLE - das Stammprojekt (Vorgabe) oder eine vorhandene Variante der
   Gruppe - gibt den INHALT; der BEZEICHNER gibt den Namen. Gruppe und Projektname
   "<Stamm> - <Bezeichner>" kommen immer vom Stamm, auch wenn die Quelle eine Variante ist
   (VariantenCtrl.AnlegenAusQuelle) - eine Variante haengt nie an einer anderen Variante.

   DER ZIELNAME KOMMT AUS DEM KERN: Der Delegat Zielname fragt VariantenCtrl.Zielname; der
   Dialog setzt ihn nicht selbst zusammen (dieselbe Regel wie im ProjektVarianteDialog,
   dessen Kaestchen mit der ganzen Projektliste fuer Kopfband und Menue unveraendert bleibt).

   DER WIRT SCHREIBT (Hausregel: geschrieben wird im OK-Weg): Der Dialog meldet seine Wahl;
   scheitert das Anlegen, reicht der Wirt die Meldung als Parameter herein, und der Dialog
   bleibt mit ihr offen. Keine Datenbank hier (Hausregel EPOS.UI).

   TASTATUR: Enter bestaetigt, solange der Knopf frei ist; Esc bricht ab. *@

@namespace EPOS.UI.Dialoge.Berichte
@using EPOS.UI.Bausteine
@using EPOS.UI.Seiten.Berichte

<div class="epos-dialog epos-variantendialog" tabindex="-1" @ref="_wurzel" @onkeydown="BeiTaste">

    @* Ein Titel, eine Stelle: eingebettet in der Ueberlagerung traegt DIE den Titel und das
       Kreuz (TitelText=""); dann bleiben beide hier aus. *@
    <div class="epos-dialog-kopf @(string.IsNullOrEmpty(TitelText) ? "epos-dialog-kopf--ohnetitel" : "")">
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <h1 class="epos-dialog-titel">@TitelText</h1>
        }
        @if (!string.IsNullOrEmpty(HilfeSchluessel))
        {
            <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@TitelText" />
        }
        @if (!string.IsNullOrEmpty(TitelText))
        {
            <Schliesskreuz Geschlossen="@(() => BeiErgebnis(false))" />
        }
    </div>

    @if (!string.IsNullOrEmpty(HinweisText))
    {
        <Herleitungszeile Text="@HinweisText" />
    }

    <Auswahlfeld Bezeichnung="@LabelQuelle" Eintraege="@Quellen"
                 Auswahl="@_quelleId" AuswahlChanged="BeiQuelle" />

    <Textfeld Bezeichnung="@LabelBezeichner" Wert="@_bezeichner" WertChanged="BeiBezeichner" />

    @if (!string.IsNullOrEmpty(Zielzeile))
    {
        <Herleitungszeile Text="@Zielzeile" />
    }

    @if (!string.IsNullOrEmpty(Meldung))
    {
        <Warnbanner Stufe="WarnStufe.Warnung" Text="@Meldung" />
    }

    <SpeichernLeiste OkText="@OkText" AbbrechenText="@AbbrechenText"
                     OkErlaubt="@OkErlaubt" Ergebnis="BeiErgebnis" />
</div>

@code {
    /// <summary>Kopfzeile (<c>BK_BTN_ANLEGEN</c>); leer = die Überlagerung trägt den Titel.</summary>
    [Parameter] public string TitelText { get; set; } = "Variante anlegen";

    /// <summary>
    /// Die wählbaren Quellen der Gruppe: das Stammprojekt zuerst, dann die Varianten
    /// (Id = <c>Tab_Projekt.ID</c>, Text fertig beschriftet).
    /// </summary>
    [Parameter] public IReadOnlyList<(int Id, string Text)> Quellen { get; set; } = Array.Empty<(int, string)>();

    /// <summary>Die vorbelegte Quelle; <c>null</c> = der erste Eintrag (das Stammprojekt).</summary>
    [Parameter] public int? VorgabeQuelle { get; set; }

    /// <summary>
    /// Der Zielname zu einem Bezeichner — <c>VariantenCtrl.Zielname</c>. Ohne den
    /// Delegaten bleibt die Vorschauzeile leer (Prüfstand).
    /// </summary>
    [Parameter] public Func<string, string>? Zielname { get; set; }

    /// <summary>
    /// Die Meldung eines gescheiterten Anlegens, die der Wirt hereinreicht; der Dialog
    /// zeigt sie und bleibt offen. Leer = keine.
    /// </summary>
    [Parameter] public string Meldung { get; set; } = "";

    /// <summary>Die Antwort: Quelle und Bezeichner, oder <c>null</c> bei Abbruch.</summary>
    [Parameter] public EventCallback<VarianteAnlegenWahl?> Geschlossen { get; set; }

    /// <summary>Der Satz über den Feldern (<c>BK_DLG_ANLEGEN_HINWEIS</c>, fertig gefüllt); leer = keiner.</summary>
    [Parameter] public string HinweisText { get; set; } = "";

    /// <summary>Beschriftung der Quellenwahl (<c>BK_UEB_LBL_QUELLE</c>).</summary>
    [Parameter] public string LabelQuelle { get; set; } = "Quelle:";

    /// <summary>Beschriftung des Bezeichnerfeldes (<c>BK_LBL_BEZEICHNER</c>).</summary>
    [Parameter] public string LabelBezeichner { get; set; } = "Bezeichner:";

    /// <summary>Die Vorschauzeile (<c>VAR_DLG_ZIELNAME</c>); <c>{0}</c> = Zielname.</summary>
    [Parameter] public string ZielnameFormat { get; set; } = "Neuer Projektname: {0}";

    /// <summary>Beschriftung des Anlegeknopfes (<c>BK_BTN_ANLEGEN</c>).</summary>
    [Parameter] public string OkText { get; set; } = "Variante anlegen";

    [Parameter] public string AbbrechenText { get; set; } = "Abbrechen";

    /// <summary>Schlüssel des Hilfeknopfes; leer = kein Knopf.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "";

    private ElementReference _wurzel;
    private bool _ersterAufbau = true;

    private int? _quelleId;
    private string _bezeichner = "";

    /// <summary>Die gewählte Quelle, 0 = keine (Prüfhilfe).</summary>
    public int QuelleId => _quelleId ?? 0;

    /// <summary>Der Feldinhalt (Prüfhilfe).</summary>
    public string Bezeichner => _bezeichner;

    /// <summary>Ist „Variante anlegen" gerade anklickbar? Quelle gewählt und Bezeichner vorhanden.</summary>
    public bool OkErlaubt => QuelleId > 0 && !string.IsNullOrWhiteSpace(_bezeichner);

    /// <summary>Die Vorschauzeile; leer, solange kein Bezeichner dasteht.</summary>
    public string Zielzeile
    {
        get
        {
            string b = (_bezeichner ?? "").Trim();
            if (b.Length == 0 || Zielname is null) return "";
            string ziel;
            try { ziel = Zielname(b) ?? ""; }
            catch { ziel = ""; }
            return ziel.Length == 0 ? "" : string.Format(ZielnameFormat, ziel);
        }
    }

    protected override void OnParametersSet()
    {
        // Die Vorgabe greift einmal - danach gehoert die Wahl dem Anwender, auch wenn der
        // Wirt eine Meldung hereinreicht und der Dialog neu zeichnet.
        if (_quelleId is null)
            _quelleId = VorgabeQuelle ?? (Quellen.Count > 0 ? Quellen[0].Id : null);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync(preventScroll: true);
    }

    private void BeiQuelle(int? id) => _quelleId = id;

    private void BeiBezeichner(string wert) => _bezeichner = wert ?? "";

    private async Task BeiErgebnis(bool ok)
    {
        if (!ok) { await Geschlossen.InvokeAsync(null); return; }
        if (!OkErlaubt) return;
        await Geschlossen.InvokeAsync(new VarianteAnlegenWahl(QuelleId, _bezeichner.Trim()));
    }

    private Task BeiTaste(KeyboardEventArgs e) => e.Key switch
    {
        "Enter" => OkErlaubt ? BeiErgebnis(true) : Task.CompletedTask,
        "Escape" => BeiErgebnis(false),
        _ => Task.CompletedTask
    };
}
