@* Der Abschnitt "Ergebnisse — Energie" der Seite "Uebersicht" (Anwenderauftrag 13.10.2026).

   WAS ER ZEIGT. Die Energie-Kennzahlen von Stamm und Varianten nebeneinander -
   dieselben Versionen und dieselbe Reihenfolge wie die Gegenueberstellung der
   Komponenten (Stamm und die Varianten "Im Vergleich"), im Spaltenkopf der
   Simulationsstand. Die Zeilen sind gruppiert (Bedarf, Waermeerzeugung, Strom,
   Endenergie, Deckung, Kaelte, Effizienz, Gebaeude), die Einheit steht im
   Zeilenkopf. Was vom Stamm abweicht, ist hinterlegt wie in der
   Komponententabelle, darunter leise die Abweichung in Prozent. Kosten gehoeren
   nicht hierher, sie stehen in der Wirtschaftlichkeit.

   WOHER. Die Zahlen und die Entscheidung "weicht ab" kommen fertig aus dem Kern
   (Energievergleich, aus dem KennzahlenKatalog des Berichts, ueber die Huelle
   UebersichtErgebnisGaben). Die Komponente zeigt nur; sie laedt neu, sobald die
   Seite einen neuen Stand reicht (Stammwahl, Vergleichswahl, Simulation).

   EMISSIONEN ALS OPTION. Die Gruppe "Emissionen" (CO2 wie im Katalog) steht unter der
   Tafel als Klappgruppe des Hauses (Baustein Klappgruppe), beim Oeffnen zugeklappt; ihr
   Kopf nennt die Zahl der Kennzahlen und zeigt eine Abweichung an. Die Stellung haelt die
   Huelle je Sitzung. "nur Unterschiede" der Seite blendet Gruppen ohne Abweichung aus.

   LEERE FAELLE. Eine nicht simulierte Version zeigt "—" mit Kurztext; ist keine
   Version simuliert, steht ein Hinweis statt der Tabelle. Ohne Gaben zeichnet
   der Abschnitt nichts. *@

@if (_ergebnis is not null && _ergebnis.Versionsspalten.Count > 0)
{
    <section class="epos-uebersicht-ergebnisse" aria-label="@Titel">
        <h2 class="epos-uebersicht-abschnitt">@Titel</h2>
        @if (_ergebnis.KeineSimulation || _ergebnis.Gruppen.Count == 0)
        {
            <p class="epos-komponenten-leer epos-ergebnis-leer">@KeineSimulationText</p>
        }
        else
        {
            <div class="epos-komponenten-werkzeug">
                <span class="epos-komponenten-legende">
                    <span class="epos-komponenten-legende-marke" aria-hidden="true"></span>@LegendeAbweichung; @LegendeProzent
                </span>
            </div>
            @if (Tafelgruppen.Count == 0 && Klappgruppen.Count == 0)
            {
                <p class="epos-komponenten-leer epos-ergebnis-gleich">@KeineUnterschiedeText</p>
            }
            @if (Tafelgruppen.Count > 0)
            {
                @Tafel(Tafelgruppen, true)
            }
            @foreach (ErgebnisVergleichGruppe g in Klappgruppen)
            {
                @* Die Emissionen als Option (Anwenderwunsch 13.10.2026): die Klappgruppe des Hauses,
                   beim Oeffnen zugeklappt, im Kopf die Zahl der Kennzahlen und der Hinweis auf eine
                   Abweichung; die Stellung gilt je Sitzung (Huelle). *@
                <Klappgruppe Titel="@g.Titel" Zusatz="@Anzahl(g.Zeilen.Count)" Ebene="3"
                             Klasse="epos-ergebnis-klappgruppe"
                             Offen="@EmissionenOffen" OffenChanged="BeiEmissionen">
                    <Kopfhandlungen>
                        @if (g.WeichtAb)
                        {
                            <span class="epos-ergebnis-klapphinweis" title="@WeichtAbText">
                                <span class="epos-komponenten-gewerkmarke" aria-hidden="true">●</span>@WeichtAbText
                            </span>
                        }
                    </Kopfhandlungen>
                    <ChildContent>
                        @Tafel(new[] { g }, false)
                    </ChildContent>
                </Klappgruppe>
            }
            <p class="epos-leisezeile epos-ergebnis-quelle">@HinweisQuelle</p>
        }
    </section>
}

@code {
    /// <summary>Der Stand der Seite (Gruppe, Vergleichswahl, Stamm); ein neuer Stand lädt den Abschnitt neu.</summary>
    [Parameter] public UebersichtStand? Stand { get; set; }

    /// <summary>Baut aus dem Stand der Seite den Energievergleich (Hülle <c>UebersichtErgebnisGaben</c>).</summary>
    [Parameter] public Func<UebersichtStand, UebersichtErgebnisStand>? Laden { get; set; }

    /// <summary>Die Abschnittsüberschrift (<c>BK_ERG_ABSCHNITT_ERGEBNISSE</c>).</summary>
    [Parameter] public string Titel { get; set; } = "Ergebnisse — Energie";

    /// <summary>Der Kopf der ersten Spalte (<c>BK_ERG_SP_KENNZAHL</c>).</summary>
    [Parameter] public string SpalteKennzahl { get; set; } = "Kennzahl";

    /// <summary>Die Legende der Markierung (<c>BK_LBL_LEGENDE_ABWEICHUNG</c>).</summary>
    [Parameter] public string LegendeAbweichung { get; set; } = "markiert: weicht vom Stammprojekt ab";

    /// <summary>Der Zusatz zur Prozentangabe (<c>BK_ERG_LEGENDE_PROZENT</c>).</summary>
    [Parameter] public string LegendeProzent { get; set; } = "darunter die Abweichung zum Stammprojekt in Prozent";

    /// <summary>Die leise Zeile unter der Tabelle (<c>BK_ERG_HINWEIS_QUELLE</c>).</summary>
    [Parameter] public string HinweisQuelle { get; set; } =
        "Werte aus dem letzten gespeicherten Simulationslauf je Version. Kosten stehen unter Wirtschaftlichkeit.";

    /// <summary>Der Hinweis, wenn keine Version simuliert ist (<c>BK_ERG_KEINE_SIMULATION</c>).</summary>
    [Parameter] public string KeineSimulationText { get; set; } =
        "Für keine Version im Vergleich liegt ein Simulationsergebnis vor. Starten Sie die Simulation, um die Energie-Ergebnisse gegenüberzustellen.";

    /// <summary>Der Kurztext einer nicht simulierten Zelle (<c>BK_LBL_NICHT_SIMULIERT</c>).</summary>
    [Parameter] public string NichtSimuliertText { get; set; } = "nicht simuliert";

    /// <summary>Der Text der Sprachausgabe an einer abweichenden Zelle (<c>BK_LBL_WEICHT_AB</c>).</summary>
    [Parameter] public string WeichtAbText { get; set; } = "weicht vom Stammprojekt ab";

    /// <summary>Ein Wert unter „nur Unterschiede“ der Seite: Gruppen ohne Abweichung entfallen.</summary>
    [Parameter] public bool NurUnterschiede { get; set; }

    /// <summary>Der Hinweis, wenn „nur Unterschiede“ alles ausblendet (<c>BK_ERG_KEINE_UNTERSCHIEDE</c>).</summary>
    [Parameter] public string KeineUnterschiedeText { get; set; } =
        "Keine Version im Vergleich weicht in den Energie-Ergebnissen vom Stammprojekt ab.";

    /// <summary>Die Zahl im Kopf der Klappgruppe (<c>BK_ERG_ANZAHL_KENNZAHLEN</c>).</summary>
    [Parameter] public string AnzahlFormat { get; set; } = "{0} Kennzahlen";

    /// <summary>Die Einzahl im Kopf der Klappgruppe (<c>BK_ERG_ANZAHL_KENNZAHL_EINS</c>).</summary>
    [Parameter] public string AnzahlEins { get; set; } = "1 Kennzahl";

    /// <summary>Liest die Stellung der Klappgruppe „Emissionen“ aus der Merkablage der Hülle (je Sitzung).</summary>
    [Parameter] public Func<bool>? EmissionenOffenLesen { get; set; }

    /// <summary>Meldet die neue Stellung der Klappgruppe an die Hülle.</summary>
    [Parameter] public Action<bool>? EmissionenOffenGewechselt { get; set; }

    /// <summary>Die Stellung, solange die Hülle sie nicht führt.</summary>
    private bool _emissionenOffen;

    /// <summary>Steht die Klappgruppe „Emissionen“ offen? (auch Prüfhilfe)</summary>
    public bool EmissionenOffen => EmissionenOffenLesen?.Invoke() ?? _emissionenOffen;

    private void BeiEmissionen(bool an)
    {
        _emissionenOffen = an;
        EmissionenOffenGewechselt?.Invoke(an);
    }

    private string Anzahl(int n) => n == 1 ? AnzahlEins : string.Format(AnzahlFormat, n);

    private bool Sichtbar(ErgebnisVergleichGruppe g) => !NurUnterschiede || g.WeichtAb;

    /// <summary>Die Gruppen der Tafel (ohne die Klappgruppen), unter „nur Unterschiede“ nur die abweichenden.</summary>
    private IReadOnlyList<ErgebnisVergleichGruppe> Tafelgruppen
        => _ergebnis?.Gruppen.Where(g => !g.Klappbar && Sichtbar(g)).ToList() ?? new List<ErgebnisVergleichGruppe>();

    /// <summary>Die Klappgruppen unter der Tafel (die Emissionen).</summary>
    private IReadOnlyList<ErgebnisVergleichGruppe> Klappgruppen
        => _ergebnis?.Gruppen.Where(g => g.Klappbar && Sichtbar(g)).ToList() ?? new List<ErgebnisVergleichGruppe>();

    /// <summary>Die Tafel über die Gruppen; mit Gruppenkopf je Gruppe oder (in der Klappgruppe) ohne.</summary>
    private RenderFragment Tafel(IEnumerable<ErgebnisVergleichGruppe> gruppen, bool mitGruppenkopf) => __builder =>
    {
        <div class="epos-raster-huelle epos-raster-huelle--vergleich epos-komponenten-huelle epos-ergebnis-huelle">
            <table class="epos-raster epos-uebersicht-tabelle epos-komponentenvergleich epos-ergebnisvergleich">
                <thead>
                    <tr>
                        <th scope="col" class="epos-komponenten-gewerk">@SpalteKennzahl</th>
                        @foreach (VersionsSpalte v in _ergebnis!.Versionsspalten)
                        {
                            <th scope="col" class="epos-komponenten-versionkopf">
                                <span class="epos-komponenten-version">@v.Name</span>
                                @if (!string.IsNullOrEmpty(v.Stand))
                                {
                                    <span class="epos-komponenten-stand">@v.Stand</span>
                                }
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (ErgebnisVergleichGruppe g in gruppen)
                    {
                        @if (mitGruppenkopf)
                        {
                            <tr class="epos-ergebnis-gruppe">
                                <th scope="rowgroup" class="epos-komponenten-gewerk">@g.Titel</th>
                                @for (int i = 0; i < _ergebnis.Versionsspalten.Count; i++)
                                {
                                    <td></td>
                                }
                            </tr>
                        }
                        @foreach (ErgebnisVergleichZeile z in g.Zeilen)
                        {
                            <tr>
                                <th scope="row" class="epos-komponenten-gewerk epos-ergebnis-kennzahl">@z.Bezeichnung</th>
                                @foreach (ErgebnisVergleichZelle c in z.Zellen)
                                {
                                    <td class="@ZellKlasse(c)" title="@(c.NichtSimuliert ? NichtSimuliertText : null)">
                                        <span class="epos-ergebnis-wert">@c.Text</span>
                                        @if (!string.IsNullOrEmpty(c.Abweichung))
                                        {
                                            <span class="epos-ergebnis-prozent">@c.Abweichung</span>
                                        }
                                        @if (c.WeichtAb)
                                        {
                                            <span class="epos-komponenten-sprachausgabe">@WeichtAbText</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    };

    private UebersichtErgebnisStand? _ergebnis;
    private UebersichtStand? _geladenFuer;
    private Func<UebersichtStand, UebersichtErgebnisStand>? _geladenMit;

    /// <summary>Der gezeigte Stand (Prüfhilfe); <c>null</c> ohne Gaben.</summary>
    public UebersichtErgebnisStand? Ergebnis => _ergebnis;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Stand, _geladenFuer) && ReferenceEquals(Laden, _geladenMit)) return;
        _geladenFuer = Stand;
        _geladenMit = Laden;
        _ergebnis = Stand is not null && Laden is not null ? Laden(Stand) : null;
    }

    private static string ZellKlasse(ErgebnisVergleichZelle c)
        => c.WeichtAb ? "epos-zahl epos-komponenten-zelle epos-komponenten-zelle--abweichend" : "epos-zahl epos-komponenten-zelle";

    /// <summary>
    /// Die Tabelle als Text für den Assistenten: je Zeile „Gruppe · Kennzahl: Version = Wert (Abweichung); …“; leer ohne
    /// Tabelle, der Hinweis, wenn keine Version simuliert ist.
    /// </summary>
    public string Text()
    {
        if (_ergebnis is null || _ergebnis.Versionsspalten.Count == 0) return "";
        if (_ergebnis.KeineSimulation || _ergebnis.Gruppen.Count == 0) return KeineSimulationText;
        var zeilen = new List<string>();
        foreach (ErgebnisVergleichGruppe g in _ergebnis.Gruppen)
            foreach (ErgebnisVergleichZeile z in g.Zeilen)
            {
                var teile = new List<string>();
                for (int i = 0; i < z.Zellen.Count; i++)
                {
                    ErgebnisVergleichZelle c = z.Zellen[i];
                    string name = i < _ergebnis.Versionsspalten.Count ? _ergebnis.Versionsspalten[i].Name : "";
                    string wert = c.NichtSimuliert ? NichtSimuliertText : c.Text;
                    teile.Add(name + " = " + wert
                              + (string.IsNullOrEmpty(c.Abweichung) ? "" : " (" + c.Abweichung + ")")
                              + (c.WeichtAb ? " — " + WeichtAbText : ""));
                }
                zeilen.Add(g.Titel + " · " + z.Bezeichnung + ": " + string.Join("; ", teile));
            }
        return string.Join("\n", zeilen);
    }
}
