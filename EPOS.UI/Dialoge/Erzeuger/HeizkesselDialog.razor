    private void BeiTraegerwechsel(int? neu)
    {
        if (_projektZeile is null || !neu.HasValue) return;
        if (neu.Value == _projektZeile.CarrierId) return;   // programmatische Vorwahl

        TraegerWechseln?.Invoke(_projektZeile, neu.Value);
        _projektZeile.CarrierId = neu.Value;
    }

    /// <summary>
    /// Eine Eingabe macht das Paar zu dem des Anwenders — die Zeile „Vorgabe …" bzw. „Aus
    /// dem Kesseldatensatz …" gilt dann nicht mehr und verschwindet.
    /// </summary>
    private void BeiVorlauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Vorlauf = wert;
        _projektZeile.TemperaturHerleitung = "";
        Uebernehmen?.Invoke(_projektZeile);
    }

    private void BeiRuecklauf(int? wert)
    {
        if (_projektZeile is null) return;
        _projektZeile.Ruecklauf = wert;
        _projektZeile.TemperaturHerleitung = "";
        Uebernehmen?.Invoke(_projektZeile);
    }

    // =================================================================================
    // Katalogpflege
    // =================================================================================

    /// <summary>
    /// „Bearbeiten…" im Katalogbereich (KA‑E‑8): EIN ungesperrter Satz öffnet den Katalogeditor
    /// (Kennlinie, Speichern unter); mehrere Sätze oder ein gesperrter öffnen die
    /// Satzbearbeitung — gesperrte übersprungen, alle gesperrt nur lesend.
    /// </summary>
    private async Task BeiKatalogBearbeiten()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1 && !ziele[0].Geschuetzt && EditorGaben is not null)
        {
            _editorGaben = EditorGaben(ziele[0].Bezeichner);
            return;
        }
        // UeS1: EIN gesperrter Satz oeffnet nur lesend in der Satz-Ueberlagerung („Erst Schloss aufheben").
        if (ziele.Count == 1 && ziele[0].Geschuetzt && Katalogfelder is not null && _zweispalten is not null)
        {
            if (_katalogZeile?.Bezeichner != ziele[0].Bezeichner) KatalogZeileWaehlen(ziele[0].Bezeichner);
            await _zweispalten.SatzUeberlagerungOeffnen();
            return;
        }
        if (KatalogsatzWege is not null)
        {
            _bearbeitung = (Satzmarke.Katalogsatz,
                            ziele.Select(z => new Bearbeitungssatz(z.Id, z.Bezeichner, z.Geschuetzt)).ToList());
            return;
        }
        if (ziele.All(z => z.Geschuetzt)) BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
    }

    /// <summary>
    /// „Bearbeiten…" im Projektbereich: EINE Projektkopie öffnet die Satz-Überlagerung (UeS1),
    /// mehrere die Satzbearbeitung (je Gerät einmal).
    /// </summary>
    private async Task BeiProjektBearbeiten()
    {
        if (ProjektsatzWege is null) return;
        List<ErzeugerZeile> ziele = ProjektZiele();
        var saetze = ziele.GroupBy(z => z.GeraetId)
            .Select(g => new Bearbeitungssatz(g.Key, g.First().Bezeichner, false)).ToList();
        if (saetze.Count == 0) return;
        if (saetze.Count == 1 && _zweispalten is not null)
        {
            if (_projektZeile?.GeraetId != saetze[0].Id) ProjektZeileWaehlen(ziele.First(z => z.GeraetId == saetze[0].Id));
            await _zweispalten.SatzUeberlagerungOeffnen();
            return;
        }
        _bearbeitung = (Satzmarke.Projektsatz, saetze);
    }

    /// <summary>
    /// UeS2: der Stift einer Projektzeile — sie wird gewählt (ohne die Kästchen der
    /// Mehrfachwahl anzufassen) und ihre Projektkopie öffnet in der Satz-Überlagerung.
    /// </summary>
    private async Task BeiProjektStift(ErzeugerZeile zeile)
    {
        if (ProjektsatzWege is null || _zweispalten is null) return;
        if (_projektZeile != zeile) ProjektZeileWaehlen(zeile);
        await _zweispalten.SatzUeberlagerungOeffnen();
    }

    /// <summary>
    /// UeS2: der Stift einer Katalogzeile (die Katalogliste hat sie schon gewählt) — ein
    /// gesperrter Satz öffnet nur lesend in der Satz-Überlagerung, ein ungesperrter den
    /// Katalogeditor (KA‑E‑13); ohne Editor die Überlagerung.
    /// </summary>
    private async Task BeiKatalogStift(Katalogfilterzeile zeile)
    {
        if (_katalogZeile?.Schluessel != zeile.Schluessel) KatalogZeileWaehlen(zeile.Bezeichner);
        if (!zeile.Geschuetzt && EditorGaben is not null)
        {
            _editorGaben = EditorGaben(zeile.Bezeichner);
            return;
        }
        if (Katalogfelder is not null && _zweispalten is not null)
        {
            await _zweispalten.SatzUeberlagerungOeffnen();
            return;
        }
        if (zeile.Geschuetzt) BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
    }

    // =================================================================================
    // Die Zusammenfassung der Detailzeile (UeS2)
    // =================================================================================

    /// <summary>Die Kostensummen der gewählten Projektzeile — gelesen bei der Wahl und nach der Überlagerung.</summary>
    private (double Invest, double Betrieb)? _kosten;

    private void KostenNachziehen()
    {
        _kosten = null;
        if (Wizard || Kostensumme is null || _projektZeile is null) return;
        try { _kosten = Kostensumme(_projektZeile); }
        catch { _kosten = null; }   // die Zusammenfassung ist Anzeige; ohne Summe fehlt die Angabe
    }

    /// <summary>
    /// <b>Die Kurzangaben des gewählten Satzes</b> für die Detailzeile. Projektsatz: Leistung,
    /// Brennstoff, Träger, Vorlauf/Rücklauf, Brennwert, Invest, Betrieb, Senken. Katalogsatz: die
    /// Spalten des Katalogprofils (Hersteller, Brennstoff, Leistung, η, Brennwert). Ohne Satz eine
    /// leere Liste — nie <c>null</c>, sonst zeichnete der Baustein das Fragment in der Detailzeile.
    /// </summary>
    internal IReadOnlyList<Satzangabe> Zusammenfassung()
    {
        var liste = new List<Satzangabe>();
        CultureInfo k = CultureInfo.CurrentCulture;
        if (_projektZeile is ErzeugerZeile p)
        {
            string? leistung = _detail.Felder.Where(f => f.Feld != LabelBrennstofftyp && ErzeugerDetail.IstZahl(f.Wert))
                                             .Select(f => f.Wert).FirstOrDefault();
            if (leistung is not null) liste.Add(new(Resource.AUSWAHL_ZF_LEISTUNG, leistung + " kWth"));
            string? brennstoff = _detail.Felder.Where(f => f.Feld == LabelBrennstofftyp).Select(f => f.Wert).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(brennstoff)) liste.Add(new(Resource.AUSWAHL_ZF_BRENNSTOFF, brennstoff));
            string traeger = _varianten.Where(v => v.Id == p.CarrierId).Select(v => v.Text).FirstOrDefault() ?? "";
            if (traeger.Length > 0) liste.Add(new(Resource.AUSWAHL_ZF_TRAEGER, traeger));
            if (p.Vorlauf is not null || p.Ruecklauf is not null)
                liste.Add(new(Resource.AUSWAHL_ZF_VORLAUF_RUECKLAUF,
                              (p.Vorlauf?.ToString(k) ?? ParameterVerwendung.LEER) + "/" +
                              (p.Ruecklauf?.ToString(k) ?? ParameterVerwendung.LEER) + " °C"));
            if (_detail.Schalter is { } brennwert)
                liste.Add(new(Resource.AUSWAHL_ZF_BRENNWERT, brennwert.Wert ? Resource.ALLG_BTN_JA : Resource.ALLG_BTN_NEIN));
            if (_kosten is { } kosten)
            {
                liste.Add(new(Resource.AUSWAHL_ZF_INVEST, string.Format(k, Resource.AUSWAHL_ZF_EURO, kosten.Invest)));
                liste.Add(new(Resource.AUSWAHL_ZF_BETRIEB, string.Format(k, Resource.AUSWAHL_ZF_EURO_JAHR, kosten.Betrieb)));
            }
            string senken = Senkenwert(p.Senken);
            if (senken.Length > 0) liste.Add(new(Resource.AUSWAHL_ZF_SENKEN, senken));
        }
        else if (_katalogZeile is Katalogfilterzeile z && Katalogprofil is not null)
        {
            foreach (Katalogspalte spalte in Katalogprofil.Spalten)
            {
                if (spalte.Schluessel is Katalogfilterprofil.SpBezeichner or Katalogfilterprofil.SpVerwendet) continue;
                string wert = z.Text(spalte.Schluessel);
                if (string.IsNullOrWhiteSpace(wert) || wert == ParameterVerwendung.LEER) continue;
                liste.Add(new(spalte.Titel, spalte.Einheit.Length > 0 ? wert + " " + spalte.Einheit : wert));
            }
        }
        return liste;
    }

    /// <summary>Die Senkenzeile ohne ihr Präfix „Senken: " (<c>ANL_SENKEN_ZEILE</c>).</summary>
    private static string Senkenwert(string zeile)
    {
        if (string.IsNullOrWhiteSpace(zeile)) return "";
        string praefix = Resource.ANL_SENKEN_ZEILE.Split("{0}")[0];
        return praefix.Length > 0 && zeile.StartsWith(praefix, StringComparison.Ordinal) ? zeile[praefix.Length..].Trim() : zeile.Trim();
    }

    /// <summary>Die Satzbearbeitung ist zu; gespeichert: Listen, Detail und Summe neu.</summary>
    private void BearbeitungFertig(bool gespeichert)
    {
        Satzmarke? art = _bearbeitung?.Art;
        _bearbeitung = null;
        if (!gespeichert) return;
        if (art == Satzmarke.Katalogsatz)
        {
            KatalogNeuLaden();
            if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
        }
        else if (_projektZeile is not null)
        {
            ProjektZeileWaehlen(_projektZeile);
        }
        SummeNachziehen();
    }

    /// <summary>
    /// „In die Datenbank übernehmen…" (KA‑E‑9): die Rückfrage für die Projektkopien der gewählten Zeilen (je Gerät
    /// einmal). Die Oberfläche fragt nur; geschrieben wird im Kern.
    /// </summary>
    private void BeiRueckweg()
    {
        if (RueckwegWege is null) return;
        var ids = ProjektZiele().Select(z => z.GeraetId).Where(id => id > 0).Distinct().ToList();
        if (ids.Count == 0) return;
        IReadOnlyList<Rueckwegvorschlag> zeilen = RueckwegWege.Vorschau(ids);
        if (zeilen.Count == 0) return;
        _rueckweg = zeilen;
    }

    /// <summary>Die Rückfrage ist zu; nach dem Schreiben Meldung (Zahl und Namen) und Katalog neu.</summary>
    private void RueckwegFertig(string? meldung)
    {
        _rueckweg = null;
        if (meldung is null) return;
        Melden(meldung, false);
        KatalogNeuLaden();
    }

    /// <summary>„Neu…" rechts in der Katalog-Fußleiste: der Katalogeditor im Modus Neu.</summary>
    private void BeiNeu()
    {
        if (NeuGaben is not null) _editorGaben = NeuGaben();
    }

    /// <summary>„Vergleichen…" — zwei oder mehr gewählte Katalogsätze nebeneinander.</summary>
    private void BeiVergleichen()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count >= 2) _katalogliste?.Vergleichen(ziele.Select(z => z.Schluessel).ToList());
    }

    /// <summary>Nach dem Editor die Katalogliste neu ziehen (Bestandsverhalten).</summary>
    private void EditorFertig(string? name)
    {
        _editorGaben = null;
        if (name is null) return;
        KatalogNeuLaden();
        foreach (var z in _katalog)
            if (z.Bezeichner == name) { KatalogZeileWaehlen(z.Bezeichner); return; }
    }

    /// <summary>
    /// „Löschen": die Rückfrage nennt bei mehreren Sätzen Zahl und Namen; gesperrte werden bei
    /// mehreren übersprungen und genannt. Ein einzelner Satz geht den Weg wie bisher.
    /// </summary>
    private void BeiLoeschenGefragt()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1)
        {
            _loeschziele = ziele;
            _loeschUebersprungen = new();
        }
        else
        {
            _loeschziele = ziele.Where(z => !z.Geschuetzt).ToList();
            _loeschUebersprungen = ziele.Where(z => z.Geschuetzt).ToList();
            if (_loeschziele.Count == 0)
            {
                BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
                return;
            }
        }
        _loeschfrage = true;
    }

    private string LoeschfrageText
    {
        get
        {
            string text = _loeschziele.Count <= 1
                ? string.Format(FrageLoeschen, _loeschziele.FirstOrDefault()?.Bezeichner ?? "")
                : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, _loeschziele.Count,
                                string.Join(", ", _loeschziele.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschUebersprungen.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                            string.Join(", ", _loeschUebersprungen.Select(z => "„" + z.Bezeichner + "“")));
            return text;
        }
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || KatalogLoeschen is null || ziele.Count == 0) return;
        bool fehler = false, fokusWeg = false;
        string loeschGrund = "";
        foreach (Katalogfilterzeile z in ziele)
        {
            // KT-4: Wirft der Löschweg, nennt die Meldung den Grund (Katalogladung.Loeschen).
            if (!Katalogladung.Loeschen(() => KatalogLoeschen(z.Id), z.Bezeichner, out string grund))
            {
                fehler = true;
                if (grund.Length > 0) loeschGrund = grund;
                continue;
            }
            if (z.Bezeichner == _katalogGewaehlt) fokusWeg = true;
        }
        if (fehler) Melden(loeschGrund.Length > 0 ? loeschGrund : MeldungLoeschFehler, true);
        if (fehler && ziele.Count == 1) return;
        KatalogKaestchenLeeren();
        if (fokusWeg)
        {
            _katalogZeile = null;
            _katalogGewaehlt = "";
            _detail = Leer("");
        }
        KatalogNeuLaden();
    }

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text;
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Der Abbrechen-Weg: schliesst ohne zu speichern. Esc und das ✕ im Kopf rufen ihn.</summary>
    private Task Abbrechen() => BeiErgebnis(false);

    /// <summary>
    /// Esc schliesst; die Ueberlagerungen werten ihn zuerst fuer sich aus. Enter bleibt
    /// unbelegt (A-7 aus B5b).
    /// </summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_traegerGaben is not null || _editorGaben is not null || _bearbeitung is not null || _rueckweg is not null ||
            _loeschfrage || _satzGross)
            return Task.CompletedTask;
        return Abbrechen();
    }

    // =================================================================================
    // Schloss setzen / aufheben (AD-Q15) - derselbe Baustein wie in den Verwaltungen
    // =================================================================================

    /// <summary>
    /// „Schloss setzen…" / „Schloss aufheben…" an der Katalogliste
    /// (<c>Schlosswege.Aus(…StammCtrl.SchlossSetzen)</c>). Ohne ihn steht der Knopf nicht da.
    /// Die Verwendung im Projekt sperrt nichts: Das Projekt führt eine eigene Kopie.
    /// </summary>
    [Parameter] public Schlossweg? Schloss { get; set; }

    private Katalogschloss? _katalogschloss;

    /// <summary>Trägt der gewählte Katalogsatz das Schloss? Dann ist er nur lesbar.</summary>
    private bool KatalogsatzGesperrt => _katalogZeile?.Geschuetzt == true;

    /// <summary>Steht die Rückfrage „Schloss setzen/aufheben"? (Prüfhilfe für Tests.)</summary>
    public bool Schlossfrage => _katalogschloss?.FrageOffen == true;

    /// <summary>Nach dem Schalten: Liste neu lesen, Felder des Satzes nachziehen, Status melden.</summary>
    private void BeiSchlossGeschaltet(string status)
    {
        KatalogNeuLaden();
        FelderNachziehen();
        _meldung = status ?? "";
        _meldungStufe = WarnStufe.Hinweis;
    }

    /// <summary>Warum nicht geschaltet (oder nicht bearbeitet) wurde.</summary>
    private void BeiSchlossAbgelehnt(string grund)
    {
        _meldung = grund ?? "";
        _meldungStufe = WarnStufe.Warnung;
    }
}
