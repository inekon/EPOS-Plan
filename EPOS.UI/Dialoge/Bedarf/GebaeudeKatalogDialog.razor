    // =================================================================================
    // Der EINE Schreibweg: Pruefen, Ableiten, Speichern (Konzept 4.8; E27/U1)
    // =================================================================================

    /// <summary>
    /// Die Prüfregeln — genau einmal, für OK, „Speichern unter" und den Assistenten; sie
    /// stehen im Arbeitsstand (<see cref="GebaeudeArbeitsstand.Pruefen"/>), den auch das
    /// Stammblatt der Gebäudeverwaltung prüft. Meldet die erste verletzte Regel und springt
    /// auf ihren Reiter.
    /// </summary>
    private bool Pruefen(bool mitName)
    {
        GebaeudePruefbefund? befund = _arbeit.Pruefen(mitName, _prueftexte, Texte);
        if (befund is null) return true;
        return Verletzt(befund.Meldung, befund.Temperaturen ? REITER_TEMPERATUREN : REITER_HUELLE);
    }

    private bool Verletzt(string meldung, string reiter)
    {
        Melden(meldung, WarnStufe.Warnung);
        _reiter = reiter;
        return false;
    }

    /// <summary>
    /// Die Ableitungen des Vorläufers und der Hülle — jetzt im OK-Weg
    /// (<see cref="GebaeudeArbeitsstand.Ableiten"/>).
    /// </summary>
    private void Ableiten() => _arbeit.Ableiten();

    /// <summary>
    /// Prüft, leitet ab und schreibt — der eine Schreibweg. <c>false</c> = eine Regel
    /// ist verletzt oder die Hülle hat abgelehnt; die Meldung steht dann.
    /// </summary>
    private bool Schreiben(bool istNeu, string bezeichner)
    {
        if (!Pruefen(istNeu)) return false;
        if (Speichern is null) return true;

        Ableiten();
        GebaeudeKatalogErgebnis ergebnis = Speichern(_stand, istNeu, bezeichner);
        if (!ergebnis.Erfolg)
        {
            Melden(ergebnis.Meldung, WarnStufe.Warnung);
            return false;
        }

        _geschrieben = true;
        _ursprungsname = bezeichner;
        _arbeit.Geschrieben();
        _meldung = "";
        return true;
    }

    /// <summary>
    /// Die Leiste: OK prüft, speichert und schließt — im Modus Neu wird angelegt, sonst
    /// der Satz unter seinem Ursprungsnamen überschrieben. Abbrechen schließt ohne zu
    /// schreiben.
    /// </summary>
    private async Task BeiErgebnis(bool ok)
    {
        if (!ok) { await Abbrechen(); return; }

        // Betriebsart Projekt (G3): die Projektkopie samt Zonen, in benannten Schritten.
        if (Modus == GebaeudeKatalogModus.Projekt)
        {
            if (!SchreibenProjekt()) return;
            await Geschlossen.InvokeAsync(true);
            return;
        }

        bool istNeu = Modus == GebaeudeKatalogModus.Neu;
        if (!Schreiben(istNeu, istNeu ? _stand.Name : _ursprungsname)) return;
        await Geschlossen.InvokeAsync(true);
    }

    /// <summary>
    /// <b>Der OK-Weg in der Betriebsart Projekt</b> (Stufe G3, Welle D2; Softwarearchitektur 3.3) —
    /// in drei BENANNTEN Schritten, jeder mit eigener Meldung:
    /// <list type="number">
    /// <item><b>Gebäudedaten</b>: prüfen, ableiten, die Projektkopie überschreiben — nicht noch einmal,
    /// wenn ein früheres OK sie mit demselben Stand schon geschrieben hat.</item>
    /// <item><b>Katalogaufbauten</b>: jeder im Bauteildialog aus dem Katalog gewählte Aufbau wird in das
    /// Projekt übernommen; die Bauteile zeigen danach auf die Kopie (der Arbeitsstand merkt es sich,
    /// ein zweites OK übernimmt nichts doppelt).</item>
    /// <item><b>Zonen</b>: nur wenn sie sich geändert haben — Abgleich über die Ids, eine Transaktion
    /// im Kern (Entfernen → Ändern → Anlegen).</item>
    /// </list>
    /// Scheitert ein Schritt, steht seine Meldung, und der Dialog bleibt offen.
    /// </summary>
    private bool SchreibenProjekt()
    {
        if (!Pruefen(false)) return false;
        if (Speichern is null) return true;

        // G6a: die Pruefregeln des Kerns ueber die ganze Zonenliste - VOR dem ersten Schritt, damit
        // eine verletzte Regel (Nutzflaeche ab zwei Zonen, Hoechstzahl, doppelte Id) nichts halb schreibt.
        if (_arbeit.ZonenGeaendert && Zonen?.Pruefen?.Invoke(_arbeit.Zonenstand(false)) is { Length: > 0 } zonenfehler)
        {
            Melden(string.Format(CultureInfo.CurrentCulture, ZonenTexte.MeldungZonen, zonenfehler), WarnStufe.Warnung);
            return false;
        }

        // Schritt 1: die Gebaeudedaten der Projektkopie.
        Ableiten();
        string abdruck = _arbeit.Abdruck();
        if (abdruck != _abdruckGeschrieben)
        {
            GebaeudeKatalogErgebnis e = Speichern(_stand, false, _ursprungsname);
            if (!e.Erfolg)
            {
                Melden(e.Meldung, WarnStufe.Warnung);
                return false;
            }
            _abdruckGeschrieben = abdruck;
            _geschrieben = true;
            _arbeit.Geschrieben();
        }

        // Schritt 2: Katalogaufbauten in das Projekt uebernehmen.
        if (Zonen?.AufbauUebernehmen is not null)
        {
            foreach (BauteilDaten b in _arbeit.Zonen.SelectMany(z => z.Bauteile).Where(x => x.IdAufbauStamm.HasValue).ToList())
            {
                if (!b.IdAufbauStamm.HasValue) continue;   // schon mit einem gleichen Aufbau uebernommen
                int stamm = b.IdAufbauStamm.Value;
                AufbauUebernahmeErgebnis r = Zonen.AufbauUebernehmen(stamm);
                if (!r.Ok || r.Wahl is null)
                {
                    Melden(string.Format(CultureInfo.CurrentCulture, ZonenTexte.MeldungAufbau, b.AufbauText, r.Meldung),
                           WarnStufe.Warnung);
                    return false;
                }
                _projektaufbauten.Add(r.Wahl);
                foreach (BauteilDaten gleich in _arbeit.Zonen.SelectMany(z => z.Bauteile).Where(x => x.IdAufbauStamm == stamm))
                {
                    gleich.IdAufbauStamm = null;
                    gleich.IdAufbau = r.Wahl.Id;
                    gleich.AufbauText = r.Wahl.Text;
                    gleich.UAufbau = r.Wahl.UWert;
                }
            }
        }

        // Schritt 3: die Zonen.
        if (_arbeit.ZonenGeaendert && Zonen?.Speichern is not null)
        {
            string fehler = Zonen.Speichern(_arbeit.Zonenstand(true)) ?? "";
            if (fehler.Length > 0)
            {
                Melden(string.Format(CultureInfo.CurrentCulture, ZonenTexte.MeldungZonen, fehler), WarnStufe.Warnung);
                return false;
            }
            _arbeit.ZonenGeschrieben();
            _geschrieben = true;
        }
        _meldung = "";
        return true;
    }

    /// <summary>
    /// „Speichern unter" — derselbe OK-Weg, angelegt unter dem eingegebenen Namen als Katalogsatz.
    /// Trägt das Gebäude eine Zone, fragt der Dialog VOR dem Schreiben (Softwarearchitektur 2.9): Der
    /// Katalogsatz trägt keine Zonen.
    /// </summary>
    private async Task BeiSpeichernUnter()
    {
        if (_arbeit.Zonen.Count > 0)
        {
            _speichernUnterFrage = true;
            return;
        }
        await SpeichernUnterSchreiben();
    }

    /// <summary>Die Antwort auf die Rückfrage: Ja führt den Weg zu Ende, Nein hält den Dialog offen (3.3 Punkt 6).</summary>
    private async Task SpeichernUnterBeantwortet(bool? antwort)
    {
        _speichernUnterFrage = false;
        if (antwort == true) await SpeichernUnterSchreiben();
    }

    private async Task SpeichernUnterSchreiben()
    {
        if (!Schreiben(istNeu: true, bezeichner: _stand.Name)) return;
        await Geschlossen.InvokeAsync(true);
    }

    private void Melden(string text, WarnStufe stufe)
    {
        _meldung = text ?? "";
        _meldungStufe = stufe;
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        // Die Ueberlagerungen und Rueckfragen werten Esc zuerst fuer sich aus (Esc kaskadiert).
        if (e.Key != "Escape" || _brauchwasserGaben is not null || _zoneOffen is not null || _vorschlag is not null
            || _entfernId is not null || _speichernUnterFrage || _nachFrage is not null || _luftOffen) return Task.CompletedTask;
        return Abbrechen();
    }

    /// <summary>
    /// Abbrechen, Esc und das Kreuz: schließen ohne zu schreiben. Hat der Assistent
    /// zwischendurch gespeichert, meldet der Rückweg das mit <c>true</c>.
    /// </summary>
    private Task Abbrechen() => Geschlossen.InvokeAsync(_geschrieben);
}
