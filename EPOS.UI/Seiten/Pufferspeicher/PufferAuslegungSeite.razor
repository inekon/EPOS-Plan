@* DIE ANSICHT „PUFFERSPEICHER-AUSLEGUNG" (Seitenschluessel PUFFER_AUSLEGUNG; Konzept
   Pufferspeicher-Auslegung, Abschnitt 6, Stufe P2; Gestalt nach dem abgenommenen Mockup
   Dokumentation/aktuell/Mockups/Pufferspeicher_Auslegung_Mockup.html).

   EINE FREIE ANSICHT DER APPWURZEL, kein Fenster im Fenster: dieselbe Bauart wie die
   Stromspeicher-Auslegung - Kopf mit Titel, Kontext, Rueckweg und Kreuz, darunter die
   Ablaufleiste mit vier Schritten (1 Klasse und Erzeuger, 2 Bedarf und Randbedingungen,
   3 Kriterien, 4 Ergebnis und Uebernahme) und der Umschalter der Tiefe (Schnell, Standard,
   Experte). Unter Windows zeigt sie dieselbe Komponente auch in einem eigenen Fenster - der
   Weg aus dem Zapfprofil, das selbst in einem Fenster steht.

   RECHNEN. Jeder Schalter (Klasse, Vorlage, Geraetetyp, Zweiterzeuger, Kriterium, Uebergabe,
   Sperrprofil, Zirkulationsweg) rechnet sofort neu - der Kern rechnet ohne Datenbank, die
   Reihen haelt die Huelle. Ein Zahlenfeld rechnet NICHT je Tastendruck (Betriebssimulation
   ueber 8 760 h mit Bisektion): Es markiert das Ergebnis als veraltet, gerechnet wird beim
   Wechsel in Schritt 4 oder mit „Neu rechnen".

   KEINE DATENBANK (Hausregel EPOS.UI). Alles, was liest oder schreibt, steht als Delegat in
   PufferAuslegungDienste und fuehrt in PufferAuslegungCtrl. Herkunft je Feld kommt aus der
   Vorbelegung des Kerns; was der Anwender aendert, traegt die Marke „ueberschrieben". *@

@namespace EPOS.UI.Seiten.Pufferspeicher
@using System.Globalization
@using EPOS.UI.Seiten.Strom
@using WindowsFormsApplication1
@implements IDisposable

<div class="epos-seite epos-pausl">

    @* ---------------------------------------------------------------- Kopf *@
    <div class="epos-seite-kopf epos-pausl-kopf">
        <h1 class="epos-seite-titel">@Texte.Titel</h1>
        @if (Kontextzeile.Length > 0)
        {
            <span class="epos-pausl-kontext">@Kontextzeile</span>
        }
        <span class="epos-pausl-kopfaktionen">
            @if (!HilfePilleImKopfband)
            {
                <InfoKnopf Schluessel="@HilfeSchluessel" Dialogname="@Texte.Titel" />
            }
            <button type="button" class="epos-knopf epos-pausl-zurueck" @onclick="Verlassen">@Texte.Zurueck</button>
            <Schliesskreuz Geschlossen="Verlassen" />
        </span>
    </div>

    @if (Daten.Fehler.Length > 0)
    {
        @* Ohne Vorbelegung gibt es nichts zu zeigen - der Grund steht benannt da. *@
        <Warnbanner Stufe="WarnStufe.Fehler" Text="@Daten.Fehler" />
    }
    else
    {
        <div class="epos-pausl-leiste">
            <Ablaufleiste Vorne="@Schritte" Aktiv="@_schritt" Gewaehlt="SchrittGewaehlt"
                          MitAktion="false" Bezeichnung="@Texte.Ablauf" VeraltetText="@Texte.Veraltet" Buendig="true" />
            <Optionsgruppe Bezeichnung="@Texte.Stufe" Eintraege="@Stufeneintraege"
                           Auswahl="@((int)_stufe)" AuswahlChanged="StufeGewaehlt" />
        </div>

        @if (Daten.Gespeichert)
        {
            <p class="epos-leisezeile epos-pausl-gespeichert">@Texte.GespeicherteAuslegung</p>
        }

        @if (_meldung.Length > 0)
        {
            <Warnbanner Stufe="@(_meldungErfolg ? WarnStufe.Erfolg : WarnStufe.Fehler)" Text="@_meldung" />
        }

        <div class="epos-pausl-blatt">
            @if (_schritt == PufferAuslegungSchritt.Anlage)
            {
                @SchrittAnlage
            }
            else if (_schritt == PufferAuslegungSchritt.Bedarf)
            {
                @SchrittBedarf
            }
            else if (_schritt == PufferAuslegungSchritt.Kriterien)
            {
                @SchrittKriterien
            }
            else
            {
                @SchrittErgebnis
            }
        </div>

        @* Der Weg durch die Schritte - eine Zeile am Ende des Blattes. *@
        <div class="epos-pausl-fuss">
            @if (_schritt != PufferAuslegungSchritt.Anlage)
            {
                <button type="button" class="epos-knopf epos-pausl-vorher" @onclick="SchrittZurueck">@Texte.ZurueckSchritt</button>
            }
            @if (_schritt == PufferAuslegungSchritt.Kriterien)
            {
                <button type="button" class="epos-knopf epos-knopf--primaer epos-pausl-rechnen" @onclick="ZumErgebnis">@Texte.Rechnen</button>
            }
            else if (_schritt != PufferAuslegungSchritt.Ergebnis)
            {
                <button type="button" class="epos-knopf epos-knopf--primaer epos-pausl-weiter" @onclick="SchrittWeiter">@Texte.Weiter</button>
            }
            <button type="button" class="epos-knopf epos-pausl-zuruecksetzen" @onclick="Zuruecksetzen">@Texte.Zuruecksetzen</button>
        </div>
    }
</div>

@code {
    // =====================================================================
    //  Parameter
    // =====================================================================

    /// <summary>Der Startstand; ohne Gaben ein leerer Stand (die Ansicht zeichnet trotzdem).</summary>
    [Parameter] public PufferAuslegungStartDaten Daten { get; set; } = new();

    /// <summary>Die Wege in den Kern; ohne sie rechnet die Ansicht nicht und zeigt keine Knöpfe zum Schreiben.</summary>
    [Parameter] public PufferAuslegungDienste? Dienste { get; set; }

    /// <summary>Das Textbündel.</summary>
    [Parameter] public PufferAuslegungTexte Texte { get; set; } = new();

    /// <summary>Der Hilfeschlüssel der Ansicht.</summary>
    [Parameter] public string HilfeSchluessel { get; set; } = "Form_PufferAuslegung.btn_Help";

    /// <summary>„← zurück" und das Kreuz — die Wurzel kehrt dorthin zurück, woher die Ansicht kam.</summary>
    [Parameter] public EventCallback Geschlossen { get; set; }

    /// <summary>Führt ein Kopfband schon eine Hilfe-Pille? Dann zeichnet die Ansicht keine zweite.</summary>
    [CascadingParameter(Name = "HilfePilleImKopfband")]
    public bool HilfePilleImKopfband { get; set; }

    /// <summary>Der Weg nach oben; <c>null</c> = niemand hört zu.</summary>
    [CascadingParameter] public Hilfekontextmelder? Hilfemelder { get; set; }

    // =====================================================================
    //  Zustand
    // =====================================================================

    private string _schritt = PufferAuslegungSchritt.Anlage;
    private PufferAuslegungStufe _stufe = PufferAuslegungStufe.Standard;
    private PufferAuslegungEingabeDaten _eingabe = new();
    private PufferAuslegungErgebnisDaten? _ergebnis;
    private bool _veraltet;
    private int? _idPuffer;
    private string _pufferName = "";
    private int _ziel;
    private bool _katalogsatz = true;
    private string _bezeichner = "";

    /// <summary>V14: das Sperrprofil der Auslegung beim Übernehmen an die Wärmepumpe schreiben? Vorgabe aus.</summary>
    private bool _sperrprofilSchreiben;
    private string _meldung = "";
    private bool _meldungErfolg;
    private Hilfekontext? _gemeldet;
    private KiMaskenanmeldung? _kiMaske;
    private PufferAuslegungKiSicht? _kiSicht;

    // ---- Prüfhilfen (bunit) ----
    public string Schritt => _schritt;
    public PufferAuslegungStufe Stufe => _stufe;
    public PufferAuslegungEingabeDaten Arbeitsstand => _eingabe;
    public PufferAuslegungErgebnisDaten? Ergebnis => _ergebnis;
    public string Meldung => _meldung;
    public bool Veraltet => _veraltet;

    /// <summary>Wo der Anwender steht: Hilfeschlüssel, Name der Ansicht und ihr Schritt.</summary>
    public Hilfekontext Kontext => new Hilfekontext(HilfeSchluessel, Texte.Titel, Schrittname(_schritt));

    protected override void OnInitialized()
    {
        _eingabe = (Daten.Eingabe ?? new PufferAuslegungEingabeDaten()).Kopie();
        // Die gespeicherte Anzeigestufe (Welle P4c); leer = Standard.
        if (Enum.TryParse(_eingabe.Anzeigestufe ?? "", true, out PufferAuslegungStufe gespeichert) &&
            Enum.IsDefined(typeof(PufferAuslegungStufe), gespeichert)) _stufe = gespeichert;
        _ergebnis = Daten.Ergebnis;
        _probelauf = Daten.Probelauf;
        _idPuffer = Daten.IdPuffer;
        _pufferName = Daten.PufferBezeichner ?? "";
        _ziel = _idPuffer.HasValue ? 0 : 1;
        _kiMaske = KiMaskenanmeldung.Fuer(KiMaskennamen.PUFFER_AUSLEGUNG, () => KiSicht(), KiHaken());
    }

    /// <inheritdoc />
    protected override void OnAfterRender(bool firstRender)
    {
        Hilfekontextmelder? melder = Hilfemelder;
        if (melder is null) return;
        Hilfekontext jetzt = Kontext;
        if (_gemeldet is not null && _gemeldet.Equals(jetzt)) return;
        _gemeldet = jetzt;
        melder.Melden(jetzt);
    }

    /// <inheritdoc />
    public void Dispose() => _kiMaske?.Dispose();

    private Task Verlassen() => Geschlossen.InvokeAsync();

    // =====================================================================
    //  Kopf und Ablauf
    // =====================================================================

    /// <summary>„Projekt „…" · Speicher „…"" samt Einstieg.</summary>
    private string Kontextzeile
    {
        get
        {
            string projekt = Daten.Projektname ?? "";
            string z = _idPuffer.HasValue && _pufferName.Length > 0
                ? Format(Texte.KontextPuffer, projekt, _pufferName)
                : projekt.Length > 0 ? Format(Texte.KontextNeu, projekt) : "";
            if (!string.IsNullOrEmpty(Daten.Einstieg)) z = z.Length > 0 ? z + " · " + Daten.Einstieg : Daten.Einstieg;
            return z;
        }
    }

    private IReadOnlyList<Ablaufeintrag> Schritte => new[]
    {
        new Ablaufeintrag(PufferAuslegungSchritt.Anlage, Texte.SchrittAnlage, true, false, ""),
        new Ablaufeintrag(PufferAuslegungSchritt.Bedarf, Texte.SchrittBedarf, true, false, ""),
        new Ablaufeintrag(PufferAuslegungSchritt.Kriterien, Texte.SchrittKriterien, true, false, ""),
        new Ablaufeintrag(PufferAuslegungSchritt.Ergebnis, Texte.SchrittErgebnis, true, _veraltet && _ergebnis is not null, "")
    };

    private string Schrittname(string schritt) => schritt switch
    {
        PufferAuslegungSchritt.Anlage => Texte.SchrittAnlage,
        PufferAuslegungSchritt.Bedarf => Texte.SchrittBedarf,
        PufferAuslegungSchritt.Kriterien => Texte.SchrittKriterien,
        _ => Texte.SchrittErgebnis
    };

    private IReadOnlyList<(int Id, string Text)> Stufeneintraege => new[]
    {
        ((int)PufferAuslegungStufe.Schnell, Texte.StufeSchnell),
        ((int)PufferAuslegungStufe.Standard, Texte.StufeStandard),
        ((int)PufferAuslegungStufe.Experte, Texte.StufeExperte)
    };

    private void StufeGewaehlt(int? id)
    {
        if (id is int i && Enum.IsDefined(typeof(PufferAuslegungStufe), i))
        {
            _stufe = (PufferAuslegungStufe)i;
            _eingabe.Anzeigestufe = _stufe.ToString().ToUpperInvariant();
        }
    }

    private bool AbStandard => _stufe != PufferAuslegungStufe.Schnell;
    private bool Experte => _stufe == PufferAuslegungStufe.Experte;

    private void SchrittGewaehlt(string schritt)
    {
        if (schritt == PufferAuslegungSchritt.Ergebnis && (_veraltet || _ergebnis is null)) NeuRechnen();
        _schritt = schritt;
    }

    private void SchrittWeiter()
    {
        int i = IndexVon(_schritt);
        if (i < PufferAuslegungSchritt.Alle.Count - 1) SchrittGewaehlt(PufferAuslegungSchritt.Alle[i + 1]);
    }

    private void SchrittZurueck()
    {
        int i = IndexVon(_schritt);
        if (i > 0) _schritt = PufferAuslegungSchritt.Alle[i - 1];
    }

    private static int IndexVon(string schritt)
    {
        for (int i = 0; i < PufferAuslegungSchritt.Alle.Count; i++)
            if (PufferAuslegungSchritt.Alle[i] == schritt) return i;
        return 0;
    }

    private void ZumErgebnis()
    {
        NeuRechnen();
        _schritt = PufferAuslegungSchritt.Ergebnis;
    }

    /// <summary>„Auf Vorbelegung zurücksetzen" — der Startstand, neu gerechnet.</summary>
    private void Zuruecksetzen()
    {
        _eingabe = (Daten.Eingabe ?? new PufferAuslegungEingabeDaten()).Kopie();
        _meldung = "";
        NeuRechnen();
    }

    // =====================================================================
    //  Rechnen
    // =====================================================================

    private bool KlasseGewaehlt => _eingabe.KlasseHeizung || _eingabe.KlasseBrauchwasser || _eingabe.KlasseProzess;

    /// <summary>Rechnet den Arbeitsstand über die Hülle; ein Fehler steht benannt im Ergebnis.</summary>
    public void NeuRechnen()
    {
        _veraltet = false;
        if (!KlasseGewaehlt)
        {
            _ergebnis = PufferAuslegungErgebnisDaten.MitFehler(Texte.KlasseLeer);
            return;
        }
        if (Dienste?.Rechnen is null) return;
        try
        {
            _ergebnis = Dienste.Rechnen(_eingabe.Kopie());
        }
        catch (Exception ex)
        {
            _ergebnis = PufferAuslegungErgebnisDaten.MitFehler(ex.Message);
        }
    }

    /// <summary>Ein Schalter: setzen und sofort rechnen.</summary>
    private void Schalten(Action setzen)
    {
        setzen();
        _meldung = "";
        NeuRechnen();
    }

    /// <summary>Ein Zahlenfeld: setzen und das Ergebnis als veraltet markieren.</summary>
    private void Zahl(Action setzen)
    {
        setzen();
        _meldung = "";
        _veraltet = true;
    }

    // =====================================================================
    //  Herkunft
    // =====================================================================

    /// <summary>Weicht das Feld vom Startstand ab?</summary>
    private bool Geaendert(string feld)
    {
        PufferAuslegungEingabeDaten a = Daten.Eingabe ?? new PufferAuslegungEingabeDaten(), e = _eingabe;
        return feld switch
        {
            "Klassen" => a.KlasseHeizung != e.KlasseHeizung || a.KlasseBrauchwasser != e.KlasseBrauchwasser
                         || a.KlasseProzess != e.KlasseProzess,
            "Vorlage" => a.Vorlage != e.Vorlage,
            "Erzeuger" => a.WpGeregelt != e.WpGeregelt || a.ZweiterzeugerFrei != e.ZweiterzeugerFrei
                          || a.MindestleistungKw != e.MindestleistungKw,
            "Uebergabeart" => (a.Uebergabeart ?? "") != (e.Uebergabeart ?? ""),
            "HeizgrenzeC" => a.HeizgrenzeC != e.HeizgrenzeC,
            "AuslegungsheizlastKw" => a.AuslegungsheizlastKw != e.AuslegungsheizlastKw,
            "AnlagenvolumenL" => a.AnlagenvolumenL != e.AnlagenvolumenL,
            "Sperrfenster" => a.Sperrprofil != e.Sperrprofil || a.SperrbeginnH != e.SperrbeginnH
                              || a.SperrdauerH != e.SperrdauerH || a.SperrzeitExpertenweg != e.SperrzeitExpertenweg,
            "MindestlaufzeitMin" => a.MindestlaufzeitMin != e.MindestlaufzeitMin,
            "StartzielJeTag" => a.StartzielJeTag != e.StartzielJeTag,
            "Deckungsziel" => a.DeckungszielProzent != e.DeckungszielProzent,
            "DeltaTBK" => a.DeltaTBK != e.DeltaTBK,
            "TPufferObenC" => a.TPufferObenC != e.TPufferObenC,
            "ZirkulationWeg" => (a.ZirkulationWeg ?? "") != (e.ZirkulationWeg ?? "") || a.Wohneinheiten != e.Wohneinheiten,
            _ => false
        };
    }

    /// <summary>Die Herkunftsmarke eines Felds: „überschrieben", sonst die Quelle des Kerns, sonst die Vorgabe.</summary>
    private RenderFragment Marke(string feld, string? rueckfall = null)
    {
        bool ueber = Geaendert(feld);
        PufferHerkunftDaten? h = Daten.HerkunftVon(feld);
        string text = ueber ? Texte.QuelleUeberschrieben : h?.Marke ?? rueckfall ?? Texte.QuelleVorgabe;
        string titel = string.Join(" · ", Daten.HerkunftAlle(feld).Select(z => z.Text).Where(t => t.Length > 0));
        string klasse = "epos-pausl-marke" + (ueber ? " epos-pausl-marke--ueberschrieben" : "");
        return @<span class="@klasse" data-feld="@feld" title="@(titel.Length > 0 ? titel : null)">@text</span>;
    }

    // =====================================================================
    //  Schritt 1 — Klasse, Vorlage, Erzeuger
    // =====================================================================

    private PufferVorlageDaten? GewaehlteVorlage => Daten.Vorlagen.FirstOrDefault(v => v.Schluessel == _eingabe.Vorlage);

    private bool IstWpVorlage => _eingabe.Vorlage is "WP_MONO" or "WP_BIVALENT";

    private void VorlageWaehlen(string schluessel)
    {
        if (_eingabe.Vorlage == schluessel) return;
        Schalten(() =>
        {
            _eingabe.Vorlage = schluessel;
            _eingabe.Kriterien.Clear();
        });
    }

    private IReadOnlyList<(int Id, string Text)> Geraetetypen => new[] { (0, Texte.FixedSpeed), (1, Texte.Geregelt) };

    private IReadOnlyList<(int Id, string Text)> Zweiterzeugerwege => new[] { (1, Texte.ZweitFrei), (0, Texte.ZweitHeizstab) };

    private RenderFragment SchrittAnlage => @<div class="epos-pausl-schritt epos-pausl-schritt--anlage">
        <Gruppenkopf Titel="@Texte.GruppeKlasse">
            <KindInhalt>
                <div class="epos-pausl-klassen">
                    <Schalter Bezeichnung="@Texte.KlasseHeizung" Wert="@_eingabe.KlasseHeizung"
                              WertChanged="@((bool w) => Schalten(() => _eingabe.KlasseHeizung = w))" />
                    <Schalter Bezeichnung="@Texte.KlasseBrauchwasser" Wert="@_eingabe.KlasseBrauchwasser"
                              WertChanged="@((bool w) => Schalten(() => _eingabe.KlasseBrauchwasser = w))" />
                    <Schalter Bezeichnung="@Texte.KlasseProzess" Wert="@_eingabe.KlasseProzess"
                              WertChanged="@((bool w) => Schalten(() => _eingabe.KlasseProzess = w))" />
                    @Marke("Klassen")
                </div>
                @if (!KlasseGewaehlt)
                {
                    <Warnbanner Stufe="WarnStufe.Warnung" Text="@Texte.KlasseLeer" />
                }
                <p class="epos-leisezeile">@Texte.KlasseHinweis</p>
                <div class="epos-pausl-zeile epos-pausl-nutzungsprofil">
                    <span class="epos-pausl-beschriftung">@Texte.Nutzungsprofil</span>
                    <strong>@Daten.Nutzungsprofil</strong>
                    <span class="epos-pausl-marke" title="@Daten.NutzungsprofilHerkunft">@(Daten.NutzungsprofilVorgabe ? Texte.QuelleVorgabe : Texte.QuelleProjekt)</span>
                </div>
                <p class="epos-leisezeile">@Texte.NutzungsprofilHinweis</p>
            </KindInhalt>
        </Gruppenkopf>

        <Gruppenkopf Titel="@Texte.GruppeVorlage">
            <KindInhalt>
                <div class="epos-pausl-vorlagen" role="radiogroup" aria-label="@Texte.GruppeVorlage">
                    @foreach (PufferVorlageDaten v in Daten.Vorlagen)
                    {
                        string schluessel = v.Schluessel;
                        bool gewaehlt = schluessel == _eingabe.Vorlage;
                        <button type="button" @key="schluessel" role="radio" aria-checked="@(gewaehlt ? "true" : "false")"
                                class="@("epos-pausl-vorlage" + (gewaehlt ? " epos-pausl-vorlage--gewaehlt" : ""))"
                                data-vorlage="@schluessel" @onclick="() => VorlageWaehlen(schluessel)">
                            <span class="epos-pausl-vorlage-titel">@v.Titel</span>
                            <span class="epos-pausl-vorlage-unter">@v.Untertitel</span>
                            <span class="epos-pausl-vorlage-text">@v.Beschreibung</span>
                            @if (v.Faustwert.Length > 0)
                            {
                                <span class="epos-pausl-vorlage-faust">@v.Faustwert</span>
                            }
                        </button>
                    }
                </div>
                <div class="epos-pausl-zeile">@Marke("Vorlage")</div>
                <p class="epos-leisezeile">@Texte.VorlageHinweis</p>
                @if (IstWpVorlage)
                {
                    <div class="epos-pausl-geraetetyp">
                        <Optionsgruppe Bezeichnung="@Texte.Geraetetyp" Eintraege="@Geraetetypen"
                                       Auswahl="@(_eingabe.WpGeregelt ? 1 : 0)"
                                       AuswahlChanged="@((int? w) => Schalten(() => _eingabe.WpGeregelt = w == 1))" />
                        @Marke("Erzeuger")
                    </div>
                }
                @if (_eingabe.Vorlage == "WP_BIVALENT")
                {
                    <div class="epos-pausl-zweiterzeuger">
                        <Optionsgruppe Bezeichnung="@Texte.Zweiterzeuger" Eintraege="@Zweiterzeugerwege"
                                       Auswahl="@(_eingabe.ZweiterzeugerFrei ? 1 : 0)"
                                       AuswahlChanged="@((int? w) => Schalten(() => _eingabe.ZweiterzeugerFrei = w == 1))" />
                    </div>
                }
            </KindInhalt>
        </Gruppenkopf>

        <Gruppenkopf Titel="@Texte.GruppeErzeuger">
            <KindInhalt>
                @if (Daten.Erzeuger.Count == 0)
                {
                    <p class="epos-leisezeile epos-pausl-erzeuger-keiner">@Texte.ErzeugerKeiner</p>
                }
                else
                {
                    <ul class="epos-pausl-erzeuger">
                        @foreach (string z in Daten.Erzeuger)
                        {
                            <li>@z</li>
                        }
                    </ul>
                    <div class="epos-pausl-zeile">@Marke("Erzeuger", Texte.QuelleKaskade)</div>
                }
            </KindInhalt>
        </Gruppenkopf>

        @if (AbStandard)
        {
            <Gruppenkopf Titel="@Texte.GruppeTemperatur">
                <KindInhalt>
                    <div class="epos-pausl-zeile">
                        <span class="epos-pausl-beschriftung">@Texte.Temperaturpaar</span>
                        <span>@(Z(Daten.VorlaufC) + " / " + Z(Daten.RuecklaufC) + " °C")</span>
                        @Marke("VorlaufC")
                    </div>
                    <div class="epos-pausl-zeile">
                        <span class="epos-pausl-beschriftung">@Texte.Schwellen</span>
                        <span>@(Z(Daten.SchwelleEin * 100) + " % / " + Z(Daten.SchwelleAus * 100) + " % → "
