    private IReadOnlyList<Steuerwahl> _fallA = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _esA = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _aufA = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _esP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _aufP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _uaP = Array.Empty<Steuerwahl>();
    private IReadOnlyList<Steuerwahl> _modus = Array.Empty<Steuerwahl>();

    private List<WirtschaftlichkeitErgebnis>? _ergebnisCache;

    /// <summary>Die Beschriftungen des Dialogs (Pruefhilfe fuer den Feldkarten-Abgleich).</summary>
    public BhkwWirtschaftlichkeitTexte Texte => _t;

    /// <summary>true, wenn mindestens einmal gespeichert wurde (Pruefhilfe fuer Tests).</summary>
    public bool Gespeichert => _gespeichert;

    /// <summary>true, wenn seit dem letzten Speichern etwas geaendert wurde.</summary>
    public bool Geaendert => _geaendert;

    /// <summary>Die gewaehlte Anlagenzeile; <c>null</c> = keine. Sie traegt, was der
    /// Dialog NICHT pflegt (Bezeichner, Leistung, Brennstoff, Projekt); die Eingaben
    /// stehen in <see cref="AktuellerStand"/>.</summary>
    public KwkgAnlagenAngabe? Aktuelle =>
        _aktuell >= 0 && _aktuell < Anlagen.Count ? Anlagen[_aktuell] : null;

    /// <summary>Der Arbeitsstand der gewaehlten Zeile; <c>null</c> = keine gewaehlt.</summary>
    public BhkwAnlagenstand? AktuellerStand =>
        _aktuell >= 0 && _aktuell < _staende.Count ? _staende[_aktuell] : null;

    /// <summary>Der Arbeitsstand der Projektvorgaben (Pruefhilfe fuer Tests).</summary>
    public BhkwVorgabenstand Vorgabenstand => _vorgaben;

    /// <summary>Der Arbeitsstand einer Zeile der Anlagentabelle.</summary>
    private BhkwAnlagenstand Stand(KwkgAnlagenAngabe a)
    {
        int i = Anlagen.IndexOf(a);
        return i >= 0 && i < _staende.Count ? _staende[i] : new BhkwAnlagenstand();
    }

    /// <summary>
    /// K6 - der Hilfsenergieanteil ist nur bei BHKW-Anlagen pflegbar.
    ///
    /// <para>Die Spalte <c>Hilfsenergie_Anteil</c> gilt formal fuer jede Komponente
    /// (Konzept § 5.2), gelesen wird sie in B3 aber nur fuer BHKW und Heizkessel.
    /// Der Kessel bekommt in Gruppe 5 einen Hinweis statt eines Feldes - sein
    /// Hilfsstrom ist reiner Ausweis ohne Strommengenwirkung (B3b) -, die
    /// Waermepumpe bleibt einer spaeteren Etappe vorbehalten.</para>
    /// </summary>
    public static bool AnteilPflegbar(int idType) => idType == WizardItemClass.BHKW_TYP;

    /// <summary>Zeigt den Hinweis fuer Kessel bzw. blendet ihn aus; die Waermepumpe
    /// bekommt weder Feld noch Hinweis.</summary>
    public static bool AnteilHinweis(int idType) => idType == WizardItemClass.KESSEL_TYP;

    /// <summary>Der Dialog fuehrt ausschliesslich BHKW-Anlagenzeilen (<c>LadeGruppe</c>
    /// filtert auf <c>ID_Type = BHKW_TYP</c>) - das Feld ist deshalb sichtbar, sobald
    /// eine Zeile gewaehlt ist.</summary>
    public bool AnteilSichtbar => Aktuelle is not null && AnteilPflegbar(WizardItemClass.BHKW_TYP);

    /// <summary>Der Kessel-Hinweis der Gruppe 5.</summary>
    public bool Kesselhinweis => HatHeizkessel && AnteilHinweis(WizardItemClass.KESSEL_TYP);

    private string Kopftitel => _t.Titel +
        (string.IsNullOrEmpty(StammName) ? "" : " — " + StammName);

    // =====================================================================
    // Aufbau
    // =====================================================================

    protected override void OnInitialized()
    {
        _artA = BhkwWahlen.Anlagenart(false);
        _fallA = BhkwWahlen.Eigenfall(false);
        _esA = BhkwWahlen.Energiesteuer(true);
        _aufA = BhkwWahlen.Aufteilung(true);
        _esP = BhkwWahlen.Energiesteuer(false);
        _aufP = BhkwWahlen.Aufteilung(false);
        _uaP = BhkwWahlen.Unternehmensart();
        _modus = BhkwWahlen.Befreiungsmodus();

        // Der Arbeitsstand entsteht EINMAL aus dem geladenen Stand. Ab hier
        // arbeitet der Dialog nur noch auf ihm; die hereingereichten Objekte
        // ruehrt er erst im OK-Weg an.
        foreach (KwkgAnlagenAngabe a in Anlagen)
        {
            _staende.Add(BhkwAnlagenstand.Aus(a));
            _anlageGeschrieben.Add(false);
            _anlageFehlversuch.Add(false);
        }
        _vorgaben = BhkwVorgabenstand.Aus(Parameter);

        // Erstauswahl wie ErsteZeileWaehlen der WinForms-Fassung.
        _aktuell = Anlagen.Count > 0 ? 0 : -1;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !_ersterAufbau) return;
        _ersterAufbau = false;
        await _wurzel.FocusAsync();
    }

    // =====================================================================
    // Anlagenwahl und Felder
    // =====================================================================

    private bool Gewaehlt(KwkgAnlagenAngabe a) => ReferenceEquals(a, Aktuelle);

    private string Wahlklasse(KwkgAnlagenAngabe a) =>
        Gewaehlt(a) ? "epos-knopf epos-anlagenwahl epos-knopf--primaer"
                    : "epos-knopf epos-anlagenwahl";

    private void Waehle(KwkgAnlagenAngabe a)
    {
        _aktuell = Anlagen.IndexOf(a);
        _meldung = "";
    }

    /// <summary>Ein Feld hat sich geaendert: den ARBEITSSTAND fortschreiben und
    /// merken. In die Datenbank geht davon nichts - das tut allein
    /// <see cref="Schreiben"/> im OK-Weg.</summary>
    private void Setze(Action aenderung)
    {
        aenderung();
        _geaendert = true;
        _meldung = "";
        _leiste?.Leeren();
    }

    private void StichtagA(DateOnly? d) => Setze(() => AktuellerStand!.Stichtag = Zeit(d));
    private void IbnA(DateOnly? d) => Setze(() => AktuellerStand!.Inbetriebnahme = Zeit(d));
    private void ArtA(int? n) => Setze(() => AktuellerStand!.Anlagenart = BhkwWahlen.WertZu(_artA, n));
    private void FallA(int? n) => Setze(() => AktuellerStand!.Eigenfall = BhkwWahlen.WertZu(_fallA, n));

    // 0 heisst "kein eigener Wert": Ein Zuschlagssatz von null waere fachlich kein
    // Satz und ein Kontingent von null keine Laufzeit - sonst kaeme niemand mehr zum
    // Projektwert zurueck (E6-Muster).
    private void SatzEinspA(double? w) => Setze(() => AktuellerStand!.SatzEinspCt = Positiv(w));
    private void SatzEigenA(double? w) => Setze(() => AktuellerStand!.SatzEigenCt = Positiv(w));
    private void KontingentA(double? w) => Setze(() => AktuellerStand!.VbhKontingent = Positiv(w));
    private void DeckelA(double? w) => Setze(() => AktuellerStand!.VbhDeckel = Positiv(w));

    // BK1: 0 heisst auch hier "nicht gepflegt" - dann waehlt § 8 keine Stufe und der
    // Kontingentvorschlag nennt den Grund statt einer Zahl.
    private void KostenanteilA(double? w) => Setze(() => AktuellerStand!.Kostenanteil = Positiv(w));
    private void EnergiesteuerA(int? n) => Setze(() => AktuellerStand!.EnergiesteuerWahl = BhkwWahlen.WertZu(_esA, n));
    private void AufteilungA(int? n) => Setze(() => AktuellerStand!.AufteilungMethode = BhkwWahlen.WertZu(_aufA, n));

    // Beim Anteil ist 0 ein GUELTIGER Wert ("keine Hilfsenergie", BF4) - er wird
    // deshalb als 0 geschrieben und nicht auf null abgebildet.
    private void HilfsAnteilA(double? w) => Setze(() => AktuellerStand!.HilfsenergieAnteil = w ?? 0);

    // AUFTRAG #325: 0 heisst "nicht gepflegt" - dieselbe Nullsemantik, die der Satz
    // im Parameterdialog hatte, und dieselbe, mit der StromPreisCtrl ihn liest.
    private void EinspeisungKwkP(double? w) => Setze(() => _vorgaben.EinspeiseverguetungKwk = Positiv(w));

    // ETAPPE BK1: Satz, Deckel, Kontingent, Tatbestand und Anlagenart des PROJEKTS
    // haben keinen Schreibweg mehr - sie stehen an der Anlage. Die Spalten bleiben in
    // der Datenbank stehen (Aufraeumkandidaten) und werden mit dem Arbeitsstand
    // WERTGLEICH zurueckgeschrieben; der Dialog aendert sie nicht mehr.
    private void AbschlagP(double? w) => Setze(() => _vorgaben.KwkgAbschlagNegativ = w ?? 0);
    private void PauschalP(bool b) => Setze(() => _vorgaben.KwkgPauschalmodus = b);
    private void StichtagP(DateOnly? d) => Setze(() => _vorgaben.KwkgStichtag = Zeit(d));
    private void IbnP(DateOnly? d) => Setze(() => _vorgaben.KwkgInbetriebnahme = Zeit(d));

    private void EnergiesteuerP(int? n) => Setze(() => _vorgaben.EnergiesteuerWahl =
        WertMitVorgabe(_esP, n, DbWerte.ENERGIESTEUER_WAHL_KEINE));
    private void AufteilungP(int? n) => Setze(() => _vorgaben.AufteilungMethode =
        WertMitVorgabe(_aufP, n, DbWerte.AUFTEILUNG_VOLLER_BRENNSTOFF));
    private void UnternehmensartP(int? n) => Setze(() => _vorgaben.Unternehmensart =
        WertMitVorgabe(_uaP, n, DbWerte.UNTERNEHMENSART_KEIN_PROD_GEWERBE));

    private void RaeumlichP(bool b) => Setze(() => _vorgaben.RaeumlicherZusammenhang = b);
    private void HocheffizienzP(bool b) => Setze(() => _vorgaben.HocheffizienzNachweis = b);

    // ETAPPE B6: Der Modus des § 9 Abs. 1 Nr. 3 StromStG. Die Vorgabe AUSWEIS steht
    // auch dann, wenn die Liste nichts hergibt - sie ist der Rechenstand, nicht eine
    // Leerstelle.
    private void BefreiungsmodusP(int? n) => Setze(() => _vorgaben.StromsteuerBefreiungModus =
        WertMitVorgabe(_modus, n, DbWerte.STROMST_BEFREIUNG_MODUS_AUSWEIS));

    // 0 % Jahresnutzungsgrad heisst "nicht erfasst": Ein Nutzungsgrad von null ist
    // fachlich kein Wert, und die Begruendung soll "nicht erfasst" von "erfasst und
    // zu niedrig" unterscheiden koennen (E4-Muster).
    private void NutzungsgradP(double? w) => Setze(() => _vorgaben.Jahresnutzungsgrad = Positiv(w));

    /// <summary>Wie <c>GewaehltMitVorgabe</c> der WinForms-Fassung: Diese drei Listen
    /// haben keinen Leereintrag, ein unbekannter Index faellt auf die Vorgabe.</summary>
    private static string WertMitVorgabe(IReadOnlyList<Steuerwahl> liste, int? n, string vorgabe)
    {
        string w = BhkwWahlen.WertZu(liste, n);
        return string.IsNullOrEmpty(w) ? vorgabe : w;
    }

    private static DateOnly? Tag(DateTime? d) => d.HasValue ? DateOnly.FromDateTime(d.Value) : null;

    private static DateTime? Zeit(DateOnly? d) => d.HasValue ? d.Value.ToDateTime(TimeOnly.MinValue) : null;

    /// <summary>0 und leer bedeuten dasselbe: kein eigener Wert.</summary>
    private static double? Positiv(double? w) => w.HasValue && w.Value > 0 ? w : null;

    // =====================================================================
    // Herleitung und Warnzeilen (reine Anzeige, Quellen des Bestands)
    // =====================================================================

    // =====================================================================
    // ETAPPE BK1 — die drei Vorschlaege AM FELD
    //
    // Je Feld eine Grundlage, ein Erlaubt und ein Uebernehmen. Gerechnet wird
    // NICHTS: Saetze und Herleitung kommen aus KwkgSatzRechner, das Kontingent aus
    // KwkgKontingentRechner - dieselben reinen Funktionen, die auch der Rechenkern
    // ruft (BW8, Leitentscheidung L9). Uebernommen wird in den ARBEITSSTAND;
    // geschrieben wird wie jede andere Eingabe erst beim OK.
    // =====================================================================

    /// <summary>
    /// Grundlage des Einspeisesatzes: Tranchen, Norm, Jahr — und AUFTRAG #351 (U23)
    /// der Vermerk zur Herkunft des Feldes: „Vorschlag", wenn das Feld dem Vorschlag
    /// entspricht, sonst „eigener Wert {0} — Vorschlag {1}". Der Vergleich laeuft auf
    /// den vier Stellen des Feldes (<c>KwkgSatzHerkunft</c>), nicht auf der Anzeige.
    /// </summary>
    private string GrundlageEinsp()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return "";
        KwkgSatzVorschlag v = Vorschlag(a);
        return MitHerkunft(string.Format(_t.HerleitungEinsp,
                                         KwkgSatzHerkunft.Satz(v.SatzEinspeisungCt, BhwTexte.Kultur),
                                         v.HerleitungEinspeisung),
                           AktuellerStand?.SatzEinspCt ?? 0, v.SatzEinspeisungCt);
    }

    /// <summary>Grundlage des Eigenstromsatzes: Tranchen, Norm des gewaehlten
    /// Tatbestands, Jahr — mit demselben Herkunftsvermerk wie die Einspeisung.</summary>
    private string GrundlageEigen()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return "";
        KwkgSatzVorschlag v = Vorschlag(a);
        return MitHerkunft(string.Format(_t.HerleitungEigen,
                                         KwkgSatzHerkunft.Satz(v.SatzEigenCt, BhwTexte.Kultur),
                                         v.HerleitungEigen),
                           AktuellerStand?.SatzEigenCt ?? 0, v.SatzEigenCt);
    }

    /// <summary>
    /// AUFTRAG #351 (U23) — haengt den Herkunftsvermerk an eine Grundlagenzeile. Der
    /// Text entsteht im Kern, damit Dialog, Erloesrubrik, Bericht und Vorschau
    /// denselben Satz fuehren; der Dialog vergleicht den ARBEITSSTAND (was beim
    /// Speichern gerechnet wuerde), nicht den gebuchten Lauf.
    /// </summary>
    private static string MitHerkunft(string grundlage, double angesetztCt, double vorschlagCt)
    {
        string vermerk = KwkgSatzHerkunft.Vermerk(angesetztCt, vorschlagCt, BhwTexte.Kultur);
        return vermerk.Length == 0 ? grundlage : grundlage + " · " + vermerk;
    }

    /// <summary>Grundlage des Kontingents: Stufe des § 8 aus Anlagenart und
    /// Kostenanteil DIESER Anlage.</summary>
    private string GrundlageKontingent()
    {
        if (AktuellerStand is null) return "";
        KwkgKontingentVorschlag v = Kontingentvorschlag();
        return string.Format(_t.HerleitungKontingent,
                             v.KontingentH.ToString("N0", BhwTexte.Kultur), v.Herleitung);
    }

    /// <summary>Ohne elektrische Nennleistung gibt es keine Leistungsstaffel — und
    /// damit keinen Satz (§ 7 Abs. 1/2).</summary>
    private bool VorschlagEinspErlaubt => Aktuelle is not null && Aktuelle.PelKW > 0;

    /// <summary>Zusaetzlich zur Leistung braucht der Eigenstromsatz den Tatbestand des
    /// § 6 Abs. 3; ohne ihn gibt es den Zuschlag nach § 7 Abs. 2 nicht.</summary>
    private bool VorschlagEigenErlaubt =>
        VorschlagEinspErlaubt && AktuellerStand is not null &&
        !string.IsNullOrEmpty(AktuellerStand.Eigenfall) &&
        !string.Equals(AktuellerStand.Eigenfall, DbWerte.KWKG_EIGENFALL_KEINER, StringComparison.Ordinal);

    /// <summary>Der Sperrgrund des Eigenstromsatzes nennt den ERSTEN fehlenden
    /// Baustein — die Leistung vor dem Tatbestand, weil ohne sie auch der Tatbestand
    /// nichts nuetzt.</summary>
    private string SperrgrundEigen => VorschlagEinspErlaubt ? _t.SperrOhneEigenfall : _t.SperrOhnePel;

    /// <summary>Ohne Anlagenart waehlt § 8 keine Kontingentstufe.</summary>
    private bool VorschlagKontingentErlaubt =>
        AktuellerStand is not null && !string.IsNullOrEmpty(AktuellerStand.Anlagenart) &&
        !Kontingentvorschlag().Unvollstaendig;

    private void VorschlagEinspUebernehmen()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        BhkwAnlagenstand? st = AktuellerStand;
        if (a is null || st is null || !VorschlagEinspErlaubt) return;
        KwkgSatzVorschlag v = Vorschlag(a);
        Setze(() => st.SatzEinspCt = Positiv(v.SatzEinspeisungCt));
    }

    private void VorschlagEigenUebernehmen()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        BhkwAnlagenstand? st = AktuellerStand;
        if (a is null || st is null || !VorschlagEigenErlaubt) return;
        KwkgSatzVorschlag v = Vorschlag(a);
        Setze(() => st.SatzEigenCt = Positiv(v.SatzEigenCt));
    }

    private void VorschlagKontingentUebernehmen()
    {
        BhkwAnlagenstand? st = AktuellerStand;
        if (st is null || !VorschlagKontingentErlaubt) return;
        KwkgKontingentVorschlag v = Kontingentvorschlag();
        Setze(() => st.VbhKontingent = Positiv(v.KontingentH));
    }

    /// <summary>Der Kontingentvorschlag der gewaehlten Anlage — aus IHRER Anlagenart
    /// und IHREM Kostenanteil, mit dem Jahr, das auch der Satzvorschlag nimmt.</summary>
    private KwkgKontingentVorschlag Kontingentvorschlag()
    {
        BhkwAnlagenstand? st = AktuellerStand;
        if (st is null)
            return new KwkgKontingentVorschlag { Unvollstaendig = true };
        return KwkgKontingentRechner.Ableiten(st.Anlagenart, st.Kostenanteil ?? 0,
                                              Vorschlagsjahr(), Katalog, BhwTexte.Kultur);
    }

    /// <summary>Der Vorschlag fuer eine Anlage - mit dem Inbetriebnahmejahr DIESER
    /// Anlage, ersatzweise dem der Projektvorgabe (Muster der abgeloesten
    /// Modulmaske aus E6).</summary>
    private KwkgSatzVorschlag Vorschlag(KwkgAnlagenAngabe a)
    {
        BhkwAnlagenstand s = Stand(a);
        return KwkgSatzRechner.Vorschlag(a.PelKW, Vorschlagsjahr(), s.Anlagenart, s.Eigenfall,
                                         Katalog, BhwTexte.Kultur);
    }

    /// <summary>Das Stichtagsjahr aller Katalogvorschlaege der gewaehlten Anlage: ihr
    /// Inbetriebnahmejahr, ersatzweise der Foerderbeginn des Projekts, sonst das
    /// naechste Jahr (Planungsfall) — Muster der abgeloesten Modulmaske aus E6.</summary>
    private int Vorschlagsjahr()
    {
        DateTime? ibn = AktuellerStand?.Inbetriebnahme;
        if (ibn.HasValue) return ibn.Value.Year;
        return _vorgaben.KwkgInbetriebnahme.HasValue
             ? _vorgaben.KwkgInbetriebnahme.Value.Year
             : DateTime.Now.Year + 1;
    }

    /// <summary>
    /// Die drei Warnzeilen der Gruppe 1 (Konzept § 6.1). <b>Reine Anzeige</b> - die
    /// Grenzwerte kommen aus demselben Gesetzeskatalog, den auch der Rechenweg liest
    /// (<c>KWKG_AUSSCHREIBUNG_GRENZE_KW</c>, <c>STROMST_GRENZE_BEFREIUNG_9_1_3_KW</c>),
    /// mit demselben Rueckfall. Ueber den Ausschluss entscheidet der Rechenweg, nicht
    /// diese Zeile.
    /// </summary>
    private IReadOnlyList<string> Anlagenwarnungen()
    {
        int jahr = _vorgaben.KwkgInbetriebnahme.HasValue
                 ? _vorgaben.KwkgInbetriebnahme.Value.Year : DateTime.Now.Year;
        double grenzeAusschreibung = Katalogwert(DbWerte.GESETZ_KWKG_AUSSCHREIBUNG_GRENZE, jahr,
                                                 GrenzeAusschreibungRueckfall);
        double grenzeStromsteuer = Katalogwert(DbWerte.GESETZ_STROMST_GRENZE_BEFREIUNG, jahr,
                                               GrenzeStromsteuerRueckfall);

        var ausschreibung = new List<string>();
        var ueberStromsteuer = new List<string>();
        var heizoel = new List<string>();
        foreach (KwkgAnlagenAngabe a in Anlagen)
        {
            if (a.PelKW > grenzeAusschreibung) ausschreibung.Add(a.Bezeichner);
            if (a.PelKW > grenzeStromsteuer) ueberStromsteuer.Add(a.Bezeichner);
            DateTime? ibnStand = Stand(a).Inbetriebnahme;
            int ibn = ibnStand.HasValue ? ibnStand.Value.Year : jahr;
            if (a.Heizoel && ibn >= 2025) heizoel.Add(a.Bezeichner);
        }

        var zeilen = new List<string>();
        var k = BhwTexte.Kultur;
        if (ausschreibung.Count > 0)
            zeilen.Add(string.Format(_t.WAusschreibung, string.Join(", ", ausschreibung),
                                     grenzeAusschreibung.ToString("N0", k)));
        if (ueberStromsteuer.Count > 0)
            zeilen.Add(string.Format(_t.WStromsteuer, string.Join(", ", ueberStromsteuer),
                                     grenzeStromsteuer.ToString("N0", k)));
        if (heizoel.Count > 0)
            zeilen.Add(string.Format(_t.WHeizoel, string.Join(", ", heizoel)));
        return zeilen;
    }

    private double Katalogwert(string schluessel, int jahr, double rueckfall)
    {
        try
        {
            GesetzParameter? p = Katalog is null ? null : Katalog(schluessel, jahr);
            if (p is not null && p.Wert.HasValue && p.Wert.Value > 0) return p.Wert.Value;
        }
        catch { /* ein stummer Katalog darf keine Warnzeile verhindern */ }
        return rueckfall;
    }

    // =====================================================================
    // Ergebnisse des Laufs
    // =====================================================================

    /// <summary>
    /// Die Ergebnisse der Gruppe im Szenario „Erwartet" - EINMAL beschafft.
    ///
    /// <para><b>Der Lauf hat Vorrang vor der Datenbank.</b> Reicht der Wirt seine
    /// Liste durch, wird sie genommen: Nur sie traegt Mengenkette und Kohaerenzzeilen,
    /// die beide nicht persistiert sind. Ohne durchgereichten Lauf bleibt der gebuchte
    /// Stand - er traegt die Vorschauzahlen und die Steuerherkunft.</para>
    /// </summary>
    private List<WirtschaftlichkeitErgebnis> Ergebnisse()
    {
        if (_ergebnisCache is not null) return _ergebnisCache;

        var ausLauf = new List<WirtschaftlichkeitErgebnis>();
        foreach (WirtschaftlichkeitErgebnis e in ErgebnisseAusLauf)
            if (e is not null && string.Equals(e.Szenario, WirtschaftlichkeitSzenario.ERWARTET,
                                               StringComparison.Ordinal))
                ausLauf.Add(e);
        if (ausLauf.Count > 0) { _ergebnisCache = ausLauf; return _ergebnisCache; }

        _ergebnisCache = new List<WirtschaftlichkeitErgebnis>();
        if (ErgebnisseLaden is null) return _ergebnisCache;
        try
        {
            var ids = new List<int>();
            foreach (KwkgAnlagenAngabe a in Anlagen)
                if (!ids.Contains(a.IdProjekt)) ids.Add(a.IdProjekt);
            if (!ids.Contains(IdStamm)) ids.Add(IdStamm);
            foreach (WirtschaftlichkeitErgebnis e in ErgebnisseLaden(ids))
                if (e is not null && string.Equals(e.Szenario, WirtschaftlichkeitSzenario.ERWARTET,
                                                   StringComparison.Ordinal))
                    _ergebnisCache.Add(e);
        }
        catch { /* ohne gebuchten Stand bleiben Vorschau und Herkunft leer */ }
        return _ergebnisCache;
    }

    /// <summary>Die Modulzeile des zuletzt gebuchten Laufs zu einer Anlage - ueber den
    /// Bezeichner, so wie die Rechnung selbst zuordnet.</summary>
    private KwkgModulNachweis? ModulNachweis(KwkgAnlagenAngabe a)
    {
        foreach (WirtschaftlichkeitErgebnis e in Ergebnisse())
        {
            if (e.IdProjekt != a.IdProjekt || e.KwkgModule is null) continue;
            foreach (KwkgModulNachweis n in e.KwkgModule)
                if (string.Equals(n.Bezeichner, a.Bezeichner, StringComparison.OrdinalIgnoreCase))
                    return n;
        }
        return null;
    }

    /// <summary>
    /// Die Mengenkette der Gruppe 5 aus dem <b>Bestand</b>: <c>KwkgModulNachweis</c>
    /// fuehrt seit B3b Brutto − Hilfsstrom = Netto → Eigen/Einspeisung je Anlage. Ohne
    /// gebuchten Lauf steht hier ein Hinweis - nachgerechnet wird nichts.
    /// </summary>
    private IReadOnlyList<string> Mengenkette()
    {
        KwkgAnlagenAngabe? a = Aktuelle;
        if (a is null) return Array.Empty<string>();
        KwkgModulNachweis? n = ModulNachweis(a);
        if (n is null) return new[] { _t.HOhneLauf };

        var k = BhwTexte.Kultur;
        return new[]
        {
            string.Format(_t.HKette1, n.StromBruttoMWh.ToString("N3", k),
                          n.HilfsstromMWh.ToString("N3", k), n.StromNettoMWh.ToString("N3", k)),
            string.Format(_t.HKette2, n.EigenMWh.ToString("N3", k),
                          n.EinspeisungMWh.ToString("N3", k))
        };
    }

    /// <summary>
    /// Die steuerlichen Kohaerenzzeilen des letzten Laufs.
    ///
    /// <para><b>Warum ein Block fuer beide Steuerseiten</b> (Abweichung A-2 der
    /// Feldkarte, begruendet): <c>KohaerenzHinweis</c> traegt Schwere, Text und Betrag,
    /// aber kein Artmerkmal. Eine Aufteilung auf „Energiesteuer" und „Stromsteuer"
    /// ginge nur ueber den Anzeigetext - also sprachabhaengiges Textraten - oder ueber
    /// eine Aenderung an <c>KohaerenzPruefung</c>, die zum gesperrten Rechenwerk
    /// gehoert.</para>
    /// </summary>
    public List<KohaerenzHinweis> SteuerlicheHinweise()
    {
        List<string> doppelTexte = DoppelTexte();
        var steuer = new List<KohaerenzHinweis>();
        foreach (KohaerenzHinweis h in AusLaufHinweise())
        {
            // Die Doppelpflege steht in Gruppe 5 - sie hier ein zweites Mal zu zeigen,
            // waere dieselbe Aussage an zwei Stellen.
            if (doppelTexte.Contains(h.Text)) continue;
            if (!steuer.Exists(x => string.Equals(x.Text, h.Text, StringComparison.Ordinal)))
                steuer.Add(h);
        }
        return steuer;
    }

    /// <summary>Die Doppelpflegezeilen der Gruppe 5 - aus der laufunabhaengigen
    /// Pruefung und, falls derselbe Text auch im Lauf steht, entdoppelt.</summary>
    public List<KohaerenzHinweis> Doppelpflegehinweise()
    {
        var liste = new List<KohaerenzHinweis>();
        foreach (KohaerenzHinweis h in Doppelpflege)
            if (h is not null && !string.IsNullOrEmpty(h.Text) &&
                !liste.Exists(x => string.Equals(x.Text, h.Text, StringComparison.Ordinal)))
                liste.Add(new KohaerenzHinweis
                { Schwere = KohaerenzSchwere.WARNUNG, Text = h.Text, Betrag = h.Betrag });

        List<string> doppelTexte = DoppelTexte();
        foreach (KohaerenzHinweis h in AusLaufHinweise())
            if (doppelTexte.Contains(h.Text) &&
                !liste.Exists(x => string.Equals(x.Text, h.Text, StringComparison.Ordinal)))
                liste.Add(h);
        return liste;
    }

    private List<string> DoppelTexte()
    {
        var l = new List<string>();
        foreach (KohaerenzHinweis h in Doppelpflege)
            if (h is not null && !string.IsNullOrEmpty(h.Text) && !l.Contains(h.Text)) l.Add(h.Text);
        return l;
    }

    private List<KohaerenzHinweis> AusLaufHinweise()
    {
        var l = new List<KohaerenzHinweis>();
        foreach (WirtschaftlichkeitErgebnis e in Ergebnisse())
            if (e.KohaerenzHinweise is not null)
                foreach (KohaerenzHinweis h in e.KohaerenzHinweise)
                    if (h is not null && !string.IsNullOrEmpty(h.Text)) l.Add(h);
        return l;
    }

    /// <summary>Die Schwere einer Kohaerenzzeile als Farbklang. ETAPPE B6: Die
    /// positive Nennung (Fall 1) ist gruen mit Haken - dieselbe Stufe, mit der die
    /// Anwendung sonst einen gelungenen Vorgang meldet.</summary>
    private static WarnStufe Stufe(string schwere)
    {
        if (string.Equals(schwere, KohaerenzSchwere.WARNUNG, StringComparison.Ordinal))
            return WarnStufe.Warnung;
        if (string.Equals(schwere, KohaerenzSchwere.BESTAETIGUNG, StringComparison.Ordinal))
            return WarnStufe.Erfolg;
        return WarnStufe.Hinweis;
    }

    /// <summary>Die im Lauf ausgewiesene Herkunft der Steuersaetze (Fundstelle, Wert,
    /// Einheit, Jahr, Status) - die Herleitungszeile der Gruppe 3.</summary>
    private string Steuerherkunft()
    {
        foreach (WirtschaftlichkeitErgebnis e in Ergebnisse())
            if (e.IdProjekt == IdStamm && !string.IsNullOrEmpty(e.SteuerHerkunft))
                return e.SteuerHerkunft;
        return _t.EOhneHerkunft;
    }

    /// <summary>
    /// Vorschau (Gruppe 6) — die Erloesrubrik des gebuchten Laufs, Zeile fuer Zeile
    /// aus DERSELBEN Quelle wie Ergebnisreiter, Word und Excel
    /// (<see cref="WirtschaftlichkeitZeilen.Kennzahlen"/>, gefiltert mit
    /// <see cref="WirtschaftlichkeitZeilen.Sichtbare"/>).
    ///
    /// <para><b>ETAPPE B7.</b> Hier stand bis dahin eine EIGENE Liste aus fuenf von
    /// Hand zusammengestellten Zahlen — unter anderem „Stromsteuer p. a." als Summe
    /// aus Befreiung und Entlastung, also aus einer Position, die im Kapitalwert steht,
    /// und einer, die nur ausgewiesen wird. Genau diese Vermischung trennt die Rubrik:
    /// Block A ist Zahlung, Block B ist Ausweis. Eine zweite Liste an dieser Stelle
    /// hiesse, die Trennung ein zweites Mal zu treffen — und beim naechsten Zusatz
    /// eine der beiden zu vergessen.</para>
    ///
    /// <para>Der Dialog rechnet weiterhin nichts nach: Ohne gebuchten Lauf steht hier
    /// ein Hinweis statt einer Zahl.</para>
    /// </summary>
    private IReadOnlyList<(string Titel, string Wert)> Vorschau()
    {
        List<WirtschaftlichkeitErgebnis> alle = Ergebnisse();
        WirtschaftlichkeitErgebnis? e = null;
        foreach (WirtschaftlichkeitErgebnis x in alle)
            if (x.IdProjekt == IdStamm) { e = x; break; }

        if (e is null) return new[] { (_t.VOhneLauf, "") };

        var k = BhwTexte.Kultur;
        var zeilen = new List<(string, string)>();
        foreach (WirtZeile z in WirtschaftlichkeitZeilen.Sichtbare(
                     WirtschaftlichkeitZeilen.Kennzahlen(alle, null), alle))
        {
            // Nur die Rubrik — die uebrigen Kennzahlen stehen im Ergebnisreiter, und
            // eine vollstaendige Tabelle waere in einem Anlagendialog kein Ueberblick.
            if (z.Block != WirtZeile.BLOCK_A && z.Block != WirtZeile.BLOCK_B) continue;
            zeilen.Add(((z.Einzug > 0 ? "    " : "") + z.Titel,
                        z.IstUeberschrift ? "" : z.Anzeige(e, k)));
        }
        if (zeilen.Count == 0) zeilen.Add((_t.VOhneRubrik, ""));
        zeilen.Add((string.Format(_t.VStand, e.Zeitstempel.ToString("g", k)), ""));
        return zeilen;
    }

    // =====================================================================
    // Speichern und Schliessen
    // =====================================================================

    /// <summary>
    /// Der EINZIGE Schreibweg des Dialogs. Die Reihenfolge ist Absicht: erst die
    /// Anlagenzeilen in Listenreihenfolge (elf Spalten, K7), dann die
    /// Projektvorgaben — so steht der Projektwert nie vor den Zeilen, die ihn
    /// ueberschreiben. Der Arbeitsstand wird dabei Zeile fuer Zeile auf das
    /// hereingereichte Objekt gelegt und dieses geschrieben.
    ///
    /// <para>Scheitert ein Schritt, bleibt der Dialog OFFEN und nennt die Zahl der
    /// gescheiterten Saetze — derselbe Wortlaut wie zuvor (<c>BHW_MSG_FEHLER</c>).
    /// Was geschrieben ist, gilt und wird bei einem zweiten OK nicht wiederholt;
    /// die uebrigen Schritte laufen trotz eines Fehlschlags weiter, damit die Zahl
    /// stimmt.</para>
    ///
    /// <para><b><paramref name="nurBeiAenderung"/> — der Sprungweg (#289).</b> Die
    /// zwei Sprungknoepfe schreiben nur, was sich seit dem Laden WERTLICH
    /// geaendert hat: Wer nur nachschlagen will, soll keinen Schreibzugriff
    /// ausloesen, und ein Schreiben ohne Aenderung ueberschriebe in einer
    /// Mehrbenutzerlage fremde Aenderungen mit dem eigenen geladenen Stand.
    /// Gemessen wird am Wert (<c>BhkwAnlagenstand.Gleicht</c>,
    /// <c>BhkwVorgabenstand.Gleicht</c>), nicht an einem Merkflag - ein Flag
    /// kippt schon bei einem Fokuswechsel. Der OK-Weg bleibt unberuehrt: Er
    /// schreibt wie bisher jede noch nicht geschriebene Zeile.</para>
    /// </summary>
    private async Task Schreiben(BhkwSprung sprung, bool nurBeiAenderung = false)
    {
        int fehler = 0;
        bool geschrieben = false;

        for (int i = 0; i < Anlagen.Count && i < _staende.Count; i++)
        {
            if (_anlageGeschrieben[i]) continue;
            // ETAPPE E2: Ein GESCHEITERTER Schritt bleibt fällig. Anwenden ist unten
            // schon gelaufen, Arbeitsstand und Objekt gleichen einander seither — ohne
            // das Merkmal hielte die Änderungsprüfung den Schritt für erledigt, und
            // der zweite OK schlösse den Dialog, ohne je geschrieben zu haben.
            if (nurBeiAenderung && !_anlageFehlversuch[i] &&
                _staende[i].Gleicht(Anlagen[i])) continue;

            _staende[i].Anwenden(Anlagen[i]);
            if (SpeichereAnlage is not null && !SpeichereAnlage(Anlagen[i]))
            { fehler++; _anlageFehlversuch[i] = true; continue; }
            _anlageGeschrieben[i] = true;
            _anlageFehlversuch[i] = false;
            geschrieben = true;
        }

        if (!_vorgabenGeschrieben &&
            !(nurBeiAenderung && !_vorgabenFehlversuch && _vorgaben.Gleicht(Parameter)))
        {
            // K3 = a: Der Modus des § 9 Abs. 1 Nr. 3 reist seit Etappe B6 mit — die
            // Spalte Tab_ProjektWirtschaftlichkeit.Stromst_Befreiung_Modus gibt es
            // seit Schemaschritt 88, und der Arbeitsstand fuehrt ihn
            // (BhkwVorgabenstand.StromsteuerBefreiungModus). Anwenden schreibt ihn
            // mit; Gleicht vergleicht ihn mit.
            _vorgaben.Anwenden(Parameter);
            if (SpeichereVorgaben is not null && !SpeichereVorgaben(Parameter))
            { fehler++; _vorgabenFehlversuch = true; }
            else { _vorgabenGeschrieben = true; _vorgabenFehlversuch = false; geschrieben = true; }
        }

        // Scheitert ein Schritt, findet der Sprung NICHT statt und die Maske bleibt
        // offen (Muster Ae25) - derselbe Ausgang wie beim OK-Weg.
        if (fehler > 0)
        {
            _meldung = string.Format(_t.MsgFehler, fehler);
            _leiste?.Fehler();
            return;
        }

        // Der OK-Weg meldet "gespeichert" wie bisher unbedingt; der Sprungweg nur,
        // wenn wirklich etwas geschrieben wurde - sonst haette der Wirt keinen
        // Grund, neu zu rechnen.
        if (geschrieben || !nurBeiAenderung)
        {
            _gespeichert = true;
            _ergebnisCache = null;   // der gebuchte Lauf ist ueberholt - neu einlesen
        }
        _geaendert = false;
        _meldung = "";
        await Schliessen(sprung);
    }

    /// <summary>
    /// Der Rueckruf der Leiste. <b>OK</b> schreibt den ganzen Arbeitsstand und
    /// schliesst; scheitert ein Schritt, bleibt der Dialog offen und nennt den Grund.
    /// <b>Abbrechen</b> verlaesst ihn ohne einen einzigen Schreibzugriff.
    ///
    /// <para><b>ETAPPE E2 (Mockup-Pruefung 04/B30).</b> Auch der OK-Weg schreibt nur,
    /// was sich seit dem Laden geaendert hat. Die Begruendung ist dieselbe wie bei den
    /// Sprungknoepfen: Ein Schreiben ohne Aenderung ueberschriebe in einer
    /// Mehrbenutzerlage fremde Aenderungen mit dem eigenen geladenen Stand — und wer
    /// den Dialog nur oeffnet, nachsieht und mit OK schliesst, tut genau das. Der
    /// Vergleich laeuft am WERT (<c>Gleicht</c>), nicht an einem Merkflag.</para>
    /// </summary>
    private Task BeiErgebnis(bool ok)
        => ok ? Schreiben(BhkwSprung.Keiner, nurBeiAenderung: true) : Verwerfen();

    // Die zwei Sprungknoepfe nehmen den OK-Weg: Sie schreiben und schliessen. Der
    // Wirt oeffnet danach das Ziel und bringt den Dialog zurueck - ohne das
    // Schreiben waeren die Eingaben mit dem Sprung verloren, und der Satz unter den
    // Knoepfen (BHW_S_SPRUNG_HINWEIS) sagt es.
    //
    // ANWENDERENTSCHEID 15.09.2026: Sie schreiben aber NUR, wenn sich der
    // Arbeitsstand seit dem Laden wirklich geaendert hat. Wer nur nachschlagen
    // will und nichts geaendert hat, soll keinen Schreibzugriff ausloesen; ein
    // Schreiben ohne Aenderung ueberschriebe in einer Mehrbenutzerlage fremde
    // Aenderungen mit dem eigenen geladenen Stand. Ohne Unterschied springt der
    // Knopf also ohne einen einzigen Schreibaufruf.
    private Task SprungBhkwTarif() => Schreiben(BhkwSprung.BhkwTarif, nurBeiAenderung: true);

    private Task SprungStrombezug() => Schreiben(BhkwSprung.Strombezug, nurBeiAenderung: true);

    /// <summary>
    /// Wuerde ein Sprung jetzt etwas schreiben? Das ist der Fall, sobald eine
    /// Anlagenzeile oder die Projektvorgaben vom geladenen Stand abweichen. Nur
    /// dann steht der Satz unter den Knoepfen — er kuendigt das Schreiben an, und
    /// eine Ankuendigung ohne Schreiben waere falsch.
    /// </summary>
    private bool SprungSchreibtMit
    {
        get
        {
            // ETAPPE E2: Ein gescheiterter Schritt ist weiterhin fällig — die
            // Ankündigung muss ihn mitzählen, sonst verspräche sie zu wenig.
            for (int i = 0; i < Anlagen.Count && i < _staende.Count; i++)
                if (!_anlageGeschrieben[i] &&
                    (_anlageFehlversuch[i] || !_staende[i].Gleicht(Anlagen[i])))
                    return true;

            return !_vorgabenGeschrieben &&
                   (_vorgabenFehlversuch || !_vorgaben.Gleicht(Parameter));
        }
    }

    /// <summary>Ohne zu schreiben hinaus. Der Arbeitsstand faellt; die
    /// hereingereichten Objekte sind unveraendert.</summary>
    private Task Verwerfen() => Schliessen(BhkwSprung.Keiner);

    private Task Schliessen(BhkwSprung sprung) =>
        Geschlossen.InvokeAsync(new BhkwWirtschaftlichkeitErgebnis(_gespeichert, sprung));

    /// <summary>Esc wirkt wie Abbrechen — geschrieben wird nichts.</summary>
    private Task BeiTaste(KeyboardEventArgs e) =>
        e.Key == "Escape" ? Verwerfen() : Task.CompletedTask;
}
