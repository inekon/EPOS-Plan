    [Parameter] public Func<WaermepumpeAnlageDaten, Task>? EnergiekostenOeffnen { get; set; }

    /// <summary>
    /// Der Katalog für die Überlagerung „Modul-Katalog…" —
    /// <c>WPStammCtrl.Katalogfilterzeilen()</c>, seit Stufe S2.2 derselbe Weg wie
    /// in der Verwaltung. Die neun Spalten und ihre Trichter kommen aus dem Profil.
    /// </summary>
    [Parameter] public Func<IReadOnlyList<Katalogfilterzeile>>? Katalog { get; set; }

    /// <summary>Die Spalten des Katalogs — die Hülle reicht das übersetzte Profil herein.</summary>
