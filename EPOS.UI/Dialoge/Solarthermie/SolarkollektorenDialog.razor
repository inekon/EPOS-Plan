    private void KatalogNeuLaden()
    {
        _katalog = Katalogladung.Lesen(Katalogzeilen, TitelText, out _listeFehler);
        VerwendungStempeln();
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        if (_katalogZeile is null) _katalogGewaehlt = "";
        _katalogWahl.Bereinigen(_katalog.Select(z => z.Schluessel));
    }

    private void VerwendungStempeln()
        => Katalogverwendung.Stempeln(_katalog, Zeilen.Select(z => z.Bezeichner));

    private Katalogfilterzeile? Katalogsatz(string bezeichner)
    {
        if (string.IsNullOrEmpty(bezeichner)) return null;
        foreach (Katalogfilterzeile z in _katalog)
            if (z.Bezeichner == bezeichner) return z;
        return null;
    }

    /// <summary>Detail und Modulfläche der Projektzeile — aus der Projektkopie, sonst aus dem Katalog.</summary>
    private void ProjektDetailSetzen(ErzeugerZeile zeile)
    {
        _detail = (ProjektDetail is not null ? ProjektDetail(zeile) : Detail?.Invoke(zeile.Bezeichner))
                  ?? Leer(zeile.Bezeichner);
        _modulflaeche = ProjektModulflaeche is not null ? ProjektModulflaeche(zeile)
                                                        : Modulflaeche?.Invoke(zeile.Bezeichner) ?? 0;
    }

    private void ProjektZeileWaehlen(ErzeugerZeile zeile)
    {
        _projektZeile = zeile;
        _katalogZeile = null;
        _katalogGewaehlt = "";
        ProjektDetailSetzen(zeile);
        _eingaben.Anzahl = (int?)(zeile.AnzahlModule ?? 0);
        _eingaben.Neigung = zeile.Neigung ?? 0;
        _eingaben.Azimut = zeile.Azimut ?? 0;
        _eingaben.Albedo = zeile.Albedo;
        _eingaben.PumpenleistungW = zeile.SolarPumpenleistungW;
        _eingaben.VerlusteProzent = zeile.SolarkreisverlusteProzent;
        _eingaben.GraedigkeitK = zeile.SolarGraedigkeitK;
        _eingaben.SpreizungK = zeile.SolarSpreizungK;
        _eingaben.ArbeitstemperaturAusSpeicher = zeile.SolarArbeitstemperaturAusSpeicher;
        FelderNachziehen();
    }

    private void KatalogZeileWaehlen(string bezeichner)
    {
        _katalogGewaehlt = bezeichner ?? "";
        _katalogZeile = Katalogsatz(_katalogGewaehlt);
        _projektZeile = null;
        _detail = (Detail is not null ? Detail(_katalogGewaehlt) : null) ?? Leer(_katalogGewaehlt);
        _modulflaeche = Modulflaeche?.Invoke(_katalogGewaehlt) ?? 0;
        FelderNachziehen();
    }

    private static ErzeugerDetail Leer(string name)
        => new(name, "", Array.Empty<(string, string)>());

    // =================================================================================
    // Hinzufügen und Entfernen (Sammelübernahme: je angekreuztem Satz eine Zeile)
    // =================================================================================

    private void BeiHinzu()
    {
        if (Aufnehmen is null) return;
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        ErzeugerZeile? letzte = null;
        foreach (Katalogfilterzeile z in ziele)
        {
            AufnahmeErgebnis aufnahme = Aufnehmen(z.Id);
            if (aufnahme.Meldung.Length > 0) Melden(aufnahme.Meldung, aufnahme.Fehler);
            if (aufnahme.Zeile is null) continue;
            Zeilen.Add(aufnahme.Zeile);
            letzte = aufnahme.Zeile;
        }
        if (_katalogWahl.Anzahl > 0) KatalogKaestchenLeeren();
        if (letzte is null) return;
        VerwendungStempeln();                 // Q12
        ProjektZeileWaehlen(letzte);
    }

    private void BeiEntfernen()
    {
        List<ErzeugerZeile> ziele = ProjektZiele();
        if (ziele.Count == 0) return;
        foreach (ErzeugerZeile zeile in ziele)
        {
            Zeilen.Remove(zeile);
            Entfernen?.Invoke(zeile);
        }
        VerwendungStempeln();                 // Q12
        _projektWahl.Leeren();
        _projektZeile = null;
        _meldung = "";
        _detail = Leer("");
        if (Zeilen.Count > 0) ProjektZeileWaehlen(Zeilen[0]);
        else if (_katalog.Count > 0) KatalogZeileWaehlen(_katalog[0].Bezeichner);
    }

    /// <summary>
    /// „Übernehmen" der Anlagenfelder: schreibt den Arbeitsstand in die Zeile und reicht sie an die
    /// Hülle (Modell). Die Albedo außerhalb 0…1 gilt als leer.
    /// </summary>
    private void BeiUebernehmen()
    {
        if (_projektZeile is null) return;
        _projektZeile.AnzahlModule = _eingaben.Anzahl ?? 0;
        _projektZeile.Neigung = _eingaben.Neigung ?? 0;
        _projektZeile.Azimut = _eingaben.Azimut ?? 0;
        _projektZeile.Albedo = _eingaben.Albedo is double a && a >= 0.0 && a <= 1.0 ? a : null;
        _projektZeile.SolarPumpenleistungW = _eingaben.PumpenleistungW;
        _projektZeile.SolarkreisverlusteProzent = _eingaben.VerlusteProzent;
        _projektZeile.SolarGraedigkeitK = _eingaben.GraedigkeitK;
        _projektZeile.SolarSpreizungK = _eingaben.SpreizungK;
        _projektZeile.SolarArbeitstemperaturAusSpeicher = _eingaben.ArbeitstemperaturAusSpeicher;
        Uebernehmen?.Invoke(_projektZeile);
        Melden(MeldungUebernommen, false);
    }

    // =================================================================================
    // Alle Daten: beim Katalogsatz der Katalog, beim Projektsatz die Projektkopie
    // =================================================================================

    private void ParameterUmschalten()
    {
        _parameterOffen = !_parameterOffen;
        if (_parameterOffen) FelderHolen();
    }

    private void FelderHolen()
    {
        _felder = _projektZeile is not null
            ? ProjektsatzWege?.Lesen(_projektZeile.GeraetId)
            : Katalogfelder is null || _katalogZeile is null
                ? null
                : Katalogfelder(_katalogZeile.Bezeichner);
        _felderGeaendert = false;
        _feldFehler = false;
    }

    private void FelderNachziehen()
    {
        if (_parameterOffen && (_katalogZeile is not null || _projektZeile is not null)) { FelderHolen(); return; }
        _felder = null;
        _felderGeaendert = false;
        _feldFehler = false;
    }

    private void BeiFeldFehler((string Feldname, bool Fehler) meldung)
        => _feldFehler = meldung.Fehler;

    private void FeldGeaendert()
    {
        _felderGeaendert = true;
        _felderVermerk?.Leeren();
    }

    private void FelderSpeichern()
    {
        if (_felder is null) return;
        KatalogSpeicherErgebnis ergebnis;
        if (_projektZeile is not null)
        {
            if (ProjektsatzWege?.Speichern is null) return;
            ergebnis = ProjektsatzWege.Speichern(new[] { (_projektZeile.GeraetId, _felder) });
        }
        else
        {
            if (KatalogfelderSpeichern is null || _katalogZeile is null) return;
            ergebnis = KatalogfelderSpeichern(_katalogZeile.Bezeichner, _felder);
        }
        if (!ergebnis.Ok)
        {
            Melden(ergebnis.Meldung, true);
            _felderVermerk?.Fehler(ergebnis.Meldung);
            return;
        }
        _felderGeaendert = false;
        _meldung = "";
        _felderErfolg = ergebnis.Meldung;
        _felderVermerk?.Gespeichert();
        if (_projektZeile is not null) ProjektDetailSetzen(_projektZeile);
        else
        {
            KatalogNeuLaden();
            _detail = (Detail is not null ? Detail(_katalogGewaehlt) : null) ?? _detail;
            _modulflaeche = Modulflaeche?.Invoke(_katalogGewaehlt) ?? _modulflaeche;
        }
    }

    // =================================================================================
    // Katalogpflege und Bearbeiten je Bereich (4.6, KA-E-8, KA-E-13)
    // =================================================================================

    /// <summary>
    /// „Bearbeiten…" im Katalogfuss: ein einzelner ungesperrter Satz öffnet den vollen
    /// Katalogeditor (KA-E-13), mehrere oder gesperrte Sätze die Satzbearbeitung -
    /// gesperrte übersprungen, alle gesperrt nur lesend.
    /// </summary>
    private void BeiKatalogBearbeiten()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1 && !ziele[0].Geschuetzt && EditorGaben is not null)
        {
            _editorNeu = false;
            _neuerName = "";
            _editorGaben = EditorGaben(ziele[0].Bezeichner, false);
            return;
        }
        if (KatalogsatzWege is not null)
        {
            _bearbeitung = (Satzmarke.Katalogsatz,
                            ziele.Select(z => new Bearbeitungssatz(z.Id, z.Bezeichner, z.Geschuetzt)).ToList());
            return;
        }
        if (ziele.All(z => z.Geschuetzt)) BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
    }

    /// <summary>„Bearbeiten…" im Projektbereich: die Projektkopien der Auswahl, je Gerät einmal.</summary>
    private void BeiProjektBearbeiten()
    {
        if (ProjektsatzWege is null) return;
        var saetze = ProjektZiele().GroupBy(z => z.GeraetId)
            .Select(g => new Bearbeitungssatz(g.Key, g.First().Bezeichner, false)).ToList();
        if (saetze.Count == 0) return;
        _bearbeitung = (Satzmarke.Projektsatz, saetze);
    }

    /// <summary>Die Satzbearbeitung ist zu; gespeichert: Listen und Detail neu.</summary>
    private void BearbeitungFertig(bool gespeichert)
    {
        Satzmarke? art = _bearbeitung?.Art;
        _bearbeitung = null;
        if (!gespeichert) return;
        if (art == Satzmarke.Katalogsatz)
        {
            KatalogNeuLaden();
            if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
        }
        else if (_projektZeile is not null)
        {
            ProjektDetailSetzen(_projektZeile);
            FelderNachziehen();
        }
    }

    /// <summary>„In die Datenbank übernehmen…" (KA-E-9): die Rückfrage zu den Projektkopien der Auswahl.</summary>
    private void BeiRueckweg()
    {
        if (RueckwegWege is null) return;
        var ids = ProjektZiele().Select(z => z.GeraetId).Where(id => id > 0).Distinct().ToList();
        if (ids.Count == 0) return;
        IReadOnlyList<Rueckwegvorschlag> zeilen = RueckwegWege.Vorschau(ids);
        if (zeilen.Count == 0) return;
        _rueckweg = zeilen;
    }

    private void RueckwegFertig(string? meldung)
    {
        _rueckweg = null;
        if (meldung is null) return;
        Melden(meldung, false);
        KatalogNeuLaden();
    }

    private void BeiVergleichen()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count >= 2) _katalogliste?.Vergleichen(ziele.Select(z => z.Schluessel).ToList());
    }

    /// <summary>„Neu…": nach dem Namen der Katalogeditor im Modus Neu.</summary>
    private void NameFertig(string? name)
    {
        _namensfrage = false;
        if (string.IsNullOrWhiteSpace(name) || EditorGaben is null) return;
        _editorNeu = true;
        _neuerName = name!.Trim();
        _editorGaben = EditorGaben(_neuerName, true);
    }

    private void EditorFertig(bool _)
    {
        _editorGaben = null;
        string neu = _editorNeu ? _neuerName : "";
        _editorNeu = false;
        _neuerName = "";
        KatalogNeuLaden();
        // Ein neu angelegter Satz wird gleich gewählt; sonst bleibt die Wahl und „Alle Daten" liest neu.
        if (neu.Length > 0 && Katalogsatz(neu) is not null) { KatalogZeileWaehlen(neu); return; }
        if (_katalogZeile is not null) KatalogZeileWaehlen(_katalogZeile.Bezeichner);
        else FelderNachziehen();
    }

    /// <summary>„Löschen": ein Satz fragt nach; bei mehreren werden gesperrte übersprungen und genannt.</summary>
    private void BeiLoeschenGefragt()
    {
        List<Katalogfilterzeile> ziele = KatalogZiele();
        if (ziele.Count == 0) return;
        if (ziele.Count == 1)
        {
            _loeschziele = ziele;
            _loeschUebersprungen = new();
        }
        else
        {
            _loeschziele = ziele.Where(z => !z.Geschuetzt).ToList();
            _loeschUebersprungen = ziele.Where(z => z.Geschuetzt).ToList();
            if (_loeschziele.Count == 0)
            {
                BeiSchlossAbgelehnt(Resource.ADM_SCHLOSS_ERST_AUFHEBEN);
                return;
            }
        }
        _loeschfrage = true;
    }

    private string LoeschfrageText
    {
        get
        {
            string text = _loeschziele.Count <= 1
                ? string.Format(FrageLoeschen, _loeschziele.FirstOrDefault()?.Bezeichner ?? "")
                : string.Format(Resource.Culture, Resource.AUSWAHL_FRAGE_LOESCHEN_N, _loeschziele.Count,
                                string.Join(", ", _loeschziele.Select(z => "„" + z.Bezeichner + "“")));
            if (_loeschUebersprungen.Count > 0)
                text += " " + string.Format(Resource.Culture, Resource.SATZBEARB_UEBERSPRUNGEN,
                                            string.Join(", ", _loeschUebersprungen.Select(z => "„" + z.Bezeichner + "“")));
            return text;
        }
    }

    private void BeiLoeschfrage(bool? antwort)
    {
        _loeschfrage = false;
        List<Katalogfilterzeile> ziele = _loeschziele;
        _loeschziele = new();
        if (antwort != true || KatalogLoeschen is null || ziele.Count == 0) return;
        string fehler = "";
        bool fokusWeg = false;
        int geloescht = 0;
        foreach (Katalogfilterzeile z in ziele)
        {
            string grund = KatalogLoeschen(z.Id) ?? "";
            if (grund.Length > 0) { fehler = grund; continue; }
            geloescht++;
            if (z.Bezeichner == _katalogGewaehlt) fokusWeg = true;
        }
        if (fehler.Length > 0) Melden(fehler, true);
        if (geloescht == 0) return;
        KatalogKaestchenLeeren();
        if (fokusWeg)
        {
            _katalogZeile = null;
            _katalogGewaehlt = "";
            _detail = Leer("");
            _felder = null;
        }
        KatalogNeuLaden();
    }

    // =================================================================================
    // Abschluss
    // =================================================================================

    private void Melden(string text, bool fehler)
    {
        _meldung = text ?? "";
        _meldungStufe = fehler ? WarnStufe.Warnung : WarnStufe.Hinweis;
    }

    private Task BeiErgebnis(bool ok) => Geschlossen.InvokeAsync(ok);

    /// <summary>Der Abbrechen-Weg: schliesst ohne zu speichern. Esc und das ✕ im Kopf rufen ihn.</summary>
    private Task Abbrechen() => BeiErgebnis(false);

    /// <summary>Esc schliesst; die Überlagerungen werten ihn zuerst für sich aus. Enter bleibt unbelegt.</summary>
    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && _katalogschloss?.FrageOffen == true) return Task.CompletedTask;
        if (e.Key != "Escape") return Task.CompletedTask;
        if (_editorGaben is not null || _bearbeitung is not null || _rueckweg is not null ||
            _namensfrage || _loeschfrage)
            return Task.CompletedTask;
        return Abbrechen();
    }

    // =================================================================================
    // Schloss setzen / aufheben (AD-Q15) - derselbe Baustein wie in den Verwaltungen
    // =================================================================================

    [Parameter] public Schlossweg? Schloss { get; set; }

    private Katalogschloss? _katalogschloss;

    private bool KatalogsatzGesperrt => _katalogZeile?.Geschuetzt == true;

    /// <summary>Ist die Rückfrage des Schlosses offen (Prüfhilfe)?</summary>
    public bool Schlossfrage => _katalogschloss?.FrageOffen == true;

    private void BeiSchlossGeschaltet(string status)
    {
        KatalogNeuLaden();
        FelderNachziehen();
        Melden(status ?? "", false);
    }

    private void BeiSchlossAbgelehnt(string grund) => Melden(grund ?? "", true);
}
