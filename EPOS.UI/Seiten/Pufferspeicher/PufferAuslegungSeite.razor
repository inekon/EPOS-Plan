    // =====================================================================
    //  Schritt 4 — Ergebnis und Übernahme
    // =====================================================================

    private PufferBetriebsbildDaten? Betriebsbild
        => _ergebnis?.Zonen.FirstOrDefault(z => z.Zone == "Heizung")?.Betriebsbild
           ?? _ergebnis?.Zonen.FirstOrDefault(z => z.Zone == "Prozess")?.Betriebsbild;

    private string Vorschlagsname
        => _ergebnis is { EmpfehlungL: > 0 } e && !string.IsNullOrEmpty(Daten.BezeichnerMuster)
            ? Format(Daten.BezeichnerMuster, Z(e.EmpfehlungL))
            : "";

    private IReadOnlyList<(int Id, string Text)> Zieleintraege
    {
        get
        {
            var l = new List<(int, string)>();
            if (_idPuffer.HasValue) l.Add((0, Format(Texte.ZielAendern, _pufferName)));
            l.Add((1, Texte.ZielNeu));
            return l;
        }
    }

    // ---- Probelauf der Jahressimulation (Welle P4b) ----
    private PufferProbelaufDaten? _probelauf;
    private bool _probelaufLaeuft;

    /// <summary>Der letzte Probelauf (bunit).</summary>
    public PufferProbelaufDaten? Probelauf => _probelauf;

    private PufferProbelaufStartsDaten? ProbelaufRang1 => _probelauf is { Erfolg: true } p ? p.Rang1 : null;

    /// <summary>„kein Lauf", solange kein erfolgreicher Probelauf vorliegt.</summary>
    private string ProbelaufLeer => _probelauf is { Erfolg: true } ? "—" : Texte.ProbelaufKeinLauf;

    /// <summary>Startet den Probelauf mit der Empfehlung — nichts wird gespeichert oder übernommen.</summary>
    public async Task ProbelaufStarten()
    {
        if (Dienste?.Probelauf is null || _probelaufLaeuft) return;
        if (_veraltet || _ergebnis is null) NeuRechnen();
        _probelaufLaeuft = true;
        try
        {
            _probelauf = await Dienste.Probelauf(_eingabe.Kopie());
        }
        catch (Exception ex)
        {
            _probelauf = PufferProbelaufDaten.MitFehler(Format(Texte.ProbelaufFehler, ex.Message));
        }
        finally
        {
            _probelaufLaeuft = false;
        }
    }

    private bool Neuanlage => !_idPuffer.HasValue || _ziel == 1;

    /// <summary>Hat das Ergebnis einen Katalogvorschlag (dann steht der Schalter „Katalogsatz übernehmen")?</summary>
    private bool HatKatalogvorschlag => _ergebnis is { } e && !string.IsNullOrEmpty(e.Katalogvorschlag);

    private bool UebernahmeFrei => _ergebnis is { Zustand: PufferErgebnisZustand.Gerechnet, EmpfehlungL: > 0 } && !_veraltet;

    private void Speichern()
    {
        if (Dienste?.Speichern is null) return;
        if (_veraltet) NeuRechnen();
        string? fehler = Dienste.Speichern(_eingabe.Kopie());
        Melden(fehler ?? Texte.MeldungGespeichert, fehler is null);
    }

    private void Uebernehmen()
    {
        if (Dienste?.Uebernehmen is null) return;
        if (_veraltet || _ergebnis is null) NeuRechnen();
        if (_ergebnis is not { Zustand: PufferErgebnisZustand.Gerechnet, EmpfehlungL: > 0 })
        {
            Melden(Texte.GrundKeineEmpfehlung, false);
            return;
        }
        bool neu = Neuanlage;
        string name = neu ? (_bezeichner.Trim().Length > 0 ? _bezeichner.Trim() : Vorschlagsname) : "";
        if (neu && name.Length == 0)
        {
            Melden(Texte.GrundBezeichner, false);
            return;
        }
        PufferUebernahmeErgebnis r = Dienste.Uebernehmen(_eingabe.Kopie(),
            new PufferUebernahmeDaten(neu, name, Katalogsatz: _katalogsatz && HatKatalogvorschlag,
                                      SperrprofilSchreiben: _sperrprofilSchreiben));
        Melden(r.Text, r.Erfolg);
        if (r.Erfolg && r.IdPuffer > 0)
        {
            _idPuffer = r.IdPuffer;
            if (neu) _pufferName = name;
            _ziel = 0;
            _bezeichner = "";
        }
    }

    /// <summary>Ein weich gesperrter Übernahme-Knopf meldet seinen Grund.</summary>
    private void UebernahmeVerweigert() => Melden(Texte.GrundKeineEmpfehlung, false);

    private void Melden(string text, bool erfolg)
    {
        _meldung = text ?? "";
        _meldungErfolg = erfolg;
    }

    private string Verlustzeile(PufferKennzahlDaten k)
    {
        if (k.VerlustKwhJeTag is not double tag) return "—";
        string z = Z(tag, "N2") + " kWh/d";
        if (k.VerlustWJeK is double wk) z += " · " + Z(wk, "N2") + " W/K";
        z += " · " + (k.VerlustAusKatalog ? Texte.KzAusKatalog : Texte.KzKlasseC);
        if (k.VerlustExtrapoliert) z += " · " + Texte.KzExtrapoliert;
        return z;
    }

    private RenderFragment Kennzahl(string titel, string wert, string klasse) => @<div class="@("epos-pausl-kennzahl " + klasse)">
        <span class="epos-pausl-beschriftung">@titel</span>
        <span class="epos-pausl-kennzahl-wert">@wert</span>
    </div>;

    private RenderFragment SchrittErgebnis => @<div class="epos-pausl-schritt epos-pausl-schritt--ergebnis">
        @if (_ergebnis is null || _ergebnis.Zustand == PufferErgebnisZustand.NichtGerechnet)
        {
            <p class="epos-leisezeile epos-pausl-ergebnis-leer">@Texte.ErgebnisLeer</p>
        }
        else if (_ergebnis.Zustand == PufferErgebnisZustand.Fehler)
        {
            <Warnbanner Stufe="WarnStufe.Fehler" Text="@_ergebnis.Grund" />
        }
        else
        {
            PufferAuslegungErgebnisDaten e = _ergebnis;
            PufferKennzahlDaten kz = e.Kennzahlen;
            <Gruppenkopf Titel="@Texte.GruppeZonen" Summe="@(Z(e.EmpfehlungL) + " l")">
                <KindInhalt>
                    <table class="epos-raster epos-pausl-zonen">
                        <thead>
                            <tr>
                                <th>@Texte.SpalteZone</th>
                                <th>@Texte.SpalteBemessend</th>
                                <th>@Texte.SpalteVolumen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (PufferZoneDaten z in e.Zonen)
                            {
                                <tr @key="z.Zone" data-zone="@z.Zone">
                                    <td>@z.Name</td>
                                    <td>@(z.KeinPuffer ? Texte.KeinPuffer : z.BemessendName)</td>
                                    <td>@(Z(z.VolumenL) + " l")</td>
                                </tr>
                            }
                            <tr class="epos-pausl-summe">
                                <td>@Texte.Summe</td>
                                <td></td>
                                <td>@(Z(e.SummeL) + " l")</td>
                            </tr>
                            <tr class="epos-pausl-empfehlung">
                                <td>@Texte.Empfehlung</td>
                                <td>@e.Bemessend</td>
                                <td>@(e.EmpfehlungL > 0 ? Format(Texte.EmpfehlungZeile, Z(e.EmpfehlungL), Z(kz.KapazitaetKwh, "N1")) : Texte.KeinPuffer)</td>
                            </tr>
                        </tbody>
                    </table>
                    @if (e.UeberListenende)
                    {
                        <p class="epos-leisezeile">@Texte.UeberListenende</p>
                    }
                    @if (e.AnPraxisgrenze)
                    {
                        <p class="epos-leisezeile epos-pausl-praxisgrenze">@Texte.AnPraxisgrenze</p>
                    }
                    <div class="epos-pausl-zeile epos-pausl-katalog">
                        <span class="epos-pausl-beschriftung">@Texte.Katalogvorschlag</span>
                        <span>@(e.Katalogvorschlag.Length > 0 ? e.Katalogvorschlag : Texte.KatalogKeiner)</span>
                    </div>
                </KindInhalt>
            </Gruppenkopf>

            <Gruppenkopf Titel="@Texte.GruppeKennzahlen">
                <KindInhalt>
                    <div class="epos-pausl-kennzahlen">
                        @if (Betriebsbild is PufferBetriebsbildDaten b)
                        {
                            @Kennzahl(Texte.KzStartsTag, Z(b.StartsJeTag, "N1"), "epos-pausl-kz-starts-tag")
                            @Kennzahl(Texte.KzStartsJahr, Z(b.StartsHeizperiode), "epos-pausl-kz-starts-jahr")
                        }
                        @Kennzahl(Texte.KzVerlustTag, Verlustzeile(kz), "epos-pausl-kz-verlust")
                        @Kennzahl(Texte.KzVerlustJahr, kz.VerlustKwhJeJahr is double ja ? Z(ja) + " kWh/a" : "—", "epos-pausl-kz-betriebsverlust")
                        @Kennzahl(Texte.KzKapazitaet, Z(kz.KapazitaetKwh, "N1") + " kWh", "epos-pausl-kz-kapazitaet")
                        @Kennzahl(Texte.KzNutzanteil, Z(kz.Nutzanteil * 100) + " %", "epos-pausl-kz-nutzanteil")
                        @if (AbStandard && kz.FaustwertL is double f)
                        {
                            @Kennzahl(Texte.KzFaustwert, Z(f) + " l", "epos-pausl-kz-faustwert")
                        }
                        @if (kz.LiterJePerson is double lp)
                        {
                            @Kennzahl(Texte.KzJePerson, Z(lp) + " l", "epos-pausl-kz-je-person")
                        }
                        @if (kz.ZonenanteilHeizung is double anteil)
                        {
                            @Kennzahl(Texte.KzZonenanteil, Z(anteil * 100) + " %", "epos-pausl-kz-zonenanteil")
                            @Kennzahl(Texte.KzSchichten, Z(kz.SchichtenMindest), "epos-pausl-kz-schichten")
                        }
                    </div>
                    @if (kz.BandMinL is double bmin && kz.BandMaxL is double bmax)
                    {
                        <Herleitungszeile Text="@Format(Texte.Band, Z(bmin), Z(bmax))" />
                    }
                    @if (kz.BandWpMinL is double wmin && kz.BandWpMaxL is double wmax)
                    {
                        <Herleitungszeile Text="@Format(Texte.BandWp, Z(wmin), Z(wmax))" />
                    }
                </KindInhalt>
            </Gruppenkopf>

            <Gruppenkopf Titel="@Texte.ProbelaufGruppe">
                <KindInhalt>
                    <table class="epos-raster epos-pausl-probelauf">
                        <thead>
                            <tr>
                                <th>@Texte.ProbelaufSpalteGroesse</th>
                                <th>@Texte.ProbelaufSpalteAuslegung</th>
                                <th>@Texte.ProbelaufSpalteLauf</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="epos-pausl-probelauf-tag">
                                <td>@Texte.KzStartsTag</td>
                                <td>@(Betriebsbild is PufferBetriebsbildDaten bt ? Z(bt.StartsJeTag, "N1") : "—")</td>
                                <td>@(ProbelaufRang1 is PufferProbelaufStartsDaten rt ? Z(rt.StartsJeTag, "N1") : ProbelaufLeer)</td>
                            </tr>
                            <tr class="epos-pausl-probelauf-heizperiode">
                                <td>@Texte.KzStartsJahr</td>
                                <td>@(Betriebsbild is PufferBetriebsbildDaten bh ? Z(bh.StartsHeizperiode) : "—")</td>
                                <td>@(ProbelaufRang1 is PufferProbelaufStartsDaten rh ? Z(rh.StartsHeizperiode) : ProbelaufLeer)</td>
                            </tr>
                            <tr class="epos-pausl-probelauf-jahr">
                                <td>@Texte.ProbelaufStartsJahr</td>
                                <td>—</td>
                                <td>@(ProbelaufRang1 is PufferProbelaufStartsDaten rj ? Z(rj.StartsJahr) : ProbelaufLeer)</td>
                            </tr>
                            <tr class="epos-pausl-probelauf-deckung">
                                <td>@Texte.ProbelaufDeckung</td>
                                <td>@(Betriebsbild is PufferBetriebsbildDaten bd ? Z(bd.Deckungsgrad * 100) + " %" : "—")</td>
                                <td>@(_probelauf is { Erfolg: true, Deckung: double dk } ? Z(dk * 100) + " %" : ProbelaufLeer)</td>
                            </tr>
                            @if (_probelauf is { Erfolg: true } pl)
                            {
                                @foreach (PufferProbelaufStartsDaten s in pl.Starts.Where(s => !s.Rang1))
                                {
                                    <tr class="epos-pausl-probelauf-weitere">
                                        <td>@(s.Erzeuger + ": " + Texte.ProbelaufStartsJahr)</td>
                                        <td>—</td>
                                        <td>@Z(s.StartsJahr)</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                    @if (_probelauf is { Erfolg: true } stand)
                    {
                        <p class="epos-leisezeile epos-pausl-probelauf-stand">@Format(Texte.ProbelaufStand, stand.Zeitpunkt.ToString("g", CultureInfo.CurrentCulture), Z(stand.VolumenL), Z(stand.DauerSekunden, "N1"))</p>
                        @if (stand.Rang1 is { AusReihe: true })
                        {
                            <p class="epos-leisezeile epos-pausl-probelauf-ausreihe">@Texte.ProbelaufAusReihe</p>
                        }
                        @if (stand.Abweichung)
                        {
                            <p class="epos-pausl-probelauf-abweichung" data-code="PA-STARTS-ABWEICHUNG">@stand.AbweichungText</p>
                        }
                        @if (stand.Monate.Count > 0)
                        {
                            <table class="epos-raster epos-pausl-probelauf-monate">
                                <caption>@Texte.ProbelaufFuellstand</caption>
                                <thead>
                                    <tr>
                                        <th>@Texte.ProbelaufMonat</th>
                                        <th>@Texte.ProbelaufMin</th>
                                        <th>@Texte.ProbelaufMittel</th>
                                        <th>@Texte.ProbelaufMax</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (PufferFuellstandMonatDaten m in stand.Monate)
                                    {
                                        <tr>
                                            <td>@CultureInfo.CurrentCulture.DateTimeFormat.GetAbbreviatedMonthName(m.Monat)</td>
                                            <td>@(Z(m.Min * 100) + " %")</td>
                                            <td>@(Z(m.Mittel * 100) + " %")</td>
                                            <td>@(Z(m.Max * 100) + " %")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            @if (stand.KaeltesteWocheTag > 0 && stand.WocheMin is double wmin2 && stand.WocheMittel is double wmit && stand.WocheMax is double wmax2)
                            {
                                <Herleitungszeile Text="@Format(Texte.ProbelaufWoche, stand.KaeltesteWocheTag, Z(wmin2 * 100), Z(wmit * 100), Z(wmax2 * 100))" />
                            }
                        }
                        else
                        {
                            <p class="epos-leisezeile">@Texte.ProbelaufOhneFuellstand</p>
                        }
                    }
                    else if (_probelauf is { Erfolg: false } fehl)
                    {
                        <p class="epos-pausl-probelauf-fehler">@fehl.Fehler</p>
                    }
                    @if (Dienste?.Probelauf is not null)
                    {
                        <p class="epos-leisezeile">@Texte.ProbelaufErklaerung</p>
                        <div class="epos-pausl-probelauf-knoepfe">
                            @if (_probelaufLaeuft)
                            {
                                <button type="button" class="epos-knopf epos-pausl-probelauf-knopf" aria-disabled="true" aria-busy="true">@Texte.ProbelaufLaeuft</button>
                            }
                            else
                            {
                                <button type="button" class="epos-knopf epos-pausl-probelauf-knopf" @onclick="ProbelaufStarten">@Texte.ProbelaufKnopf</button>
                            }
                        </div>
                    }
                </KindInhalt>
            </Gruppenkopf>

            <Gruppenkopf Titel="@Texte.GruppeWarnungen" Summe="@(e.Warnungen.Count > 0 ? Z(e.Warnungen.Count) : "")">
                <KindInhalt>
                    @if (e.Warnungen.Count == 0)
                    {
                        <p class="epos-leisezeile">@Texte.WarnungenLeer</p>
                    }
                    else
                    {
                        <table class="epos-raster epos-pausl-warnungen">
                            <thead>
                                <tr>
                                    <th>@Texte.SpalteCode</th>
                                    <th>@Texte.SpalteStufe</th>
                                    <th>@Texte.SpalteText</th>
                                    <th>@Texte.SpalteHerkunft</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < e.Warnungen.Count; i++)
                                {
                                    PufferWarnungDaten w = e.Warnungen[i];
                                    <tr @key="i" data-code="@w.Code" class="@(w.Warnung ? "epos-pausl-warnung" : "epos-pausl-hinweis")">
                                        <td>@w.Code</td>
                                        <td>@(w.Warnung ? Texte.StufeWarnung : Texte.StufeHinweis)</td>
                                        <td title="@(w.Klartext.Length > 0 && w.Klartext != w.Text ? w.Klartext : null)">@w.Text</td>
                                        <td>@w.Herkunft</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </KindInhalt>
            </Gruppenkopf>

            <Gruppenkopf Titel="@Texte.GruppeUebernahme">
                <KindInhalt>
                    @if (_idPuffer.HasValue)
                    {
                        <Optionsgruppe Bezeichnung="@Texte.Ziel" Eintraege="@Zieleintraege" Auswahl="@_ziel"
                                       AuswahlChanged="@((int? w) => _ziel = w ?? 0)" />
                    }
                    @if (Neuanlage)
                    {
                        <Formularraster>
                            <KindInhalt>
                                <Textfeld Bezeichnung="@Texte.Bezeichner" Wert="@_bezeichner" Platzhalter="@Vorschlagsname"
                                          WertChanged="@((string w) => _bezeichner = w ?? "")" />
                            </KindInhalt>
                        </Formularraster>
                    }
                    <Schalter Bezeichnung="@Texte.SperrprofilSchreiben" Wert="@_sperrprofilSchreiben"
                              WertChanged="@((bool w) => _sperrprofilSchreiben = w)" />
                    @if (HatKatalogvorschlag)
                    {
                        <Schalter Bezeichnung="@Texte.KatalogsatzUebernehmen" Wert="@_katalogsatz"
                                  WertChanged="@((bool w) => _katalogsatz = w)" />
                    }
                    <p class="epos-leisezeile epos-pausl-bleibt">@Texte.UebernahmeBleibt</p>
                    <div class="epos-pausl-uebernahme-knoepfe">
                        @if (Dienste?.Speichern is not null)
                        {
                            <button type="button" class="epos-knopf epos-pausl-speichern" @onclick="Speichern">@Texte.BtnSpeichern</button>
                        }
                        @if (Dienste?.Uebernehmen is not null)
                        {
                            @if (UebernahmeFrei)
                            {
                                <button type="button" class="epos-knopf epos-knopf--primaer epos-pausl-uebernehmen"
                                        @onclick="Uebernehmen">@Texte.BtnUebernehmen</button>
                            }
                            else
                            {
                                <button type="button" class="epos-knopf epos-pausl-uebernehmen" aria-disabled="true"
                                        title="@Texte.GrundKeineEmpfehlung" @onclick="UebernahmeVerweigert">@Texte.BtnUebernehmen</button>
                            }
                        }
                    </div>
                </KindInhalt>
            </Gruppenkopf>
        }
        @if (_veraltet)
        {
            <div class="epos-pausl-veraltet">
                <p class="epos-leisezeile">@Texte.VeraltetHinweis</p>
                <button type="button" class="epos-knopf epos-pausl-neurechnen" @onclick="NeuRechnen">@Texte.NeuRechnen</button>
            </div>
        }
    </div>;

    // =====================================================================
    //  Der Hilfe-Assistent
    // =====================================================================

    private PufferAuslegungKiSicht KiSicht()
    {
        return _kiSicht ??= new PufferAuslegungKiSicht
        {
            KlasseLesen = k => k switch
            {
                PufferAuslegungKiSicht.HEIZUNG => _eingabe.KlasseHeizung,
                PufferAuslegungKiSicht.BRAUCHWASSER => _eingabe.KlasseBrauchwasser,
                _ => _eingabe.KlasseProzess
            },
            KlasseSetzen = (k, w) => Schalten(() =>
            {
                if (k == PufferAuslegungKiSicht.HEIZUNG) _eingabe.KlasseHeizung = w;
                else if (k == PufferAuslegungKiSicht.BRAUCHWASSER) _eingabe.KlasseBrauchwasser = w;
                else _eingabe.KlasseProzess = w;
            }),
            VorlageLesen = () => _eingabe.Vorlage,
            VorlageSetzen = v => { if (Daten.Vorlagen.Any(x => x.Schluessel == v)) VorlageWaehlen(v); },
            VorlageEintraege = () => KiMaskenanmeldung.Eintraege(Daten.Vorlagen, v => v.Schluessel, v => v.Titel + " " + v.Untertitel),
            GeregeltLesen = () => _eingabe.WpGeregelt,
            GeregeltSetzen = w => Schalten(() => _eingabe.WpGeregelt = w),
            ZweiterzeugerFreiLesen = () => _eingabe.ZweiterzeugerFrei,
            ZweiterzeugerFreiSetzen = w => Schalten(() => _eingabe.ZweiterzeugerFrei = w),
            UebergabeartLesen = () => _eingabe.Uebergabeart ?? "",
            UebergabeartSetzen = w => { if (Daten.Uebergabearten.Any(u => u.Wert == (w ?? ""))) Schalten(() => _eingabe.Uebergabeart = w ?? ""); },
            UebergabeartEintraege = () => KiMaskenanmeldung.Eintraege(Daten.Uebergabearten, u => u.Wert, u => u.Text),
            SperrprofilLesen = () => _eingabe.Sperrprofil,
            SperrprofilSetzen = w => { if (PufferSperrprofilWert.Alle.Contains(w)) Schalten(() => _eingabe.Sperrprofil = w); },
            SperrprofilEintraege = () => KiMaskenanmeldung.Eintraege(PufferSperrprofilWert.Alle, p => p, p => Texte.SperrprofilText(p)),
            ZahlLesen = f => f switch
            {
                PufferAuslegungKiSicht.HEIZGRENZE => _eingabe.HeizgrenzeC,
                PufferAuslegungKiSicht.ANLAGENVOLUMEN => _eingabe.AnlagenvolumenL,
                PufferAuslegungKiSicht.STARTZIEL => _eingabe.StartzielJeTag,
                PufferAuslegungKiSicht.MINDESTLAUFZEIT => _eingabe.MindestlaufzeitMin,
                _ => _eingabe.DeckungszielProzent
            },
            ZahlSetzen = (f, w) => Zahl(() =>
            {
                switch (f)
                {
                    case PufferAuslegungKiSicht.HEIZGRENZE: _eingabe.HeizgrenzeC = w; break;
                    case PufferAuslegungKiSicht.ANLAGENVOLUMEN: _eingabe.AnlagenvolumenL = w; break;
                    case PufferAuslegungKiSicht.STARTZIEL: _eingabe.StartzielJeTag = w; break;
                    case PufferAuslegungKiSicht.MINDESTLAUFZEIT: _eingabe.MindestlaufzeitMin = w; break;
                    default: _eingabe.DeckungszielProzent = w; break;
                }
            })
        };
    }

    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged)
    };

    // =====================================================================
    //  Hilfen
    // =====================================================================

    private static string Z(double wert, string format = "N0") => wert.ToString(format, CultureInfo.CurrentCulture);

    private static string Format(string muster, params object[] werte)
    {
        try { return string.Format(CultureInfo.CurrentCulture, muster ?? "", werte); }
        catch (FormatException) { return muster ?? ""; }
    }
}
