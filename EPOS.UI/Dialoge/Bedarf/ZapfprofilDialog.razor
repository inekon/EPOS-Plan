    /// <summary>Die Realisierungen der Jahresreihe; ein geleertes Feld steht für die Vorgabe.</summary>
    private void RealisierungenSetzen(int? wert)
    {
        int? neu = wert ?? Daten.RealisierungenVorgabe;
        if (neu == _eingabe.Realisierungen) return;
        _eingabe.Realisierungen = neu;
        Geaendert();
    }

    /// <summary>Ein Feld meldet, ob sein Text gerade eine gültige Zahl ist — eine Fehleingabe hält das OK an.</summary>
    private void FehlerZustandMelden((string Feld, bool Fehlerhaft) f)
    {
        if (f.Fehlerhaft) _fehlfelder.Add(f.Feld);
        else _fehlfelder.Remove(f.Feld);
    }

    /// <summary>Ein gesperrter Versuch (Stufe, Reiter, Knopf): der Grund als leise Zeile.</summary>
    private void NochNicht() => _hinweis = Texte.GrundNochNicht;

    private void ZoneWaehlen(int index)
    {
        // Die Felder der bisherigen Zone verschwinden — ihre Fehleingaben mit ihnen.
        if (index != _wahl) FehlfelderRaeumen(art => art.Zone);
        _wahl = index;
        _hinweis = "";
    }

    private void ZoneNeu()
    {
        int n = _eingabe.Zonen.Count + 1;
        string name = Format(Texte.ZoneNameVorgabe, n);
        while (_eingabe.Zonen.Any(z => z.Name == name)) name = Format(Texte.ZoneNameVorgabe, ++n);

        _eingabe.Zonen.Add(new ZapfprofilZoneDaten { Name = name, Angaben = new ZapfprofilZonenangabenDaten() });
        FehlfelderRaeumen(art => art.Zone);
        _wahl = _eingabe.Zonen.Count - 1;
        PunktUeberholen();
        Geaendert(ansichtZuruecksetzen: true);
    }

    private void ZoneDuplizieren()
    {
        if (Gewaehlte is not { } z) return;
        ZapfprofilZoneDaten kopie = z.Kopie();
        kopie.Id = 0;
        kopie.IdVorlage = z.Id != 0 ? z.Id : z.IdVorlage;
        kopie.Name = Format(Texte.ZoneKopie, z.Name);
        _eingabe.Zonen.Insert(_wahl + 1, kopie);
        FehlfelderRaeumen(art => art.Zone);
        _wahl++;
        PunktUeberholen();
        Geaendert(ansichtZuruecksetzen: true);
    }

    private void ZoneEntfernen()
    {
        if (Gewaehlte is null) return;
        FehlfelderRaeumen(art => art.Zone);
        _eingabe.Zonen.RemoveAt(_wahl);
        if (_wahl >= _eingabe.Zonen.Count) _wahl = _eingabe.Zonen.Count - 1;
        PunktUeberholen();
        Geaendert(ansichtZuruecksetzen: true);
    }

