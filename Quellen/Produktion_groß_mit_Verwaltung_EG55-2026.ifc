#47007=IFCPROPERTYSINGLEVALUE('Identifier','Eindeutiger Bezeichner, der dem Modellobjekt zugewiesen wird. Der Bezeichner ist f\X\FCr alle Clients eindeutig. Wird bei der Instanziierung von Modellklassen automatisch gesetzt.',IFCIDENTIFIER('5e6a9f01-0147-b875-ac49-49da5f20a4db'),$);
