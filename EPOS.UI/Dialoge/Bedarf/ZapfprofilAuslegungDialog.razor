    /// <summary>Ein Umschalter auto/manuell — nur einer der zwei Einträge.</summary>
    private static string? KiAutoManuell(string feld, int? id, Action<int?> weg)
    {
        if (id is not (AUTO or MANUELL)) return ZapfprofilKiRegeln.Gesperrt(feld);
        weg(id);
        return null;
    }

    /// <summary>
    /// Was der Assistent über die Feldwerte hinaus darf: auffrischen und prüfen.
    /// </summary>
    /// <remarks>
    /// <b>Kein Speicherweg</b> — „OK" übernimmt Eingaben und Punkt in das Zapfprofil, und
    /// geschrieben wird mit dem OK der Bedarfsprofile; das bleibt der Klick des Anwenders.
    /// <b>Prüfen</b> ist der Befund des OK: die Fehleingabe, die es anhält.
    /// </remarks>
    private KiMaskenhaken KiHaken() => new KiMaskenhaken
    {
        Auffrischen = () => _ = InvokeAsync(StateHasChanged),
        Pruefen = OkBefund
    };

    /// <summary>Der Befund des OK: Ein Feld mit ungültigem Text hält es an; leer = in Ordnung.</summary>
    private string OkBefund()
        => _fehlfelder.Count > 0 ? Format(Texte.MeldungFehleingabe, string.Join(", ", _fehlfelder)) : "";

    /// <summary>
    /// Der Bedarfstag wie in der Auswahlliste; eine gesperrte Quelle nennt ihren Grund, statt
    /// still nichts zu tun.
    /// </summary>
    private string? KiBedarfstag(int? id)
    {
        int wahl = id ?? WAHL_VORGABE;
        if (Sperrgruende.TryGetValue(wahl, out string? grund))
            return grund.Length > 0
                ? grund
                : ZapfprofilKiRegeln.Gesperrt(Bedarfstagwahl.FirstOrDefault(e => e.Id == wahl).Text ?? "");
        BedarfstagWaehlen(wahl);
        return null;
    }

    /// <summary>Das Perzentil — es steht nur mit „Stochastisch rechnen" auf der Maske.</summary>
    private string? KiPerzentil(int? id)
    {
        if (!_eingabe.Stochastisch)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelPerzentil, Texte.LabelStochastisch);
        PerzentilSetzen(id);
        return null;
    }

    /// <summary>Die Realisierungen des Bedarfstags — nur mit „Stochastisch rechnen", in den Grenzen des Feldes.</summary>
    private string? KiRealisierungen(int? wert)
    {
        if (!_eingabe.Stochastisch)
            return ZapfprofilKiRegeln.NurMit(Texte.LabelRealisierungen, Texte.LabelStochastisch);
        string? grund = ZapfprofilKiRegeln.Bereich(Texte.LabelRealisierungen, wert,
                                                   Daten.RealisierungenMindestens, Daten.RealisierungenHoechstens);
        if (grund is not null) return grund;
        RealisierungenSetzen(wert);
        return null;
    }

    /// <summary>Eine Zahl in den Grenzen des Eingabefeldes (<c>Min</c>/<c>Max</c>), dann ihr Weg.</summary>
    private static string? KiZahl(string feld, double? wert, double? min, double? max, Action weg)
    {
        string? grund = ZapfprofilKiRegeln.Bereich(feld, wert, min, max);
        if (grund is not null) return grund;
        weg();
        return null;
    }

    /// <summary>Ein Weg ohne eigene Ablehnung.</summary>
    private static string? KiWeg(Action weg)
    {
        weg();
        return null;
    }

    // =================================================================================
    // Ergebnis
    // =================================================================================

    /// <summary>
    /// OK rechnet ein überholtes Ergebnis sofort nach, übernimmt den EINEN Punkt (erste
    /// rechenbare Speichergruppe, sonst die erste rechenbare) in die Eingaben und gibt sie
    /// zurück. Stammt der Bedarfstag aus dem Stundenprofil, fragt vorher die Rückfrage.
    /// </summary>
    private async Task BeiErgebnis(bool ok)
    {
        if (!ok)
        {
            await Abbrechen();
            return;
        }
        // Ein Feld mit ungültigem Text (Realisierungen) hielte sonst still den alten Wert.
        string befund = OkBefund();
        if (befund.Length > 0)
        {
            _hinweis = befund;
            return;
        }
        // Der Punkt hängt nicht am Ensemble (4.5, Empfehlung aus (a)): Ein laufendes Ensemble endet,
        // ein überholtes Ergebnis rechnet deterministisch nach — nie das Ensemble im Zeichenlauf.
        EntprellungAbbrechen();
        LaufVerwerfen();
        if (!_aktuell) DeterministischRechnen(konstruktorFolgen: false);
        if (_eingabe.Quelle == ZapfprofilBedarfstagquelle.Stundenprofil && _ergebnis?.Punktgruppe is not null)
        {
            _rueckfrage = true;
            return;
        }
        await Uebernehmen();
    }

    private async Task RueckfrageBeantwortet(bool? ja)
    {
        _rueckfrage = false;
        if (ja == true) await Uebernehmen();
    }

    private Task Uebernehmen()
    {
        ZapfprofilAuslegungEingabeDaten e = _eingabe.Kopie();
        ZapfprofilAuslegungsgruppeDaten? g = _ergebnis?.Punktgruppe;
        e.PunktVolumenL = g?.Empfehlung.Speicher == true ? g.Empfehlung.VolumenL : null;
        e.PunktLeistungKw = g?.Empfehlung.LeistungKw;
        return Geschlossen.InvokeAsync(e);
    }

    /// <summary>Abbrechen — von Esc, vom Schliesskreuz und vom Knopf gleichermaßen gerufen; verwirft.</summary>
    private Task Abbrechen()
    {
        EntprellungAbbrechen();
        LaufVerwerfen();
        return Geschlossen.InvokeAsync(null);
    }

    private Task BeiTaste(KeyboardEventArgs e)
    {
        if (e.Key != "Escape" || _konstruktorOffen || _rueckfrage) return Task.CompletedTask;
        return Abbrechen();
    }
}
